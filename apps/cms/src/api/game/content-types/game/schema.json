{
  "kind":"collectionType","collectionName":"games",
  "info":{"singularName":"game","pluralName":"games","displayName":"Game",
    "description":"One sport on the roster. Mirrors `games.outdoor` / `games.indoor` in apps/web/src/data/sports.ts — ONE type with an `arena` enum rather than two, because the card is identical and only the rail it sits in differs."},
  "options":{"draftAndPublish":true},
  "attributes":{
    "name":{"type":"string","required":true,"maxLength":120},
    "slug":{"type":"uid","targetField":"name","required":true},
    "arena":{"type":"enumeration","required":true,"default":"outdoor","enum":["outdoor","indoor"]},
    "icon":{"type":"string","required":true,"maxLength":40},
    "blurb":{"type":"text","required":true,"maxLength":800},
    "venue":{"type":"string","maxLength":200},
    "alt":{"type":"text","maxLength":500},
    "photo":{"type":"media","multiple":false,"allowedTypes":["images"]},
    "displayOrder":{"type":"integer","default":0,"required":true}
  }
}
