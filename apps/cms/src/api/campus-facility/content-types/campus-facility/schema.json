{
  "kind": "collectionType",
  "collectionName": "campus_facilities",
  "info": {
    "singularName": "campus-facility", "pluralName": "campus-facilities", "displayName": "Campus Facility",
    "description": "A named room or space on the campus tour, with its photographs. Mirrors the `facilities` export of apps/web/src/data/campusTour.ts. `pending` marks one the school has named but not photographed — the tour shows it as awaited rather than inventing a picture."
  },
  "options": { "draftAndPublish": true },
  "attributes": {
    "name": { "type": "string", "required": true, "maxLength": 160 },
    "slug": { "type": "uid", "targetField": "name", "required": true },
    "blurb": { "type": "text", "required": true, "maxLength": 1200 },
    "brief": { "type": "text", "maxLength": 1200 },
    "alt": { "type": "text", "required": true, "maxLength": 500 },
    "pending": { "type": "boolean", "default": false, "required": true },
    "gallery": { "type": "component", "repeatable": true, "component": "shared.photo" },
    "displayOrder": { "type": "integer", "default": 0, "required": true }
  }
}
