{
  "kind":"collectionType","collectionName":"sport_facilities",
  "info":{"singularName":"sport-facility","pluralName":"sport-facilities","displayName":"Sport Facility",
    "description":"A sporting venue on the campus. Mirrors the `facilities` export of apps/web/src/data/sports.ts. `lead` is the hero frame and `support` the rest — the page lays them out differently, so the split is content, not presentation."},
  "options":{"draftAndPublish":true},
  "attributes":{
    "name":{"type":"string","required":true,"maxLength":160},
    "slug":{"type":"uid","targetField":"name","required":true},
    "kicker":{"type":"string","maxLength":160},
    "body":{"type":"text","required":true,"maxLength":2000},
    "brief":{"type":"text","maxLength":1200},
    "notes":{"type":"component","repeatable":true,"component":"shared.fact"},
    "alt":{"type":"text","maxLength":500},
    "lead":{"type":"media","multiple":false,"allowedTypes":["images"]},
    "support":{"type":"component","repeatable":true,"component":"shared.photo"},
    "displayOrder":{"type":"integer","default":0,"required":true}
  }
}
