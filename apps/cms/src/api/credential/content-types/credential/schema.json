{
  "kind": "collectionType",
  "collectionName": "credentials",
  "info": {
    "singularName": "credential",
    "pluralName": "credentials",
    "displayName": "Credential",
    "description": "Third-party recognition — rankings, certifications and awards. Mirrors the `credentials` export of apps/web/src/data/achievements.ts."
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true,
      "maxLength": 200
    },
    "slug": {
      "type": "uid",
      "targetField": "title",
      "required": true
    },
    "figure": {
      "type": "string",
      "maxLength": 40
    },
    "body": {
      "type": "text",
      "required": true,
      "maxLength": 600
    },
    "icon": {
      "type": "enumeration",
      "required": true,
      "default": "medal",
      "enum": [
        "trophy",
        "medal",
        "target",
        "sprout",
        "field",
        "whistle",
        "belt",
        "chess",
        "carrom",
        "yoga",
        "swing",
        "skating",
        "aerobics",
        "karate",
        "kabaddi",
        "khokho",
        "cricket",
        "football",
        "basketball",
        "volleyball",
        "hockey",
        "tabletennis"
      ]
    },
    "displayOrder": {
      "type": "integer",
      "default": 0,
      "required": true
    }
  }
}
