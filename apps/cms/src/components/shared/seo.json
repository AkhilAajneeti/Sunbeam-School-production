{
  "collectionName": "components_shared_seos",
  "info": {
    "displayName": "SEO",
    "icon": "search",
    "description": "Page metadata. Attached to Single Types as they are migrated. Route-level SEO for collection-driven pages still lives in the .astro file and moves with the pages architecture, which is deliberately not started yet."
  },
  "options": {},
  "attributes": {
    "metaTitle": {
      "type": "string",
      "required": true,
      "maxLength": 120
    },
    "metaDescription": {
      "type": "text",
      "required": true,
      "maxLength": 500
    },
    "ogImage": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "noIndex": {
      "type": "boolean",
      "default": false,
      "required": true
    }
  }
}
