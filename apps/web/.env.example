# ═══════════════════════════════════════════════════════════════════════════
# COPY TO .env AND FILL IN.
#
# STRAPI_TOKEN is minted from the CMS, which is the only place it is ever
# visible in plaintext:
#
#     cd apps/cms && npm run token:read-only
#
# That prints a fresh read-only key and invalidates the previous one. A
# read-only token can call find and findOne and nothing else — it cannot write,
# delete, or reach the admin API.
#
# ⚠ NEVER PREFIX THESE WITH PUBLIC_. Astro inlines PUBLIC_* into the client
#   bundle; the token would then be readable by any visitor.
# ═══════════════════════════════════════════════════════════════════════════

STRAPI_URL=http://localhost:1337
STRAPI_TOKEN=
