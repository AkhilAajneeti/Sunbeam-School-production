---
/**
 * §1 · MAJOR ACHIEVEMENTS — first on the page, at display size.
 *
 * The client's clause is precise: "major achievements displayed first using
 * high-resolution photographs". Three qualify, and they qualify for the same
 * reason — they are the three the SCHOOL ITSELF produced an award graphic for.
 * That is the school's own editorial decision about what matters most, already
 * made, and it is also the only place high-resolution imagery exists.
 *
 * ⚠ THE ARTWORK IS SHOWN WHOLE, NEVER CROPPED. All three are designed posters —
 * portrait or square, each with its own headline, crest and framed photograph
 * inside it. An earlier build used one of them as a full-bleed card background
 * under a dark ramp, which cropped its headline away and dimmed its crest: a
 * designed graphic used as wallpaper. `object-fit` never applies here; the frame
 * takes the poster's own proportion and the copy sits beside it.
 *
 * THE LEAD RUNS WIDE AND THE OTHER TWO SHARE THE ROW BENEATH, so "first" is
 * visible as well as true — three equal cards would say these three rank
 * equally, and the first is the school's only international placing.
 *
 * ⚠ ALL THREE CARDS ARE HORIZONTAL, AND THAT IS A CORRECTION. The two secondary
 * cards were built stacked — poster above, copy below — which let each poster
 * fill the full column width. Measured at 1440: the lead came to 409px tall and
 * the two beneath it to 1088px each. The cards meant to be SECONDARY were nearly
 * three times the height of the card meant to lead, which inverts the whole
 * point of the layout, and two 670px-tall posters is what "very big" looks like.
 *
 * They are now the same object as the lead at a smaller size: poster left at a
 * capped width, copy right. The hierarchy is carried by scale — poster width,
 * heading size and how much detail each card shows — rather than by orientation,
 * so the three read as one family with a clear first among them.
 */
import CmsImage from '../../ui/CmsImage.astro';
import { getMajors, getAchievementsBands } from '../../../lib/cms';
import SectionHead from '../../academics/SectionHead.astro';

/* ⚠ FROM STRAPI NOW, NOT data/achievements.ts. `m.slug` replaces the old `m.id`
   and carries the same values — robowunder, innovation, khokho — because it is
   rendered as this article's HTML id and data/newsEvents.ts links to it.
   `facts` is flattened back to string[] in the query module, so the map below is
   unchanged. The old data file stays on disk until this is verified in a
   production build. */
const majors = await getMajors();

/* The band's heading, from the Achievements Page single type. */
const { majors: bandCopy } = await getAchievementsBands();
---

<section class="maj" id="major" aria-labelledby="maj-title">
  <div class="u-container">
    <SectionHead
      id="maj-title"
      eyebrow={bandCopy.eyebrow}
      heading={bandCopy.heading}
      stand={bandCopy.stand}
      align="start"
      tone="dark"
      measure={18}
    />

    <div class="maj__grid">
      {majors.map((m, i) => (
        <article class:list={['maj__card', i === 0 && 'maj__card--lead']} id={m.slug} data-reveal data-reveal-delay={i * 90}>
          {/* The poster, framed on a mat. The mat is what stops a graphic with
              its own white ground from floating on the ink. */}
          <figure class="maj__frame">
            {/* SIZES IS PER CARD, because the lead and the secondaries are no
                longer the same width. One shared hint over-declared the two
                small posters by roughly double and pulled the 840w variant for
                an image rendering at 182px — waste on the 4G connections
                docs/08 D13 sizes the whole image pipeline around.
                Breakpoints track the layout: ≤560 every card is one column and
                the poster is full width; ≤900 the grid is one column so a
                secondary card still spans the container; above that the
                secondaries sit two-up and the lead spans the row. */}
            <CmsImage
              file={m.art}
              alt={m.alt}
              sizes={
                i === 0
                  ? '(max-width: 560px) 86vw, (max-width: 900px) 40vw, 30vw'
                  : '(max-width: 560px) 86vw, (max-width: 900px) 34vw, 18vw'
              }
              fallbackWidth={i === 0 ? 1100 : 420}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </figure>

          <div class="maj__body">
            {/* Kicker and heading are wrapped so that on mobile they can sit
                BESIDE the thumbnail while the paragraph below runs the full card
                width — see the phone block at the foot of this stylesheet. On
                desktop the wrapper is an inert block and changes no spacing. */}
            <div class="maj__head">
              <p class="maj__kicker t-label">{m.kicker}</p>
              <h3 class="maj__h">{m.title}</h3>
            </div>
            <p class="maj__detail">{m.detail}</p>

            {/* Read straight off the artwork — the card's receipt, not a
                restatement of the paragraph above it. */}
            <ul class="maj__facts">
              {m.facts.map((f) => (
                <li><span class="maj__tick" aria-hidden="true"></span>{f}</li>
              ))}
            </ul>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .maj {
    position: relative;
    isolation: isolate;
    /* CLIPS THE BLOOM BELOW. It is `min(1200px, 118%)` wide, centred with a
       translate, so on any viewport under ~1200 it hangs past both edges — 88px
       at 1024, 35px at 390, measured. A pseudo-element never appears in a DOM
       scan for overflowing boxes, so this shows up only as a page that scrolls
       sideways with nothing visibly out of place.

       Safe here, unlike on the inter-house deck: `overflow` on an ancestor
       breaks `position: sticky` inside it, and nothing in this section is
       sticky. */
    overflow: hidden;
    padding-block: var(--sb-section-y);
    background: var(--sb-violet-ink);
    color: var(--sb-on-dark-78);
  }

  /* A single wide bloom behind the lead card, so the ink is not a flat slab. */
  .maj::before {
    content: '';
    position: absolute;
    z-index: -1;
    left: 50%;
    top: 26%;
    width: min(1200px, 118%);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(201, 60, 10, 0.22), transparent 68%);
    pointer-events: none;
  }

  .maj__grid {
    margin-top: var(--sb-10);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.6vw, 26px);
  }

  /* HORIZONTAL BY DEFAULT — see the note in the header on why. The poster's
     width is capped by the frame's flex basis, which is what stops it driving
     the card's height. */
  .maj__card {
    display: flex;
    align-items: center;
    gap: clamp(18px, 2vw, 30px);
    padding: clamp(20px, 2vw, 30px);
    border-radius: var(--sb-r-3);
    background: rgba(255, 255, 255, 0.05);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.11);
    transition: box-shadow var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  /* A SHARE OF THE CARD, NOT OF THE VIEWPORT. These were sized in `vw`, which
     meant the poster tracked the window while the card tracked the grid — at
     1440 that left a 135px image inside a 570px card, a thumbnail of a graphic
     that carries its own headline and crest. A percentage flex-basis resolves
     against the card's own content box, so the poster now grows with whatever
     it sits in. The px bounds keep it usable in the tablet band, where the
     two-column grid makes the card narrow. */
  .maj__card .maj__frame { flex: 0 0 clamp(140px, 36%, 240px); }
  .maj__card .maj__body { flex: 1 1 auto; min-width: 0; }

  .maj__card:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.26);
  }

  /* The lead spans the row and turns side-on, so the poster and the copy sit
     together at the size the clause is really asking for. */
  .maj__card--lead {
    grid-column: span 2;
    gap: clamp(28px, 3.6vw, 64px);
    padding: clamp(24px, 2.6vw, 44px);
    background:
      radial-gradient(90% 120% at 10% 50%, rgba(201, 60, 10, 0.18), transparent 62%),
      rgba(255, 255, 255, 0.05);
  }

  /* Scale is what carries the hierarchy now that all three share an
     orientation, so the lead grows with the secondaries rather than being left
     behind by them.

     ⚠ THE PERCENTAGE MUST EXCEED THE SECONDARIES' 36%, not merely rely on the
     lead's card being wider. Above 900 it spans both columns, so a smaller
     share of a bigger card still won; from 900 down the grid is one column,
     every card is the same width, and 32% made the lead's poster the SMALLEST
     of the three — measured 224px against 223px at 768, hierarchy gone. It is
     a larger share of an equal-or-wider card at every width now. The 400px cap
     is what stops it running away on desktop. */
  .maj__card--lead .maj__frame { flex: 0 0 clamp(240px, 44%, 400px); }

  .maj__frame {
    margin: 0;
    padding: clamp(8px, 0.8vw, 14px);
    border-radius: var(--sb-r-2);
    background: rgba(255, 255, 255, 0.07);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.14), 0 22px 44px rgba(0, 0, 0, 0.4);
  }

  .maj__frame :global(picture) { display: block; }

  /* `height: auto` IS LOAD-BEARING. Astro's <Picture> emits real width/height
     attributes, which are presentational hints mapping to the CSS width and
     height properties — and base.css resets `max-width` WITHOUT `height: auto`.
     Without this the width collapses to the column while the specified height
     stays at the source's, and the poster renders thousands of pixels tall. */
  .maj__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 4px;
    transition: transform 700ms var(--sb-ease);
  }

  .maj__card:hover .maj__frame :global(img) { transform: scale(1.02); }

  .maj__kicker { color: var(--sb-lime); }

  /* SECONDARY SIZE IS THE BASE, and the lead steps up from it. Written this way
     round because the two secondaries are the pair that has to stay compact —
     if the base grows, they grow, and the card that must not dominate does. */
  .maj__h {
    margin-top: var(--sb-3);
    max-width: 24ch;
    font-family: var(--sb-font-display);
    font-size: clamp(19px, 1.7vw, 24px);
    font-weight: 700;
    line-height: 1.14;
    letter-spacing: -0.026em;
    color: #fff;
    text-wrap: balance;
  }

  .maj__card--lead .maj__h {
    margin-top: var(--sb-4);
    max-width: 20ch;
    font-size: clamp(24px, 2.4vw, 38px);
    line-height: 1.08;
    letter-spacing: -0.032em;
  }

  .maj__detail {
    margin-top: var(--sb-4);
    max-width: 46ch;
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.78);
  }

  .maj__card--lead .maj__detail {
    margin-top: var(--sb-5);
    max-width: 52ch;
    font-size: var(--sb-body);
    line-height: 1.62;
    color: rgba(255, 255, 255, 0.82);
  }

  /* Stacked on the secondaries — two or three short facts in a narrow column
     wrap badly across a row, and a wrapped inline list reads as broken rather
     than as designed. The lead has the width to run them across. */
  .maj__facts {
    list-style: none;
    margin: var(--sb-5) 0 0;
    padding-top: var(--sb-5);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    display: grid;
    gap: 6px;
  }

  .maj__card--lead .maj__facts {
    margin-top: var(--sb-6);
    padding-top: var(--sb-6);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3) var(--sb-6);
  }

  .maj__facts li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--sb-caption);
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
  }

  .maj__tick {
    width: 5px;
    height: 5px;
    flex-shrink: 0;
    border-radius: 50%;
    background: var(--sb-lime);
  }

  @media (max-width: 900px) {
    /* One column. The lead keeps its row — at full width there is plenty of
       room for a 210px poster beside the copy. */
    .maj__grid { grid-template-columns: minmax(0, 1fr); }
    .maj__card--lead { grid-column: span 1; }
  }

  @media (max-width: 560px) {
    /* ═══ PHONE — a different arrangement, not the desktop card narrowed ═══
       Three faults were measured at 390 and all three are fixed here.

       1 · DEAD SPACE. The previous rule capped every poster at 200px and pinned
           it left inside a 310px column, leaving 102–110px of bare ink beside
           it on all three cards. A poster is now the width of whatever column
           it is given, so there is none.
       2 · THE HIERARCHY HAD GONE. Lead 621px against secondaries at 574 and
           586 — a 6% difference, on a section whose eyebrow says "first, and at
           full size". Scale now separates them instead.
       3 · THE LEAD'S FACTS WRAPPED RAGGED (140/70, then 150/113) into an
           accidental two-column while the secondaries stacked cleanly. Both
           stack now.

       ⚠ ALL THREE CARDS TAKE THE SAME SHAPE — client instruction. An interim
       pass ran the two secondaries as thumbnail-beside-heading to keep them
       compact; that held the hierarchy but made them a different object from
       the lead. One arrangement now: poster at full card width, copy beneath.
       Hierarchy falls to heading scale and the lead's warm ground — which is
       how the desktop layout already carries it, the orientation there being
       shared too. It also means all three posters render large enough to read,
       which the clause's "high-resolution photographs" is better served by.

       Grid rather than flex so `display: contents` can lift .maj__body's
       children onto the card's own grid. .maj__head is load-bearing: without it
       the kicker and heading become separate grid items and take the full row
       gap between them. */
    /* 72px between a section head and its first card is a desktop measure. */
    .maj__grid { margin-top: var(--sb-8); }

    .maj__card {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-items: start;
      gap: var(--sb-5);
      padding: var(--sb-6);
    }

    .maj__body { display: contents; }

    /* Gaps do the spacing here; the desktop margins would double it. */
    .maj__card .maj__detail,
    .maj__card--lead .maj__detail { margin-top: 0; }

    .maj__card .maj__facts,
    .maj__card--lead .maj__facts {
      margin-top: 0;
      padding-top: var(--sb-5);
      display: grid;
      gap: 8px;
    }

    /* The lead still leads, on scale rather than on shape — the same 1.4 : 1
       heading ratio the desktop layout uses, plus its warm radial ground. */
    .maj__card--lead .maj__h { font-size: 27px; }
  }
</style>
