---
/**
 * §3 · THE FULL RECORD — two boards, sport and academic.
 *
 * WHAT MOVED HERE. The six sporting records used to close the Sports & Games
 * page. The audit asks for achievements "showcased separately", so they now live
 * here and that page ends on coaching and links across. Nothing was lost in the
 * move; the wording is identical.
 *
 * THE ACADEMIC BOARD IS NEW and had nowhere to live before — the AI Impact
 * Festival win, the science-congress and Vigyan Manthan qualifications, the
 * MANAK selections and the declamation results were all published (docs/01
 * § "Activities & events") and appeared nowhere on the rebuilt site.
 *
 * ⚠ THERE IS NO BOARD-RESULTS BOARD, and its absence is the most conspicuous
 * thing on this page. docs/01 §119 records why: "the single most-searched fact
 * about any CBSE school is absent" — the school publishes no pass rate, no
 * toppers and no year-on-year data anywhere, and `/result/` is only a login
 * portal to an external system. Audit §2E requires Board Results. That is an
 * asset request, not something to fill with an estimate.
 *
 * A LIST, PRESENTED AS A LIST. Eleven records is a record board; giving each one
 * a card with a stock icon would be the "endless gallery" the audit objects to
 * on the live site, rebuilt in a nicer font.
 */
import { getAchievementRecords } from '../../../lib/cms';
import SectionHead from '../../academics/SectionHead.astro';

/* ⚠ FROM STRAPI NOW, NOT data/achievements.ts. Both boards are one content type
   in the CMS separated by a `category` field — their shapes were identical, and
   two collections with the same three columns is a form an editor has to learn
   twice. One request returns both; the split happens in the query module.
   The old data file stays on disk until this is verified in a production build. */
const { sportRecord, academicRecord } = await getAchievementRecords();

const boards = [
  {
    id: 'sport',
    label: 'Sport',
    note: 'Every competition record the school publishes.',
    items: sportRecord,
  },
  {
    id: 'academic',
    label: 'Academic & innovation',
    note: 'Science, technology and public speaking.',
    items: academicRecord,
  },
];
---

<section class="brd" id="record" aria-labelledby="brd-title">
  <div class="u-container">
    <SectionHead
      id="brd-title"
      eyebrow="The rest of it"
      heading="The full record"
      stand="Everything else the school has published, on two boards."
      align="start"
      measure={18}
    />

    <div class="brd__cols">
      {boards.map((b, bi) => (
        <div class="brd__col">
          <p class="brd__label">
            {b.label}
            <span class="brd__n t-tabular">{String(b.items.length).padStart(2, '0')}</span>
          </p>
          <p class="brd__note">{b.note}</p>

          <ul class="brd__list">
            {b.items.map((r, i) => (
              <li data-reveal data-reveal-delay={bi * 80 + i * 45}>
                <p class="brd__meta t-label">{r.meta}</p>
                <h3 class="brd__h">{r.title}</h3>
                <p class="brd__b">{r.body}</p>
              </li>
            ))}
          </ul>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .brd {
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  .brd__cols {
    margin-top: var(--sb-10);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(28px, 4vw, 72px);
  }

  .brd__label {
    display: flex;
    align-items: center;
    gap: var(--sb-4);
    padding-bottom: var(--sb-4);
    border-bottom: 2px solid var(--sb-violet);
    font-family: var(--sb-font-display);
    font-size: clamp(19px, 1.8vw, 24px);
    font-weight: 700;
    letter-spacing: -0.022em;
    color: var(--sb-charcoal);
  }

  /* Pushed right so both boards' counts align whatever their labels run to. */
  .brd__n {
    margin-left: auto;
    font-size: var(--sb-body-sm);
    font-weight: 700;
    color: var(--sb-violet);
  }

  .brd__note {
    margin-top: var(--sb-4);
    font-size: var(--sb-caption);
    color: var(--sb-text-muted);
  }

  .brd__list {
    list-style: none;
    margin: var(--sb-6) 0 0;
    padding: 0;
  }

  .brd__list li {
    padding-block: var(--sb-5);
    border-bottom: var(--sb-hairline);
    transition: padding-left 260ms var(--sb-ease);
  }

  .brd__list li:hover { padding-left: 8px; }

  .brd__meta { color: var(--sb-violet); }

  .brd__h {
    margin-top: var(--sb-3);
    font-family: var(--sb-font-display);
    font-size: 19px;
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .brd__b {
    margin-top: var(--sb-3);
    max-width: 48ch;
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  @media (max-width: 860px) {
    .brd__cols { grid-template-columns: minmax(0, 1fr); }
  }
</style>
