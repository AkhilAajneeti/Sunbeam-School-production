---
/**
 * ═══ STUDENT COUNCIL — THE ROLL ════════════════════════════════════════════
 *
 * Two bodies, senior and junior. Each opens with its four head offices set
 * large, then the rest of its posts in a plain four-up grid.
 *
 * ⚠ NOTHING HERE REWRITES WHAT THE SCHOOL PUBLISHED. The posts are uppercased
 * by CSS, not in the markup, so the stored string stays the record; the names
 * are printed exactly as they are stored, with no casing applied at all. The
 * board prints several spellings that look like mistakes and they are the
 * school's — see the Student Council content type's own description.
 *
 * ⚠ THE BOARD AND THE LIST BELOW IT ARE THE SAME FORTY-FIVE PEOPLE, so they
 * have to be changed together or the page contradicts itself in public. The
 * board is the school's artwork and carries the faces; the list carries the
 * names as text, which is what search, screen readers and a parent pressing
 * ctrl-F actually reach. Neither replaces the other. A new board is uploaded
 * AND its roll retyped in the same save, in Content Manager -> Student Council.
 *
 * ⚠ data/studentCouncil.ts IS NO LONGER WHAT THIS RENDERS. It stays in the
 * repository as the seed's source and as the record of where each spelling
 * came from; editing it changes nothing on the site.
 */
import CmsImage from '../../ui/CmsImage.astro';
import { getStudentCouncil } from '../../../lib/cms';

const council = await getStudentCouncil();
const { session = '', intro = '', board = null, bodies = [] } = council ?? {};
---

<section class="stc" aria-labelledby="stc-intro">
  <div class="u-container">
    <p class="stc__intro" id="stc-intro">{intro}</p>

    {/* ⚠ THE ALT TEXT DOES NOT TRY TO LIST FORTY-FIVE NAMES. Every one of them
        is marked up as text directly below, so reading them twice would be a
        long detour to arrive back where the reader already was. */}
    <figure class="stc__board">
      <CmsImage
        file={board}
        alt={`The Sunbeam School Ballia student council board for ${session}, photographs of the junior and senior councils with each member's name and post.`}
        sizes="(min-width: 1100px) 1040px, 94vw"
        fallbackWidth={1040}
        loading="eager"
        fetchpriority="high"
      />
      <figcaption>
        The school's own board for {session}. Every name it carries is
        listed below.
      </figcaption>
    </figure>

    {
      bodies.map((body) => (
        <div class="stc__body" id={body.id}>
          <h2 class="stc__h">{body.label}</h2>

          {/* The four head offices. A separate list, not a styled first row of
              the grid below — they are a different size and would otherwise
              have to be excluded from the grid's own rules one by one. */}
          <ul class="stc__offices" role="list">
            {body.offices.map((o) => (
              <li class="stc__card stc__card--office">
                <span class="stc__post stc__post--office">{o.post}</span>
                <span class="stc__name stc__name--office">{o.name}</span>
              </li>
            ))}
          </ul>

          <ul class="stc__grid" role="list">
            {body.posts.map((o) => (
              <li class="stc__card">
                <span class="stc__post">
                  {/* ⚠ THE DOT IS DECORATION AND IS HIDDEN FROM ASSISTIVE TECH.
                      The house is already in the post's own text — "Captain
                      Love House" — so announcing it again would say it twice.
                      Colour alone never carries meaning here. */}
                  {o.house && (
                    <span
                      class:list={['stc__dot', `stc__dot--${o.house}`]}
                      aria-hidden="true"
                    />
                  )}
                  {o.post}
                </span>
                <span class="stc__name">{o.name}</span>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  /* The page panel this sits in already carries the stacking contract against
     the pinned banner (see .u-page-panel in base.css): position, an explicit
     z-index and an opaque ground. This section adds none of its own so there
     is one place that owns it. */
  .stc {
    padding-block: 0;
  }

  .stc__intro {
    max-width: 64ch;
    margin: 0 auto clamp(28px, 3.2vh, 40px);
    font-size: var(--sb-body-lg, 17px);
    line-height: 1.7;
    text-align: center;
    color: var(--sb-text-secondary);
  }

  .stc__board {
    max-width: 1040px;
    margin: 0 auto clamp(48px, 6vh, 76px);
  }

  /* ⚠ ANCHORED ON THE FIGURE, WHICH THIS COMPONENT RENDERS. CmsImage emits a
     bare <img> — never a <picture> — and a scoped selector never reaches it. */
  .stc__board :global(img) {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid rgba(18, 16, 15, 0.08);
    border-radius: 12px;
  }

  .stc__board figcaption {
    margin-top: var(--sb-3, 10px);
    font-size: var(--sb-caption);
    line-height: 1.5;
    text-align: center;
    color: var(--sb-text-muted);
  }

  .stc__body + .stc__body {
    margin-top: clamp(48px, 6vh, 76px);
  }

  /* The rule leads the heading, as it does on the rest of this section. */
  .stc__h {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
    margin: 0 0 var(--sb-6);
    font-family: var(--sb-font-display);
    font-size: clamp(20px, 1.9vw, 25px);
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--sb-ink);
  }
  .stc__h::before {
    content: '';
    width: clamp(20px, 2.2vw, 30px);
    height: 2px;
    flex: none;
    background: var(--sb-violet);
  }

  .stc__offices,
  .stc__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-4, 12px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .stc__offices {
    margin-bottom: var(--sb-5);
  }

  .stc__card {
    display: flex;
    flex-direction: column;
    gap: 5px;
    padding: 14px 18px;
    border: 1px solid rgba(18, 16, 15, 0.08);
    border-radius: 10px;
    background: var(--sb-paper);
  }
  .stc__card--office {
    padding: 18px 20px;
    border-color: rgba(201, 60, 10, 0.18);
  }

  .stc__post {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12px;
    line-height: 1.4;
    letter-spacing: 0.02em;
    color: var(--sb-text-muted);
  }
  /* ⚠ UPPERCASED IN CSS, NOT IN THE DATA. The stored string is the school's
     record of the post; this is only how it is set. */
  .stc__post--office {
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  /* ⚠ NO text-transform ON A NAME, EVER. The board has published a name with a
     lower-case initial before; capitalising one here would be this page quietly
     correcting a child's name, with nothing on screen to show it had. */
  .stc__name {
    font-weight: 600;
    font-size: var(--sb-body-sm);
    line-height: 1.4;
    color: var(--sb-ink);
  }
  .stc__name--office {
    font-family: var(--sb-font-display);
    font-size: clamp(16px, 1.3vw, 19px);
    letter-spacing: -0.01em;
  }

  .stc__dot {
    width: 7px;
    height: 7px;
    flex: none;
    border-radius: 50%;
  }
  /* ⚠ THESE ARE THE HOUSES' OWN COLOURS, READ OFF THE BOARD — on it the Love
     House captains wear red, Joy yellow and Hope green. They are not three
     colours chosen to tell three dots apart, so do not re-pick them to suit
     the palette. The house's name and its colour are two different things. */
  .stc__dot--love {
    background: #d64541;
  }
  .stc__dot--joy {
    background: #e0a92b;
  }
  .stc__dot--hope {
    background: #3a9a55;
  }

  /* The last row of a grid of twenty or six is often short; cards keep their
     own width rather than stretching to fill it. */
  @media (max-width: 1023px) {
    .stc__offices,
    .stc__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 559px) {
    .stc__offices,
    .stc__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
