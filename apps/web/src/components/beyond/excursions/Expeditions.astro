---
import { getExpeditions } from '../../../lib/cms';

const expeditions = await getExpeditions();
/**
 * NEARER HOME — the local learning expeditions, as a hovering icon grid.
 *
 * ═══ WHAT THIS SECTION IS ══════════════════════════════════════════════════
 *
 * The seven places named inside the live page's closing paragraph — Parag
 * Dairy, the court, the post office, Van Bihar, Basantpur, Bhrigu Temple and
 * Karo Dham — pulled out of a run-on sentence into a readable register.
 *
 * ⚠ THE NOTES ARE ONE LINE EACH ON PURPOSE. The school publishes the
 * destination and nothing else for any of these, so each note says what the
 * place IS, not what the children learned there. Writing a paragraph per
 * destination would mean writing seven small fictions.
 *
 * ═══ THE HOVER — CLIENT INSTRUCTION, BUILT AS A SWEEP NOT A FADE ═══════════
 *
 * "Add icons, on hover icons animate and background colour animate."
 *
 * Each card carries its own two colours as custom properties, taken from its
 * category, so one rule set drives four palettes. On hover:
 *
 * · the ground SWEEPS UP from the card's bottom edge — a `::before` on
 *   `scaleY`, not a `background-color` transition. Transitioning a colour is a
 *   crossfade and reads as a light going on; a wipe reads as a deliberate
 *   change of state, and it composites on the GPU rather than repainting.
 * · the icon plate fills with the category's ink, its glyph inverts to white,
 *   and the icon lifts and tilts.
 * · the name takes the category ink.
 *
 * ⚠ `transform` AND `opacity` ONLY, per docs/05 § N. Nothing here animates a
 * layout property, so seven cards hovering in sequence cost no reflow.
 *
 * ⚠ THESE CARDS ARE NOT LINKS, and that is not an oversight — the school
 * publishes no page for any of these seven places, and inventing destinations
 * is the one thing this project does not do. A hover state on a non-interactive
 * card does carry a mild implication of clickability; it is here because it was
 * asked for, the cursor stays `default`, and no focus or pointer affordance
 * suggests an action. If the school ever publishes pages for these, each card
 * becomes an `<a>` and the styling is unchanged.
 */
import SectionHead from '../../academics/SectionHead.astro';
import FacIcon from '../../campus/facilities/FacIcon.astro';

/**
 * One entry per category, and the ONLY place these pairings are written down.
 * `tint` is the swept ground; `ink` is the plate fill, the glyph on hover and
 * the name — every one already checked against the section's ground elsewhere
 * on the site, so no new colour enters the system here.
 */
const kinds: Record<string, { label: string; tint: string; ink: string }> = {
  civic: { label: 'Civic', tint: 'var(--sb-accent-wash)', ink: 'var(--sb-accent)' },
  heritage: { label: 'Heritage', tint: 'var(--sb-violet-wash)', ink: 'var(--sb-violet-dark)' },
  nature: { label: 'Nature', tint: 'var(--sb-lime-wash)', ink: 'var(--sb-lime-deep)' },
  industry: { label: 'Industry', tint: 'var(--sb-gold-wash)', ink: 'var(--sb-maroon)' },
};
---

<section class="exp" id="nearby" aria-labelledby="exp-title">
  <div class="u-container">
    <SectionHead
      id="exp-title"
      eyebrow="Within an afternoon of school"
      heading="Learning expeditions"
      stand="A dairy, a court, a post office, a temple and a forest park — the places a class can reach and be back by the last bell."
      measure={20}
    />

    <ul class="exp__grid">
      {expeditions.map((e, i) => {
        const k = kinds[e.kind];
        return (
          <li
            class="exp__card"
            style={`--tint:${k.tint}; --ink:${k.ink};`}
            data-reveal
            data-reveal-delay={i * 55}
          >
            <span class="exp__plate" aria-hidden="true">
              <FacIcon name={e.icon} size={26} />
            </span>
            <h3 class="exp__name">{e.name}</h3>
            <p class="exp__note">{e.note}</p>
            <span class="exp__kind">{k.label}</span>
          </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .exp {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .exp__grid {
    list-style: none;
    margin: var(--sb-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(12px, 1.4vw, 20px);
  }

  /* --- The card ------------------------------------------------------------ */

  .exp__card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    padding: clamp(22px, 2.2vw, 30px);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    overflow: hidden;
    transition: box-shadow var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  /* THE SWEEP. A `::before` on scaleY rather than a background-color transition:
     a colour crossfade reads as a light going on, a wipe reads as a change of
     state — and this composites instead of repainting the card. Anchored to the
     bottom edge so it rises into the card. */
  .exp__card::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background: var(--tint);
    transform: scaleY(0);
    transform-origin: bottom;
    transition: transform 420ms var(--sb-ease);
  }

  .exp__card:hover::before,
  .exp__card:focus-within::before { transform: scaleY(1); }

  .exp__card:hover,
  .exp__card:focus-within {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px transparent, var(--sb-shadow-card-hover);
  }

  /* --- The icon plate ------------------------------------------------------ */

  .exp__plate {
    display: grid;
    place-items: center;
    width: 52px;
    height: 52px;
    margin-bottom: var(--sb-6);
    border-radius: 14px;
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    color: var(--ink);
    transition:
      background-color 320ms ease,
      color 320ms ease,
      box-shadow 320ms ease,
      transform 460ms var(--sb-ease);
  }

  /* Lift, tilt and grow — three small moves at once read as one gesture, where
     any single one of them reads as a twitch. */
  .exp__card:hover .exp__plate,
  .exp__card:focus-within .exp__plate {
    background: var(--ink);
    color: #fff;
    box-shadow: inset 0 0 0 1px transparent, 0 10px 22px -10px rgba(28, 14, 8, 0.45);
    transform: translateY(-3px) rotate(-7deg) scale(1.06);
  }

  /* --- Type ---------------------------------------------------------------- */

  .exp__name {
    font-family: var(--sb-font-display);
    font-size: clamp(18px, 1.5vw, 21px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--sb-charcoal);
    text-wrap: balance;
    transition: color 320ms ease;
  }

  .exp__card:hover .exp__name,
  .exp__card:focus-within .exp__name { color: var(--ink); }

  .exp__note {
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  /* Pushed to the card's foot by `margin-top: auto`, so every card in a row ends
     its label on the same line however long its note runs. */
  .exp__kind {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--sb-6);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
    transition: color 320ms ease;
  }

  .exp__card:hover .exp__kind,
  .exp__card:focus-within .exp__kind { color: var(--ink); }

  /* --- Grid ---------------------------------------------------------------- */

  @media (min-width: 620px) {
    .exp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  /* Four across, so seven items land 4 + 3. Three across would give 3 + 3 + 1
     and leave a single card stranded on its own row. */
  @media (min-width: 1024px) {
    .exp__grid { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    /* The colour change survives — it carries the state. The movement does not. */
    .exp__card,
    .exp__card::before,
    .exp__plate { transition-duration: 1ms; }

    .exp__card:hover,
    .exp__card:focus-within { transform: none; }

    .exp__card:hover .exp__plate,
    .exp__card:focus-within .exp__plate { transform: none; }
  }
</style>
