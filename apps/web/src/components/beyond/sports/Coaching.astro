---
import { getSportsPage } from '../../../lib/cms';

const { coaching } = await getSportsPage();
/**
 * §5 · COACHING OPPORTUNITIES — the staggered tinted-card layout.
 *
 * ═══ THE REFERENCE ══════════════════════════════════════════════════════════
 *
 * Built to a layout the client supplied: two columns of soft tinted cards with
 * the right column dropped below the left, each card an icon over a heading over
 * a paragraph, no borders and no shadows — the tint IS the card. The stagger is
 * the whole trick; four cards on a level grid read as a table, and the same four
 * offset read as a composition.
 *
 * THE COLUMNS ARE REAL COLUMNS, NOT A STAGGERED GRID. A two-column grid with a
 * margin on every even child staggers the first row and then re-levels on the
 * second, because each grid row has its own baseline. Splitting the cards into
 * two flex columns lets each column flow on its own, which is what keeps the
 * right-hand offset constant all the way down.
 *
 * ═══ THE CLOUD ══════════════════════════════════════════════════════════════
 *
 * Same device as "What our students say" on the home page: overlapping circles
 * of one opaque fill, which merge into a single silhouette. TOP EDGE ONLY here,
 * as asked. The fill is `--sb-sand` — the colour of the INTER-HOUSE section
 * directly above — so the band above appears to billow down into this one.
 * Filling it with this section's own ivory would draw a cloud-shaped hole.
 *
 * ⚠ NO COACH IS NAMED, AND THE CARDS ARE STILL SPECIFIC. The school publishes no
 * coach, no timetable and no programme detail. Inventing "Mr Sharma, national
 * Taekwondo coach, twelve years' experience" would satisfy the brief and be a
 * fabrication about a real, identifiable person. What each card states is what
 * the results themselves establish — a Class I karate medal cannot happen
 * without Class I coaching — and then prints the record that forces it. The
 * `proof` line is the card's evidence, not decoration.
 */
import SectionHead from '../../academics/SectionHead.astro';
import SportIcon from './SportIcon.astro';
import CloudEdge from '../../ui/CloudEdge.astro';

/* MAPPED ONTO THE REFERENCE COLUMN BY COLUMN, not cycled through four colours.
   In the supplied layout the LEFT column repeats one neutral and the RIGHT
   column carries the two colours — that repetition is deliberate, and cycling
   four tints instead breaks the calm the reference has. So: neutral, neutral
   down the left; warm then cool down the right. */
const tints = ['n', 'b', 'n', 'a'];

/* Split, not staggered by nth-child — see the note above on why.

   ⚠ THIS PUTS THE DOM IN 1, 3, 2, 4 ORDER, which is the real cost of using two
   columns instead of one grid. It is acceptable HERE and would not be everywhere:
   these four cards are unordered peers making four independent points, so a
   screen reader meeting them in column order loses nothing. If a numbered or
   sequential set ever uses this layout, it needs the grid and a different way of
   staggering. */
const left = coaching.filter((_, i) => i % 2 === 0);
const right = coaching.filter((_, i) => i % 2 === 1);

---

<section class="coa" id="coaching" aria-labelledby="coa-title">
  {/* Billowing down from the inter-house band above, which is sand. */}
  <CloudEdge fill="var(--sb-sand)" side="top" />

  <div class="u-container">
    <SectionHead
      id="coa-title"
      eyebrow="Being taught, not just supervised"
      heading="Coaching opportunities"
      stand="The school does not publish its coaching staff. What it does publish is a set of results, and those say something quite specific about how sport is taught here."
      measure={20}
    />

    <div class="coa__grid">
      {[left, right].map((col, ci) => (
        <div class:list={['coa__col', ci === 1 && 'coa__col--drop']}>
          {col.map((c, i) => {
            const n = i * 2 + ci;
            return (
              <article class="coa__card" data-tint={tints[n]} data-reveal data-reveal-delay={n * 90}>
                <span class="coa__icon" aria-hidden="true"><SportIcon name={c.icon} size={46} /></span>

                <p class="coa__fig t-tabular">{c.figure}</p>
                <h3 class="coa__h">{c.title}</h3>
                <p class="coa__b">{c.body}</p>
                <p class="coa__proof">{c.proof}</p>
              </article>
            );
          })}
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .coa {
    position: relative;
    isolation: isolate;
    /* Extra top padding so the cloud sits in breathing space and never collides
       with the eyebrow — 96px of cloud against the section's own padding. */
    padding-block: calc(var(--sb-section-y) + clamp(24px, 4vh, 48px)) var(--sb-section-y);
    /* PAPER, NOT IVORY, AND THE CLOUD IS WHY. The cloud is filled with the sand
       of the section above so the band appears to billow down into this one —
       and sand against ivory is six RGB units, which rendered as an invisible
       scallop. On paper the same silhouette actually reads, which is also how
       the reference does it: a coloured cloud on a white page. */
    background: var(--sb-paper);
    --cloud-h: clamp(52px, 7vw, 104px);
  }

  /* --- The two columns ------------------------------------------------------ */

  .coa__grid {
    margin-top: var(--sb-10);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 1.6vw, 26px);
    align-items: start;
  }

  .coa__col {
    display: flex;
    flex-direction: column;
    gap: clamp(16px, 1.6vw, 26px);
  }

  /* THE STAGGER. Dropping the right column is what turns four cards into a
     composition rather than a table — and because these are real columns rather
     than grid cells, the offset holds for every card in the column instead of
     re-levelling on the second row. */
  .coa__col--drop { margin-top: clamp(32px, 5vw, 72px); }

  /* --- The card -------------------------------------------------------------
     THE TINT IS THE CARD. No border, no shadow at rest — the reference's cards
     are flat fills, and adding a hairline to "define" them is exactly what makes
     that layout look like a form. */
  .coa__card {
    display: flex;
    flex-direction: column;
    padding: clamp(24px, 2.4vw, 40px);
    border-radius: clamp(16px, 1.5vw, 24px);
    background: var(--tint);
    transition:
      transform var(--sb-dur-link) var(--sb-ease),
      box-shadow var(--sb-dur-link) ease;
  }

  /* `n` is sand — the same neutral the section above is painted in, which is
     also what the cloud is filled with, so the two columns read as paper and
     colour rather than as four unrelated swatches. */
  .coa__card[data-tint='n'] { --tint: var(--sb-sand); --ink: var(--sb-violet-dark); }
  .coa__card[data-tint='b'] { --tint: var(--sb-violet-wash); --ink: var(--sb-maroon); }
  .coa__card[data-tint='a'] { --tint: var(--sb-accent-wash); --ink: var(--sb-accent); }

  .coa__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 22px 44px -22px rgba(28, 14, 8, 0.24);
  }

  /* Line art at the card's own accent, sized to the reference — large enough to
     be the first thing read, not a bullet. */
  .coa__icon {
    display: block;
    color: var(--ink);
    margin-bottom: clamp(16px, 1.8vw, 26px);
  }

  .coa__fig {
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 2.6vw, 36px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--ink);
  }

  .coa__h {
    margin-top: var(--sb-4);
    max-width: 24ch;
    font-family: var(--sb-font-display);
    font-size: clamp(18px, 1.6vw, 22px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.022em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .coa__b {
    margin-top: var(--sb-4);
    max-width: 46ch;
    font-size: var(--sb-body-sm);
    line-height: 1.65;
    color: var(--sb-text-secondary);
  }

  /* The receipt. `margin-top: auto` pins it to the card's foot so the evidence
     lines sit low on every card whatever the paragraph above runs to. */
  .coa__proof {
    margin-top: auto;
    padding-top: clamp(18px, 2vw, 28px);
    font-size: var(--sb-caption);
    font-weight: 600;
    line-height: 1.5;
    color: var(--sb-text-muted);
  }

  .coa__proof::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    margin-bottom: var(--sb-4);
    background: var(--ink);
    opacity: 0.45;
  }

  @media (max-width: 860px) {
    /* One column, and the stagger goes with it — an offset on a single column is
       just an odd gap. */
    .coa__grid { grid-template-columns: minmax(0, 1fr); }
    .coa__col--drop { margin-top: 0; }
  }
</style>
