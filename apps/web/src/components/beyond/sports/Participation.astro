---
/**
 * §3 · STUDENT PARTICIPATION — a bento that alternates photographs and figures.
 *
 * ═══ THE PROBLEM THIS LAYOUT SOLVES ═════════════════════════════════════════
 *
 * The client asked for "a gallery with photos of students participating". There
 * are no such photographs. Every ground shot we hold is empty; the only frame
 * with children in it is the Kho-Kho team with their medals. A nine-tile gallery
 * of empty fields, captioned as student participation, would be a worse outcome
 * than saying nothing.
 *
 * So the bento INTERLEAVES: photograph, figure, photograph, figure. The figures
 * are not filler — they are the actual participation evidence, and they carry
 * the tiles that would otherwise have needed a photograph we do not have. The
 * result is a real bento with varied tile sizes and no dead weight, and it reads
 * as a designed composition rather than as a gallery with holes.
 *
 * ⚠ NO HEADCOUNT IS CLAIMED ANYWHERE. Every figure is read back out of the
 * school's own published records — "35" is the arithmetic on two medal counts,
 * "21" is the Poomse entry, "A & B" is the NCC affiliation. "800+ students play
 * sport" would be the single most tempting invention on this page and the least
 * defensible.
 *
 * ⚠ THE MEDAL IMAGE IS NOT IN THIS BENTO, and that is deliberate. It is the
 * school's own portrait award POSTER, not a photograph — cropping it into a
 * landscape tile cuts its own headline off. It is shown whole, once, in §6 where
 * the record belongs. So this section has no image of students, which is the
 * honest state of the library; the figures are what carry it.
 */
import { getSportsPage } from '../../../lib/cms';
import CmsImage from '../../ui/CmsImage.astro';

/* ⚠ THE FIVE PHOTOGRAPHS COME FROM THE CMS; THE MOSAIC DOES NOT.
   Which tile each photograph occupies (spans a, c, e, g, i) is layout and stays
   here; the photographs themselves are content and are editable. They are read
   BY POSITION, so reordering them in the admin reorders the mosaic. */
const { figures, montage } = await getSportsPage();
import SectionHead from '../../academics/SectionHead.astro';

/* The bento, declared as data so the layout classes and the content cannot
   drift apart. `span` maps to a named area class below. */
const tiles = [
  { kind: 'photo', span: 'a', i: 0, alt: 'The JOSH ground at Sunbeam School Ballia, seen through the school gateway arch' },
  { kind: 'fig', span: 'b', i: 0 },
  { kind: 'photo', span: 'c', i: 1, alt: 'The basketball court at Sunbeam School Ballia' },
  { kind: 'fig', span: 'd', i: 1 },
  { kind: 'photo', span: 'e', i: 2, alt: 'The junior playground swings at Sunbeam School Ballia' },
  { kind: 'fig', span: 'f', i: 2 },
  { kind: 'photo', span: 'g', i: 3, alt: 'Volleyball nets on the JOSH ground at Sunbeam School Ballia' },
  { kind: 'fig', span: 'h', i: 3 },
  { kind: 'photo', span: 'i', i: 4, alt: 'Climbing frames in the junior playground at Sunbeam School Ballia' },
  { kind: 'fig', span: 'j', i: 4 },
] as const;
---

<section class="spp" id="participation" aria-labelledby="spp-title">
  <div class="u-container">
    <SectionHead
      id="spp-title"
      eyebrow="Who actually plays"
      heading="Student participation"
      stand="Every year group, every week — not a squad of specialists. The games period reaches Class I to Class XII, and the medal records are what tell us how far it goes."
      align="start"
      measure={18}
    />

    <div class="spp__bento">
      {tiles.map((t, n) =>
        t.kind === 'photo' ? (
          <figure class:list={['spp__tile', 'spp__tile--photo', `spp__tile--${t.span}`]} data-reveal data-reveal-delay={n * 55}>
            <CmsImage
              file={montage[t.i]?.image}
              alt={t.alt}
              sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 34vw"
              loading="lazy"
            fallbackWidth={760}
          />
          </figure>
        ) : (
          <div class:list={['spp__tile', 'spp__tile--fig', `spp__tile--${t.span}`]} data-reveal data-reveal-delay={n * 55}>
            <p class="spp__fig t-tabular">{figures[t.i].figure}</p>
            <p class="spp__label">{figures[t.i].label}</p>
            <p class="spp__note">{figures[t.i].note}</p>
          </div>
        )
      )}
    </div>
  </div>
</section>

<style>
  .spp {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  /* --- The bento -------------------------------------------------------------
     Six columns, explicit areas. A `grid-auto-flow: dense` masonry was tried
     first and rejected: dense flow reorders tiles by whatever happens to fit,
     which put two figure tiles side by side at some widths and broke the
     photo/figure alternation the whole composition depends on. Named areas make
     the rhythm fixed. */
  .spp__bento {
    margin-top: var(--sb-10);
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    grid-auto-rows: minmax(132px, auto);
    gap: clamp(12px, 1.1vw, 18px);
  }

  .spp__tile {
    margin: 0;
    position: relative;
    border-radius: var(--sb-r-2);
    overflow: hidden;
  }

  /* The lead frame — the only photograph we hold of students taking part. */
  .spp__tile--a { grid-column: span 3; grid-row: span 3; }
  .spp__tile--b { grid-column: span 3; grid-row: span 1; }
  .spp__tile--c { grid-column: span 2; grid-row: span 2; }
  .spp__tile--d { grid-column: span 1; grid-row: span 2; }
  .spp__tile--e { grid-column: span 2; grid-row: span 2; }
  .spp__tile--f { grid-column: span 2; grid-row: span 2; }
  .spp__tile--g { grid-column: span 2; grid-row: span 2; }
  .spp__tile--h { grid-column: span 2; grid-row: span 1; }
  .spp__tile--i { grid-column: span 2; grid-row: span 1; }
  .spp__tile--j { grid-column: span 2; grid-row: span 1; }

  /* --- Photo tiles ---------------------------------------------------------- */

  .spp__tile--photo { background: var(--sb-sand); }

  .spp__tile--photo :global(picture) { display: block; height: 100%; }

  .spp__tile--photo :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 800ms var(--sb-ease);
  }

  .spp__tile--photo:hover :global(img) { transform: scale(1.06); }

  /* --- Figure tiles ----------------------------------------------------------
     Paper, not ink: two ink tiles among five photographs read as holes in the
     grid. A hairline and a violet numeral carry them instead. */
  .spp__tile--fig {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: clamp(16px, 1.6vw, 26px);
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    transition: box-shadow var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  .spp__tile--fig:hover {
    box-shadow: inset 0 0 0 1px var(--sb-violet), 0 16px 34px rgba(28, 14, 8, 0.08);
    transform: translateY(-2px);
  }

  .spp__fig {
    font-family: var(--sb-font-display);
    font-size: clamp(30px, 3.2vw, 44px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.045em;
    color: var(--sb-violet);
  }

  .spp__label {
    margin-top: var(--sb-4);
    font-weight: 650;
    font-size: var(--sb-body-sm);
    line-height: 1.3;
    color: var(--sb-charcoal);
  }

  .spp__note {
    margin-top: var(--sb-2);
    font-size: var(--sb-caption);
    line-height: 1.5;
    color: var(--sb-text-muted);
  }

  @media (max-width: 1023px) {
    /* Four columns. The lead keeps its dominance; everything else pairs up. */
    .spp__bento { grid-template-columns: repeat(4, minmax(0, 1fr)); }

    .spp__tile--a { grid-column: span 4; grid-row: span 3; }
    .spp__tile--b { grid-column: span 2; grid-row: span 1; }
    .spp__tile--c { grid-column: span 2; grid-row: span 2; }
    .spp__tile--d { grid-column: span 2; grid-row: span 1; }
    .spp__tile--e,
    .spp__tile--f,
    .spp__tile--g { grid-column: span 2; grid-row: span 2; }
    .spp__tile--h,
    .spp__tile--i,
    .spp__tile--j { grid-column: span 2; grid-row: span 1; }
  }

  @media (max-width: 600px) {
    /* Two columns, and the figures go full width so a 44px numeral is never
       squeezed into a 150px tile. */
    .spp__bento { grid-template-columns: repeat(2, minmax(0, 1fr)); grid-auto-rows: minmax(112px, auto); }

    .spp__tile--a { grid-column: span 2; grid-row: span 2; }
    .spp__tile--c,
    .spp__tile--e,
    .spp__tile--g,
    .spp__tile--i { grid-column: span 1; grid-row: span 2; }
    .spp__tile--b,
    .spp__tile--d,
    .spp__tile--f,
    .spp__tile--h,
    .spp__tile--j { grid-column: span 1; grid-row: span 2; }
  }
</style>
