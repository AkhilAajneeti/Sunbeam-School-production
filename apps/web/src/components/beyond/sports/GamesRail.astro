---
import { getGames } from '../../../lib/cms';

/* ⚠ NOT DESTRUCTURED. getGames() RETURNS the { outdoor, indoor } object that
   this rail calls `games` — destructuring a `games` key off it yields undefined
   and the rail renders empty with no error. */
const games = await getGames();
/**
 * §2 · GAMES CONDUCTED THROUGH THE YEAR — the page's highlight.
 *
 * ═══ WHY THIS RAIL IS NOT PINNED, WHEN THE SITE'S OTHER RAIL IS ══════════════
 *
 * motion-gsap.ts will pin any `[data-rail-scope]` and scrub the track against
 * page scroll. StemRail uses that and it is superb — with SIX panels. This rail
 * has FIFTEEN. The pin distance is the track's own width, so pinning this would
 * hold the page still for roughly five screen-heights of scrolling in a single
 * section, on a page that has five more sections after it. `data-rail-nopin`
 * opts out and keeps the native scroller, the progress meter and the button
 * handshake, all of which the shared implementation still provides.
 *
 * The coverflow that the pin would have given us is instead driven from the
 * scroller's own `scrollLeft` in this component's script — same effect, same
 * custom properties, no scroll-jack. With no JavaScript at all the cards resolve
 * to flat, upright, full size, because every transform below is a var() with a
 * neutral fallback.
 *
 * ═══ WHY EIGHT CARDS CARRY A PHOTOGRAPH AND SEVEN DO NOT ════════════════════
 *
 * We hold twenty sports photographs and NOT ONE shows a child playing anything —
 * every ground shot is empty (see the note at the top of data/sports.ts). So a
 * card cannot show "football being played". What it can honestly show is the
 * ground football is played on, captioned as the ground.
 *
 * That is available for the eight OUTDOOR games and for none of the seven INDOOR
 * ones. Rather than hide the asymmetry, the design uses it: outdoor cards are
 * photographic, indoor cards are graphic, and the split falls exactly on the
 * school's own published outdoor/indoor division. A reader sees a deliberate
 * distinction, which is what it is — not a gallery with seven holes in it.
 *
 * The one true action photograph in the building — the Kho-Kho team with their
 * cluster medals — is on the Kho-Kho card, where it belongs.
 */
import CmsImage from '../../ui/CmsImage.astro';
import SectionHead from '../../academics/SectionHead.astro';
import SportIcon from './SportIcon.astro';

const all = [
  ...games.outdoor.map((g) => ({ ...g, group: 'Outdoor' as const })),
  ...games.indoor.map((g) => ({ ...g, group: 'Indoor' as const })),
];
---

{/* data-rail-scope: the meter lives in the head, a SIBLING of the scroller, so
    --rail-progress has to be written to a shared ancestor. */}
<section class="grail" id="games" data-rail-scope data-rail-nopin aria-labelledby="grail-title">
  <div class="u-container grail__head-wrap">
    <SectionHead
      id="grail-title"
      eyebrow="The highlight of the page"
      heading="Games conducted throughout the year"
      stand="Fifteen games, indoor and out — the full roster the school runs. Eight on the grounds, seven inside."
      align="start"
      tone="dark"
      measure={18}
      class="grail__head"
    />

    <div class="grail__controls">
      <div class="grail__meter" aria-hidden="true"><span class="grail__meter-fill"></span></div>

      {/* Ships `hidden`; the script reveals it. With JS blocked there are no dead
          controls, and the rail still drags, flicks, shift-wheels and arrows. */}
      <div class="grail__btns" data-grail-btns hidden>
        <button class="grail__btn" type="button" data-grail-prev aria-label="Previous games">
          <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
        <button class="grail__btn" type="button" data-grail-next aria-label="More games">
          <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  <div
    class="grail__viewport"
    data-rail
    data-grail-viewport
    tabindex="0"
    role="region"
    aria-label="The fifteen games on the school roster — scroll sideways for more"
  >
    <ol class="grail__track" data-rail-track>
      {all.map((g, i) => (
        <li
          class:list={['gcard', g.photo ? 'gcard--shot' : 'gcard--mark']}
          style={`--t:${i % 3}`}
          data-rail-item
        >
          <article class="gcard__in">
            {g.photo && (
              <span class="gcard__media" aria-hidden="true">
                <CmsImage
                  file={g.photo}
                  alt=""
                  sizes="(max-width: 700px) 74vw, 30vw"
                  loading="lazy"
              fallbackWidth={760}
            />
              </span>
            )}

            {/* The watermark on a graphic card. Large, low-contrast, clipped by
                the frame — it gives the card a subject without pretending to be
                a photograph of one. */}
            {!g.photo && (
              <span class="gcard__wm" aria-hidden="true">
                <SportIcon name={g.icon} size={260} />
              </span>
            )}

            <p class="gcard__top">
              <span class="gcard__i t-tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="gcard__grp">{g.group}</span>
            </p>

            <div class="gcard__body">
              <span class="gcard__plate"><SportIcon name={g.icon} size={22} /></span>
              <h3 class="gcard__h">{g.name}</h3>
              <p class="gcard__b">{g.blurb}</p>

              {/* Only where it says something the pill above has not. Every
                  indoor game's venue IS "Indoor", and printing that under a card
                  already badged INDOOR was the same word twice. */}
              {g.venue !== g.group && <p class="gcard__venue">{g.venue}</p>}
            </div>
          </article>
        </li>
      ))}

      {/* A real element, not padding: Chrome omits a flex container's end padding
          from scrollWidth, which leaves the last card unable to reach the right
          margin. aria-hidden because it is empty spacing. */}
      <li class="grail__tail" data-rail-tail aria-hidden="true"></li>
    </ol>
  </div>
</section>

<style>
  .grail {
    position: relative;
    padding-block: var(--sb-section-y);
    background: var(--sb-violet-ink);
    color: var(--sb-on-dark-78);
    overflow: hidden;
  }

  /* A single wide glow behind the track, so the dark band is not flat ink. */
  .grail::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 34%;
    width: min(1200px, 120%);
    aspect-ratio: 2 / 1;
    transform: translateX(-50%);
    background: radial-gradient(ellipse at center, rgba(201, 60, 10, 0.22), transparent 68%);
    pointer-events: none;
  }

  .grail__head-wrap {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(32px, 5vh, 56px);
  }

  /* --- Controls ------------------------------------------------------------- */

  .grail__controls { display: flex; align-items: center; gap: var(--sb-5); }

  .grail__meter {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: var(--sb-r-full);
    background: rgba(255, 255, 255, 0.16);
    overflow: hidden;
  }

  .grail__meter-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--sb-lime);
    transform-origin: left;
    /* var() fallback, not a hard 0: with the motion chunk absent nothing writes
       the property and the bar stays empty, which is honest. */
    transform: scaleX(var(--rail-progress, 0));
    transition: transform 120ms linear;
  }

  .grail__btns { display: flex; gap: var(--sb-3); flex-shrink: 0; }

  /* `display: flex` would otherwise beat the `hidden` attribute's UA rule. */
  .grail__btns[hidden] { display: none; }

  .grail__btn {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.24);
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.06);
    color: #fff;
    cursor: pointer;
    transition: background var(--sb-dur-btn) ease, border-color var(--sb-dur-btn) ease, transform var(--sb-dur-btn) var(--sb-ease);
  }

  .grail__btn:hover:not(:disabled) {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    transform: translateY(-2px);
  }

  .grail__btn:disabled { opacity: 0.3; cursor: default; }

  /* --- Viewport and track --------------------------------------------------- */

  /* ⚠ CONTAINER-BOUND — client instruction: the cards must not touch the
     viewport's left and right edges. The rail is the container's width and
     centred, so the row is clipped on the same line the heading is set to. */
  .grail__viewport {
    position: relative;
    width: min(100vw - 2 * var(--sb-margin), var(--sb-max-content));
    margin-inline: auto;
    border-radius: var(--sb-r-2);
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* Zero now the track has no inset: card one satisfies its own
       `snap-align: start` at scrollLeft 0, which is what keeps the rail from
       loading part-scrolled with "previous" already enabled. */
    scroll-padding-inline: 0;
    scrollbar-width: none;
  }

  /* Snap would pull the rail back to the nearest card on every frame and the
     drift would stall. Set by the script only while it is actually drifting. */
  .grail__viewport[data-auto] { scroll-snap-type: none; }

  .grail__viewport::-webkit-scrollbar { display: none; }

  .grail__viewport:focus-visible {
    outline: 2px solid var(--sb-lime);
    outline-offset: -4px;
  }

  /* The drag cursor is only applied once the script has taken over. */
  .grail__viewport[data-dragging] { scroll-snap-type: none; cursor: grabbing; }

  .grail__track {
    display: flex;
    align-items: stretch;
    gap: clamp(14px, 1.4vw, 22px);
    list-style: none;
    margin: 0;
    padding-block: 10px 26px;
    padding-inline: 0;
  }

  /* Zero now the rail is the container: card one already starts on the
     container line and the last already finishes on it. The element stays
     because motion-gsap.ts measures a rail's end from `[data-rail-tail]`. */
  .grail__tail { flex: 0 0 0; }

  /* --- Card ------------------------------------------------------------------
     THE SNAP TARGET IS NEVER TRANSFORMED. `.gcard` carries scroll-snap-align and
     stays untouched; the lean is applied to `.gcard__in` inside it. Chromium
     computes a snap area from the element's TRANSFORMED box, so leaning the snap
     target itself moved its own start edge — measured exactly that: the rail
     loaded resting at scrollLeft 12 instead of 0, which left "previous" enabled
     before anyone had scrolled and the progress meter reading 9% at rest.

     Custom properties inherit, so the script still writes them to `.gcard`. */
  .gcard {
    flex: 0 0 clamp(230px, 25vw, 320px);
    scroll-snap-align: start;
  }

  .gcard__in {
    /* THE TRANSFORM IS DECLARED HERE AND ONLY THE VARIABLES ARE SCRIPTED, so
       every state that never runs the script — no JS, reduced motion, Save-Data
       — resolves to a flat, upright, full-size card rather than to nothing.

       `perspective()` is part of the expression rather than a `perspective`
       property on the scroller, because that property only reaches its DIRECT
       children and the card is two levels down (viewport → track → card). */
    transform:
      perspective(1500px)
      rotateY(var(--pan-turn, 0deg))
      scale(var(--pan-scale, 1));
    transform-origin: center center;
    transition: transform 120ms linear, box-shadow var(--sb-dur-image) var(--sb-ease);
    will-change: transform;
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    height: clamp(360px, 46vh, 440px);
    padding: var(--sb-6);
    border-radius: var(--sb-r-3);
    overflow: hidden;
    background: #17100c;
    box-shadow: 0 1px 0 rgba(255, 255, 255, 0.06) inset, 0 24px 48px rgba(0, 0, 0, 0.34);
  }

  .gcard:hover .gcard__in { box-shadow: 0 1px 0 rgba(255, 255, 255, 0.14) inset, 0 30px 60px rgba(0, 0, 0, 0.46); }

  /* --- Photographic cards --------------------------------------------------- */

  .gcard__media { position: absolute; inset: 0; z-index: -2; }

  .gcard__media :global(picture) { display: block; height: 100%; }

  .gcard__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 900ms var(--sb-ease);
  }

  .gcard:hover .gcard__media :global(img) { transform: scale(1.07); }

  /* The ramp is ::after and NOT ::before, and the z-index is -1 against the
     media's -2. Both at -1 would paint in tree order and put the scrim UNDER the
     photograph — measured at 1.1:1 on an earlier section of this site. */
  .gcard--shot .gcard__in::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    /* Heavier at the top than a normal caption ramp would be. These are
       landscape photographs in a portrait card, so `cover` fits them to the
       card's HEIGHT — which means the full sky is always in frame and roughly
       the top third of every outdoor card is blank white sky. Carrying the ramp
       up to 0.58 turns that band into a tinted field the card's own dark ground
       agrees with, instead of a pale rectangle. */
    background: linear-gradient(
      6deg,
      rgba(10, 6, 4, 0.96) 6%,
      rgba(10, 6, 4, 0.86) 34%,
      rgba(10, 6, 4, 0.64) 62%,
      rgba(10, 6, 4, 0.58) 100%
    );
  }

  /* --- Graphic cards ---------------------------------------------------------
     Three tints on rotation so seven indoor cards do not read as one card
     repeated. --t comes off the card's index. */
  .gcard--mark .gcard__in {
    background:
      radial-gradient(120% 80% at 20% 0%, rgba(255, 255, 255, 0.07), transparent 60%),
      linear-gradient(165deg, var(--tint-a), #14100e 72%);
  }

  .gcard--mark { --tint-a: #2a160c; }
  .gcard--mark[style*='--t:1'] { --tint-a: #2a1f0c; }
  .gcard--mark[style*='--t:2'] { --tint-a: #17210f; }

  .gcard__wm {
    position: absolute;
    right: -58px;
    top: 42%;
    z-index: -1;
    color: rgba(255, 255, 255, 0.075);
    transform: translateY(-50%) rotate(-8deg);
    transition: transform 900ms var(--sb-ease), color 400ms ease;
  }

  .gcard:hover .gcard__wm {
    transform: translateY(-50%) rotate(-4deg) scale(1.06);
    color: rgba(255, 255, 255, 0.11);
  }

  /* --- Card contents --------------------------------------------------------- */

  .gcard__top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-4);
  }

  .gcard__i {
    font-family: var(--sb-font-display);
    font-size: 15px;
    font-weight: 700;
    color: rgba(255, 255, 255, 0.42);
  }

  .gcard__grp {
    padding: 4px 10px;
    border-radius: var(--sb-r-full);
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(6px);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.86);
  }

  .gcard__plate {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    margin-bottom: var(--sb-5);
    border-radius: 12px;
    background: rgba(255, 255, 255, 0.1);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, 0.16);
    color: #fff;
    transition: background var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  .gcard:hover .gcard__plate { background: var(--sb-violet); transform: translateY(-3px); }

  .gcard__h {
    font-family: var(--sb-font-display);
    font-size: clamp(21px, 1.6vw, 26px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.025em;
    color: #fff;
  }

  .gcard__b {
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.74);
  }

  /* Captions THE PHOTOGRAPH, not the sport — the frame above shows an empty
     ground, and this says which ground. */
  .gcard__venue {
    margin-top: var(--sb-5);
    padding-top: var(--sb-4);
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--sb-lime);
  }

  @media (max-width: 900px) {
    .grail__head-wrap { grid-template-columns: minmax(0, 1fr); }
    .grail__controls { margin-top: var(--sb-6); }
  }

  @media (max-width: 700px) {
    .gcard { flex: 0 0 74vw; }
    .gcard__in { height: clamp(340px, 60vh, 420px); }
    .gcard__wm :global(svg) { width: 200px; height: 200px; }
  }

  /* The lean is decoration; someone who has asked for less motion gets a flat
     row, and the script never starts. */
  @media (prefers-reduced-motion: reduce) {
    .gcard__in { transform: none; transition: none; }
  }
</style>

<script>
  /**
   * The rail's three scripted behaviours: arrows, pointer drag, and coverflow.
   *
   * EVERYTHING HERE IS AN ENHANCEMENT. The rail underneath is a real `overflow-x`
   * scroller with scroll-snap, which already gives flick, trackpad, shift-wheel,
   * arrow keys, deep links and screen-reader scrolling for free. Nothing below is
   * load-bearing; with this file blocked the section still works completely.
   */
  const section = document.querySelector<HTMLElement>('.grail');
  const view = section?.querySelector<HTMLElement>('[data-grail-viewport]');
  const btns = section?.querySelector<HTMLElement>('[data-grail-btns]');

  if (section && view && btns) {
    const prev = btns.querySelector<HTMLButtonElement>('[data-grail-prev]')!;
    const next = btns.querySelector<HTMLButtonElement>('[data-grail-next]')!;
    const cards = [...view.querySelectorAll<HTMLElement>('[data-rail-item]')];
    btns.hidden = false;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

    /* ── Coverflow ────────────────────────────────────────────────────────────
       The same effect motion-gsap.ts applies to a PINNED rail, driven here from
       the native scroll position instead — see the header note on why this rail
       is not pinned.

       Positions come from `offsetLeft`, read once per resize, not from
       getBoundingClientRect on every frame: this runs across fifteen cards on
       every scroll frame, and forcing fifteen layout flushes per frame is how a
       smooth rail becomes a stuttering one on a mid-range laptop. offsetLeft
       cannot change while only the scroll position moves. */
    let mids: number[] = [];
    const measure = () => { mids = cards.map((c) => c.offsetLeft + c.offsetWidth / 2); };

    let frame = 0;
    const draw = () => {
      frame = 0;
      const half = view.clientWidth / 2;
      if (!half) return;
      const x = view.scrollLeft;
      for (let i = 0; i < cards.length; i++) {
        // -1 at the far left of the viewport, 0 dead centre, +1 at the far right.
        const d = Math.max(-1.3, Math.min(1.3, (mids[i] - x - half) / half));
        const away = Math.abs(d);
        cards[i].style.setProperty('--pan-scale', (1 - away * 0.1).toFixed(4));
        cards[i].style.setProperty('--pan-turn', (-d * 11).toFixed(2) + 'deg');
      }
    };

    const onScroll = () => {
      if (!frame && !reduced.matches) frame = requestAnimationFrame(draw);
      sync();
    };

    /* ── Buttons ──────────────────────────────────────────────────────────────
       A step is ONE CARD, measured from the DOM. The card basis and the gap are
       both clamp()s, so any number hard-coded here would be wrong at most
       viewport widths. */
    const pitch = () =>
      cards.length > 1
        ? cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left
        : view.clientWidth * 0.8;

    /* Disabled at the ends rather than silently doing nothing. The 2px slack
       absorbs fractional scroll positions, which otherwise leave "next" enabled
       for ever at the right-hand end on non-integer device pixel ratios. */
    const sync = () => {
      const max = view.scrollWidth - view.clientWidth;
      prev.disabled = view.scrollLeft <= 2;
      next.disabled = view.scrollLeft >= max - 2;

      /* The progress meter, written here as well as by motion-gsap.ts. The
         shared writer only runs when the GSAP chunk loads at all; this rail is
         perfectly usable without it, and a meter that sits empty while the rail
         scrolls looks broken. Both write the same value, so they cannot
         disagree. */
      section.style.setProperty('--rail-progress', max > 0 ? String(view.scrollLeft / max) : '1');
    };

    const step = (dir: number) =>
      view.scrollBy({ left: dir * pitch(), behavior: reduced.matches ? 'auto' : 'smooth' });

    /* ═══ SMOOTH AUTO-SCROLL ════════════════════════════════════════════════
     *
     * A continuous drift at a walking pace, not a jump every two seconds — a
     * stepped autoplay on a coverflow reads as a series of lurches because each
     * jump restarts the lean on every card it passes.
     *
     * ⚠ IT REVERSES AT THE ENDS RATHER THAN LOOPING, and that is a deliberate
     * difference from the record rails on this page, which do clone their cards
     * into a seamless loop. Three things here make cloning the wrong call:
     *
     *   · THE PROGRESS METER measures `scrollWidth - clientWidth`. Doubling the
     *     track would leave it permanently reading half, and a meter that never
     *     fills is worse than no meter.
     *   · THE COVERFLOW leans each card by its distance from the rail's centre,
     *     from a `cards` array captured at start-up. Clones appended later would
     *     sit flat among leaning neighbours.
     *   · A meter only means anything on a FINITE list. Fifteen games with a
     *     position indicator is a different object from an endless gallery of
     *     photographs, and it should not pretend otherwise.
     *
     * Three gates, as everywhere else on this page: on-screen only, never under
     * reduced motion, and paused while the reader is in it — with any drag,
     * wheel or button press stopping it for good. The buttons are the WCAG
     * 2.2.2 pause mechanism.
     */
    const SPEED = 34; // px per second
    let raf = 0;
    let last = 0;
    let pos = 0;
    let dir = 1;
    let onScreen = false;
    let held = false;
    let stopped = false;

    const drift = (t: number) => {
      if (!last) last = t;
      /* `pos` is the source of truth and is never read back from scrollLeft:
         that value is quantised to the device pixel grid, so re-reading it
         compounds the rounding and the rail accelerates. Measured on the record
         rails: 61px/s against a 34px/s setting. */
      pos += (SPEED * dir * (t - last)) / 1000;
      last = t;
      const max = view.scrollWidth - view.clientWidth;
      if (pos >= max) { pos = max; dir = -1; }
      else if (pos <= 0) { pos = 0; dir = 1; }
      view.scrollLeft = pos;
      raf = requestAnimationFrame(drift);
    };

    const run = () => {
      if (raf || stopped || held || !onScreen || reduced.matches) return;
      if (view.scrollWidth <= view.clientWidth + 4) return;
      view.dataset.auto = 'true';
      last = 0;
      pos = view.scrollLeft;
      raf = requestAnimationFrame(drift);
    };

    const halt = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
      delete view.dataset.auto;
    };

    /** Permanent: the reader has taken control of this rail. */
    const stopAuto = () => {
      stopped = true;
      halt();
    };

    const hold = (on: boolean) => {
      held = on;
      on ? halt() : run();
    };

    view.addEventListener('pointerenter', () => hold(true));
    view.addEventListener('pointerleave', () => hold(false));
    section.addEventListener('focusin', () => hold(true));
    section.addEventListener('focusout', () => hold(false));
    view.addEventListener('wheel', stopAuto, { passive: true });

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        onScreen ? run() : halt();
      },
      { threshold: 0.35 },
    ).observe(view);

    reduced.addEventListener('change', () => (reduced.matches ? halt() : run()));

    prev.addEventListener('click', () => {
      stopAuto();
      step(-1);
    });
    next.addEventListener('click', () => {
      stopAuto();
      step(1);
    });

    /* ── Pointer drag ─────────────────────────────────────────────────────────
       MOUSE AND PEN ONLY. Touch is excluded deliberately: a phone already drags
       this rail natively with momentum, and intercepting the pointer there
       replaces good native scrolling with a worse hand-written copy.

       Snap is switched off for the duration of the drag — a mandatory snap point
       fights every frame of a drag and the rail sticks. */
    let down = false;
    let startX = 0;
    let startLeft = 0;
    let moved = 0;

    view.addEventListener('pointerdown', (e) => {
      if (e.pointerType === 'touch') return;
      down = true;
      /* A drag is the reader taking over — the drift must not resume under
         their hand, and it must not fight the drag frame by frame. */
      stopAuto();
      moved = 0;
      startX = e.clientX;
      startLeft = view.scrollLeft;
      view.setPointerCapture(e.pointerId);
      view.dataset.dragging = 'true';
    });

    view.addEventListener('pointermove', (e) => {
      if (!down) return;
      const dx = e.clientX - startX;
      moved = Math.abs(dx);
      view.scrollLeft = startLeft - dx;
    });

    const release = (e: PointerEvent) => {
      if (!down) return;
      down = false;
      delete view.dataset.dragging;
      if (view.hasPointerCapture(e.pointerId)) view.releasePointerCapture(e.pointerId);
    };

    view.addEventListener('pointerup', release);
    view.addEventListener('pointercancel', release);

    /* A drag that ends on a link must not also count as a click on it. There are
       no links inside these cards today, but the guard costs nothing and stops
       that becoming a bug the day one is added. */
    view.addEventListener('click', (e) => { if (moved > 6) { e.preventDefault(); e.stopPropagation(); } }, true);

    view.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', () => { measure(); draw(); sync(); });

    measure();
    draw();
    sync();
  }
</script>
