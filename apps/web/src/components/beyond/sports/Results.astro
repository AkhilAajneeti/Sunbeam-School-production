---
import { getSportsRecord } from '../../../lib/cms';

const record = await getSportsRecord();
/**
 * §7 · RESULTS — every published placing, in one board.
 *
 * ═══ WHY THIS SECTION EXISTS ═══════════════════════════════════════════════
 *
 * Client: "can we create another section where all results regarding games are
 * shown in one section, and make these sections independent."
 *
 * The placings used to sit inside the record blocks in §6, and they were doing
 * two incompatible jobs at once:
 *
 *   · DISTRICT HANDBALL's three rows are the school's OWN honours — Junior Boys
 *     1st, Senior Boys 2nd, Girls 1st.
 *   · ASMITA's nine rows are a TOURNAMENT SCOREBOARD. Sunbeam hosted that
 *     league, so the published results list every competitor — and only two of
 *     the nine name Sunbeam at all. The volleyball podium names no Sunbeam side
 *     whatsoever.
 *
 * Inside a block headed "Asmita Khelo India Women's League", nine rows mostly
 * naming other schools read as the school's own record. Pulled out into a
 * board of their own they read as what they are: the results of competitions
 * the school ran or entered, where naming the field is correct and is in fact
 * the proof that a real district-level league took place on the school ground.
 *
 * ⚠ NOTHING WAS DROPPED. Every placing the school published is here, verbatim.
 * The change is where it sits, not what it says.
 *
 * ═══ CONSEQUENCE FOR §6 ════════════════════════════════════════════════════
 *
 * All fourteen record blocks are now the same object — kicker, heading,
 * account, gallery — which is what makes the page's one repeated unit actually
 * repeat. It also puts the photographs directly under each heading, which is
 * the evidence audit 4.8 asks for and which ~250px of tabular type used to
 * push below the fold.
 *
 * ═══ NOT CARDS ═════════════════════════════════════════════════════════════
 *
 * A ruled board, not a grid of boxes. Three podium cards in a row was the
 * pattern docs/05 § H5 rules out, and it appeared nowhere else on this page.
 * Results are read by scanning a column of placings, so the placings share a
 * column and the rules do the separating.
 */
import SectionHead from '../../academics/SectionHead.astro';

/* Only the blocks that actually published placings. Computed, never typed — a
   hard-coded list would go stale the moment a result is added to the data. */
const boards = record.filter((r) => r.podiums && r.podiums.length > 0);

/**
 * Splits a published placing into its rank and its label.
 *
 * ⚠ THE TWO SOURCES PUT THEM IN OPPOSITE ORDERS, and assuming one of them was
 * a real bug caught on screen: Asmita publishes "1st — Sunbeam School Ballia"
 * (rank first), District Handball publishes "Junior Boys — 1st" (rank LAST,
 * because every team in that list is Sunbeam's so the label is the age group).
 * A naive left-of-the-dash split put "Junior Boys" in the rank column and "1st"
 * in the name column.
 *
 * So the rank is identified by what it looks like — an ordinal — rather than by
 * where it sits. A placing with no dash at all falls through as a label with no
 * rank rather than throwing.
 */
const ORDINAL = /^\d+\s*(st|nd|rd|th)\b/i;

const split = (place: string) => {
  const [head, ...rest] = place.split('—');
  const a = head.trim();
  const b = rest.join('—').trim();
  if (!b) return { rank: ORDINAL.test(a) ? a : '', name: ORDINAL.test(a) ? '' : a };
  return ORDINAL.test(a) ? { rank: a, name: b } : { rank: b, name: a };
};
---

<section class="res" id="results" aria-labelledby="res-title">
  <div class="u-container">
    <SectionHead
      id="res-title"
      eyebrow="Every placing, in one place"
      heading="Results"
      stand="The published results of the competitions the school has hosted and entered — the full field, as they were announced."
      align="start"
      measure={18}
    />

    <div class="res__boards">
      {boards.map((b, i) => (
        <article class="res__board" data-reveal data-reveal-delay={i * 90}>
          <header class="res__head">
            <p class="res__kicker t-label">{b.kicker}</p>
            <h3 class="res__h">{b.title}</h3>
          </header>

          <div class="res__events">
            {b.podiums!.map((p) => (
              <div class="res__event">
                <p class="res__event-name">{p.event}</p>
                <ol class="res__places">
                  {p.places.map((place) => {
                    const { rank, name } = split(place);
                    return (
                      <li class="res__place">
                        <span class="res__rank t-tabular">{rank}</span>
                        {/* An em dash with no name after it means the school
                            published a rank alone — District Handball's rows are
                            "Junior Boys — 1st" and carry no school name because
                            every one of them is Sunbeam's. */}
                        {name && <span class="res__name">{name}</span>}
                      </li>
                    );
                  })}
                </ol>
              </div>
            ))}
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .res {
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  .res__boards {
    margin-top: var(--sb-10);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(30px, 4vh, 52px);
  }

  .res__board {
    padding-top: clamp(24px, 3vh, 36px);
    border-top: 2px solid var(--sb-violet);
  }

  /* ⚠ --sb-violet-dark, NOT --sb-violet — and this is a repeat of a mistake the
     project has already made and written down. On the SAND ground the lighter
     brand tone measures 4.35:1, under AA, and both the kicker (12px) and the
     rank (15px/700) are small text so neither qualifies for the large-text
     allowance. The darker tone clears at 6.07:1. JourneyCarousel carries the
     same note for its own eyebrow; sand is simply too close to the brand
     orange for it to be used as small type. */
  .res__kicker { color: var(--sb-violet-dark); }

  .res__h {
    margin-top: var(--sb-3);
    font-family: var(--sb-font-display);
    font-size: clamp(21px, 2vw, 28px);
    font-weight: 700;
    line-height: 1.12;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .res__events {
    margin-top: var(--sb-6);
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(20px, 2.4vw, 36px);
  }

  .res__event-name {
    padding-bottom: var(--sb-3);
    border-bottom: var(--sb-hairline);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }

  .res__places {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The rank sits in its own column so nine placings read straight down the
     page — which is the whole reason a result is a table and not a sentence. */
  .res__place {
    display: grid;
    grid-template-columns: 3.2em minmax(0, 1fr);
    gap: var(--sb-4);
    align-items: baseline;
    padding-block: 9px;
    border-bottom: var(--sb-hairline);
  }

  .res__rank {
    font-weight: 700;
    font-size: var(--sb-body-sm);
    color: var(--sb-violet-dark); /* 6.07:1 on sand — see the kicker's note. */
  }

  .res__name {
    font-size: var(--sb-body-sm);
    line-height: 1.45;
    color: var(--sb-charcoal);
  }

  /* Three events across on desktop — they are parallel and short, so a column
     each reads faster than one list of nine. A board with a single event keeps
     its one column rather than stretching across three. */
  @media (min-width: 760px) {
    .res__events { grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
    .res__board:has(.res__event:only-child) .res__events {
      grid-template-columns: minmax(0, 340px);
    }
  }
</style>
