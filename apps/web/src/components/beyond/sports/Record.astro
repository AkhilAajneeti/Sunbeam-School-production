---
/**
 * §6 · THE RECORD — the live page's structure, in this site's styling.
 *
 * ═══ WHAT THE CLIENT ASKED FOR ══════════════════════════════════════════════
 *
 * Their own Sports & Games page, rebuilt: a block per achievement — heading, the
 * account, and that achievement's own photographs — repeated down the page. They
 * chose "same structure, our styling", so the shape is theirs and the type,
 * colour, spacing and carousel are the site's.
 *
 * WHAT THE ORIGINAL GETS RIGHT and this keeps: every achievement carries its own
 * pictures. That is the only thing a reader is really here for.
 *
 * WHAT IT GETS WRONG and this fixes:
 *   · the photographs are 150×150 thumbnails — of a medal ceremony, which at
 *     that size communicates nothing (docs/01 §109 objects to exactly this).
 *     Here they are 300–420px in a scrollable gallery;
 *   · podiums are buried in running prose. Where the school published placings
 *     they are set as a result list — but in §7 Results rather than here, so
 *     every one of these fourteen blocks is the same object. See the note in
 *     the markup below;
 *   · every block looks identical with no indication of level. A kicker line
 *     now says district / state / national / hosted before the heading.
 *
 * ═══ THE GALLERY ═══════════════════════════════════════════════════════════
 *
 * A real `overflow-x` scroller with scroll-snap — flick, trackpad, shift-wheel,
 * arrow keys, a scrollbar and screen-reader scrolling all work with no
 * JavaScript. The arrows are the only scripted part and ship `hidden`, so with
 * the script blocked there are no dead controls and the rail still works.
 *
 * ⚠ ONE SCRIPT, MANY RAILS. There are fourteen galleries on this page. The
 * script therefore binds PER RAIL inside a loop over `[data-rec-rail]` — an
 * earlier component on this site used `document.querySelector` for a single rail
 * and copying that pattern here would wire up block one and silently leave the
 * other thirteen inert.
 */
import CmsImage from '../../ui/CmsImage.astro';
import { getSportsRecord } from '../../../lib/cms';

/* ⚠ NO `shot` LOOKUP ANY MORE. The source stored filenames that indexed a
   Vite-glob map; each record now carries its photographs directly, so
   `r.shots` is StrapiFile[] and needs no resolution step. */
const record = await getSportsRecord();
import SectionHead from '../../academics/SectionHead.astro';
---

<section class="rec" id="record" aria-labelledby="rec-title">
  <div class="u-container">
    <SectionHead
      id="rec-title"
      eyebrow="And then the results"
      heading="The record"
      stand="Fourteen years of it — the leagues the school hosts, the camps it runs, and what its teams have brought back."
      align="start"
      measure={18}
    />
  </div>

  {record.map((r, i) => (
    <article class="rblk" id={r.id}>
      <div class="u-container rblk__head">
        <p class="rblk__kicker t-label">{r.kicker}</p>
        <h3 class="rblk__h">{r.title}</h3>

        <div class="rblk__prose">
          <p class="rblk__b">{r.body}</p>
          {r.more && <p class="rblk__b rblk__b--more">{r.more}</p>}
        </div>

        {/* ⚠ NO PLACINGS HERE ANY MORE — they are all in §7 Results, and this
            is a structural decision rather than a tidy-up.

            Only 2 of these 14 blocks ever had `podiums`, and the two were not
            the same kind of thing. District Handball's three rows are all the
            school's own. ASMITA'S NINE ROWS ARE A TOURNAMENT SCOREBOARD — the
            school HOSTED that league, so the published results list every
            competitor, and only two of the nine name Sunbeam at all. The Volleyball
            podium names no Sunbeam side whatsoever.

            Rendered inside a record block, that read as the school's own honours
            when most of it is other schools', and it put ~250px of small tabular
            type between the heading and the photographs — the evidence audit 4.8
            actually asks for. It also put three cards in a row on the one page
            that has them nowhere else (docs/05 § H5).

            Moved wholesale, the results become what they are: the scoreboard of
            competitions the school ran or entered. Naming rivals is correct
            there, and every block on this page is now the same object. */}
      </div>

      {/* The gallery bleeds off the right edge: a row cut by the viewport is the
          clearest signal that there is more of it. */}
      <div class="rblk__rail-wrap">
        <div
          class="rblk__rail"
          data-rec-rail
          tabindex="0"
          role="region"
          aria-label={`Photographs — ${r.title}. Scroll sideways for more.`}
        >
          <ul class="rblk__track">
            {r.shots.map((s, si) => (
              <li class="rblk__frame">
                <CmsImage
                  file={s}
                  alt={si === 0 ? r.alt : ''}
                  sizes="(max-width: 700px) 78vw, 380px"
                  loading={i < 2 ? 'eager' : 'lazy'}
                  fallbackWidth={760}
                />
              </li>
            ))}
            {/* A real element: Chrome omits a flex container's end padding from
                scrollWidth, so the last frame could never reach the margin. */}
            <li class="rblk__tail" aria-hidden="true"></li>
          </ul>
        </div>

        {r.shots.length > 2 && (
          /* Sat above the rail as a pair in the top-right corner; now one on
             each edge, vertically centred on the cards, per the reference. */
          <div class="rblk__btns" data-rec-btns hidden>
            <button class="rblk__btn rblk__btn--prev" type="button" data-rec-prev aria-label={`Previous photographs from ${r.title}`}>
              <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </button>
            <button class="rblk__btn rblk__btn--next" type="button" data-rec-next aria-label={`More photographs from ${r.title}`}>
              <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
                <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </button>
          </div>
        )}
      </div>
    </article>
  ))}
</section>

<style>
  .rec {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .rblk {
    padding-top: clamp(40px, 6vh, 76px);
  }

  /* A hairline between blocks — fourteen of them need a boundary, and a rule is
     quieter than fourteen boxes. */
  .rblk + .rblk .rblk__head::before {
    content: '';
    display: block;
    height: 1px;
    margin-bottom: clamp(32px, 5vh, 60px);
    background: var(--sb-border);
  }

  /* CENTRED HEAD — client instruction, matching the supplied reference: eyebrow,
     heading and the account stacked on the centre line, then the cards beneath.
     `margin-inline: auto` on the measures rather than a wrapper, so the hairline
     above still spans the full container. */
  .rblk__head { text-align: center; }

  .rblk__kicker { color: var(--sb-violet); }

  .rblk__h {
    margin-top: var(--sb-4);
    max-width: 22ch;
    margin-inline: auto;
    font-family: var(--sb-font-display);
    font-size: clamp(23px, 2.6vw, 38px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.033em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .rblk__prose { margin-top: var(--sb-5); }

  /* 58ch, not 62 — a centred paragraph is read from a ragged left edge, so the
     eye has to find the start of every line. A shorter measure is what makes
     that survivable; docs/05 § I2 warns against centring prose at all. */
  .rblk__b {
    max-width: 58ch;
    margin-inline: auto;
    font-size: clamp(16px, 1.25vw, 19px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }

  .rblk__b--more { margin-top: var(--sb-4); }

  /* --- The gallery ---------------------------------------------------------- */

  /* One place the rail's arithmetic is defined, so the card width, the track's
     padding and the arrows' offsets all resolve from the same two numbers.
     --rblk-gutter is the distance from the viewport edge to the container's
     content edge; --rblk-w is the container's own width. */
  /* ⚠ CONTAINER-BOUND, NOT FULL-BLEED — client instruction: the cards must not
     touch the viewport's left and right edges. The rail is therefore exactly
     the container's width and centred, so the row is clipped on the container
     line — the same line the heading above it is set to. The loop still keeps a
     card under each edge; it is now the container's edge rather than the
     window's. */
  .rblk__rail-wrap {
    position: relative;
    margin-top: clamp(26px, 3.4vh, 44px);
    width: var(--rblk-w);
    margin-inline: auto;

    --rblk-per: 1.15;
    --rblk-gap: clamp(10px, 1vw, 20px);
    --rblk-w: min(100vw - 2 * var(--sb-margin), var(--sb-max-content));
  }

  .rblk__rail {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    /* Must match the track's left padding, or frame one can only satisfy its own
       snap by resting part-scrolled — which leaves the rail loading at an offset
       and "previous" enabled before anyone has scrolled. */
    scroll-padding-inline: 0;
    scrollbar-width: none;
    border-radius: var(--sb-r-2);

    /* THE EDGE FADE from the reference — the cards do not stop, they dissolve.
       3% at each end, which at 1440 is 43px and therefore lands INSIDE the 80px
       gutter: card one is never dimmed at rest, only the neighbours peeking past
       the container edge are. A wider fade would grey the first card's edge and
       read as a rendering fault. */
    -webkit-mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
    mask-image: linear-gradient(to right, transparent 0, #000 3%, #000 97%, transparent 100%);
  }

  .rblk__rail::-webkit-scrollbar { display: none; }

  /* Set by the script on rails it has cloned into a loop. See the drift note. */
  .rblk__rail[data-loop] { scroll-snap-type: none; }

  .rblk__rail:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: -3px; }

  /* ⚠ NO GUTTER PADDING — the row runs edge to edge.
     It used to start at the container line, which left an 80px white margin on
     the left while cards ran off the right: a row that had been cut, not a
     slider. In the reference the cards are clipped at BOTH edges, which is what
     says there is more of them in both directions. The loop in the script keeps
     a card under each edge at all times.

     `safe center` centres the few rails that hold only one or two photographs
     and cannot overflow. Plain `center` would overflow such a rail equally in
     both directions and the left half would be unreachable — there is no
     negative scroll position — so `safe` falls back to flex-start the moment
     the content stops fitting. */
  .rblk__track {
    display: flex;
    gap: var(--rblk-gap);
    list-style: none;
    margin: 0;
    padding-inline: 0;
    justify-content: center;
    justify-content: safe center;
  }

  /* Exactly --rblk-per cards across the CONTAINER, so three fill the 1280 line
     and the fourth peeks into the gutter — which is what makes it read as a
     slider rather than a row that happens to be cut off. */
  .rblk__frame {
    flex: 0 0 calc(
      (var(--rblk-w) - (var(--rblk-per) - 1) * var(--rblk-gap)) / var(--rblk-per)
    );
    scroll-snap-align: start;
    border-radius: var(--sb-r-2);
    overflow: hidden;
    background: var(--sb-sand);
  }

  /* `height: auto` with an aspect-ratio, NOT the source's height. Astro's
     <Picture> emits width/height attributes — presentational hints that map to
     the CSS width and height properties — and base.css resets `max-width`
     WITHOUT `height: auto`, so without this every frame renders at its source
     height and the row runs to thousands of pixels. */
  .rblk__frame :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: transform 700ms var(--sb-ease);
  }

  .rblk__frame:hover :global(img) { transform: scale(1.05); }

  /* Zero now the track runs edge to edge — the element stays because a looping
     rail measures one set's width from the cards themselves and a stray spacer
     inside the loop would shift every wrap by its width. */
  .rblk__tail { flex: 0 0 0; }

  /* The arrows are no longer a pair in a corner — one sits on each edge,
     vertically centred on the cards, as the reference has them. `contents` so
     each button positions against .rblk__rail-wrap rather than against a
     wrapper that would have to span the rail itself. */
  .rblk__btns { display: contents; }

  /* `display: contents` would beat the `hidden` attribute's UA rule, which is a
     classic way to ship a control that cannot work. */
  .rblk__btns[hidden] { display: none; }

  .rblk__btn {
    position: absolute;
    top: 50%;
    z-index: 2;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid var(--sb-border-strong);
    border-radius: 50%;
    background: var(--sb-paper);
    color: var(--sb-charcoal);
    cursor: pointer;
    box-shadow: 0 10px 26px -14px rgba(28, 14, 8, 0.5);
    transition: background var(--sb-dur-btn) ease, border-color var(--sb-dur-btn) ease,
      transform var(--sb-dur-btn) var(--sb-ease), opacity var(--sb-dur-btn) ease;
  }

  /* Inset from the rail's own edge, sitting on the clipped card. The rail is
     the container now, so these land inside the container line rather than out
     by the window. */
  .rblk__btn--prev { left: clamp(8px, 1.2vw, 18px); }
  .rblk__btn--next { right: clamp(8px, 1.2vw, 18px); }

  .rblk__btn:hover:not(:disabled) {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
    transform: scale(1.06);
  }

  /* Faded rather than removed: a control that vanishes at the end of a rail
     moves the other one, and a row of arrows that jumps is worse than one that
     dims. */
  .rblk__btn:disabled { opacity: 0.3; cursor: default; }

  @media (min-width: 700px) {
    .rblk__rail-wrap { --rblk-per: 2.2; }
  }

  @media (min-width: 1024px) {
    /* 3.2, not 3 — at exactly 3 the cards fill the container to the pixel and
       nothing is ever clipped, which is the "row that has been cut" look this
       was moved away from. The fraction is what leaves a card under each edge. */
    .rblk__rail-wrap { --rblk-per: 3.2; }
  }

  @media (max-width: 900px) {
    /* The gutter is too narrow to hold a 46px button without it landing on the
       card's subject, and the rail drags perfectly well with a finger. */
    .rblk__btns { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .rblk__frame :global(img),
    .rblk__btn { transition: none; }
    .rblk__frame:hover :global(img) { transform: none; }
    .rblk__btn:hover:not(:disabled) { transform: none; }
  }
</style>

<script>
  /**
   * The galleries' arrow buttons.
   *
   * ⚠ BOUND PER RAIL, IN A LOOP. There are fourteen galleries on this page.
   * `document.querySelector('[data-rec-rail]')` would wire up the first and
   * leave thirteen sets of arrows inert — and they would look enabled, because
   * the `hidden` attribute is removed per group.
   *
   * Everything here is an enhancement: the rails underneath are real overflow
   * scrollers with scroll-snap, so flick, trackpad, shift-wheel, arrow keys and
   * screen-reader scrolling already work without any of this.
   */
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-rec-rail]').forEach((rail) => {
    const btns = rail.parentElement?.querySelector<HTMLElement>('[data-rec-btns]');
    if (!btns) return;

    const prev = btns.querySelector<HTMLButtonElement>('[data-rec-prev]')!;
    const next = btns.querySelector<HTMLButtonElement>('[data-rec-next]')!;
    btns.hidden = false;

    /* A step is ONE FRAME, measured from the DOM. The frame basis and the gap
       are both clamp()s, so any number hard-coded here would be wrong at most
       viewport widths. */
    const frames = () => rail.querySelectorAll<HTMLElement>('.rblk__frame');
    const pitch = () => {
      const f = frames();
      if (f.length < 2) return rail.clientWidth * 0.8;
      return f[1].getBoundingClientRect().left - f[0].getBoundingClientRect().left;
    };

    /* ═══ THE LOOP — what puts a card under BOTH edges ══════════════════════
     *
     * The reference clips a card at each side, and a finite rail cannot: at
     * scrollLeft 0 there is nothing to the left of card one, so the row reads as
     * cut rather than continuing.
     *
     * So the set is duplicated once and the rail parks inside the seam. Because
     * the two sets are identical, subtracting one set's width is invisible —
     * the pixels under every point on screen are unchanged.
     *
     * ⚠ THE CLONES ARE `aria-hidden` WITH EMPTY ALT. A screen reader must hear
     * eight photographs, not sixteen. This is the cost that stopped me looping
     * the excursions gallery, where the frames are tabbable panels; here the
     * clones are inert images, so it is payable.
     *
     * ⚠ ONLY WHERE IT MAKES SENSE. Several blocks hold one, two or three
     * photographs and cannot overflow — `sgfi-handball` has a single frame.
     * Duplicating those would invent a scroll where none exists, so they stay
     * finite and `safe center` centres them.
     */
    const track = rail.querySelector<HTMLElement>('.rblk__track')!;
    const tail = track.querySelector<HTMLElement>('.rblk__tail');
    const originals = [...track.querySelectorAll<HTMLElement>('.rblk__frame')];
    let setW = 0;
    let loop = false;

    const measure = () => {
      if (!loop) return;
      setW = originals.reduce((w, f) => w + f.getBoundingClientRect().width, 0)
        + originals.length * (parseFloat(getComputedStyle(track).columnGap) || 0);
    };

    /* Overflow is decided BEFORE cloning, or every rail looks like it overflows. */
    if (rail.scrollWidth > rail.clientWidth + 4 && originals.length > 2) {
      loop = true;
      /* Snap fights a continuous drift — it would pull the rail back to the
         nearest card every frame and the motion would stall. */
      rail.dataset.loop = 'true';
      tail?.remove();
      originals.forEach((f) => {
        const c = f.cloneNode(true) as HTMLElement;
        c.setAttribute('aria-hidden', 'true');
        c.querySelectorAll('img').forEach((i) => i.setAttribute('alt', ''));
        track.append(c);
      });
      measure();
      /* Park a third of a card in from the seam, so a clipped card sits under
         the left edge from the first frame the reader sees. */
      rail.scrollLeft = setW - (originals[0]?.getBoundingClientRect().width ?? 0) / 3;
    }

    /** Keeps the rail inside the seam. Called between animations, never during
     *  one — assigning scrollLeft mid-smooth-scroll cancels it and stutters.
     *  Returns the shift it applied so a caller tracking its own position can
     *  follow without reading scrollLeft back (see the drift note). */
    const reseat = () => {
      if (!loop || !setW) return 0;
      if (rail.scrollLeft > setW * 1.5) {
        rail.scrollLeft -= setW;
        return -setW;
      }
      if (rail.scrollLeft < setW * 0.5) {
        rail.scrollLeft += setW;
        return setW;
      }
      return 0;
    };

    /* Disabled at the ends rather than silently doing nothing. The 2px slack
       absorbs fractional scroll positions, which otherwise leave "next" enabled
       for ever at the right-hand end on non-integer device pixel ratios.
       A looping rail has no ends, so both stay live. */
    const sync = () => {
      if (loop) {
        prev.disabled = false;
        next.disabled = false;
        return;
      }
      const max = rail.scrollWidth - rail.clientWidth;
      prev.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= max - 2;
    };

    const step = (dir: number) =>
      rail.scrollBy({ left: dir * pitch(), behavior: reduced.matches ? 'auto' : 'smooth' });

    /* ═══ AUTO-SCROLL — client instruction ═══════════════════════════════════
     *
     * Three gates, each for a different reason:
     *
     * 1 · ONLY WHEN ON SCREEN. There are FOURTEEN rails on this page. docs/05
     *     § N budgets one animated element per viewport, and fourteen timers
     *     stepping at once would break that on every count — visually, and on
     *     the mid-range Android over 4G docs/03 § D1 describes. An
     *     IntersectionObserver runs only the rail in view.
     * 2 · NOT UNDER REDUCED MOTION. The timer is never created, so the page is
     *     still rather than merely slower.
     * 3 · NOT WHILE THE READER IS THERE. Hover and focus pause; using an arrow,
     *     dragging or wheeling the rail STOPS it for good on that gallery.
     *
     * ⚠ ON WCAG 2.2.2. The arrows are the pause mechanism — first use halts the
     * timer permanently — with hover, focus and reduced motion each covering a
     * different reader on top. Deliberately not a dedicated always-visible pause
     * button, which was removed from the Voices marquee at the client's request
     * (docs/08 D23).
     *
     * IT PING-PONGS rather than jumping home. Returning from the far end of a
     * scroller to zero is either a long backwards sweep or a hard cut; reversing
     * is the only option that stays smooth on rails this short.
     */
    /* ═══ SMOOTH, NOT STEPPED — client instruction ══════════════════════════
     *
     * This used to jump one card every two seconds. Each jump is an animation
     * that starts and stops, so on a rail of photographs it reads as a series
     * of lurches rather than as movement. A continuous drift at a walking pace
     * reads as one motion and is what "smooth auto scroller" means.
     *
     * ⚠ IT NEEDS THE LOOP, and only looping rails get it. A finite rail drifting
     * continuously has to stop dead at its end or reverse into the reader,
     * which is worse than not moving. The six one- and two-photograph blocks
     * keep the stepped fallback and, since they cannot overflow, never move.
     *
     * ⚠ SNAP IS OFF WHILE IT DRIFTS. `scroll-snap-type` would pull the rail back
     * to the nearest card on every frame and the drift would stall — the CSS
     * turns it off for looping rails. Manual arrow steps still land on a card
     * because `step()` scrolls by exactly one pitch.
     *
     * rAF rather than a timer, and the delta is scaled by real elapsed time, so
     * the speed is the same on a 60Hz laptop and a 120Hz phone.
     */
    const SPEED = 40; // px per second
    const STEP_MS = 2000;
    let dir = 1;
    let timer: number | undefined;
    let raf = 0;
    let last = 0;
    let pos = 0;
    let onScreen = false;
    let held = false;
    let stopped = false;

    /* ⚠ `pos` IS THE SOURCE OF TRUTH AND IS NEVER READ BACK FROM scrollLeft.
       Doing that made the rail drift at 61px/s against a 34px/s setting —
       measured, not guessed. `scrollLeft` is quantised to the device pixel
       grid, so a 0.57px-per-frame increment gets rounded on write and the
       inflated value is then read back as the new base, compounding every
       frame. Keeping a float here and only applying reseat()'s own shift means
       the speed is exactly what the constant says. */
    const frame = (t: number) => {
      if (!last) last = t;
      pos += (SPEED * (t - last)) / 1000;
      last = t;
      rail.scrollLeft = pos;
      pos += reseat();
      raf = requestAnimationFrame(frame);
    };

    /* The stepped fallback, for rails that do not loop. */
    const tick = () => {
      const max = rail.scrollWidth - rail.clientWidth;
      if (rail.scrollLeft >= max - 2) dir = -1;
      else if (rail.scrollLeft <= 2) dir = 1;
      step(dir);
    };

    const run = () => {
      if (stopped || held || !onScreen || reduced.matches) return;
      if (loop) {
        if (raf) return;
        last = 0;
        pos = rail.scrollLeft;
        raf = requestAnimationFrame(frame);
      } else if (!timer) {
        timer = window.setInterval(tick, STEP_MS);
      }
    };

    const halt = () => {
      if (raf) cancelAnimationFrame(raf);
      raf = 0;
      last = 0;
      window.clearInterval(timer);
      timer = undefined;
    };

    /** Permanent, for this rail: the reader has taken control. */
    const stop = () => {
      stopped = true;
      halt();
    };

    const hold = (on: boolean) => {
      held = on;
      on ? halt() : run();
    };

    const wrap = rail.parentElement!;
    wrap.addEventListener('pointerenter', () => hold(true));
    wrap.addEventListener('pointerleave', () => hold(false));
    wrap.addEventListener('focusin', () => hold(true));
    wrap.addEventListener('focusout', () => hold(false));
    rail.addEventListener('pointerdown', stop);
    rail.addEventListener('wheel', stop, { passive: true });

    new IntersectionObserver(
      ([e]) => {
        onScreen = e.isIntersecting;
        onScreen ? run() : halt();
      },
      { threshold: 0.3 },
    ).observe(wrap);

    reduced.addEventListener('change', () => (reduced.matches ? halt() : run()));

    prev.addEventListener('click', () => {
      stop();
      reseat();
      step(-1);
    });
    next.addEventListener('click', () => {
      stop();
      reseat();
      step(1);
    });

    rail.addEventListener('scroll', sync, { passive: true });

    /* A drag or a flick can carry the rail out of the seam, and that settles
       long after the last scroll event. `scrollend` fires exactly once when it
       does; where it is unsupported a short idle timer stands in. Wrapping on
       every scroll event instead would cancel an in-flight smooth scroll. */
    if ('onscrollend' in window) {
      rail.addEventListener('scrollend', reseat);
    } else {
      let idle: number | undefined;
      rail.addEventListener(
        'scroll',
        () => {
          window.clearTimeout(idle);
          idle = window.setTimeout(reseat, 140);
        },
        { passive: true },
      );
    }

    window.addEventListener('resize', () => {
      measure();
      sync();
    });
    sync();
  });
</script>
