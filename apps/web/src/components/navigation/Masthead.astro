---
/**
 * C02 · MASTHEAD — docs/06 §02
 *
 * Crest + wordmark left, Apply Online right, and the navigation on its own
 * full-width row beneath. Sticky; condenses 96 → 68px on scroll.
 *
 * IMPLEMENTATION NOTE — TWO ROWS, and the desktop threshold is 1280px.
 *
 * The client requires all eleven audit sections on the main menu. Named
 * verbatim they measure 1117px of link text at 14px — "School Planner &
 * Academic Calendar" (§8) is 253px on its own, "Latest News & Events" (§11)
 * 148px — and the container caps at 1280px. Beside the brand lockup (242px) and
 * the Apply button (151px) a single row leaves roughly 810px, so eleven items
 * cannot share a line with the brand at any type size worth reading. Giving the
 * nav its own row hands it the full container and is what makes eleven possible.
 *
 * Measured slack in Chromium, one row at every width: 81px at 1280, 95px at
 * 1360, 52px at 1440 and above (the floor — the container stops growing while
 * the gap clamp does not). Below 1280 the drawer takes over.
 */
import { mainNav } from '../../data/navigation';
import { getSchool } from '../../lib/cms';
import MegaMenu from './MegaMenu.astro';

const school = await getSchool();
---

<header class="masthead" data-masthead>
  <div class="masthead__inner u-container">
    <a class="brand" href="/" aria-label="Sunbeam School Ballia — home">
      <img
        class="brand__emblem"
        src="/brand/sunbeam-emblem.png"
        alt=""
        width="190"
        height="144"
        decoding="async"
      />
      <img
        class="brand__wordmark"
        src="/brand/sunbeam-wordmark.png"
        alt="Sunbeam School Ballia"
        width="588"
        height="178"
        decoding="async"
      />
    </a>

    <nav class="mainnav" aria-label="Main">
      <ul class="mainnav__list">
        {mainNav.map((item) => {
          const panelId = `mega-${item.label.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '')}`;
          return (
          <li class:list={['mainnav__item', item.columns && 'mainnav__item--has-mega']}>
            {/* ⚠⚠ A BUTTON, NOT A LINK, WHEN THE ITEM OWNS A SUBMENU — and that is a
                semantic claim, not a styling one. These six parents have nothing
                of their own to show; the submenu IS the content. As <a href> they
                navigated, which on a phone meant tapping “About Us” left the
                drawer for a page that reads “we’re still writing this” instead of
                opening the six links underneath it. A button that reveals is
                what this control has always been.
                ⚠ /academics/ AND /news-events/ ARE NO LONGER REACHED FROM THIS
                BAR, deliberately — the client’s call. Both remain in the footer
                and the sitemap; neither is orphaned.
                ⚠ THE PANEL STILL OPENS ON HOVER AND focus-within IN CSS. This
                button adds the click/Enter/Space path for pointer and touch, and
                keeps aria-expanded honest about what is actually showing. */}
            {item.columns ? (
              <button
                type="button"
                class="mainnav__link mainnav__link--toggle"
                aria-expanded="false"
                aria-controls={panelId}
                data-mega-toggle
              >{item.label}</button>
            ) : (
              <a class="mainnav__link" href={item.href}>{item.label}</a>
            )}
            {item.columns && <MegaMenu item={item} panelId={panelId} />}
          </li>
          );
        })}
      </ul>
    </nav>

    <div class="masthead__actions">
      {/* ⚠⚠ ADMISSIONS IS BACK IN THIS SLOT, AT THE CLIENT'S REQUEST. It briefly
          held Uniform Catalogue, which is now an ordinary nav item instead.

          ⚠ IT POINTS AT THE NURSERY–IX FORM, THE MAIN INTAKE, because one button
          cannot open two forms. Class XI is not lost: both forms stay in the
          utility bar directly above, which is where the school's own site puts
          them, and the mobile drawer lists both under Quick Links.

          ⚠ "BLINK" IS A PULSE, AND THAT IS DELIBERATE. A true blink fails WCAG
          2.2.2 — anything that flashes must be stoppable, and above three
          flashes a second it is a seizure risk. This breathes once every 2.4s,
          never fully disappears (so the label is always readable), and stops
          dead under prefers-reduced-motion. It only runs while admissionsOpen
          is true. */}
      <a
        class:list={['btn', 'btn--primary', 'masthead__apply', school.admissionsOpen && 'is-live']}
        href={school.external.applyFormNurseryToIX}
        target="_blank"
        rel="noopener noreferrer"
      >Admissions</a>
      <button
        class="masthead__toggle"
        type="button"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
        data-nav-toggle
      >
        <span class="masthead__toggle-bars" aria-hidden="true"><i></i><i></i></span>
        <span class="masthead__toggle-text">Menu</span>
      </button>
    </div>
  </div>

</header>

<style>
  .masthead {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--sb-paper);
    border-bottom: var(--sb-hairline);
    transition: box-shadow var(--sb-dur-nav) ease;
  }

  .masthead.is-scrolled {
    box-shadow: var(--sb-shadow-header);
  }

  /* Tucked away once the footer reaches the top of the viewport. A sticky header
     will always sit on whatever lands beneath it, and at the end of the page
     that was slicing the top off the footer's wordmark at shorter viewport
     heights. Scrolling up brings it straight back. */
  .masthead.is-tucked {
    transform: translateY(-100%);
  }

  .masthead {
    transition: box-shadow var(--sb-dur-nav) ease,
      transform var(--sb-dur-nav) var(--sb-ease);
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead { transition: none; }
  }

  .masthead__inner {
    height: var(--sb-masthead-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    /* Capped, not clamp(20px, 2vw, 40px): the container stops growing at 1280
       but vw does not, so the old gap widened on big screens while the space it
       had to fit into stayed fixed — 1920 overflowed harder than 1440 did. */
    gap: clamp(12px, 1.1vw, 16px);
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* --- Brand ------------------------------------------------------------- */

  .brand {
    display: flex;
    align-items: center;
    gap: 14px;
    flex-shrink: 0;
  }

  /* 52/48 rather than 60/56: the doc's verbatim labels cost the nav ~120px over
     the short ones, and the lockup is where that comes back from. 279 → 242px. */
  .brand__emblem {
    height: 52px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  .brand__wordmark {
    height: 48px;
    width: auto;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  /* Shrinks on scroll so the sticky bar stays shallow — same ratio as above. */
  .masthead.is-scrolled .brand__emblem { height: 52px; }
  .masthead.is-scrolled .brand__wordmark { height: 48px; }

  /* --- Main navigation --------------------------------------------------- */

  .mainnav {
    flex: 1;
    display: flex;
    justify-content: flex-end;
  }

  .mainnav__list {
    display: flex;
    align-items: center;
    justify-content: center;
    /* Wraps rather than overflows: if a longer label is ever added the row drops
       to a second line instead of pushing a horizontal scrollbar onto every
       page — `body` is overflow-x:hidden, so that bug shows up as the whole
       document sliding sideways, not as a broken header. */
    flex-wrap: wrap;
    gap: 0 clamp(9px, 0.95vw, 13px);
  }

  /* relative — the multi-level panel is narrow and hangs off its own trigger,
     so the item is the containing block. (The 920px glass panel that briefly
     lived here had to centre on the nav instead; this one does not.) */
  .mainnav__item {
    position: relative;
  }

  .mainnav__link {
    position: relative;
    display: inline-block;
    padding: 11px 2px;
    /* Fluid, and the cap is set by measurement rather than taste: the nine
       labels plus the Apply button and the brand lockup need every pixel the
       1280px container has. At 13.5px the row wrapped at 1280, 1600 and 1920. */
    font-size: clamp(12px, 0.92vw, 13px);
    font-weight: 600;
    color: var(--sb-charcoal);
    white-space: nowrap;
    transition: color var(--sb-dur-link) ease;
  }

  /* Active/hover indicator: 2px maroon rule, wipes in from the left. */
  .mainnav__link::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: var(--sb-violet);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sb-dur-link) var(--sb-ease);
  }

  .mainnav__item:hover .mainnav__link,
  .mainnav__item:focus-within .mainnav__link {
    color: var(--sb-violet);
  }

  .mainnav__item:hover .mainnav__link::after,
  .mainnav__item:focus-within .mainnav__link::after {
    transform: scaleX(1);
  }

  /* ⚠ THE TOGGLE IS A <button>, SO IT ARRIVES WITH A UA BUTTON’S BACKGROUND,
     BORDER, PADDING, FONT AND CENTRED TEXT. Every one of those has to be reset
     or it would sit a few pixels off its nine neighbours — which is exactly the
     kind of drift that makes a semantic fix look like a regression. */
  .mainnav__link--toggle {
    appearance: none;
    -webkit-appearance: none;
    background: none;
    border: 0;
    font: inherit;
    font-size: clamp(12px, 0.92vw, 13px);
    font-weight: 600;
    line-height: inherit;
    text-align: left;
    cursor: pointer;
  }

  /* CSS-first mega-menu reveal — plus .is-open, which is how a CLICK or a tap
     holds the panel open for anyone not using hover. */
  .mainnav__item--has-mega:hover :global(.mega),
  .mainnav__item--has-mega:focus-within :global(.mega),
  .mainnav__item--has-mega.is-open :global(.mega) {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition:
      opacity var(--sb-dur-menu) ease,
      transform var(--sb-dur-menu) var(--sb-ease);
  }

  /* ONE PANEL AT A TIME. Hover and focus both open a menu, so a keyboard user
     who has tabbed into one and then moves the pointer over another had two
     open together. That was survivable when each panel hung off its own item —
     they sat side by side. Now every panel is centred on the nav, so two open
     panels stack directly on top of each other and the menu reads as corrupt.
     Whenever the pointer is over the bar, hover wins and any focus-held panel
     that is not also hovered is suppressed. */
  .mainnav:hover .mainnav__item--has-mega:not(:hover) :global(.mega) {
    opacity: 0;
    visibility: hidden;
    transition-delay: 0ms;
  }

  .masthead.is-mega-suppressed :global(.mega) {
    opacity: 0 !important;
    visibility: hidden !important;
  }

  /* --- Actions ----------------------------------------------------------- */

  /* Sized against the nav row rather than the button default — see the note on
     the row measurement below. */
  .masthead__apply { padding-inline: 22px; white-space: nowrap; }

  /* ⚠ TWO PROPERTIES, NOT opacity. Fading a button in and out makes its label
     unreadable at the trough; a shadow bloom and a hair of scale read as "live"
     while the text never changes contrast. */
  .masthead__apply.is-live {
    animation: masthead-pulse 2.4s ease-in-out infinite;
  }
  @keyframes masthead-pulse {
    0%, 100% {
      box-shadow: 0 0 0 0 color-mix(in srgb, var(--sb-orange-bright) 46%, transparent);
      scale: 1;
    }
    50% {
      box-shadow: 0 0 0 7px color-mix(in srgb, var(--sb-orange-bright) 0%, transparent);
      scale: 1.035;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .masthead__apply.is-live { animation: none; }
  }

  .masthead__actions {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
    flex-shrink: 0;
  }


  .masthead__toggle {
    display: none;
    align-items: center;
    gap: var(--sb-3);
    min-height: 48px;
    padding: 0 var(--sb-2);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-charcoal);
  }

  .masthead__toggle-bars {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 22px;
    height: 14px;
  }

  .masthead__toggle-bars i {
    display: block;
    height: 2px;
    width: 100%;
    background: var(--sb-charcoal);
    border-radius: 2px;
    transition: transform 320ms var(--sb-ease);
  }

  /* --- Hamburger → cross ---------------------------------------------------
     The maths, so the X is actually centred rather than approximately so: two
     2px bars with a 5px gap occupy 9px inside a 14px box, so their centres sit
     at 3.5px and 10.5px while the box centre is 7px. Each bar therefore travels
     exactly 3.5px inward before rotating, and the two strokes cross dead centre.

     Driven off `aria-expanded`, not a class — the attribute has to be correct
     for assistive tech anyway, so keying the visual to it means the two can
     never disagree. */
  .masthead__toggle[aria-expanded='true'] .masthead__toggle-bars i:first-child {
    transform: translateY(3.5px) rotate(45deg);
  }

  .masthead__toggle[aria-expanded='true'] .masthead__toggle-bars i:last-child {
    transform: translateY(-3.5px) rotate(-45deg);
  }

  /* ABOVE THE DRAWER WHILE IT IS OPEN. The drawer sits at z-index 100 and this
     header at 50, so the toggle was behind the scrim and unclickable — a
     hamburger that morphs into a cross is pointless if the cross cannot be
     pressed. Raised only while open, so the resting stack is unchanged. */
  .masthead.is-nav-open {
    z-index: 120;
  }

  @media (prefers-reduced-motion: reduce) {
    .masthead__toggle-bars i { transition: none; }
  }

  /* --- Below 1360: drawer takes over --------------------------------------
     THE BUG THIS PREVENTS IS A HORIZONTAL SCROLLBAR ON EVERY PAGE. Because
     `body` is `overflow-x: hidden` an over-wide header never shows as a broken
     header — it shows as the whole document scrolling sideways, which on a
     full-bleed layout looks like every band stopping short of the right edge.

     Moving the nav onto its own row bought back everything the brand lockup and
     the Apply button used to take, which is what makes eleven items possible at
     all. The threshold is set from the measured width of the eleven links; see
     the figures recorded in the header comment above. Below it the drawer takes
     over, which is honest, rather than a nav squeezed past legibility.

     ⚠ RE-MEASURE IF A TWELFTH ITEM OR A LONGER LABEL IS ADDED. The list wraps
     rather than overflowing, so the failure mode is a second row appearing, not
     a sideways-scrolling page. */

  @media (max-width: 1279px) {
    .mainnav { display: none; }
    .masthead__toggle { display: inline-flex; }
  }

  /* 1280–1439 is where the row is tightest: the container is still growing but
     has not reached its 1280 cap, so the nav has less room than it does at 1440
     while carrying exactly the same labels. The lockup steps down one notch
     there rather than the type shrinking further. */
  @media (max-width: 1439px) {
    .brand__emblem,
    .masthead.is-scrolled .brand__emblem { height: 44px; }
    .brand__wordmark,
    .masthead.is-scrolled .brand__wordmark { height: 40px; }
  }

  @media (max-width: 1023px) {
    .brand__emblem { height: 44px; }
    .brand__wordmark { height: 40px; }
    .masthead.is-scrolled .brand__emblem { height: 38px; }
    .masthead.is-scrolled .brand__wordmark { height: 34px; }
  }

  /* ⚠⚠ THE PILL HAS TO SHRINK BELOW 480, or the header overflows. Brand lockup +
     133px pill + burger came to 352px against a 320px viewport and pushed the
     whole document 32px sideways. The client wants Admissions in the header, so
     it stays — it just gets compact rather than hidden. */
  @media (max-width: 479px) {
    .masthead__apply { padding-inline: 13px; font-size: 11px; }
  }


  @media (max-width: 767px) {
    .brand { gap: 10px; }
    .brand__emblem { height: 38px; }
    .brand__wordmark { height: 34px; }
    .masthead.is-scrolled .brand__emblem { height: 32px; }
    .masthead.is-scrolled .brand__wordmark { height: 28px; }
    .masthead__toggle-text { display: none; }
  }
  /* ⚠⚠ THE LOGO GIVES WAY AT 359, NOT THE BUTTON. At 320 the row needs 320px
     inside 280px of usable width — brand 173 + gap 12 + actions 135 — and it
     pushed the document 20px sideways on EVERY page, not just the homepage.

     The pill was already trimmed at 479 and there is nothing left to take from
     it: shrinking “Admissions” further makes the one action in the header
     illegible, and the burger is a 30px tap target that should not go below 24.
     The wordmark is the compressible element — it is 113px of artwork that
     still reads at 88 — so it is what steps aside. */
  @media (max-width: 359px) {
    .brand { gap: 7px; }
    .brand__emblem,
    .masthead.is-scrolled .brand__emblem { height: 30px; }
    .brand__wordmark,
    .masthead.is-scrolled .brand__wordmark { height: 26px; }
    .masthead__inner { gap: 8px; }
  }

  /* ⚠ THE 359 BLOCK MUST STAY BELOW THE 767 ONE. Both match at 320px and both
     are one class deep, so source order decides — written above, the 767 rule
     re-set the emblem to 38px and the overflow came straight back. */
</style>

<script>
  // Sticky condense + Escape-to-close. Everything else is CSS.
  const masthead = document.querySelector<HTMLElement>('[data-masthead]');
  const utility = document.querySelector<HTMLElement>('[data-utility-bar]');
  const footer = document.querySelector<HTMLElement>('footer');

  if (masthead) {
    let lastY = window.scrollY;
    let ticking = false;

    const onScroll = () => {
      const y = window.scrollY;
      masthead.classList.toggle('is-scrolled', y > 8);

      // Tuck the header out of the way once the footer reaches it, so the
      // footer's wordmark is never sliced in half at the end of the page.
      if (footer) {
        masthead.classList.toggle(
          'is-tucked',
          footer.getBoundingClientRect().top <= masthead.offsetHeight + 4
        );
      }

      // Utility bar hides on scroll-down, returns on scroll-up (docs/06 §01).
      if (utility) {
        const goingDown = y > lastY && y > 120;
        utility.classList.toggle('is-hidden', goingDown);
      }

      lastY = y;
      ticking = false;
    };

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          window.requestAnimationFrame(onScroll);
        }
      },
      { passive: true }
    );

    /* ⚠⚠ CLICK/TAP TOGGLES THE PANEL, because hover is not available to a
       touch user and these triggers no longer navigate. The panel is still
       revealed by :hover and :focus-within in CSS — this only adds .is-open for
       the pointer path, and keeps aria-expanded truthful, which a CSS-only
       reveal cannot do on its own.

       ⚠ ONE OPEN AT A TIME. Two panels overlapping the hero at once is how a
       nav starts looking broken. */
    const megaToggles = Array.from(
      masthead.querySelectorAll<HTMLButtonElement>('[data-mega-toggle]'),
    );

    const setOpen = (btn: HTMLButtonElement, open: boolean) => {
      btn.closest('.mainnav__item')?.classList.toggle('is-open', open);
      btn.setAttribute('aria-expanded', String(open));
    };
    const closeAllMega = (except?: HTMLButtonElement) =>
      megaToggles.forEach((b) => b !== except && setOpen(b, false));

    megaToggles.forEach((btn) => {
      btn.addEventListener('click', () => {
        /* ⚠ READ .is-open, NOT aria-expanded. aria-expanded also tracks the
           HOVER reveal, so using it here meant a mouse user who hovered a parent
           and then clicked it saw the panel vanish — the click was read as
           ‘close the thing hover just opened’. .is-open is the click state alone:
           first click pins the panel, second unpins it, and hovering is
           unaffected either way. */
        const open = btn.closest('.mainnav__item')?.classList.contains('is-open') ?? false;
        closeAllMega(btn);
        setOpen(btn, !open);
      });

      /* aria-expanded has to follow the CSS reveal too, or a screen-reader user
         hears “collapsed” about a panel that is plainly on screen. */
      const item = btn.closest('.mainnav__item');
      item?.addEventListener('pointerenter', () => btn.setAttribute('aria-expanded', 'true'));
      /* ⚠⚠ THE POINTER LEAVING CLOSES THE PANEL, PINNED OR NOT. A clicked-open
         menu that survived the cursor walking away sat over the hero until
         something else was clicked, which reads as stuck rather than as pinned.
         Two things have to be undone, and missing either one leaves it open:
           · .is-open, the click state;
           · FOCUS — a mouse click leaves the button focused, and :focus-within
             reveals the panel on its own, so clearing .is-open alone changed
             nothing visible.
         ⚠ MOUSE ONLY. A tap fires pointerleave too, and on a touchscreen there
         is no hover to fall back on — closing there would make the menu
         unopenable. Keyboard focus is untouched: if nobody is moving a mouse,
         this never fires. */
      item?.addEventListener('pointerleave', (event) => {
        const e = event as PointerEvent;
        if (e.pointerType && e.pointerType !== 'mouse') return;
        setOpen(btn, false);
        if (item.contains(document.activeElement)) (document.activeElement as HTMLElement).blur();
      });
      item?.addEventListener('focusin', () => btn.setAttribute('aria-expanded', 'true'));
      item?.addEventListener('focusout', (e) => {
        const to = (e as FocusEvent).relatedTarget as Node | null;
        if (item.contains(to)) return;
        if (!item.classList.contains('is-open')) btn.setAttribute('aria-expanded', 'false');
      });
    });

    /* A click anywhere else dismisses a clicked-open panel. */
    document.addEventListener('click', (event) => {
      const t = event.target as Node;
      if (!masthead.contains(t)) closeAllMega();
      else if (!(t as Element).closest?.('.mainnav__item--has-mega')) closeAllMega();
    });

    // Escape closes an open mega-menu and returns focus to its trigger.
    masthead.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const openItem = masthead
        .querySelector('.mainnav__item--has-mega:focus-within');
      if (!openItem) return;

      const trigger = openItem.querySelector<HTMLElement>('.mainnav__link');
      closeAllMega();
      masthead.classList.add('is-mega-suppressed');
      trigger?.focus();
      // Release the suppression once focus moves on, so hover still works.
      const release = () => {
        masthead.classList.remove('is-mega-suppressed');
        masthead.removeEventListener('focusout', release);
        masthead.removeEventListener('mouseleave', release);
      };
      masthead.addEventListener('focusout', release);
      masthead.addEventListener('mouseleave', release);
    });
  }
</script>
