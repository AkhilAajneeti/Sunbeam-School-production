---
/**
 * C01 · UTILITY BAR — docs/06 §01
 *
 * Serves existing parents and students BEFORE the marketing begins, so a
 * returning user never scrolls a persuasion page to reach a notice.
 * Removes eight competing links from the main navigation.
 */
import { getSchool } from '../../lib/cms';
import { utilityLinks } from '../../data/navigation';

const school = await getSchool();
---

<div class="utility" data-utility-bar>
  <div class="utility__inner u-container">
    <nav aria-label="Parent and student utilities">
      <ul class="utility__links">
        {utilityLinks.map((link) => (
          <li class:list={[`utility__li--t${link.tier}`]}>
            <a
              href={link.href}
              {...('external' in link && link.external
                ? { target: '_blank', rel: 'noopener' }
                : {})}
            >
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <a class="utility__phone" href={`tel:${school.phone.admissions}`}>
      <span class="utility__phone-label">Admission Helpline:</span>
      <span class="utility__phone-number t-tabular">{school.phone.admissionsDisplay}</span>
    </a>
  </div>
</div>

<style>
  /* ⚠ --sb-violet (#c93c0a), NOT --sb-orange-bright (#ff5c35). The reference
     bar is a brighter orange, and white text on it measures 3.08:1 — under the
     4.5:1 WCAG AA floor for text this size, on the one strip that carries the
     admissions number. The brand primary is the same orange family and measures
     5.08:1, which is why the token file annotates it "PRIMARY — 5.1:1 with white
     text". Verified with scripts/contrast-sample.mjs. */
  .utility {
    background: var(--sb-violet);
    color: rgba(255, 255, 255, 0.92);
    font-size: var(--sb-caption);
    line-height: 1;
    /* Hides on scroll-down, returns on scroll-up — docs/06 §01.
       Collapsing height (not transform) so the sticky masthead moves up with it. */
    height: var(--sb-utility-h);
    overflow: hidden;
    transition: height var(--sb-dur-nav) var(--sb-ease);
  }

  .utility.is-hidden {
    height: 0;
  }

  .utility__inner {
    height: var(--sb-utility-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-6);
  }

  .utility__links {
    display: flex;
    align-items: center;
    gap: var(--sb-6);
  }

  .utility__links a {
    position: relative;
    display: inline-block;
    padding-block: var(--sb-3);
    /* The bar sheds links by tier rather than wrapping to a second line. */
    white-space: nowrap;
    transition: color var(--sb-dur-link) ease;
  }

  /* Gold underline wipes left→right — N. */
  .utility__links a::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 2px;
    height: 1px;
    width: 100%;
    /* White, not gold — the gold underline vanished against the orange. */
    background: #fff;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform var(--sb-dur-link) var(--sb-ease);
  }

  .utility__links a:hover,
  .utility__links a:focus-visible {
    color: #fff;
  }

  .utility__links a:hover::after,
  .utility__links a:focus-visible::after {
    transform: scaleX(1);
  }

  /* ⚠ min-height MATCHES THE SIBLING LINKS' HIT AREA, WHICH IT DID NOT.
     `.utility__links a` carries `padding-block: var(--sb-3)`; this one carried
     none, so on the bar's `line-height: 1` it measured 98×12 — half the 24×24
     WCAG 2.2 SC 2.5.8 (AA) minimum, on the one control a parent is most likely
     to want on a phone. The bar's height is set by its own padding, so growing
     the hit area here moves nothing. */
  .utility__phone {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    gap: var(--sb-3);
    white-space: nowrap;
    transition: color var(--sb-dur-link) ease;
  }

  .utility__phone:hover {
    color: #fff;
  }

  .utility__phone-label {
    color: rgba(255, 255, 255, 0.78);
  }

  .utility__phone-number {
    font-weight: 600;
    color: #fff;
  }

  /* --- Mobile: keep only Notices · Results (docs/06 §01) ------------------
     The bar is three links now, so nothing needs shedding until the phone
     number and the links genuinely compete — which is 767, not 1239. */
  /* ⚠ SHED BY TIER, WIDEST FIRST. Eight links and a phone number need roughly
     1400px; below that the bar drops its least time-critical links rather than
     wrapping to a second line and doubling the masthead height. */
  @media (max-width: 1279px) {
    .utility__li--t3 { display: none; }
  }

  @media (max-width: 1023px) {
    .utility__li--t2 { display: none; }
  }

  @media (max-width: 767px) {
    .utility__inner {
      gap: var(--sb-4);
    }

    .utility__links {
      gap: var(--sb-5);
    }

    .utility__phone-label {
      display: none;
    }
  }

  @media (max-width: 400px) {
    .utility__links {
      gap: var(--sb-4);
    }
  }
</style>
