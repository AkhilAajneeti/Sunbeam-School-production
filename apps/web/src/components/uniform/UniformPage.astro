---
/**
 * UNIFORM CATALOGUE — the whole body. Five sections.
 *
 * ⚠⚠ THE PDFs ARE NOT LEFT BEHIND A DOWNLOAD BUTTON. The school's Uniform page
 * carries two links and nothing else; everything below the cards here — the
 * class groups, the four seasons, the shoe table and the eleven notes — was read
 * out of the catalogues themselves and surfaced on the page, which is what the
 * brief asks for. Both PDFs are image-only, so every line was read off pages
 * rendered at 4× rather than extracted. Sourcing in data/uniform.ts.
 *
 * ⚠ EXACTLY TWO CATALOGUES, BECAUSE THE SCHOOL PUBLISHES TWO. No third card, no
 * "coming soon", no invented season editions.
 *
 * ⚠ THE ORIGINAL FILES ARE SERVED, NOT RECREATED. public/uniform/ holds the
 * school's own PDFs byte for byte; "View" opens one in a new tab and "Download"
 * saves it. Their sizes are printed because 38.9 MB is worth warning a parent
 * on a phone about.
 *
 * ⚠ THIS IS NOT A SHOP. No prices, no outlets, no sizes, no stock — the school
 * publishes none of it, and the reference art's "buy from any shop" line was not
 * found on the Uniform page or on any catalogue page checked.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · IVORY  copy left, the two catalogue cards right.
 *   02 · PAPER  the class groups, three columns.
 *   03 · CREAM  the four seasons on a rule.
 *   04 · PAPER  the shoe table and the eleven notes.
 *   05 · IVORY  the two documents again, compact, as a last access point.
 */
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import { getUniform } from '../../lib/cms';
import ClipHeading from '../ui/ClipHeading.astro';
import RichLine from '../ui/RichLine.astro';

const {
  top, catalogues, classes, seasonsBlock, shoes, notes, download, source: uniformSource,
} = await getUniform();
---

{/* ══ 01 · THE CATALOGUES ════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad un-top" aria-labelledby="un-top-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container un-top__grid">
    <div class="un-top__copy">
      <p class="as-kicker" data-reveal>{top.kicker}</p>
      <ClipHeading class="as-h as-h--xl un-top__h" id="un-top-t" text={top.heading} />
      <p class="as-body" data-reveal data-reveal-delay="200">{top.body}</p>
      <RichLine class="as-note" reveal revealDelay={260} text={top.note} />
    </div>

    <ul class="un-cats">
      {catalogues.map((c, i) => (
        <li class="un-cat" data-pop data-pop-delay={120 + i * 110}>
          <span class="un-cat__n t-tabular" aria-hidden="true">{c.n}</span>
          <span class="un-cat__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[c.mark]} />
            </svg>
          </span>

          <h3 class="un-cat__k">{c.title}</h3>
          <p class="un-cat__s t-tabular">{c.session}</p>
          {c.revised && <p class="un-cat__r">{c.revised}</p>}

          <p class="un-cat__meta t-tabular">
            PDF <span class="un-cat__dot" aria-hidden="true">·</span> {c.pages} pages
            <span class="un-cat__dot" aria-hidden="true">·</span> {c.size}
          </p>

          <p class="un-cat__acts">
            <a class="un-btn" href={c.href} target="_blank" rel="noopener noreferrer">
              View catalogue
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.external} />
              </svg>
            </a>
            <a class="un-btn un-btn--solid" href={c.href} download>
              Download PDF
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
              </svg>
            </a>
          </p>

          {/* Which of the school's own two links this is — the covers both say
              "winter", so the label is what tells them apart. */}
          <p class="un-cat__as">On the school’s page: “{c.linkedAs}”</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 02 · THE CLASS GROUPS ══════════════════════════════════════════════════ */}
<section class="as-sec as-sec--paper as-pad--sm un-cls" aria-labelledby="un-cls-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <div class="un-head">
      <div>
        <p class="as-kicker" data-reveal>{classes.kicker}</p>
        <ClipHeading class="as-h as-h--md un-head__h" id="un-cls-t" stagger={140} text={classes.heading} />
        <span class="un-rule" aria-hidden="true"></span>
      </div>
      <p class="un-head__n" data-reveal data-reveal-delay="180">{classes.note}</p>
    </div>

    <ul class="un-groups">
      {classes.groups.map((g, i) => (
        <li class="un-group" data-pop data-pop-delay={110 + i * 90}>
          <span class="un-group__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[g.mark]} />
            </svg>
          </span>
          <span class="un-group__n t-tabular">{g.n}</span>
          <h3 class="un-group__k">{g.k}</h3>
          <p class="un-group__v">{g.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 03 · THE SEASONS ═══════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm un-sea" aria-labelledby="un-sea-t">
  <div class="u-container">
    <div class="un-head un-head--solo">
      <div>
        <p class="as-kicker" data-reveal>{seasonsBlock.kicker}</p>
        <ClipHeading class="as-h as-h--md un-head__h" id="un-sea-t" stagger={140} text={seasonsBlock.heading} />
        <span class="un-rule" aria-hidden="true"></span>
      </div>
    </div>

    <ol class="un-seasons">
      {seasonsBlock.seasons.map((s, i) => (
        <li class="un-season" data-reveal data-reveal-delay={110 + i * 80}>
          <span class="un-season__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <span class="un-season__k">{s.k}</span>
          <span class="un-season__v t-tabular">{s.v}</span>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 04 · SHOES AND THE SCHOOL'S NOTES ══════════════════════════════════════ */}
<section class="as-sec as-sec--paper as-pad un-det" aria-labelledby="un-det-t">
  <div class="u-container un-det__grid">
    <div class="un-det__shoes">
      <p class="as-kicker" data-reveal>{shoes.kicker}</p>
      <h2 class="as-h as-h--md un-det__h" id="un-det-t">
        <span data-clip data-clip-delay="0">{shoes.heading}</span>
      </h2>
      <span class="un-rule" aria-hidden="true"></span>

      <div class="un-tabwrap">
        <table class="un-tab">
          <caption class="u-visually-hidden">
            Shoes by class group, for boys and girls, and the days each applies — from the school’s
            own uniform catalogue.
          </caption>
          <thead>
            <tr>
              <th scope="col">Classes</th>
              <th scope="col">Boys</th>
              <th scope="col">Girls</th>
              <th scope="col">Days</th>
            </tr>
          </thead>
          <tbody>
            {shoes.rows.map((r) => (
              <tr>
                <th scope="row">{r.classes}</th>
                <td>{r.boys}</td>
                <td>{r.girls}</td>
                <td class="un-tab__days">{r.days}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="un-det__src">{shoes.note}</p>
    </div>

    {/* ⚠ THE ELEVEN NOTES ARE THE SCHOOL'S OWN, VERBATIM. This is the block that
        makes the page worth reading rather than a pair of download buttons. */}
    <div class="un-det__notes">
      <div class="un-note__head">
        <span class="un-note__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.shield} />
          </svg>
        </span>
        <div>
          <h3 class="un-note__k">{notes.title}</h3>
          <p class="un-note__v">{notes.body}</p>
        </div>
      </div>

      <ol class="un-notes">
        {notes.items.map((n, i) => (
          <li class="un-noteitem" data-reveal data-reveal-delay={70 + i * 28}>
            <span class="un-noteitem__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="un-noteitem__t">{n}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* ══ 05 · THE DOCUMENTS AGAIN ═══════════════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad--sm un-dl" aria-labelledby="un-dl-t">
  <div class="u-container">
    <div class="un-head un-head--solo">
      <div>
        <p class="as-kicker" data-reveal>{download.kicker}</p>
        <ClipHeading class="as-h as-h--md un-head__h" id="un-dl-t" stagger={140} text={download.heading} />
        <span class="un-rule" aria-hidden="true"></span>
      </div>
    </div>

    <ul class="un-rows">
      {catalogues.map((c, i) => (
        <li class="un-row" data-pop data-pop-delay={110 + i * 90}>
          <span class="un-row__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.doc} />
            </svg>
          </span>
          <span class="un-row__t">
            <span class="un-row__k">{c.title}</span>
            <span class="un-row__v t-tabular">
              {c.session}{c.revised && <> <span class="un-cat__dot" aria-hidden="true">·</span> {c.revised}</>}
              {' '}<span class="un-cat__dot" aria-hidden="true">·</span> {c.pages} pages
              {' '}<span class="un-cat__dot" aria-hidden="true">·</span> {c.size}
            </span>
          </span>
          <span class="un-row__acts">
            <a class="un-btn" href={c.href} target="_blank" rel="noopener noreferrer">
              View PDF
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.external} />
              </svg>
            </a>
            <a class="un-btn un-btn--solid" href={c.href} download>
              Download
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
              </svg>
            </a>
          </span>
        </li>
      ))}
    </ul>

    <RichLine class="un-dl__note" text={download.note} />
  </div>
</section>

<style>
  /* ═══ SHARED CHROME ═══════════════════════════════════════════════════════ */
  .un-rule {
    display: block;
    width: clamp(34px, 3.4vw, 46px);
    height: 3px;
    margin: clamp(9px, 1.1vw, 14px) 0 0;
    border-radius: 3px;
    background: var(--sb-orange-bright);
  }
  .un-head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
    gap: clamp(20px, 2.6vw, 40px);
    align-items: end;
    margin: 0 0 clamp(22px, 2.8vw, 36px);
  }
  .un-head--solo { grid-template-columns: minmax(0, 1fr); }
  .un-head > div { display: grid; justify-items: start; }
  .un-head__h { margin-top: 0; max-width: 18ch; }
  .un-head__n { margin: 0; max-width: 52ch; font-size: clamp(10px, 0.76vw, 12.2px); line-height: 1.68; color: var(--sb-text-muted); }

  .un-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: clamp(8px, 0.95vw, 11px) clamp(14px, 1.6vw, 20px);
    border: 1.5px solid color-mix(in srgb, var(--sb-orange-bright) 52%, transparent);
    border-radius: var(--sb-r-1);
    font-size: clamp(10px, 0.76vw, 12.2px);
    font-weight: 700;
    white-space: nowrap;
    color: var(--sb-orange-bright);
    transition: background 220ms var(--sb-ease), color 220ms var(--sb-ease), border-color 220ms var(--sb-ease);
  }
  .un-btn svg { width: 13px; height: auto; }
  .un-btn:hover { border-color: var(--sb-orange-bright); background: var(--sb-orange-bright); color: #fff; }
  .un-btn--solid { border-color: var(--sb-orange-bright); background: var(--sb-orange-bright); color: #fff; }
  .un-btn--solid:hover { border-color: var(--sb-violet); background: var(--sb-violet); }

  /* ═══ 01 · THE CATALOGUES ═════════════════════════════════════════════════ */
  .un-top__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(26px, 3.6vw, 58px);
    align-items: center;
  }
  .un-top__h { max-width: 14ch; }
  .un-top__copy .as-body { max-width: 40ch; }

  .un-cats { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(14px, 1.8vw, 24px); margin: 0; padding: 0; list-style: none; }
  .un-cat {
    position: relative;
    display: grid;
    align-content: start;
    padding: clamp(18px, 2.2vw, 28px) clamp(17px, 2vw, 24px) clamp(18px, 2.2vw, 26px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-3);
    background: var(--sb-paper);
    box-shadow: 0 6px 22px -16px rgba(28, 14, 8, 0.28);
    transition: transform 240ms var(--sb-ease), border-color 240ms var(--sb-ease), box-shadow 240ms var(--sb-ease);
  }
  .un-cat:hover {
    transform: translateY(-4px);
    border-color: color-mix(in srgb, var(--sb-orange-bright) 44%, transparent);
    box-shadow: var(--sb-shadow-card);
  }
  /* The big ghosted numeral behind the icon, as the reference has it. */
  .un-cat__n {
    position: absolute;
    top: clamp(10px, 1.3vw, 16px);
    left: clamp(15px, 1.8vw, 22px);
    font-family: var(--sb-font-display);
    font-size: clamp(34px, 3.6vw, 54px);
    font-weight: 800;
    line-height: 1;
    letter-spacing: -0.04em;
    color: color-mix(in srgb, var(--sb-orange-bright) 14%, transparent);
    pointer-events: none;
  }
  .un-cat__m {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(38px, 3.6vw, 50px);
    aspect-ratio: 1 / 1;
    margin-left: auto;
    border-radius: 50%;
    background: var(--sb-orange-bright);
    color: #fff;
  }
  .un-cat__m svg { width: 48%; height: auto; }
  .un-cat__k {
    margin: clamp(12px, 1.5vw, 18px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.06vw, 17px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .un-cat__s { margin: 4px 0 0; font-size: clamp(10px, 0.76vw, 12.2px); font-weight: 700; color: var(--sb-orange-bright); }
  .un-cat__r { margin: 2px 0 0; font-size: clamp(9px, 0.68vw, 10.8px); color: var(--sb-text-muted); }
  .un-cat__meta {
    margin: clamp(9px, 1.1vw, 13px) 0 0;
    font-size: clamp(9px, 0.68vw, 10.8px);
    letter-spacing: 0.05em;
    color: var(--sb-text-muted);
  }
  .un-cat__dot { color: var(--sb-border-strong); }
  .un-cat__acts { display: flex; flex-wrap: wrap; gap: 8px; margin: clamp(13px, 1.6vw, 19px) 0 0; }
  .un-cat__as {
    margin: clamp(10px, 1.2vw, 14px) 0 0;
    padding-top: clamp(9px, 1.1vw, 13px);
    border-top: 1px solid var(--sb-border);
    font-size: clamp(8.6px, 0.64vw, 10.2px);
    font-style: italic;
    line-height: 1.55;
    color: var(--sb-text-muted);
  }

  /* ═══ 02 · CLASS GROUPS ═══════════════════════════════════════════════════ */
  .un-groups { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(12px, 1.5vw, 20px); margin: 0; padding: 0; list-style: none; }
  .un-group {
    display: grid;
    align-content: start;
    padding: clamp(16px, 2vw, 24px) clamp(15px, 1.8vw, 21px) clamp(18px, 2.1vw, 25px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    transition: transform 240ms var(--sb-ease), border-color 240ms var(--sb-ease);
  }
  .un-group:hover { transform: translateY(-3px); border-color: color-mix(in srgb, var(--sb-orange-bright) 44%, transparent); }
  .un-group__m { display: block; width: clamp(26px, 2.4vw, 34px); color: var(--sb-orange-bright); }
  .un-group__m svg { display: block; width: 100%; height: auto; }
  .un-group__n {
    margin-top: clamp(10px, 1.2vw, 15px);
    font-size: clamp(8.6px, 0.64vw, 10.2px);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sb-orange-bright);
  }
  .un-group__k {
    margin: 4px 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.06vw, 17px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .un-group__v { margin: clamp(6px, 0.8vw, 10px) 0 0; font-size: clamp(9.5px, 0.7vw, 11px); line-height: 1.62; color: var(--sb-text-muted); }

  /* ═══ 03 · SEASONS ════════════════════════════════════════════════════════ */
  .un-seasons {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .un-season {
    display: grid;
    justify-items: center;
    align-content: start;
    padding: clamp(4px, 0.6vw, 8px) clamp(14px, 2vw, 28px);
    text-align: center;
  }
  .un-season:first-child { padding-left: 0; }
  .un-season:last-child { padding-right: 0; }
  .un-season + .un-season { border-left: 1px dashed var(--sb-border-strong); }
  .un-season__m {
    display: grid;
    place-items: center;
    width: clamp(38px, 3.4vw, 48px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-paper);
    border: 1px solid var(--sb-border);
    color: var(--sb-orange-bright);
  }
  .un-season__m svg { width: 48%; height: auto; }
  .un-season__k {
    margin-top: clamp(9px, 1.1vw, 14px);
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.06vw, 17px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .un-season__v { margin-top: 2px; font-size: clamp(9.5px, 0.72vw, 11.4px); font-weight: 700; color: var(--sb-orange-bright); }

  /* ═══ 04 · SHOES + NOTES ══════════════════════════════════════════════════ */
  .un-det__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(0, 0.88fr);
    gap: clamp(26px, 3.4vw, 54px);
    align-items: start;
  }
  .un-det__h { margin-top: 0; }
  /* ⚠ THE SCROLLER IS THE WRAPPER. Four columns of garment description do not
     fit a phone, and a table that shrinks below legibility is worse than one
     that scrolls. */
  .un-tabwrap {
    margin: clamp(16px, 2vw, 24px) 0 0;
    overflow-x: auto;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
  }
  .un-tab { width: 100%; min-width: 520px; border-collapse: collapse; text-align: left; }
  .un-tab th[scope='col'] {
    padding: clamp(10px, 1.1vw, 14px) clamp(11px, 1.2vw, 16px);
    border-bottom: 1px solid var(--sb-border);
    background: var(--sb-sand);
    font-size: clamp(9px, 0.68vw, 10.6px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-text-secondary);
  }
  .un-tab tbody tr + tr { border-top: 1px solid var(--sb-border); }
  .un-tab td,
  .un-tab tbody th {
    padding: clamp(10px, 1.1vw, 14px) clamp(11px, 1.2vw, 16px);
    font-size: clamp(9.6px, 0.72vw, 11.4px);
    line-height: 1.5;
    vertical-align: top;
    color: var(--sb-text-secondary);
  }
  .un-tab tbody th { font-weight: 700; white-space: nowrap; color: var(--sb-charcoal); }
  .un-tab__days { white-space: nowrap; font-weight: 700; color: var(--sb-violet); }
  .un-det__src {
    margin: clamp(9px, 1.1vw, 13px) 0 0;
    font-size: clamp(8.8px, 0.66vw, 10.4px);
    font-style: italic;
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  .un-det__notes {
    padding: clamp(18px, 2.2vw, 28px) clamp(17px, 2vw, 24px);
    border: 1px solid color-mix(in srgb, var(--sb-orange-bright) 34%, transparent);
    border-left: 3px solid var(--sb-orange-bright);
    border-radius: var(--sb-r-2);
    background: var(--sb-violet-wash);
  }
  .un-note__head { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(11px, 1.3vw, 15px); align-items: center; }
  .un-note__m {
