---
/**
 * THE CARD GRID — a card per item, and nothing else on the card.
 *
 * Shared by Workshops and School Events. The route prefix arrives as `base`.
 *
 * ═══ WHY THE CARD IS THIS BARE ═════════════════════════════════════════════
 *
 * Client: "only card show and heading of the workshop is written and view type
 * button to go detail page." So the card carries the heading and the button,
 * and the trainer, the institution and the date — which used to sit on the
 * index — move to the detail page where there is room for them.
 *
 * That is the right split anyway. The old ledger put every fact about all
 * thirteen sessions on one screen, which made the page long and made no single
 * workshop findable. A card grid makes the SET scannable and the detail page
 * makes each one readable.
 *
 * ⚠ THE GROUP HEADINGS STAY. Thirteen identical cards in one run is a wall;
 * three labelled groups of four-ish is a structure. The groups are the same
 * ones the ledger used, so nothing has been re-categorised.
 *
 * ⚠ A CARD WITHOUT A `slug` DOES NOT OPEN. It renders as a plain tile with no
 * button rather than a button that goes nowhere — the same rule as the nav
 * submenu, and for the same reason.
 */
import CmsImage from '../ui/CmsImage.astro';
import type { ChroniclePage } from '../../lib/cms';
import { faceOf } from '../../lib/cms';

interface Props {
  page: ChroniclePage;
  /**
   * Route prefix for a card's detail page — '/news-events/workshops/' etc.
   *
   * ⚠ A PROP, NOT A CONSTANT. This grid was written for Workshops with the path
   * hard-coded, and School Events needed the identical design. Copying it would
   * have meant two files drifting apart the first time either was touched — the
   * same reasoning recorded in ui/BurstCard.astro, which exists because that
   * card was needed twice.
   */
  base: string;
  /**
   * What one card IS — 'session' for workshops, 'event' for school events.
   *
   * ⚠ THIS WAS HARD-CODED TO 'session', and the School Events page duly
   * announced "4 SESSIONS" above four events. A shared component cannot name
   * the thing it lists; only its caller knows what that is.
   */
  unit?: string;
  /**
   * The plural, when English will not make it by adding an s.
   *
   * ⚠ THE `unit + 's'` RULE PRINTED "5 ENTRYS". Naive pluralisation is fine for
   * session/event/day and wrong for entry/match/party, and the component cannot
   * know which it has been handed. The caller states the plural when it is
   * irregular; everything else keeps working untouched.
   */
  units?: string;
}

const { page, base, unit = 'session', units = `${unit}s` } = Astro.props;

/* Numbering runs across the whole set, not per group — the reader is counting
   workshops, not counting within a category. */
let n = 0;
---

{
  page.groups.map((g, gi) => (
    <section class:list={['wgrid', `wgrid--${['paper', 'ivory', 'sand'][gi % 3]}`]} id={g.id} aria-labelledby={`${g.id}-h`}>
      <div class="u-container">
        {/* ⚠ THE GROUP NAME IS THE HEADING; THE DESCRIPTION IS NOT. This block
            used to print the label as a small eyebrow and promote `note` — a
            sentence ending in a full stop — to the h2. Two things were wrong
            with that: a display heading closed by a full stop reads as a
            caption rather than a title, and the eyebrow said the same thing
            immediately above it.

            Now the label is the h2 and the note supports it, which is also the
            order the section rail and the URL fragment already use. */}
        <div class="wgrid__head">
          {/* ⚠ THE STAR IS NOT INSIDE `data-split`. That attribute hands the
              heading to the motion chunk, which re-wraps its text into per-line
              masks — a pseudo-element on the heading would be re-parented or
              clipped by that. It is drawn on a wrapper the splitter does not
              touch, so the sparkle survives the animation. */}
          <h2 class="wgrid__h u-starred" id={`${g.id}-h`}>
            <span data-split>{g.label}</span>
          </h2>
          <p class="wgrid__note">{g.note}</p>
          {/* ⚠ ONE TEMPLATE LITERAL, NOT TWO ADJACENT EXPRESSIONS. Written as
              `{n} {n === 1 ? 'session' : 'sessions'}` the compiler dropped the
              whitespace between them and the page read "6SESSIONS". Building
              the whole string in one expression leaves nothing to trim. */}
          <p class="wgrid__n">{`${g.items.length} ${g.items.length === 1 ? unit : units}`}</p>
        </div>

        <ul class="wgrid__list">
          {g.items.map((item) => {
            n += 1;
            /* ⚠ `art` WINS OVER THE FOLDER. A workshop resolves its face from
               photoDir through the assets glob; an award graphic is a single
               poster already imported by data/achievements.ts and has no folder
               to point at. */
            /* ⚠ SAME PRECEDENCE AS BEFORE — art beats the gallery. It used to resolve
               the folder through a Vite glob; the gallery is CMS content now and
               faceOf() applies the identical rule. */
            const face = faceOf(item);

            /* ⚠ A POSTER IS FRAMED, NOT CROPPED. The full-bleed treatment below
               covers the card and lays white copy over the picture — right for a
               photograph of a session, wrong for a designed graphic that carries
               its own headline and crest. `fit: 'contain'` puts the artwork whole
               on a mat at the top of an ordinary card instead. See the header of
               beyond/achievements/Majors.astro: an earlier build used one of
               these as a full-bleed background and cropped its headline away. */
            const framed = item.fit === 'contain';
            const to = item.href ?? (item.slug ? `${base}${item.slug}/` : null);

            return (
              <li class:list={['wcard', face && !framed && 'wcard--shot', framed && 'wcard--art']}>
                {/* ⚠ THE PICTURE IS DECORATIVE HERE — alt="". The card's own
                    heading names the session immediately below it, so a
                    described image would make a screen reader announce the same
                    workshop twice before the link. The real description lives on
                    the detail page, where the photographs are the content. */}
                {face && (
                  <div class:list={[framed ? 'wcard__art' : 'wcard__face']}>
                    <CmsImage
                      file={face}
                      alt=""
                      sizes="(max-width: 700px) 92vw, (max-width: 1100px) 46vw, 30vw"
                      fallbackWidth={420}
                      loading="lazy"
                    />
                  </div>
                )}
                <p class="wcard__n t-tabular" aria-hidden="true">{String(n).padStart(2, '0')}</p>

                {/* ⚠ ONLY WHERE THE SCHOOL PUBLISHED ONE. Roughly half these
                    items carry no date — a festival recurs every year, and the
                    school dates very few of them — so this is rendered
                    conditionally rather than with an "n/a" or a guessed year.
                    An empty slot says nothing; an invented one says something
                    false. Same rule as the counted figures above the grid. */}
                {item.when && <p class="wcard__when t-tabular">{item.when}</p>}

                <h3 class="wcard__t">{item.title}</h3>

                {to ? (
                  <a class="wcard__go" href={to}>
                    <span>View details</span>
                    <span class="wcard__arrow" aria-hidden="true">
                      <svg width="15" height="10" viewBox="0 0 14 10" fill="none">
                        <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.7" />
                      </svg>
                    </span>
                    {/* The heading is inside the card, not inside the link, so a
                        screen-reader user tabbing the buttons would otherwise
                        hear "View details" thirteen times with no way to tell
                        them apart. */}
                    <span class="u-visually-hidden"> — {item.title}</span>
                  </a>
                ) : (
                  <p class="wcard__none">Detail page to follow</p>
                )}
              </li>
            );
          })}
        </ul>
      </div>
    </section>
  ))
}

<style>
  .wgrid { padding-block: var(--sb-section-y); }

  .wgrid--paper { background: var(--sb-paper); }
  .wgrid--ivory { background: var(--sb-ivory); }
  .wgrid--sand { background: var(--sb-sand); }

  .wgrid__h {
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.034em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .wgrid__note {
    max-width: 52ch;
    margin-top: var(--sb-4);
    font-size: var(--sb-body);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }

  .wgrid__n {
    margin-top: var(--sb-5);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-text-secondary);
  }

  .wgrid__list {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--sb-4);
    margin: clamp(26px, 3.4vh, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  /* ⚠ THE CARD IS A GRID WITH THE BUTTON ON ITS OWN ROW, PINNED TO THE BOTTOM.
     Card titles here run from "Critical Thinking" to a sixty-eight character
     conference name, so a flow layout would leave every button at a different
     height and the row would read as ragged. `1fr` on the title row pushes the
     button down to a common baseline whatever the title does.

     ⚠ THE FLOOR IS 168px, NOT 200px, BECAUSE OF THE ALL-PLAIN GRIDS. Workshops
     mixes photograph cards (340px) with plain ones, and grid stretch pulls the
     plain ones up to the row anyway — so the floor was never visible there.
     Competitions and Celebrations have no photographs at all, which made every
     card in the grid sit at exactly 200px with a band of empty ground between a
     one-line title and its button. 168px is the height a two-line title needs;
     below that the card is compact rather than half-empty, and nothing on the
     mixed grids moves. */
  .wcard {
    /* ⚠ POSITIONED SO THE DATE BADGE HAS SOMETHING TO PIN TO. `position:
       relative` alone creates no stacking context — only `relative` WITH a
       `z-index` does — so this cannot repeat the flyout bug where a positioned
       ancestor silently became the containing block for something else. */
    position: relative;
    display: grid;
    /* ⚠ AN EXPLICIT minmax(0, 1fr) COLUMN, OR THE ARTWORK BLOWS THE CARD OPEN.
       With rows declared and no columns, the implicit column is `auto` — which
       sizes to its content's MAX-CONTENT width. A heading and a button have no
       max-content worth speaking of, so this was harmless until the framed award
       posters arrived: measured at 1440, three 419px cards held art frames of
       489, 599 and 571px and the page scrolled 99px sideways. `minmax(0, …)` is
       what lets a track shrink below its content, exactly as it already does on
       `.wgrid__list` above. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
    gap: var(--sb-4);
    min-height: 168px;
    padding: clamp(18px, 2vw, 26px);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    transition: transform var(--sb-dur-link) var(--sb-ease), box-shadow var(--sb-dur-link) ease;
  }

  .wgrid--paper .wcard { background: var(--sb-ivory); }

  /* ═══ THE PHOTOGRAPH CARD ════════════════════════════════════════════════
     The picture fills the whole card and the copy sits on it, rather than the
     picture being a strip along the top. The hover language is BurstCard's —
     the same lift, shadow and warm border used on Parent Partnership — so the
     two read as one system rather than two people's cards.

     ⚠ THE SCRIM IS SIZED FOR THE WORST PHOTOGRAPH, NOT THE AVERAGE ONE. These
     images are not art-directed: one is a projector screen at full brightness,
     another a sunlit courtyard. White text over an unknown photograph is only
     safe if the scrim alone can carry it, so the bottom band reaches 0.88 —
     which over pure white still resolves to about rgb(52,49,48) and holds white
     text at roughly 12:1. The image can be anything and the text stays legible.

     ⚠ `isolation: isolate` MATTERS HERE. The scrim and the picture both sit
     below the copy on the z-axis; without a stacking context of its own the
     card's negative z-index children would punch through the section ground
     behind it and the photograph would vanish. */
  /* ⚠ flex, NOT THE BASE CARD'S GRID. The base card is `auto 1fr auto`, which
     puts the flexible row in the MIDDLE and pushes the button to the bottom —
     right for a card whose copy starts at the top. Here the copy has to sit in
     the scrim's dark foot, so the flexible space belongs ABOVE everything.
     Measured before the change, the title sat at 17% of the card's height, in
     the pale part of the gradient. */
  .wcard--shot {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: var(--sb-4);
    min-height: 340px;
    padding: clamp(18px, 2vw, 26px);
    overflow: hidden;
    background: var(--sb-charcoal);
    box-shadow: inset 0 0 0 1px var(--sb-border);
  }

  .wcard--shot .wcard__go,
  .wcard--shot .wcard__none { align-self: flex-start; }

  .wgrid--paper .wcard--shot,
  .wgrid--sand .wcard--shot { background: var(--sb-charcoal); }

  /* ═══ THE FRAMED-ARTWORK CARD ══════════════════════════════════════════════
     An ordinary card with the poster shown WHOLE on a mat at the top. It keeps
     the grid's radius, border, hover lift and button, so it reads as the same
     family as the photograph cards — only the picture is presented differently,
     because a designed graphic and a photograph are different things.

     The mat is what stops a poster with its own white ground from floating on
     the card. `aspect-ratio` gives every card in the row the same frame height
     whatever proportion the artwork inside it happens to be. */
  /* ⚠ flex, NOT THE BASE CARD'S GRID. The base is `auto 1fr auto`, which puts
     the flexible row SECOND — fine when the first child is the number, since the
     slack then sits above the title and pins it to the button. With the artwork
     taking row one, the number lands in the flexible row and the title is left
     hanging off the button instead of sitting under the picture: measured at
     1440, a one-line title started 28px lower than a two-line one across a row
     of otherwise identical cards. As a flex column the art, number and title
     stack from the top and only the button is pushed down. */
  .wcard--art {
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .wcard--art .wcard__go { margin-top: auto; align-self: flex-start; }

  .wcard__art {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    margin-bottom: var(--sb-4);
    padding: clamp(12px, 1.4vw, 18px);
    /* ⚠ --sb-r-0, NOT --sb-r-1. I guessed the token name and `--sb-r-1` is the
       full pill, 999px — combined with `overflow: hidden` that clipped every
       award poster into an ellipse and cut the corners off the artwork. The
       image radius in this system is --sb-r-0 (16px); the pill is for buttons
       and badges. */
    border-radius: var(--sb-r-0);
    background: var(--sb-sand);
  }

  /* ⚠ `min-height: 0` ON THE GRID ITEM, OR THE RATIO IS ADVISORY. A grid item
     defaults to `min-height: auto`, which refuses to shrink below its content's
     min-content height — so the two PORTRAIT posters pushed their frames taller
     than 4:3 and the three cards' titles stopped aligning. Measured at 1440: the
     frames came out at three different heights against a declared single ratio.
     Zeroing the floor lets the declared box win. */
  .wcard__art :global(picture) {
    display: block;
    /* Definite, so the image's own 100% height below has something real to
       resolve against. */
    width: 100%;
    height: 100%;
    min-height: 0;
  }

  /* ⚠ 100% BOTH WAYS PLUS `contain`, NOT `auto` WITH max-* CAPS. The capped
     version looked right and was not: `max-height: 100%` resolves against the
     <picture>, and while that was `height: auto` the percentage was indefinite
     and never bound — so both PORTRAIT posters rendered at full frame width and
     were clipped off at the bottom. The same indefinite-height trap the lightbox
     hit. With the picture given a definite height above, `object-fit: contain`
     does the fitting and cannot overflow. */
  .wcard__art :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    /* NEVER `cover` here. That is the whole point of this variant. */
    object-fit: contain;
    transition: transform 620ms var(--sb-ease);
  }

  .wcard--art:hover .wcard__art :global(img) { transform: scale(1.04); }

  .wcard__face {
    position: absolute;
    z-index: 0;
    inset: 0;
    overflow: hidden;
  }

  /* ⚠ THE <picture> WRAPPER HAS TO BE STRETCHED TOO, NOT JUST THE <img>. Astro's
     Picture emits <picture><source…><img></picture>, and `<picture>` is an inline
     box by default — so `height: 100%` on the img resolved against a wrapper
     that was only as tall as its own content. Measured: a 279px image in a 340px
     card, leaving a strip of bare charcoal under the photograph. */
  .wcard__face :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .wcard__face :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 620ms var(--sb-ease);
  }

  /* The scrim. Weighted to the foot, where the copy is. */
  .wcard__face::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(24, 12, 8, 0.12) 0%,
      rgba(24, 12, 8, 0.34) 42%,
      rgba(24, 12, 8, 0.78) 74%,
      rgba(24, 12, 8, 0.88) 100%
    );
  }

  .wcard--shot:hover .wcard__face :global(img) { transform: scale(1.06); }

  .wcard--shot:hover {
    transform: translateY(-6px);
    box-shadow: 0 30px 66px -30px rgba(28, 14, 8, 0.42);
  }

  /* The copy rides above both layers, and the number/title/button recolour for
     the dark ground. */
  .wcard--shot .wcard__n,
  .wcard--shot .wcard__t,
  .wcard--shot .wcard__go,
  .wcard--shot .wcard__none { position: relative; z-index: 1; }

  .wcard--shot .wcard__n { color: var(--sb-lime); }
  .wcard--shot .wcard__t { color: #fff; }
  .wcard--shot .wcard__none { color: rgba(255, 255, 255, 0.72); }

  .wcard--shot .wcard__go {
    border-color: rgba(255, 255, 255, 0.55);
    color: #fff;
  }

  .wcard--shot .wcard__go:hover,
  .wcard--shot .wcard__go:focus-visible {
    background: #fff;
    border-color: #fff;
    color: var(--sb-charcoal);
  }

  .wcard:hover {
    transform: translateY(-3px);
    box-shadow: inset 0 0 0 1px transparent, var(--sb-shadow-card-hover);
  }

  .wcard__n {
    font-family: var(--sb-font-display);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sb-violet-dark);
  }

  /* ═══ THE DATE BADGE ══════════════════════════════════════════════════════
     Pinned to the corner rather than placed in the flow, because the two card
     variants lay their copy out in opposite directions: the plain card runs
     top-down from the number, while the photograph card is a flex column
     pushed to the BOTTOM so the copy sits in the dark foot of the scrim. A
     flow-placed date would land under the title on one and above it on the
     other. Pinned, it reads at the top-right of both, opposite the number.

     `inset` matches the card's own padding so it lines up with the number's
     baseline rather than floating in from the edge. */
  .wcard__when {
    position: absolute;
    top: clamp(18px, 2vw, 26px);
    right: clamp(18px, 2vw, 26px);
    max-width: 58%;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-align: right;
    text-transform: uppercase;
    color: var(--sb-text-secondary);
  }

  /* ⚠ THE PHOTOGRAPH CARD NEEDS ITS OWN GROUND, NOT JUST A LIGHTER COLOUR. The
     scrim is deliberately weakest at the top — 0.12 — because the copy it
     protects sits at the foot. Plain white text up here would be laid over an
     unmodified photograph, which for this set includes a sunlit courtyard and a
     projector screen at full brightness. The pill carries its own 0.62 ground,
     which over even pure white resolves to about rgb(112,105,102) and holds
     white text at roughly 4.7:1 whatever the picture underneath is doing. */
  .wcard--shot .wcard__when {
    z-index: 1;
    padding: 5px 10px;
    border-radius: var(--sb-r-full);
    background: rgba(24, 12, 8, 0.62);
    color: #fff;
    backdrop-filter: blur(3px);
  }

  .wcard__t {
    align-self: start;
    font-family: var(--sb-font-display);
    font-size: clamp(18px, 1.6vw, 23px);
    font-weight: 650;
    line-height: 1.2;
    letter-spacing: -0.024em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .wcard__go {
    display: inline-flex;
    align-items: center;
    justify-self: start;
    gap: var(--sb-3);
    min-height: 24px;
    padding: 10px 18px;
    border: 1px solid var(--sb-violet);
    border-radius: var(--sb-r-full);
    color: var(--sb-violet-dark);
    font-size: var(--sb-body-sm);
    font-weight: 700;
    text-decoration: none;
    transition: background var(--sb-dur-btn) ease, color var(--sb-dur-btn) ease;
  }

  .wcard__go:hover,
  .wcard__go:focus-visible {
    background: var(--sb-violet);
    color: #fff;
  }

  .wcard__go:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 3px; }

  .wcard__arrow { display: grid; place-items: center; transition: transform var(--sb-dur-btn) var(--sb-ease); }
  .wcard__go:hover .wcard__arrow { transform: translateX(4px); }

  .wcard__none {
    justify-self: start;
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-text-secondary);
  }

  @media (min-width: 700px) {
    .wgrid__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (min-width: 1100px) {
    .wgrid__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  @media (prefers-reduced-motion: reduce) {
    .wcard,
    .wcard__go,
    .wcard__arrow,
    .wcard__face :global(img) { transition-duration: 1ms; }
    .wcard:hover { transform: none; }
    .wcard__go:hover .wcard__arrow { transform: none; }
    .wcard--shot:hover .wcard__face :global(img) { transform: none; }
  }
</style>
