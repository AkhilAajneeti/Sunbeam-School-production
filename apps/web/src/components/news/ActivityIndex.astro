---
import { getActivitiesData } from '../../lib/cms';

const { schoolActivities, activityItems, activityPage, pageCount } = await getActivitiesData();
/**
 * SCHOOL ACTIVITIES INDEX — the body shared by page 1 and every later page.
 *
 * ⚠ ONE COMPONENT, TWO ROUTES, AND THAT IS THE POINT. Page 1 is `index.astro`
 * (so the first page is the bare route rather than `/page/1/`) and the rest are
 * `page/[page].astro`. Those are necessarily two files; if each carried its own
 * copy of the banner, the rail, the intro and the grid, the two would drift the
 * first time either was touched and only the second page would show it. Both
 * routes are now thin: they work out which page they are and hand it here.
 */
import PageHero from '../ui/PageHero.astro';
import SectionRail from '../academics/SectionRail.astro';
import IndexIntro from './IndexIntro.astro';
import CardGrid from './CardGrid.astro';
import Pager from './Pager.astro';


import heroPhoto from '../../assets/photos/sunbeem-1.jpg';

interface Props {
  /** 1-based. */
  current: number;
}

const { current } = Astro.props;
const BASE = '/beyond-academics/school-activities/';
const view = activityPage(current);

/**
 * ⚠ COUNTED FROM THE DATA, NEVER TYPED — the rule the Workshops index states and
 * the reason its figures cannot drift as items are added. `photographs` sums the
 * counts the school itself published, which is why it is far larger than the
 * number of files in the repo: the source published 2,797 frames across its
 * activities page and this build carries a selection of each gallery.
 */
const totalPhotos = activityItems.reduce((n, i) => n + (parseInt(i.meta, 10) || 0), 0);

/**
 * ⚠ THE VERB AGREES WITH THE NUMBER, AND RIGHT NOW THE NUMBER IS ONE. Written
 * flat as 'carry a date' the strip read "1 carry a date" — and this is exactly
 * the figure most likely to stay at one, because only a single gallery in the
 * source states a year at all. A counted figure has to survive its own count.
 */
const dated = activityItems.filter((i) => i.when).length;

const figures = [
  { n: activityItems.length, k: 'activities on record' },
  { n: totalPhotos, k: 'photographs published by the school' },
  { n: dated, k: dated === 1 ? 'carries a date' : 'carry a date' },
];

/**
 * ⚠ THE RAIL LISTS ONLY THE GROUPS ON THIS PAGE. Left pointing at all four, the
 * second page would offer anchors to two sections that are not in its document —
 * a jump link that does nothing, which is worse than an absent one.
 */
const rail = view.groups.map((g) => ({ id: g.id, label: g.label }));
---

<PageHero
  title={schoolActivities.title}
  standfirst={schoolActivities.standfirst}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Beyond Academics', href: '/beyond-academics/' },
  ]}
  src={heroPhoto}
  alt="The main building of Sunbeam School Ballia seen across its ground"
  position="50% 58%"
/>

<SectionRail items={rail} />

<div class="u-page-panel sa-panel">
  {/* ⚠ THE INTRO IS ON PAGE ONE ONLY. Repeated above page two it would read as
      the page restarting, and it would push the cards a screen further down for
      a reader who has already read it once. */}
  {current === 1 && (
    <IndexIntro
      eyebrow={schoolActivities.eyebrow}
      heading={schoolActivities.heading}
      stand={schoolActivities.stand}
      figures={figures}
    />
  )}

  {/* `unit` matters: shared with Workshops, this grid would otherwise print
      "6 SESSIONS" above six activities. */}
  <CardGrid page={view} base={BASE} unit="activity" units="activities" />
</div>

<Pager current={current} total={pageCount} base={BASE} label="activities" />

<style>
  div.sa-panel { padding-block: 0; }

  .sa-panel :global(section[id]) {
    scroll-margin-top: calc(var(--sb-masthead-h) + 24px);
  }
</style>
