       in half. It now breaks the lead photograph's corner and nothing else. */
    left: 52%;
    bottom: clamp(16px, 3vw, 54px);
    width: clamp(88px, 10vw, 148px);
    aspect-ratio: 1 / 1;
    border: 6px solid var(--sb-sand);
