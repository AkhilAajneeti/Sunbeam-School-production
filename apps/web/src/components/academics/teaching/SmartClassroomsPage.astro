---
/**
 * TEACHING & LEARNING · SMART CLASSROOMS & DIGITAL LITERACY — the five sections
 * below the banner.
 *
 * ⚠ COMBINED PAGE — two of the brief's fourteen bullets: Smart Classrooms and
 * AI & Digital Literacy. The standalone /ai-digital-literacy/ route was an
 * implementation experiment; its verified content is merged here.
 *
 * ═══ THE NUMBERS, AND WHY THEY ARE THESE NUMBERS ═══════════════════════════
 * ⚠⚠ READ THIS BEFORE CHANGING ANY FIGURE ON THIS PAGE.
 *
 * The school publishes 75+ digitally smart classrooms and 49+ interactive flat
 * panels. Those exact figures appear in THREE data files that all have to agree:
 *   data/facilities.ts   counters, and the Learning Environment group
 *   data/home.ts         the campus card and its qualifier
 *   data/academics.ts    `room.stats` and the `panels` beat
 *
 * "30+" HAS BEEN WRONG ON THIS SITE ONCE ALREADY. data/facilities.ts still
 * carries the correction note — "WAS 'Thirty-plus classrooms wired for
 * teaching' — a figure matching nothing the school publishes, and one the very
 * next item contradicted with the real 75+". A second reintroduction would put
 * this page in direct conflict with the home page and the facilities page.
 * If the school has since republished 30+, change the DATA FILES first and let
 * every page follow; do not special-case this one.
 *
 * ⚠ AND THE TWO FIGURES ARE PRINTED TOGETHER ON PURPOSE. 49 is FEWER than 75,
 * so the panels do not yet reach every smart classroom. The school publishes
 * both numbers, which means a reader can already work that out — writing past it
 * would be the one thing worse than not mentioning it. Section 03 says it
 * plainly. An earlier build of the retired split page claimed "MORE PANELS THAN
 * ROOMS", which is the arithmetic backwards.
 *
 * ═══ EVERY OTHER CLAIM, AND WHERE IT COMES FROM ════════════════════════════
 *   Junior and senior computer laboratories, 40+ machines each.
 *   100 Microsoft Innovative Educator Experts → a Microsoft Showcase School.
 *   Indian AI Impact Festival, 2024 — Ayushi, of Class VII, placed first.
 *   The Reading Carnival photograph shows the school's own wall of "Microsoft
 *     Innovative Educator Expert 2024" posters — the certification is displayed
 *     in the building, not only stated on a website.
 *
 * ⚠ NOT CLAIMED, BECAUSE IT IS NOT PUBLISHED: a device-per-child ratio, a
 * rollout date for the remaining rooms, an AI syllabus, which classes take
 * digital literacy, any software platform, any named capability of a panel, or
 * any outcome attributed to the equipment.
 *
 * ⚠ SCOPE BOUNDARY — the METHOD that runs on this equipment is Teaching
 * Methodology's; the Robotics Lab, its drone, 3-D printer and telescope belong
 * to STEM, Robotics & Enrichment. This page is the room and the subject, and it
 * links out rather than restating either.
 *
 * ═══ COMPOSITION — one story, not five sections ════════════════════════════
 *   01 · CREAM  the room        → what a smart classroom actually is here
 *   02 · SAND   the system      → the infrastructure, as connected figures
 *   03 · CREAM  the point       → why the equipment is not the story
 *   04 · SAND   in practice     → the same technology inside ordinary days
 *   05 · PHOTO  the close       → what is still changing, and what is not said
 *
 * ⚠ THE DECORATION IS CIRCUITRY, AND IT IS THE ONE THING THAT MAKES THIS PAGE
 * ITS OWN. Teaching Methodology uses dot fields and dashed arcs; this page uses
 * right-angled trace lines with terminal nodes, a fine technical grid and small
 * `+` register marks. Same hand, different subject — which is the whole point.
 * Kept at 6–14% opacity so it never reads as a technology brand.
 *
 * PHOTOGRAPHY is six genuine Sunbeam Ballia frames. No stock, per docs/07, and
 * every caption says what its picture actually shows.
 *
 * MOTION is the project's own attribute set — data-clip, data-reveal, data-pop,
 * data-drift, data-count, data-parallax, data-draw, data-mask, data-zoom.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';

/* ── PHOTOGRAPHY ────────────────────────────────────────────────────────────
   ⚠ SIX DISTINCT FRAMES, and the banner is a seventh. A page about one subject
   is the easiest place on the site to end up showing the same room five times. */
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/teaching-learning/smart-classrooms/');
const pLabBusy = ac.pic('pLabBusy');
const pCanva = ac.pic('pCanva');
const pLabRow = ac.pic('pLabRow');
const pLabEmpty = ac.pic('pLabEmpty2');
const pLabTaught = ac.pic('pLabTaught');
const pCarnival = ac.pic('pCarnival');
const pCohort = ac.pic('pCohort');

const S = 'Sunbeam School Ballia';

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. */
const MARK: Record<string, string> = {
  panel: `<rect x="2.6" y="4.4" width="18.8" height="12.4" rx="1.8"/><path d="M8.4 20.4h7.2M12 16.8v3.6"/><path d="M6.6 12.4l3-3.2 2.4 2 4.4-4.6"/>`,
  spark: `<rect x="3.4" y="3.4" width="17.2" height="17.2" rx="2.4"/><path d="M12 7.6v8.8M7.6 12h8.8"/>`,
  chipJr: `<rect x="5.4" y="5.4" width="13.2" height="13.2" rx="1.8"/><rect x="9.2" y="9.2" width="5.6" height="5.6" rx=".8"/><path d="M9.4 2.6v2.8M14.6 2.6v2.8M9.4 18.6v2.8M14.6 18.6v2.8M2.6 9.4h2.8M2.6 14.6h2.8M18.6 9.4h2.8M18.6 14.6h2.8"/>`,
  tower: `<rect x="6.4" y="2.8" width="11.2" height="18.4" rx="1.8"/><path d="M9.6 6.6h4.8M9.6 9.8h4.8"/><circle cx="12" cy="16.4" r="1.9"/>`,
  touch: `<path d="M9.4 11.2V6a1.9 1.9 0 1 1 3.8 0v7.4"/><path d="M13.2 10.4a1.7 1.7 0 0 1 3.4 0v1M16.6 11.6a1.7 1.7 0 0 1 3.4 0v3.2a6 6 0 0 1-6 6h-1.6c-2 0-3-1-4.2-2.4l-3-3.6a1.8 1.8 0 0 1 2.6-2.4l1.6 1.6"/>`,
  book: `<path d="M12 6.6C10.4 5.1 8 4.6 4 5.1v13c4-.5 6.4 0 8 1.5 1.6-1.5 4-2 8-1.5v-13c-4-.5-6.4 0-8 1.5zM12 6.6v13"/>`,
  rocket: `<path d="M13.6 3.8c3.4 2 5.4 5.8 5.2 9.8l-3.6 3.4-5.6-5.6 3.4-3.6c.2-1.4.4-2.7.6-4Z"/><path d="M9.6 11.4 6 12.6l-1.6-1.6 3.4-3.4 2.4.6"/><path d="m12.6 14.4 1.2 3.6-1.6 1.6-3.4-3.4.6-2.4"/><path d="M7.4 16.6 4.2 19.8"/>`,
};

/* ── THE INFRASTRUCTURE ─────────────────────────────────────────────────────
   ⚠ FOUR PUBLISHED QUANTITIES AND NOTHING ELSE. No derived figure, no ratio, no
   total. See the header note before touching any value. */
/**
 * ⚠ THE ODOMETER DURATIONS STAY IN CODE. `dur` is how long each figure takes to
 * count up — animation configuration, not something a school should have to
 * think about — so it is kept here and matched to the card by its label. The
 * figures and their labels come from the CMS.
 */
const COUNT_DUR: Record<string, number> = {
  'Digitally smart classes': 1.5,
  'Interactive flat panels': 1.2,
  'Junior computer lab computers': 1.35,
  'Senior computer lab computers': 1.6,
};
const system = ac.section('system').points.map((p) => ({ ...p, dur: COUNT_DUR[p.k] ?? 1.4 }));

/* ── THE THREE CONCEPTS ─────────────────────────────────────────────────────
   ⚠ THE LABELS ARE DESIGN, THE LINES UNDER THEM ARE EVIDENCE. Each `body` is a
   published fact and nothing more — no capability, no outcome, no percentage. */
const beyond = ac.section('beyond').points;

const STEM = '/academics/teaching-learning/stem-robotics/';
---

{/* ══ 01 · THE ROOM ══════════════════════════════════════════════════════════
    Ground: cream. Idea: the statement, with an asymmetric photo pair breaking
    the grid at the right, over a fine technical grid and a ghost 75. */}
<section class="sc-room" aria-labelledby="sc-room-t">
  <span class="sc-room__warm" aria-hidden="true"></span>
  <span class="sc-grid" aria-hidden="true"></span>
  <span class="sc-room__ghost" aria-hidden="true" data-parallax data-parallax-y="26">75<i>+</i></span>

  {/* ⚠ THE TRACE, NOT AN ARC. Right angles with terminal nodes — the page's own
      decorative language, and the thing that separates it from the dashed arcs
      on Teaching Methodology. */}
  <svg class="sc-trace sc-room__trace" viewBox="0 0 260 300" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M254 22h-58a12 12 0 0 0-12 12v52a12 12 0 0 1-12 12h-38" />
      <path d="M254 92h-30a12 12 0 0 0-12 12v96a12 12 0 0 1-12 12h-60" />
      <path d="M254 176h-84" />
    </g>
    <circle cx="134" cy="98" r="3.4" fill="currentColor" />
    <circle cx="140" cy="212" r="3.4" fill="currentColor" />
    <circle cx="170" cy="176" r="3.4" fill="currentColor" />
  </svg>

  <div class="u-container sc-room__grid">
    <div class="sc-room__copy">
      <p class="sc-kicker" data-reveal>The room</p>
      <h2 class="sc-h sc-room__h" id="sc-room-t">
        <span data-clip data-clip-delay="0">A smart classroom</span>
        <span data-clip data-clip-delay="130">is more than</span>
        <span data-clip data-clip-delay="240"><em>a screen.</em></span>
      </h2>
      <p class="sc-body" data-reveal data-reveal-delay="200">
        The useful question about a smart classroom is not whether a school has one. It is whether
        a teacher can <strong>assume</strong> it.
      </p>
      <p class="sc-body" data-reveal data-reveal-delay="270">
        {S} publishes <strong>75+ digitally smart classrooms</strong> and
        {' '}<strong>49+ interactive flat panels</strong> — figures at the scale of the whole
        school rather than of a demonstration suite booked by rotation.
      </p>
      <p class="sc-body" data-reveal data-reveal-delay="340">
        Alongside them it runs <strong>two computer laboratories</strong>, junior and senior,
        carrying <strong>40+ machines each</strong>.
      </p>
    </div>

    <div class="sc-room__media">
      <span class="sc-dots" aria-hidden="true"></span>

      <figure class="sc-room__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={pLabBusy}
          alt={ac.picAlt('pLabBusy')}
         
          widths={[560, 900, 1200]}
          sizes="(max-width: 1023px) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="sc-room__inset" data-parallax data-parallax-y="24">
        <SmartImage
          file={pCanva}
          alt={ac.picAlt('pCanva')}
         
          widths={[340, 560]}
          sizes="(max-width: 1023px) 44vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <svg class="sc-plus sc-room__plus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </div>
  </div>
</section>

{/* ══ 02 · THE DIGITAL CLASSROOM SYSTEM ══════════════════════════════════════
    Ground: sand. Idea: four published quantities wired together on one rule
    that draws itself — infrastructure as a circuit, not as four cards. */}
<section class="sc-sys" aria-labelledby="sc-sys-t">
  <span class="sc-sys__warm" aria-hidden="true"></span>
  <span class="sc-grid sc-grid--fine" aria-hidden="true"></span>

  <div class="u-container" data-draw-scope>
    <div class="sc-sys__head">
      <p class="sc-kicker" data-reveal>The digital classroom system</p>
      <h2 class="sc-h sc-sys__h" id="sc-sys-t">
        <span data-clip data-clip-delay="0">Four numbers,</span>
        <span data-clip data-clip-delay="150"><em>and one of them is a gap.</em></span>
      </h2>
    </div>

    <ol class="sc-sys__list">
      {system.map((s, i) => (
        <li class="sc-stat" data-reveal data-reveal-delay={100 + i * 110}>
          {/* ⚠ A WIRE ON BOTH SIDES OF THE NODE, not a trailing one. With the
              wire only to the right every icon sat off-centre above its own
              figure; flanking it centres the node and still draws one
              continuous dashed run across the four. The outer two stubs are
              hidden, so the trace begins and ends at a node. */}
          <div class="sc-stat__rail">
            <span class="sc-stat__wire sc-stat__wire--in" aria-hidden="true"><span data-draw></span></span>
            <span class="sc-stat__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
              </svg>
            </span>
            <span class="sc-stat__wire sc-stat__wire--out" aria-hidden="true">
              <span data-draw></span>
              <i></i>
            </span>
          </div>

          <p class="sc-stat__n t-tabular">
            <span data-count={s.n} data-count-suffix={s.suffix} data-count-dur={s.dur}>{`${s.n}${s.suffix}`}</span>
          </p>
          <p class="sc-stat__k">{s.k}</p>
        </li>
      ))}
    </ol>

    {/* ⚠ THE HONEST LINE, AND IT IS NOT SET AS SMALL PRINT. 49 is fewer than 75.
        The school publishes both figures, so a reader can already see it; saying
        it plainly is what makes the rest of the page worth believing. */}
    <p class="sc-sys__note" data-reveal data-reveal-delay="220">
      Read together the first two say something a marketing sentence would not:
      {' '}<strong>the panels do not yet reach every room.</strong> This is a rollout in progress
      rather than a finished one — and a school that publishes both numbers has already given a
      parent the means to work that out.
    </p>
  </div>
</section>

{/* ══ 03 · BEYOND THE SCREEN ═════════════════════════════════════════════════
    Ground: cream. Idea: the conceptual turn — the equipment is not the story,
    the people certified to use it are. Photo left, a wired path right. */}
<section class="sc-beyond" aria-labelledby="sc-beyond-t">
  <span class="sc-beyond__warm" aria-hidden="true"></span>

  <div class="u-container sc-beyond__grid" data-draw-scope>
    <div class="sc-beyond__media">
      <figure class="sc-beyond__lead" data-mask data-zoom data-zoom-to="1.07">
        <SmartImage
          file={pLabRow}
          alt={ac.picAlt('pLabRow')}
         
          widths={[560, 900, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="sc-beyond__disc" data-parallax data-parallax-y="22">
        <SmartImage
          file={pLabEmpty}
          alt={ac.picAlt('pLabEmpty')}
         
          widths={[300, 480]}
          sizes="(max-width: 1023px) 34vw, 15vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="sc-beyond__copy">
      <p class="sc-kicker" data-reveal>Beyond the screen</p>
      <h2 class="sc-h sc-beyond__h" id="sc-beyond-t">
        <span data-clip data-clip-delay="0">Technology is the tool.</span>
        <span data-clip data-clip-delay="150"><em>Learning</em> is the point.</span>
      </h2>

      <ol class="sc-path">
        {beyond.map((b, i) => (
          <li class="sc-step" data-reveal data-reveal-delay={140 + i * 130}>
            <div class="sc-step__rail">
              <span class="sc-step__n t-tabular">{b.n}</span>
              <span class="sc-step__i" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[b.mark]} />
                </svg>
              </span>
              <span class="sc-step__wire" aria-hidden="true"><span data-draw></span></span>
            </div>
            <h3 class="sc-step__k">{b.k}</h3>
            <p class="sc-step__b">{b.body}</p>
          </li>
        ))}
      </ol>

      <p class="sc-beyond__link" data-reveal data-reveal-delay="520">
        <a href={STEM}>Robotics, coding and the STEM rooms <span aria-hidden="true">→</span></a>
      </p>
    </div>
  </div>
</section>

{/* ══ 04 · TECHNOLOGY IN PRACTICE ════════════════════════════════════════════
    Ground: sand. Idea: the same equipment inside ordinary days — a collage,
    with a caption on each frame saying what it actually shows. */}
<section class="sc-prac" aria-labelledby="sc-prac-t">
  <span class="sc-prac__warm" aria-hidden="true"></span>
  <span class="sc-grid sc-grid--fine" aria-hidden="true"></span>

  <svg class="sc-trace sc-prac__trace" viewBox="0 0 240 260" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M6 18h52a12 12 0 0 1 12 12v60a12 12 0 0 0 12 12h44" />
      <path d="M6 96h28a12 12 0 0 1 12 12v104a12 12 0 0 0 12 12h60" />
    </g>
    <circle cx="126" cy="102" r="3.4" fill="currentColor" />
    <circle cx="118" cy="236" r="3.4" fill="currentColor" />
  </svg>

  <div class="u-container sc-prac__grid">
    <div class="sc-prac__copy">
      <p class="sc-kicker" data-reveal>Technology in practice</p>
      <h2 class="sc-h sc-prac__h" id="sc-prac-t">
        <span data-clip data-clip-delay="0">Real rooms.</span>
        <span data-clip data-clip-delay="130">Real lessons.</span>
        <span data-clip data-clip-delay="240"><em>Nothing staged.</em></span>
      </h2>
      <p class="sc-body" data-reveal data-reveal-delay="200">
        Every photograph below is the school's own, and each caption says what is actually in it.
        None of them is a stock picture of somebody else's laboratory.
      </p>
    </div>

    {/* ONE DOMINANT FRAME, TWO SMALLER ONES BREAKING ITS EDGES. */}
    <div class="sc-prac__stage">
      <figure class="sc-frame sc-frame--lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={pLabTaught}
          alt={ac.picAlt('pLabTaught')}
         
          widths={[620, 1000, 1320]}
          sizes="(max-width: 1023px) 92vw, 54vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>Taught, not just equipped — the shortcut charts are on the wall of the room itself.</figcaption>
      </figure>

      <figure class="sc-frame sc-frame--side" data-parallax data-parallax-y="-24">
        <SmartImage
          file={pCarnival}
          alt={ac.picAlt('pCarnival')}
         
          widths={[380, 640]}
          sizes="(max-width: 1023px) 46vw, 24vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The MIE Expert 2024 posters, up on a corridor wall where parents walk past them.</figcaption>
      </figure>

      <figure class="sc-frame sc-frame--disc" data-parallax data-parallax-y="20">
        <SmartImage
          file={pLabEmpty}
          alt={ac.picAlt('pLabEmpty2')}
         
          widths={[280, 440]}
          sizes="(max-width: 1023px) 32vw, 14vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <svg class="sc-plus sc-prac__plus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
      </svg>
    </div>
  </div>
</section>

{/* ══ 05 · THE CLOSE ═════════════════════════════════════════════════════════ */}
<section class="sc-close" aria-labelledby="sc-close-t">
  <div class="sc-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <SmartImage
      file={pCohort}
      alt={ac.picAlt('pCohort')}
     
      widths={[1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <span class="sc-close__scrim" aria-hidden="true"></span>
  <span class="sc-close__nodes" aria-hidden="true">
    <i style="--x: 11%; --y: 26%; --s: 3px; --o: .5"></i>
    <i style="--x: 24%; --y: 70%; --s: 2px; --o: .32"></i>
    <i style="--x: 48%; --y: 16%; --s: 2px; --o: .34"></i>
    <i style="--x: 71%; --y: 66%; --s: 3px; --o: .44"></i>
    <i style="--x: 89%; --y: 32%; --s: 2px; --o: .3"></i>
  </span>

  <div class="u-container sc-close__inner">
    <svg class="sc-plus sc-close__plus" viewBox="0 0 24 24" fill="none" aria-hidden="true">
      <path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
    </svg>

    <h2 class="sc-h sc-close__h" id="sc-close-t">
      <span data-clip data-clip-delay="0">The classroom</span>
      <span data-clip data-clip-delay="150"><em>keeps changing.</em></span>
    </h2>
    <p class="sc-close__b" data-reveal data-reveal-delay="180">
      The school publishes its room counts, its panel count and the certification behind them. It
      does not publish a device-per-child ratio, a rollout schedule for the remaining rooms, or
      which classes take digital literacy and for how long — so none of those is described here.
    </p>
  </div>
</section>

<style>
  /* ═══ SHARED ══════════════════════════════════════════════════════════════ */
  .sc-kicker {
    margin: 0;
    font-size: clamp(10.5px, 0.78vw, 12px);
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  .sc-h {
    margin: clamp(12px, 1.5vw, 18px) 0 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--sb-charcoal);
  }
  .sc-h span { display: block; }
  .sc-h em { font-style: normal; color: var(--sb-violet); }

  .sc-body {
    max-width: 44ch;
    margin: clamp(13px, 1.6vw, 19px) 0 0;
    font-size: clamp(13px, 0.95vw, 15px);
    line-height: 1.78;
    color: var(--sb-text-secondary);
  }
  .sc-body strong { font-weight: 700; color: var(--sb-charcoal); }

  /* ── THE PAGE'S OWN DECORATIVE LANGUAGE ───────────────────────────────────
     A fine technical grid, right-angled traces with terminal nodes, small `+`
     register marks and a dot field. Kept faint enough that none of it competes
     with a photograph or a figure. */
  .sc-grid {
    position: absolute;
    z-index: -3;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(27, 21, 18, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(27, 21, 18, 0.05) 1px, transparent 1px);
    background-size: 38px 38px;
    -webkit-mask-image: radial-gradient(120% 92% at 28% 42%, #000 0%, transparent 78%);
    mask-image: radial-gradient(120% 92% at 28% 42%, #000 0%, transparent 78%);
  }
  .sc-grid--fine {
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(110% 96% at 66% 46%, #000 0%, transparent 80%);
