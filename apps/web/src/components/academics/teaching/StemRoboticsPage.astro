    transition: opacity var(--sb-dur-link) var(--sb-ease);
  }
  .st-shot__zoom svg { width: 54%; height: auto; }
  .st-shot.is-on:hover .st-shot__zoom,
  .st-shot.is-on:focus-visible .st-shot__zoom { opacity: 1; }

  .st-use__cap {
    grid-area: cap;
    margin: 0;
    font-size: clamp(10.5px, 0.78vw, 12.5px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  /* THE RAIL — vertical on desktop, and it is the thing that stops this being
     a wall of thumbnails: five small frames beside one large one. */
  .st-rail-thumbs {
    grid-area: thumbs;
    display: grid;
    grid-auto-rows: 1fr;
    gap: clamp(7px, 0.8vw, 11px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st-thumb {
    display: block;
    width: clamp(64px, 7vw, 104px);
    height: 100%;
    padding: 0;
    overflow: hidden;
    border: 1px solid transparent;
    border-radius: var(--sb-r-0);
    background: none;
    cursor: pointer;
    opacity: 0.55;
    transition: opacity var(--sb-dur-btn) var(--sb-ease),
      border-color var(--sb-dur-btn) var(--sb-ease), transform var(--sb-dur-btn) var(--sb-ease);
  }
  .st-thumb :global(picture) { display: block; width: 100%; height: 100%; }
  .st-thumb :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .st-thumb:hover { opacity: 0.85; transform: translateY(-2px); }
  .st-thumb.is-on { opacity: 1; border-color: var(--sb-violet); }

  /* ═══ 04 · THE ENRICHMENT ECOSYSTEM ═══════════════════════════════════════ */
  .st-eco {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--sb-ivory);
    padding-block: clamp(38px, 4.6vw, 74px);
  }
  .st-eco__warm {
    position: absolute;
    z-index: -3;
    inset: 0;
    background:
      radial-gradient(58% 66% at 8% 8%, rgba(255, 255, 255, 0.72) 0%, rgba(255, 255, 255, 0) 70%),
      radial-gradient(56% 62% at 94% 92%, rgba(255, 138, 92, 0.1) 0%, rgba(255, 138, 92, 0) 72%);
  }
  .st-eco__circuit {
    position: absolute;
    z-index: -2;
    top: 16%;
    width: clamp(70px, 9vw, 150px);
    height: auto;
    color: rgba(201, 60, 10, 0.22);
  }
  .st-eco__circuit--l { left: clamp(-14px, -0.4vw, -2px); }
  .st-eco__circuit--r { right: clamp(-14px, -0.4vw, -2px); }

  /* ⚠ THE INTRODUCTION TAKES A QUARTER, THE CARDS TAKE THE REST. A wider left
     column pushed the four cards into a narrow strip and the row stopped
     reading as one composition. */
  .st-eco__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.34fr) minmax(0, 1fr);
    gap: clamp(20px, 2.6vw, 44px);
    align-items: center;
  }
  :global(.st-eco__h) { font-size: clamp(24px, 2.8vw, 38px); }
  :global(.st-eco__b) { max-width: 24ch; }
  :global(.st-eco__note) {
    max-width: 28ch;
    margin: clamp(11px, 1.3vw, 16px) 0 0;
    padding-top: clamp(11px, 1.3vw, 16px);
    border-top: 1px solid var(--sb-border);
    font-size: clamp(10px, 0.74vw, 11.5px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }
  :global(.st-eco__note strong) { font-weight: 700; color: var(--sb-charcoal); }

  .st-eco__stage { position: relative; }

  /* THE JOURNEY, behind the cards. */
  .st-eco__path {
    position: absolute;
    z-index: 0;
    inset-inline: clamp(-40px, -2vw, -12px);
    top: 0;
    width: calc(100% + clamp(80px, 4vw, 24px));
    height: 100%;
    overflow: visible;
    /* Behind the cards and quieter than them — at 42% it read as a decorative
       zig-zag competing with the photographs. */
    color: rgba(201, 60, 10, 0.3);
    pointer-events: none;
  }
  .st-eco__draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    color: var(--sb-orange-bright);
    opacity: 0.45;
  }
  /* The connection points, dropped on the gaps between cards where no card
     covers them — five of them, so the run starts before the first card and
     ends after the last. */
  .st-eco__nodes { position: absolute; z-index: 2; inset: 0; pointer-events: none; }
  .st-eco__nodes i {
    position: absolute;
    top: 43%;
    left: calc(var(--k) * 25%);
    translate: -50% -50%;
    width: clamp(7px, 0.7vw, 9px);
    aspect-ratio: 1 / 1;
    border: 1.4px solid rgba(201, 60, 10, 0.55);
    border-radius: 50%;
    background: var(--sb-ivory);
  }

  .st-eco__list {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* THE CARD — picture on top, wave, then icon, title and copy. */
  .st-card {
    display: grid;
    grid-template-rows: auto auto;
    align-content: start;
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
    transition: transform var(--sb-dur-image) var(--sb-ease),
      box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .st-card:hover { transform: translateY(-4px); box-shadow: var(--sb-shadow-card-hover); }

  .st-card__pic {
    position: relative;
    overflow: hidden;
    background: var(--sb-sand);
  }
  .st-card__pic :global(picture) { display: block; }
  .st-card__pic :global(img) {
    display: block;
    width: 100%;
    height: auto;
    /* ⚠ ONE RATIO FOR ALL FOUR, and shallower than 4:3. At 4:3 the picture took
       well over half the card and the four read as photo panels; at 1.38:1 it
       sits at about 45% of the card, which is the reference's balance. */
    aspect-ratio: 1.46 / 1;
    object-fit: cover;
    transition: scale var(--sb-dur-image) var(--sb-ease);
  }
  .st-card:hover .st-card__pic :global(img) { scale: 1.05; }

  /* ⚠ AN SVG WAVE, NOT A BORDER RADIUS. A radius gives an arc; the reference's
     divider between picture and body is a wave, and it is filled with the
     card's own colour so it reads as the body rising into the picture. */
  .st-card__wave {
    position: absolute;
    inset-inline: 0;
    bottom: -1px;
    width: 100%;
    height: clamp(16px, 1.8vw, 26px);
    color: var(--sb-paper);
  }

  /* ⚠ THE BODY ENDS SHORTLY AFTER THE COPY. The card was running to ~500px
     with dead white under every description; icon, title and three lines of
     text plus a bottom margin is the whole of it. */
  .st-card__body { padding: 0 clamp(12px, 1.3vw, 17px) clamp(18px, 2vw, 26px); }
  .st-card__i {
    display: grid;
    place-items: center;
    width: clamp(24px, 2.1vw, 29px);
    aspect-ratio: 1 / 1;
    color: var(--sb-violet);
  }
  .st-card__i svg { width: 100%; height: auto; }
  .st-card__k {
    margin: clamp(6px, 0.7vw, 9px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(16px, 1.5vw, 22px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .st-card__b {
    margin: clamp(6px, 0.7vw, 9px) 0 0;
    font-size: clamp(10.5px, 0.8vw, 12.8px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  /* ═══ 05 · THE CLOSE ══════════════════════════════════════════════════════ */
  .st-close {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(48px, 5.8vw, 92px);
  }
  .st-close__media { position: absolute; z-index: -3; inset: -12% 0; }
  .st-close__media :global(picture),
  .st-close__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 42%;
  }
  .st-close__scrim {
    position: absolute;
    z-index: -2;
    inset: 0;
    background: linear-gradient(to bottom, rgba(22, 10, 4, 0.86) 0%, rgba(22, 10, 4, 0.74) 46%, rgba(22, 10, 4, 0.9) 100%);
  }
  .st-close__glow {
    position: absolute;
    z-index: -1;
    top: 46%;
    left: 50%;
    translate: -50% -50%;
    width: min(72%, 780px);
    aspect-ratio: 1.7 / 1;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgba(255, 92, 53, 0.3) 0%, rgba(255, 92, 53, 0) 74%);
    filter: blur(24px);
  }
  .st-close__inner {
    position: relative;
    display: grid;
    justify-items: center;
    text-align: center;
  }
  :global(.st-close__h) {
    max-width: 22ch;
    font-size: clamp(26px, 3.2vw, 46px);
    color: #fff;
  }
  :global(.st-close__h em) { color: var(--sb-lime); font-style: normal; }
  :global(.st-close__b) {
    max-width: 66ch;
    margin: clamp(14px, 1.7vw, 21px) 0 0;
    font-size: clamp(12px, 0.88vw, 14px);
    line-height: 1.78;
    color: var(--sb-on-dark-82);
  }
  :global(.st-close__beats) {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 2.4vw, 42px);
    margin: clamp(22px, 2.8vw, 36px) 0 0;
    padding: 0;
    list-style: none;
  }
  :global(.st-close__beats li) {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: clamp(10px, 0.76vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #fff;
  }
  :global(.st-close__beats li + li::before) {
    content: '';
    width: clamp(20px, 3vw, 54px);
    height: 1px;
    margin-right: clamp(16px, 2.4vw, 42px);
    background-image: linear-gradient(to right, rgba(255, 138, 92, 0.6) 52%, transparent 52%);
    background-size: 7px 1px;
  }
  :global(.st-close__beats span) {
    display: grid;
    place-items: center;
    width: clamp(26px, 2.4vw, 34px);
    aspect-ratio: 1 / 1;
    border: 1px solid rgba(255, 138, 92, 0.34);
    border-radius: 50%;
    color: var(--sb-lime);
  }
  :global(.st-close__beats svg) { width: 52%; height: auto; }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .st-rooms__grid,
    .st-use__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(32px, 4.6vw, 48px);
    }
    .st-body,
    .st-use__copy .st-body { max-width: 58ch; }
    .st-rooms__lead { width: 100%; }
    .st-rooms__side { width: clamp(120px, 26vw, 190px); }
    .st-rooms__disc { width: clamp(84px, 18vw, 132px); }

    .st-rail__list { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(26px, 4vw, 38px); }
    /* The bus runs behind one row of four; with two rows it would point at
       nothing on the wrap, so it goes and the numbered nodes carry the order. */
    .st-rail__bus { display: none; }

    /* Two-up keeps the card concept; the journey re-draws across two rows, so
       it goes and the nodes go with it — a line that connects a wrap is worse
       than none. */
    .st-eco__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(26px, 4vw, 40px); }
    :global(.st-eco__b), :global(.st-eco__note) { max-width: 58ch; }
    .st-eco__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.6vw, 20px); }
    /* Two-up doubles the card width, so the crop has to flatten with it — see
       the same correction in the 767 block. */
    .st-card__pic :global(img) { aspect-ratio: 16 / 9; }
    .st-eco__path, .st-eco__nodes { display: none; }
  }

  @media (max-width: 767px) {
    .st-rail__list { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 5vw, 30px); }


    /* ⚠ THE RAIL TURNS HORIZONTAL AND SCROLLS. A vertical rail beside a stage
       that is now full-width would squeeze the stage to nothing; six thumbs in a
       swipeable row keeps every frame reachable without shrinking the picture. */
    .st-use__stage {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas: 'frames' 'cap' 'thumbs';
    }
    .st-rail-thumbs {
      grid-auto-rows: auto;
      grid-auto-flow: column;
      justify-content: start;
      overflow-x: auto;
      margin-inline: calc(var(--sb-margin) * -1);
      padding-inline: var(--sb-margin);
      scroll-snap-type: x proximity;
    }
    .st-thumb { width: clamp(66px, 20vw, 92px); aspect-ratio: 4 / 3; scroll-snap-align: start; }

    /* ⚠ THE ECOSYSTEM BECOMES A VERTICAL JOURNEY, not four loose cards. The
       horizontal route cannot survive a stack, so a dashed rail runs down the
       left instead and the SAME connection points come back on it — one per
       card. That is the concept the brief asks to keep; dropping the line would
       leave a plain column of cards. */
    .st-eco__list {
      grid-template-columns: minmax(0, 1fr);
      gap: clamp(16px, 4.5vw, 22px);
      padding-left: clamp(26px, 8vw, 38px);
    }
    .st-eco__list::before {
      content: '';
      position: absolute;
      left: clamp(5px, 1.6vw, 8px);
      top: 10px;
      bottom: 10px;
      width: 1px;
      background-image: linear-gradient(to bottom, rgba(201, 60, 10, 0.45) 52%, transparent 52%);
      background-size: 1px 8px;
    }
    /* ⚠ A SHALLOWER CROP ONCE THE CARD IS FULL WIDTH. 1.46:1 is a portion of a
       220px column; at 320px the same ratio makes the picture two thirds of the
       card and the copy an afterthought. */
    .st-card__pic :global(img) { aspect-ratio: 16 / 9; }

    .st-eco__nodes { display: block; }
    .st-eco__nodes i {
      top: calc((var(--k) + 0.5) * 25%);
      left: clamp(5px, 1.6vw, 8px);
    }
    /* Five points served four gaps on the row; stacked there are four cards, so
       the spare one goes rather than floating past the last. */
    .st-eco__nodes i:nth-child(5) { display: none; }

    :global(.st-close__beats) { gap: clamp(10px, 3vw, 16px); }
    :global(.st-close__beats li + li::before) { display: none; }

    .st-bots__circuit,
    .st-rooms__trace,
    .st-eco__circuit { display: none; }
  }
