    width: 16.6667%;
    background: var(--sb-violet);
    transition: width var(--sb-dur-reveal) var(--sb-ease);
  }

  /* THE STAGE. Every frame is in the DOM, stacked; only one is opaque. */
  .st-use__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'frames thumbs' 'cap thumbs';
    gap: clamp(10px, 1.2vw, 18px) clamp(12px, 1.4vw, 20px);
  }
  .st-use__frames {
    grid-area: frames;
    position: relative;
    aspect-ratio: 3 / 2;
    border-radius: var(--sb-r-3);
    overflow: hidden;
    background: var(--sb-sand);
    box-shadow: var(--sb-shadow-card-hover);
  }
  .st-shot {
    position: absolute;
    inset: 0;
    display: block;
    opacity: 0;
    scale: 1.03;
    pointer-events: none;
    transition: opacity 620ms var(--sb-ease), scale 900ms var(--sb-ease);
  }
  .st-shot.is-on { opacity: 1; scale: 1; pointer-events: auto; }
  .st-shot :global(picture) { display: block; width: 100%; height: 100%; }
  .st-shot :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }
  .st-shot__zoom {
    position: absolute;
    right: clamp(10px, 1.2vw, 16px);
    bottom: clamp(10px, 1.2vw, 16px);
