---
/**
 * TEACHING & LEARNING · STEM, ROBOTICS & ENRICHMENT — five sections.
 *
 * ⚠ COMBINED PAGE — three of the brief's fourteen bullets: STEM Education,
 * Robotics & Coding, and Mathematics & Science Enrichment. The three standalone
 * routes were an implementation experiment; their verified content is merged
 * here and the routes are retired.
 *
 * ⚠⚠ THE ROBOTICS LAB IS NOT PHOTOGRAPHED, AND NOTHING ON THIS PAGE PRETENDS
 * OTHERWISE. The client's instruction stands: Robotics-drones.jpg and dron.jpg
 * are stock DJI product shots, not this school's room, and are banned. Section
 * 02 is therefore a TYPOGRAPHIC composition around the four things the school
 * lists as being in the room — drawn marks, not photographs — and it says so on
 * the page rather than only in this comment. It is built so a real photograph
 * drops into the reserved plate later without redesigning anything.
 * ASSET REQUIREMENT: photography of the Robotics Lab.
 *
 * ═══ SOURCE — verified in this repository ══════════════════════════════════
 *   Robotics Lab — "Drone · 3-D printer · telescope · embedded systems".
 *   Two computer laboratories, 40+ machines each.
 *   Mathematics laboratory — "mathematics as a practical subject".
 *   Physics, Chemistry, Biology — board practicals, Classes IX–XII.
 *   Vidyarthi Vigyan Manthan — the national science talent search, Classes VI–XI.
 *   National Children's Science Congress — project work presented and defended.
 *   Inspire Award MANAK — Department of Science & Technology, original ideas
 *     from school students, taken to national level.
 *   RoboWunder International Robotics Championship, Kuala Lumpur — Master Deepak
 *     Kumar, 2nd place, cash prize 1,500 USD, session 2025-26.
 *   National School Innovation Ranking & Awards (CBSE) — Rank 2, Uttar Pradesh.
 *
 * ⚠ SCOPE BOUNDARY — the results in full live on Student Success; the room
 * inventory lives on Laboratories & Academic Clubs; the panels and computer-room
 * teaching live on Smart Classrooms. This page is the science and engineering
 * work and where it is entered.
 *
 * ⚠ NOT CLAIMED: a coding curriculum, which classes take robotics, club hours,
 * or how students are selected for entry. None is published.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · CREAM  asymmetric gallery — one dominant frame, two overlapping, one
 *               circular detail, over a faint technical grid.
 *   02 · INK    the Robotics Lab as a drawn circuit path. No photographs, and
 *               the section states why.
 *   03 · CREAM  the interactive gallery — one large stage, a vertical thumbnail
 *               rail, a counter, prev/next, a progress rule, and the shared
 *               Lightbox on the stage itself.
 *   04 · SAND   the ecosystem — four blocks of DIFFERENT weight joined by thin
 *               rules. Deliberately photograph-free; see the note on it.
 *   05 · PHOTO  the dark close.
 *
 * ⚠ NO SECTION IS TEXT-LEFT / IMAGE-RIGHT TWICE. 01 is copy-left with a
 * four-frame cluster; 02 is a full-width dark path; 03 is a stage with a rail;
 * 04 is a connected diagram; 05 is centred over a photograph. That variation is
 * the brief's first requirement and the easiest thing to lose.
 *
 * PHOTOGRAPHY is ten genuine Sunbeam Ballia frames and no stock. Every caption
 * says what is actually in its picture.
 *
 * MOTION is the project's own attribute set — data-clip, data-reveal, data-pop,
 * data-drift, data-parallax, data-mask, data-zoom — plus one scoped script for
 * the gallery and one for the circuit draw.
 */
import Lightbox from '../../ui/Lightbox.astro';

/* ── PHOTOGRAPHY ────────────────────────────────────────────────────────────
   ⚠ TEN DISTINCT FRAMES, AND THE BANNER IS AN ELEVENTH. A page about rooms is
   the easiest place on the site to show the same bench five times. */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getStemRobotics } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const { rooms, bots, use, eco, close } = await getStemRobotics();

const S = 'Sunbeam School Ballia';

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. */
const MARK: Record<string, string> = {
  drone: `<path d="M12 9.6h.01"/><rect x="8.8" y="8.8" width="6.4" height="6.4" rx="1.4"/><path d="M8.8 10.4 5.4 7M15.2 10.4 18.6 7M8.8 13.6 5.4 17M15.2 13.6 18.6 17"/><circle cx="4.2" cy="5.8" r="2.2"/><circle cx="19.8" cy="5.8" r="2.2"/><circle cx="4.2" cy="18.2" r="2.2"/><circle cx="19.8" cy="18.2" r="2.2"/>`,
  printer: `<rect x="4.4" y="8.6" width="15.2" height="7.6" rx="1.6"/><path d="M7.6 8.6V4.4h8.8v4.2M7.6 16.2v3.4h8.8v-3.4"/><path d="M7.4 11.8h2"/>`,
  telescope: `<path d="m3.4 13.4 11.2-6.5a1.8 1.8 0 0 1 2.5.7l1.5 2.6a1.8 1.8 0 0 1-.7 2.4L6.7 19.2a1.8 1.8 0 0 1-2.5-.7l-1.5-2.6a1.8 1.8 0 0 1 .7-2.5Z"/><path d="m13 16.2 2.4 4.2M9.4 18.2l1.4 2.4M18.2 4.4l1.6 2.8"/>`,
  chip: `<rect x="6.4" y="6.4" width="11.2" height="11.2" rx="1.6"/><rect x="9.8" y="9.8" width="4.4" height="4.4" rx=".8"/><path d="M9.6 2.8v3.6M14.4 2.8v3.6M9.6 17.6v3.6M14.4 17.6v3.6M2.8 9.6h3.6M2.8 14.4h3.6M17.6 9.6h3.6M17.6 14.4h3.6"/>`,
  flask: `<path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4"/><path d="M8.2 14.4h7.6"/><circle cx="10.8" cy="16.8" r=".9"/>`,
  gear: `<circle cx="12" cy="12" r="3.2"/><path d="M12 2.6v3M12 18.4v3M2.6 12h3M18.4 12h3M5.3 5.3l2.1 2.1M16.6 16.6l2.1 2.1M18.7 5.3l-2.1 2.1M7.4 16.6l-2.1 2.1"/>`,
  code: `<path d="m8.6 8.4-4 3.6 4 3.6M15.4 8.4l4 3.6-4 3.6M13.4 4.6l-2.8 14.8"/>`,
  cog: `<circle cx="12" cy="12" r="3.1"/><path d="M12 2.4v2.6M12 19v2.6M2.4 12h2.6M19 12h2.6M5.2 5.2l1.9 1.9M16.9 16.9l1.9 1.9M18.8 5.2l-1.9 1.9M7.1 16.9l-1.9 1.9"/><path d="M12 5a7 7 0 0 1 7 7 7 7 0 0 1-7 7 7 7 0 0 1-7-7 7 7 0 0 1 7-7Z" stroke-dasharray="2.6 3.4"/>`,
  bulb: `<path d="M9.4 18.4h5.2M10.2 21h3.6"/><path d="M8.2 13.4a5.4 5.4 0 1 1 7.6 0c-.9.9-1.4 1.7-1.4 2.8v.6H9.6v-.6c0-1.1-.5-1.9-1.4-2.8Z"/>`,
};

/* ── THE ROBOTICS LAB ───────────────────────────────────────────────────────
   The school's own one-line inventory, split into four. `body` is this site's
   own gloss on each item — none of it claims a capability the school has not
   listed. */

/* ── THE GALLERY ────────────────────────────────────────────────────────────
   ⚠ SIX FRAMES, EVERY ONE OF THEM STUDENTS OR ROOMS THAT ACTUALLY EXIST, and
   each `cap` describes what is IN the picture rather than what the section is
   about. The empty-room frames say "between classes" so nobody reads a bench
   shot as a lesson in progress. */

/* ── THE ECOSYSTEM ──────────────────────────────────────────────────────────
   ⚠ FOUR BLOCKS OF DELIBERATELY DIFFERENT WEIGHT, AND NO PHOTOGRAPHS AT ALL.
   Not an omission: this page already carries ten, and the brief's own warning is
   against a wall of them. More to the point, three of these four have no frame
   that would be honest — a chemistry bench captioned "Making" is a mislabel, and
   the Robotics Lab has no photograph at all. Type and drawn marks claim nothing.
   `w` sets each block's span so the four read as one system rather than a row. */

const SUCCESS = '/academics/student-success/';
---

{/* ══ 01 · WHERE SCIENCE HAPPENS ═════════════════════════════════════════════
    Ground: cream. Idea: copy left, a four-frame cluster right — one dominant
    landscape, two overlapping, one circular detail — over a faint technical
    grid. */}
<section class="st-rooms" aria-labelledby="st-rooms-t">
  <span class="st-rooms__warm" aria-hidden="true"></span>
  <span class="st-grid" aria-hidden="true"></span>
  <span class="st-dots st-rooms__dots" aria-hidden="true"></span>

  <svg class="st-trace st-rooms__trace" viewBox="0 0 220 300" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M214 18h-46a12 12 0 0 0-12 12v56a12 12 0 0 1-12 12h-34" />
      <path d="M214 104h-24a12 12 0 0 0-12 12v104a12 12 0 0 1-12 12h-52" />
    </g>
    <circle cx="110" cy="98" r="3.2" fill="currentColor" />
    <circle cx="114" cy="232" r="3.2" fill="currentColor" />
  </svg>

  <div class="u-container st-rooms__grid">
    <div class="st-rooms__copy">
      <p class="st-kicker" data-reveal>{rooms.kicker}</p>
      <ClipHeading class="st-h st-rooms__h" id="st-rooms-t" text={rooms.heading} />
      <RichLine class="st-body" text={rooms.body[0]} reveal revealDelay={200} />
      <RichLine class="st-body" text={rooms.body[1]} reveal revealDelay={270} />

      <ul class="st-rooms__tags">
        {[
          { m: 'flask', k: 'Named laboratories' },
          { m: 'gear', k: 'Board practicals IX–XII' },
          { m: 'code', k: 'Purpose-built spaces' },
          { m: 'bulb', k: 'Hands-on, everyday' },
        ].map((t, i) => (
          <li data-reveal data-reveal-delay={330 + i * 60}>
            <span aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[t.m]} />
              </svg>
            </span>
            {t.k}
          </li>
        ))}
      </ul>
    </div>

    <div class="st-rooms__media">
      <figure class="st-rooms__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={rooms.shots[0]?.image} alt={rooms.shots[0]?.alt ?? ''}
         
          widths={[620, 1000, 1320]}
          sizes="(max-width: 1023px) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="st-rooms__side" data-parallax data-parallax-y="26">
        <SmartImage
          file={rooms.shots[1]?.image} alt={rooms.shots[1]?.alt ?? ''}
         
          widths={[360, 620]}
          sizes="(max-width: 1023px) 46vw, 21vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="st-rooms__disc" data-parallax data-parallax-y="-22">
        <SmartImage
          file={rooms.shots[2]?.image} alt={rooms.shots[2]?.alt ?? ''}
         
          widths={[300, 480]}
          sizes="(max-width: 1023px) 32vw, 14vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

{/* ══ 02 · THE ROBOTICS LAB ══════════════════════════════════════════════════
    Ground: ink. Idea: the four items as nodes on a drawn circuit that draws
    itself. ⚠ NO PHOTOGRAPHS — see the header note. */}
<section class="st-bots" aria-labelledby="st-bots-t">
  <span class="st-bots__glow" aria-hidden="true"></span>
  <span class="st-bots__grid" aria-hidden="true"></span>
  <span class="st-bots__grain" aria-hidden="true"></span>
  <span class="st-bots__ghost" aria-hidden="true" data-parallax data-parallax-y="20">Robotics</span>

  <svg class="st-bots__circuit st-bots__circuit--l" viewBox="0 0 200 260" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M-6 26h60a12 12 0 0 1 12 12v50a12 12 0 0 0 12 12h56" />
      <path d="M-6 128h34a12 12 0 0 1 12 12v78a12 12 0 0 0 12 12h72" />
    </g>
    <circle cx="134" cy="100" r="3" fill="currentColor" />
    <circle cx="124" cy="230" r="3" fill="currentColor" />
  </svg>
  <svg class="st-bots__circuit st-bots__circuit--r" viewBox="0 0 200 260" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M206 34h-56a12 12 0 0 0-12 12v56a12 12 0 0 1-12 12H70" />
      <path d="M206 140h-30a12 12 0 0 0-12 12v66a12 12 0 0 1-12 12H82" />
    </g>
    <circle cx="66" cy="114" r="3" fill="currentColor" />
    <circle cx="78" cy="230" r="3" fill="currentColor" />
  </svg>

  <div class="u-container st-bots__inner">
    <div class="st-bots__head">
      <p class="st-kicker st-kicker--dark" data-reveal>{bots.kicker}</p>
      <ClipHeading class="st-h st-bots__h" id="st-bots-t" text={bots.heading} />
      <RichLine class="st-body st-body--dark" text={bots.body[0]} reveal revealDelay={200} />
    </div>

    <div class="st-rail">
      {/* ⚠ TWO PATHS ON ONE GEOMETRY. The dotted one is the bus and is always
          painted; the solid one is the same shape drawn on scroll via
          stroke-dashoffset. `pathLength="1"` keeps the script in fractions. */}
      <svg class="st-rail__bus" viewBox="0 0 1200 60" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path class="st-rail__line" d="M-40 30 Q80 30 150 30 T450 30 T750 30 T1050 30 Q1160 30 1240 30"
          stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-dasharray="6 9" />
        <path class="st-rail__draw" pathLength="1" d="M-40 30 Q80 30 150 30 T450 30 T750 30 T1050 30 Q1160 30 1240 30"
          stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
      </svg>

      <ol class="st-rail__list">
        {bots.cells.map((k, i) => (
          <li class="st-node" data-drift="24" style={`--i: ${i};`}>
            <span class="st-node__n t-tabular" data-pop data-pop-delay={i * 110}>{String(i + 1).padStart(2, '0')}</span>
            <span class="st-node__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[k.mark]} />
              </svg>
            </span>
            <h3 class="st-node__k">{k.label}</h3>
            <p class="st-node__b">{k.value}</p>
          </li>
        ))}
      </ol>
    </div>

    {/* ⚠ THE MISSING PHOTOGRAPH, STATED ON THE PAGE. The stock drone images in
        this repository are not this school's room, so the section says the
        picture is owed rather than borrowing somebody else's. */}
    <p class="st-bots__owed" data-reveal data-reveal-delay="260">
      <span aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3.4" y="5.6" width="17.2" height="13.2" rx="2" />
            <path d="M3.4 15.2 8.6 10l4.4 4.2 3-2.6 4.6 4" />
            <circle cx="9" cy="9.6" r="1.4" />
          </g>
        </svg>
      </span>
      <RichLine tag="span" text={bots.caption} />
    </p>
  </div>
</section>

{/* ══ 03 · STEM IN PRACTICE ══════════════════════════════════════════════════
    Ground: cream. Idea: one large stage with a vertical thumbnail rail, a
    counter, prev/next and a progress rule. The stage opens the Lightbox. */}
<section class="st-use" aria-labelledby="st-use-t">
  <span class="st-use__warm" aria-hidden="true"></span>

  <div class="u-container st-use__grid">
    <div class="st-use__copy">
      <p class="st-kicker" data-reveal>{use.kicker}</p>
      <ClipHeading class="st-h st-use__h" id="st-use-t" text={use.heading} />
      <RichLine class="st-body" text={use.body[0]} reveal revealDelay={200} />

      <div class="st-use__ctrl" data-reveal data-reveal-delay="280">
        <button type="button" class="st-use__nav" data-gal-prev>
          <span class="u-visually-hidden">Previous photograph</span>
          <svg viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M5 1 1 5l4 4M1 5h12" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <p class="st-use__count t-tabular"><span data-gal-n>01</span> / {String(use.cells.length).padStart(2, '0')}</p>
        <button type="button" class="st-use__nav" data-gal-next>
          <span class="u-visually-hidden">Next photograph</span>
          <svg viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M9 1l4 4-4 4M13 5H1" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>

      <p class="st-use__bar" aria-hidden="true"><span data-gal-bar></span></p>
    </div>

    <div class="st-use__stage" data-gal-scope>
      <div class="st-use__frames">
        {use.cells.map((sh, i) => (
          <a class={`st-shot${i === 0 ? ' is-on' : ''}`} href={sh.image.src} data-gal-frame data-lb-open
            data-lb-alt={sh.alt} data-lb-cap={sh.caption} tabindex={i === 0 ? 0 : -1}>
            <SmartImage
              file={sh.image}
              alt={sh.alt}
              sizes="(max-width: 1023px) 92vw, 46vw"
              fallbackWidth={1100}
            />
            <span class="st-shot__zoom" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="10.6" cy="10.6" r="6.4" stroke="currentColor" stroke-width="1.7" />
                <path d="M15.4 15.4 20.4 20.4M10.6 8v5.2M8 10.6h5.2" stroke="currentColor"
                  stroke-width="1.7" stroke-linecap="round" />
              </svg>
            </span>
          </a>
        ))}
      </div>

      <p class="st-use__cap" data-gal-cap>{use.cells[0]?.caption ?? ''}</p>

      <ol class="st-rail-thumbs">
        {use.cells.map((sh, i) => (
          <li>
            <button type="button" class={`st-thumb${i === 0 ? ' is-on' : ''}`} data-gal-thumb={i}>
              <span class="u-visually-hidden">{`Show photograph ${i + 1}: ${sh.caption}`}</span>
              <SmartImage
                file={sh.image}
                alt=""
                sizes="120px"
                fallbackWidth={1100}
                loading="lazy"
              />
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* ══ 04 · THE ENRICHMENT ECOSYSTEM ══════════════════════════════════════════
    Ground: cream. Idea: a compact introduction on the left and FOUR IMAGE CARDS
    on the right, threaded by a dashed orange journey that runs behind them.

    ⚠ THE CARDS CARRY PHOTOGRAPHS, AND ONE OF THEM DOES NOT — see the note on
    `eco`. The wave between a card's picture and its body is an inline SVG filled
    with the card's own colour, not a border radius: a radius gives an arc, and
    the reference's divider is a wave. */}
<section class="st-eco" aria-labelledby="st-eco-t">
  <span class="st-eco__warm" aria-hidden="true"></span>
  <span class="st-grid st-grid--fine" aria-hidden="true"></span>

  <svg class="st-eco__circuit st-eco__circuit--l" viewBox="0 0 160 220" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M-6 22h44a10 10 0 0 1 10 10v44a10 10 0 0 0 10 10h48" />
      <path d="M-6 116h26a10 10 0 0 1 10 10v64a10 10 0 0 0 10 10h56" />
    </g>
    <circle cx="108" cy="88" r="2.8" fill="currentColor" />
    <circle cx="98" cy="202" r="2.8" fill="currentColor" />
  </svg>
  <svg class="st-eco__circuit st-eco__circuit--r" viewBox="0 0 160 220" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M166 30h-44a10 10 0 0 0-10 10v46a10 10 0 0 1-10 10H56" />
      <path d="M166 124h-26a10 10 0 0 0-10 10v58a10 10 0 0 1-10 10H66" />
    </g>
    <circle cx="52" cy="96" r="2.8" fill="currentColor" />
    <circle cx="62" cy="212" r="2.8" fill="currentColor" />
  </svg>

  <div class="u-container st-eco__grid">
    <div class="st-eco__head">
      <p class="st-kicker" data-reveal>{eco.kicker}</p>
      <ClipHeading class="st-h st-eco__h" id="st-eco-t" text={eco.heading} />
      <RichLine class="st-body st-eco__b" text={eco.body[0]} reveal revealDelay={200} />
      <RichLine class="st-eco__note" text={eco.body[1]} linkClass="st-link" reveal revealDelay={270} />
    </div>

    <div class="st-eco__stage">
      {/* ⚠ ONE JOURNEY BEHIND ALL FOUR, NOT A BORDER PER CARD. It enters from the
          introduction, passes behind each card and leaves past the last. The
          nodes are placed on the gaps between cards, where nothing covers them.
          preserveAspectRatio="none" lets it stretch to whatever width the row
          resolves to. */}
      <svg class="st-eco__path" viewBox="0 0 1000 120" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path class="st-eco__route"
          d="M-60 74 C40 74 70 52 140 52 C230 52 240 74 330 74 C420 74 430 52 520 52 C610 52 620 74 710 74 C800 74 810 52 900 52 C960 52 1010 66 1060 78"
          stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-dasharray="5 8" />
        <path class="st-eco__draw" pathLength="1"
          d="M-60 74 C40 74 70 52 140 52 C230 52 240 74 330 74 C420 74 430 52 520 52 C610 52 620 74 710 74 C800 74 810 52 900 52 C960 52 1010 66 1060 78"
          stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
      </svg>

      <span class="st-eco__nodes" aria-hidden="true">
        {[0, 1, 2, 3, 4].map((k) => (
          <i style={`--k: ${k};`} data-pop data-pop-delay={k * 90}></i>
        ))}
      </span>

      <ol class="st-eco__list">
        {eco.cells.map((e, i) => (
          <li class="st-card" data-pop data-pop-delay={120 + i * 110}>
            <div class="st-card__pic">
              <SmartImage
                file={e.image}
                alt={e.alt}
                sizes="(max-width: 767px) 92vw, 18vw"
                fallbackWidth={1100}
                loading="lazy"
              />

              <svg class="st-card__wave" viewBox="0 0 320 30" fill="none" preserveAspectRatio="none" aria-hidden="true">
                <path d="M0 16C60 30 110 2 172 8s86 20 148 12v12H0z" fill="currentColor" />
              </svg>
            </div>

            <div class="st-card__body">
