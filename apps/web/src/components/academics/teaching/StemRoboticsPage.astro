<script>
  /* ── THE CIRCUIT DRAWS ITSELF ─────────────────────────────────────────────
     ⚠ DECORATION ONLY. The dotted bus underneath is always painted, so with
     this script absent the reader loses the travelling line and nothing else. */
  const stBots = document.querySelector('.st-bots');
  const stDraw = document.querySelector('.st-rail__draw');

  if (stBots instanceof HTMLElement && stDraw instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;
    const paint = () => {
      queued = false;
      const r = stBots.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (window.innerHeight * 0.82 - r.top) / (r.height * 0.7)));
      stDraw.style.strokeDashoffset = String(1 - p);
      const on = Math.round(p * 4);
      document.querySelectorAll('.st-node').forEach((n, i) => n.classList.toggle('is-on', i < on));
    };
    const onScroll = () => { if (queued) return; queued = true; requestAnimationFrame(paint); };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }

  /* ── THE GALLERY ──────────────────────────────────────────────────────────
     ⚠ EVERY FRAME IS IN THE DOM AND ONLY ONE IS SHOWN. Not a src swap: the
     browser has already decoded the others, so a change is instant and there is
     no flash of an empty stage. The frames are anchors, so with JavaScript off
     the reader gets six links to six photographs rather than a dead widget.

     ⚠ AUTOPLAY STOPS AT THE FIRST INTERACTION AND NEVER RESTARTS. A carousel
     that resumes after a reader has taken control fights them for the rest of
     the page. It also stops while the tab is hidden and when the section is out
     of view, so it is not animating to nobody. */
  const scope = document.querySelector('[data-gal-scope]');

  if (scope) {
    const frames = [...scope.querySelectorAll('[data-gal-frame]')];
    const thumbs = [...scope.querySelectorAll('[data-gal-thumb]')];
    const capEl = scope.querySelector('[data-gal-cap]');
    const root = scope.closest('.st-use');
    const nEl = root?.querySelector('[data-gal-n]');
    const barEl = root?.querySelector('[data-gal-bar]');
    const prev = root?.querySelector('[data-gal-prev]');
    const next = root?.querySelector('[data-gal-next]');

    const caps = frames.map((f) => f.getAttribute('data-lb-cap') || '');
    let at = 0;
    let timer = 0;
    let live = false;

    const show = (i) => {
      at = (i + frames.length) % frames.length;
      frames.forEach((f, k) => {
        const on = k === at;
        f.classList.toggle('is-on', on);
        f.setAttribute('tabindex', on ? '0' : '-1');
      });
      thumbs.forEach((t, k) => {
        t.classList.toggle('is-on', k === at);
        t.setAttribute('aria-current', k === at ? 'true' : 'false');
      });
      if (capEl) capEl.textContent = caps[at];
      if (nEl) nEl.textContent = String(at + 1).padStart(2, '0');
      if (barEl instanceof HTMLElement) {
        barEl.style.width = `${((at + 1) / frames.length) * 100}%`;
      }
    };

    const stop = () => { if (timer) { clearInterval(timer); timer = 0; } live = false; };
    const start = () => {
      if (timer || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      live = true;
      timer = window.setInterval(() => {
        if (document.hidden) return;
        show(at + 1);
      }, 5000);
    };

    thumbs.forEach((t, i) => t.addEventListener('click', () => { stop(); show(i); }));
    prev?.addEventListener('click', () => { stop(); show(at - 1); });
    next?.addEventListener('click', () => { stop(); show(at + 1); });

    /* Arrow keys, but only while the gallery holds focus — hijacking them for
       the whole document would break normal page scrolling. */
    scope.addEventListener('keydown', (e) => {
      if (e.key !== 'ArrowLeft' && e.key !== 'ArrowRight') return;
      e.preventDefault();
      stop();
      show(at + (e.key === 'ArrowRight' ? 1 : -1));
    });

    /* Swipe. Horizontal only, and only past a real threshold, so a vertical
       scroll that drifts sideways never flips the frame. */
    let x0 = 0;
    let y0 = 0;
    scope.addEventListener('touchstart', (e) => {
      x0 = e.changedTouches[0].clientX;
      y0 = e.changedTouches[0].clientY;
    }, { passive: true });
    scope.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) < 45 || Math.abs(dx) < Math.abs(dy)) return;
      stop();
      show(at + (dx < 0 ? 1 : -1));
    }, { passive: true });

    show(0);

    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) { if (!timer && live !== false) start(); }
          else if (timer) { clearInterval(timer); timer = 0; }
        });
      }, { threshold: 0.4 }).observe(scope);
      live = true;
      start();
    }
  }
</script>

