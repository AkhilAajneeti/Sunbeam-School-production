---
/**
 * TEACHING & LEARNING · READING, LANGUAGE & LIBRARY — five sections.
 *
 * ⚠ COMBINED PAGE — three of the brief's fourteen bullets: Reading Programme,
 * Language Development and Library Programme. In the school's own description
 * these are one effort seen from three sides.
 *
 * ═══ SOURCE — verified in this repository ══════════════════════════════════
 *   Nalanda Library — 17,574 books and 25 periodicals. ⚠ USE THE EXACT FIGURE.
 *     teachingTopics.ts rounds it to "around fifteen thousand", which is true but
 *     weaker than the number the school actually counted.
 *   Language laboratory — one of the twelve; "spoken language, recorded and
 *     reviewed", which is the part a textbook cannot do.
 *   Ardent Reader Award — the school's award for its most committed readers,
 *     published in seventy-five photographs. ⚠ NO WINNERS' NAMES ARE PUBLISHED,
 *     so none is given here.
 *   Reading Carnival — a book fair run in the school's own corridors, its racks
 *     signed by section. Read off the school's photographs: a "Reading Club"
 *     header board, and racks headed STUDY SKILLS, STORYBOOK and NEW RELEASE.
 *   Cohort Inter-Branch Attire Speak Competition — entered by Class I.
 *   Virtual Interbranch Declamation — Class IV took the top three positions.
 *
 * ⚠⚠ IT IS THE **ARDENT** READER AWARD, NOT THE "ANCIENT" READER AWARD. The
 * design brief spells it "Ancient" throughout; the repository and the school's
 * own photographs say Ardent. A misspelt award name is a factual error about the
 * client, so the brief's spelling is not followed.
 *
 * ⚠⚠ THERE IS NO PHOTOGRAPH OF THE LANGUAGE LABORATORY. The brief asks for a
 * large picture of that room with an orange badge naming it. None exists in this
 * repository — the nearest candidate, multimedia room/DSC_1214, is a DANCE
 * STUDIO (mirrors, a Nataraja, dance portraits) and captioning it as a language
 * lab would be an invention. Section 03 therefore carries a real reading
 * photograph, captions it as what it is, and states the absence in a line under
 * the frame. The badge names the fact, not the picture.
 * ASSET REQUIREMENT: photography of the language laboratory.
 *
 * ⚠ THE READING CLUB IS NAMED FROM THE SCHOOL'S OWN SIGNAGE and nothing beyond
 * the name and the rack headings is claimed — no membership, no meeting times.
 *
 * ⚠ SCOPE BOUNDARY — the library as a ROOM is inventoried on Laboratories &
 * Academic Clubs; here it is the collection and what is done with it.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · CREAM  copy left, a three-frame magazine cluster right, four small
 *               fact indicators beneath.
 *   02 · SAND   the collage moves LEFT and the copy right — a carnival, a club,
 *               and an editorial index rather than a table.
 *   03 · WHITE  one large frame with a floating badge, copy left.
 *   04 · CREAM  copy left, four compact plates right.
 *   05 · PHOTO  the dark close.
 *
 * ⚠ NO TWO SECTIONS PUT THE PICTURE ON THE SAME SIDE TWICE RUNNING. 01 right,
 * 02 left, 03 right, 04 plates, 05 full bleed. That alternation is the brief's
 * first requirement and the easiest thing to lose.
 *
 * MOTION is the project's own attribute set — data-clip, data-reveal, data-pop,
 * data-count, data-drift, data-parallax, data-mask, data-zoom.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';

/* ── PHOTOGRAPHY — eight genuine Sunbeam Ballia frames, no stock. ──────────
   ⚠ sb-library.jpg IS ALSO THE BANNER, and that is deliberate: it is the only
   published frame of children actually reading in the Nalanda Library, and
   section 01's whole argument is that the room is not empty. The banner crops it
   wide and dark behind the title; here it runs clean and full. */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getReadingLanguage } from '../../../lib/cms';

const { lib, round, lab, stage, close } = await getReadingLanguage();

const S = 'Sunbeam School Ballia';

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. */
const MARK: Record<string, string> = {
  book: `<path d="M12 6.6C10.4 5.1 8 4.6 4 5.1v13c4-.5 6.4 0 8 1.5 1.6-1.5 4-2 8-1.5v-13c-4-.5-6.4 0-8 1.5zM12 6.6v13"/>`,
  news: `<path d="M17.4 4.6H4.2a1.6 1.6 0 0 0-1.6 1.6v11.6a1.6 1.6 0 0 0 1.6 1.6h13.2a1.6 1.6 0 0 0 1.6-1.6V6.2a1.6 1.6 0 0 0-1.6-1.6Z"/><path d="M19 8.6h1.4a1 1 0 0 1 1 1v7.8a2 2 0 0 1-4 0"/><path d="M5.6 8h8.4M5.6 11.4h8.4M5.6 14.8h5"/>`,
  copy: `<rect x="6.4" y="2.8" width="11.2" height="5" rx="1"/><path d="M6.4 16.2H4.8a1.8 1.8 0 0 1-1.8-1.8V9.6a1.8 1.8 0 0 1 1.8-1.8h14.4a1.8 1.8 0 0 1 1.8 1.8v4.8a1.8 1.8 0 0 1-1.8 1.8h-1.6"/><rect x="6.4" y="14" width="11.2" height="7.2" rx="1"/>`,
  seat: `<circle cx="12" cy="6.6" r="3"/><path d="M6.4 19.8a5.6 5.6 0 0 1 11.2 0"/><path d="M3.4 20.4h17.2"/>`,
  mic: `<rect x="9.2" y="2.6" width="5.6" height="11" rx="2.8"/><path d="M5.4 11.2a6.6 6.6 0 0 0 13.2 0"/><path d="M12 17.8v3.6M8.8 21.4h6.4"/>`,
  trophy: `<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 5.4H5.6a2 2 0 0 0 0 4h.8M16 5.4h2.4a2 2 0 0 1 0 4h-.8"/><path d="M12 13v3.6M8.8 20.4h6.4l-.8-3.8H9.6z"/>`,
  headset: `<path d="M4.4 14.4v-2.2a7.6 7.6 0 0 1 15.2 0v2.2"/><rect x="2.6" y="13.4" width="4" height="6" rx="1.8"/><rect x="17.4" y="13.4" width="4" height="6" rx="1.8"/><path d="M19.6 19.4v.6a2 2 0 0 1-2 2h-3"/>`,
  globe: `<circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2"/><path d="M12 3.4c2.2 2.4 3.4 5.4 3.4 8.6S14.2 18.2 12 20.6c-2.2-2.4-3.4-5.4-3.4-8.6S9.8 5.8 12 3.4Z"/>`,
};

/* Four small indicators under section 01. The first two count; the last two are
   facilities the school lists, so they carry a word rather than a figure. */

/* ── THE INDEX under section 02 ─────────────────────────────────────────────
   ⚠ EDITORIAL, NOT A TABLE. Every line is the school's own published record and
   nothing is added to it — in particular no club membership, no meeting times
   and no winners' names, because none is published. */

/* ── SECTION 04 ─────────────────────────────────────────────────────────────
   Where the speaking ends up. Four stages, all from the published record. */
---

{/* ══ 01 · THE NALANDA LIBRARY ═══════════════════════════════════════════════
    Ground: cream. Idea: copy left, a three-frame magazine cluster right, and
    four small indicators sitting under the whole relationship. */}
<section class="rd-lib" aria-labelledby="rd-lib-t">
  <span class="rd-lib__warm" aria-hidden="true"></span>
  <span class="rd-grid" aria-hidden="true"></span>
  <span class="rd-dots rd-lib__dots" aria-hidden="true"></span>

  <svg class="rd-trace rd-lib__trace" viewBox="0 0 200 260" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M-6 24h48a10 10 0 0 1 10 10v52a10 10 0 0 0 10 10h50" />
      <path d="M-6 122h28a10 10 0 0 1 10 10v76a10 10 0 0 0 10 10h60" />
    </g>
    <circle cx="114" cy="98" r="3" fill="currentColor" />
    <circle cx="104" cy="220" r="3" fill="currentColor" />
  </svg>

  <div class="u-container">
    <div class="rd-lib__grid">
      <div class="rd-lib__copy">
        <p class="rd-kicker" data-reveal>{lib.kicker}</p>
        <ClipHeading class="rd-h rd-lib__h" id="rd-lib-t" text={lib.heading} delays={[0, 130, 240]} />
        <RichLine class="rd-body" text={lib.body[0]} reveal revealDelay={200} />
        <RichLine class="rd-body" text={lib.body[1]} reveal revealDelay={270} />
        <RichLine class="rd-body" text={lib.body[2]} reveal revealDelay={340} />
      </div>

      {/* THE CLUSTER — one dominant frame, one overlapping its lower-left, one
          circular detail breaking its lower-right. Three different sizes. */}
      <div class="rd-lib__media">
        <figure class="rd-lib__lead" data-mask data-zoom data-zoom-to="1.06">
          <SmartImage
            file={lib.shots[0]?.image} alt={lib.shots[0]?.alt ?? ''}
           
            widths={[620, 1000, 1320]}
            sizes="(max-width: 1023px) 92vw, 46vw"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="rd-lib__side" data-parallax data-parallax-y="26">
          <SmartImage
            file={lib.shots[1]?.image} alt={lib.shots[1]?.alt ?? ''}
           
            widths={[360, 600]}
            sizes="(max-width: 1023px) 44vw, 20vw"
            loading="lazy"
            decoding="async"
          />
        </figure>

        <figure class="rd-lib__disc" data-parallax data-parallax-y="-20">
          <SmartImage
            file={lib.shots[2]?.image} alt={lib.shots[2]?.alt ?? ''}
           
            widths={[280, 440]}
            sizes="(max-width: 1023px) 30vw, 13vw"
            loading="lazy"
            decoding="async"
          />
        </figure>
      </div>
    </div>

    {/* THE FOUR INDICATORS — small, on one hairline, under the whole
        text-and-image relationship rather than inside either half. */}
    <ul class="rd-facts">
      {lib.cells.map((f, i) => (
        <li data-reveal data-reveal-delay={120 + i * 90}>
          <span class="rd-facts__i" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[f.mark]} />
            </svg>
          </span>
          <p class="rd-facts__n t-tabular">
            {f.number
              ? <span data-count={f.number} data-count-dur={1.2 + i * 0.2}>{Number(f.number).toLocaleString('en-IN')}</span>
              : f.value}
          </p>
          <p class="rd-facts__k">{f.label}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 02 · AROUND THE COLLECTION ═════════════════════════════════════════════
    Ground: sand. Idea: the collage crosses to the LEFT and the copy to the
    right, so the spread reads across rather than down the same gutter. */}
<section class="rd-round" aria-labelledby="rd-round-t">
  <span class="rd-round__warm" aria-hidden="true"></span>

  <div class="u-container rd-round__grid">
    <div class="rd-round__media">
      <figure class="rd-round__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={round.shots[0]?.image} alt={round.shots[0]?.alt ?? ''}
         
          widths={[560, 900, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="rd-round__side" data-parallax data-parallax-y="-24">
        <SmartImage
          file={round.shots[1]?.image} alt={round.shots[1]?.alt ?? ''}
         
          widths={[340, 560]}
          sizes="(max-width: 1023px) 42vw, 19vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="rd-round__disc" data-parallax data-parallax-y="22">
        <SmartImage
          file={round.shots[2]?.image} alt={round.shots[2]?.alt ?? ''}
         
          widths={[280, 440]}
          sizes="(max-width: 1023px) 30vw, 13vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>

    <div class="rd-round__copy">
      <p class="rd-kicker" data-reveal>{round.kicker}</p>
      <ClipHeading class="rd-h rd-round__h" id="rd-round-t" text={round.heading} />
      <RichLine class="rd-body" text={round.body[0]} reveal revealDelay={200} />
      <RichLine class="rd-body" text={round.body[1]} reveal revealDelay={270} />

      <dl class="rd-index">
        {round.cells.map((row, i) => (
          <div class="rd-index__row" data-reveal data-reveal-delay={140 + i * 80}>
            <dt>{row.label}</dt>
            <dd>{row.value}</dd>
          </div>
        ))}
      </dl>
    </div>
  </div>
</section>

{/* ══ 03 · THE HALF A BOOK CANNOT DO ═════════════════════════════════════════
    Ground: white. Idea: one large frame with a floating badge — the section's
    visual anchor — and the copy held to the left of it. */}
<section class="rd-lab" aria-labelledby="rd-lab-t">
  <span class="rd-grid rd-grid--fine" aria-hidden="true"></span>
  <span class="rd-dots rd-lab__dots" aria-hidden="true"></span>

  <div class="u-container rd-lab__grid">
    <div class="rd-lab__copy">
      <p class="rd-kicker" data-reveal>{lab.kicker}</p>
      <ClipHeading class="rd-h rd-lab__h" id="rd-lab-t" text={lab.heading} />
      <RichLine class="rd-body" text={lab.body[0]} reveal revealDelay={200} />
      <RichLine class="rd-body" text={lab.body[1]} reveal revealDelay={270} />
    </div>

    <div class="rd-lab__media">
      <figure class="rd-lab__lead" data-mask data-mask-from="left" data-zoom data-zoom-to="1.05">
        <SmartImage
          file={lab.shots[0]?.image} alt={lab.shots[0]?.alt ?? ''}
         
          widths={[620, 1000, 1400]}
          sizes="(max-width: 1023px) 92vw, 50vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      {/* ⚠ THE BADGE NAMES A FACT, NOT THE PICTURE. There is no published
          photograph of the language laboratory — see the header note — so the
          badge states what the room is and the line beneath says what the
          photograph actually shows. */}
      <p class="rd-lab__badge" data-reveal data-reveal-delay="180">
        {lab.cellsTwo.map((b) => (
          <>
            <span class="rd-lab__badge-k">{b.label}</span>
            <span class="rd-lab__badge-v">{b.value}</span>
          </>
        ))}
      </p>

      <RichLine class="rd-lab__cap" text={lab.body[2]} reveal revealDelay={260} />
    </div>
  </div>
</section>

{/* ══ 04 · ON A PLATFORM ═════════════════════════════════════════════════════
    Ground: cream. Idea: copy left, four compact plates right on one drawn rule. */}
<section class="rd-stage" aria-labelledby="rd-stage-t">
  <span class="rd-stage__warm" aria-hidden="true"></span>

  <div class="u-container rd-stage__grid" data-draw-scope>
    <div class="rd-stage__copy">
      <p class="rd-kicker" data-reveal>{stage.kicker}</p>
      <ClipHeading class="rd-h rd-stage__h" id="rd-stage-t" text={stage.heading} />
      <RichLine class="rd-body" text={stage.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="rd-stage__list">
      <span class="rd-stage__rule" aria-hidden="true"><span data-draw></span></span>
      {stage.cells.map((st, i) => (
        <li class="rd-plate" data-reveal data-reveal-delay={120 + i * 110}>
          <span class="rd-plate__i" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[st.mark]} />
            </svg>
          </span>
          <p class="rd-plate__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="rd-plate__k">{st.label}</h3>
          <p class="rd-plate__b">{st.value}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 05 · THE CLOSE ═════════════════════════════════════════════════════════ */}
<section class="rd-close" aria-labelledby="rd-close-t">
  <div class="rd-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <SmartImage
      file={close.shots[0]?.image} alt={close.shots[0]?.alt ?? ''}
     
      widths={[1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <span class="rd-close__scrim" aria-hidden="true"></span>
  <span class="rd-close__grain" aria-hidden="true"></span>

  <div class="u-container rd-close__inner">
    <p class="rd-kicker rd-kicker--dark" data-reveal>{close.kicker}</p>
    <ClipHeading class="rd-h rd-close__h" id="rd-close-t" text={close.heading} />
    <RichLine class="rd-close__b" text={close.body[0]} reveal revealDelay={180} />
  </div>
</section>

<style>
  /* ═══ SHARED ══════════════════════════════════════════════════════════════ */
  .rd-kicker {
    margin: 0;
    font-size: clamp(10.5px, 0.78vw, 12px);
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .rd-kicker--dark { color: var(--sb-lime); }

  :global(.rd-h) {
    margin: clamp(12px, 1.5vw, 18px) 0 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--sb-charcoal);
  }
  :global(.rd-h span) { display: block; }
  :global(.rd-h em) { font-style: normal; color: var(--sb-violet); }

  :global(.rd-body) {
    max-width: 46ch;
    margin: clamp(13px, 1.6vw, 19px) 0 0;
    font-size: clamp(12.5px, 0.92vw, 14.5px);
    line-height: 1.78;
    color: var(--sb-text-secondary);
  }
  :global(.rd-body strong) { font-weight: 700; color: var(--sb-charcoal); }
  :global(.rd-body em) { font-style: italic; color: var(--sb-charcoal); }

  /* The page's decorative language: a very light grid, thin right-angled traces
     with terminal nodes, and a dot field. Never above 12% opacity. */
  .rd-grid {
    position: absolute;
    z-index: -3;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(27, 21, 18, 0.045) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(27, 21, 18, 0.045) 1px, transparent 1px);
    background-size: 40px 40px;
    -webkit-mask-image: radial-gradient(120% 92% at 26% 42%, #000 0%, transparent 78%);
    mask-image: radial-gradient(120% 92% at 26% 42%, #000 0%, transparent 78%);
  }
  .rd-grid--fine {
    background-size: 26px 26px;
    -webkit-mask-image: radial-gradient(110% 96% at 64% 46%, #000 0%, transparent 80%);
    mask-image: radial-gradient(110% 96% at 64% 46%, #000 0%, transparent 80%);
  }
  .rd-trace {
    position: absolute;
    z-index: -2;
    height: auto;
    color: rgba(201, 60, 10, 0.22);
  }
  .rd-dots {
    position: absolute;
    z-index: -2;
    background-image: radial-gradient(rgba(201, 60, 10, 0.28) 1.5px, transparent 1.7px);
    background-size: 17px 17px;
  }

  /* ═══ 01 · THE NALANDA LIBRARY ════════════════════════════════════════════ */
  .rd-lib {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--sb-ivory);
    padding-block: clamp(40px, 5vw, 80px);
  }
  .rd-lib__warm {
    position: absolute;
    z-index: -3;
    inset: 0;
    background:
      radial-gradient(56% 66% at 6% 8%, rgba(255, 138, 92, 0.12) 0%, rgba(255, 138, 92, 0) 70%),
      radial-gradient(54% 64% at 96% 86%, rgba(201, 60, 10, 0.06) 0%, rgba(201, 60, 10, 0) 72%);
  }
  .rd-lib__dots {
    right: clamp(6px, 2vw, 40px);
    top: 10%;
    width: clamp(58px, 6.6vw, 100px);
    height: clamp(66px, 7.6vw, 112px);
    -webkit-mask-image: linear-gradient(230deg, #000 0%, transparent 92%);
    mask-image: linear-gradient(230deg, #000 0%, transparent 92%);
  }
  .rd-lib__trace { bottom: 8%; right: clamp(-18px, -0.5vw, -4px); width: clamp(100px, 12vw, 200px); }

  .rd-lib__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.12fr);
    gap: clamp(28px, 4vw, 62px);
    align-items: center;
  }
  :global(.rd-lib__h) { font-size: clamp(28px, 3.4vw, 48px); }

  .rd-lib__media { position: relative; }
  .rd-lib__lead {
    margin: 0 0 0 auto;
    width: min(100%, 92%);
    overflow: hidden;
    border-radius: var(--sb-r-3);
    box-shadow: var(--sb-shadow-card-hover);
  }
  .rd-lib__lead :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10;
    object-fit: cover;
  }
  .rd-lib__side {
    position: absolute;
    z-index: 2;
    left: clamp(-16px, -0.4vw, 4px);
    bottom: clamp(-28px, -1.2vw, -10px);
    width: clamp(136px, 16vw, 236px);
    margin: 0;
    overflow: hidden;
    border: 7px solid var(--sb-ivory);
    border-radius: var(--sb-r-2);
    box-shadow: var(--sb-shadow-card);
  }
  .rd-lib__side :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
  }
  .rd-lib__disc {
    position: absolute;
    z-index: 3;
    right: clamp(6px, 2.6vw, 54px);
    bottom: clamp(-32px, -1.4vw, -12px);
    width: clamp(90px, 10vw, 152px);
    aspect-ratio: 1 / 1;
    margin: 0;
    overflow: hidden;
    border: 6px solid var(--sb-ivory);
    border-radius: 50%;
    box-shadow: var(--sb-shadow-card);
  }
  .rd-lib__disc :global(picture) { display: block; width: 100%; height: 100%; }
  .rd-lib__disc :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* THE FOUR INDICATORS — one hairline, four columns, small. */
  .rd-facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 2vw, 34px);
    margin: clamp(34px, 4.4vw, 62px) 0 0;
    padding: clamp(18px, 2.2vw, 28px) 0 0;
    border-top: 1px solid var(--sb-border);
    list-style: none;
  }
  .rd-facts li { display: grid; justify-items: start; gap: 2px; }
  .rd-facts__i {
    display: grid;
    place-items: center;
    width: clamp(24px, 2.2vw, 30px);
    aspect-ratio: 1 / 1;
    margin-bottom: 6px;
    color: var(--sb-violet);
  }
  .rd-facts__i svg { width: 100%; height: auto; }
  .rd-facts__n {
    margin: 0;
    font-family: var(--sb-font-display);
