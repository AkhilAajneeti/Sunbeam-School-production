---
/**
 * TEACHING & LEARNING · CHAPTER 5 — READING · LANGUAGE · LIBRARY
 *
 * COMPOSITION: a tall masked photograph on the left, and a vertical rail of three
 * entries on the right with the 15,000 figure set as a plate that straddles the
 * boundary between them. The one chapter on the page built around a single
 * photograph rather than several, because the Nalanda Library is one room.
 *
 * THE FIGURE PLATE OVERLAPS THE PHOTOGRAPH'S EDGE, which is the whole reason the
 * grid has an extra column: the plate sits in a cell of its own that both the
 * image and the rail reach into, so the overlap is a placement rather than a
 * negative margin that has to be re-tuned every breakpoint.
 *
 * The counter reuses the existing `data-count` wiring, and the number is
 * server-rendered at its final grouped value — 15,000 is much harder to read
 * mid-count without separators, and it must be correct with JavaScript off.
 */
import Photo from '../../ui/Photo.astro';
import SectionHead from '../SectionHead.astro';
import AcademicGlyph from '../AcademicGlyph.astro';
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/teaching-learning/');
const libraryPhoto = ac.pic('libraryPhoto');
const teachingLearning = ac.blockMap('teachingLearning');

const { words } = teachingLearning;
---

<section class="wrd" id="reading" aria-labelledby="wrd-title">
  <div class="u-container">
    <div class="wrd__grid">
      {/* --- Photograph --- */}
      <div class="wrd__media" data-mask>
        <Photo
          file={libraryPhoto}
          alt={words.alt}
          brief="Nalanda Library"
          ratio="3 / 4"
          position="50% 42%"
          sizes="(max-width: 1023px) 100vw, 42vw"
        />
      </div>

      {/* --- The figure, straddling the two columns --- */}
      <p class="wrd__fig" data-pop>
        <span class="wrd__fig-n t-tabular">
          <span data-count={words.figure.n} data-count-suffix={words.figure.suffix}>
            {Number(words.figure.n).toLocaleString('en-IN')}{words.figure.suffix}
          </span>
        </span>
        <span class="wrd__fig-l">{words.figure.label}</span>
      </p>

      {/* --- Copy + rail --- */}
      <div class="wrd__copy">
        <div data-reveal>
          <SectionHead
            eyebrow={words.eyebrow}
            heading={words.heading}
            stand={words.stand}
            align="start"
            id="wrd-title"
            measure={18}
          />
        </div>

        <ol class="wrd__rail">
          {
            words.entries.map((e, i) => (
              <li class="wrd__entry" data-reveal data-reveal-delay={i * 80}>
                <h3 class="wrd__entry-h">
                  <AcademicGlyph name={e.glyph} size={22} class="wrd__glyph" />
                  {e.label}
                </h3>
                <p class="wrd__entry-b">{e.body}</p>
                {e.anchor && <p class="wrd__entry-a t-tabular">{e.anchor}</p>}
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </div>
</section>

<style>
  .wrd {
    position: relative;
    overflow: hidden;
    padding-block: var(--sb-section-y-major);
    background:
      radial-gradient(80% 55% at 0% 8%, #fff3ec 0%, rgba(255, 243, 236, 0) 60%),
      var(--sb-ivory);
  }

  /* THREE columns, not two. The middle one is 0-width at the track level and
     exists only so the figure plate has a cell that straddles the image and the
     rail — the overlap is then a grid placement, not a margin to re-tune. */
  .wrd__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) 0 minmax(0, 1.14fr);
    column-gap: clamp(28px, 4.4vw, 72px);
    align-items: center;
  }

  .wrd__media {
    grid-column: 1;
    grid-row: 1;
    border-radius: var(--sb-r-2);
    overflow: hidden;
    box-shadow: var(--sb-shadow-card);
  }

  .wrd__copy { grid-column: 3; grid-row: 1; }

  /* --- The figure ---------------------------------------------------------- */

  /* justify-self: END, not center.
     The straddle column is 0-width with a gutter either side, so `center` hung
     half of a 260px plate into each — and the gutter is only 63px at 1440, so
     ~67px of the plate landed ON the copy and covered the "Language development"
     heading. Aligned to the column's end, the plate's right edge lands on the
     boundary and the whole box overflows LEFT over the photograph; the small
     negative margin lets it cross into the gutter without ever reaching the text.
     The max-width is a hard stop on the same failure returning if the label grows. */
  .wrd__fig {
    grid-column: 2;
    grid-row: 1;
    z-index: 2;
    justify-self: end;
    margin-right: clamp(-26px, -1.8vw, -10px);
    align-self: end;
    width: max-content;
    max-width: 250px;
    margin-bottom: clamp(24px, 5vh, 72px);
    padding: clamp(18px, 1.9vw, 26px) clamp(20px, 2.2vw, 30px);
    border-radius: var(--sb-r-2);
    background: var(--sb-violet);
    box-shadow: 0 24px 54px -22px rgba(122, 36, 6, 0.7);
    transform: rotate(-1.4deg);
  }

  .wrd__fig-n {
    display: block;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(34px, 3.6vw, 52px);
    line-height: 0.94;
    letter-spacing: -0.045em;
    color: #fff;
  }

  .wrd__fig-l {
    display: block;
    margin-top: var(--sb-3);
    font-size: var(--sb-caption);
    font-weight: 600;
    line-height: 1.4;
    color: var(--sb-on-violet-muted);
  }

  /* --- Rail ---------------------------------------------------------------- */

  .wrd__rail {
    margin: clamp(28px, 4vh, 48px) 0 0;
    padding: 0;
    list-style: none;
  }

  .wrd__entry {
    position: relative;
    padding: 0 0 clamp(26px, 3.6vh, 40px) clamp(26px, 2.4vw, 38px);
  }

  .wrd__entry:last-child { padding-bottom: 0; }

  /* The rail line, and a node on it. The line stops at the last node rather than
     running off the bottom of the list. */
  .wrd__entry::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 6px;
    width: 9px;
    height: 9px;
    border-radius: var(--sb-r-full);
    background: var(--sb-violet);
  }

  .wrd__entry:not(:last-child)::after {
    content: '';
    position: absolute;
    left: 9px;
    top: 20px;
    bottom: 6px;
    border-left: 1px dashed rgba(201, 60, 10, 0.4);
  }

  .wrd__entry-h {
    display: flex;
    align-items: center;
    gap: var(--sb-4);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(18px, 1.7vw, 24px);
    line-height: 1.2;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }

  .wrd__glyph { color: var(--sb-violet); }

  .wrd__entry-b {
    max-width: 50ch;
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.74;
    color: var(--sb-text-secondary);
  }

  .wrd__entry-a {
    margin-top: var(--sb-4);
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sb-violet-dark);
  }

  /* --- Tablet + mobile ----------------------------------------------------
     The straddling cell has nothing to straddle once the columns stack, so the
     plate returns to the flow between the photograph and the copy. */
  @media (max-width: 1023px) {
    .wrd__grid { grid-template-columns: minmax(0, 1fr); row-gap: clamp(24px, 4vh, 40px); }

    .wrd__media { grid-column: 1; grid-row: 1; max-height: 420px; }
    .wrd__media :global(.photo) { aspect-ratio: 16 / 10; }

    .wrd__fig {
      grid-column: 1;
      grid-row: 2;
      justify-self: start;
      /* The desktop overhang has nothing to overhang once the columns stack. */
      margin-right: 0;
      align-self: auto;
      margin-bottom: 0;
      transform: none;
    }

    .wrd__copy { grid-column: 1; grid-row: 3; }
  }

  @media (max-width: 639px) {
    .wrd { padding-block: var(--sb-section-y); }
  }
</style>
