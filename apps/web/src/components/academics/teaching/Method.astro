---
/**
 * TEACHING & LEARNING · CHAPTER 1 — TEACHING METHODOLOGY + COLLABORATIVE LEARNING
 *
 * COMPOSITION: editorial, asymmetric. The head holds the left column and stays
 * put; the four moves of a lesson cascade down the right in a diagonal, each one
 * indented further than the last, with an outlined numeral doing the work a card
 * border would otherwise do. The collaborative-learning note is a rotated plate
 * that overlaps the cascade rather than sitting under it.
 *
 * NOT A CARD GRID, and the diagonal is the reason: four equal boxes would say the
 * steps are interchangeable. They are ordered, and the indent is what says so.
 *
 * THE NUMERALS ARE OUTLINED, not filled — `-webkit-text-stroke`. At 96px a filled
 * numeral out-shouts the step name beside it, which is the actual content. The
 * fallback where text-stroke is unsupported is a filled numeral at 8% opacity,
 * declared first, so it degrades to quiet rather than to black.
 *
 * BLUEPRINT TEXTURE IN CSS, not the grid PNG. Two sections further down this page
 * use that image; a third would make it the page's motif rather than an accent.
 * Repeating gradients also stay sharp at any size and cost no request.
 */
import { Image } from 'astro:assets';
import SectionHead from '../SectionHead.astro';
import brush from '../../../assets/icons/paintbrush.png';
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/teaching-learning/');
const teachingLearning = ac.blockMap('teachingLearning');

const { method } = teachingLearning;
---

<section class="mth" id="methodology" aria-labelledby="mth-title">
  <div class="u-container mth__frame">
    <div class="mth__grid">
      <div class="mth__intro" data-reveal>
        <SectionHead
          eyebrow={method.eyebrow}
          heading={method.heading}
          stand={method.stand}
          align="start"
          id="mth-title"
          measure={18}
        />

        <dl class="mth__proofs">
          {
            method.proofs.map((p) => (
              <div class="mth__proof">
                {/* One expression, not two on separate lines: JSX preserves the
                    newline between adjacent expressions as a space, which
                    rendered "130 +". */}
                <dt class="mth__proof-v t-tabular">
                  <span data-count={p.value} data-count-suffix={p.suffix}>{`${p.value}${p.suffix}`}</span>
                </dt>
                <dd class="mth__proof-l">{p.label}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* The cascade. An <ol> because the order is the content.
          data-step-track drives the connector: the line draws itself down the
          numerals as the reader scrolls, and each step lights as it is passed. */}
      <ol class="mth__steps" data-step-track>
        {
          method.steps.map((s, i) => (
            <li class="mth__step" data-pop data-pop-delay={i * 60} data-step>
              <span class="mth__n" aria-hidden="true">{s.n}</span>
              <div class="mth__body">
                <h3 class="mth__step-h">{s.step}</h3>
                <p class="mth__step-b">{s.body}</p>
              </div>
            </li>
          ))
        }
      </ol>
    </div>

    <aside class="mth__aside" data-pop>
      {/* The brush belongs to THIS plate, not to the section. Inside the aside so
          it inherits the plate's own 1.2° lean and travels with it — anchored to
          the corner it appears to have painted, rather than floating somewhere
          above the whole chapter.

          TWO ELEMENTS: the wrapper positions, the image inside animates. Keeping
          the motion off the positioned element means a transform written here
          later — an entrance, a parallax — cannot collide with the painting
          keyframes. Decorative throughout, so aria-hidden. */}
      <span class="mth__brush" aria-hidden="true">
        <Image
          class="mth__brush-img"
          src={brush}
          alt=""
          widths={[160, 320]}
          sizes="130px"
          loading="lazy"
        />
      </span>

      <p class="mth__aside-l">{method.aside.label}</p>
      <p class="mth__aside-b">{method.aside.body}</p>
    </aside>
  </div>
</section>

<style>
  .mth {
    position: relative;
    overflow: hidden;
    padding-block: var(--sb-section-y) clamp(56px, 8vh, 96px);
    background:
      /* Blueprint. Two line weights an octave apart, so it reads as ruled paper
         rather than as a single flat mesh, and a wash that fades the whole thing
         out before it reaches the copy. */
      radial-gradient(120% 80% at 80% 0%, rgba(255, 255, 255, 0.92) 0%, rgba(255, 255, 255, 0) 62%),
      repeating-linear-gradient(90deg, rgba(201, 60, 10, 0.055) 0 1px, transparent 1px 88px),
      repeating-linear-gradient(0deg, rgba(201, 60, 10, 0.055) 0 1px, transparent 1px 88px),
      repeating-linear-gradient(90deg, rgba(201, 60, 10, 0.032) 0 1px, transparent 1px 22px),
      repeating-linear-gradient(0deg, rgba(201, 60, 10, 0.032) 0 1px, transparent 1px 22px),
      var(--sb-ivory);
  }

  .mth__frame { position: relative; }

  /* --- The brush -----------------------------------------------------------
     It paints. The handle swings back and forth around the BRISTLES rather than
     around the image's centre — `transform-origin` at 28%/76% is roughly where
     the ferrule sits — which is the whole difference between a brush working and
     a picture rocking.

     THE MOTION IS ON THE IMAGE, THE POSITION ON ITS WRAPPER — worth keeping even
     though nothing writes a transform here today. An earlier version carried a
     scroll parallax as well and put both on one node, animating the individual
     `rotate`/`translate` properties on the reasoning that those compose with
     `transform` rather than replacing it, so GSAP could still own `transform`.

     That is not how it behaves. GSAP's CSSPlugin normalises whatever transform
     state it finds when it initialises, INCLUDING the individual properties, and
     bakes it into the matrix it writes. Measured: the inline style came out as
     `translate3d(…) rotate(-5.99896deg)` — a snapshot of wherever the keyframes
     happened to be at that instant, then applied for ever on top of an animation
     still running. The brush was double-rotated and drifting. The split costs one
     element and makes the collision impossible to reintroduce.

     No blend mode, unlike the pale two-stars mark this replaced: that needed a
     multiply to register on ivory at all. This is full-colour art on a saturated
     plate, and multiply would only dirty it. */
  /* Anchored to the PLATE's top-right corner, hanging past both edges so the
     bristles sit on the paint and the handle runs off into the page — the plate
     reads as something the brush has just laid down.

     THE CORNER IS THE ONE PLACE IT FITS. The label sits top-left and the body
     fills the rest, so the top-right is the only region of this plate with no
     type in it. Checked against the text's own extent rather than its block box:
     an earlier position over the cascade passed a box test and still had the
     first step's opening line running under the bristles. */
  .mth__brush {
    position: absolute;
    z-index: 1;
    top: clamp(-46px, -3.2vw, -26px);
    right: clamp(-34px, -2vw, -14px);
    width: clamp(78px, 7.4vw, 108px);
    pointer-events: none;
    user-select: none;
  }

  .mth__brush-img {
    display: block;
    width: 100%;
    height: auto;
    /* Around the BRISTLES, not the image's centre — that is the difference
       between a brush working and a picture rocking. */
    transform-origin: 28% 76%;
    animation: mth-brush 5.5s ease-in-out infinite;
  }

  @keyframes mth-brush {
    0%,
    100% {
      rotate: -6deg;
      translate: 0 0;
    }
    50% {
      rotate: 5deg;
      translate: -7px 9px;
    }
  }

  /* base.css already collapses every animation to 0.01ms under reduced motion,
     which lands the brush on its 100% frame — a static, slightly tilted brush.
     Stated explicitly so the resting angle is a decision rather than a leftover. */
  @media (prefers-reduced-motion: reduce) {
    .mth__brush-img {
      animation: none;
      rotate: -6deg;
    }
  }

  .mth__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: start;
  }

  /* The head stays with the reader while the cascade runs past it. Sticky, not
     JS: it costs nothing and cannot break. The offset clears the masthead. */
  .mth__intro {
    position: sticky;
    top: calc(var(--sb-masthead-h) + 32px);
  }

  /* --- Proofs --------------------------------------------------------------- */

  .mth__proofs {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 28px);
    margin: clamp(28px, 4vh, 44px) 0 0;
    padding-top: var(--sb-6);
    border-top: var(--sb-hairline);
  }

  .mth__proof-v {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(30px, 3.4vw, 46px);
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-violet);
  }

  .mth__proof-l {
    margin: var(--sb-3) 0 0;
    font-size: var(--sb-caption);
    line-height: 1.5;
    color: var(--sb-text-secondary);
  }

  /* --- The cascade ----------------------------------------------------------
     Each step steps further in than the last. The indent is a step-count
     multiplier rather than four hand-typed values, so adding a fifth move
     continues the diagonal instead of restarting it. */
  /* The foot padding is what the aside plate overlaps INTO. Without it the plate's
     negative top margin pulled it straight over the last step's final line — the
     word "marked." was sitting under an orange panel. The plate still tucks up
     against the cascade; it just lands on reserved space instead of on type. */
  .mth__steps {
    list-style: none;
    margin: 0;
    padding: 0 0 clamp(48px, 6vh, 84px);
  }

  .mth__step {
    --indent: 0;
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(16px, 2vw, 30px);
    align-items: start;
    margin-left: calc(var(--indent) * clamp(12px, 2.4vw, 40px));
    padding-block: clamp(22px, 3vh, 34px);
    border-top: var(--sb-hairline);
  }

  /* --- The connector -------------------------------------------------------
     A dashed line from each numeral to the next, so the four moves read as one
     route rather than four entries. It is drawn per STEP rather than as one line
     down the list, because the cascade indents: a single straight rail would
     leave the lower numerals further and further away from it.

     scaleY from the top, so it draws downward. The step below is offset by the
     indent, so the line leans — `--indent` is the same variable that sets the
     margin, which keeps the two in step if the indent ever changes. */
  .mth__step:not(:last-child)::after {
    content: '';
    position: absolute;
    left: calc(clamp(19px, 2.6vw, 38px));
    top: calc(clamp(22px, 3vh, 34px) + 0.62em);
    bottom: calc(clamp(22px, 3vh, 34px) * -1 - 0.2em);
    border-left: 2px dashed rgba(201, 60, 10, 0.32);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 700ms var(--sb-ease);
  }

  /* `.is-passed` is set by the observer below as each step reaches the middle of
     the screen. Without the script the line simply never draws — the steps are
     numbered and ordered in the markup, so nothing is lost but the flourish. */
  .mth__step.is-passed::after { transform: scaleY(1); }

  .mth__step.is-passed .mth__n {
    -webkit-text-stroke-color: var(--sb-violet);
    color: rgba(201, 60, 10, 0.12);
  }

  .mth__step:nth-child(2) { --indent: 1; }
  .mth__step:nth-child(3) { --indent: 2; }
  .mth__step:nth-child(4) { --indent: 3; }

  .mth__step:first-child { border-top: 0; padding-top: 0; }

  /* Outlined. The filled colour is declared FIRST as the fallback for engines
     without text-stroke, and it is a faint tint rather than the brand orange, so
     an unsupported browser gets a quiet numeral instead of a shouting one. */
  .mth__n {
    font-family: var(--sb-font-display);
    font-weight: 800;
    font-size: clamp(38px, 5.2vw, 76px);
    line-height: 0.82;
    letter-spacing: -0.05em;
    color: rgba(201, 60, 10, 0.14);
    -webkit-text-stroke: 1.5px rgba(201, 60, 10, 0.5);
    font-variant-numeric: tabular-nums;
    transition: -webkit-text-stroke-color var(--sb-dur-link) ease, color var(--sb-dur-link) ease;
  }

  @supports (-webkit-text-stroke: 1px red) {
    .mth__n { color: transparent; }
  }

  .mth__step:hover .mth__n {
    -webkit-text-stroke-color: var(--sb-violet);
    color: rgba(201, 60, 10, 0.1);
  }

  .mth__step-h {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(20px, 2vw, 28px);
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }

  .mth__step-b {
    /* 40ch, not 46. The brush sits in this column's top-right corner and at 46
       the first step's opening line ran under its bristles — measured, and
       visible in the render as "a problem, a" crossing the paint. */
    max-width: 40ch;
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.72;
    color: var(--sb-text-secondary);
  }

  /* --- Collaborative-learning plate ---------------------------------------
     Overlaps the cascade's foot and leans a degree and a half off true, so it
     reads as laid on top of the page rather than as the next row of it. */
  .mth__aside {
    position: relative;
    z-index: 2;
    width: min(560px, 100%);
    margin: clamp(-28px, -2vw, -12px) 0 0 auto;
    padding: clamp(24px, 2.6vw, 36px);
    border-radius: var(--sb-r-2);
    background: var(--sb-violet);
    box-shadow: 0 26px 56px -26px rgba(122, 36, 6, 0.62);
    transform: rotate(-1.2deg);
  }

  .mth__aside-l {
    margin-bottom: var(--sb-4);
    font-size: var(--sb-label);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-on-violet-muted);
  }

  .mth__aside-b {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.42;
    letter-spacing: -0.02em;
    color: #fff;
  }

  /* --- Reduced motion ------------------------------------------------------
     The connector still DRAWS — it just arrives instead of growing. Removing it
     entirely would take away information the sighted reader uses to see the four
     moves as one sequence; only the travel goes. */
  @media (prefers-reduced-motion: reduce) {
    .mth__n,
    .mth__step::after { transition: none; }
  }

  /* --- Tablet --------------------------------------------------------------
     Two columns leave the cascade about 40 characters wide once the numeral and
     the deepest indent are taken out. It goes full width and the head stops
     being sticky — a sticky block in a single column just pins the top of the
     section to the viewport for the length of the whole chapter. */
  @media (max-width: 1023px) {
    .mth__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(36px, 5vh, 56px); }
    .mth__intro { position: static; }
    .mth__aside { margin-inline: 0; width: 100%; }
  }

  @media (max-width: 767px) {
    /* The plate is full width and the corner is tight; the brush would hang off
       the screen edge rather than off the plate. */
    .mth__brush { display: none; }
    /* The diagonal is a wide-screen device. At this width the indent eats the
       measure it was meant to dramatise. */
    .mth__step { margin-left: 0; }
    .mth__proofs { grid-template-columns: minmax(0, 1fr); }

    .mth__aside { transform: none; }
  }
</style>

<script>
  /**
   * Lights each step of the cascade as the reader reaches it, and draws the
   * connector down to the next one.
   *
   * NOT IN motion-gsap.ts. That chunk is gated behind prefers-reduced-motion and
   * Save-Data because everything in it is decoration; the connector is closer to
   * structure — it is what makes four numbered blocks read as one ordered route.
   * So it ships here and always runs, and the CSS above holds the travel back
   * under reduced motion rather than the line never appearing at all.
   *
   * ONE-WAY. `unobserve` after the first crossing, so scrolling back up does not
   * un-draw the line behind the reader — a route that erases itself is a fidget,
   * not a narrative.
   */
  const track = document.querySelector<HTMLElement>('[data-step-track]');

  if (track) {
    const steps = [...track.querySelectorAll<HTMLElement>('[data-step]')];

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting) return;
          e.target.classList.add('is-passed');
          io.unobserve(e.target);
        });
      },
      // Fires as the step's top passes the lower third of the viewport, which is
      // where a reader is actually looking rather than where the element starts.
      { rootMargin: '0px 0px -34% 0px', threshold: 0 }
    );

    steps.forEach((s) => io.observe(s));
  }
</script>
