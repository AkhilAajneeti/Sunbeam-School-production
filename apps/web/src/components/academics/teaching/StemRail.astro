---
/**
 * TEACHING & LEARNING · CHAPTER 4 — STEM · ROBOTICS & CODING · ENRICHMENT
 *
 * COMPOSITION: horizontal storytelling. Six panels on a rail that runs off the
 * right edge of the page, read by scrolling sideways.
 *
 * ═══ WHY THIS RAIL IS NOT SCROLL-JACKED ══════════════════════════════════════
 *
 * The Awwwards build of a horizontal story pins the section and translates a
 * track against page scroll. It looks superb in a video and behaves badly in
 * three real cases: a trackpad gesture gets hijacked mid-page, a phone fights the
 * browser's own momentum, and a keyboard user cannot reach the content at all
 * because there is nothing focusable to move.
 *
 * This is a real `overflow-x` scroller with scroll-snap. That single decision buys
 * flick, drag, shift-wheel, arrow keys, a scrollbar, deep-linking and screen
 * reader scrolling — none of which has to be written. GSAP only draws the progress
 * bar (`[data-rail]` in motion-gsap.ts), so with the chunk absent the rail is
 * still fully usable and merely loses its indicator.
 *
 * `tabindex="0"` with a role and a label is the accessible pattern for a scroll
 * region: it is what makes the arrow keys work and what tells a screen reader the
 * container is scrollable. Without it a keyboard-only reader would reach panel one
 * and stop.
 *
 * ═══ AND WHY THE PANELS ARE NOT SIX CARDS ════════════════════════════════════
 *
 * `kind` gives each panel a different internal composition — a photograph, a
 * list, or a stated gap where no image exists. Six identical cards on a rail is
 * still a card grid; it has just been turned on its side.
 *
 * ⚠ THE ROBOTICS LAB NOW HAS A PHOTOGRAPH, and photography request A2 is closed
 * for this panel. It carried `kind: 'gap'` and a rendered notice saying no image
 * existed, because the only robotics picture in the repository was stock. The
 * school has since supplied assets/extra-img/robotics.jpg — one of its own
 * builds, sensors and wiring visible — so the panel is an ordinary photo panel.
 *
 * ⚠ `kind: 'figure'` NO LONGER EXISTS. Two panels used to set a 56–88px white
 * numeral over their photograph; the client asked for it removed, so those are
 * photo panels now and `figure`/`figureLabel` are gone from the data. If a
 * numeral is ever wanted back, note that these panels already carry an "03"
 * index in the same corner — that collision is what made the big figure read as
 * two competing numbers.
 */
import Photo from '../../ui/Photo.astro';
import SectionHead from '../SectionHead.astro';

import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/teaching-learning/');
const teachingLearning = ac.blockMap('teachingLearning');

const { rail } = teachingLearning;

/** Explicit map, not import.meta.glob — see the note in teaching-learning.astro. */
const photos = ac.section('photos').photos;
---

{/* data-rail-scope: the progress indicator lives in the head, which is a SIBLING
    of the scroller, and a custom property set on the scroller would never reach
    it. This marks the ancestor the motion chunk writes --rail-progress to. */}
<section class="rail" id="stem" data-rail-scope aria-labelledby="rail-title">
  <div class="u-container rail__head-wrap">
    <SectionHead
      eyebrow={rail.eyebrow}
      heading={rail.heading}
      stand={rail.stand}
      align="start"
      id="rail-title"
      measure={20}
      class="rail__head"
    />

    {/* Controls. A thin progress bar alone was not an affordance — nothing on
        screen said "this moves sideways" until you tried. Two buttons say it.

        They are BUTTONS, not links, and they are the only scripted part of this
        rail: with the script blocked they are hidden outright rather than left
        on screen doing nothing. Everything else about the rail still works. */}
    <div class="rail__controls">
      <div class="rail__meter" aria-hidden="true">
        <span class="rail__meter-fill"></span>
      </div>

      <div class="rail__btns" data-rail-btns hidden>
        <button class="icon-btn rail__btn" type="button" data-rail-prev aria-label="Previous rooms">
          <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
        <button class="icon-btn rail__btn" type="button" data-rail-next aria-label="More rooms">
          <svg width="15" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
            <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
          </svg>
        </button>
      </div>
    </div>
  </div>

  {/* TWO ELEMENTS, NOT ONE — the viewport clips, the track moves.
      The native rail scrolls the viewport; the pinned build translates the track
      inside it. A single element cannot do both, because a pinned translate needs
      something outside itself to clip against.

      The track bleeds off the right edge of the container on purpose: a panel cut
      by the viewport is the clearest possible signal that there is more to the
      right. */}
  <div
    class="rail__viewport"
    data-rail
    tabindex="0"
    role="region"
    aria-label="Science and enrichment rooms — scroll sideways for more"
  >
  <ol class="rail__track" data-rail-track>
    {
      rail.panels.map((p) => {
        const img = p.photo ? photos[p.photo] : undefined;
        /* `in`, not a non-null assertion. The panels are a discriminated union and
           the ones with `photo: null` genuinely have no `alt` key, so `p.alt!`
           was a type error that only stayed quiet because Astro strips types
           before the build ever sees it. This narrows instead of overriding. */
        const alt = 'alt' in p ? p.alt : '';
        return (
          /* ONE CARD SHAPE, TWO GROUNDS. Every panel is now a full-bleed frame
             with the copy laid over its foot — the reference composition. Panels
             that HAVE a photograph use it; the two that do not get an ink ground
             with the page's blueprint mesh, at the same size and shape, so the
             rail keeps its rhythm without a stock photograph being invented to
             fill the hole. */
          <li class:list={['pan', `pan--${p.kind}`, !img && 'pan--dark']} data-rail-item>
            <div class="pan__inner">
              {img ? (
                <div class="pan__media">
                  <Photo
                    src={img}
                    alt={alt}
                    brief={p.title}
                    position="50% 45%"
                    sizes="(max-width: 767px) 82vw, 440px"
                  />
                </div>
              ) : (
                <span class="pan__plan" aria-hidden="true"></span>
              )}

              <span class="pan__scrim" aria-hidden="true"></span>

              <p class="pan__n t-tabular" aria-hidden="true">{p.n}</p>

              {/* ⚠ THE BIG WHITE QUANTITY IS GONE, at the client's request. It
                  set a 56–88px numeral over the photograph — "3" on the science
                  rooms, "12" on the laboratory total — and on a panel that
                  already carries an "03" index in the same corner it read as two
                  numbers competing rather than one figure leading. The counts
                  themselves are unaffected: they are stated in the copy and on
                  the counter strip. */}

              <div class="pan__body">
                <h3 class="pan__h">{p.title}</h3>
                <p class="pan__fact t-tabular">{p.fact}</p>
                <p class="pan__b">{p.body}</p>

                {p.kind === 'list' && 'items' in p && (
                  <ul class="pan__list">
                    {p.items.map((it) => (
                      <li>{it}</li>
                    ))}
                  </ul>
                )}

                {/* Dashed, so it reads as deliberately unfinished rather than as
                    another sentence of marketing. */}
                {p.kind === 'gap' && (
                  <p class="pan__gap">
                    No photograph of this room yet — the only image we hold is stock, and stock
                    would misrepresent a lab that genuinely exists.
                  </p>
                )}
              </div>
            </div>
          </li>
        );
      })
    }

    {/* THE TAIL IS A REAL ELEMENT, not padding and not a pseudo — see the note on
        .rail__tail below. aria-hidden because it is empty spacing: a screen
        reader announcing a seventh, blank item in a list of six rooms would be
        reporting a room that does not exist. */}
    <li class="rail__tail" data-rail-tail aria-hidden="true"></li>
  </ol>
  </div>
</section>

<style>
  .rail {
    position: relative;
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  .rail__head-wrap {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 300px);
    gap: clamp(24px, 4vw, 64px);
    align-items: end;
    margin-bottom: clamp(32px, 5vh, 56px);
  }

  /* --- Controls ------------------------------------------------------------ */

  .rail__controls {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
  }

  .rail__btns { display: flex; gap: var(--sb-3); flex-shrink: 0; }

  /* `hidden` is removed by the component script, so with JavaScript blocked these
     never appear rather than appearing dead. `display: flex` would otherwise beat
     the `hidden` attribute's UA `display: none`, which is a classic way to ship a
     button that cannot work. */
  .rail__btns[hidden] { display: none; }

  .rail__btn:disabled {
    opacity: 0.34;
    cursor: default;
  }

  .rail__btn:disabled:hover {
    background: #fff;
    border-color: var(--sb-border);
    color: var(--sb-charcoal);
  }

  .rail__meter {
    position: relative;
    flex: 1;
    height: 3px;
    border-radius: var(--sb-r-full);
    background: rgba(201, 60, 10, 0.16);
    overflow: hidden;
  }

  .rail__meter-fill {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: var(--sb-violet);
    transform-origin: left;
    /* var() fallback, not a hard 0: with the motion chunk absent the property is
       never written and the bar stays empty, which is honest. */
    transform: scaleX(var(--rail-progress, 0));
    transition: transform 120ms linear;
  }

  /* --- Track ---------------------------------------------------------------
     Padded with the container's own margin so panel one lines up with the
     heading above it, and with a full margin of run-off at the end so the last
     panel can snap flush instead of stopping short. */
  /* --- Viewport: the native scroller, and the fallback ---------------------
     THIS IS THE BASE STATE AND IT IS FULLY FUNCTIONAL ON ITS OWN. The pinned
     build below is layered on top by the motion chunk; when that chunk does not
     load — reduced motion, Save-Data, a blocked script — the reader gets exactly
     this: a real scroller with flick, drag, shift-wheel, arrow keys and a
     scrollbar. Nothing about the pin is load-bearing. */
  .rail__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    /* MUST MATCH THE TRACK'S PADDING. `scroll-snap-align: start` aligns a panel
       to the SNAPPORT, which without this is the scrollport — so panel one, which
       begins 80px in because of the track's left padding, could only satisfy its
       own snap by resting at scrollLeft: 80. Measured exactly that: the rail sat
       at 80 on load, which left the "previous" button enabled at the start and
       the progress bar showing 8% before anyone had scrolled. Insetting the
       snapport by the same amount puts panel one's snap position back at 0. */
    scroll-padding-inline: max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2));
    /* Firefox / standards. WebKit's ::-webkit-scrollbar rules below do the same
       job where this is unsupported. */
    scrollbar-width: thin;
    scrollbar-color: rgba(201, 60, 10, 0.4) transparent;
  }

  .rail__viewport:focus-visible {
    outline: 2px solid var(--sb-focus);
    outline-offset: 4px;
    border-radius: var(--sb-r-0);
  }

  .rail__viewport::-webkit-scrollbar { height: 8px; }
  .rail__viewport::-webkit-scrollbar-track { background: transparent; }
  .rail__viewport::-webkit-scrollbar-thumb {
    background: rgba(201, 60, 10, 0.32);
    border-radius: var(--sb-r-full);
  }
  .rail__viewport::-webkit-scrollbar-thumb:hover { background: rgba(201, 60, 10, 0.55); }

  .rail__track {
    display: flex;
    align-items: flex-start;
    gap: clamp(16px, 1.8vw, 26px);
    list-style: none;
    margin: 0;
    /* The left inset lines panel one up with the heading above it. */
    padding-block: 6px 22px;
    padding-left: max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2));
    padding-right: 0;
  }


  /* --- Pinned state ---------------------------------------------------------
     Added by motion-gsap.ts once it has taken the rail over, and ONLY at ≥1024.
     Everything here is a consequence of that hand-over:

     · the viewport stops scrolling natively, because the track is now moved by
       transform and two scroll models fighting produces a rail that jumps;
     · snapping goes with it — a mandatory snap point against a scrubbed transform
       drags the scroll position back on every frame;
     · the scrollbar goes, since there is nothing left to scroll.

     The section also becomes a viewport-height stage. A pinned section that is
     taller than the screen simply hides its own bottom, and this one was ~890px
     against a 700px laptop viewport. Panels are given a height rather than being
     left content-sized so six of them cannot disagree about it. */
  .rail.is-pinned .rail__viewport {
    overflow: hidden;
    scroll-snap-type: none;
    scrollbar-width: none;
  }

  .rail.is-pinned .rail__viewport::-webkit-scrollbar { display: none; }

  .rail.is-pinned {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 100vh;
    min-height: 100svh;
    padding-block: clamp(24px, 5vh, 56px);
  }

  .rail.is-pinned .rail__head-wrap { margin-bottom: clamp(20px, 3.4vh, 40px); }

  /* Slightly shorter when pinned, so a card plus the section head still fits a
     short laptop viewport. The frame clips internally, so nothing needs to
     scroll inside it. */
  .rail.is-pinned .pan { height: clamp(340px, 56vh, 540px); }

  /* --- Panel ----------------------------------------------------------------
     A full-bleed frame with the copy laid over its foot. Every panel is the same
     object whether it carries a photograph or not — see the note in the markup.

     `perspective` lives on the TRACK, not here, so all six cards share one
     vanishing point. Per-card perspective gives each its own, and the row stops
     reading as one plane turning. */
  /* THE TAIL SPACE IS A REAL ELEMENT, and it took three attempts to get here.
     It is what decides where the rail stops.

       padding-right on the track   — Chrome omits a flex container's end padding
                                      from scrollWidth entirely.
       ::after flex item            — computed 464px wide and STILL contributed
                                      nothing: measured lastPanelRight 2802 and
                                      trackScrollWidth 2802, identical.
       a real <li>                  — an ordinary in-flow box, counted everywhere.

     The middle two left the native rail ending 500px short of where the pinned
     build stopped — two mechanisms disagreeing because of an invisible browser
     quirk.

     SIZED TO MIRROR THE LEFT INSET, less the flex gap that precedes it, so the
     last panel finishes the same distance from the right edge as the first one
     starts from the left. The rail ends with the last card fully in view and
     framed, and the pin releases there. */
  .rail__tail {
    flex: 0 0 calc(
      max(var(--sb-margin), calc(50vw - var(--sb-max-content) / 2)) - clamp(16px, 1.8vw, 26px)
    );
    align-self: stretch;
  }

  .pan {
    position: relative;
    flex: 0 0 clamp(268px, 30vw, 440px);
    /* An explicit height in every state, not only when pinned. The heading, fact
       and paragraph are absolutely positioned over the frame now, so they no
       longer give the panel a height of their own — without this the card
       collapses to nothing. */
    height: clamp(400px, 62vh, 560px);
    scroll-snap-align: start;
    /* The stagger is MARGIN, not transform: the depth effect writes transform on
       these elements every frame and would overwrite an offset set that way. */
    margin-top: 0;
    /* Set by the depth and drift passes. THE FALLBACKS ARE THE WHOLE POINT: with
       no script at all this resolves to an untransformed card — flat, upright,
       full size — so every state that never runs the passes still looks right.
       Order matters. The lift is applied before the rotations so a tilted card
       rises straight up rather than along its own tilted axis. */
    transform:
      perspective(1600px)
      translate3d(0, var(--pan-lift, 0px), 0)
      rotateY(var(--pan-turn, 0deg))
      rotateZ(var(--pan-tilt, 0deg))
      scale(var(--pan-scale, 1));
    transform-origin: center center;
    transition: box-shadow var(--sb-dur-image) var(--sb-ease);
    will-change: transform;
  }

  .pan:nth-child(even) { margin-top: clamp(18px, 4.4vh, 52px); }

  .pan__inner {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    height: 100%;
    border-radius: var(--sb-r-3);
    background: var(--sb-ink);
    box-shadow: var(--sb-shadow-card);
  }

  .pan:hover .pan__inner { box-shadow: var(--sb-shadow-card-hover); }

  /* --- Grounds ------------------------------------------------------------- */

  .pan__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .pan__media :global(.photo) { height: 100%; border-radius: 0; }

  .pan__media :global(img) {
    transition: transform 1200ms var(--sb-ease);
  }

  .pan:hover .pan__media :global(img) { transform: scale(1.06); }

  /* The blueprint stands in for a photograph we do not have. Same frame, same
     scrim, so the panel reads as considered rather than as a missing image. */
  .pan__plan {
    position: absolute;
    inset: 0;
    z-index: 0;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 26px),
      radial-gradient(120% 80% at 50% 0%, rgba(255, 138, 92, 0.16), transparent 62%),
      var(--sb-ink);
  }

  /* Bottom-weighted, and deep — this carries a heading, a fact line and a
     three-line paragraph, not just a title. Held at 0.9 through the lower half
     for the same reason the figure panels are: the copy has to clear AA over
     whatever the photograph is doing underneath it. */
  .pan__scrim {
    position: absolute;
    z-index: 1;
    inset: 0;
    background: linear-gradient(
      to top,
      rgba(10, 7, 5, 0.96) 0%,
      rgba(10, 7, 5, 0.92) 42%,
      rgba(10, 7, 5, 0.58) 68%,
      rgba(10, 7, 5, 0.24) 100%
    );
    pointer-events: none;
  }

  /* --- Overlaid content ---------------------------------------------------- */

  .pan__n {
    position: absolute;
    z-index: 2;
    top: clamp(18px, 1.8vw, 26px);
    left: clamp(20px, 1.9vw, 28px);
    font-family: var(--sb-font-display);
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.12em;
    color: var(--sb-lime);
  }

  /* `.pan__fig` was the big white numeral over the photograph. Removed with its
     markup — see the note there. */

  .pan__body {
    position: absolute;
    z-index: 2;
    inset: auto 0 0 0;
    padding: clamp(20px, 1.9vw, 28px);
  }

  .pan__h {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(19px, 1.7vw, 25px);
    line-height: 1.16;
    letter-spacing: -0.024em;
    color: #fff;
  }

  .pan__fact {
    margin-top: var(--sb-3);
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.03em;
    color: var(--sb-lime);
  }

  .pan__b {
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.62;
    color: var(--sb-on-dark-78);
  }

  .pan__list {
    margin: var(--sb-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .pan__list li {
    position: relative;
    padding-left: var(--sb-5);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    line-height: 1.5;
    color: #fff;
  }

  .pan__list li + li { margin-top: var(--sb-3); }

  .pan__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.58em;
    width: 6px;
    height: 6px;
    border-radius: var(--sb-r-full);
    background: var(--sb-lime);
  }

  .pan__gap {
    margin-top: var(--sb-5);
    padding-top: var(--sb-4);
    border-top: 1px dashed rgba(255, 255, 255, 0.34);
    font-size: var(--sb-caption);
    line-height: 1.55;
    color: var(--sb-on-dark-66);
  }

  @media (prefers-reduced-motion: reduce) {
    .pan,
    .pan__media :global(img),
    .rail__meter-fill { transition: none; }
    .pan:hover .pan__media :global(img) { transform: none; }
    /* NOT `.pan:hover { transform: none }`. Transform on a panel is now owned by
       the depth pass, and zeroing it on hover would flatten whichever card the
       pointer happened to be over. The depth pass does not run under reduced
       motion anyway, so there is nothing here to switch off. */
  }

  @media (max-width: 767px) {
    .rail__head-wrap { grid-template-columns: minmax(0, 1fr); align-items: start; }
    /* A touch reader flicks the rail rather than aiming at a 48px button, so the
       arrows go and the meter takes the full width. The depth pass does not run
       at this width either, so the cards sit flat and full size. */
    .rail__btns { display: none !important; }
  }
</style>

<script>
  /**
   * The rail's arrow buttons.
   *
   * PROGRESSIVE ENHANCEMENT, in the literal sense: the buttons ship with the
   * `hidden` attribute and this script removes it. If the script never runs there
   * are no dead controls on the page, and the rail is still fully operable by
   * drag, flick, shift-wheel, scrollbar and arrow keys — none of which this file
   * provides or can break.
   *
   * A STEP IS ONE PANEL, measured from the DOM rather than assumed: the panel
   * basis is a clamp() and the gap is a clamp(), so any number hard-coded here
   * would be wrong at most widths. Reading the first two panels' offsets gives
   * the real pitch including the gap, whatever the viewport is doing.
   */
  const rail = document.querySelector<HTMLElement>('[data-rail]');
  const btns = document.querySelector<HTMLElement>('[data-rail-btns]');

  if (rail && btns) {
    const prev = btns.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
    const next = btns.querySelector<HTMLButtonElement>('[data-rail-next]')!;
    btns.hidden = false;

    /* The panels are GRANDCHILDREN, not children. Splitting the rail into a
       clipping viewport and a moving track for the pin put an <ol> between them,
       and this had been reading `rail.children` — which became a list of one.
       That silently took the `< 2` fallback of 80% of the viewport, so a single
       press of "next" jumped almost to the end of the rail instead of advancing
       one panel. Measured: 0 → 1290 in one click, where a panel is 446. */
    const pitch = () => {
      const panels = rail.querySelectorAll<HTMLElement>('[data-rail-track] > *');
      if (panels.length < 2) return rail.clientWidth * 0.8;
      return panels[1].getBoundingClientRect().left - panels[0].getBoundingClientRect().left;
    };

    const section = rail.closest<HTMLElement>('[data-rail-scope]');

    /* Disabled at the ends rather than silently doing nothing.
       TWO SOURCES OF TRUTH, because there are two mechanisms. When the motion
       chunk has pinned the section the viewport no longer scrolls at all, so
       `scrollLeft` is a flat 0 for ever and these buttons would sit disabled and
       enabled in exactly the wrong states; the pin publishes its position on the
       section as data attributes instead. The 2px slack on the native path
       absorbs sub-pixel scroll positions, which otherwise leave "next" enabled
       for ever at the right-hand end on fractional device pixel ratios. */
    const sync = () => {
      if (section?.classList.contains('is-pinned')) {
        prev.disabled = section.dataset.railAtStart !== 'false';
        next.disabled = section.dataset.railAtEnd === 'true';
        return;
      }
      const max = rail.scrollWidth - rail.clientWidth;
      prev.disabled = rail.scrollLeft <= 2;
      next.disabled = rail.scrollLeft >= max - 2;
    };

    const step = (dir: number) => {
      /* Offer the step to the pin first. A cancelable event is the whole
         handshake: if motion-gsap.ts has taken this rail over it calls
         preventDefault and scrolls the page; if it has not — reduced motion,
         Save-Data, below 1024, no JS chunk — nothing listens, nothing cancels,
         and the native scroll below runs. Neither side has to know whether the
         other exists. */
      const offer = new CustomEvent('rail:step', {
        detail: { dir },
        cancelable: true,
        bubbles: false,
      });
      if (section && !section.dispatchEvent(offer)) return;

      // `smooth` here rather than in CSS: base.css already disables smooth
      // scrolling under prefers-reduced-motion, and honouring that means asking
      // at the moment of the scroll rather than baking it in.
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      rail.scrollBy({ left: dir * pitch(), behavior: reduced ? 'auto' : 'smooth' });
    };

    prev.addEventListener('click', () => step(-1));
    next.addEventListener('click', () => step(1));
    rail.addEventListener('scroll', sync, { passive: true });
    window.addEventListener('resize', sync);

    /* The pin reports its position by mutating the section's data attributes, so
       that is what the buttons watch when it is driving. */
    if (section) {
      new MutationObserver(sync).observe(section, {
        attributes: true,
        attributeFilter: ['data-rail-at-start', 'data-rail-at-end', 'class'],
      });
    }

    sync();
  }
</script>
