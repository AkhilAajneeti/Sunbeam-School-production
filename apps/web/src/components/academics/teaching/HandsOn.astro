---
/**
 * TEACHING & LEARNING · CHAPTER 3 — EXPERIENTIAL + PROJECT-BASED LEARNING
 *
 * COMPOSITION: an overlapping collage. Three photographs at three depths, laid
 * out on an explicit 12-column grid so they overlap by design rather than by
 * negative margin, each drifting at a different rate so the stack has parallax
 * depth. The copy runs down the left; a rotated pull quote sits on the seam
 * between two of the frames.
 *
 * THE OVERLAP IS GRID AREAS, NOT MARGINS. Negative margins would make the
 * overlap depend on each image's own height, so a different crop or a slower
 * decode changes the composition. Column and row spans hold it whatever the
 * images do.
 *
 * DEPTH COMES FROM DIFFERENT PARALLAX RATES, and the middle frame moves the other
 * way — matched rates on all three would slide the whole collage as one flat
 * sheet, which is not parallax, it is a moving picture.
 *
 * Every photograph is Sunbeam Ballia's own. The stock files in this repository
 * that would fit these slots are not used; see the header of the page.
 */
import Photo from '../../ui/Photo.astro';
import SectionHead from '../SectionHead.astro';
import AcademicGlyph from '../AcademicGlyph.astro';

import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/teaching-learning/');
const bioPhoto = ac.pic('bioPhoto');
const sciPhoto = ac.pic('sciPhoto');
const mathsPhoto = ac.pic('mathsPhoto');
const teachingLearning = ac.blockMap('teachingLearning');

const { handsOn } = teachingLearning;
---

<section class="hands" id="experiential" aria-labelledby="hands-title">
  <div class="u-container">
    <div class="hands__grid">
      {/* --- Copy column --- */}
      <div class="hands__copy" data-reveal>
        <SectionHead
          eyebrow={handsOn.eyebrow}
          heading={handsOn.heading}
          align="start"
          id="hands-title"
          measure={17}
        />

        <div class="hands__prose">
          {handsOn.paragraphs.map((p) => <p>{p}</p>)}
        </div>

        <dl class="hands__anchors">
          {
            handsOn.anchors.map((a) => (
              <div class="hands__anchor">
                <dt class="hands__anchor-l">
                  <AcademicGlyph name={a.glyph} size={22} class="hands__glyph" />
                  {a.label}
                </dt>
                <dd class="hands__anchor-d">{a.detail}</dd>
              </div>
            ))
          }
        </dl>
      </div>

      {/* --- Collage. Decorative order: the frames are placed, not listed. --- */}
      <figure class="hands__collage">
        <div class="hands__frame hands__frame--a" data-parallax data-parallax-y="70">
          <div data-mask>
            <Photo
              file={bioPhoto}
              alt={ac.picAlt('bioPhoto')}
              brief="Biology practical"
              ratio="4 / 5"
              position="50% 45%"
              sizes="(max-width: 1023px) 60vw, 30vw"
            />
          </div>
        </div>

        <div class="hands__frame hands__frame--b" data-parallax data-parallax-y="-96">
          <div data-mask data-mask-from="left">
            <Photo
              file={sciPhoto}
              alt={ac.picAlt('sciPhoto')}
              brief="Microscope work"
              ratio="1 / 1"
              position="50% 40%"
              sizes="(max-width: 1023px) 46vw, 22vw"
            />
          </div>
        </div>

        <div class="hands__frame hands__frame--c" data-parallax data-parallax-y="46">
          <div data-mask>
            <Photo
              file={mathsPhoto}
              alt={ac.picAlt('mathsPhoto')}
              brief="Activity room lesson"
              ratio="3 / 2"
              position="50% 50%"
              sizes="(max-width: 1023px) 70vw, 34vw"
            />
          </div>
        </div>

        <figcaption class="hands__pull">{handsOn.pull}</figcaption>
      </figure>
    </div>
  </div>
</section>

<style>
  .hands {
    position: relative;
    overflow: hidden;
    padding-block: var(--sb-section-y-major);
    background:
      radial-gradient(90% 60% at 100% 12%, #fff4ee 0%, rgba(255, 244, 238, 0) 58%),
      var(--sb-ivory);
  }

  .hands__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
    gap: clamp(32px, 5vw, 76px);
    align-items: center;
  }

  /* --- Copy --------------------------------------------------------------- */

  .hands__prose { margin-top: clamp(24px, 3.4vh, 40px); }

  .hands__prose p {
    max-width: 48ch;
    font-size: var(--sb-body-sm);
    line-height: 1.78;
    color: var(--sb-text-secondary);
  }

  .hands__prose p + p { margin-top: var(--sb-5); }

  .hands__anchors {
    margin: clamp(28px, 4vh, 44px) 0 0;
    padding-top: var(--sb-6);
    border-top: var(--sb-hairline);
  }

  .hands__anchor + .hands__anchor {
    margin-top: var(--sb-5);
    padding-top: var(--sb-5);
    border-top: var(--sb-hairline);
  }

  .hands__anchor-l {
    display: flex;
    align-items: center;
    gap: var(--sb-4);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-h4);
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .hands__glyph { color: var(--sb-violet); }

  .hands__anchor-d {
    margin: 6px 0 0 calc(22px + var(--sb-4));
    font-size: var(--sb-caption);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  /* --- Collage -------------------------------------------------------------
     A 12 × 12 cell field the frames are placed into. Overlap is a matter of two
     spans sharing cells, so it holds at every width the grid survives and never
     depends on an image's intrinsic height. */
  .hands__collage {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(12, minmax(0, 1fr));
    /* The field needs a height to divide into rows; an aspect ratio gives it one
       that scales instead of a fixed pixel value that does not. */
    aspect-ratio: 1 / 1;
    margin: 0;
  }

  .hands__frame {
    position: relative;
    border-radius: var(--sb-r-2);
    overflow: hidden;
    box-shadow: var(--sb-shadow-card);
    will-change: transform;
  }

  .hands__frame > div,
  .hands__frame :global(.photo) { height: 100%; }

  /* a — tall, back-left. b — square, front, overlapping a's right edge and
     lifted. c — wide, bottom-right, behind b's lower corner. */
  .hands__frame--a { grid-column: 1 / 8; grid-row: 1 / 10; z-index: 1; }
  .hands__frame--b { grid-column: 6 / 13; grid-row: 3 / 9; z-index: 3; }
  .hands__frame--c { grid-column: 4 / 12; grid-row: 8 / 13; z-index: 2; }

  /* A white keyline on the front frame, so where two photographs overlap there is
     a deliberate edge rather than two crops merging into one another. */
  .hands__frame--b { border: 5px solid var(--sb-ivory); }

  /* --- Pull quote ---------------------------------------------------------
     On the seam between the tall frame and the wide one. */
  .hands__pull {
    position: absolute;
    z-index: 4;
    left: -2%;
    bottom: 9%;
    width: min(300px, 46%);
    padding: var(--sb-6) var(--sb-6) calc(var(--sb-6) + 2px);
    border-radius: var(--sb-r-2);
    background: var(--sb-violet);
    box-shadow: 0 24px 52px -22px rgba(122, 36, 6, 0.66);
    transform: rotate(-2deg);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(15px, 1.35vw, 20px);
    line-height: 1.34;
    letter-spacing: -0.02em;
    color: #fff;
  }

  /* --- Tablet -------------------------------------------------------------
     The collage keeps working stacked under the copy — it is a self-contained
     square field — so only the outer grid changes. */
  @media (max-width: 1023px) {
    .hands__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(36px, 6vh, 56px); }
    .hands__collage { max-width: 620px; margin-inline: auto; width: 100%; }
  }

  /* --- Mobile -------------------------------------------------------------
     Below this the three frames are ~110px each and the overlaps swallow the
     subjects. The field flattens to a stack of two: the tall frame and the wide
     one, side by side, with the square one dropped rather than shrunk to a
     thumbnail nobody can read. The pull quote returns to the flow. */
  @media (max-width: 639px) {
    .hands { padding-block: var(--sb-section-y); }

    .hands__collage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      aspect-ratio: auto;
      gap: var(--sb-4);
      max-width: none;
    }

    .hands__frame--a,
    .hands__frame--b,
    .hands__frame--c {
      grid-column: auto;
      grid-row: auto;
      /* The parallax script does not run below 1024, so nothing is fighting this
         reset — but a transform left on the element would break the flow. */
      transform: none;
    }

    .hands__frame--a { grid-column: span 2; }
    .hands__frame--b { display: none; }
    .hands__frame--c { grid-column: span 2; }

    .hands__pull {
      position: static;
      width: 100%;
      margin-top: var(--sb-5);
      transform: none;
    }
  }
</style>
