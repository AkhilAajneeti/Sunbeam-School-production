    margin: clamp(12px, 1.5vw, 18px) 0 0;
    font-size: clamp(28px, 3.4vw, 48px);
    color: #fff;
  }
  .ex-close__h em { color: var(--sb-lime); font-style: normal; }
  .ex-close__b {
    max-width: 64ch;
    margin: clamp(15px, 1.8vw, 22px) 0 0;
    font-size: clamp(12.5px, 0.92vw, 14.5px);
    line-height: 1.78;
    color: var(--sb-on-dark-82);
  }

  .ex-close__beats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: clamp(16px, 2.4vw, 40px);
    margin: clamp(24px, 3vw, 38px) 0 0;
    padding: 0;
    list-style: none;
  }
  .ex-close__beats li {
    display: flex;
    align-items: center;
    gap: 9px;
    font-size: clamp(10px, 0.76vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.17em;
    text-transform: uppercase;
    color: #fff;
  }
  /* The rule between the three, drawn on the gap rather than on the items. */
  .ex-close__beats li + li::before {
    content: '';
    width: clamp(20px, 3vw, 52px);
