  .ex-stop__shot :global(picture) {
    display: block;
    overflow: hidden;
    border-radius: calc(var(--sb-r-2) - 6px);
  }
  .ex-stop__shot :global(img) {
    display: block;
    width: 100%;
    height: auto;
