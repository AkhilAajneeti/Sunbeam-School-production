    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* ═══ 04 · THE SCHOOL IN PRACTICE ═════════════════════════════════════════ */
  .ex-close {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(50px, 6vw, 96px);
  }
  .ex-close__media { position: absolute; z-index: -3; inset: -12% 0; }
  .ex-close__media :global(picture),
  .ex-close__media :global(img) {
