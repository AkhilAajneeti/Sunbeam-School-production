  /* The stop with no photograph — an outlined plate, visibly not a picture. */
  /* ⚠ SHALLOWER AND LIGHTER THAN A PHOTOGRAPH, ON PURPOSE. At the same 5:4 as
     the real frames it was the largest and emptiest object in the composition
     and read as a broken image rather than as a stated absence. */
  .ex-stop__owed {
    display: grid;
    place-items: center;
    width: 100%;
    aspect-ratio: 16 / 10;
