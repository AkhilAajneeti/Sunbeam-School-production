    background: rgba(255, 237, 230, 0.5);
    color: rgba(201, 60, 10, 0.4);
  }
  .ex-stop__owed svg { width: 24%; height: auto; }

  /* ⚠ THE HALO IS LOAD-BEARING, NOT A GLOW. The route runs behind the copy by
     design and no band exists that clears all six interleaved stops; without a
     paper halo the dashes cut through glyphs and read as a strikethrough. Four
     stacked shadows in the section's own background colour erase the line
     around the letterforms, so it passes UNDER the text. Matches --sb-paper,
     the ground this section is painted on — change one and change the other.

     ⚠ THE NUMERALS NEED IT TOO, and chasing that with geometry is a dead end.
     A stop's content height does not scale with `--drop`, so any route band
     expressed as a fraction of either one drifts across the other at some
     width: measured, the wave cleared the lower numerals at 1440 and clipped
     them at 1024. The halo is width-independent, which the geometry cannot be.
     Photographs are left crossed on purpose — a 1px dashed line at 34% over a
     photograph already reads as behind it; over a glyph it reads as a strike. */
  .ex-stop__n,
  .ex-stop__k,
  .ex-stop__b {
    text-shadow:
