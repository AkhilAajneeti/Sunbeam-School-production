---
/**
 * TEACHING & LEARNING · EXPERIENTIAL & PROJECT-BASED LEARNING — four sections.
 *
 * ⚠ COMBINED PAGE — two of the brief's fourteen bullets: Experiential Learning
 * and Project-Based Learning. The standalone /project-based-learning/ route was
 * an implementation experiment; its verified content is merged here.
 *
 * ═══ SOURCE — every claim, and where it comes from ═════════════════════════
 *   The school's own framing: a topic "met in the hand before it is met in the
 *     exam".
 *   CBSE Capacity Building Programme on Experiential Learning — hosted at
 *     Ballia, 20–21 September 2025, two days, taken by two visiting principals.
 *   Little Agriculture Land — "a planting plot the youngest children actually
 *     dig, sow and water", published as the Little Agriculturists activity.
 *   Gallery Walks, the school's own words — "students confidently presented
 *     their projects, charts, and models, turning the classroom into a mini
 *     exhibition hall" (Class IV, Science).
 *   Stargazing Activity, the school's own words — "a breathtaking view of the
 *     Moon through a telescope — a first-time experience for many".
 *   Taramandal — a planetarium show, published in eleven photographs.
 *   Impetus — the activity programme for Classes III–V, including the Indian
 *     Folk Painting competition and a Canva presentation session.
 *   KIDS Entrepreneurship — "a Class 7 programme that runs a real venture end
 *     to end."
 *   Monash University, Australia — students travelled to Delhi for an
 *     international innovation project on entrepreneurship, at K.R. Mangalam
 *     World School, G.K-II.
 *
 * ⚠⚠ CHANDRAYAAN-3 AND A "SCIENCE & MATHEMATICS EXHIBITION" ARE NOT ON THIS
 * PAGE, AND THAT IS DELIBERATE. Both were offered in the brief. Neither appears
 * on the school's site or in this repository — the finding is recorded in
 * components/academics/ExperientialPage.astro and is the most recent judgement
 * in the repo (19 Aug), newer than the list in PhilosophyStory.astro (13 Aug)
 * that still carries them. "Living Newspaper" is in that same older list with no
 * source note and no photography, so it is out for the same reason. Four
 * sourced activities beat six where two cannot be checked.
 *
 * ⚠ NOT CLAIMED: what KIDS runs week to week, how many students went to Delhi,
 * or where the planetarium show was held. None is published, and no photography
 * of KIDS in progress exists.
 *
 * ⚠ SCOPE BOUNDARY — the national science programmes (VVM, NCSC, Inspire MANAK)
 * belong to STEM, Robotics & Enrichment; the laboratory inventory belongs to
 * Laboratories & Academic Clubs; the smart-classroom and computer-lab counts
 * belong to Smart Classrooms & Digital Literacy. This page is about work that
 * produces an object, a venture or a plot.
 *
 * ═══ COMPOSITION — four sections, four different builds ════════════════════
 *   01 · SAND   the claim, and the two-day fact that tests it. Photo cluster
 *               right, ghost "DO" behind it.
 *   02 · PAPER  THE PATH — a drawn curve with five photographed stops alternating
 *               above and below it, and a sixth terminal node with no photograph
 *               because none exists. Every stop opens the shared Lightbox, so
 *               the five are one viewer set with prev/next and keyboard nav.
 *   03 · IVORY  the projects that left the building — a documentary stack, each
 *               frame captioned with what it actually shows.
 *   04 · PHOTO  the dark close.
 *
 * ⚠ THE STATS BAND FROM THE REFERENCE ART IS NOT HERE. It carried 30+ smart
 * classes, 49+ panels and the two computer labs — which is Smart Classrooms &
 * Digital Literacy's content, on a page about digging a plot, and its first
 * figure contradicts the 75+ that three data files publish. The brief also asked
 * for four sections. Both reasons point the same way.
 *
 * MOTION is the project's own attribute set — data-clip, data-reveal, data-pop,
 * data-drift, data-parallax, data-draw, data-mask, data-zoom.
 */
import Lightbox from '../../ui/Lightbox.astro';

/* ── PHOTOGRAPHY — every frame is a genuine Sunbeam Ballia photograph, and each
   alt says what is IN it rather than what the section is about. */
import { getAcademicTopic } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const ac = await getAcademicTopic('/academics/teaching-learning/experiential-learning/');
const pCompost = ac.pic('pCompost');
const pOwnWork = ac.pic('pOwnWork');
const pCanva = ac.pic('pCanva');
const pMonash = ac.pic('pMonash');
const pChef = ac.pic('pChef');
const pThread = ac.pic('pThread');
const pCohort = ac.pic('pCohort');

const S = 'Sunbeam School Ballia';

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. */
const MARK: Record<string, string> = {
  hand: `<path d="M9.4 11.2V6a1.9 1.9 0 1 1 3.8 0v7.4"/><path d="M13.2 10.4a1.7 1.7 0 0 1 3.4 0v1M16.6 11.6a1.7 1.7 0 0 1 3.4 0v3.2a6 6 0 0 1-6 6h-1.6c-2 0-3-1-4.2-2.4l-3-3.6a1.8 1.8 0 0 1 2.6-2.4l1.6 1.6"/>`,
  build: `<path d="M12 3.4 4.6 7.2v9.6L12 20.6l7.4-3.8V7.2z"/><path d="M4.6 7.2 12 11l7.4-3.8M12 11v9.6"/>`,
  seed: `<path d="M20 4.6c.8 6.2-2.6 10.6-7.6 11.2-2.9.3-5.2-1-5.7-3.3-.6-2.7 1.3-4.9 4.4-5.5"/><path d="M4.4 20.4c1.5-4.4 5-8.2 9.4-10.4"/>`,
  eye: `<path d="M2.4 12S6 5.6 12 5.6 21.6 12 21.6 12 18 18.4 12 18.4 2.4 12 2.4 12Z"/><circle cx="12" cy="12" r="2.9"/>`,
  spark: `<path d="M12 1.8c.7 5.2 4.2 8.7 9.4 9.4-5.2.7-8.7 4.2-9.4 9.4-.7-5.2-4.2-8.7-9.4-9.4 5.2-.7 8.7-4.2 9.4-9.4z"/>`,
};

/* ── THE PATH ───────────────────────────────────────────────────────────────
   ⚠ FIVE PHOTOGRAPHED STOPS AND ONE THAT IS NOT. Every `body` is the school's
   own account; `alt` describes the photograph itself, which is not always the
   same thing — a stop about Gallery Walks captioned "students at their desks
   with their own drawings" is honest, a stop captioned "a gallery walk" would
   not be. `owed: true` marks the stop with no photograph rather than borrowing
   one from another activity. */
const stops = ac.section('stops').points;

/* The three design labels on the dark close. */
const beats = ac.section('beats').points;
---

{/* ══ 01 · IN THE HAND BEFORE THE EXAM ═══════════════════════════════════════
    Ground: sand. Idea: the claim every school makes, and the one dated fact that
    tests it — set against a photo cluster and a ghost "DO". */}
<section class="ex-open" aria-labelledby="ex-open-t">
  <span class="ex-open__warm" aria-hidden="true"></span>
  <span class="ex-grid" aria-hidden="true"></span>
  <span class="ex-open__ghost" aria-hidden="true" data-parallax data-parallax-y="26">Do</span>

  <div class="u-container ex-open__grid">
    <div class="ex-open__copy">
      <p class="ex-kicker" data-reveal>The claim, and the test of it</p>
      <h2 class="ex-h ex-open__h" id="ex-open-t">
        <span data-clip data-clip-delay="0">In the hand</span>
        <span data-clip data-clip-delay="150"><em>before the exam.</em></span>
      </h2>
      <p class="ex-body" data-reveal data-reveal-delay="200">
        Sunbeam’s stated approach is that a topic is <strong>met in the hand before it is met in
        the exam</strong>. Every school says something like it, so the only useful question is
        what a reader can check.
      </p>
      <p class="ex-body" data-reveal data-reveal-delay="270">
        Here the check is unusually strong. In September 2025 the school
        {' '}<strong>hosted the CBSE Capacity Building Programme on Experiential Learning</strong> —
        two days, taken by two visiting principals. Sunbeam Ballia was the venue other schools came
        to. Running experiential learning is a claim; being the place it is taught is a fact with a
        date on it.
      </p>

      <ul class="ex-open__tags">
        <li data-reveal data-reveal-delay="340">
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.hand} /></svg></span>
          Learn by doing
        </li>
        <li data-reveal data-reveal-delay="390">
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.build} /></svg></span>
          Think by making
        </li>
        <li data-reveal data-reveal-delay="440">
          <span aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.seed} /></svg></span>
          Understand for life
        </li>
      </ul>
    </div>

    {/* THE CLUSTER — one large frame, one smaller breaking its corner, one
        circular detail, and a drawn line tying the three together. */}
    <div class="ex-open__media">
      <svg class="ex-open__tie" viewBox="0 0 300 200" fill="none" aria-hidden="true">
        <path d="M14 150c58 34 108 22 150-6 34-22 62-34 122-40" stroke="currentColor"
          stroke-width="1.3" stroke-linecap="round" stroke-dasharray="5 9" />
      </svg>

      <figure class="ex-open__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={pCanva}
          alt={ac.picAlt('pCanva')}
         
          widths={[560, 900, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="ex-open__mid" data-parallax data-parallax-y="26">
        <SmartImage
          file={pOwnWork}
          alt={ac.picAlt('pOwnWork')}
         
          widths={[320, 540]}
          sizes="(max-width: 1023px) 42vw, 19vw"
          loading="lazy"
          decoding="async"
        />
      </figure>

      <figure class="ex-open__disc" data-parallax data-parallax-y="-20">
        <SmartImage
          file={pCompost}
          alt={ac.picAlt('pCompost')}
         
          widths={[260, 420]}
          sizes="(max-width: 1023px) 30vw, 13vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

{/* ══ 02 · EXPERIENCES THAT BECOME LEARNING ══════════════════════════════════
    Ground: paper. Idea: ONE journey, six stops, built to the approved reference
    composition — six columns, alternating high and low, a dashed route weaving
    behind all of it with a numbered node on the route at every stop.

    ⚠ THE TWO ROWS INTERLEAVE, THEY DO NOT STACK. Earlier builds gave the upper
    stops one grid row and the lower stops another, so every upper description
    had to finish before any lower stop could begin and the band grew past
    1100px. Here each stop carries its OWN `--k` offset, so a lower stop starts
    beside the upper one's description rather than under it. Same six items, a
    little over half the height, and the compact editorial rhythm the reference
    has. */}
<section class="ex-path" aria-labelledby="ex-path-t">
  <span class="ex-path__warm" aria-hidden="true"></span>

  {/* Four drawn marks, all subject-specific: a flask over the science end, a
      star over the stargazing end, a seedling under Little Agriculturists, a
      node cluster closing the right edge. */}
  <svg class="ex-deco ex-deco--flask" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round">
      <path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4" />
      <path d="M8.2 14.4h7.6" />
    </g>
  </svg>
  <svg class="ex-deco ex-deco--star" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <path d="m12 2.6 2.9 5.9 6.5.9-4.7 4.6 1.1 6.5L12 17.4l-5.8 3.1 1.1-6.5-4.7-4.6 6.5-.9z"
      stroke="currentColor" stroke-width="1.1" stroke-linejoin="round" />
  </svg>
  <svg class="ex-deco ex-deco--seed" viewBox="0 0 60 70" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round">
      <path d="M30 66V26" />
      <path d="M30 40c-11 0-17-7-17-16 10 0 17 6 17 16z" />
      <path d="M30 32c9 0 15-6 15-14-9 0-15 5-15 14z" />
      <circle cx="12" cy="12" r="2.2" />
      <circle cx="49" cy="19" r="1.6" />
    </g>
  </svg>
  <svg class="ex-deco ex-deco--nodes" viewBox="0 0 80 60" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M2 30h22a8 8 0 0 0 8-8v-8a8 8 0 0 1 8-8h38" />
      <path d="M2 44h34a8 8 0 0 1 8 8v6" />
    </g>
    <circle cx="78" cy="6" r="2.6" fill="currentColor" />
    <circle cx="44" cy="58" r="2.6" fill="currentColor" />
  </svg>

  <div class="u-container">
    <h2 class="ex-kicker ex-path__eyebrow" id="ex-path-t" data-reveal>
      Experiences that become learning
    </h2>

    <div class="ex-path__scroller">
      <div class="ex-path__stage">
        {/* ⚠ TWO PATHS ON ONE GEOMETRY. The dashed one is the route and is
            always painted; the solid one is the same shape drawn on scroll via
            stroke-dashoffset, so the journey travels as the reader does. With
            no JavaScript the route still reads — only the travelling line is
            missing, which is the right thing to lose. `pathLength="1"` lets the
            script work in fractions and never measure the DOM.

            ⚠ THE CROSSINGS ARE CALCULATED. The wave returns to the node band
            (y = 189 of 460, i.e. 41%) at x = 183, 383, 583 … — the middle of the
            gutter to the RIGHT of each stop, which is where the badges sit and
            where the reference puts them. Anchored to a column’s LEFT edge they
            landed on top of that stop’s own title. */}
        <svg class="ex-path__curve" viewBox="0 0 1200 460" fill="none"
          preserveAspectRatio="none" aria-hidden="true">
          <path class="ex-path__route"
            d="M-320 256 C-190 256 -40 242 100 242 C180 242 220 212 300 212 C380 212 420 242 500 242 C580 242 620 212 700 212 C780 212 820 242 900 242 C980 242 1020 212 1100 212 C1220 212 1360 238 1520 254"
            stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="7 11" />
          <path class="ex-path__draw" pathLength="1"
            d="M-320 256 C-190 256 -40 242 100 242 C180 242 220 212 300 212 C380 212 420 242 500 242 C580 242 620 212 700 212 C780 212 820 242 900 242 C980 242 1020 212 1100 212 C1220 212 1360 238 1520 254"
            stroke="currentColor" stroke-width="1.7" stroke-linecap="round" />
        </svg>

        {/* ⚠ THE NODES ARE THEIR OWN LAYER, not children of the stops. A badge
            inside a stop would be positioned against that stop's box, and the
            stops sit at six different heights — the route's nodes all belong on
            one band. Placed in percentages of the stage so they land on the
            curve's crossings at every width. */}
        <span class="ex-path__nodes" aria-hidden="true">
          {stops.map((s, i) => (
            <i class="t-tabular" style={`--n: ${i}; --ny: ${i % 2 === 0 ? '52.56%' : '46.09%'};`}
              data-pop data-pop-delay={i * 90}>{s.n}</i>
          ))}
        </span>

        <ol class="ex-path__list">
          {stops.map((s, i) => (
            <li class={`ex-stop ex-stop--${i % 2 === 0 ? 'up' : 'down'}${s.owed ? ' ex-stop--owed' : ''}`}
              style={`--c: ${i + 1}; --k: ${[0, 0.96, 0.04, 1, 0.02, 0.94][i]};`}>
              <p class="ex-stop__n t-tabular" data-pop data-pop-delay={i * 90}>{s.n}</p>

              {s.photo ? (
                <a class="ex-stop__shot" href={s.photo.src} data-lb-open
                  data-lb-alt={s.alt} data-lb-cap={s.k} data-drift="26">
                  <SmartImage
                    file={s.photo}
                    alt={s.alt}
                    sizes="(max-width: 767px) 40vw, 16vw"
                    fallbackWidth={1100}
                    loading="lazy"
                  />
                  <span class="ex-stop__zoom" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none">
                      <circle cx="10.6" cy="10.6" r="6.4" stroke="currentColor" stroke-width="1.7" />
                      <path d="M15.4 15.4 20.4 20.4M10.6 8v5.2M8 10.6h5.2" stroke="currentColor"
                        stroke-width="1.7" stroke-linecap="round" />
                    </svg>
                  </span>
                </a>
              ) : (
                <span class="ex-stop__owed" aria-hidden="true" data-drift="26">
                  <svg viewBox="0 0 24 24" fill="none">
                    <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3.4" y="5.6" width="17.2" height="13.2" rx="2" />
                      <path d="M3.4 15.2 8.6 10l4.4 4.2 3-2.6 4.6 4" />
                      <circle cx="9" cy="9.6" r="1.4" />
                    </g>
                  </svg>
                </span>
              )}

              <h3 class="ex-stop__k" data-reveal data-reveal-delay={120 + i * 60}>{s.k}</h3>
              <p class="ex-stop__b" data-reveal data-reveal-delay={200 + i * 60}>{s.body}</p>
              {s.owed && <p class="ex-stop__flag">No photography published</p>}
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  /* THE ROUTE DRAWS ITSELF as the section travels through the viewport.

     ⚠ DECORATION ONLY. The dashed route underneath is always painted, so with
     this script absent the reader loses the travelling line and nothing else —
     which is what makes it safe for the drawn path to start at zero length.
     `pathLength="1"` normalises the geometry, so nothing has to measure the DOM
     and the maths cannot drift when the curve is edited. */
  const exStage = document.querySelector('.ex-path');
  const exRoute = document.querySelector('.ex-path__draw');

  if (exStage instanceof HTMLElement && exRoute instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = exStage.getBoundingClientRect();
      /* Starts when the section's top passes 85% of the viewport and finishes
         once it has travelled three quarters of its own height past that. */
      const travelled = window.innerHeight * 0.85 - r.top;
      const p = Math.min(1, Math.max(0, travelled / (r.height * 0.75)));
      exRoute.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>

{/* ══ 03 · PROJECTS LEAVE THE CLASSROOM ══════════════════════════════════════
    Ground: ivory. Idea: the two endpoints that are worth more than any
    description of the method — told as a documentary stack, each frame
    captioned with what it actually shows. */}
<section class="ex-proj" aria-labelledby="ex-proj-t">
  <span class="ex-proj__warm" aria-hidden="true"></span>
  <span class="ex-dots" aria-hidden="true"></span>

  <div class="u-container ex-proj__grid">
    <div class="ex-proj__copy">
      <p class="ex-kicker" data-reveal>Projects leave the classroom</p>
      <h2 class="ex-h ex-proj__h" id="ex-proj-t">
        <span data-clip data-clip-delay="0">From making</span>
        <span data-clip data-clip-delay="150">to <em>understanding.</em></span>
      </h2>
      <p class="ex-body" data-reveal data-reveal-delay="200">
        Project work here has two published endpoints, and both are worth more than any account of
        the method.
      </p>
      <p class="ex-body" data-reveal data-reveal-delay="270">
        The first is <strong>KIDS Entrepreneurship</strong>, and the school’s description of it is
        six words long: <em>“a Class 7 programme that runs a real venture end to end.”</em> Not a
        simulation and not a case study — a venture, carried from start to finish by
        twelve-year-olds.
      </p>
      <p class="ex-body" data-reveal data-reveal-delay="340">
        The second left the state. Students travelled to Delhi for an
        {' '}<strong>international innovation project on entrepreneurship run with Monash
        University, Australia</strong>, held at K.R. Mangalam World School, G.K-II. A project
        judged outside the building is judged by people who owe the school nothing.
      </p>
      <p class="ex-body ex-proj__pt" data-reveal data-reveal-delay="410">
        Neither is an extra activity bolted onto the timetable. They are how the school says it
        teaches.
      </p>
    </div>

    <div class="ex-proj__stack">
      <figure class="ex-proj__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={pMonash}
          alt={ac.picAlt('pMonash')}
         
          widths={[480, 800, 1100]}
          sizes="(max-width: 1023px) 84vw, 34vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>The Monash University innovation session — the project that left the state.</figcaption>
      </figure>

      <figure class="ex-proj__side" data-parallax data-parallax-y="-30">
        <SmartImage
          file={pChef}
          alt={ac.picAlt('pChef')}
         
          widths={[340, 560]}
          sizes="(max-width: 1023px) 44vw, 20vw"
          loading="lazy"
          decoding="async"
        />
        <figcaption>One demonstration table, and no version of the task that can be done alone.</figcaption>
      </figure>

      <figure class="ex-proj__disc" data-parallax data-parallax-y="22">
        <SmartImage
          file={pThread}
          alt={ac.picAlt('pThread')}
         
          widths={[240, 400]}
          sizes="(max-width: 1023px) 28vw, 12vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

{/* ══ 04 · THE SCHOOL IN PRACTICE ════════════════════════════════════════════ */}
<section class="ex-close" aria-labelledby="ex-close-t">
  <div class="ex-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <SmartImage
      file={pCohort}
      alt={ac.picAlt('pCohort')}
     
      widths={[1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <span class="ex-close__scrim" aria-hidden="true"></span>
  <span class="ex-close__glow" aria-hidden="true"></span>

  <div class="u-container ex-close__inner">
    <p class="ex-kicker ex-kicker--dark" data-reveal>Experiential learning in practice</p>
    <h2 class="ex-h ex-close__h" id="ex-close-t">
      <span data-clip data-clip-delay="0">See it. Make it.</span>
      <span data-clip data-clip-delay="150"><em>Understand it.</em></span>
    </h2>
    <p class="ex-close__b" data-reveal data-reveal-delay="180">
      The school publishes the plot, the programme, the Monash project and the CBSE programme it
      hosted. What KIDS runs week to week, how many students travelled to Delhi, and where the
      planetarium show was held are not published — so none of those is described here.
    </p>

    {/* ⚠ DESIGN LABELS, NOT A QUOTED FRAMEWORK. The school does not publish a
        three-step model, so these are set as marks rather than as its words. */}
    <ul class="ex-close__beats">
      {beats.map((b, i) => (
        <li data-reveal data-reveal-delay={260 + i * 90}>
          <span aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[b.mark]} />
            </svg>
          </span>
          {b.k}
        </li>
      ))}
    </ul>
  </div>
</section>

