  .ex-path__eyebrow {
    text-align: center;
    font-family: inherit;
  }

  /* The four drawn marks. All outline, all low contrast, each placed against
     what it belongs to rather than dropped in a corner. */
  .ex-deco {
    position: absolute;
    z-index: 0;
    height: auto;
    /* ⚠ VISIBLE, NOT CLIPPED. The SVG box is the content column; with the
       default `hidden` the route began and ended ON the column edges instead of
       arriving from off-page and leaving the same way, which left two stub ends
       in mid-air. The path is drawn from x = -320 to 1520 in a 1200 viewBox, so
       it clears the widest margin the container ever has. */
    overflow: visible;
    color: rgba(201, 60, 10, 0.34);
    pointer-events: none;
  }
  .ex-deco--flask { top: 30%; left: 27%; width: clamp(20px, 2.2vw, 32px); }
  .ex-deco--star { top: 24%; right: 5%; width: clamp(20px, 2.2vw, 32px); }
  .ex-deco--seed { bottom: 6%; left: 2%; width: clamp(34px, 4vw, 58px); opacity: 0.8; }
  /* ⚠ BELOW THE ROUTE BAND, NOT ON IT. At 34% it sat in the route’s own band
     immediately after the last node and read as the line carrying on. */
  .ex-deco--nodes { bottom: 10%; right: 2%; width: clamp(48px, 6vw, 86px); opacity: 0.6; }

  .ex-path__scroller { margin-top: clamp(16px, 2vw, 28px); }

  /* ⚠ THE STAGE IS THE POSITIONING CONTEXT FOR ALL THREE LAYERS — the route,
     the node band and the stops — so all three are measured against the same
     box and cannot drift apart. */
  .ex-path__stage {
    /* One drop distance, and every stop's offset is a multiple of it. Changing
       the rhythm is one number, not six. */
    --drop: clamp(214px, 22.2vw, 320px);
    position: relative;
  }

  .ex-path__curve {
    position: absolute;
    z-index: 0;
    inset: 0;
    width: 100%;
    height: 100%;
    color: rgba(201, 60, 10, 0.34);
    pointer-events: none;
  }
  /* The travelling line, drawn over the dashed route. Starts at zero length and
     is advanced by the scroll handler; brighter and a touch heavier than the
     route so the drawn part reads as progress rather than as a second line. */
  .ex-path__draw {
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
    color: var(--sb-orange-bright);
    opacity: 0.6;
  }

  /* ⚠ THE NODE BAND. `top: 38%` is not a guess — it is y = 189 of the curve's
     460-unit viewBox, and each badge's `left` is the same 33 + n × 200 the wave
     returns to. Both are percentages of the same stage, so a badge sits on its
     crossing at every width. */
  .ex-path__nodes {
    position: absolute;
    z-index: 2;
    inset: 0;
    pointer-events: none;
  }
  .ex-path__nodes i {
    position: absolute;
    top: 0;
    left: calc((var(--n) + 0.5) * 16.6667%);
    top: var(--ny);
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: clamp(22px, 2vw, 28px);
    aspect-ratio: 1 / 1;
    border: 1.4px solid var(--sb-orange-bright);
    border-radius: 50%;
    background: var(--sb-paper);
    font-size: clamp(8.5px, 0.64vw, 10px);
    font-weight: 700;
    font-style: normal;
    color: var(--sb-violet);
    animation: ex-pulse 4.5s ease-in-out infinite;
    animation-delay: calc(var(--n) * 0.45s);
  }

  /* ⚠ ONE ROW, SIX COLUMNS, AND THE OFFSET IS A MARGIN. Not two grid rows: with
     rows, an upper stop's description had to clear the row before a lower stop
     could start, which is what made the band twice as tall as the reference.
     A margin lets a lower stop begin BESIDE the upper one's text. */
  .ex-path__list {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    align-items: start;
    margin: 0;
    padding: 0;
