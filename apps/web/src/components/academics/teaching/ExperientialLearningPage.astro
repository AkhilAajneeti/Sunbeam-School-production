    grid-column: var(--c);
    margin-top: calc(var(--drop) * var(--k));
    padding-right: clamp(16px, 2.7vw, 38px);
    display: grid;
    justify-items: start;
    align-content: start;
    gap: clamp(4px, 0.5vw, 7px);
  }

  /* The item's own numeral — display scale, orange, above its photograph. */
  .ex-stop__n {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(18px, 1.9vw, 28px);
    font-weight: 700;
