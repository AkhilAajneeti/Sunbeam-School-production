  /* A white mount, as the reference frames every photograph — which is what
     lifts the stops off the cream and lets the route pass behind them. */
  .ex-stop__shot {
    position: relative;
    display: block;
    width: 100%;
    padding: clamp(4px, 0.45vw, 6px);
