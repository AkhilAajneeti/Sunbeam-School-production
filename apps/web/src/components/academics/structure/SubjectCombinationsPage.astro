    line-height: 1;
    color: color-mix(in srgb, var(--t) 58%, #fff);
  }
  .sc-world__k {
    font-family: var(--sb-font-display);
    font-size: clamp(20px, 1.9vw, 28px);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    color: var(--sb-charcoal);
