    opacity: var(--o);
    animation: sc-twinkle 8s ease-in-out infinite;
  }
  .sc-map__spark i:nth-child(2n) { animation-duration: 11s; animation-delay: -3s; }

  .sc-map__ghost {
    position: absolute;
    z-index: -2;
    font-family: var(--sb-font-display);
    font-size: clamp(38px, 6.4vw, 104px);
    font-weight: 700;
    letter-spacing: -0.045em;
    line-height: 0.9;
    text-transform: uppercase;
    white-space: nowrap;
    color: rgba(255, 138, 92, 0.075);
    user-select: none;
    pointer-events: none;
  }
  /* ⚠ THE TOP PAIR SITS ABOVE THE COPY, NOT BEHIND IT. At 34% the PCM ghost
     landed across the eyebrow — an ornament over text, which this project
     checks for. Both top ghosts now clear the heading block entirely. */
  .sc-map__ghost--tl { top: 5%; left: calc(var(--sb-margin) * -0.6); }
  .sc-map__ghost--tr { top: 5%; right: calc(var(--sb-margin) * -0.6); }
  .sc-map__ghost--bl { bottom: 5%; left: calc(var(--sb-margin) * -0.6); }
  .sc-map__ghost--br { bottom: 5%; right: calc(var(--sb-margin) * -0.6); }

  /* ⚠ COPY BESIDE THE DIAGRAM, NOT ABOVE IT. Stacked, the diagram loses the
     width its circles need and the band grows a third taller. */
  .sc-map__grid-l {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(26px, 3.6vw, 60px);
    align-items: center;
  }
  /* Sized so "Four ways of thinking." sets on ONE line beside the diagram. */
  :global(.sc-map__h) { font-size: clamp(26px, 3.05vw, 43px); color: #fff; }
  :global(.sc-map__h em) { color: var(--sb-lime); font-style: italic; }
  :global(.sc-map__b) { color: var(--sb-on-dark-78); max-width: 40ch; }

  .sc-plan { position: relative; }
  :global(.sc-plan__era) {
    margin: 0 0 clamp(12px, 1.6vw, 22px);
    text-align: center;
    font-size: clamp(10px, 0.76vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.28em;
    text-transform: uppercase;
    color: var(--sb-lime);
  }

  /* THE FOUR CIRCLES. A NEGATIVE GAP is the whole device: the discs overlap so
     the four read as one field with a shared centre rather than as four tiles,
     and the glowing node sits exactly where they meet. */
  /* ⚠ NEGATIVE MARGINS, NOT A NEGATIVE GAP. `gap` cannot go below zero, so the
     overlap is made by letting each disc bleed 11% of the grid's width toward
     the centre — which also keeps every disc a perfect circle, because the
     aspect-ratio still resolves against its own (now wider) box. */
  /* ⚠ SIZED SO THE WHOLE BAND FITS ONE SCREEN. At 44vw the cluster alone ran
     460px tall and the section cleared 790px — taller than the content area of
     a 1366 × 768 laptop, so the reader never saw the four together, which is
     the only thing this section is for. */
  .sc-orbits {
    --lap: 11%;
    position: relative;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
