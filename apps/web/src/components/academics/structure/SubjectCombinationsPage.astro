---
/**
 * ACADEMIC STRUCTURE · SUBJECT COMBINATIONS — the four sections below the banner.
 *
 * ═══ WHAT IS VERIFIED, AND WHAT IS NOT ═════════════════════════════════════
 * Every subject list on this page is read from `streamDetail` in
 * data/academics.ts — the same four objects Combinations.astro renders on
 * /academics/structure/, so the two pages cannot drift apart. That file records
 * the confidence of each list, and exactly one thing on it is still owed:
 *
 *   · CORE, PCM and PCB — definitional. The abbreviation IS the subject list,
 *     and English is compulsory in CBSE Classes XI–XII.
 *   · CORE, Commerce — the CBSE commerce structure, standard almost everywhere
 *     it is taught. The school has not published a core of its own.
 *   · CORE, Humanities — `coreUnverified: true`. INDICATIVE, not confirmed.
 *   · OPTIONAL and ADDITIONAL, all four streams — `unverified: false`. The
 *     school supplied these lists; they are its own.
 *
 * ⚠ THE "TO BE CONFIRMED" STAMPS WERE REMOVED AT THE CLIENT'S INSTRUCTION, and
 * with them the confidence ladder that used to be section 04. THE CAVEAT ITSELF
 * SURVIVES, in full, as the note under the panel grid: "The Humanities core
 * above is indicative and awaiting confirmation from the school. Every other
 * subject list on this page is the school's own." That sentence is the page's
 * whole remaining guard against publishing an unconfirmed combination as fact —
 * it is wired to nothing, so nothing will restore it if it is deleted. Leave it.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · CREAM — the opening statement, one large photograph with a smaller
 *        crop breaking its corner. Never two equal images.
 *   02 · CREAM, CONTINUOUS — the four subject worlds. Same ground as 01 on
 *        purpose: one cream field runs from the banner to the dark band, and a
 *        seam between them reads as two pages.
 *   03 · INK   — the four as four OVERLAPPING CIRCLES, not boxes. Copy sits
 *        beside the diagram rather than above it. The page's ONE dark band.
 *   04 · CREAM — a light close, with the checked-document mark as its picture.
 *
 * ⚠ THE CLOSE IS LIGHT, NOT A PHOTOGRAPH. It was a full-bleed dark plate under
 * the dark map, which flattened the contrast the map was carrying. It now holds
 * the wash, grid, hairlines, arcs and illustration the removed section 04 had,
 * so the page lost a band and not its texture.
 *
 * ⚠ THE FOUR PANELS CARRY NO PHOTOGRAPHS. Each is a typographic world: number
 * and name on one line, a line on what the stream is for, the core as a stacked
 * list with a mark each, the optional and additional lists as chips, and the
 * stream's own mark set large in a soft disc with a ghost of it bleeding off the
 * corner behind.
 *
 * ⚠ EVERY SECTION IS `overflow: hidden`. The ghost words, the drawn rules and
 * the inset photograph all run off their section by design.
 *
 * ⚠ THE ACCENTS ARE THE SECTION'S OWN. --as-blue, --as-teal and --as-indigo are
 * declared on pages/academics/structure.astro and already carry PCM, PCB and
 * Commerce on Combinations.astro; every value is measured AA against white.
 * HUMANITIES IS THE ONE DEPARTURE: that file gives it --as-violet, which fights
 * the peach ground its panel takes, so it uses --sb-urgent (#8a4b00, 7.0:1).
 *
 * MOTION is the project's own attribute set — data-clip, data-reveal, data-pop,
 * data-drift, data-parallax, data-draw, data-mask, data-zoom. With the motion
 * chunk absent every section is complete and readable.
 */
import { Image } from 'astro:assets';
import SmartImage from '../../../components/ui/SmartImage.astro';
import { getSchool } from '../../../lib/cms';
/* ⚠ THE SUBJECT LISTS COME FROM THE DATA FILE, NOT FROM THIS PAGE. Same source
   as Combinations.astro on /academics/structure/, so the two can never disagree
   about what the school teaches. */

/* ── PHOTOGRAPHY — three frames, all genuine Sunbeam Ballia. No stock, per
   docs/07, and none of the four subject panels carries one. */

/* Two raster accents, both from the project's hand-drawn set. */
import oBooks from '../../../assets/icons/booksparkel.png';
import oTick from '../../../assets/icons/booktick.png';
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getSubjectCombinations, getAcademicTopic } from '../../../lib/cms';

/**
 * `streams` is the page-level list drawn by both the worlds band and the map;
 * `worlds` is the BAND those cards sit in. They were one word for two things.
 */
const { streams, open, worlds, map, close } = await getSubjectCombinations();
/**
 * ⚠ A SECOND, DIFFERENT PAGE'S RECORD. `streamDetail` and the footnote belong to
 * the Academic Structure hub at /academics/structure/, not to this page, and are
 * read here because this page prints them too. Converting them belongs with that
 * hub, not with this conversion.
 */
const ac1 = await getAcademicTopic('/academics/structure/');
const streamDetail = ac1.section('streamDetail').streams;
const combinationsFootnote = ac1.section('combinationsFootnote').note;

const school = await getSchool();

/**
 * ⚠ WHICH SYMBOL GOES WITH WHICH SUBJECT IS DESIGN, AND IT LIVES HERE.
 * This was stored against the content, which meant an editor adding a subject
 * to a stream had to know the map — and one that was not in it drew nothing.
 * Held here, an unlisted subject falls back to the book rather than vanishing.
 */
const SUBJECT_MARK: Record<string, string> = {
  Physics: 'atom',
  Chemistry: 'flask',
  Mathematics: 'sigma',
  Biology: 'leaf',
  English: 'book',
  Accountancy: 'ledger',
  'Business Studies': 'case',
  Economics: 'bars',
  History: 'column',
  'Political Science': 'scale',
  Geography: 'globe',
};

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. Same
   specification as AcademicGlyph; drawn here because the subject set it needs
   (ledger, briefcase, globe) is not in that file and the whole set has to read
   as one hand. */
const MARK: Record<string, string> = {
  atom: `<circle cx="12" cy="12" r="1.9"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(120 12 12)"/>`,
  flask: `<path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4"/><path d="M8.2 14.4h7.6"/>`,
  sigma: `<path d="M17.4 5.2H6.8l5 6.8-5 6.8h10.6"/><path d="M17.4 5.2V3.6M17.4 18.8v1.6"/>`,
  leaf: `<path d="M19.4 4.6c1 6.9-2.2 11.7-7.5 12.4-3 .4-5.4-1-6-3.4-.7-2.9 1.3-5.3 4.6-6"/><path d="M4.6 20.2c1.6-4.6 5.4-8.6 9.8-10.8"/>`,
  book: `<path d="M12 6.6C10.4 5.1 8 4.6 4 5.1v13c4-.5 6.4 0 8 1.5 1.6-1.5 4-2 8-1.5v-13c-4-.5-6.4 0-8 1.5zM12 6.6v13"/>`,
  ledger: `<rect x="4.6" y="3.4" width="14.8" height="17.2" rx="1.8"/><path d="M8.2 8h7.6M8.2 12h7.6M8.2 16h4.4"/>`,
  case: `<rect x="3" y="7.4" width="18" height="12.2" rx="1.8"/><path d="M8.8 7.4V5.6a1.8 1.8 0 0 1 1.8-1.8h2.8a1.8 1.8 0 0 1 1.8 1.8v1.8"/><path d="M3 12.6h18"/>`,
  bars: `<path d="M3.6 20.2h16.8"/><rect x="5.2" y="12.6" width="3.5" height="5.4" rx=".9"/><rect x="10.3" y="8.2" width="3.5" height="9.8" rx=".9"/><rect x="15.4" y="10.4" width="3.5" height="7.6" rx=".9"/><path d="M4.8 9.2 8.9 5.8l3.6 2.2 6.4-4"/>`,
  globe: `<circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2"/><path d="M12 3.4c2.2 2.4 3.4 5.4 3.4 8.6S14.2 18.2 12 20.6c-2.2-2.4-3.4-5.4-3.4-8.6S9.8 5.8 12 3.4Z"/>`,
  /* A fluted column for History and a balance for Political Science — the two
     marks the Humanities core needs and AcademicGlyph does not carry. */
  column: `<path d="M3.6 20.4h16.8M4.8 8.6h14.4L12 4.2 4.8 8.6z"/><path d="M7.4 8.6v11.8M12 8.6v11.8M16.6 8.6v11.8"/>`,
  scale: `<path d="M12 4.2v16.2M7.2 20.4h9.6"/><path d="m12 6.6-6.6 2.2M12 6.6l6.6 2.2"/><path d="M5.4 8.8 2.9 14a2.6 2.6 0 0 0 5 0zM18.6 8.8 16.1 14a2.6 2.6 0 0 0 5 0z"/>`,
};

/* ── THE FOUR SUBJECT WORLDS ────────────────────────────────────────────────
   ⚠ READ FROM `streamDetail`, NOT RETYPED. These are the same four objects that
   Combinations.astro renders on /academics/structure/, so the two pages cannot
   drift apart — and the `coreUnverified` flag that stamps the Humanities core
   travels with the data rather than being re-decided here.

   `n`, `key` and `mark` are the only things this page adds: a display numeral,
   a CSS hook and which drawing goes with which stream. */

/* Which drawing goes with which subject. Anything unlisted falls back to the
   book — a missing mark, never a broken row. */


/**
 * ⚠ THE COLOUR OF EACH STREAM IS DESIGN, AND IT LIVES HERE.
 * `key` was stored against the editorial text and only ever used as a CSS
 * modifier - `sc-world--${key}` - running pcm, pcb, com, hum in list order. It
 * was never a choice anybody made per stream, and a typo produced a card with
 * no colour at all.
 */
const WORLD_KEYS = ['pcm', 'pcb', 'com', 'hum'];
const keyOf = (i) => WORLD_KEYS[i % WORLD_KEYS.length];


const CONTACT = '/contact-us/';
---

{/* ══ 01 · A STREAM IS MORE THAN A NAME ══════════════════════════════════════
    Ground: cream. Idea: one editorial statement, and an asymmetric pair of
    photographs — one large, one small breaking its corner. */}
<section class="sc-open" aria-labelledby="sc-open-t">
  <span class="sc-open__grid" aria-hidden="true"></span>
  <span class="sc-open__warm" aria-hidden="true"></span>
  <span class="sc-open__ghost" aria-hidden="true" data-parallax data-parallax-y="24">XI — XII</span>
  <span class="sc-open__dots" aria-hidden="true"></span>

  {/* The faint subject symbols — an atom at the left margin, a flask below it.
      Background, not ornament: both sit under the copy at 9% and neither is
      placed beside a heading. */}
  <svg class="sc-open__sym sc-open__sym--a" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="0.7" set:html={MARK.atom} />
  </svg>
  <svg class="sc-open__sym sc-open__sym--b" viewBox="0 0 24 24" fill="none" aria-hidden="true">
    <g stroke="currentColor" stroke-width="0.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.flask} />
  </svg>

  {/* The dashed academic path, curving from the copy up and across behind the
      photographs and off the right edge. */}
  <svg class="sc-open__line" viewBox="0 0 1200 300" fill="none" preserveAspectRatio="none" aria-hidden="true">
    <path d="M-20 250C190 250 262 44 470 44s300 208 520 172" stroke="currentColor"
      stroke-width="1.1" stroke-linecap="round" stroke-dasharray="5 9" />
  </svg>

  <div class="u-container sc-open__grid-l">
    <div class="sc-open__copy">
      <p class="sc-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="sc-h sc-open__h" id="sc-open-t" text={open.heading} />
      <RichLine class="sc-body" text={open.body[0]} reveal revealDelay={200} />
    </div>

    {/* ONE LARGE FRAME, ONE SMALLER BREAKING ITS CORNER — not two equal images.
        The inset carries its own paper border so it reads as a print laid over
        the first rather than a hole cut in it. */}
    <div class="sc-open__media">
      <Image class="sc-open__books" src={oBooks} alt="" width={160} aria-hidden="true" loading="lazy" />

      <figure class="sc-open__lead" data-mask data-zoom data-zoom-to="1.06">
        <SmartImage
          file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''}
         
          widths={[620, 980]}
          sizes="(max-width: 1023px) 92vw, 40vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
      <figure class="sc-open__inset" data-parallax data-parallax-y="22">
        <SmartImage
          file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 22vw"
          loading="lazy"
          decoding="async"
        />
      </figure>
    </div>
  </div>
</section>

{/* ══ 02 · THE FOUR SUBJECT WORLDS ═══════════════════════════════════════════
    ⚠ SAME CREAM GROUND AS 01, DELIBERATELY. One continuous field runs from the
    banner to the dark band; a change of ground here would read as two pages. */}
<section class="sc-worlds" aria-labelledby="sc-worlds-t">
  <span class="sc-worlds__wash" aria-hidden="true"></span>
  <span class="sc-worlds__dots" aria-hidden="true"></span>

  <div class="u-container">
    <div class="sc-worlds__head">
      <p class="sc-kicker" data-reveal>{worlds.kicker}</p>
      <ClipHeading class="sc-h sc-worlds__h" id="sc-worlds-t" text={worlds.heading} />
      <RichLine class="sc-body sc-worlds__b" text={worlds.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="sc-worlds__grid">
      {streams.map((w, i) => (
        <li class={`sc-world sc-world--${keyOf(i)}`} data-pop data-pop-delay={80 + i * 90}>
          {/* The ghost of the panel's own mark, bled off its corner. */}
          <svg class="sc-world__ghost" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[w.mark]} />
          </svg>

          <div class="sc-world__t">
            {/* NUMBER AND NAME ON ONE LINE, as the reference sets them — the
                numeral is a marker beside the title, not a heading above it. */}
            <p class="sc-world__top">
              <span class="sc-world__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="sc-world__k">{w.label}</span>
            </p>

            <p class="sc-world__b">{w.value}</p>

            {/* CORE AND OPTIONAL SIDE BY SIDE, ADDITIONAL BENEATH — the shape
                /academics/structure/ already uses for the same four lists. */}
            <div class="sc-world__pair">
              <div class="sc-set">
                {/* ⚠ NO "TO BE CONFIRMED" STAMP HERE — removed at the client's
                    instruction. The caveat it carried has NOT been dropped: the
                    note under the grid still says in full that the Humanities
                    core is indicative and awaiting the school, and that every
                    other list on the page is the school's own. */}
                <p class="sc-set__l">Core subjects</p>
                <ul class="sc-world__subs">
                  {w.core.map((s) => (
                    <li class="sc-sub">
                      <span class="sc-sub__i" aria-hidden="true">
                        <svg viewBox="0 0 24 24" fill="none">
                          <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"
                            set:html={MARK[SUBJECT_MARK[s] ?? 'book']} />
                        </svg>
                      </span>
                      <span class="sc-sub__k">{s}</span>
                    </li>
                  ))}
                </ul>
              </div>

              <div class="sc-set">
                <p class="sc-set__l">Optional subjects</p>
                <ul class="sc-chips">
                  {w.optional.map((e) => <li class="sc-chip">{e}</li>)}
                </ul>
              </div>
            </div>

            <div class="sc-set sc-set--wide">
              <p class="sc-set__l">Additional subjects</p>
              <ul class="sc-chips">
                {w.additional.map((e) => <li class="sc-chip sc-chip--add">{e}</li>)}
              </ul>
            </div>

            {/* ⚠ ONE PANEL CARRIES A LINK, AND IT IS THE ONE STILL WAITING ON
                THE SCHOOL. The other three answered on the panel itself. */}
            {w.owed && (
              <p class="sc-world__ask">
                <a href={CONTACT}>Ask the school office <span aria-hidden="true">→</span></a>
              </p>
            )}
          </div>

          {/* The stream's mark, set large in a soft disc — the panel's picture. */}
          <div class="sc-world__disc" aria-hidden="true">
            <span class="sc-world__ring"></span>
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[w.mark]} />
            </svg>
          </div>
        </li>
      ))}
    </ol>

    {/* ⚠ THE TWO NOTES THE LISTS ARE OWED, AND NEITHER IS SET IN SMALL PRINT.
        The first names exactly what is still indicative and, as importantly,
        what is not; the second is the school's own caveat on availability, from
        the same data file as the lists. */}
    <div class="sc-worlds__foot">
      <p class="sc-claim" data-reveal>
        The {school.streams[3]} core above is indicative and awaiting confirmation from the
        school. Every other subject list on this page is the school’s own.
        <svg class="sc-claim__swash" viewBox="0 0 240 12" fill="none" aria-hidden="true" preserveAspectRatio="none">
          <path d="M3 8.4c34-4.6 68-6.4 102-5.5 33 .9 66 4.4 99 6.1" stroke="currentColor"
            stroke-width="3" stroke-linecap="round" />
        </svg>
      </p>
      <p class="sc-note" data-reveal data-reveal-delay="120">{combinationsFootnote}</p>
    </div>
  </div>
</section>

{/* ══ 03 · FOUR WAYS OF THINKING ═════════════════════════════════════════════
    Ground: ink. Idea: the four as OVERLAPPING CIRCLES, with the copy beside the
    diagram rather than above it. The page's single dark band. */}
<section class="sc-map" aria-labelledby="sc-map-t">
  <span class="sc-map__glow" aria-hidden="true"></span>
  <span class="sc-map__mesh" aria-hidden="true"></span>
  <span class="sc-map__grain" aria-hidden="true"></span>
  <span class="sc-map__vig" aria-hidden="true"></span>
  {/* THE SWEEP — three concentric arcs running off the left edge, the largest
      thing on the band and the reason the composition reads as a field rather
      than as a diagram floating on brown. Rings, not an image: they scale with
      the section and cost nothing. */}
  <span class="sc-map__sweep" aria-hidden="true"></span>

  <span class="sc-map__spark" aria-hidden="true">
    <i style="--x: 9%;  --y: 26%; --s: 3px; --o: .5"></i>
    <i style="--x: 16%; --y: 58%; --s: 2px; --o: .3"></i>
    <i style="--x: 27%; --y: 74%; --s: 2px; --o: .34"></i>
    <i style="--x: 35%; --y: 22%; --s: 3px; --o: .42"></i>
    <i style="--x: 44%; --y: 86%; --s: 2px; --o: .3"></i>
    <i style="--x: 52%; --y: 14%; --s: 2px; --o: .34"></i>
    <i style="--x: 63%; --y: 90%; --s: 3px; --o: .4"></i>
    <i style="--x: 69%; --y: 66%; --s: 2px; --o: .32"></i>
    <i style="--x: 78%; --y: 20%; --s: 3px; --o: .46"></i>
    <i style="--x: 91%; --y: 44%; --s: 2px; --o: .3"></i>
  </span>

  {/* THE GHOST NAMES — one to each corner, bleeding off both edges, so the
      circles read as rising out of their own words. */}
  <span class="sc-map__ghost sc-map__ghost--tl" aria-hidden="true" data-parallax data-parallax-y="16">{school.streams[0]}</span>
  <span class="sc-map__ghost sc-map__ghost--tr" aria-hidden="true" data-parallax data-parallax-y="16">{school.streams[1]}</span>
  <span class="sc-map__ghost sc-map__ghost--bl" aria-hidden="true" data-parallax data-parallax-y="-16">{school.streams[2]}</span>
  <span class="sc-map__ghost sc-map__ghost--br" aria-hidden="true" data-parallax data-parallax-y="-16">{school.streams[3]}</span>

  <div class="u-container sc-map__grid-l">
    <div class="sc-map__head">
      <p class="sc-kicker sc-kicker--dark" data-reveal>{map.kicker}</p>
      <ClipHeading class="sc-h sc-map__h" id="sc-map-t" text={map.heading} />
      <RichLine class="sc-body sc-map__b" text={map.body[0]} reveal revealDelay={200} />
    </div>

    <div class="sc-plan">
      <RichLine class="sc-plan__era" text={map.body[1]} reveal />

      {/* ⚠ CIRCLES THAT OVERLAP, NOT CARDS IN A GRID. The negative gap is what
          makes the four read as one field with a shared centre rather than as
          four tiles — and the glowing node sits exactly where they meet. */}
      <div class="sc-orbits">
        {/* The stem dropping from the XI — XII label into the node where the
            four meet. Drawn, not written: it is the only thing on the band that
            says the four belong to one decision. */}
        <span class="sc-orbits__stem" aria-hidden="true"></span>

        {streams.map((o, i) => (
          <article class={`sc-orbit sc-orbit--${keyOf(i)}`} data-drift="24">
            <span class="sc-orbit__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[o.mark]} />
              </svg>
            </span>
            <h3 class="sc-orbit__k">{o.label}</h3>
            {/* The core is shown on all four, unstamped — see the note on the
                Core subjects label in section 02. */}
            <ul class="sc-orbit__subs">
              {o.core.map((s) => <li>{s}</li>)}
            </ul>
          </article>
        ))}
        <span class="sc-orbits__core" aria-hidden="true"></span>
      </div>
    </div>
  </div>
</section>

{/* ══ 04 · THE CLOSE ═════════════════════════════════════════════════════════
    Ground: cream with a lavender-peach wash. Idea: a light close rather than a
    dark one — the dark map above is the page's single accent band, and a second
    dark section directly under it flattened the contrast the map was carrying.

    ⚠ THIS SECTION REPLACES TWO. It took over the atmosphere, the illustration
    and the arcs of the confidence ladder that used to sit between the map and
    the close; the ladder itself is gone at the client's instruction. */}
<section class="sc-close" aria-labelledby="sc-close-t">
  <span class="sc-close__wash" aria-hidden="true"></span>
  <span class="sc-close__grid" aria-hidden="true"></span>
  <span class="sc-close__rules" aria-hidden="true"></span>

  {/* The two dashed arcs that close the page, one to each side. */}
  <svg class="sc-close__arc sc-close__arc--l" viewBox="0 0 260 180" fill="none" aria-hidden="true">
    <path d="M-10 6C92 6 172 68 196 174" stroke="currentColor" stroke-width="1.2"
      stroke-linecap="round" stroke-dasharray="6 10" />
  </svg>
  <svg class="sc-close__arc sc-close__arc--r" viewBox="0 0 260 180" fill="none" aria-hidden="true">
    <path d="M270 6C168 6 88 68 64 174" stroke="currentColor" stroke-width="1.2"
      stroke-linecap="round" stroke-dasharray="6 10" />
  </svg>

  <div class="u-container sc-close__grid-l">
    <div class="sc-close__copy">
      <ClipHeading class="sc-h sc-close__h" id="sc-close-t" text={close.heading} />
      <RichLine class="sc-close__b" text={close.body[0]} reveal revealDelay={180} />
      <p class="sc-close__act" data-reveal data-reveal-delay="260">
        <a class="btn btn--primary" href={CONTACT}>
          Contact school <span aria-hidden="true">→</span>
        </a>
      </p>
