    -webkit-mask-image: radial-gradient(130% 120% at 55% 50%, #000 0%, transparent 82%);
    mask-image: radial-gradient(130% 120% at 55% 50%, #000 0%, transparent 82%);
  }
  /* ⚠ THE SEAM, SOFTENED. Cream meeting the ink footer on a raw edge is what
     made the join read as two unrelated blocks. A hairline of warm shadow in the
     last few pixels reads as the footer sitting ON the section rather than being
     butted against it — and it is a gradient, so there is no visible line. */
  .sc-close::after {
    content: '';
    position: absolute;
    z-index: -1;
    inset: auto 0 0;
