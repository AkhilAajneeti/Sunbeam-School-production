    padding: 0;
    list-style: none;
  }

  .sc-world {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(12px, 1.4vw, 20px);
    /* ⚠ START, NOT CENTRE. Centring the text block put Humanities' shorter copy
       lower than Commerce's, so the two titles in a row no longer lined up. The
       disc still centres itself — that one wants the middle. */
    align-items: start;
    padding: clamp(20px, 2.2vw, 32px);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
  }
  /* ⚠ RADII ARE NOT UNIFORM. Each panel turns a different corner in, which is
     what stops four rounded rectangles reading as a dashboard. */
  .sc-world--pcm { --t: var(--as-blue);   border-radius: clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px) 10px; }
  .sc-world--pcb { --t: var(--as-teal);   border-radius: clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px) 10px clamp(26px, 3vw, 44px); }
  .sc-world--com { --t: var(--as-indigo); border-radius: clamp(26px, 3vw, 44px) 10px clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px); }
  .sc-world--hum { --t: var(--as-amber);  border-radius: 10px clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px) clamp(26px, 3vw, 44px); }

  /* Each panel's own atmosphere, mixed from its accent — never a flat fill. */
  .sc-world::before {
    content: '';
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      radial-gradient(76% 86% at 10% 6%, color-mix(in srgb, var(--t) 15%, transparent) 0%, transparent 72%),
      linear-gradient(158deg, color-mix(in srgb, var(--t) 8%, #fff) 0%, #fff 64%);
  }
  .sc-world__ghost {
    position: absolute;
    z-index: -1;
    right: clamp(-46px, -2vw, -22px);
    bottom: clamp(-40px, -1.8vw, -18px);
    width: clamp(150px, 16vw, 230px);
    height: auto;
    color: color-mix(in srgb, var(--t) 11%, transparent);
    pointer-events: none;
  }

  .sc-world__top {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: clamp(10px, 1.2vw, 16px);
    margin: 0;
  }
  .sc-world__n {
    font-family: var(--sb-font-display);
    font-size: clamp(22px, 2.2vw, 32px);
