  }
  .sc-world__disc svg { position: relative; width: 46%; height: auto; }

  /* ═══ 03 · FOUR WAYS OF THINKING ══════════════════════════════════════════ */
  .sc-map {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: #2a1109;
    /* Tightened with the cluster: the band is meant to be read in one look. */
    padding-block: clamp(40px, 4.4vw, 70px);
  }
  .sc-map__glow {
    position: absolute;
    z-index: -3;
