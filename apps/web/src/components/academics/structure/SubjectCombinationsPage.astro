    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(14px, 1.7vw, 26px);
    margin-top: clamp(16px, 1.9vw, 24px);
  }
  .sc-set--wide { margin-top: clamp(15px, 1.8vw, 22px); }
  .sc-set__l {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 clamp(8px, 1vw, 12px);
    font-size: clamp(9px, 0.68vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  /* THE CORE AS A STACKED LIST, one small tile each — not a chip cloud. A
     vertical list reads as a syllabus; chips read as tags, which is exactly
