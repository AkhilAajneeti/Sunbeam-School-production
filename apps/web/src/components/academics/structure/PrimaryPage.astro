---
/**
 * ACADEMIC STRUCTURE · PRIMARY — Classes I to V, in eight sections.
 *
 * ═══ SOURCE OF TRUTH — every line traces to this repository ════════════════
 *   data/academics.ts
 *     PRECEPT — the CBSE curriculum published class by class, Nursery to XII,
 *       session 2026-27. Primary is five of those documents.
 *     The four teaching commitments, in the school's own words: Student-Centred
 *       Learning · Experiential & Inquiry-Based Learning · Critical Thinking &
 *       Creativity · Curriculum Excellence.
 *     The motto and its three published glosses — Duty, Devotion, Discipline.
 *     Stage body: "Reading, number and the first structured subjects, taught
 *       across smart classrooms and the junior computer lab."
 *   data/newsPages.ts
 *     Class I — Cohort Inter-Branch Attire Speak Competition, "entered by the
 *       school's six-year-olds".
 *     Nursery–Class II — SOF Olympiad.
 *     Classes III–V — SOF Zonal Excellence Award, "with a ₹500 voucher".
 *     Classes III–V — Indian Folk Painting Competition, under Impetus.
 *     Classes III–V — Heritage Week.
 *   data/facilities.ts
 *     Junior Computer Lab, 40+ machines · Nalanda Library, 17,574 books ·
 *     Art Room · Dance Room · fifteen sports · 75+ smart classrooms.
 *   data/career.ts (the school's own recruitment posters, published verbatim)
 *     "Pre-primary and primary teachers: dance teacher, English story teller,
 *      music teacher, and mother teacher with knowledge of all subjects."
 *
 * ⚠⚠ SECTION 02 IS NOT A SUBJECT RAIL, AND THAT IS DELIBERATE.
 * The brief asked for seven Primary subjects — English, Hindi, Mathematics, EVS,
 * Computer Education, Art & Craft, Physical Education. THE SCHOOL PUBLISHES NO
 * PRIMARY SUBJECT LIST. It publishes that a PRECEPT syllabus document exists for
 * every class; it does not publish what is inside one. Printing seven subjects
 * under this school's name would be exactly the fabrication the brief itself
 * forbids two pages earlier ("Do NOT invent subjects").
 *
 * What the school DOES publish about who teaches these years is unusually
 * specific, and better: one mother teacher carrying all subjects, with four
 * named specialist posts alongside her. Section 02 is that, set as the same
 * seven-item hairline rail the reference composition calls for, and the footnote
 * states the absence in one line.
 * ASSET REQUEST: the Primary subject scheme, if the school will publish it.
 *
 * ⚠ SECTION 05 CARRIES THREE VALUES, NOT FIVE. The brief suggested Respect,
 * Responsibility, Integrity, Teamwork, Perseverance. None of the five is
 * published. The school's own values are the three words on its crest, and the
 * glosses beside them are the ones already published on Teaching & Learning.
 *
 * ⚠ NOT CLAIMED ANYWHERE: student numbers, teacher ratios, period allocations,
 * assessment weightings, or the contents of any PRECEPT document.
 *
 * ═══ COMPOSITION — eight sections, eight different builds ═══════════════════
 *   01 · IVORY  copy LEFT, a three-frame collage RIGHT, four commitments as a
 *               hairline strip.
 *   02 · PEACH  one horizontal rail, seven cells, thin vertical rules. No cards.
 *   03 · WHITE  the photograph crosses LEFT, a checked list RIGHT.
 *   04 · CREAM  a four-frame editorial collage LEFT, the published record RIGHT
 *               on hairlines.
 *   05 · WHITE  a single horizontal band — three values, thin rules.
 *   06 · IVORY  copy LEFT, a deliberately unequal 2×2 photo composition RIGHT.
 *   07 · PEACH  a drawn journey rail, four stages.
 *   08 · PHOTO  the cinematic close.
 *
 * MOTION is the project's own attribute set. The journey rail draws with the
 * same scroll-driven stroke-dashoffset the Experiential page uses — decoration
 * over an always-painted dashed route, so nothing is lost if the script fails.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';

/* ── PHOTOGRAPHY — nine genuine Sunbeam Ballia frames, each used ONCE. ────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getPrimaryStage } from '../../../lib/cms';

const { open, rail, appr, act, val, space, jrn, close } = await getPrimaryStage();


const CURRICULUM = '/academics/philosophy/curriculum/';
const FACILITIES = '/campus/facilities-infrastructure/';
const TEACHING = '/academics/teaching-learning/';
const SUCCESS = '/academics/student-success/';

/* ── THE MARKS — 24-unit box, 1.5 stroke, round caps, no fill ─────────────── */
const MARK: Record<string, string> = {
  learner: `<circle cx="12" cy="7.4" r="3.4"/><path d="M4.8 20.6a7.2 7.2 0 0 1 14.4 0"/><path d="M12 3.2v-1.4M18.4 6.4l1-1M4.6 6.4l-1-1"/>`,
  hand: `<path d="M9.4 11.2V6a1.9 1.9 0 1 1 3.8 0v7.4"/><path d="M13.2 10.4a1.7 1.7 0 0 1 3.4 0v1M16.6 11.6a1.7 1.7 0 0 1 3.4 0v3.2a6 6 0 0 1-6 6h-1.6c-2 0-3-1-4.2-2.4l-3-3.6a1.8 1.8 0 0 1 2.6-2.4l1.6 1.6"/>`,
  bulb: `<path d="M9.2 17.6h5.6"/><path d="M10 20.4h4"/><path d="M12 2.8a6.4 6.4 0 0 0-3.6 11.7c.5.4.8 1 .8 1.6h5.6c0-.6.3-1.2.8-1.6A6.4 6.4 0 0 0 12 2.8Z"/>`,
  book: `<path d="M4 4.4h5.2A2.8 2.8 0 0 1 12 7.2v12.4a2.4 2.4 0 0 0-2.4-2.4H4Z"/><path d="M20 4.4h-5.2A2.8 2.8 0 0 0 12 7.2v12.4a2.4 2.4 0 0 1 2.4-2.4H20Z"/>`,
  teacher: `<circle cx="9.4" cy="7" r="3"/><path d="M3.6 20.4a5.8 5.8 0 0 1 11.6 0"/><path d="M16.6 6.2h4.8v6.4h-2.2l-1.4 2-1.2-2Z"/>`,
  speech: `<path d="M20.4 13.4a2.6 2.6 0 0 1-2.6 2.6H9.4l-4.6 3.6v-3.6a2.6 2.6 0 0 1-2.6-2.6V6.6A2.6 2.6 0 0 1 4.8 4h13a2.6 2.6 0 0 1 2.6 2.6Z"/><path d="M7.6 9.6h8.8M7.6 12.4h5.6"/>`,
  music: `<path d="M9.4 18.2V5.4l9.2-1.8v12.6"/><ellipse cx="6.8" cy="18.4" rx="2.6" ry="2.2"/><ellipse cx="16" cy="16.2" rx="2.6" ry="2.2"/>`,
  dance: `<circle cx="13.6" cy="4.6" r="1.9"/><path d="m6.4 20.4 3.6-5 3.2-2.2-1.4-4.6-3.8 2.2-1.4 3"/><path d="m11.8 8.6 3.6-1.2 3 2.6 3 .8"/><path d="m13.4 13.2 1.8 2.8.8 4.4"/>`,
  screen: `<rect x="2.6" y="4.4" width="18.8" height="12.4" rx="1.8"/><path d="M8.4 20.4h7.2M12 16.8v3.6"/>`,
  brush: `<path d="M14.6 4.4a4 4 0 0 1 5.1 5.1l-9.4 9.4-5.1-5.1Z"/><path d="m12.6 6.4 5.1 5.1"/><path d="M5.2 13.8 3.6 20.4l6.6-1.6"/>`,
  ball: `<circle cx="12" cy="12" r="9.2"/><path d="M12 2.8v18.4M2.8 12h18.4"/><path d="M5.4 5.4c3.6 3.6 3.6 9.6 0 13.2M18.6 5.4c-3.6 3.6-3.6 9.6 0 13.2"/>`,
  flask: `<path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4"/><path d="M8.2 14.4h7.6"/>`,
  panel: `<rect x="2.6" y="4" width="18.8" height="13" rx="1.8"/><path d="M6.4 8.2h7.4M6.4 11.4h5"/><path d="M8.6 20.4h6.8"/>`,
  seed: `<path d="M12 20.6v-7.8"/><path d="M12 12.8C12 9.3 9.5 6.8 6 6.8c0 3.5 2.5 6 6 6Z"/><path d="M12 12.8c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z"/>`,
  target: `<circle cx="12" cy="12" r="8.4"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="1.2"/>`,
  cup: `<path d="M7.4 3.6h9.2v5a4.6 4.6 0 0 1-9.2 0Z"/><path d="M7.4 5.4H5a2 2 0 0 0 2 2M16.6 5.4H19a2 2 0 0 1-2 2"/><path d="M12 13.2v4M8.8 20.4h6.4l-.8-3.2H9.6Z"/>`,
  duty: `<path d="M12 2.8 4.6 6v6c0 4.6 3.1 8.2 7.4 9.2 4.3-1 7.4-4.6 7.4-9.2V6z"/><path d="m8.8 12 2.4 2.4 4-4.6"/>`,
  devotion: `<path d="M12 20.4S3.8 15.4 3.8 9.4a4.6 4.6 0 0 1 8.2-2.8 4.6 4.6 0 0 1 8.2 2.8c0 6-8.2 11-8.2 11Z"/>`,
  discipline: `<circle cx="12" cy="12" r="8.6"/><path d="M12 6.8V12l3.4 2"/>`,
};

/* ── SECTION 01 — the four commitments, in the school's own words ──────────
   These are published on Teaching & Learning as the four things every class is
   taught against. The strip carries the school's names for them, shortened only
   where a two-word cell demands it. */

/* ── SECTION 02 — WHO TEACHES THE PRIMARY YEARS ───────────────────────────
   ⚠ NOT A SUBJECT LIST. See the header note. Every cell below is a post the
   school advertises by name, or a room it publishes by name. */

/* ── SECTION 03 — the four commitments again, this time in full ───────────
   The strip in 01 is the headline; this is the school's own sentence for each. */

/* ── SECTION 04 — THE RECORD. Each line names the class that did it. ─────── */

/* ── SECTION 05 — the school's OWN three values, off its own crest ────────
   The words are the school's. The glosses are the ones already published on
   Teaching & Learning, verbatim. */

/* ── SECTION 06 — spaces a primary child actually uses ───────────────────── */

/* ── SECTION 07 — four stages, each anchored to something published ─────── */
---

{/* ══ 01 · FOUNDATION IN ACTION ══════════════════════════════════════════════
    Ground: warm ivory. Copy LEFT, a three-frame collage RIGHT, and the four
    published commitments closing the column as a hairline strip — the brief is
    explicit that they must not become four cards. */}
<section class="pr-open" aria-labelledby="pr-open-t">
  <span class="pr-open__warm" aria-hidden="true"></span>
  <span class="pr-grid" aria-hidden="true"></span>
  <span class="pr-dots pr-open__dots" aria-hidden="true"></span>

  <div class="u-container pr-open__grid">
    <div class="pr-open__copy">
      <p class="pr-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="pr-h pr-open__h" id="pr-open-t" text={open.heading} />

      <RichLine class="pr-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="pr-body" text={open.body[1]} reveal revealDelay={260} />

      <ul class="pr-pillars">
        {open.cells.map((p, i) => (
          <li class="pr-pillar" data-reveal data-reveal-delay={300 + i * 70}>
            <span class="pr-pillar__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[p.mark]} />
              </svg>
            </span>
            <span class="pr-pillar__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="pr-pillar__k">{p.label}</span>
            <span class="pr-pillar__v">{p.value}</span>
          </li>
        ))}
      </ul>
      <RichLine class="pr-note" text={open.body[2]} linkClass="pr-link" reveal revealDelay={600} />
    </div>

    {/* ⚠ THE COLLAGE IS BUILT INSIDE ITS OWN COLUMN. The overhang frame stops at
        the column's right edge and the circle at its left, so the composition
        overlaps without a single pixel of page overflow. */}
    <div class="pr-open__stage">
      <div class="pr-open__lead" data-mask>
        <SmartImage
          file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pr-open__sm" data-pop data-pop-delay="180">
        <SmartImage
          file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pr-open__cir" data-pop data-pop-delay="300">
        <SmartImage
          file={open.shots[2]?.image} alt={open.shots[2]?.alt ?? ''}
         
          widths={[220, 400]}
          sizes="(max-width: 1023px) 30vw, 12vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · WHO TEACHES THE PRIMARY YEARS ═════════════════════════════════════
    Ground: very light peach. ONE horizontal rail, seven cells, thin vertical
    rules — not seven cards.

    ⚠ THIS IS NOT THE SUBJECT LIST THE BRIEF ASKED FOR, AND THE FOOTNOTE SAYS SO.
    The school publishes no Primary subject scheme; it publishes exactly who
    stands in front of these classes, which is more specific than a subject list
    and happens to be more interesting. See the header note. */}
<section class="pr-rail" aria-labelledby="pr-rail-t">
  <span class="pr-rail__warm" aria-hidden="true"></span>

  <div class="u-container pr-rail__grid">
    <div class="pr-rail__head">
      <p class="pr-kicker" data-reveal>{rail.kicker}</p>
      <ClipHeading class="pr-h pr-rail__h" id="pr-rail-t" text={rail.heading} />
      <RichLine class="pr-body pr-rail__b" text={rail.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="pr-cells">
      {rail.cells.map((s, i) => (
        <li class="pr-cell" data-reveal data-reveal-delay={140 + i * 60}>
          <span class="pr-cell__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <h3 class="pr-cell__k">{s.label}</h3>
          <p class="pr-cell__v">{s.value}</p>
        </li>
      ))}
    </ol>
  </div>

  {/* ⚠ THE RULE ABOVE THIS NOTE MUST SHARE THE CONTENT GRID. Put .u-container on
      the <p> itself and its border-top spans the container's PADDING box — 48px
      wider on each side than every headline on the page. The container wraps it
      instead. */}
  <div class="u-container">
    <RichLine class="pr-note pr-rail__note" text={rail.body[1]} linkClass="pr-link" reveal revealDelay={560} />
  </div>
</section>

{/* ══ 03 · OUR APPROACH ══════════════════════════════════════════════════════
    Ground: white. The photograph crosses LEFT — the opposite of section 01 — and
    scales gently on scroll. The list on the right is checked, not carded. */}
<section class="pr-appr" aria-labelledby="pr-appr-t">
  <span class="pr-grid pr-grid--fine" aria-hidden="true"></span>

  <div class="u-container pr-appr__grid">
    <div class="pr-appr__pic" data-zoom data-zoom-to="1.04">
      <SmartImage
        file={appr.shots[0]?.image} alt={appr.shots[0]?.alt ?? ''}
       
        widths={[560, 900, 1280]}
        sizes="(max-width: 1023px) 92vw, 48vw"
        loading="lazy"
        decoding="async"
      />
    </div>

    <div class="pr-appr__copy">
      <p class="pr-kicker" data-reveal>{appr.kicker}</p>
      <ClipHeading class="pr-h pr-appr__h" id="pr-appr-t" text={appr.heading} />
      <RichLine class="pr-body" text={appr.body[0]} reveal revealDelay={200} />

      <ul class="pr-checks">
        {appr.cells.map((a, i) => (
          <li class="pr-check" data-reveal data-reveal-delay={250 + i * 80}>
            <span class="pr-check__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
                <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            <span class="pr-check__t">
              <span class="pr-check__k">{a.label}</span>
              <span class="pr-check__v">{a.value}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

{/* ══ 04 · LEARNING DOESN'T STOP AT THE DESK ═════════════════════════════════
    Ground: soft warm cream. A four-frame editorial collage LEFT — one large, two
    floating, one circular — and the published record RIGHT on hairlines. This is
    the strongest visual section on the page, and every line beside it names the
    class that earned it. */}
<section class="pr-act" aria-labelledby="pr-act-t">
  <span class="pr-act__warm" aria-hidden="true"></span>
  <span class="pr-act__ghost" aria-hidden="true" data-drift>Impetus</span>

  <div class="u-container pr-act__grid">
    <div class="pr-act__stage">
      <div class="pr-act__lead" data-mask>
        <SmartImage
          file={act.shots[0]?.image} alt={act.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pr-act__f1" data-pop data-pop-delay="160">
        <SmartImage
          file={act.shots[1]?.image} alt={act.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 44vw, 17vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pr-act__f2" data-pop data-pop-delay="260">
        <SmartImage
          file={act.shots[2]?.image} alt={act.shots[2]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 40vw, 16vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pr-act__cir" data-pop data-pop-delay="360">
        <SmartImage
          file={act.shots[3]?.image} alt={act.shots[3]?.alt ?? ''}
         
          widths={[220, 400]}
          sizes="(max-width: 1023px) 28vw, 11vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="pr-act__copy">
      <p class="pr-kicker" data-reveal>{act.kicker}</p>
      <ClipHeading class="pr-h pr-act__h" id="pr-act-t" text={act.heading} />
      <RichLine class="pr-body" text={act.body[0]} reveal revealDelay={200} />

      <ol class="pr-record">
        {act.cells.map((r, i) => (
          <li class="pr-rec" data-reveal data-reveal-delay={250 + i * 60}>
            <p class="pr-rec__who t-tabular">{r.note}</p>
            <div class="pr-rec__t">
              <p class="pr-rec__k">{r.label}</p>
              <p class="pr-rec__v">{r.value}</p>
            </div>
          </li>
        ))}
      </ol>
      <RichLine class="pr-note" text={act.body[1]} linkClass="pr-link" reveal revealDelay={560} />
    </div>
  </div>
</section>

{/* ══ 05 · VALUES ════════════════════════════════════════════════════════════
    Ground: white. One horizontal band — headline anchored left, the values in
    columns divided by thin orange rules. No cards, no shadows, no boxes.

    ⚠ THREE, NOT FIVE. These are the words on the school's crest and the glosses
    it already publishes beside them. Five invented virtues would have looked
    tidier and meant nothing. */}
<section class="pr-val" aria-labelledby="pr-val-t">
  <div class="u-container pr-val__grid">
    <div class="pr-val__head">
      <p class="pr-kicker" data-reveal>{val.kicker}</p>
      <ClipHeading class="pr-h pr-val__h" id="pr-val-t" text={val.heading} />
      <RichLine class="pr-note pr-val__note" text={val.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="pr-vals">
      {val.cells.map((v, i) => (
        <li class="pr-vcol" data-reveal data-reveal-delay={160 + i * 100}>
          <span class="pr-vcol__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[v.mark]} />
            </svg>
          </span>
          <p class="pr-vcol__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="pr-vcol__k">{v.label}</h3>
          <p class="pr-vcol__v">{v.value}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 06 · LEARNING SPACES ═══════════════════════════════════════════════════
    Ground: warm ivory. Copy LEFT, and a 2×2 photo composition RIGHT in which no
    two frames are the same shape — the brief rules out four identical cards. */}
<section class="pr-space" aria-labelledby="pr-space-t">
  <span class="pr-space__warm" aria-hidden="true"></span>
  <span class="pr-dots pr-space__dots" aria-hidden="true"></span>

  <div class="u-container pr-space__grid">
    <div class="pr-space__copy">
      <p class="pr-kicker" data-reveal>{space.kicker}</p>
      <ClipHeading class="pr-h pr-space__h" id="pr-space-t" text={space.heading} />
      <RichLine class="pr-body" text={space.body[0]} reveal revealDelay={200} />

      <ul class="pr-feats">
        {space.cells.map((s, i) => (
          <li class="pr-feat" data-reveal data-reveal-delay={250 + i * 55}>
            <span class="pr-feat__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
                <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {s.label}
          </li>
        ))}
      </ul>
      <RichLine class="pr-note" text={space.body[1]} linkClass="pr-link" reveal revealDelay={600} />
    </div>

    {/* ⚠ FOUR DIFFERENT SHAPES. Two tall, two wide, offset by a half-step — a
        2×2 of identical squares is the card grid the brief forbids. */}
    <div class="pr-quad">
      <figure class="pr-q pr-q--a" data-pop data-pop-delay="120">
        <SmartImage file={space.shots[0]?.image} alt={space.shots[0]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Nalanda Library</figcaption>
      </figure>
      <figure class="pr-q pr-q--b" data-pop data-pop-delay="200">
        <SmartImage file={space.shots[1]?.image} alt={space.shots[1]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Computer laboratory</figcaption>
      </figure>
      <figure class="pr-q pr-q--c" data-pop data-pop-delay="280">
