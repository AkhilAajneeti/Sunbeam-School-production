{/* ══ 07 · THE PRIMARY JOURNEY ═══════════════════════════════════════════════
    Ground: very light peach. Four stages on one thin orange rail that draws
    itself as the section arrives. Each stage is anchored to a published thing
    rather than to a verb, so the row says something the parent page cannot. */}
<section class="pr-jrn" aria-labelledby="pr-jrn-t">
  <span class="pr-jrn__warm" aria-hidden="true"></span>

  <div class="u-container pr-jrn__inner">
    <p class="pr-kicker pr-jrn__kicker" data-reveal>{jrn.kicker}</p>
    <ClipHeading class="pr-h pr-jrn__h" id="pr-jrn-t" text={jrn.heading} />

    <div class="pr-jrn__track">
      {/* ⚠ THE RULE SITS ON THE NODE CENTRES. The nodes are the first row of the
          grid below and the rule is absolutely positioned to their vertical
          centre, so the line passes through every disc at every width. */}
      <span class="pr-jrn__rule" aria-hidden="true">
        <i class="pr-jrn__dash"></i>
        <svg class="pr-jrn__svg" viewBox="0 0 1000 2" fill="none" preserveAspectRatio="none">
          <path class="pr-jrn__draw" pathLength="1" d="M0 1H1000" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>

      <ol class="pr-steps">
        {jrn.cells.map((j, i) => (
          <li class="pr-step" data-reveal data-reveal-delay={140 + i * 120}>
            <span class="pr-step__node" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[j.mark]} />
              </svg>
            </span>
            <p class="pr-step__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="pr-step__k">{j.label}</h3>
            <p class="pr-step__v">{j.value}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  /* THE JOURNEY RULE DRAWS ITSELF as section 07 travels through the viewport.

     ⚠ DECORATION ONLY. The dashed rule underneath is always painted, so with
     this script absent the reader loses the travelling line and nothing else.
     `pathLength="1"` normalises the geometry, so nothing measures the DOM. */
  const prTrack = document.querySelector('.pr-jrn__track');
  const prRule = document.querySelector('.pr-jrn__draw');

  if (prTrack instanceof HTMLElement && prRule instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = prTrack.getBoundingClientRect();
      const travelled = window.innerHeight * 0.86 - r.top;
      const p = Math.min(1, Math.max(0, travelled / Math.max(1, r.height * 0.85)));
      prRule.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>

