      <span class="ms-jrn__rule" aria-hidden="true">
        <i class="ms-jrn__dash"></i>
        <svg class="ms-jrn__svg" viewBox="0 0 1000 2" fill="none" preserveAspectRatio="none">
          <path class="ms-jrn__draw" pathLength="1" d="M0 1H1000" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
      </span>

      <ol class="ms-steps">
        {jrn.cells.map((j, i) => (
          <li class="ms-step" data-reveal data-reveal-delay={140 + i * 120}>
            <span class="ms-step__node" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[j.mark]} />
              </svg>
            </span>
            <p class="ms-step__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
            <h3 class="ms-step__k">{j.label}</h3>
            <p class="ms-step__v">{j.value}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<script>
  /* THE JOURNEY RULE DRAWS ITSELF. Decoration only — the dashed rule underneath
     is always painted, so with this script absent nothing is lost but the
     travelling line. `pathLength="1"` keeps the maths in fractions. */
  const msTrack = document.querySelector('.ms-jrn__track');
  const msRule = document.querySelector('.ms-jrn__draw');

  if (msTrack instanceof HTMLElement && msRule instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = msTrack.getBoundingClientRect();
      const travelled = window.innerHeight * 0.86 - r.top;
      const p = Math.min(1, Math.max(0, travelled / Math.max(1, r.height * 0.85)));
      msRule.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>

