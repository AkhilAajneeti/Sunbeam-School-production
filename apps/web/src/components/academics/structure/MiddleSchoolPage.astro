  flask: `<path d="M9.6 3.4h4.8M10.6 3.4v5.2L6.9 17a2 2 0 0 0 1.8 2.8h6.6a2 2 0 0 0 1.8-2.8l-3.7-8.4V3.4"/><path d="M8.2 14.4h7.6"/>`,
  make: `<path d="M14.6 4.4a4 4 0 0 1 5.1 5.1l-9.4 9.4-5.1-5.1Z"/><path d="m12.6 6.4 5.1 5.1"/><path d="M5.2 13.8 3.6 20.4l6.6-1.6"/>`,
  speech: `<path d="M20.4 13.4a2.6 2.6 0 0 1-2.6 2.6H9.4l-4.6 3.6v-3.6a2.6 2.6 0 0 1-2.6-2.6V6.6A2.6 2.6 0 0 1 4.8 4h13a2.6 2.6 0 0 1 2.6 2.6Z"/><path d="M7.6 9.6h8.8M7.6 12.4h5.6"/>`,
  book: `<path d="M4 4.4h5.2A2.8 2.8 0 0 1 12 7.2v12.4a2.4 2.4 0 0 0-2.4-2.4H4Z"/><path d="M20 4.4h-5.2A2.8 2.8 0 0 0 12 7.2v12.4a2.4 2.4 0 0 1 2.4-2.4H20Z"/>`,
  atom: `<circle cx="12" cy="12" r="1.9"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(120 12 12)"/>`,
  globe: `<circle cx="12" cy="12" r="8.6"/><path d="M3.4 12h17.2"/><path d="M12 3.4c2.2 2.4 3.4 5.4 3.4 8.6S14.2 18.2 12 20.6c-2.2-2.4-3.4-5.4-3.4-8.6S9.8 5.8 12 3.4Z"/>`,
  sigma: `<path d="M17.4 5.2H6.8l5 6.8-5 6.8h10.6"/><path d="M17.4 5.2V3.6M17.4 18.8v1.6"/>`,
  langue: `<path d="M2.8 6.2h9.6M7.6 4v2.2"/><path d="M10 6.2c0 4-3.2 7.2-7.2 7.2"/><path d="M5.2 9c0 2.2 2.8 4.4 6.2 4.4"/><path d="m12.4 20.4 4-9.6 4 9.6M13.8 17.4h5.2"/>`,
  screen: `<rect x="2.6" y="4.4" width="18.8" height="12.4" rx="1.8"/><path d="M8.4 20.4h7.2M12 16.8v3.6"/>`,
  ball: `<circle cx="12" cy="12" r="9.2"/><path d="M12 2.8v18.4M2.8 12h18.4"/><path d="M5.4 5.4c3.6 3.6 3.6 9.6 0 13.2M18.6 5.4c-3.6 3.6-3.6 9.6 0 13.2"/>`,
  brush: `<path d="M14.6 4.4a4 4 0 0 1 5.1 5.1l-9.4 9.4-5.1-5.1Z"/><path d="m12.6 6.4 5.1 5.1"/><path d="M5.2 13.8 3.6 20.4l6.6-1.6"/>`,
  chip: `<rect x="6.4" y="6.4" width="11.2" height="11.2" rx="1.6"/><rect x="9.8" y="9.8" width="4.4" height="4.4" rx=".8"/><path d="M9.6 2.8v3.6M14.4 2.8v3.6M9.6 17.6v3.6M14.4 17.6v3.6M2.8 9.6h3.6M2.8 14.4h3.6M17.6 9.6h3.6M17.6 14.4h3.6"/>`,
  spark: `<path d="M12 1.8c.7 5.2 4.2 8.7 9.4 9.4-5.2.7-8.7 4.2-9.4 9.4-.7-5.2-4.2-8.7-9.4-9.4 5.2-.7 8.7-4.2 9.4-9.4z"/>`,
  ask: `<circle cx="12" cy="12" r="9.2"/><path d="M9.4 9.4a2.6 2.6 0 1 1 3.4 2.5c-.6.2-1 .8-1 1.5v.6"/><circle cx="11.8" cy="17" r=".9"/>`,
  compass: `<circle cx="12" cy="12" r="9.2"/><path d="m15.4 8.6-2 5.4-5.4 2 2-5.4Z"/>`,
  target: `<circle cx="12" cy="12" r="8.4"/><circle cx="12" cy="12" r="4.6"/><circle cx="12" cy="12" r="1.2"/>`,
  present: `<path d="M3.6 4.4h16.8v10.2H3.6Z"/><path d="M12 14.6v3.4M8.4 20.4h7.2"/><path d="m7.6 11.4 2.6-3 2.4 2 3.8-4.4"/>`,
};

/* ── SECTION 01 — the four the school names for this stage ─────────────────
   Three come from the published focus list; the fourth is the milestone. */

/* ── SECTION 02 — four numbered lines on horizontal rules, not cards ─────── */

/* ── SECTION 04 — four directions ─────────────────────────────────────────
   Each is anchored to something the school publishes for this stage, so none of
   the four is a generic verb wearing a number. */

/* ── SECTION 05 — SUBJECTS ────────────────────────────────────────────────
   ⚠ `hired: true` marks the five the school recruits middle-school teachers for,
   naming grades 6 to 8. The last three are ROOMS on the facilities inventory,
   not subjects the school has named for this stage, and the list says so. */

/* ── SECTION 06 — the data rail under the laboratories copy ───────────────── */

/* ── SECTION 08 — four stages, each anchored to something published ──────── */
---

{/* ══ 01 · THE TRANSITION ════════════════════════════════════════════════════
    Ground: warm ivory. Copy LEFT, a three-frame collage RIGHT, and "VI–VIII"
    set oversized and outlined behind the headline — heavy enough type to carry a
    watermark without losing a word of it. */}
<section class="ms-open" aria-labelledby="ms-open-t">
  <span class="ms-open__warm" aria-hidden="true"></span>
  <span class="ms-grid" aria-hidden="true"></span>
  <span class="ms-dots ms-open__dots" aria-hidden="true"></span>

  <div class="u-container ms-open__grid">
    <div class="ms-open__copy">
      {/* ⚠ BEHIND THE HEADLINE, NOT BEHIND THE SECTION. Centred on the section a
          ghost word runs straight through the paragraphs. */}
      <span class="ms-open__ghost" aria-hidden="true" data-drift>VI–VIII</span>

      <p class="ms-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="ms-h ms-open__h" id="ms-open-t" text={open.heading} />

      <RichLine class="ms-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="ms-body" text={open.body[1]} reveal revealDelay={260} />

      <ul class="ms-marks">
        {open.cells.map((m, i) => (
          <li class="ms-mark" data-reveal data-reveal-delay={300 + i * 70}>
            <span class="ms-mark__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[m.mark]} />
              </svg>
            </span>
            <span class="ms-mark__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="ms-mark__k">{m.label}</span>
            <span class="ms-mark__v">{m.value}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="ms-open__stage">
      <div class="ms-open__lead" data-mask>
        <SmartImage file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''} widths={[520, 880, 1200]} sizes="(max-width: 1023px) 92vw, 42vw" loading="eager" decoding="async" />
      </div>
      <div class="ms-open__sm" data-pop data-pop-delay="180">
        <SmartImage file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''} widths={[320, 560]} sizes="(max-width: 1023px) 46vw, 18vw" loading="lazy" decoding="async" />
      </div>
      <div class="ms-open__cir" data-pop data-pop-delay="300">
        <SmartImage file={open.shots[2]?.image} alt={open.shots[2]?.alt ?? ''} widths={[220, 400]} sizes="(max-width: 1023px) 30vw, 12vw" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · THE MIDDLE SCHOOL EXPERIENCE ══════════════════════════════════════
    Ground: white. The collage crosses LEFT — the opposite of section 01 — and
    the four changes are set as numbered lines on horizontal rules. Not cards:
    the brief rules them out in as many words. */}
<section class="ms-exp" aria-labelledby="ms-exp-t">
  <span class="ms-grid ms-grid--fine" aria-hidden="true"></span>

  <div class="u-container ms-exp__grid">
    <div class="ms-exp__stage">
      <div class="ms-exp__lead" data-zoom data-zoom-to="1.04">
        <SmartImage file={exp.shots[0]?.image} alt={exp.shots[0]?.alt ?? ''} widths={[520, 880, 1200]} sizes="(max-width: 1023px) 92vw, 42vw" loading="lazy" decoding="async" />
      </div>
      <div class="ms-exp__sm" data-pop data-pop-delay="200">
        <SmartImage file={exp.shots[1]?.image} alt={exp.shots[1]?.alt ?? ''} widths={[320, 560]} sizes="(max-width: 1023px) 52vw, 20vw" loading="lazy" decoding="async" />
      </div>
    </div>

    <div class="ms-exp__copy">
      <p class="ms-kicker" data-reveal>{exp.kicker}</p>
      <ClipHeading class="ms-h ms-exp__h" id="ms-exp-t" text={exp.heading} />
      <RichLine class="ms-body" text={exp.body[0]} reveal revealDelay={200} />

      <ol class="ms-shifts">
        {exp.cells.map((s, i) => (
          <li class="ms-shift" data-reveal data-reveal-delay={250 + i * 80}>
            <p class="ms-shift__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
            <div class="ms-shift__t">
              <p class="ms-shift__k">{s.label}</p>
              <p class="ms-shift__v">{s.value}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* ══ 03 · LEARNING BY DOING ═════════════════════════════════════════════════
    Ground: soft warm peach. Copy LEFT in a narrow column, three frames RIGHT at
    three heights, hung under one dotted rule with nodes on it. */}
<section class="ms-doing" aria-labelledby="ms-doing-t">
  <span class="ms-doing__warm" aria-hidden="true"></span>

  <div class="u-container ms-doing__grid">
    <div class="ms-doing__copy">
      <p class="ms-kicker" data-reveal>{doing.kicker}</p>
      <ClipHeading class="ms-h ms-doing__h" id="ms-doing-t" text={doing.heading} />
      <RichLine class="ms-body" text={doing.body[0]} reveal revealDelay={200} />
      <span class="ms-doing__rule" aria-hidden="true" data-reveal data-reveal-delay="270"></span>
      <RichLine class="ms-note" text={doing.body[1]} linkClass="ms-link" reveal revealDelay={320} />
    </div>

    <div class="ms-doing__stage">
      <svg class="ms-doing__arc" viewBox="0 0 1000 60" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-40 42C50 42 92 16 166 16s194 28 334 28 214-28 334-28c74 0 116 12 206 26"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 9" />
      </svg>
      <span class="ms-doing__nodes" aria-hidden="true">
        <i style="--nx: 16.6%; --ny: 26.7%;" data-pop data-pop-delay="120"></i>
        <i style="--nx: 50%; --ny: 73.3%;" data-pop data-pop-delay="210"></i>
        <i style="--nx: 83.4%; --ny: 26.7%;" data-pop data-pop-delay="300"></i>
      </span>

      <ol class="ms-frames">
        <li class="ms-frame" data-reveal data-reveal-delay="160">
          <div class="ms-frame__pic" data-zoom data-zoom-to="1.05">
            <SmartImage file={doing.shots[0]?.image} alt={doing.shots[0]?.alt ?? ''} widths={[340, 600, 860]} sizes="(max-width: 767px) 92vw, 20vw" loading="lazy" decoding="async" />
          </div>
          <RichLine class="ms-frame__k" text={doing.body[2]} />
          <RichLine class="ms-frame__v" text={doing.body[3]} />
        </li>
        <li class="ms-frame" data-reveal data-reveal-delay="270">
          <div class="ms-frame__pic" data-zoom data-zoom-to="1.05">
            <SmartImage file={doing.shots[1]?.image} alt={doing.shots[1]?.alt ?? ''} widths={[340, 600, 860]} sizes="(max-width: 767px) 92vw, 20vw" loading="lazy" decoding="async" />
          </div>
          <RichLine class="ms-frame__k" text={doing.body[4]} />
          <RichLine class="ms-frame__v" text={doing.body[5]} />
        </li>
        <li class="ms-frame" data-reveal data-reveal-delay="380">
          <div class="ms-frame__pic" data-zoom data-zoom-to="1.05">
            <SmartImage file={doing.shots[2]?.image} alt={doing.shots[2]?.alt ?? ''} widths={[340, 600, 860]} sizes="(max-width: 767px) 92vw, 20vw" loading="lazy" decoding="async" />
          </div>
          <RichLine class="ms-frame__k" text={doing.body[6]} />
          <RichLine class="ms-frame__v" text={doing.body[7]} />
        </li>
      </ol>
    </div>
  </div>
</section>

{/* ══ 04 · FOUR DIRECTIONS ═══════════════════════════════════════════════════
    Ground: white. Headline anchored left, four columns divided by thin vertical
    rules. No background, no radius, no shadow. */}
<section class="ms-four" aria-labelledby="ms-four-t">
  <div class="u-container ms-four__grid">
    <div class="ms-four__head">
      <p class="ms-kicker" data-reveal>{four.kicker}</p>
      <ClipHeading class="ms-h ms-four__h" id="ms-four-t" text={four.heading} />
    </div>

    <ol class="ms-cols">
      {four.cells.map((d, i) => (
        <li class="ms-col" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="ms-col__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[d.mark]} />
            </svg>
          </span>
          <p class="ms-col__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="ms-col__k">{d.label}</h3>
          <p class="ms-col__v">{d.value}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 05 · SUBJECTS ══════════════════════════════════════════════════════════
    Ground: warm ivory. Copy LEFT, and a vertical list RIGHT threaded on one thin
    orange line. The five the school hires for are marked; the three that are
    rooms rather than stated subjects are set apart and labelled. */}
<section class="ms-subj" aria-labelledby="ms-subj-t">
  <span class="ms-subj__warm" aria-hidden="true"></span>

  <div class="u-container ms-subj__grid">
    <div class="ms-subj__copy">
      <p class="ms-kicker" data-reveal>{subj.kicker}</p>
      <ClipHeading class="ms-h ms-subj__h" id="ms-subj-t" text={subj.heading} />
      <RichLine class="ms-body" text={subj.body[0]} reveal revealDelay={200} />
      <RichLine class="ms-note" text={subj.body[1]} linkClass="ms-link" reveal revealDelay={270} />
    </div>

    {/* ⚠ ONE ORANGE THREAD RUNS THE FULL LIST and every marker sits on it. */}
    {/* ⚠ THE THREAD IS DRAWN PER ITEM, NOT AS ONE ABSOLUTE LINE. The list is two
        columns, so a single positioned rule would only run down the first of
        them; and `data-draw` scales X, which is the wrong axis for a vertical
        rule. Each item carries the segment from its own disc to the next. */}
    <ol class="ms-list">
      {subj.cells.map((s, i) => (
        <li class={`ms-subject${s.flag ? ' ms-subject--hired' : ''}`} data-reveal data-reveal-delay={140 + i * 55}>
          <span class="ms-subject__node" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <span class="ms-subject__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
          <span class="ms-subject__t">
            <span class="ms-subject__k">
              {s.label}
              {!s.flag && <i class="ms-subject__flag">Room</i>}
            </span>
            <span class="ms-subject__v">{s.value}</span>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 06 · FROM CLASSROOM TO LAB ═════════════════════════════════════════════
    Ground: white. Photograph LEFT, copy RIGHT, and a four-cell data rail beneath
    the copy rather than four more cards. */}
<section class="ms-lab" aria-labelledby="ms-lab-t">
  <span class="ms-dots ms-lab__dots" aria-hidden="true"></span>

  <div class="u-container ms-lab__grid">
    <div class="ms-lab__pic" data-mask data-mask-from="left">
      <SmartImage file={lab.shots[0]?.image} alt={lab.shots[0]?.alt ?? ''} widths={[560, 900, 1280]} sizes="(max-width: 1023px) 92vw, 46vw" loading="lazy" decoding="async" />
    </div>

    <div class="ms-lab__copy">
      <p class="ms-kicker" data-reveal>{lab.kicker}</p>
      <ClipHeading class="ms-h ms-lab__h" id="ms-lab-t" text={lab.heading} />
      <RichLine class="ms-body" text={lab.body[0]} reveal revealDelay={200} />

      <ul class="ms-rail">
        {lab.cells.map((r, i) => (
          <li class="ms-rcell" data-reveal data-reveal-delay={260 + i * 80}>
            <span class="ms-rcell__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
              </svg>
            </span>
            <span class="ms-rcell__k">{r.label}</span>
