---
/**
 * ACADEMIC STRUCTURE · MIDDLE SCHOOL — Classes VI to VIII, in eight sections.
 *
 * ═══ SOURCE OF TRUTH — every line traces to this repository ════════════════
 *   data/facilities.ts
 *     KIDS Entrepreneurship — "A Class 7 programme that runs a real venture end
 *       to end."  · General science laboratory — "Middle-school practical work."
 *     Twelve laboratories, four of them inquiry rooms · two computer labs, 40+
 *       machines each · Robotics Lab (drone, 3-D printer, telescope) · Nalanda
 *       Library, 17,574 books.
 *   data/newsPages.ts
 *     Shining Star Kids Fashion Show, 2025 — "Miss Ayana Pandey, Class VIII";
 *     "a contest of more than seventy entrants, with the award presented by Miss
 *     Universe India 2024, Riya Singha." Result: winner.
 *   data/academics.ts
 *     Stage body — "Specialist teaching begins and the laboratories open up.
 *       Class VII takes the school's KIDS entrepreneurship programme."
 *     Focus — Practical science · Independent projects · KIDS entrepreneurship.
 *     Milestone — "Practical science · independent projects."
 *     PRECEPT, published class by class, session 2026-27.
 *   data/career.ts (the school's OWN recruitment posters, quoted verbatim)
 *     "Middle school teachers: English, Science, Social Science, Maths and
 *      French." — 2024-25 poster.
 *     "Middle school teachers: English, Science, Social Science and Maths —
 *      graduate or postgraduate with B.Ed. and minimum two years of relevant
 *      school experience in grades 6 to 8." — 2023-24 poster.
 *
 * ⚠⚠ SECTION 05 IS THE SUBJECT LIST, AND ITS SOURCE IS A RECRUITMENT POSTER.
 * The brief asked for ten subjects — English, Hindi, Mathematics, Science,
 * Social Science, Computer, French/Sanskrit, General Knowledge, Physical
 * Education, Art. THE SCHOOL PUBLISHES NO MIDDLE-SCHOOL SUBJECT SCHEME. What it
 * does publish, twice, is the list of subjects it hires middle-school teachers
 * for, and it names grades 6 to 8 explicitly. Five subjects come from there.
 * Three more — computing, physical education and art — are named as ROOMS on
 * the facilities inventory rather than as subjects, and are set apart in the
 * list as exactly that. Hindi, Sanskrit and General Knowledge appear nowhere for
 * this stage and are therefore absent.
 * ASSET REQUEST: the Middle School subject scheme, if the school will publish it.
 *
 * ⚠ SECTION 07 CARRIES NO PHOTOGRAPH, ON PURPOSE. The brief's fallback applies:
 * the achievement is verified and named, but the school has published no image
 * of the Shining Star Kids Fashion Show. A stock crowd shot captioned as a
 * fashion show would be a fabrication; the section is typographic instead.
 *
 * ⚠ NOT CLAIMED: student numbers, teacher ratios, period allocations, what KIDS
 * runs week to week, or the contents of any PRECEPT document.
 *
 * ═══ COMPOSITION — eight sections, eight different builds ═══════════════════
 *   01 · IVORY  copy LEFT, three-frame collage RIGHT, ghost "VI–VIII" behind.
 *   02 · WHITE  the collage crosses LEFT, a numbered list on horizontal rules
 *               RIGHT — not cards.
 *   03 · PEACH  copy LEFT, three frames RIGHT at three heights under one rule.
 *   04 · WHITE  four editorial columns divided by thin vertical rules.
 *   05 · IVORY  copy LEFT, a vertical subject list RIGHT threaded on one orange
 *               line.
 *   06 · WHITE  photograph LEFT, copy RIGHT, a four-cell data rail beneath.
 *   07 · SAND   a typographic achievement panel — no photograph exists.
 *   08 · PEACH  the drawn journey rail, four stages.  09 · PHOTO  the close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';

/* ── PHOTOGRAPHY — ten genuine Sunbeam Ballia frames, each used ONCE. Every
   alt below is the description already published against that file in
   data/academics.ts, so no caption here invents what a photograph shows. */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getMiddleSchool } from '../../../lib/cms';

const { open, exp, doing, four, subj, lab, ach, jrn, close } = await getMiddleSchool();


const LABS = '/academics/teaching-learning/laboratories-clubs/';
const STEM = '/academics/teaching-learning/stem-robotics/';
const SUCCESS = '/academics/student-success/';
const CURRICULUM = '/academics/philosophy/curriculum/';
const CAREERS = '/career/';

/* ── THE MARKS — 24-unit box, 1.5 stroke, round caps, no fill ─────────────── */
const MARK: Record<string, string> = {
  venture: `<path d="M3.4 20.6h17.2"/><path d="M6 20.6v-7.2M11 20.6V8.4M16 20.6v-9.6"/><path d="m4.6 8 5.2-4.4 4 2.6 5.6-3.4"/><path d="M19.4 2.8v3.8h-3.8"/>`,
  microscope: `<path d="M8.6 20.6h11.8"/><path d="M12.4 20.6a6 6 0 0 0 5.4-8.6"/><path d="m9 6.6 4.2 6.6-3.4 2.2-4.2-6.6Z"/><path d="m10.6 4 2.6 1.6"/><path d="M6.2 16.4h5.4"/>`,
  hand: `<path d="M9.4 11.2V6a1.9 1.9 0 1 1 3.8 0v7.4"/><path d="M13.2 10.4a1.7 1.7 0 0 1 3.4 0v1M16.6 11.6a1.7 1.7 0 0 1 3.4 0v3.2a6 6 0 0 1-6 6h-1.6c-2 0-3-1-4.2-2.4l-3-3.6a1.8 1.8 0 0 1 2.6-2.4l1.6 1.6"/>`,
  team: `<circle cx="8.4" cy="8" r="2.8"/><circle cx="16.6" cy="9.4" r="2.2"/><path d="M2.8 19.4a5.6 5.6 0 0 1 11.2 0"/><path d="M15 15.2a4.4 4.4 0 0 1 6.2 4.2"/>`,
