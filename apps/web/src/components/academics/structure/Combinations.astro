---
/**
 * ACADEMIC STRUCTURE · 04 — SUBJECT COMBINATIONS
 *
 * Built to a supplied reference and a written spec: badge, large centred head,
 * two columns of four equal-height pastel cards with the right-hand pair
 * dropped, icons in soft circular wells, and a swash under the closing line.
 *
 * ═══ THE THREE THINGS THAT NEEDED THINKING ABOUT ════════════════════════════
 *
 * 1 · EQUAL HEIGHT **AND** STAGGERED. The spec asks for both, and the obvious
 *     way to drop the right-hand column — `margin-top` — takes that space out of
 *     the row, so the offset cards end up SHORTER than their neighbours. The
 *     drop is therefore `position: relative; top`, which paints the card lower
 *     without touching the box the grid measured. `grid-auto-rows: 1fr` then
 *     makes all four the same height rather than only each row internally
 *     consistent. The grid carries a bottom margin equal to the drop, because a
 *     card moved by `top` still reports its original box and would otherwise
 *     overlap the closing line.
 *
 * 2 · `top` RATHER THAN `transform`, and that is not interchangeable here: the
 *     hover lift is a transform, and one property cannot hold a permanent offset
 *     and an interactive one at once without the hover cancelling the stagger.
 *
 * 3 · NO ARROW, though the spec lists one. An arrow promises the card goes
 *     somewhere, and these cards are a DESTINATION — the photograph cards in the
 *     section above link down to them by id. There is nowhere for it to point.
 *     The same call every other card on this page makes.
 *
 * ⚠ UNCONFIRMED SUBJECT LISTS ARE STAMPED, AND THERE ARE TWO FLAGS FOR IT.
 * `unverified` covers the optional and additional lists; `coreUnverified` covers
 * the core. They are separate because they were confirmed separately — the
 * school supplied the elective lists, leaving the Humanities core as the only
 * outstanding one, and a single shared flag silently dropped that caveat the
 * moment the electives were signed off. The stamp on each card and the notice at
 * the foot are the version a family sees. The failure mode is
 * someone choosing a school on the strength of a subject nobody confirmed it
 * teaches, so the caveat is rendered rather than left in a comment. It renders
 * FROM the data, so confirming the lists removes every stamp and the notice
 * automatically — nobody has to remember.
 *
 * ⚠ EACH CARD CARRIES AN id — comb-pcm, comb-pcb and so on. Renaming a stream in
 * the data changes these anchors and silently breaks the four links pointing at
 * them; both ends derive from the same string, so the fix is always to leave the
 * derivation alone rather than hard-code either side.
 *
 * MOTION IS THE SITE'S OWN, not a second system. `data-reveal` fades up 26px on
 * power3 and takes its delay in milliseconds, so the spec's 0.15s stagger is
 * `i * 150`. Writing a bespoke GSAP timeline here would mean two motion
 * vocabularies on one page and a second entry point to keep gated behind
 * prefers-reduced-motion and Save-Data — which is what motion-gsap.ts already
 * does for everything else.
 */
import { Image } from 'astro:assets';
import AcademicGlyph from '../AcademicGlyph.astro';
import cap from '../../../assets/icons/graduate-cap.png';
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/structure/');
const streamDetail = ac.section('streamDetail').streams;
const combinationsFootnote = ac.section('combinationsFootnote').note;

/* Two independent caveats, because they can be outstanding independently — and
   right now exactly one of them is. `electivesOwed` is false (the school sent
   the lists); `coreOwed` is true (Humanities). The notice must fire on either,
   and must not call a core an elective. */
const electivesOwed = streamDetail.some((s) => s.unverified);
const coreOwed = streamDetail.some((s) => s.coreUnverified);
const anyUnverified = electivesOwed || coreOwed;

const claimText = electivesOwed && coreOwed
  ? 'The core and elective lists marked above are indicative and awaiting confirmation from the school.'
  : electivesOwed
    ? 'The elective lists above are indicative and awaiting confirmation from the school.'
    : 'The Humanities core above is indicative and awaiting confirmation from the school. Every other subject list on this page is the school’s own.';
---

<section class="ascb" id="combinations" aria-labelledby="ascb-title">
  {/* Decorative, and all of it behind the copy in an isolated context. */}
  <span class="ascb__glow ascb__glow--a" aria-hidden="true"></span>
  <span class="ascb__glow ascb__glow--b" aria-hidden="true"></span>
  <span class="ascb__dots" aria-hidden="true"></span>

  {/* The reference floats a kite here; a mortarboard says the same thing about
      Classes XI–XII and is already in the school's own artwork. */}
  <Image
    class="ascb__cap"
    src={cap}
    alt=""
    aria-hidden="true"
    widths={[280, 560]}
    sizes="250px"
    loading="lazy"
  />

  <div class="u-container">
    <div class="ascb__head">
      <p class="ascb__badge" data-reveal>
        <span class="ascb__star" aria-hidden="true">✳</span>
        Subject combinations
      </p>

      <h2 class="ascb__h" id="ascb-title" data-split>What each stream is made of</h2>

      <p class="ascb__lede" data-reveal data-reveal-delay="140">
        The subjects carried to the Class XII board examination, and the options taken alongside
        them.
      </p>
    </div>

    <ol class="ascb__grid">
      {
        streamDetail.map((s, i) => (
          <li
            class="cmb"
            id={`comb-${s.name.toLowerCase()}`}
            style={`--acc: var(--as-${s.accent});`}
            data-reveal
            data-reveal-delay={i * 150}
          >
            <span class="cmb__well" aria-hidden="true">
              <AcademicGlyph name={s.glyph} size={30} />
            </span>

            <h3 class="cmb__h">{s.name}</h3>
            {/* <p class="cmb__full">{s.full}</p> */}
            <p class="cmb__b">{s.body}</p>

            <div class="cmb__sets">
              <div class="cmb__set">
                {/* ⚠ THE CORE CARRIES ITS OWN FLAG, NOT `unverified`. That one
                    governs the two elective lists below and the school has
                    confirmed those; the Humanities core is the single line here
                    it has not. Sharing one flag is how the caveat went missing
                    when the electives were signed off. */}
                <p class="cmb__l">
                  Core subjects
                  {s.coreUnverified && <span class="cmb__stamp">To be confirmed</span>}
                </p>
                <ul class="cmb__chips">
                  {s.core.map((c) => (
                    <li class="cmb__chip cmb__chip--core">{c}</li>
                  ))}
                </ul>
              </div>

              {/* THE SCHOOL'S OWN TWO CATEGORIES. It distinguishes subjects
                  chosen alongside the core from subjects carried on top of it;
                  collapsing them back into one "electives" list would lose a
                  distinction it drew itself. */}
              <div class="cmb__set">
                <p class="cmb__l">
                  Optional subjects
                  {s.unverified && <span class="cmb__stamp">To be confirmed</span>}
                </p>
                <ul class="cmb__chips">
                  {s.optional.map((e) => (
                    <li class="cmb__chip">{e}</li>
                  ))}
                </ul>
              </div>

              <div class="cmb__set cmb__set--wide">
                <p class="cmb__l">
                  Additional subjects
                  {s.unverified && <span class="cmb__stamp">To be confirmed</span>}
                </p>
                <ul class="cmb__chips">
                  {s.additional.map((e) => (
                    <li class="cmb__chip cmb__chip--add">{e}</li>
                  ))}
                </ul>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    <div class="ascb__foot">
      {
        anyUnverified && (
          <p class="ascb__claim">
            <span>{claimText}</span>
            {/* The reference's hand-drawn swash. An inline path rather than an
                image: it takes the accent through `currentColor` and stays crisp
                at any width. */}
            <svg class="ascb__swash" viewBox="0 0 240 12" fill="none" aria-hidden="true" preserveAspectRatio="none">
              <path
                d="M3 8.4c34-4.6 68-6.4 102-5.5 33 .9 66 4.4 99 6.1"
                stroke="currentColor"
                stroke-width="3"
                stroke-linecap="round"
              />
            </svg>
          </p>
        )
      }
      <p class="ascb__note">{combinationsFootnote}</p>
    </div>
  </div>
</section>

<style>
  /* GENEROUS, because that is where the premium reads from. The spec's "large
     section padding" against the page's own rhythm: roughly a third more than
     the neighbouring sections carry. */
  .ascb {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(72px, 11vh, 140px);
    background: var(--as-ground);
    /* One easing for every transition on this section, so the card, its well and
       its tint all arrive together rather than in a loose sequence. */
    --ease-premium: cubic-bezier(0.22, 1, 0.36, 1);
    --dur: 350ms;
  }

  /* --- Decoration ----------------------------------------------------------
     Two blurred blooms and a dot field, all far enough under the copy to be
     atmosphere. Stacked radials with a real blur rather than flat coloured
     ovals — that is the whole difference between a bloom and a shape. */
  .ascb__glow {
    position: absolute;
    z-index: -2;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(90px);
    pointer-events: none;
  }

  .ascb__glow--a {
    top: -14%;
    left: -8%;
    width: 42%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--as-teal) 20%, transparent),
      transparent 66%
    );
  }

  .ascb__glow--b {
    bottom: -18%;
    right: -6%;
    width: 38%;
    background: radial-gradient(
      circle at 50% 50%,
      color-mix(in srgb, var(--as-violet) 17%, transparent),
      transparent 66%
    );
  }

  .ascb__dots {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image: radial-gradient(circle, rgba(22, 24, 42, 0.1) 1px, transparent 1px);
    background-size: 26px 26px;
    /* Masked to the middle so the texture never reaches the section's edges and
       turns into a visible rectangle of dots. */
    -webkit-mask-image: radial-gradient(70% 58% at 50% 44%, #000 0%, transparent 76%);
    mask-image: radial-gradient(70% 58% at 50% 44%, #000 0%, transparent 76%);
    pointer-events: none;
  }

  .ascb__cap {
    position: absolute;
    z-index: -1;
    right: clamp(-28px, -1.2vw, -6px);
    bottom: clamp(16px, 4vh, 60px);
    width: clamp(120px, 14vw, 224px);
    height: auto;
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
  }

  /* --- Head ---------------------------------------------------------------- */

  .ascb__head { text-align: center; }

  .ascb__badge {
    display: inline-flex;
    align-items: center;
    gap: var(--sb-3);
    padding: 8px 18px;
    border-radius: var(--sb-r-full);
    background: color-mix(in srgb, var(--as-teal) 10%, #fff);
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--as-teal);
  }

  .ascb__star { font-size: 1.05em; line-height: 1; }

  /* 800, not 700, and it is a real weight: the display face is a variable font
     declared 200–900, so this is drawn rather than synthesised. */
  /* 26ch, not 18. At 18 the balancer had no room to work with and split the
     line as "What each / stream is made of" — a widow-ish break that reads as an
     accident. A wider box lets it choose the even split. */
  h2.ascb__h {
    max-width: 26ch;
    margin: clamp(20px, 2.6vh, 30px) auto 0;
    font-family: var(--sb-font-display);
    font-weight: 800;
    font-size: clamp(34px, 4.6vw, 60px);
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--as-ink);
    text-wrap: balance;
  }

  .ascb__lede {
    max-width: 700px;
    margin: clamp(20px, 2.6vh, 28px) auto 0;
    font-size: clamp(16px, 1.2vw, 18px);
    line-height: 1.75;
    color: var(--as-text);
    text-wrap: pretty;
  }

  /* --- The grid ------------------------------------------------------------
     `1fr` rows rather than `auto`: with `auto`, each ROW matches internally but
     the two rows can differ, and the spec asks for four equal cards. */
  .ascb__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    grid-auto-rows: 1fr;
    gap: clamp(20px, 2.2vw, 36px);
    margin: clamp(48px, 7vh, 88px) 0 var(--drop);
    padding: 0;
    list-style: none;
    --drop: clamp(26px, 4vw, 60px);
  }

  /* THE DROP IS `top`, NOT `margin-top` — see the header. `top` paints the card
     lower without changing the box the grid measured, so the four stay equal
     height; the grid's bottom margin gives back the space the offset borrows. */
  .ascb__grid > li:nth-child(even) {
    position: relative;
    top: var(--drop);
  }

  /* --- Card ---------------------------------------------------------------- */

  /* PASTEL AND BORDERLESS, each in its own stream's accent at 7% — the tint
     carries information rather than variety, because it is the same colour that
     stream wears on the photograph card above and the stages before it. */
  .cmb {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: clamp(28px, 3.2vw, 48px);
    border-radius: clamp(22px, 2.2vw, 32px);
    background: color-mix(in srgb, var(--acc) 7%, #fff);
    box-shadow: 0 10px 30px -20px rgba(22, 24, 42, 0.2);
    transition:
      transform var(--dur) var(--ease-premium),
      box-shadow var(--dur) var(--ease-premium),
      background-color var(--dur) var(--ease-premium);
  }

  .cmb:hover {
    transform: translateY(-8px);
    background: color-mix(in srgb, var(--acc) 11%, #fff);
    box-shadow: 0 28px 58px -24px rgba(22, 24, 42, 0.28);
  }

  /* The icon's well. A circle rather than the rounded square the rest of the
     page uses, because the reference's is round and it is the one place this
     section departs from the page's chrome. */
  .cmb__well {
    display: grid;
    place-items: center;
    width: clamp(58px, 5vw, 74px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: color-mix(in srgb, var(--acc) 13%, #fff);
    color: var(--acc);
    transition:
      transform var(--dur) var(--ease-premium),
      background-color var(--dur) var(--ease-premium);
  }

  .cmb:hover .cmb__well {
    transform: scale(1.08) rotate(5deg);
    background: color-mix(in srgb, var(--acc) 21%, #fff);
  }

  h3.cmb__h {
    margin-top: clamp(22px, 2.6vw, 34px);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(21px, 2vw, 28px);
    line-height: 1.12;
    letter-spacing: -0.03em;
    color: var(--as-ink);
  }

  .cmb__full {
    margin-top: var(--sb-3);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 600;
    line-height: 1.55;
    color: var(--acc);
  }

  .cmb__b {
    max-width: 44ch;
    margin-top: clamp(12px, 1.4vw, 18px);
    font-size: clamp(15px, 1.15vw, 17px);
    line-height: 1.7;
    color: var(--as-text);
  }

  /* --- The subject lists ---------------------------------------------------
     `margin-top: auto` pins these to the card's foot, so four cards of unequal
     copy still line their lists up on the same line. */
  .cmb__sets {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 30px);
    margin-top: auto;
    padding-top: clamp(22px, 2.6vw, 34px);
  }

  /* ⚠ THE THIRD GROUP SPANS BOTH COLUMNS rather than starting a second row of
     two. There are now three sets — core, optional, additional — and on a
     two-column bed the third would sit in a half-width column with an empty
     half beside it. Additional is also the longest list of the three (six
     subjects), so it is the one that most needs the full width to avoid
     chipping down into a narrow stack. */
  .cmb__set--wide { grid-column: 1 / -1; }

  .cmb__l {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--sb-3);
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--as-text);
  }

  /* Not a decoration. It is the only thing standing between a placeholder
     subject list and a family reading it as an offer. */
  .cmb__stamp {
    padding: 3px 9px;
    border: 1px dashed color-mix(in srgb, var(--as-ink) 38%, transparent);
    border-radius: var(--sb-r-full);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.08em;
    color: var(--as-text);
  }

  .cmb__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: clamp(12px, 1.4vw, 16px) 0 0;
    padding: 0;
    list-style: none;
  }

  .cmb__chip {
    padding: 6px 13px;
    border-radius: var(--sb-r-full);
    background: #fff;
    font-size: var(--sb-caption);
    font-weight: 600;
    line-height: 1.4;
    color: var(--as-text);
  }

  /* Core subjects are filled, electives are not — the visual weight matches the
     certainty, which is the honest way round. */
  .cmb__chip--core {
    background: var(--acc);
    color: #fff;
  }

  /* THREE WEIGHTS FOR THREE CATEGORIES: core is filled, optional is solid white,
     additional is outlined. The ladder runs from "everyone takes this" down to
     "you may carry this on top", which is the order a family reads them in — and
     it keeps eleven chips per card legible as three groups rather than one
     speckled mass. */
  .cmb__chip--add {
    background: transparent;
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--acc) 34%, transparent);
    color: var(--as-ink);
  }

  /* --- The closing line ---------------------------------------------------- */

  .ascb__foot {
    max-width: 66ch;
    margin: clamp(44px, 6vh, 76px) auto 0;
    text-align: center;
  }

  .ascb__claim {
    display: inline-block;
    font-size: clamp(16px, 1.2vw, 18px);
    font-weight: 700;
    line-height: 1.6;
    color: var(--as-ink);
  }

  /* Under the line rather than through it, and short of the full width so it
     reads as drawn by hand rather than as a border. */
  .ascb__swash {
    display: block;
    width: 68%;
    height: 10px;
    margin: 8px auto 0;
    color: var(--as-teal);
  }

  .ascb__note {
    margin-top: clamp(12px, 1.6vh, 18px);
    font-size: clamp(14px, 1.05vw, 16px);
    line-height: 1.75;
    color: var(--as-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .cmb,
    .cmb__well { transition: none; }
    .cmb:hover { transform: none; }
    .cmb:hover .cmb__well { transform: none; }
  }

  /* The two subject lists stop fitting side by side well before the cards do. */
  @media (max-width: 1080px) {
    .cmb__sets { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 719px) {
    .ascb { padding-block: clamp(56px, 9vh, 88px); }
    .ascb__grid {
      grid-template-columns: minmax(0, 1fr);
      grid-auto-rows: auto;
      margin-bottom: 0;
    }
    /* Stacked, the drop is just an unexplained gap between two cards. */
    .ascb__grid > li:nth-child(even) { position: static; top: auto; }
    /* Hover lift is a pointer gesture; on touch it only reads as a stuck state
       after a tap. */
    .cmb:hover { transform: none; }
    /* At this width it would sit on the closing line. */
    .ascb__cap { display: none; }
  }
</style>
