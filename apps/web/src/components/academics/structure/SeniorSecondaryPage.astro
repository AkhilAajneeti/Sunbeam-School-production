---
/**
 * ACADEMIC STRUCTURE · SENIOR SECONDARY — Classes XI and XII, in six sections.
 *
 * ═══ SOURCE OF TRUTH — every line traces to this repository ════════════════
 *   data/site.ts — school.streams: PCM · PCB · Commerce · Humanities.
 *   data/academics.ts
 *     streamDetail — the full name and one-line body for each of the four.
 *     PRECEPT — a published syllabus document per class, session 2026-27.
 *     Milestone — the CBSE Class XII board examination.
 *   data/newsPages.ts
 *     Class XII-B Physics, 2025 — "Students determined the internal resistance
 *       of a galvanometer and calculated its figure of merit — the practical,
 *       done properly," by the half-deflection method.
 *     Monash — "Students travelled to Delhi for an international innovation
 *       project on entrepreneurship, run with Monash University, Australia," at
 *       K. R. Mangalam World School, G.K-II, New Delhi.
 *     Guiding Futures, Shaping Lives — Classes IX–XII.
 *   data/facilities.ts
 *     Physics · Chemistry · Biology — board practicals, Classes IX–XII ·
 *     twelve laboratories, four of them inquiry rooms · two computer labs, 40+
 *     machines each · Robotics Lab · Language Lab · Nalanda Library ·
 *     fifteen sports · career counselling.
 *
 * ⚠ ONLY THE STREAM NAMES ARE CLAIMED IN SECTION 01. data/academics.ts warns
 * that the Humanities core is not confirmed by the school and that elective
 * lists have been revised once already. Subject Combinations is the page that
 * carries those, with its confidence labels; this page names the four and stops.
 *
 * ⚠ SECTION 03 USES CARDS, AND THAT IS THE ONE PLACE THE REFERENCE ASKS FOR
 * THEM. Everywhere else on this page — the stream indicators, the feature
 * points, the checklist, the journey — is hairlines and columns, because the
 * brief rules cards out everywhere except this 2×2.
 *
 * ⚠ NO BOARD RESULTS ARE CLAIMED HERE; they have their own published page.
 * ⚠ Every photograph's alt is the description already published against that
 * file in data/, so no caption invents what an image shows.
 *
 * ═══ COMPOSITION — six sections, six different builds ══════════════════════
 *   01 · PEACH  copy LEFT with four stream indicators, three-frame collage RIGHT.
 *   02 · WHITE  the collage crosses LEFT, copy RIGHT over a four-cell rail.
 *   03 · IVORY  copy and a CTA LEFT, a 2×2 of small information cards RIGHT.
 *   04 · WHITE  a checked list LEFT, an unequal 2×2 gallery RIGHT.
 *   05 · PEACH  a rounded container holding the drawn journey rail.
 *   06 · PHOTO  the dark close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import { getSchool } from '../../../lib/cms';

/* ── PHOTOGRAPHY — ten genuine Sunbeam Ballia frames, each used ONCE. ─────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getSeniorSecondary } from '../../../lib/cms';

const { open, beyond, board, more, jrn, close } = await getSeniorSecondary();

const sb = await getSchool();


const COMBINATIONS = '/academics/structure/subject-combinations/';
const CURRICULUM = '/academics/philosophy/curriculum/';
const RESULTS = '/academics/board-results/';
const LABS = '/academics/teaching-learning/laboratories-clubs/';
const FACILITIES = '/campus/facilities-infrastructure/';
const SUCCESS = '/academics/student-success/';

/* ── THE MARKS — 24-unit box, 1.5 stroke, round caps, no fill ─────────────── */
const MARK: Record<string, string> = {
  atom: `<circle cx="12" cy="12" r="1.9"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(60 12 12)"/><ellipse cx="12" cy="12" rx="9.4" ry="3.7" transform="rotate(120 12 12)"/>`,
