    margin: clamp(13px, 1.6vw, 19px) 0 0;
    font-size: clamp(12.5px, 0.92vw, 14.5px);
    line-height: 1.78;
    color: var(--sb-text-secondary);
  }
  :global(.ss-body strong) { font-weight: 700; color: var(--sb-charcoal); }
  :global(.ss-body em) { font-style: italic; color: var(--sb-charcoal); }

  :global(.ss-note) {
    max-width: 56ch;
    margin: clamp(12px, 1.4vw, 17px) 0 0;
    font-size: clamp(10px, 0.74vw, 11.5px);
    line-height: 1.68;
    color: var(--sb-text-muted);
  }

  :global(.ss-link){
    color: var(--sb-violet);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-thickness: 1px;
  }
  :global(.ss-link:hover){ color: var(--sb-orange-bright); }

  /* The one call to action on the page — outlined, not filled, so it does not
     compete with the Apply Online button in the header. */
  :global(.ss-cta) { margin: clamp(16px, 2vw, 24px) 0 0; }
  :global(.ss-btn){
    display: inline-flex;
    align-items: center;
    padding: clamp(9px, 1vw, 12px) clamp(16px, 1.8vw, 24px);
    border: 1.5px solid var(--sb-violet);
    border-radius: var(--sb-r-1);
    font-size: clamp(11px, 0.8vw, 12.8px);
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--sb-violet);
    transition: background-color var(--sb-dur-image) var(--sb-ease), color var(--sb-dur-image) var(--sb-ease);
  }
  :global(.ss-btn:hover){ background: var(--sb-violet); color: #fff; }

  .ss-grid {
    position: absolute;
    z-index: -2;
    inset: 0;
    background-image:
      linear-gradient(to right, rgba(28, 14, 8, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(28, 14, 8, 0.05) 1px, transparent 1px);
    background-size: 88px 88px;
    mask-image: radial-gradient(72% 78% at 50% 44%, #000 0%, transparent 82%);
  }
  .ss-grid--fine { background-size: 52px 52px; opacity: 0.7; }

  .ss-dots {
    position: absolute;
