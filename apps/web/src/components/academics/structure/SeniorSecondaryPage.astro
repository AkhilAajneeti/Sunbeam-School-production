{/* ══ 01 · FOUR ROUTES, CHOSEN ONCE ══════════════════════════════════════════
    Ground: warm peach. Copy LEFT with four stream indicators beneath it, and a
    three-frame collage RIGHT — one large, one overlapping, one circular crop. */}
<section class="ss-open" aria-labelledby="ss-open-t">
  <span class="ss-open__warm" aria-hidden="true"></span>
  <span class="ss-dots ss-open__dots" aria-hidden="true"></span>

  <div class="u-container ss-open__grid">
    <div class="ss-open__copy">
      <p class="ss-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="ss-h ss-open__h" id="ss-open-t" text={open.heading} />

      <RichLine class="ss-body" text={open.body[0]} linkClass="ss-link" reveal revealDelay={200} />

      {/* ⚠ INDICATORS, NOT CARDS. Number, line icon, stream name, one line. */}
      <ul class="ss-routes">
        {open.cells.map((r, i) => (
          <li class="ss-route" data-reveal data-reveal-delay={260 + i * 80}>
            <span class="ss-route__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="ss-route__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
              </svg>
            </span>
            <span class="ss-route__k">{r.label}</span>
            <span class="ss-route__v">{r.value}</span>
          </li>
        ))}
      </ul>
    </div>

    <div class="ss-open__stage">
      <div class="ss-open__lead" data-mask>
        <SmartImage file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''} widths={[520, 880, 1200]} sizes="(max-width: 1023px) 92vw, 42vw" loading="eager" decoding="async" />
      </div>
      <div class="ss-open__sm" data-pop data-pop-delay="180">
        <SmartImage file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''} widths={[320, 560]} sizes="(max-width: 1023px) 46vw, 18vw" loading="lazy" decoding="async" />
      </div>
      <div class="ss-open__cir" data-pop data-pop-delay="300">
        <SmartImage file={open.shots[2]?.image} alt={open.shots[2]?.alt ?? ''} widths={[220, 400]} sizes="(max-width: 1023px) 30vw, 12vw" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

