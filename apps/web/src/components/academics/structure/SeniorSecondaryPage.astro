    </div>

    <div class="ss-quad">
      <figure class="ss-q ss-q--a" data-pop data-pop-delay="120">
        <SmartImage file={more.shots[0]?.image} alt={more.shots[0]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Students learning</figcaption>
      </figure>
      <figure class="ss-q ss-q--b" data-pop data-pop-delay="200">
        <SmartImage file={more.shots[1]?.image} alt={more.shots[1]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Computer laboratories</figcaption>
      </figure>
      <figure class="ss-q ss-q--c" data-pop data-pop-delay="280">
        <SmartImage file={more.shots[2]?.image} alt={more.shots[2]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Subject laboratories</figcaption>
      </figure>
      <figure class="ss-q ss-q--d" data-pop data-pop-delay="360">
        <SmartImage file={more.shots[3]?.image} alt={more.shots[3]?.alt ?? ''} widths={[340, 620]} sizes="(max-width: 767px) 46vw, 22vw" loading="lazy" decoding="async" />
        <figcaption>Sport and co-curricular</figcaption>
      </figure>
    </div>
  </div>
</section>

{/* ══ 05 · THE SENIOR SECONDARY JOURNEY ══════════════════════════════════════ */}
<section class="ss-jrn" aria-labelledby="ss-jrn-t">
  <div class="u-container">
    <div class="ss-jrn__box">
      <p class="ss-kicker ss-jrn__kicker" data-reveal>{jrn.kicker}</p>
      <ClipHeading class="ss-h ss-jrn__h" id="ss-jrn-t" text={jrn.heading} />

      <div class="ss-jrn__track">
        <span class="ss-jrn__rule" aria-hidden="true">
          <i class="ss-jrn__dash"></i>
          <svg class="ss-jrn__svg" viewBox="0 0 1000 2" fill="none" preserveAspectRatio="none">
            <path class="ss-jrn__draw" pathLength="1" d="M0 1H1000" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </span>

        <ol class="ss-steps">
          {jrn.cells.map((j, i) => (
            <li class="ss-step" data-reveal data-reveal-delay={140 + i * 120}>
              <span class="ss-step__node" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[j.mark]} />
                </svg>
              </span>
              <p class="ss-step__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
              <h3 class="ss-step__k">{j.label}</h3>
              <p class="ss-step__v">{j.value}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>
  </div>
</section>

<script>
  /* THE JOURNEY RULE DRAWS ITSELF. Decoration only — the dashed rule beneath is
     always painted, so with this script absent nothing is lost but the
     travelling line. `pathLength="1"` keeps the maths in fractions. */
  const ssTrack = document.querySelector('.ss-jrn__track');
  const ssRule = document.querySelector('.ss-jrn__draw');

  if (ssTrack instanceof HTMLElement && ssRule instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = ssTrack.getBoundingClientRect();
      const travelled = window.innerHeight * 0.86 - r.top;
      const p = Math.min(1, Math.max(0, travelled / Math.max(1, r.height * 0.85)));
      ssRule.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>

{/* ══ 06 · THE CLOSE ═════════════════════════════════════════════════════════ */}
<section class="ss-close" aria-labelledby="ss-close-t">
  <div class="ss-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
