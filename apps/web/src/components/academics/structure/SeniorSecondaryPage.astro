    font-family: var(--sb-font-display);
    font-weight: 700;
    line-height: 1.04;
    letter-spacing: -0.04em;
    color: var(--sb-charcoal);
  }
  :global(.ss-h span) { display: block; }
  :global(.ss-h em) { font-style: normal; color: var(--sb-violet); }

