  </div>
  <span class="ss-close__scrim" aria-hidden="true"></span>
  <span class="ss-close__grain" aria-hidden="true"></span>

  <div class="u-container ss-close__inner">
    <p class="ss-kicker ss-kicker--dark" data-reveal>{close.kicker}</p>
    <ClipHeading class="ss-h ss-close__h" id="ss-close-t" text={close.heading} />
    <RichLine class="ss-close__b" text={close.body[0]} reveal revealDelay={180} />
  </div>
</section>

<style>
  /* ═══ SHARED ══════════════════════════════════════════════════════════════ */
  .ss-kicker {
    margin: 0;
    font-size: clamp(10.5px, 0.78vw, 12px);
