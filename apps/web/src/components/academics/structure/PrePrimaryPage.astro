    />
  </div>
</section>

<script>
  /* THE RAIL DRAWS ITSELF as section 06 travels through the viewport.

     ⚠ DECORATION ONLY. The dashed rail underneath is always painted, so with
     this script absent the reader loses the travelling line and nothing else.
     `pathLength="1"` normalises the geometry, so nothing measures the DOM and
     the maths cannot drift when the curve is edited. */
  const ppTrack = document.querySelector('.pp-first__track');
  const ppRail = document.querySelector('.pp-rail__draw');

  if (ppTrack instanceof HTMLElement && ppRail instanceof SVGPathElement
    && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    let queued = false;

    const paint = () => {
      queued = false;
      const r = ppTrack.getBoundingClientRect();
      const travelled = window.innerHeight * 0.86 - r.top;
      const p = Math.min(1, Math.max(0, travelled / Math.max(1, r.height * 0.9)));
      ppRail.style.strokeDashoffset = String(1 - p);
    };

    const onScroll = () => {
      if (queued) return;
      queued = true;
      requestAnimationFrame(paint);
    };

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  }
</script>

