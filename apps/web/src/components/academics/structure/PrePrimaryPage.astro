---
/**
 * ACADEMIC STRUCTURE · PRE-PRIMARY — Nursery, LKG and UKG, in seven sections.
 *
 * ⚠ EVERY LINE IS A PUBLISHED FACT. The early years are the easiest stage in a
 * school to write fiction about — ratios, hours, "milestones", "curriculum
 * pillars" — so this page carries none of it. Its sources, all in this
 * repository:
 *
 *   data/facilities.ts
 *     Kids Park            "Swings and play equipment for the early years."
 *     Water Pool           "A shallow water play area in the early-years zone."
 *     Sand Pool            "Sand play alongside the water pool — messy, and
 *                           deliberately so."
 *     Little Agriculture   "A planting plot the youngest children actually dig,
 *       Land                sow and water."
 *     Abhayeti Prayer Gd.  "The junior block's own prayer ground."
 *     Toy Library          "Borrowable toys for the early years — a first
 *                           lending system, at four years old."
 *     Junior Attendants    "A dedicated attendant with every junior class
 *                           through the day."
 *   data/academics.ts (stages[0])
 *     classes  Nursery · LKG · UKG
 *     body     "The first years on campus, in rooms and grounds built for them
 *               — a kids park, a toy library, sand and water play, and a little
 *               agriculture patch."
 *     focus    Play-led routine · Early language · Number sense
 *     milestone "School as a place you want to be"
 *     PRECEPT  syllabus published class by class FROM NURSERY, session 2026-27.
 *   data/schoolActivities.ts
 *     Little Agriculturists — "A hands-on farming activity for the youngest
 *     children, published as 'Little Agriculturist'."
 *   data/newsPages.ts
 *     SOF Olympiad — Nursery to Class II.
 *
 * ⚠ NOT CLAIMED, ANYWHERE ON THIS PAGE: admission ages, session hours, class
 * size, staff ratios, per-class curriculum, or what any one of Nursery, LKG and
 * UKG does differently from the other two. The school publishes the three years
 * as ONE stage with one set of focuses, so section 06 does the same — the class
 * names are stops on a path, not three different syllabuses.
 *
 * ⚠ THE FOUR-WORD LABEL "EXPLORE" IN SECTION 02 SITS OVER A KIDS PARK PHOTO.
 * The sand pool and the water pool are published facilities the school has NOT
 * photographed. Rather than let a playground frame pass as a water pool, each of
 * the three frames carries a caption naming what it actually shows, and a
 * footnote states the absence. Same rule in section 05: the school names
 * Abhayeti but has published no photograph of it, so the frame there is captioned
 * as the JOSH camp gathering it actually is.
 * ASSET REQUEST: the sand pool, the water pool, the toy library in use, and
 * Abhayeti.
 *
 * ═══ COMPOSITION — seven sections, seven different builds ═══════════════════
 *   01 · IVORY  collage LEFT (lead + overhang + circle), copy RIGHT, and five
 *               facilities as a hairline-divided editorial strip — not cards.
 *   02 · CREAM  copy LEFT in a narrow column, three staggered frames RIGHT at
 *               three different heights, under one dotted arc.
 *   03 · WHITE  the photographs cross LEFT, a dotted path carries the eye into
 *               the copy, and the lead frame scales 1 → 1.04 on scroll.
 *   04 · PEACH  four editorial columns divided by thin orange rules, over an
 *               oversized ghost word.
 *   05 · IVORY  copy and photograph side by side over the ghost word ABHAYETI.
 *   06 · WHITE  a drawn wave rail with three stops, then one shared band.
 *   07 · PHOTO  the dark close — the KG-II convocation.
 *
 * MOTION is the project's own attribute set. The rail in 06 draws with the same
 * scroll-driven stroke-dashoffset the Experiential page uses; it is decoration
 * over an always-painted dashed route, so with the script absent nothing is lost
 * but the travelling line.
 */

/* ── PHOTOGRAPHY — eight genuine Sunbeam Ballia frames. No stock. ─────────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getPrePrimary } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const { open, doing, land, play, abh, first, firstBand, close } = await getPrePrimary();

/**
 * ⚠ WHERE EACH STOP SITS ON THE CURVE IS DESIGN, NOT CONTENT.
 * The three nodes were stored with an nx and an ny percentage against the
 * editorial text, which meant an editor could drag a stop off the drawn line, or
 * add a fourth with no position at all and have it land in the corner. The path
 * is fixed, so its stops are fixed, and they live here beside it.
 */
const STOP_POSITIONS = [
  { nx: '16.6%', ny: '34%' },
  { nx: '50%', ny: '62%' },
  { nx: '83.4%', ny: '34%' },
];

const S = 'Sunbeam School Ballia';

/* Cross-links, so a fact lives on one page and is pointed at from the others. */
const FACILITIES = '/campus/facilities-infrastructure/';
const STRUCTURE = '/academics/structure/';
const ACTIVITIES = '/beyond-academics/school-activities/little-agriculturists/';

/* ── THE MARKS ──────────────────────────────────────────────────────────────
   24-unit box, 1.5 stroke, round caps and joins, no fill, `currentColor`. Line
   drawings, deliberately — a cartoon set would make this page a kindergarten
   template, which is the one thing the brief rules out. */
const MARK: Record<string, string> = {
  swing: `<path d="M4.4 20.6 12 3.8l7.6 16.8"/><path d="M8.1 12.2h7.8"/><path d="M9.7 12.2v4.9M14.3 12.2v4.9"/><path d="M8.9 17.1h6.2"/>`,
  sand: `<path d="M2.6 19.8h18.8"/><path d="M2.6 19.8c2.1-5 4.7-7.5 7.9-7.5 3.2 0 4.5 3 6.3 3 1.4 0 2.4-1 3-3"/><circle cx="17.4" cy="6.4" r="2.4"/>`,
  water: `<path d="M2.7 8.2c1.9 0 1.9 1.7 3.9 1.7s1.9-1.7 3.9-1.7 1.9 1.7 3.8 1.7 1.9-1.7 3.9-1.7 1.9 1.7 3.9 1.7"/><path d="M2.7 13c1.9 0 1.9 1.7 3.9 1.7S8.5 13 10.5 13s1.9 1.7 3.8 1.7S16.2 13 18.2 13s1.9 1.7 3.9 1.7"/><path d="M2.7 17.8c1.9 0 1.9 1.7 3.9 1.7s1.9-1.7 3.9-1.7 1.9 1.7 3.8 1.7 1.9-1.7 3.9-1.7 1.9 1.7 3.9 1.7"/>`,
  sprout: `<path d="M12 20.6v-7.8"/><path d="M12 12.8C12 9.3 9.5 6.8 6 6.8c0 3.5 2.5 6 6 6Z"/><path d="M12 12.8c0-3.5 2.5-6 6-6 0 3.5-2.5 6-6 6Z"/><path d="M7.6 20.6h8.8"/>`,
  prayer: `<path d="M4.4 20.6h15.2"/><path d="M6.6 20.6v-7.9a5.4 5.4 0 0 1 10.8 0v7.9"/><path d="M12 7.3V4.9"/><circle cx="12" cy="3.4" r="1.2"/>`,
  toy: `<rect x="3.2" y="12.6" width="7.6" height="7.6" rx="1.3"/><rect x="13.2" y="12.6" width="7.6" height="7.6" rx="1.3"/><rect x="8.2" y="3.9" width="7.6" height="7.6" rx="1.3"/>`,
  hand: `<path d="M9.4 11.2V6a1.9 1.9 0 1 1 3.8 0v7.4"/><path d="M13.2 10.4a1.7 1.7 0 0 1 3.4 0v1M16.6 11.6a1.7 1.7 0 0 1 3.4 0v3.2a6 6 0 0 1-6 6h-1.6c-2 0-3-1-4.2-2.4l-3-3.6a1.8 1.8 0 0 1 2.6-2.4l1.6 1.6"/>`,
  star: `<path d="M12 2.7 14.6 9l6.8.5-5.2 4.4 1.6 6.6L12 16.9l-5.8 3.6 1.6-6.6L2.6 9.5 9.4 9Z"/>`,
  book: `<path d="M4 4.4h5.2A2.8 2.8 0 0 1 12 7.2v12.4a2.4 2.4 0 0 0-2.4-2.4H4Z"/><path d="M20 4.4h-5.2A2.8 2.8 0 0 0 12 7.2v12.4a2.4 2.4 0 0 1 2.4-2.4H20Z"/>`,
};

/* ── SECTION 01 — the five facilities, in the school's own order ───────────
   The strip is an editorial list, not five cards. Every label is a facility the
   school publishes by name. */

/* ── SECTION 02 — three activity areas ─────────────────────────────────────
   `cap` is what the PHOTOGRAPH shows, which is not always what the beat is
   named after. See the header note and the footnote under the row. */

/* ── SECTION 04 — four columns, four published facilities ──────────────────
   The brief's fourth column was "Play". The school's own fourth early-years
   provision is the Toy Library, which is published and specific, so that is what
   the column carries. */

/* ── SECTION 06 — three stops ──────────────────────────────────────────────
   ⚠ THE LINES ARE STRUCTURAL, NOT CURRICULAR. "The middle year" is true of
   three years in a row; "the last before Class I" is true of the stage boundary.
   Neither claims a syllabus, because the school publishes none per class.
   `nx`/`ny` are the node's position on the rail, and the rail's curve is drawn
   to pass through exactly those points. */

/* The three things the school names for the stage — all three years, not one. */
---

{/* ══ 01 · A BEGINNING OF ITS OWN ════════════════════════════════════════════
    Ground: warm ivory. Idea: the collage carries the left, the copy the right,
    and the five facilities close the column as a hairline strip rather than as
    five boxes — the brief is explicit that they must not become cards. */}
<section class="pp-open" aria-labelledby="pp-open-t">
  <span class="pp-open__warm" aria-hidden="true"></span>
  <span class="pp-grid" aria-hidden="true"></span>
  <span class="pp-dots pp-open__dots" aria-hidden="true"></span>

  {/* A curved dotted trail entering from the left margin. Decoration only. */}
  <svg class="pp-open__trail" viewBox="0 0 180 240" fill="none" aria-hidden="true">
    <path d="M-14 26c46 0 58 34 96 34s52-30 92-30" stroke="currentColor" stroke-width="1.4"
      stroke-linecap="round" stroke-dasharray="2 8" />
    <path d="M-14 132c52 0 60 40 100 40s48-26 88-26" stroke="currentColor" stroke-width="1.4"
      stroke-linecap="round" stroke-dasharray="2 8" />
    <circle cx="110" cy="60" r="2.6" fill="currentColor" />
    <circle cx="122" cy="172" r="2.6" fill="currentColor" />
  </svg>

  <div class="u-container pp-open__grid">
    {/* ⚠ THE COLLAGE IS BUILT INSIDE ITS OWN COLUMN. The overhang frame stops at
        the column's right edge and the circle at its left, so the composition
        reads as overlapping without a single pixel of page overflow. */}
    <div class="pp-open__stage">
      <div class="pp-open__lead" data-mask>
        <SmartImage
          file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''}
         
          widths={[520, 860, 1200]}
          sizes="(max-width: 767px) 92vw, 40vw"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="pp-open__sm" data-pop data-pop-delay="180">
        <SmartImage
          file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 767px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="pp-open__cir" data-pop data-pop-delay="300">
        <SmartImage
          file={open.shots[2]?.image} alt={open.shots[2]?.alt ?? ''}
         
          widths={[220, 400]}
          sizes="(max-width: 767px) 30vw, 12vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="pp-open__copy">
      <p class="pp-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="pp-h pp-open__h" id="pp-open-t" text={open.heading} />

      <RichLine class="pp-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="pp-body" text={open.body[1]} reveal revealDelay={260} />

      {/* ⚠ A STRIP, NOT FIVE CARDS. Hairline dividers, 20px marks, one line of
          label each — the brief rules out large cards here explicitly. */}
      <ul class="pp-zone" data-draw-scope>
        {open.cells.map((z, i) => (
          <li class="pp-zone__i" data-reveal data-reveal-delay={300 + i * 60}>
            <span class="pp-zone__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[z.mark]} />
              </svg>
            </span>
            <span class="pp-zone__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="pp-zone__k">{z.label}</span>
          </li>
        ))}
      </ul>
      <RichLine class="pp-note" text={open.body[2]} linkClass="pp-link" reveal revealDelay={620} />
    </div>
  </div>
</section>

{/* ══ 02 · LEARNING THROUGH DOING ════════════════════════════════════════════
    Ground: soft warm cream. Idea: a narrow copy column on the left and three
    frames on the right at three different heights, hung under one dotted arc so
    they read as a single composition rather than three cards in a row. */}
<section class="pp-doing" aria-labelledby="pp-doing-t">
  <span class="pp-doing__warm" aria-hidden="true"></span>

  <div class="u-container pp-doing__grid">
    <div class="pp-doing__copy">
      <p class="pp-kicker" data-reveal>{doing.kicker}</p>
      <ClipHeading class="pp-h pp-doing__h" id="pp-doing-t" text={doing.heading} />
      <RichLine class="pp-body" text={doing.body[0]} reveal revealDelay={200} />
      <RichLine class="pp-note pp-doing__note" text={doing.body[1]} reveal revealDelay={270} />
    </div>

    <div class="pp-doing__stage">
      {/* The arc the three frames hang from. Painted, not drawn — a half-drawn
          decoration above three photographs reads as a rendering fault. */}
      {/* ⚠ EACH CUBIC ENDS ON A NODE. The three dots sit at 16.6%, 50% and
          83.4% of the row — the same fractions the three frames centre on — so
          the curve is authored to pass through (166,16), (500,44) and (834,16)
          in its own viewBox, and the nodes read those same numbers back as
          percentages. Editing one means editing both. */}
      <svg class="pp-doing__arc" viewBox="0 0 1000 60" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <path d="M-40 42C50 42 92 16 166 16s194 28 334 28 214-28 334-28c74 0 116 12 206 26"
          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-dasharray="3 9" />
      </svg>
      <span class="pp-doing__nodes" aria-hidden="true">
        <i style="--nx: 16.6%; --ny: 26.7%;" data-pop data-pop-delay="120"></i>
        <i style="--nx: 50%; --ny: 73.3%;" data-pop data-pop-delay="210"></i>
        <i style="--nx: 83.4%; --ny: 26.7%;" data-pop data-pop-delay="300"></i>
      </span>

      <ol class="pp-acts">
        {doing.cells.map((d, i) => (
          <li class="pp-act" data-reveal data-reveal-delay={160 + i * 110}>
            <div class="pp-act__pic" data-zoom data-zoom-to="1.05">
              <SmartImage
                file={d.image}
                alt={d.alt}
                sizes="(max-width: 767px) 92vw, 20vw"
                fallbackWidth={1100}
                loading="lazy"
              />
            </div>
            <p class="pp-act__cap">{d.caption}</p>
            <p class="pp-act__h">
              <span class="pp-act__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
              <span class="pp-act__k">{d.label}</span>
            </p>
            <p class="pp-act__s">{d.sub}</p>
            <p class="pp-act__v">{d.value}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* ══ 03 · THE LITTLE AGRICULTURE LAND ═══════════════════════════════════════
    Ground: white. Idea: the photographs cross to the LEFT — the opposite of
    section 01 — and a dotted path carries the eye from the frames up into the
    eyebrow. The lead frame scales gently on scroll; nothing else moves. */}
<section class="pp-land" aria-labelledby="pp-land-t">
  <span class="pp-grid pp-grid--fine" aria-hidden="true"></span>

  <div class="u-container pp-land__grid">
    <div class="pp-land__stage">
      <div class="pp-land__lead" data-zoom data-zoom-to="1.04">
        <SmartImage
          file={land.shots[0]?.image} alt={land.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 767px) 92vw, 42vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pp-land__sm" data-pop data-pop-delay="200">
        <SmartImage
          file={land.shots[1]?.image} alt={land.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 767px) 52vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="pp-land__copy">
      {/* The dotted path from the frames into the copy. Decoration only. */}
      <svg class="pp-land__thread" viewBox="0 0 200 120" fill="none" aria-hidden="true">
        <path d="M-16 104C34 104 44 58 92 46s78 4 122-24" stroke="currentColor" stroke-width="1.5"
          stroke-linecap="round" stroke-dasharray="2.5 8" />
        <circle cx="196" cy="23" r="2.8" fill="currentColor" />
      </svg>

      <p class="pp-kicker" data-reveal>{land.kicker}</p>
      <ClipHeading class="pp-h pp-land__h" id="pp-land-t" text={land.heading} />

      <RichLine class="pp-body" text={land.body[0]} reveal revealDelay={200} />
      <RichLine class="pp-body" text={land.body[1]} linkClass="pp-link" reveal revealDelay={260} />

      <p class="pp-land__pull" data-reveal data-reveal-delay="330">
        {land.cells.map((c) => <span>{c.label}</span>)}
      </p>
    </div>
  </div>
</section>

{/* ══ 04 · PLAY IS PART OF THE PLACE ═════════════════════════════════════════
    Ground: very light peach. Idea: one wide horizontal band — headline anchored
    left, four columns divided by thin orange rules to the right. No boxes, no
    shadows, no cards. An oversized ghost word sits behind the whole band. */}
<section class="pp-play" aria-labelledby="pp-play-t">
  <span class="pp-play__warm" aria-hidden="true"></span>
  <span class="pp-play__ghost" aria-hidden="true" data-drift>Play</span>

  <div class="u-container pp-play__grid">
    <div class="pp-play__head">
      <p class="pp-kicker" data-reveal>{play.kicker}</p>
      <ClipHeading class="pp-h pp-play__h" id="pp-play-t" text={play.heading} delays={[0, 150, 290]} />
    </div>

    <ol class="pp-cols">
      {play.cells.map((p, i) => (
        <li class="pp-col" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="pp-col__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[p.mark]} />
            </svg>
          </span>
          <p class="pp-col__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="pp-col__k">{p.label}</h3>
          <p class="pp-col__v">{p.value}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 05 · ABHAYETI ══════════════════════════════════════════════════════════
    Ground: ivory, with the name itself set oversized and transparent behind the
    whole section. Idea: large type on the left, one photograph on the right,
    and the photograph captioned for exactly what it is. */}
<section class="pp-abh" aria-labelledby="pp-abh-t">
  <span class="pp-abh__warm" aria-hidden="true"></span>
  <div class="u-container pp-abh__grid">
    <div class="pp-abh__copy">
      {/* ⚠ BEHIND THE HEADLINE, NOT BEHIND THE SECTION. Centred on the section
          the name ran straight through three paragraphs and the footnote. The
          headline is 48px display weight and carries a 1px outline behind it
          without losing a thing. */}
      <span class="pp-abh__ghost" aria-hidden="true" data-drift>Abhayeti</span>
      <RichLine class="pp-badge" text={abh.body[0]} reveal />
      <ClipHeading class="pp-h pp-abh__h" id="pp-abh-t" text={abh.heading} />
      <RichLine class="pp-body" text={abh.body[1]} reveal revealDelay={200} />
      <RichLine class="pp-body" text={abh.body[2]} reveal revealDelay={260} />
      <RichLine class="pp-note" text={abh.body[3]} reveal revealDelay={330} />
    </div>

    <figure class="pp-abh__fig">
      <div class="pp-abh__pic" data-mask data-mask-from="left">
        <SmartImage
          file={abh.shots[0]?.image} alt={abh.shots[0]?.alt ?? ''}
         
          widths={[560, 900, 1280]}
          sizes="(max-width: 767px) 92vw, 46vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="pp-abh__cap">{abh.caption}</figcaption>
    </figure>
  </div>
</section>

{/* ══ 06 · THE FIRST YEARS ═══════════════════════════════════════════════════
    Ground: white. Idea: a shallow wave rail with three stops on it, and one band
    beneath carrying what the school actually publishes about all three years.

    ⚠ THE RAIL'S CURVE IS AUTHORED TO PASS THROUGH THE NODES. Each cubic in the
    path ends exactly at a node's (x, y), so the dots sit on the line at every
    width — preserveAspectRatio="none" scales x and y independently and the
    percentages track it. Editing the path means re-checking `first[].nx/ny`. */}
<section class="pp-first" aria-labelledby="pp-first-t">
  <span class="pp-grid pp-grid--fine" aria-hidden="true"></span>

  <div class="u-container pp-first__inner">
    <p class="pp-kicker pp-first__kicker" data-reveal>{first.kicker}</p>
    <ClipHeading class="pp-h pp-first__h" id="pp-first-t" text={first.heading} />

    <div class="pp-first__track">
      <div class="pp-rail">
        <svg class="pp-rail__svg" viewBox="0 0 1000 100" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <path
            d="M-40 62C60 62 90 34 166 34s194 28 334 28 220-28 333-28c77 0 127 14 207 22"
            stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="3 9" />
          <path class="pp-rail__draw" pathLength="1"
            d="M-40 62C60 62 90 34 166 34s194 28 334 28 220-28 333-28c77 0 127 14 207 22"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>

        {first.cells.map((f, i) => (
          <span
            class="pp-rail__node"
            style={`--nx: ${STOP_POSITIONS[i]?.nx}; --ny: ${STOP_POSITIONS[i]?.ny};`}
            aria-hidden="true"
          >
            <i style={`--d: ${i * 0.9}s;`}></i>
          </span>
        ))}
      </div>

      <ol class="pp-stops">
        {first.cells.map((f, i) => (
          <li class="pp-stop" data-reveal data-reveal-delay={140 + i * 120}>
            <p class="pp-stop__k">{f.label}</p>
            <p class="pp-stop__v">{f.value}</p>
          </li>
        ))}
      </ol>
    </div>

    {/* ⚠ ONE BAND FOR ALL THREE. The school names three focuses and one milestone
        for the stage as a whole and does not split them by class, so neither
        does this page. */}
    <div class="pp-band" data-reveal data-reveal-delay="440">
      <div class="pp-band__focus">
        <p class="pp-band__lab">{firstBand.kicker}</p>
        <ul class="pp-band__list">
          {firstBand.cells.map((f) => <li>{f.label}</li>)}
        </ul>
      </div>
      <div class="pp-band__mile">
        <p class="pp-band__lab">{firstBand.caption}</p>
