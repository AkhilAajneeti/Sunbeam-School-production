---
/**
 * ACADEMIC STRUCTURE · 01 — THE OVERVIEW
 *
 * The argument before the parts: fourteen years read as one journey, then the
 * three facts a reader is actually checking — how far the school goes, which
 * board, and how many streams at the end.
 *
 * THE FACTS ARE READ, NOT TYPED. Every value comes from data/site.ts, so the
 * class range, the board, the affiliation number and the stream count cannot
 * drift out of step with the footer, the banner or the other six Academics
 * pages. The stream figure is `school.streams.length` rather than the numeral
 * four for the same reason — add a fifth stream to the data and this counts it.
 *
 * THE BACKGROUND IS THREE LAYERS, all decorative and all behind the copy in an
 * isolated context: two blurred radial blooms in the page's cool palette, and a
 * dot grid for texture. The blooms are stacked radials with a real blur rather
 * than flat coloured ovals — that is the whole difference between a bloom and a
 * shape, and it is why the blur is not optional.
 */
import { getSchool } from '../../../lib/cms';

const school = await getSchool();

const facts = [
  { label: 'Range', value: school.classRange },
  { label: 'Board', value: `${school.board} · ${school.affiliationNo}` },
  { label: 'Streams at XI–XII', value: String(school.streams.length) },
];
---

<section class="asin" aria-labelledby="asin-title">
  <span class="asin__blob asin__blob--a" aria-hidden="true"></span>
  <span class="asin__blob asin__blob--b" aria-hidden="true"></span>
  <span class="asin__dots" aria-hidden="true"></span>

  <div class="u-container">
    <div class="asin__head">
      <p class="asin__eyebrow"><span class="asin__pill">Chapter 02 · Academics</span></p>

      <h2 class="asin__h" id="asin-title" data-split>Fourteen years, one journey</h2>

      <p class="asin__lede">
        From a first morning in Nursery to a Class XII board examination — five stages, each with its
        own shape, taught to the CBSE curriculum throughout.
      </p>

      <dl class="asin__facts">
        {
          facts.map((f, i) => (
            <div class="asin__fact" data-pop data-pop-delay={i * 90}>
              <dt>{f.label}</dt>
              <dd class="t-tabular">{f.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </div>
</section>

<style>
  .asin {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(56px, 8vh, 96px) clamp(48px, 7vh, 80px);
    background: var(--as-ground);
  }

  /* --- The three background layers ----------------------------------------- */

  .asin__blob {
    position: absolute;
    z-index: -2;
    aspect-ratio: 1;
    border-radius: 50%;
    filter: blur(72px);
    pointer-events: none;
  }

  .asin__blob--a {
    top: -18%;
    left: -6%;
    width: 46%;
    background:
      radial-gradient(circle at 55% 45%, color-mix(in srgb, var(--as-teal) 26%, transparent), transparent 68%),
      radial-gradient(circle at 30% 70%, color-mix(in srgb, var(--as-cyan) 18%, transparent), transparent 72%);
  }

  .asin__blob--b {
    bottom: -26%;
    right: -8%;
    width: 42%;
    background:
      radial-gradient(circle at 45% 50%, color-mix(in srgb, var(--as-violet) 22%, transparent), transparent 68%),
      radial-gradient(circle at 70% 30%, color-mix(in srgb, var(--as-indigo) 16%, transparent), transparent 72%);
  }

  /* Masked to the middle band so the texture never reaches the section's edges
     and turn into a visible rectangle of dots. */
  .asin__dots {
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: radial-gradient(circle, rgba(45, 55, 90, 0.13) 1px, transparent 1px);
    background-size: 22px 22px;
    -webkit-mask-image: radial-gradient(72% 62% at 50% 46%, #000 0%, transparent 78%);
    mask-image: radial-gradient(72% 62% at 50% 46%, #000 0%, transparent 78%);
    pointer-events: none;
  }

  /* --- Copy ---------------------------------------------------------------- */

  .asin__head { text-align: center; }

  .asin__pill {
    display: inline-block;
    padding: 7px 16px;
    border: 1px solid color-mix(in srgb, var(--as-indigo) 22%, transparent);
    border-radius: var(--sb-r-full);
    background: color-mix(in srgb, var(--as-indigo) 8%, #fff);
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--as-indigo);
  }

  h2.asin__h {
    max-width: 20ch;
    margin: clamp(18px, 2.4vh, 26px) auto 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(30px, 4.4vw, 60px);
    line-height: 1.05;
    letter-spacing: -0.038em;
    color: var(--as-ink);
    text-wrap: balance;
  }

  .asin__lede {
    max-width: 62ch;
    margin: clamp(18px, 2.4vh, 26px) auto 0;
    font-size: var(--sb-body);
    line-height: 1.75;
    color: var(--as-text);
    text-wrap: pretty;
  }

  /* --- The three facts ------------------------------------------------------
     Glass plates rather than plain chips: a translucent ground over the blooms
     is the one place on this page where the blur behind the copy is visible, and
     it is what makes the layer order read as depth rather than as clutter. */
  .asin__facts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: clamp(12px, 1.4vw, 20px);
    margin: clamp(28px, 4vh, 44px) 0 0;
  }

  .asin__fact {
    padding: clamp(14px, 1.4vw, 20px) clamp(20px, 2vw, 30px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: var(--sb-r-2);
    /* 0.78, not 0.66. These plates float over the blurred blooms, so their
       ground is not one colour — and the teal label on them measured 4.7:1 at
       1440, five hundredths clear of AA on the lightest patch and with nothing
       in hand for a darker one. A denser plate steadies the ground under the
       type without closing the glass. */
    background: rgba(255, 255, 255, 0.78);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    box-shadow: var(--as-shadow);
    text-align: left;
    transition:
      transform var(--sb-dur-image) var(--sb-ease),
      box-shadow var(--sb-dur-image) var(--sb-ease);
  }

  .asin__fact:hover {
    transform: translateY(-4px);
    box-shadow: var(--as-shadow-hover);
  }

  .asin__fact dt {
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--as-teal);
  }

  .asin__fact dd {
    margin: 6px 0 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.5vw, 21px);
    letter-spacing: -0.02em;
    color: var(--as-ink);
  }

  @media (prefers-reduced-motion: reduce) {
    .asin__fact { transition: none; }
    .asin__fact:hover { transform: none; }
  }

  @media (max-width: 719px) {
    .asin { padding-block: var(--sb-9) var(--sb-8); }
    .asin__facts { flex-direction: column; align-items: stretch; }
    .asin__fact:hover { transform: none; }
  }
</style>
