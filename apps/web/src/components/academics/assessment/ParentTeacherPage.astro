---
/**
 * ASSESSMENT & SUPPORT · PARENT–TEACHER MEETINGS — five sections.
 *
 * ⚠ THE PHOTOGRAPHS ARE NOT OF A PTM, AND THE PAGE SAYS SO. The school has
 * published no photograph of a parent–teacher meeting. It has published several
 * of its Parents' Forum, which is a different thing — a panel session, not a
 * one-to-one. Rather than caption a forum as a PTM, this page shows the forum,
 * names it as the forum, and states the gap in section 03 and again at the
 * close. ASSET REQUIREMENT: photography of an actual parent–teacher meeting.
 *
 * ═══ SOURCE — verified in this repository ══════════════════════════════════
 *   PTMs are placed on the academic calendar for the session, alongside the
 *     examination dates, terms and holidays.  (data/academics.ts)
 *   The parent portal carries term reports and results between meetings.
 *     (site.ts school.external.results)
 *   The Parents' Forum — read off the school's own published photograph, the
 *     projected agenda reads "Agenda for Parents Forum: Session 2025-26,
 *     Class IX to XII" and lists TWELVE items, of which FOUR are academic
 *     quality: quality of classroom teaching, pace of teaching, quality of
 *     assignment, and correction of notebooks.
 *
 * ⚠ NOT CLAIMED: how many PTMs a year, their length, whether they are by
 * appointment, or whether every subject teacher attends. None is published, and
 * the design brief rules out inventing exactly these.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · IVORY  copy left, a two-frame composition right, PTM set oversized.
 *   02 · CREAM  the collage crosses LEFT with a circular detail on it; the four
 *               channels are rows on rules, right.
 *   03 · PAPER  four editorial columns on thin vertical rules.
 *   04 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';
import { getSchool } from '../../../lib/cms';

/* ── PHOTOGRAPHY — five genuine Sunbeam Ballia frames, each used ONCE. ────── */
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/assessment/parent-teacher-meetings/');
const pHall = ac.pic('pHall');
const pTiers = ac.pic('pTiers');
const pPanel = ac.pic('pPanel');
const pSpeak = ac.pic('pSpeak');
const pCohort = ac.pic('pCohort');

const school = await getSchool();

const S = 'Sunbeam School Ballia';

const CALENDAR = '/academics/academic-calendar/';
const FORUM = '/academics/parent-partnership/parents-forum/';
const ASSESSMENT = '/academics/assessment/';
const PORTAL = school.external.results;

/* ── SECTION 02 — the four channels ──────────────────────────────────────── */
const channels = ac.section('channels').points;

/* ── SECTION 03 — four reasons, each one anchored to something published ─── */
const reasons = ac.section('reasons').points;
---

{/* ══ 01 · THE DATE COMES FIRST ══════════════════════════════════════════════
    Ground: warm ivory. Copy left, a two-frame composition right, and PTM set
    oversized and outlined behind the photographs. */}
<section class="as-sec as-sec--ivory as-pad pt-open" aria-labelledby="pt-open-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container pt-open__grid">
    <div>
      <p class="as-kicker" data-reveal>Scheduled, not called</p>
      <h2 class="as-h as-h--xl pt-open__h" id="pt-open-t">
        <span data-clip data-clip-delay="0">The date comes first,</span>
        <span data-clip data-clip-delay="150"><em>not the problem.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        Sunbeam places its parent–teacher meetings on the <strong>academic calendar for the
        session</strong>, alongside the examination dates, the terms and the holidays. The
        consequence is small and worth stating: a parent knows the date months before the meeting,
        and can read it against the examination it follows.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        A meeting called at short notice has already said something before anyone speaks — that
        something has gone wrong. A meeting that was always in the calendar has not, which is what
        makes it possible to sit down about a child who is doing perfectly well.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="330">
        The dates themselves are not published online. The
        {' '}<a class="as-link" href={CALENDAR}>academic calendar</a> page sets out what the school
        says the calendar carries.
      </p>
    </div>

    <div class="pt-open__stage">
      <span class="as-ghost pt-open__ghost" aria-hidden="true" data-drift>PTM</span>
      <span class="as-dots pt-open__dots" aria-hidden="true"></span>

      <div class="pt-open__lead as-frame as-fill" data-mask>
        <SmartImage
          file={pHall}
          alt={ac.picAlt('pHall')}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="pt-open__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={pTiers}
          alt={ac.picAlt('pTiers')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · WITH A PRINTED AGENDA ═════════════════════════════════════════════
    Ground: warm cream. The collage crosses LEFT with a circular detail dropped
    on its corner; the four channels sit right as rows on thin rules. */}
<section class="as-sec as-sec--cream as-pad pt-agenda" aria-labelledby="pt-agenda-t">
  <div class="u-container pt-agenda__grid">
    <figure class="pt-agenda__stage">
      <span class="as-dots pt-agenda__dots" aria-hidden="true"></span>
      <div class="pt-agenda__lead as-frame as-fill" data-zoom data-zoom-to="1.04">
        <SmartImage
          file={pPanel}
          alt={ac.picAlt('pPanel')}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="pt-agenda__cir as-frame as-frame--float as-frame--round as-fill" data-pop data-pop-delay="220">
        <SmartImage
          file={pSpeak}
          alt={ac.picAlt('pSpeak')}
         
          widths={[240, 430]}
          sizes="(max-width: 1023px) 32vw, 13vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="pt-agenda__cap">
        Photographs: the Parents’ Forum for Classes IX to XII, session 2025-26 — not a parent–teacher
        meeting. The school has published no photograph of one.
      </figcaption>
    </figure>

    <div class="pt-agenda__copy">
      <p class="as-kicker" data-reveal>With a printed agenda</p>
      <h2 class="as-h as-h--lg" id="pt-agenda-t">
        <span data-clip data-clip-delay="0">With a printed</span>
        <span data-clip data-clip-delay="150"><em>agenda.</em></span>
      </h2>
      <p class="as-body" data-reveal data-reveal-delay="200">
        The forum is a panel session, and its agenda is projected in the room rather than kept at the
        front. That agenda is worth reading: <strong>four of its twelve items</strong> are the ones
        parents rarely get a formal channel for — <em>quality of classroom teaching, pace of
        teaching, quality of assignment,</em> and <em>correction of notebooks.</em>
      </p>

      <ol class="as-rows pt-agenda__rows">
        {channels.map((c, i) => (
          <li class="as-row" data-reveal data-reveal-delay={250 + i * 80}>
            <span class="as-row__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[c.mark]} />
              </svg>
            </span>
            <div class="as-row__t">
              <p class="as-row__k">{c.k}</p>
              <p class="as-row__v">{c.v}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="as-note" data-reveal data-reveal-delay="580">
        The forum has its own page under
        {' '}<a class="as-link" href={FORUM}>Parent Partnership</a>; reports sit in the
        {' '}<a class="as-link" href={PORTAL} rel="noopener">parent portal</a>.
      </p>
    </div>
  </div>
</section>

{/* ══ 03 · FOUR REASONS IT WORKS ═════════════════════════════════════════════
    Ground: white. Four editorial blocks separated by thin vertical lines — not
    cards; the brief rules those out here in as many words. */}
<section class="as-sec as-sec--paper as-pad--sm pt-why" aria-labelledby="pt-why-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <div class="pt-why__head">
      <p class="as-kicker" data-reveal>Four reasons it works</p>
      <h2 class="as-h as-h--md" id="pt-why-t">
        <span data-clip data-clip-delay="0">Four things,</span>
        <span data-clip data-clip-delay="150"><em>and the reason for each</em></span>
      </h2>
    </div>

    <ol class="as-cols pt-why__cols" style="--n: 4;">
      {reasons.map((r, i) => (
        <li class="as-col" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="as-col__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
            </svg>
          </span>
          <p class="as-col__n t-tabular">{r.n}</p>
          <h3 class="as-col__k">{r.k}</h3>
          <p class="as-col__v">{r.v}</p>
          <span class="as-col__go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </span>
        </li>
      ))}
    </ol>

    <p class="as-note pt-why__foot" data-reveal data-reveal-delay="500">
      The cycle these meetings sit inside is on
      {' '}<a class="as-link" href={ASSESSMENT}>Assessment &amp; Support</a>.
    </p>
  </div>
</section>

<AsClose
  id="pt-close-t"
  kicker="On the calendar, in advance"
  lead="Read it against"
  accent="the calendar."
  body="The school publishes that PTMs are on the session calendar and that reports sit in the parent portal. How many meetings a year, how long they run and whether they are by appointment are not published — and no photograph of a PTM exists on the school's site."
  photo={pCohort}
/>

<style>
  /* ═══ 01 · THE DATE COMES FIRST ═══════════════════════════════════════════ */
  .pt-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.04fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .pt-open__h { max-width: 15ch; }
  .pt-open__stage { position: relative; padding-bottom: clamp(24px, 2.8vw, 44px); }
  .pt-open__ghost {
    bottom: clamp(-16px, -1vw, -4px);
    left: clamp(2%, 4vw, 12%);
    font-size: clamp(70px, 10vw, 150px);
  }
  .pt-open__dots { top: -3%; right: -1%; }
  .pt-open__lead { width: 84%; margin-left: auto; aspect-ratio: 16 / 11; }
  .pt-open__sm {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 16 / 9;
    border: 5px solid #f7f0ea;
  }

  /* ═══ 02 · WITH A PRINTED AGENDA ══════════════════════════════════════════ */
  .pt-agenda__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .pt-agenda__stage { position: relative; margin: 0; padding-bottom: clamp(46px, 5vw, 70px); }
  .pt-agenda__dots { top: 0; left: -1%; }
  .pt-agenda__lead { width: 88%; aspect-ratio: 16 / 10; }
  /* The circular detail the reference drops on the main image's corner. */
  .pt-agenda__cir {
    position: absolute;
    right: 0;
    bottom: clamp(30px, 3.2vw, 48px);
    width: clamp(94px, 10vw, 148px);
    aspect-ratio: 1 / 1;
    border: 5px solid #f3ece5;
  }
  .pt-agenda__cap {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    max-width: 54ch;
    font-size: clamp(9.5px, 0.7vw, 11px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }
  .pt-agenda__rows { margin-top: clamp(17px, 2vw, 25px); }

  /* ═══ 03 · FOUR REASONS ═══════════════════════════════════════════════════ */
  .pt-why__cols { margin-top: clamp(22px, 2.8vw, 36px); }
  .pt-why__foot { max-width: none; margin-top: clamp(20px, 2.4vw, 30px); padding-top: clamp(14px, 1.6vw, 20px); border-top: 1px solid var(--sb-border); }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .pt-open__grid,
    .pt-agenda__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    .pt-open__stage,
    .pt-agenda__stage { order: -1; }
    .pt-open__h { max-width: none; }
    .pt-open__ghost { font-size: clamp(58px, 11vw, 100px); }
  }

  @media (max-width: 767px) {
    .pt-open__lead { width: 100%; aspect-ratio: 5 / 4; }
    .pt-open__sm { width: 48%; }
    .pt-open__stage { padding-bottom: clamp(30px, 8vw, 42px); }
    .pt-agenda__lead { width: 100%; aspect-ratio: 5 / 4; }
    .pt-agenda__cir { width: clamp(78px, 22vw, 104px); bottom: clamp(50px, 13vw, 66px); }
    .pt-agenda__stage { padding-bottom: clamp(58px, 15vw, 76px); }
  }
</style>
