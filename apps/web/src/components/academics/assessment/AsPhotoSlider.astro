---
/**
 * THE PHOTO SLIDER — one large frame at a time, with a thumbnail strip.
 *
 * ⚠ FOR A SET OF PHOTOGRAPHS OF THE SAME EVENT, where the reader wants to look
 * at one picture properly. Career Guidance has eight frames of one afternoon;
 * showing all eight at once turns an event into a contact sheet.
 *
 * ⚠ EVERY FRAME IS IN THE DOM AND CROSS-FADED. Swapping a single <img>'s src
 * flashes white between pictures on a slow connection; two layers that are both
 * already decoded do not. The cost is that every image is fetched — which is why
 * only the first is `eager` and the rest are lazy.
 *
 * ⚠ NO AUTOPLAY. The brief is explicit, twice. An image that changes under a
 * reader who is looking at it is a bug wearing a feature's clothes.
 *
 * ⚠ THE COUNTER IS DERIVED, NEVER TYPED. `01 / 08` comes from the array's
 * length, so eight frames, twenty or fifty need no edit anywhere.
 *
 * ⚠ THE MAIN FRAME IS AN <a href> INTO THE LIGHTBOX, not a button. Without
 * JavaScript the link still opens the photograph — the reader loses the viewer,
 * not the picture. The consumer must drop <Lightbox /> once on the page.
 *
 * INTERACTION, all of it: prev/next buttons, thumbnail click, ArrowLeft and
 * ArrowRight while the slider holds focus, and touch swipe with a 45px
 * threshold. Keyboard is scoped to the component so a page with two sliders
 * does not drive both from one key press.
 */
import { Picture } from 'astro:assets';
import '../../../styles/slider.css';
import SmartImage from '../../ui/SmartImage.astro';

export interface PhotoItem {
  src: ImageMetadata;
  alt: string;
  caption: string;
}

interface Props {
  items: readonly PhotoItem[];
  /** Accessible name for the whole slider. */
  label: string;
  /** Sizes hint for the large frame. */
  sizes?: string;
  id: string;
}

const { items, label, sizes = '(max-width: 1023px) 92vw, 46vw', id } = Astro.props;
const total = String(items.length).padStart(2, '0');
---

<div class="sl-photo" data-sl-photo role="group" aria-roledescription="carousel" aria-label={label} tabindex="0">
  <div class="sl-photo__wrap">
    {/* ⚠ ONE ANCHOR PER FRAME, and every one carries data-lb-open — so the
        viewer's own prev/next walks the same set in the same order. */}
    <div class="sl-photo__stage">
      <p class="sl-photo__n" aria-live="polite">
        <b data-sl-now>01</b> / {total}
      </p>

      {items.map((it, i) => (
        <a
          class:list={['sl-photo__frame', i === 0 && 'is-on']}
          data-sl-frame
          data-lb-open
          href={it.src.src}
          data-lb-alt={it.alt}
          data-lb-cap={it.caption}
          aria-hidden={i === 0 ? undefined : 'true'}
          tabindex={i === 0 ? undefined : '-1'}
        >
          <SmartImage
            file={it.src}
            alt={it.alt}
            fallbackWidth={1100}
          />
        </a>
      ))}

      <div class="sl-photo__nav">
        <button type="button" class="sl-btn" data-sl-prev aria-controls={id}>
          <span class="u-visually-hidden">Previous photograph</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button type="button" class="sl-btn" data-sl-next aria-controls={id}>
          <span class="u-visually-hidden">Next photograph</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </div>

    <p class="sl-photo__cap" data-sl-cap>{items[0]?.caption}</p>

    <ul class="sl-photo__thumbs" id={id}>
      {items.map((it, i) => (
        <li>
          <button type="button" class="sl-thumb" data-sl-thumb aria-current={i === 0 ? 'true' : 'false'}>
            <span class="u-visually-hidden">Show photograph {i + 1}: {it.caption}</span>
            <SmartImage
              file={it.src}
              alt=""
              sizes="92px"
              fallbackWidth={1100}
              loading="lazy"
            />
          </button>
        </li>
      ))}
    </ul>
  </div>
</div>

<script>
  /* EVERY PHOTO SLIDER ON THE PAGE, wired independently.

     ⚠ SCOPED KEYBOARD. A page may carry two of these; a document-level key
     handler would drive both from one press. Each slider listens on itself and
     only responds while it holds focus. */
  document.querySelectorAll<HTMLElement>('[data-sl-photo]').forEach((root) => {
    const frames = Array.from(root.querySelectorAll<HTMLElement>('[data-sl-frame]'));
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-sl-thumb]'));
    const now = root.querySelector<HTMLElement>('[data-sl-now]');
    const cap = root.querySelector<HTMLElement>('[data-sl-cap]');
    const prev = root.querySelector<HTMLButtonElement>('[data-sl-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-sl-next]');
    if (frames.length < 2) {
      prev?.setAttribute('hidden', '');
      next?.setAttribute('hidden', '');
      return;
    }

    let i = 0;

    const show = (to: number) => {
      /* Wraps, so the run never dead-ends on a set the reader is browsing. */
      i = (to + frames.length) % frames.length;

      frames.forEach((f, n) => {
        const on = n === i;
        f.classList.toggle('is-on', on);
        if (on) {
          f.removeAttribute('aria-hidden');
          f.removeAttribute('tabindex');
        } else {
          f.setAttribute('aria-hidden', 'true');
          f.setAttribute('tabindex', '-1');
        }
      });
      thumbs.forEach((t, n) => t.setAttribute('aria-current', n === i ? 'true' : 'false'));

      if (now) now.textContent = String(i + 1).padStart(2, '0');
      if (cap) cap.textContent = thumbs[i]?.querySelector('span')?.textContent?.split(': ')[1] ?? '';

      /* ⚠ SCROLL THE STRIP, NOT THE ELEMENT. `scrollIntoView({block:'nearest'})`
         also scrolls the PAGE to bring the thumbnail into the viewport, so
         paging through the slider dragged the whole document up and down under
         the reader. Setting the strip's own scrollLeft touches nothing else. */
      const strip = thumbs[i]?.parentElement?.parentElement;
      if (strip instanceof HTMLElement) {
        const t = thumbs[i].getBoundingClientRect();
        const s = strip.getBoundingClientRect();
        if (t.left < s.left || t.right > s.right) {
          strip.scrollTo({ left: strip.scrollLeft + (t.left - s.left) - (s.width - t.width) / 2, behavior: 'smooth' });
        }
      }
    };

    prev?.addEventListener('click', () => show(i - 1));
    next?.addEventListener('click', () => show(i + 1));
    thumbs.forEach((t, n) => t.addEventListener('click', () => show(n)));

    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); show(i - 1); }
      if (e.key === 'ArrowRight') { e.preventDefault(); show(i + 1); }
    });

    /* Touch swipe. 45px threshold, and the vertical test stops a diagonal
       page-scroll from being read as a swipe. */
    let x0 = 0;
    let y0 = 0;
    root.addEventListener('touchstart', (e) => {
      x0 = e.changedTouches[0].clientX;
      y0 = e.changedTouches[0].clientY;
    }, { passive: true });
    root.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - x0;
      const dy = e.changedTouches[0].clientY - y0;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) show(dx < 0 ? i + 1 : i - 1);
    }, { passive: true });
  });
</script>
