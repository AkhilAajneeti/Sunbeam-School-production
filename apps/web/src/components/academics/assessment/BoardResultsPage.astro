---
/**
 * ACADEMICS · BOARD RESULTS — five sections.
 *
 * ⚠⚠ NO RESULT IS ESTIMATED, INFERRED OR ILLUSTRATED. The site audit records
 * board results as "no pass %, no toppers, no year-on-year data". The original
 * client brief asked for a "98% Board Results" counter. It is not here and must
 * never be: a school's results are the one number a family will act on, and an
 * invented one would be indistinguishable from a measured one.
 *
 * ⚠ THE CARDS IN SECTION 01 CARRY THE ABSENCE, NOT A STATISTIC. The design
 * brief asks for a floating "Results not published" panel listing "no pass
 * percentage, no toppers list, no rank holders, no year-on-year data". Every one
 * of those four lines is a true statement about the record — which is what makes
 * the panel safe. Nothing in the composition holds a number the school has not
 * printed.
 *
 * ═══ WHAT THE SCHOOL DOES PUBLISH ABOUT OUTCOMES ═══════════════════════════
 *   CUET (UG) 2025 — result cards per student, with NTA scores and subject
 *     percentiles, across PCM, Commerce and Humanities.
 *   "Vision To Reality" placement board, session 2024-25 — eighteen named
 *     leavers with course and institution; ten at University of Delhi colleges,
 *     three at BHU.
 * Neither is a board result, and neither is presented as one. A parent who came
 * here for evidence of where students end up should not leave empty-handed.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · IVORY  50/50. Copy left; the right column is a full layered
 *               composition — ghost %, two photographs, the absence panel, a
 *               board card, ghost XII and X, orange connector lines and dots.
 *   02 · PAPER  the layered collage crosses LEFT, copy right.
 *   03 · CREAM  a four-item information strip on thin vertical rules.
 *   04 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';

import { getAcademicTopic } from '../../../lib/cms';
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';

const ac = await getAcademicTopic('/academics/board-results/');
const pExam = ac.pic('pExam');
const pCampus = ac.pic('pCampus');
const pLib = ac.pic('pLib');
const pBench = ac.pic('pBench');
const pCohort = ac.pic('pCohort');

const S = 'Sunbeam School Ballia';

/**
 * ═══ THE PAGE'S PROSE, FROM THE CMS ════════════════════════════════════════
 *
 * ⚠⚠ THIS PAGE MOST OF ALL. It states in the school's own words that no board
 * results are published — so the day the school DOES publish them, this whole
 * position has to be rewritten. Until now that meant a developer.
 *
 * ⚠ THE CROSS-LINKS MOVED INTO THE COPY as [label](/href), so an editor
 * rewording a sentence keeps its link instead of leaving a dangling phrase.
 */
const open = ac.section('boardOpen');
const panel = ac.section('boardPanel');
const does = ac.section('boardDoes');
const foot = ac.section('boardFoot');
const close = ac.section('boardClose');

/* AsClose takes the two halves of its heading separately. */
const [closeLead = '', closeAccent = ''] = (close.heading ?? '').split('\n');

/* ── SECTION 01 — the four absences. Every line is a true statement about the
   record, checked one at a time. ────────────────────────────────────────── */
const absent = ac.section('absent').points;

/* ── SECTION 03 — the information strip ─────────────────────────────────── */
const strip = ac.section('strip').points;
---

{/* ══ 01 · NO PASS RATE. NO TOPPERS. ═════════════════════════════════════════
    Ground: warm ivory over a fine grid.

    ⚠ THE RIGHT COLUMN IS A COMPOSITION, NOT A GAP. The brief's first note is
    that this section must not have an empty right side, and it is right: a page
    whose subject is an absence looks unfinished if it is also visually empty.
    The layers below are ghost %, a photograph, a second photograph, the absence
    panel, a board card, ghost XII and X, connector lines and a dot field. */}
<section class="as-sec as-sec--ivory as-pad br-open" aria-labelledby="br-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-grid" aria-hidden="true"></span>

  <div class="u-container br-open__grid">
    <div class="br-open__copy">
      <span class="br-open__tick" aria-hidden="true"></span>

      <p class="as-kicker" data-reveal>{open.eyebrow}</p>
      <ClipHeading class="as-h as-h--xl br-open__h" id="br-open-t" text={open.heading} />

      <RichLine class="as-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="as-body" text={open.body[1]} reveal revealDelay={260} />
      <RichLine class="as-body" text={open.body[2]} reveal revealDelay={320} />
    </div>

    {/* ⚠ EVERY LAYER IS DECORATION OR A TRUE STATEMENT. No element in this
        composition carries a figure the school has not printed. */}
    <div class="br-stage" aria-hidden="false">
      <span class="br-stage__pc" aria-hidden="true" data-drift>%</span>
      <span class="br-stage__xii" aria-hidden="true" data-drift>XII</span>
      <span class="br-stage__x" aria-hidden="true" data-drift>X</span>
      <span class="as-dots br-stage__dots" aria-hidden="true"></span>

      <svg class="br-stage__wires" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none" aria-hidden="true">
        <g stroke="currentColor" stroke-width="0.3" stroke-linecap="round">
          <path d="M2 26h30a3 3 0 0 1 3 3v10" stroke-dasharray="1.4 2.2" />
          <path d="M98 18H72a3 3 0 0 0-3 3v22" stroke-dasharray="1.4 2.2" />
          <path d="M8 78h22a3 3 0 0 0 3-3V62" stroke-dasharray="1.4 2.2" />
        </g>
        <circle cx="35" cy="40" r="0.9" fill="currentColor" />
        <circle cx="69" cy="44" r="0.9" fill="currentColor" />
        <circle cx="33" cy="61" r="0.9" fill="currentColor" />
      </svg>

      <div class="br-stage__lead as-frame as-fill" data-pop>
        <SmartImage
          file={pExam}
          alt={ac.picAlt('pExam')}
         
          widths={[420, 760]}
          sizes="(max-width: 1023px) 60vw, 26vw"
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="br-stage__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="140">
        <SmartImage
          file={pCampus}
          alt={ac.picAlt('pCampus')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </div>

      {/* The absence panel. Four lines, each of them checkable. */}
      <div class="br-panel" data-pop data-pop-delay="240">
        <p class="br-panel__k">{panel.eyebrow}</p>
        <ul class="br-panel__list">
          {absent.map((a) => (
            <li>
              <span class="br-panel__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[a.mark]} />
                </svg>
              </span>
              {a.k}
            </li>
          ))}
        </ul>
      </div>

      <div class="br-board" data-pop data-pop-delay="340">
        <span class="br-board__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.cap} />
          </svg>
        </span>
        <span class="br-board__t">
          <span class="br-board__lab">Boards</span>
          <span class="br-board__k">CBSE</span>
          <span class="br-board__v">Class X &amp; XII</span>
        </span>
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · WHAT THE SCHOOL DOES PUBLISH ══════════════════════════════════════
    Ground: white. The layered collage crosses LEFT, the copy right. */}
<section class="as-sec as-sec--paper as-pad br-does" aria-labelledby="br-does-t">
  <div class="u-container br-does__grid">
    <figure class="br-does__stage">
      <span class="as-dots br-does__dots" aria-hidden="true"></span>
      <div class="br-does__lead as-frame as-fill" data-zoom data-zoom-to="1.04">
        <SmartImage
          file={pLib}
          alt={ac.picAlt('pLib')}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="br-does__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={pBench}
          alt={ac.picAlt('pBench')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 19vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="br-does__copy">
      <p class="as-kicker" data-reveal>{does.eyebrow}</p>
      <ClipHeading class="as-h as-h--lg" id="br-does-t" text={does.heading} />
      <RichLine class="as-body" text={does.body[0]} reveal revealDelay={200} />
      <RichLine class="as-body" text={does.body[1]} reveal revealDelay={260} />
      <RichLine class="as-body" text={does.body[2]} linkClass="as-link" reveal revealDelay={320} />
    </div>
  </div>
</section>

{/* ══ 03 · THE INFORMATION STRIP ═════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm br-strip" aria-label="What is and is not published">
  <div class="u-container">
    <ol class="br-strip__band">
      {strip.map((s, i) => (
        <li class="br-scell" data-reveal data-reveal-delay={120 + i * 90}>
          <span class="br-scell__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <p class="br-scell__n t-tabular">{s.n}</p>
          <h3 class="br-scell__k">{s.k}</h3>
          <p class="br-scell__v">{s.v}</p>
        </li>
      ))}
    </ol>
    <RichLine class="as-note br-strip__foot" text={foot.body[0]} linkClass="as-link" reveal revealDelay={440} />
  </div>
</section>

<AsClose
  id="br-close-t"
  kicker={close.eyebrow}
  lead={closeLead}
  accent={closeAccent.replace(/^\{\{|\}\}$/g, '')}
  body={close.body[0]}
  photo={pCohort}
  position="50% 38%"
/>

<style>
  /* ═══ 01 · NO PASS RATE. NO TOPPERS. ══════════════════════════════════════ */
  .br-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .br-open__copy { position: relative; padding-left: clamp(14px, 1.8vw, 26px); }
  /* The thin orange tick the reference runs down the copy's left edge. */
  .br-open__tick {
    position: absolute;
    top: 4px;
    bottom: 4px;
    left: 0;
    width: 1px;
    background: linear-gradient(to bottom, transparent, color-mix(in srgb, var(--sb-violet) 40%, transparent) 12%, color-mix(in srgb, var(--sb-violet) 40%, transparent) 88%, transparent);
  }
  .br-open__tick::before,
  .br-open__tick::after {
    content: '';
    position: absolute;
    left: -2.5px;
    width: 6px;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-orange-bright);
  }
  .br-open__tick::before { top: 8%; }
  .br-open__tick::after { bottom: 8%; }
  .br-open__h { max-width: 12ch; }

  /* ── THE LAYERED COMPOSITION ────────────────────────────────────────────
     ⚠ EVERY PIECE IS PLACED IN PERCENTAGES OF ONE STAGE, so the whole thing
     scales as a unit and nothing has to be re-tuned per breakpoint. */
  .br-stage {
    position: relative;
    aspect-ratio: 1 / 0.92;
    color: rgba(201, 60, 10, 0.4);
  }
  .br-stage__wires { position: absolute; inset: 0; width: 100%; height: 100%; }
  .br-stage__dots { top: 30%; left: -2%; width: clamp(70px, 8vw, 120px); }

  .br-stage__pc,
  .br-stage__xii,
  .br-stage__x {
    position: absolute;
    font-family: var(--sb-font-display);
    font-weight: 700;
    line-height: 0.82;
    letter-spacing: -0.06em;
    pointer-events: none;
    user-select: none;
  }
  .br-stage__pc { top: 2%; left: 6%; font-size: clamp(96px, 13vw, 210px); color: rgba(255, 138, 92, 0.3); }
  .br-stage__xii { top: 6%; right: 2%; font-size: clamp(42px, 5.4vw, 86px); color: rgba(255, 138, 92, 0.36); }
  .br-stage__x { bottom: 6%; right: 8%; font-size: clamp(38px, 4.8vw, 78px); color: rgba(255, 138, 92, 0.32); }

  .br-stage__lead {
    position: absolute;
    top: 16%;
    left: 26%;
    width: 46%;
    aspect-ratio: 4 / 3;
  }
  .br-stage__sm {
    position: absolute;
    top: 46%;
    left: 6%;
    width: 42%;
    aspect-ratio: 16 / 11;
    border: 5px solid #f7f0ea;
  }

  .br-panel {
    position: absolute;
    top: 26%;
    right: 0;
    width: 52%;
    padding: clamp(12px, 1.4vw, 18px) clamp(13px, 1.5vw, 19px) clamp(13px, 1.6vw, 20px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card-hover);
  }
  .br-panel__k {
    margin: 0 0 clamp(8px, 1vw, 12px);
    padding-bottom: clamp(7px, 0.9vw, 11px);
    border-bottom: 1px solid var(--sb-border);
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.98vw, 15.5px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sb-violet);
  }
  .br-panel__list { display: grid; gap: clamp(6px, 0.8vw, 10px); margin: 0; padding: 0; list-style: none; }
  .br-panel__list li {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(7px, 0.9vw, 11px);
    align-items: center;
    font-size: clamp(9.5px, 0.72vw, 11.4px);
    line-height: 1.5;
    color: var(--sb-text-secondary);
  }
  .br-panel__m {
    display: grid;
    place-items: center;
    width: clamp(20px, 1.9vw, 26px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
  }
  .br-panel__m svg { width: 56%; height: auto; }

  .br-board {
    position: absolute;
    right: 12%;
    bottom: 12%;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(9px, 1.1vw, 13px);
    align-items: center;
    padding: clamp(10px, 1.2vw, 14px) clamp(13px, 1.5vw, 18px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
  }
  .br-board__m {
    display: grid;
    place-items: center;
    width: clamp(28px, 2.6vw, 36px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
  }
  .br-board__m svg { width: 54%; height: auto; }
  .br-board__t { display: grid; gap: 1px; }
  .br-board__lab { font-size: clamp(8px, 0.6vw, 9.5px); font-weight: 700; letter-spacing: 0.13em; text-transform: uppercase; color: var(--sb-text-muted); }
  .br-board__k {
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.05vw, 17px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }
  .br-board__v { font-size: clamp(9px, 0.66vw, 10.5px); color: var(--sb-text-muted); }

  /* ═══ 02 · WHAT THE SCHOOL DOES PUBLISH ═══════════════════════════════════ */
  .br-does__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .br-does__stage { position: relative; margin: 0; padding-bottom: clamp(28px, 3.2vw, 50px); }
  .br-does__dots { bottom: 0; left: 12%; }
  .br-does__lead { width: 84%; aspect-ratio: 16 / 11; }
  .br-does__sm {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 4 / 3;
    border: 5px solid var(--sb-paper);
  }

  /* ═══ 03 · THE INFORMATION STRIP ══════════════════════════════════════════ */
  .br-strip__band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .br-scell { padding: 0 clamp(12px, 1.5vw, 24px); }
  .br-scell:first-child { padding-left: 0; }
  .br-scell:last-child { padding-right: 0; }
  .br-scell + .br-scell { border-left: 1px solid color-mix(in srgb, var(--sb-charcoal) 12%, transparent); }
  .br-scell__m { display: block; width: clamp(24px, 2.3vw, 32px); color: var(--sb-violet); }
  .br-scell__m svg { display: block; width: 100%; height: auto; }
  .br-scell__n {
    margin: clamp(9px, 1.1vw, 14px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(22px, 2.3vw, 34px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-orange-bright);
  }
  .br-scell__k {
    margin: clamp(5px, 0.7vw, 9px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.1vw, 17px);
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .br-scell__v {
    margin: clamp(5px, 0.7vw, 9px) 0 0;
    font-size: clamp(10px, 0.76vw, 12px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }
  .br-strip__foot { max-width: none; margin-top: clamp(20px, 2.4vw, 30px); padding-top: clamp(14px, 1.6vw, 20px); border-top: 1px solid color-mix(in srgb, var(--sb-charcoal) 12%, transparent); }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1023px) {
    .br-open__grid,
    .br-does__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(30px, 4.4vw, 44px); }
    .br-does__stage { order: -1; }
    .br-open__h { max-width: none; }
    .br-strip__band { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(22px, 3vw, 30px); }
    .br-scell:nth-child(odd) { padding-left: 0; border-left: 0; }
  }

  @media (max-width: 767px) {
    /* ⚠ THE COMPOSITION UNSTACKS RATHER THAN SHRINKS. Six absolutely-positioned
       layers inside a 340px column is a pile, not a composition — so the two
       cards come out of the stage and sit under it as a normal pair. */
    /* ⚠ THE STAGE GIVES UP ITS RATIO HERE. Two children become static, and a
       static child cannot lay out inside a box whose height an aspect-ratio has
       already decided — it simply overflows it. */
    .br-stage { aspect-ratio: auto; }
    .br-stage__wires,
    .br-stage__sm,
    .br-stage__x,
    .br-stage__dots { display: none; }
    .br-stage__lead { position: relative; top: auto; left: auto; width: 100%; aspect-ratio: 4 / 3; }
    .br-stage__pc { top: -6%; left: 2%; font-size: clamp(80px, 26vw, 130px); }
    .br-stage__xii { top: 0; right: 0; font-size: clamp(34px, 11vw, 58px); }
    .br-panel { position: static; width: 100%; margin-top: clamp(12px, 3.4vw, 18px); }
    .br-board { position: static; width: max-content; margin-top: clamp(10px, 3vw, 14px); }

    .br-does__lead { width: 100%; aspect-ratio: 5 / 4; }
    .br-does__sm { width: 48%; }
    .br-does__stage { padding-bottom: clamp(30px, 8vw, 42px); }

    .br-strip__band { grid-template-columns: minmax(0, 1fr); }
    .br-scell { padding: 0; }
    .br-scell + .br-scell { padding-top: clamp(16px, 4.4vw, 22px); border-left: 0; border-top: 1px solid color-mix(in srgb, var(--sb-charcoal) 12%, transparent); }
  }
</style>
