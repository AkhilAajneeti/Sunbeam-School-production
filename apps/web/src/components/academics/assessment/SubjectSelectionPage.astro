---
/**
 * STUDENT SUCCESS · SUBJECT SELECTION GUIDANCE — six sections.
 *
 * ⚠ THE FOUR STREAMS ARE THE PAGE, and the counselling photograph supports them
 * rather than competing. That is the brief's own instruction and it is also the
 * honest hierarchy: the streams are published, the procedure around them is not.
 *
 * ═══ SOURCE — verified in this repository and on the school's own artwork ═══
 *   The four streams: PCM, PCB, Commerce, Humanities (data/site.ts school.streams).
 *   Career counselling is run for CLASS X & XI — read off the school's own
 *     hand-painted banner in its published photographs. Class X is the year
 *     before the choice; Class XI is the year it lands.
 *   The on-campus career counselling desk covers "subject choice, stream
 *     selection and university guidance" (data/facilities.ts).
 *   CUET (UG) 2025 results published for all three of PCM, Commerce and
 *     Humanities — the choice is followed as far as the entrance paper.
 *   Guiding Futures, Shaping Lives — Classes IX–XII.
 *
 * ⚠⚠ NO SUBJECT COMBINATION APPEARS ON THIS PAGE. The brief is explicit ("do not
 * invent subject combinations… if exact combinations are not published, do not
 * manufacture them"), and the reference art it ships with is ANOTHER SCHOOL'S
 * stream-selection proforma — Adriel High School, powered by Pratap
 * International. Copying that table would have printed a different school's
 * curriculum under Sunbeam's name. The four stream names are named here and the
 * elective lists are left to Subject Combinations, which carries them with
 * confidence labels attached.
 *
 * ⚠ SECTION 05 IS DELIBERATELY HALF PHOTOGRAPH, HALF TYPE. The school publishes
 * a physics laboratory and a biology laboratory, so PCM and PCB get a real room
 * captioned as a room. It publishes no commerce room and no humanities room, so
 * those two are typographic — which is the brief's own fallback ("use a minimal
 * typographic composition instead") and is more honest than a library photo
 * standing in for a stream. ASSET REQUEST: teaching spaces for Commerce and
 * Humanities.
 *
 * ⚠ NO SECOND IMAGE SLIDER. The brief allows one "if multiple authentic
 * photographs are available". They are — but they are the same eight frames the
 * Career Guidance page already carries as its main feature, and repeating them
 * here would pad this page with another page's evidence.
 *
 * ⚠ NOT CLAIMED: an aptitude test, a psychometric instrument, a deadline, or a
 * procedure for changing stream. None is published.
 *
 * ═══ COMPOSITION — six sections, six different builds ══════════════════════
 *   01 · PAPER  copy left, the four streams right on one drawn orange route.
 *   02 · CREAM  the collage crosses LEFT, copy right over a checked list.
 *   03 · IVORY  the decision process — four numbered beats on short rules.
 *   04 · PAPER  the four streams again, as a visual story: two rooms, two
 *               typographic panels.
 *   05 · PHOTO  the cinematic close.
 */
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsRail from './AsRail.astro';
import AsClose from './AsClose.astro';
import { getSchool } from '../../../lib/cms';

import { getAcademicTopic } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const ac = await getAcademicTopic('/academics/student-success/subject-selection/');
const pDesk = ac.pic('pDesk');
const pTalk = ac.pic('pTalk');
const pCohort = ac.pic('pCohort');

const sb = await getSchool();

const S = 'Sunbeam School Ballia';
const streams = ac.section('streams').facts;

const COMBINATIONS = '/academics/structure/subject-combinations/';
const CAREER = '/academics/student-success/career-guidance/';
const UNIVERSITY = '/academics/student-success/university-counselling/';
const SENIOR = '/academics/structure/senior-secondary/';

/* ── SECTION 01 — the four routes ────────────────────────────────────────
   ⚠ NAMES AND A DESCRIPTION OF WHAT THE STREAM IS, never a subject list. The
   descriptions below restate the stream's own definition — PCM *is* Physics,
   Chemistry and Mathematics — and stop there. */
const routes = ac.section('routes').points;

/* ── SECTION 02 — what the desk actually covers ──────────────────────────── */
const covered = ac.section('covered').facts;

/* ── SECTION 03 — before the choice ──────────────────────────────────────── */
const process = ac.section('process').points;

/* ── SECTION 04 — the visual story. `art: null` means no room is published. */
const visual = ac.section('visual').points;
---

{/* ══ 01 · ONE CHOICE, MADE ONCE ═════════════════════════════════════════════
    Ground: white. Copy left, and the four streams right on a single drawn
    orange route — the page's main visual feature, and not four cards. */}
<section class="as-sec as-sec--paper as-pad ss-routes" aria-labelledby="ss-routes-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container ss-routes__grid">
    <div class="ss-routes__head">
      <p class="as-kicker" data-reveal>Four routes</p>
      <h2 class="as-h as-h--lg" id="ss-routes-t">
        <span data-clip data-clip-delay="0">One choice,</span>
        <span data-clip data-clip-delay="150"><em>made once</em></span>
      </h2>
      <p class="as-body ss-routes__b" data-reveal data-reveal-delay="200">
        Sunbeam Ballia teaches four streams to CBSE board level, and guides Classes X and XI through
        choosing between them. It is the only decision on a student’s timetable that cannot easily be
        undone — which is why the guidance sits in Class X rather than in Class XI.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="270">
        What each stream <em>contains</em> — and how far each of those lists can be relied on — is on
        {' '}<a class="as-link" href={COMBINATIONS}>Subject Combinations</a>, where the verified and
        the unverified are labelled. No combination is restated here.
      </p>
    </div>

    <div class="ss-routes__rail">
      <AsRail steps={routes} ground="paper" label="The four senior-secondary streams" class="ss-routes__inner" />
    </div>
  </div>
</section>

{/* ══ 02 · A DESK, A LAPTOP AND ONE STUDENT ══════════════════════════════════
    Ground: warm cream. The collage crosses LEFT, the copy right. */}
<section class="as-sec as-sec--cream as-pad ss-desk" aria-labelledby="ss-desk-t">
  <div class="u-container ss-desk__grid">
    <figure class="ss-desk__stage">
      <span class="as-dots ss-desk__dots" aria-hidden="true"></span>
      <div class="ss-desk__lead as-frame as-fill" data-mask>
        <SmartImage
          file={pDesk}
          alt={ac.picAlt('pDesk')}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="ss-desk__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={pTalk}
          alt={ac.picAlt('pTalk')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>

    <div class="ss-desk__copy">
      <p class="as-kicker" data-reveal>Where it is actually discussed</p>
      <h2 class="as-h as-h--lg" id="ss-desk-t">
        <span data-clip data-clip-delay="0">A desk, a laptop</span>
        <span data-clip data-clip-delay="150"><em>and one student</em></span>
      </h2>
      <p class="as-body" data-reveal data-reveal-delay="200">
        The school’s stream guidance is not an assembly. Its published photographs show single
        students at a table with a counsellor working from a laptop, papers between them, and in
        several frames a parent or elder sibling in the next chair. The banner behind reads
        <strong> “Career Counseling — Class X &amp; XI.”</strong>
      </p>

      <ul class="as-checks">
        {covered.map((c, i) => (
          <li class="as-check" data-reveal data-reveal-delay={250 + i * 70}>
            <span class="as-check__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
                <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {c}
          </li>
        ))}
      </ul>
      <p class="as-note" data-reveal data-reveal-delay="540">
        That the guidance works through to the end is checkable rather than asserted: the school
        published <strong>CUET (UG) 2025 results in all three of PCM, Commerce and Humanities</strong>
        and a board naming where those students went — set out on
        {' '}<a class="as-link" href={UNIVERSITY}>University Counselling</a>. The wider programme is
        on {' '}<a class="as-link" href={CAREER}>Career Guidance</a>.
      </p>
    </div>
  </div>
</section>

{/* ══ 03 · BEFORE THE CHOICE ═════════════════════════════════════════════════
    Ground: warm ivory. Four numbered beats, each on a short orange rule.

    ⚠ A DIFFERENT BUILD FROM SECTION 01, DELIBERATELY. Both are four-item rows;
    if both used the drawn rail with discs the page would say the same thing
    twice. These are numerals on short rules, with no discs and no through-line. */}
<section class="as-sec as-sec--ivory as-pad--sm ss-proc" aria-labelledby="ss-proc-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container ss-proc__grid">
    <div class="ss-proc__head">
      <p class="as-kicker" data-reveal>Before the choice</p>
      <h2 class="as-h as-h--md" id="ss-proc-t">
        <span data-clip data-clip-delay="0">Four steps,</span>
        <span data-clip data-clip-delay="150"><em>one direction</em></span>
      </h2>
    </div>

    <ol class="ss-steps">
      {process.map((p, i) => (
        <li class="ss-step" data-reveal data-reveal-delay={140 + i * 90}>
          <p class="ss-step__n t-tabular">{p.n}</p>
          <span class="ss-step__rule" aria-hidden="true"></span>
          <h3 class="ss-step__k">{p.k}</h3>
          <p class="ss-step__v">{p.v}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 04 · THE FOUR, IN THE BUILDING ═════════════════════════════════════════
    Ground: white.

    ⚠ TWO ROOMS AND TWO TYPOGRAPHIC PANELS, AND THE ASYMMETRY IS THE POINT. The
    school publishes a physics laboratory and a biology laboratory; it publishes
    no commerce room and no humanities room. A library photograph captioned
    "Humanities" would be a stream illustrated by a room it does not have. */}
<section class="as-sec as-sec--paper as-pad--sm ss-vis" aria-labelledby="ss-vis-t">
  <div class="u-container">
    <p class="as-kicker" data-reveal id="ss-vis-t">The four, in the building</p>

    <ol class="ss-vis__grid">
      {visual.map((v, i) => (
        <li class="ss-tile" data-pop data-pop-delay={120 + i * 90}>
          {v.art ? (
            <div class="ss-tile__art as-frame as-fit">
              <SmartImage
                file={v.art}
                alt={v.alt}
                sizes="(max-width: 767px) 92vw, 23vw"
                fallbackWidth={1100}
                loading="lazy"
              />
            </div>
          ) : (
            /* ⚠ NOT A PLACEHOLDER. A typographic panel that states the absence
               is a finished thing; a grey box with a spinner is not. */
            <div class="ss-tile__type" aria-hidden="true">
              <span class="ss-tile__glyph">{v.k}</span>
            </div>
          )}
          <h3 class="ss-tile__k">{v.k}</h3>
          <p class="ss-tile__v">{v.v}</p>
          <p class="ss-tile__cap">{v.cap}</p>
        </li>
      ))}
    </ol>

    <p class="as-note ss-vis__foot" data-reveal data-reveal-delay="520">
      Two of the four are photographed because the school publishes those rooms. It publishes no
      commerce or humanities teaching space, so neither is illustrated with one that belongs to
      something else. The stage all four lead into is
      {' '}<a class="as-link" href={SENIOR}>Senior Secondary</a>.
    </p>
  </div>
</section>

<AsClose
  id="ss-close-t"
  kicker="One year before it lands"
  lead="Class X,"
  accent="not Class XI."
  body="Subject selection is addressed before students enter the senior-secondary stage, so they choose with guidance rather than by default. The school publishes the four streams, the year groups its counselling is for and the results that follow the choice. It does not publish an aptitude test, a deadline or a procedure for changing stream."
  photo={pCohort}
  position="50% 38%"
/>

<style>
  /* ═══ 01 · ONE CHOICE, MADE ONCE ══════════════════════════════════════════ */
  .ss-routes__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(0, 1.32fr);
    gap: clamp(26px, 3.4vw, 52px);
    align-items: center;
  }
  .ss-routes__b { max-width: 36ch; }
  .ss-routes__rail { min-width: 0; }
  /* The stream name is the headline here, so it carries more weight than the
     rail's default step title. */
  .ss-routes__inner :global(.as-step__k) { font-size: clamp(16px, 1.5vw, 25px); }

  /* ═══ 02 · A DESK, A LAPTOP ═══════════════════════════════════════════════ */
  .ss-desk__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .ss-desk__stage { position: relative; margin: 0; padding-bottom: clamp(26px, 3vw, 46px); }
  .ss-desk__dots { top: -5%; left: -1%; }
  .ss-desk__lead { width: 84%; aspect-ratio: 16 / 11; }
  .ss-desk__sm {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 16 / 10;
    border: 5px solid #f3ece5;
  }

  /* ═══ 03 · BEFORE THE CHOICE ══════════════════════════════════════════════ */
  .ss-proc__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(24px, 3.2vw, 50px);
    align-items: center;
  }
  .ss-steps {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(14px, 1.8vw, 30px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .ss-step { display: grid; align-content: start; }
  .ss-step__n {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(24px, 2.5vw, 36px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-orange-bright);
  }
  /* The short orange rule the brief asks for, in place of a through-line. */
  .ss-step__rule {
    display: block;
    width: clamp(34px, 3.6vw, 54px);
    height: 2px;
    margin: clamp(10px, 1.2vw, 15px) 0 0;
    background: var(--sb-orange-bright);
  }
  .ss-step__k {
    margin: clamp(10px, 1.2vw, 15px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(14px, 1.24vw, 20px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .ss-step__v {
    margin: clamp(5px, 0.7vw, 9px) 0 0;
    font-size: clamp(10px, 0.76vw, 12px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }

  /* ═══ 04 · THE FOUR, IN THE BUILDING ══════════════════════════════════════ */
  .ss-vis__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 24px);
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    padding: 0;
    list-style: none;
  }
  .ss-tile__art { display: block; }
  .ss-tile__art :global(img) { aspect-ratio: 4 / 3; }
  /* The typographic panel — the stream's own name, set large on a warm ground. */
  .ss-tile__type {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    border: 1px dashed color-mix(in srgb, var(--sb-violet) 30%, transparent);
    border-radius: var(--sb-r-2);
    background: linear-gradient(140deg, #fdf1e9 0%, #fff7f2 60%, #fdf1e9 100%);
  }
  .ss-tile__glyph {
    font-family: var(--sb-font-display);
    font-size: clamp(24px, 2.8vw, 42px);
    font-weight: 700;
    letter-spacing: -0.05em;
    color: transparent;
    -webkit-text-stroke: 1.4px rgba(201, 60, 10, 0.42);
  }
  .ss-tile__k {
    margin: clamp(11px, 1.3vw, 16px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(15px, 1.35vw, 22px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .ss-tile__v {
    margin: clamp(5px, 0.7vw, 9px) 0 0;
    font-size: clamp(10px, 0.76vw, 12px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }
  .ss-tile__cap {
    margin: clamp(8px, 1vw, 12px) 0 0;
    padding-top: clamp(7px, 0.9vw, 11px);
    border-top: 2px solid var(--sb-orange-bright);
    font-size: clamp(9px, 0.66vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.09em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .ss-vis__foot { max-width: none; margin-top: clamp(20px, 2.4vw, 30px); }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .ss-routes__grid,
    .ss-proc__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 32px); }
    .ss-routes__b { max-width: 62ch; }
  }

  @media (max-width: 1023px) {
    .ss-desk__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    .ss-desk__stage { order: -1; }
    .ss-steps { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(22px, 3vw, 30px); }
    .ss-vis__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(20px, 2.8vw, 28px); }
  }

  @media (max-width: 767px) {
    .ss-desk__lead { width: 100%; aspect-ratio: 5 / 4; }
    .ss-desk__sm { width: 48%; }
    .ss-desk__stage { padding-bottom: clamp(30px, 8vw, 42px); }
    .ss-steps { grid-template-columns: minmax(0, 1fr); }
    .ss-vis__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
