---
/**
 * ASSESSMENT & SUPPORT · HOMEWORK POLICY — eight sections.
 *
 * ⚠ THE SCHOOL PUBLISHES ONE SENTENCE ABOUT HOMEWORK. Homework rules govern a
 * family's evenings, so a plausible-sounding invention here would be among the
 * most damaging things this site could print. The page carries that sentence,
 * says plainly that the rest is not published, and does not describe a policy.
 *
 * ⚠ THE SECOND, BETTER PIECE OF EVIDENCE IS IN THE SCHOOL'S PHOTOGRAPHY, NOT ITS
 * TEXT. The Parents' Forum agenda is projected and legible in a published
 * photograph. Read off it:
 *
 *   "Agenda for Parents Forum: Session 2025-26, Class IX to XII"
 *     5)  Quality of assignment in Learner's Comate / Class work / Homework
 *     11) Correction of Notebooks / Learner's Comate
 *
 * That is worth more to a parent than a paragraph of homework philosophy: it is
 * the channel through which the homework question is actually answered, and it
 * is section 03.
 *
 * ⚠ "LEARNER'S COMATE" IS TRANSCRIBED, NOT INTERPRETED. It is the school's own
 * spelling on its own slide, and it is quoted rather than expanded, because what
 * the artefact is — a diary, a workbook, a portfolio — is not published.
 *
 * ⚠ SECTION 06 IS THE HONEST HALF OF THE PAGE and it is deliberately dark. Each
 * of the four things listed there was checked for and is genuinely absent from
 * the school's site: minutes per night, a per-subject rule, a weekend rule and a
 * holiday rule. Nothing was added to the list to make it look thorough.
 *
 * ⚠ NOT CLAIMED ANYWHERE: a load, a duration, a submission day, a marking
 * turnaround, or a policy document. None is published.
 *
 * ═══ COMPOSITION — eight sections, eight different builds ═══════════════════
 *   01 · IVORY  the statement, over a grid, with PATTERN set oversized behind it
 *               and a two-column published/assumed ledger beneath.
 *   02 · PAPER  the collage crosses LEFT, the agenda quoted RIGHT on rules.
 *   03 · CREAM  the four-step framework as one drawn rail.
 *   04 · IVORY  copy left, three compact cards right.
 *   05 · DARK   what the page does not pretend to know — four cells on rules.
 *   06 · PAPER  copy left, a three-frame composition right.
 *   07 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsRail from './AsRail.astro';
import AsClose from './AsClose.astro';

/* ── PHOTOGRAPHY — five genuine Sunbeam Ballia frames, each used ONCE. ────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getHomeworkPolicy } from '../../../lib/cms';

const { open, item, frame, clear, gap, ask, close } = await getHomeworkPolicy();

/* The ledger has two columns and each carries a heading. The band already spends
   both of its runs on the two columns themselves, so the headings travel
   together in its caption, one per line. */
const ledgerLabels = (open.caption ?? '').split('\n');

/* AsClose takes its headline as two props; the record stores the same two
   lines with {{…}} that every other heading uses. */
const [closeLead = '', closeAccent = ''] = (close.heading ?? '')
  .split('\n')
  .map((l) => l.replace(/^\{\{|\}\}$/g, '').trim());

const S = 'Sunbeam School Ballia';

const FORUM = '/academics/parent-partnership/parents-forum/';
const CALENDAR = '/academics/academic-calendar/';
const PTM = '/academics/assessment/parent-teacher-meetings/';
const ASSESSMENT = '/academics/assessment/';
const CONTACT = '/contact-us/';

/* ── SECTION 01 — the two columns of the ledger ───────────────────────────
   ⚠ THE LEFT COLUMN IS THE WHOLE OF WHAT IS PUBLISHED. It is one row long
   because the school's homework copy is one sentence long. */


/* ── SECTION 03 — the framework. Four steps, and each one is only as strong as
   what the school actually states; `soft` marks the two that describe a
   channel rather than a rule. */

/* ── SECTION 04 — where a parent actually looks ───────────────────────────── */

/* ── SECTION 05 — the four absences, checked one at a time ────────────────── */

/* ── SECTION 06 — the four things the channels are for ────────────────────── */
---

{/* ══ 01 · A PATTERN, NOT A POLICY ═══════════════════════════════════════════
    Ground: warm ivory over a fine grid, with PATTERN set oversized and outlined
    behind the headline. The section's job is one distinction — what the school
    publishes against what a family might otherwise assume — so it is built as
    two columns that can be read against each other. */}
<section class="as-sec as-sec--ivory as-pad hp-open" aria-labelledby="hp-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-grid" aria-hidden="true"></span>
  <span class="as-dots hp-open__dots" aria-hidden="true"></span>

  <div class="u-container hp-open__grid">
    <div class="hp-open__copy">
      <span class="as-ghost hp-open__ghost" aria-hidden="true" data-drift>Pattern</span>

      <p class="as-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="as-h as-h--xl hp-open__h" id="hp-open-t" text={open.heading} />

      <RichLine class="as-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="as-body" text={open.body[1]} reveal revealDelay={260} />
    </div>

    {/* ⚠ TWO LEDGERS, SIDE BY SIDE, AND THE LEFT ONE IS SHORTER. That asymmetry
        is the argument the section is making; padding it out would undo it. */}
    <div class="hp-ledger">
      <div class="hp-ledger__col hp-ledger__col--yes" data-reveal data-reveal-delay="200">
        <p class="hp-ledger__lab">
          <span class="hp-ledger__i" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
              <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </span>
          {ledgerLabels[0]}
        </p>
        <dl class="hp-ledger__list">
          {open.cells.map((p) => (
            <div class="hp-ledger__row">
              <dt>{p.label}</dt>
              <dd>{p.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <div class="hp-ledger__col hp-ledger__col--no" data-reveal data-reveal-delay="280">
        <p class="hp-ledger__lab">
          <span class="hp-ledger__i" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
              <path d="M8.6 12h6.8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
          </span>
          {ledgerLabels[1]}
        </p>
        <dl class="hp-ledger__list">
          {open.cellsTwo.map((a) => (
            <div class="hp-ledger__row">
              <dt>{a.label}</dt>
              <dd>{a.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · ITEM FIVE, AND ITEM ELEVEN ════════════════════════════════════════
    Ground: white. The collage crosses LEFT; the two agenda items are quoted on
    the right as the record they are, with their numbers kept. */}
<section class="as-sec as-sec--paper as-pad hp-item" aria-labelledby="hp-item-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container hp-item__grid">
    <figure class="hp-item__stage">
      <div class="hp-item__lead as-frame as-fill" data-zoom data-zoom-to="1.04">
        <SmartImage
          file={item.shots[0]?.image} alt={item.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="hp-item__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={item.shots[1]?.image} alt={item.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 50vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="hp-item__cap">{item.caption}</figcaption>
    </figure>

    <div class="hp-item__copy">
      <p class="as-kicker" data-reveal>{item.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="hp-item-t" text={item.heading} />
      <RichLine class="as-body" text={item.body[0]} reveal revealDelay={200} />

      {/* ⚠ QUOTED WITH THEIR NUMBERS, AND SPELLED AS THE SLIDE SPELLS THEM.
          "Learner's Comate" is the school's own wording and is not expanded. */}
      <ol class="hp-agenda">
        <li class="hp-agenda__row" data-reveal data-reveal-delay="250">
          <span class="hp-agenda__n t-tabular">05</span>
          <q class="hp-agenda__q">Quality of assignment in Learner’s Comate / class work / homework</q>
        </li>
        <li class="hp-agenda__row" data-reveal data-reveal-delay="320">
          <span class="hp-agenda__n t-tabular">11</span>
          <q class="hp-agenda__q">Correction of notebooks / Learner’s Comate</q>
        </li>
      </ol>

      <RichLine class="as-body" text={item.body[1]} reveal revealDelay={380} />
    </div>
  </div>
</section>

{/* ══ 03 · THE HOMEWORK FRAMEWORK ════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm hp-frame" aria-labelledby="hp-frame-t">
  <div class="u-container hp-frame__inner">
    <p class="as-kicker hp-frame__kick" data-reveal>{frame.kicker}</p>
    <ClipHeading class="as-h as-h--md hp-frame__h" id="hp-frame-t" text={frame.heading} />

    <AsRail steps={frame.cells} ground="cream" label="The homework framework, four steps" class="hp-frame__rail" />

    <RichLine class="as-note hp-frame__note" text={frame.body[0]} reveal revealDelay={480} />
  </div>
</section>

{/* ══ 04 · LESS GUESSING, MORE CLARITY ═══════════════════════════════════════
    Ground: warm ivory. Copy left, three compact cards right — the three places a
    homework question is actually answerable. */}
<section class="as-sec as-sec--ivory as-pad hp-clear" aria-labelledby="hp-clear-t">
  <span class="as-dots hp-clear__dots" aria-hidden="true"></span>

  <div class="u-container hp-clear__grid">
    <div>
      <p class="as-kicker" data-reveal>{clear.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="hp-clear-t" text={clear.heading} />
      <RichLine class="as-body" text={clear.body[0]} reveal revealDelay={200} />
    </div>

    <ul class="hp-cards">
      {clear.cells.map((p, i) => (
        <li class="hp-card" data-pop data-pop-delay={140 + i * 100}>
          <a class="hp-card__in" href={p.href}>
            <span class="hp-card__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[p.mark]} />
              </svg>
            </span>
            <h3 class="hp-card__k">{p.label}</h3>
            <p class="hp-card__v">{p.value}</p>
            <span class="hp-card__go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 05 · WHAT THE PAGE DOESN'T PRETEND TO KNOW ═════════════════════════════
    Ground: deep brown. This is the honest half of the page, and it is set as a
    statement rather than an apology: each of the four was looked for. */}
<section class="as-sec as-sec--dark as-pad--sm hp-gap" aria-labelledby="hp-gap-t">
  <span class="hp-gap__glow" aria-hidden="true"></span>

  <div class="u-container hp-gap__grid">
    <div>
      <p class="as-kicker as-kicker--dark" data-reveal>{gap.kicker}</p>
      <ClipHeading class="as-h as-h--md hp-gap__h" id="hp-gap-t" text={gap.heading} />
      <RichLine class="hp-gap__b" text={gap.body[0]} reveal revealDelay={200} />
    </div>

    <ul class="hp-gap__list">
      {gap.cells.map((u, i) => (
        <li class="hp-gcell" data-reveal data-reveal-delay={200 + i * 80}>
          <span class="hp-gcell__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[u.mark]} />
            </svg>
          </span>
          <span class="hp-gcell__k">{u.label}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 06 · ASK THE SCHOOL, NOT THE ASSUMPTION ════════════════════════════════
    Ground: white. Copy LEFT this time — the page's other image section put the
    photographs on the left, and two identical builds would read as a template. */}
<section class="as-sec as-sec--paper as-pad hp-ask" aria-labelledby="hp-ask-t">
  <div class="u-container hp-ask__grid">
    <div class="hp-ask__copy">
      <p class="as-kicker" data-reveal>{ask.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="hp-ask-t" text={ask.heading} />
      <RichLine class="as-body" text={ask.body[0]} reveal revealDelay={200} />

      <ul class="as-checks">
        {ask.cells.map((a, i) => (
          <li class="as-check" data-reveal data-reveal-delay={250 + i * 70}>
            <span class="as-check__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
                <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {a.label}
          </li>
        ))}
      </ul>
      <RichLine class="as-note" text={ask.body[1]} linkClass="as-link" reveal revealDelay={540} />
    </div>

    {/* ⚠ THREE FRAMES, NOT TWO. The other image section on this page is a lead
        plus one floater; a third frame and a different stagger is what stops the
        two reading as the same build twice. */}
    <div class="hp-ask__stage">
      <div class="hp-ask__a as-frame as-fill" data-mask data-mask-from="left">
        <SmartImage file={ask.shots[0]?.image} alt={ask.shots[0]?.alt ?? ''} widths={[480, 820]} sizes="(max-width: 1023px) 92vw, 30vw" loading="lazy" decoding="async" />
      </div>
      <div class="hp-ask__b as-frame as-frame--float as-fill" data-pop data-pop-delay="180">
        <SmartImage file={ask.shots[1]?.image} alt={ask.shots[1]?.alt ?? ''} widths={[340, 600]} sizes="(max-width: 1023px) 46vw, 18vw" loading="lazy" decoding="async" />
      </div>
      <div class="hp-ask__c as-frame as-frame--float as-fill" data-pop data-pop-delay="280">
        <SmartImage file={ask.shots[2]?.image} alt={ask.shots[2]?.alt ?? ''} widths={[340, 600]} sizes="(max-width: 1023px) 46vw, 18vw" loading="lazy" decoding="async" />
      </div>
    </div>
  </div>
</section>

<AsClose
  id="hp-close-t"
  kicker={close.kicker}
  lead={closeLead}
  accent={closeAccent}
  body={close.body[0]}
  photo={close.shots[0]?.image ?? null}
/>

<style>
  /* ═══ 01 · A PATTERN, NOT A POLICY ════════════════════════════════════════ */
  .hp-open__dots { top: 10%; right: 2%; }
  .hp-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .hp-open__copy { position: relative; }
  .hp-open__ghost { top: clamp(0px, 0.4vw, 8px); left: clamp(-26px, -1.6vw, -8px); }
  :global(.hp-open__h) { max-width: 12ch; }

  .hp-ledger {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(18px, 2.4vw, 38px);
  }
  .hp-ledger__col { padding-top: clamp(13px, 1.5vw, 18px); border-top: 2px solid var(--sb-violet); }
  .hp-ledger__col--no { border-top-color: color-mix(in srgb, var(--sb-charcoal) 22%, transparent); }
  .hp-ledger__lab {
    display: flex;
    align-items: center;
    gap: 7px;
    margin: 0;
    font-size: clamp(9.5px, 0.7vw, 11px);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .hp-ledger__col--no .hp-ledger__lab { color: var(--sb-text-muted); }
  .hp-ledger__i { display: block; width: clamp(14px, 1.2vw, 17px); }
  .hp-ledger__i svg { display: block; width: 100%; height: auto; }
  .hp-ledger__list { margin: clamp(11px, 1.3vw, 16px) 0 0; }
  .hp-ledger__row + .hp-ledger__row { margin-top: clamp(10px, 1.2vw, 14px); padding-top: clamp(10px, 1.2vw, 14px); border-top: 1px solid var(--sb-border); }
  .hp-ledger__row dt {
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.95vw, 14.5px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .hp-ledger__row dd {
    margin: 3px 0 0;
    font-size: clamp(10px, 0.74vw, 11.8px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  /* ═══ 02 · ITEM FIVE, AND ITEM ELEVEN ═════════════════════════════════════ */
  .hp-item__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.04fr) minmax(0, 0.96fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .hp-item__stage { position: relative; margin: 0; padding-bottom: clamp(44px, 4.8vw, 66px); }
  .hp-item__lead { width: 82%; aspect-ratio: 16 / 11; }
  .hp-item__sm {
    position: absolute;
    right: 0;
    bottom: clamp(26px, 2.8vw, 40px);
    width: 46%;
    aspect-ratio: 16 / 9;
    border: 5px solid var(--sb-paper);
  }
  .hp-item__cap {
    position: absolute;
    inset-inline: 0;
    bottom: 0;
    max-width: 52ch;
    font-size: clamp(9.5px, 0.7vw, 11px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  /* The two quoted items, set as a record with the agenda's own numbering. */
  .hp-agenda {
    margin: clamp(17px, 2vw, 24px) 0 0;
    padding: 0;
    list-style: none;
    border-left: 2px solid var(--sb-violet);
  }
  .hp-agenda__row {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(10px, 1.2vw, 15px);
    align-items: baseline;
    padding: clamp(8px, 0.95vw, 12px) 0 clamp(8px, 0.95vw, 12px) clamp(13px, 1.5vw, 19px);
  }
  .hp-agenda__row + .hp-agenda__row { border-top: 1px solid var(--sb-border); }
  .hp-agenda__n {
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.96vw, 15px);
    font-weight: 700;
    color: var(--sb-orange-bright);
  }
  .hp-agenda__q {
    font-size: clamp(12px, 0.9vw, 14px);
    font-style: italic;
    line-height: 1.6;
    color: var(--sb-charcoal);
  }

  /* ═══ 03 · THE FRAMEWORK ══════════════════════════════════════════════════ */
  .hp-frame__inner { display: grid; grid-template-columns: minmax(0, 1fr); justify-items: center; text-align: center; }
  .hp-frame__kick { text-align: center; }
  :global(.hp-frame__h) { max-width: 20ch; }
  .hp-frame__rail { margin-top: clamp(24px, 3vw, 40px); }
  :global(.hp-frame__note) { max-width: 62ch; margin-top: clamp(18px, 2.2vw, 26px); text-align: center; }

  /* ═══ 04 · LESS GUESSING, MORE CLARITY ════════════════════════════════════ */
  .hp-clear__dots { bottom: 6%; left: 1%; }
  .hp-clear__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(24px, 3.2vw, 52px);
    align-items: center;
  }
  .hp-cards {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(11px, 1.3vw, 18px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .hp-card {
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 4px 16px -10px rgba(28, 14, 8, 0.14);
    transition: transform var(--sb-dur-image) var(--sb-ease), box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .hp-card:hover { transform: translateY(-3px); box-shadow: var(--sb-shadow-card); }
  .hp-card__in {
    display: grid;
    align-content: start;
    height: 100%;
    padding: clamp(15px, 1.7vw, 22px) clamp(13px, 1.5vw, 19px) clamp(16px, 1.9vw, 24px);
  }
  .hp-card__m { display: block; width: clamp(20px, 1.9vw, 26px); color: var(--sb-violet); }
  .hp-card__m svg { display: block; width: 100%; height: auto; }
  .hp-card__k {
    margin: clamp(10px, 1.2vw, 15px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(12.5px, 1vw, 16px);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }
  .hp-card__v {
    margin: clamp(6px, 0.7vw, 9px) 0 0;
    font-size: clamp(10px, 0.74vw, 11.8px);
    line-height: 1.62;
    color: var(--sb-text-muted);
  }
  .hp-card__go {
    display: block;
    width: clamp(18px, 1.7vw, 23px);
    margin-top: clamp(11px, 1.3vw, 16px);
    color: var(--sb-orange-bright);
    transition: translate var(--sb-dur-image) var(--sb-ease);
  }
  .hp-card__go svg { display: block; width: 100%; height: auto; }
  .hp-card:hover .hp-card__go { translate: 5px 0; }

  /* ═══ 05 · WHAT IS NOT PUBLISHED ══════════════════════════════════════════ */
  .hp-gap__glow {
    position: absolute;
    z-index: -1;
    inset: 0;
    background: radial-gradient(56% 68% at 6% 0%, rgba(255, 92, 53, 0.12) 0%, transparent 70%);
  }
  .hp-gap__grid {
    position: relative;
