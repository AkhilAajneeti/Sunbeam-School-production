---
/**
 * ASSESSMENT & SUPPORT · REMEDIAL SUPPORT — six sections.
 *
 * ⚠ THE RICHEST ASSESSMENT PAGE THE SCHOOL MAKES POSSIBLE. Its promotion policy
 * carries more substance on assessment than anything else it publishes, and this
 * page is built out of it: four dated rules and the exact classes each applies
 * to. The parent Assessment page has the six-step cycle; this one has the rules
 * that hang off step five.
 *
 * ═══ SOURCE — the school's own promotion policy, via data/academics.ts ══════
 *   A retest sits NO SOONER THAN TEN DAYS after results are announced.
 *   TWO CLEAR DAYS between retests where a student sits more than one.
 *   Results published within TWO AND A HALF WEEKS of the main examination.
 *   On a medical certificate the retest still has to be sat — a promotion is not
 *     given on the half-yearly alone.
 *   Applies in CLASSES VIII AND IX for a single subject below the threshold, and
 *     in CLASS XI where one subject is failed.
 *
 * ⚠⚠ THE CLASSES ARE VIII AND IX, NOT VI AND IX. The design brief says the
 * policy "describes retests for Classes VI–XI" and the reference mockup prints
 * "Classes VI & IX". Neither matches the reading recorded against the policy in
 * this repository, which is Classes VIII and IX plus Class XI. A class range is
 * exactly the kind of fact a family checks itself against, so the page keeps the
 * repository's reading. If the school's page has since changed, this is the one
 * line on the page to re-verify first.
 *
 * ⚠ THE THRESHOLD ITSELF IS NOT PUBLISHED. The policy says "below the
 * threshold"; it does not give the mark. No percentage appears anywhere here,
 * and section 04 says so rather than leaving the absence to be noticed.
 *
 * ⚠ THE PHOTOGRAPHS ARE OF STUDENTS ACTUALLY WORKING — sb-chem-lab shows a
 * chemistry bench in use, unlike the empty-room laboratory set. Captioned as
 * exactly that.
 *
 * ═══ COMPOSITION — six sections, six different builds ══════════════════════
 *   01 · IVORY  copy left, an overlapping two-frame composition right.
 *   02 · PEACH  the four-stage journey on a drawn rail, over SECOND CHANCE set
 *               oversized in two halves.
 *   03 · PAPER  copy left, five information rows on thin rules right.
 *   04 · CREAM  one callout — the page's single editorial statement.
 *   05 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsRail from './AsRail.astro';
import AsClose from './AsClose.astro';

/* ── PHOTOGRAPHY — three genuine Sunbeam Ballia frames, each used ONCE. ───── */
import { getAcademicTopic } from '../../../lib/cms';
import RichLine from '../../ui/RichLine.astro';

const ac = await getAcademicTopic('/academics/assessment/remedial-support/');
const pBench = ac.pic('pBench');
const pActivity = ac.pic('pActivity');
const pCohort = ac.pic('pCohort');

const S = 'Sunbeam School Ballia';

const ASSESSMENT = '/academics/assessment/';
const MENTORING = '/academics/assessment/mentoring/';
const PTM = '/academics/assessment/parent-teacher-meetings/';

/* ── SECTION 02 — the journey, in the order it happens ───────────────────── */
const journey = ac.section('journey').points;

/* ── SECTION 03 — the published rules, one row each ──────────────────────── */
const rules = ac.section('rules').points;
---

{/* ══ 01 · ONE SUBJECT, NOT THE WHOLE YEAR ═══════════════════════════════════
    Ground: warm ivory. Copy left, an overlapping two-frame composition right
    with a soft orange glow behind it. */}
<section class="as-sec as-sec--ivory as-pad rs-open" aria-labelledby="rs-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-dots rs-open__dots" aria-hidden="true"></span>

  <div class="u-container rs-open__grid">
    <div>
      <p class="as-kicker" data-reveal>Where it applies</p>
      <h2 class="as-h as-h--xl rs-open__h" id="rs-open-t">
        <span data-clip data-clip-delay="0">One subject,</span>
        <span data-clip data-clip-delay="150"><em>not the whole year.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        Remedial support at Sunbeam is attached to a subject, not to a student. It runs where a
        result in <strong>Classes VIII and IX</strong> falls below the threshold in a single subject,
        and in <strong>Class XI</strong> where one subject is failed — additional teaching in that
        subject, followed by a retest.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        The threshold mark itself is not published, and no percentage is quoted here. What
        <em>is</em> published, unusually, is the timetable the retest has to obey — and that turns out
        to be the part a family can actually use.
      </p>

      <ul class="as-strip rs-open__strip" style="--n: 3;">
        <li class="as-cell" data-reveal data-reveal-delay="320">
          <span class="as-cell__n t-tabular">10</span>
          <span class="as-cell__k">Days minimum</span>
          <span class="as-cell__v">Before a retest may sit.</span>
        </li>
        <li class="as-cell" data-reveal data-reveal-delay="380">
          <span class="as-cell__n t-tabular">02</span>
          <span class="as-cell__k">Clear days</span>
          <span class="as-cell__v">Between papers, where there are two.</span>
        </li>
        <li class="as-cell" data-reveal data-reveal-delay="440">
          <span class="as-cell__n t-tabular">2½</span>
          <span class="as-cell__k">Weeks</span>
          <span class="as-cell__v">The window results are published in.</span>
        </li>
      </ul>
    </div>

    <div class="rs-open__stage">
      <span class="rs-open__glow" aria-hidden="true"></span>
      <div class="rs-open__lead as-frame as-fill" data-mask>
        <SmartImage
          file={pBench}
          alt={ac.picAlt('pBench')}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="rs-open__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={pActivity}
          alt={ac.picAlt('pActivity')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · THE REMEDIAL JOURNEY ══════════════════════════════════════════════
    Ground: soft peach. The page's most important section.

    ⚠ THE GHOST IS SET IN TWO HALVES, ONE BEHIND THE OTHER. "SECOND" sits high
    left and "CHANCE" low right, so the word reads across the whole band without
    a single 1200px line of type crossing the four stages' descriptions. */}
<section class="as-sec as-sec--peach as-pad rs-journey" aria-labelledby="rs-journey-t">
  <span class="as-ghost rs-journey__g1" aria-hidden="true" data-drift>Second</span>
  <span class="as-ghost rs-journey__g2" aria-hidden="true" data-drift>Chance</span>

  <div class="u-container rs-journey__inner">
    <p class="as-kicker rs-journey__kick" data-reveal>The remedial journey</p>
    <h2 class="as-h as-h--md rs-journey__h" id="rs-journey-t">
      <span data-clip data-clip-delay="0">A fair <em>second chance.</em></span>
    </h2>

    <AsRail steps={journey} ground="peach" label="The remedial journey, four stages" class="rs-journey__rail" />
  </div>
</section>

{/* ══ 03 · THE PUBLISHED RULES ═══════════════════════════════════════════════
    Ground: white. Statement left, five rows on thin rules right. Every row is
    the school's own policy; nothing has been generalised into a principle. */}
<section class="as-sec as-sec--paper as-pad rs-rules" aria-labelledby="rs-rules-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container rs-rules__grid">
    <div class="rs-rules__head">
      <p class="as-kicker" data-reveal>The published rules</p>
      <h2 class="as-h as-h--lg" id="rs-rules-t">
        <span data-clip data-clip-delay="0">Support first.</span>
        <span data-clip data-clip-delay="150"><em>Then a fair retest.</em></span>
      </h2>
      <p class="as-body rs-rules__b" data-reveal data-reveal-delay="200">
        Most schools promise extra help. Few publish the calendar it has to run to. Everything on the
        right comes from that published policy, and each rule exists to stop a retest becoming a
        formality.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="270">
        <strong>Not published:</strong> the pass threshold itself, the form the additional teaching
        takes, or who delivers it. None is estimated here. The wider cycle is on
        {' '}<a class="as-link" href={ASSESSMENT}>Assessment &amp; Support</a>.
      </p>
    </div>

    <ol class="as-rows rs-rules__list">
      {rules.map((r, i) => (
        <li class="as-row" data-reveal data-reveal-delay={180 + i * 80}>
          <span class="as-row__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
            </svg>
          </span>
          <div class="as-row__t">
            <p class="as-row__k">{r.k}</p>
            <RichLine
  tag="p"
  class="as-row__v"
  text={r.v}
/>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 04 · THE CALLOUT ═══════════════════════════════════════════════════════
    ⚠ THIS IS THE PAGE'S VOICE, NOT THE SCHOOL'S, and it is deliberately not set
    inside quotation marks. It says what the four rules above add up to; putting
    it in quotes would attribute an editorial reading to the school. */}
<section class="as-sec as-sec--cream as-pad--sm rs-note" aria-label="What remedial support is for">
  <div class="u-container">
    <div class="rs-note__box" data-reveal>
      <span class="rs-note__m" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.handHeart} />
        </svg>
      </span>
      <p class="rs-note__t">
        Remedial support is about giving the student
        <em>another opportunity to learn</em> —
        <strong>not simply repeating an examination.</strong>
      </p>
      <span class="as-dots rs-note__dots" aria-hidden="true"></span>
    </div>

    <p class="as-note rs-note__foot" data-reveal data-reveal-delay="140">
      Where the difficulty is noticed rather than measured, it reaches
      {' '}<a class="as-link" href={MENTORING}>mentoring</a> first; results and next steps are
      discussed at the {' '}<a class="as-link" href={PTM}>parent–teacher meeting</a> that follows.
    </p>
  </div>
</section>

<AsClose
  id="rs-close-t"
  kicker="A retest with dates attached"
  lead="Not a second sitting,"
  accent="a second chance."
  body="The school publishes the retest calendar, the classes it applies to and the conditions around the additional teaching. It does not publish the pass threshold, the form the extra teaching takes, or who delivers it — and none of those is estimated here."
  photo={pCohort}
/>

<style>
  /* ═══ 01 · ONE SUBJECT, NOT THE WHOLE YEAR ════════════════════════════════ */
  .rs-open__dots { top: 12%; right: 1.5%; }
  .rs-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.02fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .rs-open__h { max-width: 13ch; }
  .rs-open__strip { --n: 3; }

  .rs-open__stage { position: relative; padding-bottom: clamp(26px, 3vw, 46px); }
  /* The soft orange glow the brief asks for behind the composition. */
  .rs-open__glow {
    position: absolute;
    z-index: -1;
    inset: -8% -6% -2% -4%;
    background: radial-gradient(58% 62% at 62% 40%, rgba(255, 138, 92, 0.24) 0%, transparent 72%);
  }
  .rs-open__lead { width: 84%; margin-left: auto; aspect-ratio: 16 / 11; }
  .rs-open__sm {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 44%;
    aspect-ratio: 4 / 3;
    border: 5px solid #f7f0ea;
  }

  /* ═══ 02 · THE REMEDIAL JOURNEY ═══════════════════════════════════════════ */
  .rs-journey__g1 {
    top: clamp(6px, 1.4vw, 22px);
    left: clamp(-24px, -1.4vw, -8px);
    font-size: clamp(74px, 12vw, 178px);
  }
  .rs-journey__g2 {
    bottom: clamp(-10px, -0.6vw, 0px);
    right: clamp(-24px, -1.4vw, -8px);
    font-size: clamp(74px, 12vw, 178px);
  }
  .rs-journey__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .rs-journey__kick { text-align: center; }
  .rs-journey__h em { font-style: italic; }
  .rs-journey__rail { margin-top: clamp(26px, 3.2vw, 44px); }

  /* ═══ 03 · THE PUBLISHED RULES ════════════════════════════════════════════ */
  .rs-rules__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: clamp(26px, 3.6vw, 54px);
    align-items: center;
  }
  .rs-rules__b { max-width: 36ch; }
  .rs-rules__list { margin-top: 0; }

  /* ═══ 04 · THE CALLOUT ════════════════════════════════════════════════════ */
  .rs-note__box {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: center;
    padding: clamp(20px, 2.4vw, 32px) clamp(20px, 2.4vw, 34px);
    border: 1px solid color-mix(in srgb, var(--sb-violet) 22%, transparent);
    border-radius: var(--sb-r-3);
    background: linear-gradient(120deg, #fdf1e9 0%, #fff7f2 62%, #fdf1e9 100%);
    overflow: hidden;
  }
  .rs-note__m {
    display: grid;
    place-items: center;
    width: clamp(46px, 4.6vw, 66px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet);
    color: #fff;
  }
  .rs-note__m svg { width: 52%; height: auto; }
  .rs-note__t {
    margin: 0;
    max-width: 62ch;
    font-family: var(--sb-font-display);
    font-size: clamp(15px, 1.42vw, 24px);
    font-weight: 700;
    line-height: 1.32;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .rs-note__t em { font-style: normal; color: var(--sb-violet); }
  .rs-note__t strong { font-weight: 700; }
  .rs-note__dots { top: 50%; right: 2%; translate: 0 -50%; width: clamp(60px, 6vw, 96px); }
  .rs-note__foot { max-width: 68ch; margin-top: clamp(14px, 1.7vw, 20px); }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .rs-rules__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 32px); }
    .rs-rules__b { max-width: 62ch; }
  }

  @media (max-width: 1023px) {
    .rs-open__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    .rs-open__stage { order: -1; }
    .rs-open__h { max-width: none; }
    .rs-journey__g1,
    .rs-journey__g2 { font-size: clamp(62px, 12vw, 108px); }
  }

  @media (max-width: 767px) {
    .rs-open__lead { width: 100%; aspect-ratio: 5 / 4; }
    .rs-open__sm { width: 48%; }
    .rs-open__stage { padding-bottom: clamp(30px, 8vw, 42px); }
    .rs-note__box { grid-template-columns: minmax(0, 1fr); gap: clamp(13px, 3.6vw, 18px); }
    .rs-note__dots { display: none; }
  }
</style>
