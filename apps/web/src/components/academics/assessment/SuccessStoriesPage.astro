---
/**
 * STUDENT SUCCESS · STUDENT SUCCESS STORIES — five sections.
 *
 * ⚠⚠ NO AGGREGATE, ANYWHERE ON THIS PAGE. The original client brief asked for
 * "100+ Olympiad Awards"-style counters. The school publishes no totals, so a
 * headline number here would be one we invented. What it does publish is three
 * finished award graphics and a handful of named individual results — so the
 * page is built out of those and stops where they stop.
 *
 * ═══ SOURCE — data/achievements.ts, every line published ═══════════════════
 *   RoboWunder International Robotics Championship, Kuala Lumpur — Master Deepak
 *     Kumar, 2nd place, cash prize of 1,500 USD, session 2025-26. The only
 *     international placing in the school's record.
 *   National School Innovation Ranking & Awards (CBSE) — Rank 2, Uttar Pradesh.
 *   CBSE Cluster-V Kho-Kho Girls' Championship — gold, girls' under-19, 2025;
 *     champions 2018-19 and 2019-20; hosted the championship in 2016.
 *   Indian AI Impact Festival, 2024 — Ayushi, of Class VII, placed first.
 *   Virtual Interbranch Declamation — Class IV took the top three positions
 *     across the Sunbeam group.
 *
 * ⚠ ALL THREE MAJORS ARE POSTERS, NOT PHOTOGRAPHS — designed graphics with their
 * own headline, crest and framed photograph inside. The card frame therefore
 * shows them WHOLE. Cropping one to fill a 16:10 slot removes its headline,
 * which is the part carrying the fact.
 *
 * ⚠ NO SECOND "EXPLORE MORE STORIES" SLIDER. The brief allows one "if enough
 * official content exists". It does not: there are three graphics and four named
 * placings in total, and the second rail would have had to repeat the first or
 * be padded. The four placings are the milestone row instead.
 *
 * ⚠ THE FULL RECORD IS NOT DUPLICATED HERE. Sport lives on Achievements and the
 * CUET scores on University Counselling; this page carries the three the school
 * itself chose to make artwork for, and the individual placings.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · IVORY  copy left, the three award graphics right as a card rail.
 *   02 · PAPER  the milestones, read by how far the record travelled.
 *   03 · CREAM  the contact panel, split.
 *   04 · PHOTO  the cinematic close.
 */
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';
import AsRailSlider from './AsRailSlider.astro';
import Lightbox from '../../ui/Lightbox.astro';
import { getSchool } from '../../../lib/cms';

import SmartImage from '../../ui/SmartImage.astro';
import { getAcademicTopic } from '../../../lib/cms';
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';

const ac = await getAcademicTopic('/academics/student-success/success-stories/');
const pCohort = ac.pic('pCohort');
const successStories = ac.section('successStories').stories;
const successMilestones = ac.section('successMilestones').points;

const school = await getSchool();

const S = 'Sunbeam School Ballia';
const CONTACT = '/contact-us/';

/**
 * ═══ THE PAGE'S PROSE, FROM THE CMS ════════════════════════════════════════
 *
 * ⚠ THE CROSS-LINKS MOVED INTO THE COPY as [label](/href), so an editor
 * rewording a sentence keeps its link rather than leaving a dangling phrase.
 */
const open = ac.section('successOpen');
const mile = ac.section('successMile');
const cta = ac.section('successCta');
const close = ac.section('successClose');

/* AsClose takes the two halves of its heading separately. */
const [closeLead = '', closeAccent = ''] = (close.heading ?? '').split('\n');

const phoneHref = school.phone.admissions;
const phoneShow = school.phone.admissionsDisplay;
---

{/* ══ 01 · SECOND IN THE WORLD ═══════════════════════════════════════════════
    Ground: warm ivory. Copy left, the three award graphics right as a rail.

    ⚠ THE RAIL HOLDS THREE TODAY AND HAS NO CEILING. Three cards fit the visible
    row exactly, so the arrows disable themselves and the dots hide — and a
    fourth record simply turns them back on. */}
<section class="as-sec as-sec--ivory as-pad st-open" aria-labelledby="st-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-dots st-open__dots" aria-hidden="true"></span>

  <div class="u-container">
    <div class="st-open__head">
      <div>
        <p class="as-kicker" data-reveal>{open.eyebrow}</p>
        <ClipHeading class="as-h as-h--lg st-open__h" id="st-open-t" text={open.heading} />
      </div>

      <div class="st-open__b">
        <RichLine class="as-body" text={open.body[0]} reveal revealDelay={200} />
        <RichLine class="as-note" text={open.body[1]} linkClass="as-link" reveal revealDelay={260} />
      </div>
    </div>

    <AsRailSlider
      label="Award graphics published by the school"
      id="st-rail"
      total={successStories.length}
      per={3}
      perMd={2}
      perSm={1}
      bleed
      class="st-open__rail"
    >
      {successStories.map((s) => (
        <li class="st-card">
          <div class="st-card__in">
            {/* ⚠ contain, NOT cover. A poster cropped to a 16:10 slot loses its
                headline, which is the part carrying the fact. */}
            <a
              class="st-card__art"
              data-lb-open
              href={s.image.src}
              data-lb-alt={s.alt}
              data-lb-cap={`${s.student} · ${s.title}`}
            >
              <SmartImage
                file={s.image}
                alt={s.alt}
                sizes="(max-width: 767px) 84vw, 28vw"
                fallbackWidth={1100}
                loading="lazy"
              />
              <span class="st-card__year t-tabular">{s.year}</span>
              <span class="st-card__cat">{s.category}</span>
            </a>
            <div class="st-card__body">
              <p class="st-card__k">{s.student}</p>
              <p class="st-card__t">{s.title}</p>
              <p class="st-card__loc">
                <span class="st-card__pin" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.pin} />
                  </svg>
                </span>
                {s.location}
              </p>
              <p class="st-card__v">{s.description}</p>
            </div>
          </div>
        </li>
      ))}
    </AsRailSlider>
  </div>
</section>

{/* ══ 02 · THE SAME RECORD, BY HOW FAR IT TRAVELLED ══════════════════════════
    Ground: white. Copy left, four milestones right on a numbered route.

    ⚠ THESE FOUR HAVE NO ARTWORK, WHICH IS WHY THEY ARE NOT CARDS. A card
    without an image beside three that have one reads as a card that failed to
    load. Numbered milestones read as a different kind of record. */}
<section class="as-sec as-sec--paper as-pad st-mile" aria-labelledby="st-mile-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container st-mile__grid">
    <div class="st-mile__head">
      <p class="as-kicker" data-reveal>{mile.eyebrow}</p>
      <ClipHeading class="as-h as-h--lg" id="st-mile-t" text={mile.heading} />
      <RichLine class="as-body st-mile__b" text={mile.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="st-miles">
      {successMilestones.map((m, i) => (
        <li class="st-mi" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="st-mi__n t-tabular">{m.n}</span>
          <span class="st-mi__t">
            <span class="st-mi__k">{m.k}</span>
            <span class="st-mi__v">{m.v}</span>
          </span>
          <span class="st-mi__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[m.mark]} />
            </svg>
          </span>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 03 · WANT TO KNOW MORE? ════════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm st-cta" aria-labelledby="st-cta-t">
  <div class="u-container">
    <div class="st-cta__box">
      <span class="st-cta__m" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.phone} />
        </svg>
      </span>

      <div class="st-cta__copy">
        <ClipHeading class="as-h as-h--md st-cta__h" id="st-cta-t" text={cta.heading} />
        <RichLine class="as-note st-cta__b" text={cta.body[0]} reveal revealDelay={200} />
      </div>

      <div class="st-cta__num">
        <p class="st-cta__lab">{cta.eyebrow}</p>
        <p class="st-cta__ph"><a href={`tel:${phoneHref}`}>{phoneShow}</a></p>
        <p class="st-cta__act">
          <a class="as-btn" href={CONTACT}>
            {cta.body[1]}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </a>
        </p>
      </div>
    </div>
  </div>
</section>

<AsClose
  id="st-close-t"
  kicker={close.eyebrow}
  lead={closeLead}
  accent={closeAccent.replace(/^\{\{|\}\}$/g, '')}
  body={close.body[0]}
  photo={pCohort}
  position="50% 38%"
/>

<Lightbox />

<style>
  /* ═══ 01 · SECOND IN THE WORLD ════════════════════════════════════════════ */
  .st-open__dots { top: 10%; right: 1%; }
  .st-open__head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3.2vw, 52px);
    align-items: end;
    margin: 0 0 clamp(22px, 2.8vw, 36px);
  }
  .st-open__h { max-width: 15ch; }
  .st-open__b { padding-bottom: clamp(2px, 0.4vw, 6px); }
  .st-open__b .as-body { margin-top: 0; }

  .st-card { display: flex; }
  .st-card__in {
    display: grid;
    grid-template-rows: auto 1fr;
    width: 100%;
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 4px 16px -10px rgba(28, 14, 8, 0.14);
    transition: transform var(--sb-dur-image) var(--sb-ease), box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .st-card__in:hover { transform: translateY(-3px); box-shadow: var(--sb-shadow-card); }

  /* ⚠ A POSTER SLOT, NOT A PHOTO SLOT. contain on a warm ground, so a graphic
     of any ratio sits whole inside a row of equal frames. */
  .st-card__art {
    position: relative;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.4;
    overflow: hidden;
    background: #f3ece5;
    cursor: zoom-in;
  }
  /* ⚠ THE PICTURE IS ABSOLUTE, and that is load-bearing. A centred grid item's
     `height: 100%` has no definite box to resolve against here, so the poster
     fell back to its natural height, outgrew the stage and was cropped by
     `overflow: hidden` — the exact failure `contain` was chosen to avoid.
     `inset: 0` gives it a definite box, and the image then fits inside it. */
  .st-card__art :global(picture) { position: absolute; inset: 0; display: block; }
  .st-card__art :global(img) { display: block; width: 100%; height: 100%; object-fit: contain; }
  .st-card__year {
    position: absolute;
    top: clamp(8px, 0.9vw, 11px);
    left: clamp(8px, 0.9vw, 11px);
    padding: 4px clamp(8px, 0.9vw, 11px);
    border-radius: var(--sb-r-1);
    background: var(--sb-orange-bright);
    font-size: clamp(8.5px, 0.64vw, 10px);
    font-weight: 700;
    letter-spacing: 0.08em;
    color: #fff;
  }
  .st-card__cat {
    position: absolute;
    top: clamp(8px, 0.9vw, 11px);
    right: clamp(8px, 0.9vw, 11px);
    padding: 4px clamp(8px, 0.9vw, 11px);
    border-radius: var(--sb-r-1);
    background: rgba(24, 16, 12, 0.7);
    font-size: clamp(8px, 0.6vw, 9.5px);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #fff;
  }
  .st-card__body { display: grid; align-content: start; padding: clamp(13px, 1.5vw, 18px) clamp(14px, 1.6vw, 19px) clamp(15px, 1.8vw, 22px); }
  .st-card__k {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(14px, 1.15vw, 18px);
    font-weight: 700;
    line-height: 1.18;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .st-card__t {
    margin: 4px 0 0;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    font-weight: 700;
    color: var(--sb-violet);
  }
  .st-card__loc {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-size: clamp(9.5px, 0.72vw, 11.2px);
    color: var(--sb-text-muted);
  }
  .st-card__pin { display: block; width: clamp(12px, 1.1vw, 15px); color: var(--sb-orange-bright); }
  .st-card__pin svg { display: block; width: 100%; height: auto; }
  .st-card__v {
    margin: clamp(7px, 0.85vw, 11px) 0 0;
    font-size: clamp(9.5px, 0.72vw, 11.2px);
    line-height: 1.62;
    color: var(--sb-text-muted);
  }

  /* ═══ 02 · THE MILESTONES ═════════════════════════════════════════════════ */
  .st-mile__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(26px, 3.6vw, 54px);
    align-items: center;
  }
  .st-mile__b { max-width: 42ch; }

  .st-miles {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 22px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .st-mi {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(10px, 1.2vw, 15px);
    align-items: start;
    padding: clamp(14px, 1.7vw, 21px) clamp(15px, 1.7vw, 22px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    transition: border-color var(--sb-dur-image) var(--sb-ease);
  }
  .st-mi:hover { border-color: color-mix(in srgb, var(--sb-violet) 40%, transparent); }
  .st-mi__n {
    display: grid;
    place-items: center;
    width: clamp(26px, 2.4vw, 34px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet);
    font-size: clamp(9.5px, 0.72vw, 11.4px);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
  }
  .st-mi__t { display: grid; gap: 4px; }
  .st-mi__k {
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.08vw, 17px);
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .st-mi__v { font-size: clamp(9.5px, 0.72vw, 11.4px); line-height: 1.62; color: var(--sb-text-muted); }
  .st-mi__m {
    position: absolute;
    right: clamp(12px, 1.4vw, 18px);
    bottom: clamp(12px, 1.4vw, 18px);
    display: block;
    width: clamp(20px, 1.9vw, 26px);
    color: color-mix(in srgb, var(--sb-orange-bright) 62%, transparent);
  }
  .st-mi__m svg { display: block; width: 100%; height: auto; }

  /* ═══ 03 · THE CTA ════════════════════════════════════════════════════════ */
  .st-cta__box {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    gap: clamp(18px, 2.4vw, 38px);
    align-items: center;
    padding: clamp(20px, 2.6vw, 34px) clamp(22px, 2.8vw, 40px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-3);
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
  }
  .st-cta__m {
    display: grid;
    place-items: center;
    width: clamp(42px, 4vw, 58px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
  }
  .st-cta__m svg { width: 50%; height: auto; }
  .st-cta__h { margin-top: 0; }
  .st-cta__b { max-width: 52ch; }
  .st-cta__num { display: grid; justify-items: start; padding-left: clamp(18px, 2.4vw, 38px); border-left: 1px solid var(--sb-border); }
  .st-cta__lab {
    margin: 0;
    font-size: clamp(9px, 0.68vw, 10.6px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .st-cta__ph {
    margin: 4px 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(15px, 1.35vw, 22px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .st-cta__ph a { color: inherit; }
  .st-cta__ph a:hover { color: var(--sb-violet); }
  .st-cta__act { margin: clamp(11px, 1.4vw, 18px) 0 0; }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .st-mile__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 32px); }
    .st-mile__b { max-width: 62ch; }
  }

  @media (max-width: 1023px) {
    .st-open__head { grid-template-columns: minmax(0, 1fr); gap: clamp(14px, 2vw, 20px); align-items: start; }
    .st-open__h { max-width: none; }
    .st-cta__box { grid-template-columns: auto minmax(0, 1fr); row-gap: clamp(18px, 2.6vw, 26px); }
    .st-cta__num { grid-column: 1 / -1; padding-left: 0; padding-top: clamp(16px, 2.4vw, 22px); border-left: 0; border-top: 1px solid var(--sb-border); }
  }

  @media (max-width: 767px) {
    .st-miles { grid-template-columns: minmax(0, 1fr); }
    .st-cta__box { grid-template-columns: minmax(0, 1fr); }
  }
</style>
