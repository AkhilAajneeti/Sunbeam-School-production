---
/**
 * ASSESSMENT & SUPPORT · THE CLOSE — the full-width dark photographic statement
 * that ends all seven pages.
 *
 * ⚠ IDENTICAL EVERYWHERE, ON PURPOSE. It is the family's full stop: a reader
 * moving between Homework Policy and Remedial Support should recognise the end
 * of a page without reading it. Only the photograph, the two lines and the
 * paragraph change.
 *
 * ⚠ THE PHOTOGRAPH IS DECORATION AND CARRIES alt="". Its subject is never the
 * claim — the claim is in the text over it — so describing it to a screen reader
 * would add noise. Every consumer passes a real Sunbeam Ballia frame.
 *
 * The scrim is a two-stop wash plus a warm radial, weighted to the middle band
 * where the headline sits; the grain is a soft-light noise tile at 0.26 that
 * stops the gradient banding on a wide display.
 */
import SmartImage from '../../ui/SmartImage.astro';
import type { StrapiFile } from '../../../lib/cms';
import '../../../styles/assessment.css';

interface Props {
  /** Small orange label above the headline. */
  kicker: string;
  /** Headline, in two halves — the second is set orange and italic. */
  lead: string;
  accent: string;
  /** One paragraph. Usually the "and here is what is NOT published" line. */
  body: string;
  /**
   * WARNING: EITHER SOURCE, BECAUSE THE PHOTOGRAPH IS NOW CONTENT.
   * Eighteen pages close with this band and every one of them now hands over a
   * Strapi file from its own record; the local shape stays accepted so a caller
   * outside academics is not forced to migrate to keep using the band.
   */
  photo: StrapiFile | ImageMetadata | null;
  /** object-position, to hold the focal point through a wide crop. */
  position?: string;
  /**
   * Set both halves of the headline on ONE line. The default stacks them, which
   * suits a long statement; a short one — "Answered to the room." — reads as a
   * single sentence and breaking it in two makes it look like two.
   */
  inline?: boolean;
  id: string;
}

const { kicker, lead, accent, body, photo, position = '50% 42%', inline = false, id } = Astro.props;
---

<section class:list={['as-close', inline && 'as-close--inline']} aria-labelledby={id}>
  <div class="as-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <SmartImage
      file={photo}
      alt=""
      widths={[1024, 1600, 2000]}
      fallbackWidth={1600}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      style={`object-position: ${position};`}
    />
  </div>
  <span class="as-close__scrim" aria-hidden="true"></span>
  <span class="as-close__grain" aria-hidden="true"></span>

  <div class="u-container as-close__inner">
    <p class="as-kicker as-kicker--dark" data-reveal>{kicker}</p>
    <h2 class="as-h as-close__h" id={id}>
      <span data-clip data-clip-delay="0">{lead}</span>
      <span data-clip data-clip-delay="150"><em>{accent}</em></span>
    </h2>
    <p class="as-close__b" data-reveal data-reveal-delay="180" set:html={body} />
  </div>
</section>
