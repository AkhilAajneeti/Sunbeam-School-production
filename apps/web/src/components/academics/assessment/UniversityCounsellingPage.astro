---
/**
 * STUDENT SUCCESS · UNIVERSITY COUNSELLING — five sections.
 *
 * ⚠ THIS PAGE OVERTURNS A STANDING GAP. The site audit records "university
 * placements — Not mentioned". That was true of the school's TEXT; it is not
 * true of its ARTWORK. The school prints a board — "Vision To Reality, Session
 * 2024-25, Students Placed In Prestigious Colleges/Universities" — carrying
 * EIGHTEEN named students with course and institution, plus a strip of
 * individual placement cards. It is the strongest single piece of evidence in
 * the Academics section.
 *
 * ═══ SOURCE — read off the school's own published artwork ══════════════════
 *   assets/placement/ — the Vision To Reality board, session 2024-25. Counted
 *     off the board: TEN University of Delhi colleges (Miranda House, Kamala
 *     Nehru, Ram Lal Anand, Deshbandhu, Sri Aurobindo, Zakir Husain twice,
 *     Dr. B. R. Ambedkar, Satyawati, Kalindi Women's), THREE Banaras Hindu
 *     University, and five elsewhere — Galgotias, NIET and ITS Greater Noida,
 *     Dr. Ram Manohar Lohia Avadh University Ayodhya, UPES Dehradun.
 *   assets/school-event/CUET-(UG)-results/ — four "Exemplar of Excellence"
 *     cards with NTA scores and subject percentiles, and four College Placement
 *     cards, batch 2024-25. All eight are in data/studentSuccess.ts.
 *
 * ⚠ THE BOARD IS SHOWN WHOLE AND IS NEVER CROPPED. Its table IS the evidence;
 * a landscape crop would cut off the rows. `object-fit: contain` on a frame
 * that matches the artwork's own ratio, never `cover`.
 *
 * ⚠ NOT CLAIMED: a placement rate, a cohort size, an average score, or any
 * comparison between years. The board is one session's record, not a statistic
 * — and a mean of four score cards would be a number we invented.
 *
 * ═══ COMPOSITION — five sections, five different builds ════════════════════
 *   01 · IVORY  copy left, the board right at full size, into the viewer.
 *   02 · CREAM  copy left, the eight result cards right as a scrolled rail.
 *   03 · PAPER  the destinations, counted off the board, as one hairline band.
 *   04 · PHOTO  the cinematic close.
 */
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';
import AsRailSlider from './AsRailSlider.astro';
import Lightbox from '../../ui/Lightbox.astro';

import { getAcademicTopic } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const ac = await getAcademicTopic('/academics/student-success/university-counselling/');
const gBoard = ac.pic('gBoard');
const pCohort = ac.pic('pCohort');
const universityResults = ac.section('universityResults').results;

const S = 'Sunbeam School Ballia';

const BOARD_RESULTS = '/academics/board-results/';
const CAREER = '/academics/student-success/career-guidance/';
const SUBJECT = '/academics/student-success/subject-selection/';

/* ── SECTION 03 — the destinations, counted off the board ─────────────────
   ⚠ COUNTS, NOT RATES. "Ten of eighteen" is a count read off a printed table.
   A percentage would imply a cohort size the school has not published. */
const destinations = ac.section('destinations').points;
---

{/* ══ 01 · EIGHTEEN NAMES ════════════════════════════════════════════════════
    Ground: warm ivory. Copy left, the board right — large, whole, uncropped and
    clickable into the viewer.

    ⚠ THE BOARD IS THE VISUAL FOCUS, not an illustration beside text. It is the
    only artefact on this site that names eighteen destinations at once. */}
<section class="as-sec as-sec--ivory as-pad uc-board" aria-labelledby="uc-board-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container uc-board__grid">
    <div>
      <p class="as-kicker" data-reveal>Vision To Reality · Session 2024-25</p>
      <h2 class="as-h as-h--lg uc-board__h" id="uc-board-t">
        <span data-clip data-clip-delay="0">Eighteen names,</span>
        <span data-clip data-clip-delay="150"><em>and where each one went</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        Most schools describe their counselling. Sunbeam prints the result and hangs it up. The board
        beside this is the school’s own, and every line on it is a student, a course and an
        institution — <strong>eighteen of them</strong>.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        Counted off the board: <strong>ten went to a University of Delhi college</strong>,
        <strong> three went to Banaras Hindu University</strong>, and the rest to Galgotias, NIET and
        ITS in Greater Noida, Dr. Ram Manohar Lohia Avadh University in Ayodhya, and UPES Dehradun.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="320">
        The board’s own last line is <em>“Series will go on…”</em>
      </p>
      <p class="as-note" data-reveal data-reveal-delay="380">
        No placement rate appears on this page. The school publishes the destinations, not a cohort
        size — so a percentage would be one this site invented. Board results are a separate question
        and have {' '}<a class="as-link" href={BOARD_RESULTS}>their own page</a>.
      </p>
    </div>

    <figure class="uc-board__fig">
      <span class="as-dots uc-board__dots" aria-hidden="true"></span>

      {/* ⚠ contain, NOT cover, AND NO FIXED RATIO. The artwork sets its own
          height; a crop would cut the table off, and the table is the fact. */}
      <a
        class="uc-board__art"
        data-lb-open
        href={gBoard.src}
        data-lb-alt={`${S}'s printed placement board, "Vision To Reality — Session 2024-25", listing eighteen students with their course and institution`}
        data-lb-cap="The placement board · session 2024-25"
        data-pop
      >
        <SmartImage
          file={gBoard}
          alt={ac.picAlt('gBoard')}
         
          widths={[700, 1100, 1600]}
          sizes="(max-width: 1023px) 94vw, 50vw"
          loading="eager"
          decoding="async"
        />
        <span class="uc-board__zoom" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.search} />
          </svg>
        </span>
      </a>

      <figcaption class="uc-board__cap">
        <span class="uc-board__cap-k">The placement board · session 2024-25</span>
        <span class="uc-board__cap-m">18 students · 10 University of Delhi · 3 BHU</span>
        <span class="uc-board__cap-v">
          The strip along the top carries individual cards for Pranjal Singh (Dyal Singh College),
          Priyanka Maurya (Miranda House), Anshu Mishra (Sarala Birla University, Ranchi), Kritika
          Singh (Sri Aurobindo College), Ankit Singh (UPES Dehradun) and Prachi Chaurasia (Kirori Mal
          College). Tap the board to read it full size.
        </span>
      </figcaption>
    </figure>
  </div>
</section>

{/* ══ 02 · AND THE PAPER THAT BOUGHT THE PLACE ═══════════════════════════════
    Ground: soft cream. Copy left, the eight cards right as a scrolled rail.

    ⚠ THESE ARE DOCUMENTS, NOT UI CARDS. The school issues one graphic per
    student; the frame carries the artwork whole and the text beneath it repeats
    only what is printed on it. */}
<section class="as-sec as-sec--cream as-pad uc-cards" aria-labelledby="uc-cards-t">
  <div class="u-container uc-cards__grid">
    <div class="uc-cards__head">
      <p class="as-kicker" data-reveal>What made it happen</p>
      <h2 class="as-h as-h--lg" id="uc-cards-t">
        <span data-clip data-clip-delay="0">And the paper</span>
        <span data-clip data-clip-delay="150"><em>that bought the place</em></span>
      </h2>
      <p class="as-body uc-cards__b" data-reveal data-reveal-delay="200">
        A Delhi University seat is decided by one examination, and the school publishes those results
        the same way it publishes the destinations — one card per student, headed
        {' '}<em>“Exemplar of Excellence”</em>, with the NTA score and every subject percentile
        printed on it rather than summarised.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="270">
        All three streams are represented. <strong>No average is given</strong>, because the school
        publishes none and a mean of these cards would be a figure this site produced. The stream
        choice behind them is on {' '}<a class="as-link" href={SUBJECT}>Subject Selection</a>, and
        the counselling around it on {' '}<a class="as-link" href={CAREER}>Career Guidance</a>.
      </p>
    </div>

    <div class="uc-cards__rail">
      <AsRailSlider
        label="CUET results and college placement cards"
        id="uc-rail"
        total={universityResults.length}
        per={2}
        perMd={2}
        perSm={1}
      >
        {universityResults.map((r) => (
          <li class="uc-card">
            <a
              class="uc-card__art"
              data-lb-open
              href={r.image.src}
              data-lb-alt={r.alt}
              data-lb-cap={`${r.name} · ${r.exam}`}
            >
              <SmartImage
                file={r.image}
                alt={r.alt}
                sizes="(max-width: 767px) 84vw, 22vw"
                fallbackWidth={1100}
                loading="lazy"
              />
            </a>
            <div class="uc-card__body">
              <p class="uc-card__k">{r.name}</p>
              <p class="uc-card__s">{r.score}</p>
              <p class="uc-card__e">{r.exam}</p>
              <p class="uc-card__v">{r.description}</p>
            </div>
          </li>
        ))}
      </AsRailSlider>
    </div>
  </div>
</section>

{/* ══ 03 · WHERE THEY WENT ═══════════════════════════════════════════════════
    Ground: white. One hairline band of four counts, read off the board. */}
<section class="as-sec as-sec--paper as-pad--sm uc-dest" aria-labelledby="uc-dest-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <p class="as-kicker" data-reveal id="uc-dest-t">Counted off the board</p>

    <ol class="uc-band">
      {destinations.map((d, i) => (
        <li class="uc-dcell" data-reveal data-reveal-delay={120 + i * 90}>
          <span class="uc-dcell__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[d.mark]} />
            </svg>
          </span>
          <p class="uc-dcell__n t-tabular">{d.n}</p>
          <h3 class="uc-dcell__k">{d.k}</h3>
          <p class="uc-dcell__v">{d.v}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<AsClose
  id="uc-close-t"
  kicker="The board's own last line"
  lead="Series will"
  accent="go on…"
  body="The school publishes the destinations by name and the scores card by card. It does not publish a cohort size, a placement rate, or the counselling timetable behind them — so no percentage appears on this page."
  photo={pCohort}
  position="50% 38%"
/>

<Lightbox />

<style>
  /* ═══ 01 · EIGHTEEN NAMES ═════════════════════════════════════════════════ */
  .uc-board__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.86fr) minmax(0, 1.14fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .uc-board__h { max-width: 16ch; }
  .uc-board__fig { position: relative; margin: 0; }
  .uc-board__dots { top: -5%; right: -1%; }

  /* ⚠ contain, NEVER cover. The board's own ratio decides the frame's height. */
  .uc-board__art {
    position: relative;
    display: block;
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: 16px;
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card-hover);
    transition: transform var(--sb-dur-image) var(--sb-ease);
  }
  .uc-board__art:hover { transform: translateY(-3px); }
  .uc-board__art :global(picture) { display: block; }
  .uc-board__art :global(img) { display: block; width: 100%; height: auto; object-fit: contain; }
  .uc-board__zoom {
    position: absolute;
    right: clamp(10px, 1.2vw, 15px);
    bottom: clamp(10px, 1.2vw, 15px);
    display: grid;
    place-items: center;
    width: clamp(32px, 3vw, 42px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: rgba(24, 16, 12, 0.74);
    color: #fff;
    opacity: 0;
    transition: opacity var(--sb-dur-image) var(--sb-ease);
  }
  .uc-board__zoom svg { width: 46%; height: auto; }
  .uc-board__art:hover .uc-board__zoom { opacity: 1; }

  .uc-board__cap { display: grid; gap: 4px; margin: clamp(11px, 1.3vw, 16px) 0 0; }
  .uc-board__cap-k {
    font-family: var(--sb-font-display);
    font-size: clamp(11.5px, 0.88vw, 13.5px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .uc-board__cap-m {
    font-size: clamp(10px, 0.76vw, 12px);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: var(--sb-violet);
  }
  .uc-board__cap-v {
    max-width: 68ch;
    font-size: clamp(9.5px, 0.7vw, 11px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }

  /* ═══ 02 · THE RESULT CARDS ═══════════════════════════════════════════════ */
  .uc-cards__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: clamp(26px, 3.6vw, 54px);
    align-items: center;
  }
  .uc-cards__b { max-width: 40ch; }
  .uc-cards__rail { min-width: 0; }

  /* ⚠ A DOCUMENT, NOT A UI CARD. The artwork is the primary visual; the body
     beneath repeats only what is printed on it. */
  .uc-card {
    display: grid;
    grid-template-rows: auto 1fr;
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 4px 16px -10px rgba(28, 14, 8, 0.14);
    transition: transform var(--sb-dur-image) var(--sb-ease), box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .uc-card:hover { transform: translateY(-3px); box-shadow: var(--sb-shadow-card); }
  .uc-card__art { display: block; background: var(--sb-sand); }
  .uc-card__art :global(picture) { display: block; }
  .uc-card__art :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 1 / 1; object-fit: cover; object-position: 50% 30%; }
  .uc-card__body { padding: clamp(12px, 1.4vw, 17px) clamp(13px, 1.5vw, 18px) clamp(14px, 1.7vw, 21px); }
  .uc-card__k {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(13px, 1.05vw, 17px);
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .uc-card__s {
    margin: 3px 0 0;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    font-weight: 700;
    color: var(--sb-violet);
  }
  .uc-card__e {
    margin: 4px 0 0;
    font-size: clamp(9px, 0.66vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .uc-card__v {
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-size: clamp(9.5px, 0.72vw, 11.4px);
    line-height: 1.6;
    color: var(--sb-text-muted);
  }

  /* ═══ 03 · WHERE THEY WENT ════════════════════════════════════════════════ */
  .uc-band {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    margin: clamp(20px, 2.4vw, 32px) 0 0;
    padding: 0;
    list-style: none;
  }
  .uc-dcell { padding: 0 clamp(10px, 1.3vw, 20px); }
  .uc-dcell:first-child { padding-left: 0; }
  .uc-dcell:last-child { padding-right: 0; }
  .uc-dcell + .uc-dcell { border-left: 1px solid var(--sb-border); }
  .uc-dcell__m { display: block; width: clamp(21px, 2vw, 27px); color: var(--sb-violet); }
  .uc-dcell__m svg { display: block; width: 100%; height: auto; }
  .uc-dcell__n {
    margin: clamp(8px, 1vw, 13px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 2.8vw, 40px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-orange-bright);
  }
  .uc-dcell__k {
    margin: clamp(5px, 0.7vw, 9px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(12.5px, 1vw, 16px);
    font-weight: 700;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }
  .uc-dcell__v {
    margin: clamp(5px, 0.65vw, 9px) 0 0;
    font-size: clamp(9.5px, 0.72vw, 11.4px);
    line-height: 1.64;
    color: var(--sb-text-muted);
  }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .uc-cards__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(22px, 3vw, 32px); }
    .uc-cards__b { max-width: 62ch; }
  }

  @media (max-width: 1023px) {
    .uc-board__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    /* The board leads on a narrow screen — it is the reason to be on this page. */
    .uc-board__fig { order: -1; }
    .uc-board__h { max-width: none; }
    .uc-band { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: clamp(20px, 2.8vw, 28px); }
    .uc-dcell:nth-child(odd) { padding-left: 0; border-left: 0; }
  }

  @media (max-width: 767px) {
    .uc-band { grid-template-columns: minmax(0, 1fr); }
    .uc-dcell { padding: 0; }
    .uc-dcell + .uc-dcell { padding-top: clamp(16px, 4.4vw, 22px); border-left: 0; border-top: 1px solid var(--sb-border); }
  }
</style>
