---
/**
 * STUDENT SUCCESS · CAREER GUIDANCE — six sections.
 *
 * ⚠ BUILT FROM THE SCHOOL'S OWN PHOTOGRAPHS, not from the parent page's
 * summary. Everything below is read off frames the school published:
 *
 *   THE HALL. A projected deck headed "Career Counselling — Dream BIG aim
 *   HIGH", carrying a Swami Vivekananda line, taken by a visiting speaker on a
 *   lapel microphone. The blackboard beside the stage reads CAREER.
 *
 *   THE DESKS. The school's own hand-painted banner behind every table reads
 *   "CAREER COUNSELING — CLASS X & XI — Your Journey". Students sit one at a
 *   time opposite a counsellor working from a laptop, several with a family
 *   member beside them.
 *
 * ═══ ALSO VERIFIED ═════════════════════════════════════════════════════════
 *   data/schoolActivities.ts — "the first day of the school's career
 *     counselling programme, in twenty-six photographs. A second day was
 *     published separately."
 *   data/newsPages.ts — Guiding Futures, Shaping Lives · Classes IX–XII ·
 *     Mr. Ashutosh Kumar Pandey, IRS, Deputy Commissioner of Income Tax.
 *   data/facilities.ts — Career Counselling ("subject choice, stream selection
 *     and university guidance") and BCS Counsellors, both on campus.
 *
 * ⚠ THE VISITING SPEAKER IS NOT NAMED. His name is printed on the slide behind
 * him but cannot be read with certainty at this resolution, and the school
 * published no caption. A name guessed off a blurred slide would be worse than
 * no name. ASSET REQUEST: the school's own caption for the two days.
 *
 * ⚠ THE SLIDER IS THE ANSWER TO "THE SCHOOL HAS MANY PHOTOGRAPHS". Eight frames
 * of one afternoon shown at once is a contact sheet; one at a time with a
 * thumbnail strip is an event. It reads data/studentSuccess.ts, so twenty
 * frames or fifty need no change to this file.
 *
 * ⚠ NOT CLAIMED: who spoke, what was covered, how a family books a session, a
 * session length, or a frequency. None is published.
 *
 * ═══ COMPOSITION — six sections, six different builds ══════════════════════
 *   01 · PAPER  copy left, a two-frame overlapping composition right.
 *   02 · IVORY  the photo slider LEFT at half the section, the record right as
 *               five numbered rows on hairlines.
 *   03 · PAPER  copy left, four editorial columns on thin vertical rules.
 *   04 · CREAM  the photo story — a controlled five-frame strip, into the
 *               viewer.
 *   05 · PHOTO  the cinematic close.
 */
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsClose from './AsClose.astro';
import AsPhotoSlider from './AsPhotoSlider.astro';
import Lightbox from '../../ui/Lightbox.astro';

/* ── PHOTOGRAPHY — the intro and photo-story frames. The slider takes its own
   set from data/studentSuccess.ts. ─────────────────────────────────────────── */
import { getAcademicTopic } from '../../../lib/cms';
import SmartImage from '../../ui/SmartImage.astro';

const ac = await getAcademicTopic('/academics/student-success/career-guidance/');
const pTalk = ac.pic('pTalk');
const pHall = ac.pic('pHall');
const pCohort = ac.pic('pCohort');
const careerGuidanceImages = ac.section('careerGuidanceImages').photos;

const S = 'Sunbeam School Ballia';

const SUBJECT = '/academics/student-success/subject-selection/';
const UNIVERSITY = '/academics/student-success/university-counselling/';
const ACTIVITY = '/beyond-academics/school-activities/career-counselling/';
const FACILITIES = '/campus/facilities-infrastructure/';

/* ── SECTION 02 — the record, five numbered rows ──────────────────────────
   ⚠ ROWS ON HAIRLINES, NOT CARDS. The brief rules cards out here explicitly. */
const record = ac.section('record').points;

/* ── SECTION 03 — what it gives. Four columns, each anchored to something the
   school actually runs rather than to an adjective. ─────────────────────── */
const benefits = ac.section('benefits').points;

/* ── SECTION 04 — the photo story. Five frames, controlled composition. ──── */
const story = ac.section('story').photos;
---

{/* ══ 01 · IT OPENS WITH A ROOM ══════════════════════════════════════════════
    Ground: warm white. Copy left, a two-frame overlapping composition right —
    the large frame is the speaker, the small one the hall he is speaking to. */}
<section class="as-sec as-sec--paper as-pad cg-open" aria-labelledby="cg-open-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container cg-open__grid">
    <div>
      <p class="as-kicker" data-reveal>A conversation that counts</p>
      <h2 class="as-h as-h--xl cg-open__h" id="cg-open-t">
        <span data-clip data-clip-delay="0">It opens</span>
        <span data-clip data-clip-delay="150"><em>with a room.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        The programme begins as a single session for the whole senior school. A visiting speaker
        takes the hall on a lapel microphone under a deck headed <strong>“Dream BIG aim HIGH”</strong>,
        opening on a line from Swami Vivekananda — <em>“knowledge does not mean simply intellectual
        assent, it means realisation.”</em>
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        Beside the stage the school has chalked one word on a blackboard and left it there:
        <strong>CAREER</strong>. Twenty-six photographs of the day were published, and a second day
        separately.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="330">
        The school does not publish who spoke or what was covered — his name is printed on the slide
        behind him but cannot be read with certainty, so it is not guessed at here. The full
        gallery is under {' '}<a class="as-link" href={ACTIVITY}>School Activities</a>.
      </p>
    </div>

    <figure class="cg-open__stage">
      <span class="as-dots cg-open__dots" aria-hidden="true"></span>
      <div class="cg-open__lead as-frame as-fill" data-mask data-mask-from="left">
        <SmartImage
          file={pTalk}
          alt={ac.picAlt('pTalk')}
         
          widths={[560, 900, 1280]}
          sizes="(max-width: 1023px) 92vw, 46vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="cg-open__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={pHall}
          alt={ac.picAlt('pHall')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 18vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </figure>
  </div>
</section>

{/* ══ 02 · ONE AT A TIME ═════════════════════════════════════════════════════
    Ground: warm ivory. THE SLIDER TAKES THE LEFT HALF and the record the right.

    ⚠ ONE FRAME AT A TIME, FROM DATA. Eight photographs of one afternoon shown
    simultaneously is a contact sheet. The count in the corner is derived from
    the array, so adding frames changes nothing here. */}
<section class="as-sec as-sec--ivory as-pad cg-main" aria-labelledby="cg-main-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container cg-main__grid">
    <div class="cg-main__slider">
      <AsPhotoSlider
        items={careerGuidanceImages}
        label="Career guidance photographs"
        id="cg-thumbs"
        sizes="(max-width: 1023px) 92vw, 46vw"
      />
    </div>

    <div class="cg-main__copy">
      <p class="as-kicker" data-reveal>One student, one counsellor</p>
      <h2 class="as-h as-h--lg" id="cg-main-t">
        <span data-clip data-clip-delay="0">One</span>
        <span data-clip data-clip-delay="150"><em>at a time.</em></span>
      </h2>
      <p class="as-body" data-reveal data-reveal-delay="200">
        The school’s own hand-painted banner sets the audience, and it is a specific one:
        <strong> “Career Counseling — Class X &amp; XI — Your Journey.”</strong> Behind that banner
        the day stops being an assembly. Each student takes a chair opposite a counsellor working
        from a laptop, and several bring a parent or an elder sibling to sit alongside.
      </p>

      <ol class="cg-record">
        {record.map((r, i) => (
          <li class="cg-row" data-reveal data-reveal-delay={250 + i * 70}>
            <span class="cg-row__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
              </svg>
            </span>
            <span class="cg-row__n t-tabular">{r.n}</span>
            <span class="cg-row__t">
              <span class="cg-row__k">{r.k}</span>
              <span class="cg-row__v">{r.v}</span>
            </span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

{/* ══ 03 · WHAT IT GIVES ═════════════════════════════════════════════════════
    Ground: white. Headline anchored left, four editorial columns divided by
    thin vertical rules. No floating cards — the brief rules them out. */}
<section class="as-sec as-sec--paper as-pad--sm cg-give" aria-labelledby="cg-give-t">
  <div class="u-container cg-give__grid">
    <div class="cg-give__head">
      <p class="as-kicker" data-reveal>What it gives</p>
      <h2 class="as-h as-h--lg" id="cg-give-t">
        <span data-clip data-clip-delay="0">Clarity today,</span>
        <span data-clip data-clip-delay="150"><em>confidence tomorrow.</em></span>
      </h2>
    </div>

    <ol class="as-cols" style="--n: 4;">
      {benefits.map((b, i) => (
        <li class="as-col" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="as-col__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[b.mark]} />
            </svg>
          </span>
          <p class="as-col__n t-tabular">{b.n}</p>
          <h3 class="as-col__k">{b.k}</h3>
          <p class="as-col__v">{b.v}</p>
          <span class="as-col__go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </span>
        </li>
      ))}
    </ol>

    <p class="as-note cg-give__foot" data-reveal data-reveal-delay="500">
      The stream choice this leads to is on
      {' '}<a class="as-link" href={SUBJECT}>Subject Selection Guidance</a>; where it ends up is on
      {' '}<a class="as-link" href={UNIVERSITY}>University Counselling</a>. The counselling desk
      itself is on the {' '}<a class="as-link" href={FACILITIES}>facilities</a> inventory.
    </p>
  </div>
</section>

{/* ══ 04 · THE PHOTO STORY ═══════════════════════════════════════════════════
    Ground: soft cream. Five frames in a controlled strip — a large one, two
    stacked, a circular crop and a tall one — not a second gallery. Every frame
    opens in the same viewer the slider uses. */}
<section class="as-sec as-sec--cream as-pad--sm cg-story" aria-label="Career guidance, in photographs">
  <div class="u-container">
    <div class="cg-story__stage">
      <span class="as-dots cg-story__dots" aria-hidden="true"></span>

      {story.map((s, i) => (
        <a
          class={`cg-story__f cg-story__f--${i + 1} as-frame${i === 3 ? ' as-frame--round' : ''} as-fill`}
          data-lb-open
          href={s.src.src}
          data-lb-alt={s.alt}
          data-lb-cap={s.cap}
          data-pop
          data-pop-delay={120 + i * 80}
        >
          <SmartImage
            file={s.src}
            alt={s.alt}
            sizes="(max-width: 767px) 92vw, 24vw"
            fallbackWidth={1100}
            loading="lazy"
          />
        </a>
      ))}
    </div>
  </div>
</section>

<AsClose
  id="cg-close-t"
  kicker="A day, in two halves"
  lead="Your journey,"
  accent="in their words."
  body="The school publishes the programme, the year groups it is for, and twenty-six photographs of the first day. It does not publish who spoke, what was covered, or how a family books a session — and none of that is invented here."
  photo={pCohort}
  position="50% 38%"
/>

<Lightbox />

<style>
  /* ═══ 01 · IT OPENS WITH A ROOM ═══════════════════════════════════════════ */
  .cg-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.06fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .cg-open__h { max-width: 11ch; }
  .cg-open__stage { position: relative; margin: 0; padding-bottom: clamp(26px, 3vw, 46px); }
  .cg-open__dots { top: -6%; right: -1%; }
  .cg-open__lead { width: 84%; margin-left: auto; aspect-ratio: 16 / 11; }
  .cg-open__sm {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 42%;
    aspect-ratio: 4 / 3;
    border: 5px solid var(--sb-paper);
  }

  /* ═══ 02 · ONE AT A TIME ══════════════════════════════════════════════════ */
  .cg-main__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }

  /* ⚠ ROWS ON HAIRLINES, NOT CARDS. */
  .cg-record { margin: clamp(18px, 2.2vw, 28px) 0 0; padding: 0; list-style: none; }
  .cg-row {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: clamp(9px, 1.1vw, 14px);
    align-items: start;
    padding: clamp(9px, 1.05vw, 13px) 0;
    border-bottom: 1px solid var(--sb-border);
  }
  .cg-row:first-child { border-top: 1px solid var(--sb-border); }
  .cg-row__m { display: block; width: clamp(19px, 1.8vw, 24px); margin-top: 1px; color: var(--sb-violet); }
  .cg-row__m svg { display: block; width: 100%; height: auto; }
  .cg-row__n {
    margin-top: 3px;
    font-size: clamp(8.5px, 0.64vw, 10.4px);
    font-weight: 700;
    letter-spacing: 0.13em;
    color: var(--sb-orange-bright);
  }
  .cg-row__t { display: grid; gap: 3px; }
  .cg-row__k {
    font-size: clamp(9.5px, 0.72vw, 11.2px);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .cg-row__v { font-size: clamp(10px, 0.76vw, 12px); line-height: 1.62; color: var(--sb-text-muted); }

  /* ═══ 03 · WHAT IT GIVES ══════════════════════════════════════════════════ */
  .cg-give__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(0, 1.38fr);
    gap: clamp(24px, 3.2vw, 50px);
    align-items: center;
  }
  .cg-give__foot { grid-column: 1 / -1; max-width: none; margin-top: clamp(20px, 2.4vw, 30px); padding-top: clamp(14px, 1.6vw, 20px); border-top: 1px solid var(--sb-border); }

  /* ═══ 04 · THE PHOTO STORY ════════════════════════════════════════════════
     ⚠ FIVE NAMED SLOTS, NOT auto-fit. The composition is the point: a large
     frame left, two stacked beside it, a circle over the seam and a tall one
     closing the row. A grid that reflowed would lose it. */
  .cg-story__stage {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr) minmax(0, 0.52fr) minmax(0, 0.92fr);
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 18px);
    aspect-ratio: 16 / 5.9;
  }
  .cg-story__dots { bottom: -8%; left: -1%; }
  .cg-story__f { display: block; }
  .cg-story__f--1 { grid-column: 1; grid-row: 1 / 3; }
  .cg-story__f--2 { grid-column: 2; grid-row: 1; border: 4px solid #f3ece5; }
  .cg-story__f--3 { grid-column: 2; grid-row: 2; border: 4px solid #f3ece5; }
  .cg-story__f--4 {
    grid-column: 3;
    grid-row: 1 / 3;
    align-self: center;
    justify-self: start;
    width: clamp(104px, 12vw, 178px);
    aspect-ratio: 1 / 1;
    margin-left: clamp(-48px, -3vw, -16px);
    border: 5px solid #f3ece5;
  }
  .cg-story__f--5 { grid-column: 4; grid-row: 1 / 3; }
  .cg-story__f :global(img) { transition: scale var(--sb-dur-image) var(--sb-ease); }
  .cg-story__f:hover :global(img) { scale: 1.05; }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .cg-give__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(20px, 2.8vw, 30px); }
  }

  @media (max-width: 1023px) {
    .cg-open__grid,
    .cg-main__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    .cg-open__stage,
    .cg-main__slider { order: -1; }
    .cg-open__h { max-width: none; }
    .cg-story__stage { aspect-ratio: 16 / 8; }
  }

  @media (max-width: 767px) {
    .cg-open__lead { width: 100%; aspect-ratio: 5 / 4; }
    .cg-open__sm { width: 46%; }
    .cg-open__stage { padding-bottom: clamp(30px, 8vw, 42px); }

    .cg-row { grid-template-columns: auto minmax(0, 1fr); row-gap: 4px; }
    .cg-row__n { grid-column: 2; margin-top: 0; }

    /* The strip becomes a deliberate pair plus a wide frame, not five slivers. */
    .cg-story__stage {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto auto auto;
      aspect-ratio: auto;
    }
    .cg-story__f--1 { grid-column: 1 / -1; grid-row: 1; aspect-ratio: 16 / 10; }
    .cg-story__f--2 { grid-column: 1; grid-row: 2; aspect-ratio: 4 / 3; }
    .cg-story__f--3 { grid-column: 2; grid-row: 2; aspect-ratio: 4 / 3; }
    .cg-story__f--4 { display: none; }
    .cg-story__f--5 { grid-column: 1 / -1; grid-row: 3; aspect-ratio: 16 / 10; }
    .cg-story__dots { display: none; }
  }
</style>
