---
/**
 * ASSESSMENT & SUPPORT · MENTORING — seven sections.
 *
 * ⚠ THE SCHOOL PUBLISHES ONE LINE OF MENTORING COPY. What it also publishes,
 * and what a page of pastoral prose would have missed, is its own recruitment
 * advertising — and a school's job adverts are a harder statement of what it
 * staffs than any paragraph about care. Read off the posters in assets/jobs/:
 *
 *   "School counsellor: MA in counselling or clinical psychology with two years
 *    of experience as a school counsellor"        (walk-in interview poster)
 *   "clinical psychology counsellor and wellness trainer"  (vacancies poster)
 *
 * A school that requires a master's degree and two years' experience for its
 * counsellor is describing its provision more precisely than copy could.
 *
 * ═══ ALSO VERIFIED ═════════════════════════════════════════════════════════
 *   Every student has a member of staff who knows them as a person rather than
 *     as a name on a class list.  (data/academics.ts assessmentTopics)
 *   BCS Counsellors — "trained counsellors available to students."
 *     (data/facilities.ts, listed on campus)
 *
 * ⚠ NOT USED: data/campus.ts carries a "Counselling" entry marked
 * `verified: false`. It is not cited here.
 *
 * ⚠ NOT CLAIMED: a mentor-to-student ratio, a programme name, a meeting
 * frequency, how a mentor is assigned, or how a parent contacts one. None is
 * published, and inventing any of it would be inventing pastoral care.
 *
 * ⚠ THIS PAGE IS ABOUT PEOPLE AND IS BUILT DIFFERENTLY FROM ITS SIBLINGS. Its
 * image composition is portrait rather than landscape, its journey alternates
 * vertically rather than sitting on one line, and it ends on a quiet cream
 * callout instead of going straight from the dark statement to the footer.
 *
 * ═══ COMPOSITION — seven sections, seven different builds ═══════════════════
 *   01 · PAPER  copy left, a three-frame portrait composition right.
 *   02 · CREAM  the collage crosses LEFT, four numbered rows on rules right.
 *   03 · IVORY  the mentoring journey — four stages on a drawn rail, over
 *               GUIDANCE set oversized, the middle two dropped a half-step.
 *   04 · PAPER  four editorial blocks, divided by thin vertical rules.
 *   05 · PHOTO  the human moment — full width, parallaxed.
 *   06 · CREAM  the closing callout, with an orange rule under it.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsRail from './AsRail.astro';

/* ── PHOTOGRAPHY — six genuine Sunbeam Ballia frames, each used ONCE. ─────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getMentoring } from '../../../lib/cms';

const { open, rel, jrn, roles, human, final } = await getMentoring();

const S = 'Sunbeam School Ballia';

const CAREERS = '/career/';
const ASSESSMENT = '/academics/assessment/';
const REMEDIAL = '/academics/assessment/remedial-support/';

/* ── SECTION 02 — the four people, in the order the school lists them ─────
   ⚠ `advert: true` marks the two whose evidence is a recruitment poster rather
   than a page of copy, and the rows say so in their own text. */

/* ── SECTION 03 — the journey. Four stages, and each is a consequence of the
   one before it rather than a stage in a programme the school has not named. */

/* ── SECTION 04 — the same four people, stated flat ──────────────────────── */
---

{/* ══ 01 · SOMEONE WHO KNOWS THE CHILD ═══════════════════════════════════════
    Ground: white. Copy left, and on the right a PORTRAIT composition — a tall
    lead frame, one overlapping landscape frame and a circular detail — rather
    than the landscape lead this page's siblings use. */}
<section class="as-sec as-sec--paper as-pad mn-open" aria-labelledby="mn-open-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container mn-open__grid">
    <div>
      <p class="as-kicker" data-reveal>{open.kicker}</p>
      <ClipHeading class="as-h as-h--xl mn-open__h" id="mn-open-t" text={open.heading} />

      <RichLine class="as-body" text={open.body[0]} reveal revealDelay={200} />
      <RichLine class="as-body" text={open.body[1]} reveal revealDelay={260} />
      <RichLine class="as-note" text={open.body[2]} linkClass="as-link" reveal revealDelay={330} />
    </div>

    <div class="mn-open__stage">
      <span class="as-dots mn-open__dots" aria-hidden="true"></span>
      <div class="mn-open__lead as-frame as-fill" data-mask>
        <SmartImage
          file={open.shots[0]?.image} alt={open.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="eager"
          decoding="async"
        />
      </div>
      <div class="mn-open__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="180">
        <SmartImage
          file={open.shots[1]?.image} alt={open.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 44vw, 17vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="mn-open__cir as-frame as-frame--float as-frame--round as-fill" data-pop data-pop-delay="300">
        <SmartImage
          file={open.shots[2]?.image} alt={open.shots[2]?.alt ?? ''}
         
          widths={[220, 400]}
          sizes="(max-width: 1023px) 28vw, 11vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · MORE THAN A NAME ON A LIST ════════════════════════════════════════
    Ground: warm cream. The collage crosses LEFT and the four people are listed
    on the right as numbered rows on thin rules. */}
<section class="as-sec as-sec--cream as-pad mn-rel" aria-labelledby="mn-rel-t">
  <div class="u-container mn-rel__grid">
    <div class="mn-rel__stage">
      <span class="as-dots mn-rel__dots" aria-hidden="true"></span>
      <div class="mn-rel__lead as-frame as-fill" data-zoom data-zoom-to="1.04">
        <SmartImage
          file={rel.shots[0]?.image} alt={rel.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 42vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="mn-rel__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={rel.shots[1]?.image} alt={rel.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 48vw, 19vw"
          loading="lazy"
          decoding="async"
        />
      </div>
    </div>

    <div class="mn-rel__copy">
      <p class="as-kicker" data-reveal>{rel.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="mn-rel-t" text={rel.heading} />
      <RichLine class="as-body" text={rel.body[0]} reveal revealDelay={200} />

      <ol class="mn-people">
        {rel.cells.map((p, i) => (
          <li class="mn-person" data-reveal data-reveal-delay={250 + i * 80}>
            <span class="mn-person__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[p.mark]} />
              </svg>
            </span>
            <span class="mn-person__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="mn-person__t">
              <span class="mn-person__k">{p.label}</span>
              <span class="mn-person__v">{p.value}</span>
            </span>
          </li>
        ))}
      </ol>
      <RichLine class="as-note" text={rel.body[1]} linkClass="as-link" reveal revealDelay={580} />
    </div>
  </div>
</section>

{/* ══ 03 · THE MENTORING JOURNEY ═════════════════════════════════════════════
    Ground: warm ivory, with GUIDANCE set oversized and outlined behind. */}
<section class="as-sec as-sec--ivory as-pad mn-jrn" aria-labelledby="mn-jrn-t">
  <span class="as-ghost mn-jrn__ghost" aria-hidden="true" data-drift>Guidance</span>

  <div class="u-container mn-jrn__inner">
    <p class="as-kicker mn-jrn__kick" data-reveal>{jrn.kicker}</p>
    <ClipHeading class="as-h as-h--md mn-jrn__h" id="mn-jrn-t" text={jrn.heading} />

    <AsRail steps={jrn.cells} ground="ivory" label="The mentoring journey, four stages" class="mn-jrn__rail" />
  </div>
</section>

{/* ══ 04 · DIFFERENT PEOPLE, ONE PURPOSE ═════════════════════════════════════
    Ground: white. Four editorial blocks divided by thin vertical rules — not
    four cards; the brief rules those out on this page in as many words. */}
<section class="as-sec as-sec--paper as-pad--sm mn-roles" aria-labelledby="mn-roles-t">
  <div class="u-container mn-roles__grid">
    <div class="mn-roles__head">
      <p class="as-kicker" data-reveal>{roles.kicker}</p>
      <ClipHeading class="as-h as-h--md" id="mn-roles-t" text={roles.heading} />
    </div>

    <ol class="as-cols" style="--n: 4;">
      {roles.cells.map((r, i) => (
        <li class="as-col" data-reveal data-reveal-delay={140 + i * 90}>
          <span class="as-col__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[r.mark]} />
            </svg>
          </span>
          <p class="as-col__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="as-col__k">{r.label}</h3>
          <p class="as-col__v">{r.value}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 05 · THE HUMAN MOMENT ══════════════════════════════════════════════════
    ⚠ THIS IS NOT THE PAGE'S LAST SECTION, WHICH IS WHY IT DOES NOT USE AsClose.
    The brief puts a quiet cream callout after it, and a dark statement that is
    followed by anything other than the footer needs its own build. */}
<section class="as-sec mn-human" aria-labelledby="mn-human-t">
  <div class="mn-human__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <SmartImage
      file={human.shots[0]?.image} alt={human.shots[0]?.alt ?? ''}
     
      widths={[1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <span class="mn-human__scrim" aria-hidden="true"></span>

  <div class="u-container mn-human__inner">
    <ClipHeading class="as-h mn-human__h" id="mn-human-t" text={human.heading} />
    <RichLine class="mn-human__b" text={human.body[0]} reveal revealDelay={180} />
  </div>
</section>

{/* ══ 06 · THE CLOSING CALLOUT ═══════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream mn-final" aria-label="Closing statement">
  <div class="u-container mn-final__inner">
    <span class="mn-final__m" aria-hidden="true">
      <svg viewBox="0 0 24 24" fill="none">
        <g stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.quote} />
      </svg>
    </span>
    <RichLine class="mn-final__t" text={final.body[0]} reveal />
    <span class="as-dots mn-final__dots" aria-hidden="true"></span>
  </div>
  <RichLine class="u-container as-note mn-final__foot" text={final.body[1]} linkClass="as-link" reveal revealDelay={140} />
</section>

<style>
  /* ═══ 01 · SOMEONE WHO KNOWS THE CHILD ════════════════════════════════════ */
  .mn-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.96fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  :global(.mn-open__h) { max-width: 14ch; }

  /* ⚠ A PORTRAIT COMPOSITION, NOT A LANDSCAPE ONE. Mentoring is the page about
     people, and a 4:5 lead with a landscape frame across its foot reads closer
     to a person than the 16:11 the other pages use. */
  .mn-open__stage { position: relative; padding-bottom: clamp(30px, 3.4vw, 52px); }
  .mn-open__dots { top: 2%; right: 0; }
  .mn-open__lead { width: 76%; margin-left: auto; aspect-ratio: 4 / 5; }
  .mn-open__sm {
    position: absolute;
    left: 0;
    bottom: clamp(30px, 3.4vw, 52px);
    width: 52%;
    aspect-ratio: 4 / 3;
    border: 5px solid var(--sb-paper);
  }
  .mn-open__cir {
    position: absolute;
    right: 6%;
    bottom: 0;
    width: clamp(84px, 9vw, 132px);
    aspect-ratio: 1 / 1;
    border: 5px solid var(--sb-paper);
  }

  /* ═══ 02 · MORE THAN A NAME ON A LIST ═════════════════════════════════════ */
  .mn-rel__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(26px, 3.6vw, 56px);
    align-items: center;
  }
  .mn-rel__stage { position: relative; padding-bottom: clamp(24px, 2.8vw, 42px); }
  .mn-rel__dots { top: 0; left: 0; }
  .mn-rel__lead { width: 84%; aspect-ratio: 4 / 3; }
  .mn-rel__sm {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 46%;
    aspect-ratio: 16 / 10;
    border: 5px solid #f3ece5;
  }

  .mn-people { margin: clamp(18px, 2.2vw, 28px) 0 0; padding: 0; list-style: none; }
  .mn-person {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: clamp(10px, 1.2vw, 15px);
    align-items: start;
    padding: clamp(9px, 1.05vw, 13px) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--sb-charcoal) 12%, transparent);
  }
  .mn-person:first-child { border-top: 1px solid color-mix(in srgb, var(--sb-charcoal) 12%, transparent); }
  .mn-person__m { display: block; width: clamp(20px, 1.9vw, 26px); margin-top: 1px; color: var(--sb-violet); }
  .mn-person__m svg { display: block; width: 100%; height: auto; }
  .mn-person__n {
    margin-top: 3px;
    font-size: clamp(9px, 0.68vw, 11px);
    font-weight: 700;
    letter-spacing: 0.13em;
    color: var(--sb-orange-bright);
  }
  .mn-person__t { display: grid; gap: 3px; }
  .mn-person__k {
    font-size: clamp(9.5px, 0.72vw, 11.2px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .mn-person__v { font-size: clamp(10.5px, 0.78vw, 12.4px); line-height: 1.62; color: var(--sb-text-secondary); }

  /* ═══ 03 · THE MENTORING JOURNEY ══════════════════════════════════════════ */
  .mn-jrn__ghost {
    top: 50%;
    left: 50%;
    translate: -50% -50%;
    font-size: clamp(76px, 13.5vw, 210px);
  }
  .mn-jrn__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    justify-items: center;
    text-align: center;
  }
  .mn-jrn__kick { text-align: center; }
  .mn-jrn__rail { margin-top: clamp(26px, 3.2vw, 44px); }
  /* ⚠ THE MIDDLE TWO DROP A HALF-STEP. Four stages on one dead-straight line is
     the build every other page on this site uses; mentoring is not a process, so
     its rail is allowed to breathe. The rule still passes through every disc
     because the rule is pinned to the FIRST row of the grid. */
  .mn-jrn__rail :global(.as-step:nth-child(2)),
  .mn-jrn__rail :global(.as-step:nth-child(4)) { padding-top: clamp(10px, 1.4vw, 22px); }
  .mn-jrn__rail :global(.as-rail__rule) { top: calc(clamp(38px, 3.6vw, 50px) / 2 - 1px); }

  /* ═══ 04 · DIFFERENT PEOPLE, ONE PURPOSE ══════════════════════════════════ */
  .mn-roles__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.6fr) minmax(0, 1.4fr);
    gap: clamp(24px, 3.2vw, 50px);
    align-items: center;
  }

  /* ═══ 05 · THE HUMAN MOMENT ═══════════════════════════════════════════════ */
  .mn-human { padding-block: clamp(44px, 5.4vw, 84px); }
  .mn-human__media { position: absolute; z-index: -3; inset: -12% 0; }
  .mn-human__media :global(picture),
  .mn-human__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 40%;
  }
  .mn-human__scrim {
    position: absolute;
    z-index: -2;
    inset: 0;
    background:
      linear-gradient(to bottom, rgba(24, 16, 12, 0.84) 0%, rgba(24, 16, 12, 0.7) 48%, rgba(24, 16, 12, 0.88) 100%),
      radial-gradient(64% 74% at 50% 44%, rgba(255, 92, 53, 0.15) 0%, transparent 72%);
  }
  .mn-human__inner { position: relative; display: grid; justify-items: center; text-align: center; }
  :global(.mn-human__h) { max-width: 20ch; font-size: clamp(26px, 3.2vw, 46px); color: #fff; }
  :global(.mn-human__h em) { color: var(--sb-lime); font-style: italic; }
  :global(.mn-human__b) {
    max-width: 66ch;
    margin: clamp(14px, 1.7vw, 21px) 0 0;
    font-size: clamp(12px, 0.88vw, 14px);
    line-height: 1.78;
    color: var(--sb-on-dark-82);
  }

  /* ═══ 06 · THE CLOSING CALLOUT ════════════════════════════════════════════ */
  .mn-final { padding-block: clamp(30px, 3.6vw, 56px); }
  .mn-final__inner {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(16px, 2vw, 28px);
    align-items: center;
  }
  .mn-final__m {
    display: grid;
    place-items: center;
    width: clamp(44px, 4.2vw, 60px);
    aspect-ratio: 1 / 1;
    border: 1.6px solid color-mix(in srgb, var(--sb-violet) 40%, transparent);
    border-radius: 50%;
    color: var(--sb-violet);
  }
  .mn-final__m svg { width: 50%; height: auto; }
  :global(.mn-final__t) {
    margin: 0;
    max-width: 30ch;
    padding-bottom: clamp(10px, 1.2vw, 15px);
    border-bottom: 2px solid var(--sb-orange-bright);
    font-family: var(--sb-font-display);
    font-size: clamp(17px, 1.7vw, 29px);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.032em;
    color: var(--sb-charcoal);
  }
  :global(.mn-final__t em) { display: block; font-style: normal; color: var(--sb-violet); }
  .mn-final__dots { top: 50%; right: 3%; translate: 0 -50%; width: clamp(64px, 6.4vw, 104px); }
  :global(.mn-final__foot) { max-width: none; margin-top: clamp(14px, 1.7vw, 20px); }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .mn-roles__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(20px, 2.8vw, 30px); }
  }

  @media (max-width: 1023px) {
    .mn-open__grid,
    .mn-rel__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(28px, 4vw, 40px); }
    .mn-open__stage,
    .mn-rel__stage { order: -1; }
    :global(.mn-open__h) { max-width: none; }
    .mn-open__lead { width: 70%; aspect-ratio: 4 / 3; }
    .mn-jrn__ghost { font-size: clamp(64px, 13vw, 130px); }
    .mn-jrn__rail :global(.as-step:nth-child(2)),
    .mn-jrn__rail :global(.as-step:nth-child(4)) { padding-top: 0; }
  }

  @media (max-width: 767px) {
    .mn-open__lead { width: 100%; aspect-ratio: 5 / 4; }
    .mn-open__sm { width: 50%; bottom: 0; }
    .mn-open__cir { display: none; }
    .mn-open__stage { padding-bottom: clamp(30px, 8vw, 42px); }

    .mn-rel__lead { width: 100%; aspect-ratio: 5 / 4; }
    .mn-rel__sm { width: 50%; }
    .mn-rel__stage { padding-bottom: clamp(28px, 7.4vw, 40px); }

    .mn-person { grid-template-columns: auto minmax(0, 1fr); row-gap: 4px; }
    .mn-person__n { grid-column: 2; margin-top: 0; }

    .mn-final__inner { grid-template-columns: minmax(0, 1fr); gap: clamp(13px, 3.6vw, 18px); }
    :global(.mn-final__t) { max-width: none; }
    .mn-final__dots { display: none; }
  }
</style>
