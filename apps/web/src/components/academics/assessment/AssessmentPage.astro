---
/**
 * ACADEMICS · 04 — ASSESSMENT & SUPPORT, in eight sections.
 *
 * ═══ SOURCE OF TRUTH — every line traces to this repository ════════════════
 *   data/academics.ts `cycle` — the six steps, verbatim:
 *     Learning · Activities · Assessment · Feedback · Improvement · Achievement
 *   data/academics.ts `assessmentTopics` — the four support channels and the
 *     retest rules that hang off step five.
 *   data/academics.ts — PRECEPT, the CBSE syllabus published class by class.
 *   The school's own /promotion-policy/ page — a retest sits no sooner than TEN
 *     DAYS after results, TWO CLEAR DAYS between retests, results within TWO AND
 *     A HALF WEEKS, and a medical certificate does not waive the retest.
 *
 * ⚠ THE SIX STEPS DESCRIBE A CBSE YEAR, NOT A PROPRIETARY SUNBEAM METHOD. The
 * school has not published one, and the page does not name one.
 *
 * ⚠ NOT CLAIMED ANYWHERE ON THIS PAGE: an examination date, a term start, a
 * weighting, a pass mark, a number of assessments per year, or a promotion
 * threshold. The threshold in particular: the school's policy says "below the
 * threshold" and does not give the mark, so section 05 links to the policy
 * rather than paraphrasing a number that does not exist.
 *
 * ⚠ SECTION 07'S PHOTOGRAPHS ARE OF THE PARENTS' FORUM, NOT OF A PTM, AND THE
 * CAPTION SAYS SO. The school has published no photograph of a parent–teacher
 * meeting. ASSET REQUIREMENT: photography of an actual PTM.
 *
 * ═══ COMPOSITION — eight sections, eight different builds ═══════════════════
 *   01 · IVORY  copy left, standfirst right, the six steps as one drawn rail.
 *   02 · SPLIT  a beige panel bleeding LEFT carries the radial cycle; a white
 *               column right carries four small cards. One band, two grounds.
 *   03 · PAPER  copy left, four information blocks and one CTA panel right.
 *   04 · DARK   the support system — statement left, four rows on rules right.
 *   05 · IVORY  an image composition left, a checked list right.
 *   06 · PEACH  the four-step "what happens next" rail.
 *   07 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from './marks';
import AsRail from './AsRail.astro';
import AsClose from './AsClose.astro';

/* ── PHOTOGRAPHY — four genuine Sunbeam Ballia frames, each used ONCE. ────── */
import ClipHeading from '../../ui/ClipHeading.astro';
import RichLine from '../../ui/RichLine.astro';
import { getAssessment } from '../../../lib/cms';

const { open, cycle, struct, sup, conv, next, close } = await getAssessment();

/* AsClose takes its headline as two props; the record stores the same two
   lines with {{…}} that every other heading uses. */
const [closeLead = '', closeAccent = ''] = (close.heading ?? '')
  .split('\n')
  .map((l) => l.replace(/^\{\{|\}\}$/g, '').trim());

const S = 'Sunbeam School Ballia';

const POLICY = '/academics/philosophy/curriculum/';
const REMEDIAL = '/academics/assessment/remedial-support/';
const MENTORING = '/academics/assessment/mentoring/';
const PTM = '/academics/assessment/parent-teacher-meetings/';
const CALENDAR = '/academics/academic-calendar/';
const PARTNERSHIP = '/academics/parent-partnership/';

/* ── THE SIX STEPS ────────────────────────────────────────────────────────
   `cycle` is the school's own wording and is imported rather than retyped, so
   the rail in 01 and the radial diagram in 02 cannot disagree. The mark and the
   longer gloss are this page's; the step name and short body are the data's. */


/* Where each node sits on the ring. cx 50, cy 42, rx 36, ry 34 — computed once
   here rather than typed six times, so moving the ring moves the discs with it. */
const RING = { cx: 50, cy: 42, rx: 36, ry: 34 };
/* ⚠ THE RAIL IN 01 AND THE RING IN 02 ARE THE SAME SIX STEPS. They are held
   once, on the opening band, so the two cannot disagree. */
const ringed = open.cells.map((s, i) => {
  const a = (-90 + i * 60) * (Math.PI / 180);
  return {
    ...s,
    x: (RING.cx + RING.rx * Math.cos(a)).toFixed(2),
    y: (RING.cy + RING.ry * Math.sin(a)).toFixed(2),
  };
});

/* ── SECTION 02 — the four things an assessment looks at ─────────────────── */

/* ── SECTION 03 — what the school publishes about the structure ──────────── */

/* ── SECTION 04 — the four support channels, all published by name ───────── */

/* ── SECTION 05 — what a parent–teacher meeting is for ───────────────────── */

/* ── SECTION 06 — what happens when a difficulty appears ─────────────────── */
---

{/* ══ 01 · HOW A YEAR ACTUALLY RUNS ══════════════════════════════════════════
    Ground: warm ivory. Copy left, standfirst right, and the six steps as one
    refined horizontal rail — not the zig-zag timeline this page used to carry,
    which ran to five screens and said the same six words. */}
<section class="as-sec as-sec--ivory as-pad ai-open" aria-labelledby="ai-open-t">
  <span class="as-warm" aria-hidden="true"></span>
  <span class="as-grid" aria-hidden="true"></span>

  <div class="u-container">
    <div class="ai-open__grid">
      <div>
        <p class="as-kicker" data-reveal>{open.kicker}</p>
        <ClipHeading class="as-h as-h--xl ai-open__h" id="ai-open-t" text={open.heading} />
      </div>

      <RichLine class="as-body ai-open__stand" text={open.body[0]} reveal revealDelay={180} />
    </div>

    <div class="ai-open__rail">
      <AsRail steps={open.cells} ground="ivory" label="The assessment cycle, six steps" />
    </div>
  </div>
</section>

{/* ══ 02 · THE LEARNING CYCLE ════════════════════════════════════════════════
    ⚠ ONE BAND, TWO GROUNDS. The beige panel bleeds off the left edge and stops
    at 62%; the white column carries on to the right. That is the reference's
    composition, and it is what lets the diagram breathe without the section
    becoming two.

    ⚠ THE RING IS A REAL ELLIPSE AND THE DISCS SIT ON IT. Both come from one
    RING constant in the frontmatter, so the geometry cannot drift. */}
<section class="as-sec as-sec--paper ai-cycle" aria-labelledby="ai-cycle-t">
  <div class="u-container ai-cycle__grid">
    {/* ⚠ THE PANEL IS A GRID ITEM, NOT A SECTION CHILD. As a sibling of the grid
        its grid-column did nothing and its right edge had to be guessed as a
        percentage of the viewport — which put the edge inside the right column's
        eyebrow. In column one it tracks the column at every width. */}
    <span class="ai-cycle__panel" aria-hidden="true"></span>

    <div class="ai-cycle__stage">
      <p class="as-kicker ai-cycle__kick" data-reveal>{cycle.kicker}</p>

      <div class="ai-ring">
        <svg class="ai-ring__path" viewBox="0 0 100 100" fill="none" preserveAspectRatio="none" aria-hidden="true">
          <ellipse
            cx={RING.cx}
            cy={RING.cy}
            rx={RING.rx}
            ry={RING.ry}
            stroke="currentColor"
            stroke-width="0.34"
            stroke-dasharray="1.1 2.2"
            stroke-linecap="round"
          />
        </svg>

        <div class="ai-ring__hub" aria-hidden="true">
          <span>The<br />learning</span>
          <em>cycle</em>
        </div>

        <ol class="ai-ring__list">
          {ringed.map((r, i) => (
            <li class="ai-node" style={`--x: ${r.x}%; --y: ${r.y}%;`} data-pop data-pop-delay={120 + i * 90}>
              <span class="ai-node__disc t-tabular" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
              <h3 class="ai-node__k">{r.label}</h3>
              <p class="ai-node__v">{r.sub}</p>
            </li>
          ))}
        </ol>
      </div>
    </div>

    <div class="ai-cycle__copy">
      <p class="as-kicker" data-reveal>Assessment is more than an exam</p>
      <ClipHeading class="as-h as-h--lg" id="ai-cycle-t" text={cycle.heading} />
      <RichLine class="as-body" text={cycle.body[0]} reveal revealDelay={200} />

      <ul class="ai-facets">
        {cycle.cells.map((f, i) => (
          <li class="ai-facet" data-reveal data-reveal-delay={250 + i * 80}>
            <span class="ai-facet__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[f.mark]} />
              </svg>
            </span>
            <span class="ai-facet__t">
              <span class="ai-facet__k">{f.label}</span>
              <span class="ai-facet__v">{f.value}</span>
            </span>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>

{/* ══ 03 · PUBLISHED WHEN IT MATTERS ═════════════════════════════════════════
    Ground: warm ivory. Copy left, four information blocks right, and the fifth
    tile is the one call to action — because the promotion rules are long, and
    paraphrasing them here would be a second version of a policy that already
    exists in one place. */}
<section class="as-sec as-sec--ivory as-pad ai-struct" aria-labelledby="ai-struct-t">

  <div class="u-container ai-struct__grid">
    <div class="ai-struct__head">
      <p class="as-kicker" data-reveal>{struct.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="ai-struct-t" text={struct.heading} />
      <RichLine class="as-body ai-struct__b" text={struct.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="ai-blocks">
      {struct.cells.map((s, i) => (
        <li class="ai-block" data-pop data-pop-delay={140 + i * 90}>
          <span class="ai-block__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
            </svg>
          </span>
          <p class="ai-block__n t-tabular">{String(i + 1).padStart(2, '0')}</p>
          <h3 class="ai-block__k">{s.label}</h3>
          <p class="ai-block__v">{s.value}</p>
        </li>
      ))}

      {/* ⚠ THE FIFTH TILE IS A LINK, NOT A FACT. The promotion rules run to more
          than a card, and a summary of them here would be a second, thinner
          version of a document that already exists. */}
      <li class="ai-block ai-block--cta" data-pop data-pop-delay="500">
        <a class="ai-cta" href={POLICY}>
          <span class="ai-cta__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.doc} />
            </svg>
          </span>
          <span class="ai-cta__k">View the detailed promotion policy and information</span>
          <span class="ai-cta__go" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </span>
        </a>
      </li>
    </ol>
  </div>
</section>

{/* ══ 04 · SUPPORT BEGINS WHERE A DIFFICULTY APPEARS ═════════════════════════
    Ground: deep brown. Statement left, four rows on thin rules right. This is
    the page's serious section and it is the only dark one before the close. */}
<section class="as-sec as-sec--dark as-pad ai-sup" aria-labelledby="ai-sup-t">
  <span class="ai-sup__glow" aria-hidden="true"></span>

  <div class="u-container ai-sup__grid">
    <div>
      <p class="as-kicker as-kicker--dark" data-reveal>{sup.kicker}</p>
      <ClipHeading class="as-h as-h--lg ai-sup__h" id="ai-sup-t" text={sup.heading} />
      <RichLine class="ai-sup__b" text={sup.body[0]} reveal revealDelay={200} />
    </div>

    <ol class="ai-sup__list">
      {sup.cells.map((s, i) => (
        <li class="ai-srow" data-reveal data-reveal-delay={200 + i * 90}>
          <a class="ai-srow__in" href={s.href}>
            <span class="ai-srow__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
            <span class="ai-srow__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[s.mark]} />
              </svg>
            </span>
            <span class="ai-srow__t">
              <span class="ai-srow__k">{s.label}</span>
              <span class="ai-srow__v">{s.value}</span>
            </span>
            <span class="ai-srow__go" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ol>
  </div>
</section>

{/* ══ 05 · PROGRESS IS A CONVERSATION ════════════════════════════════════════
    Ground: white. The image composition crosses LEFT, the copy right. */}
<section class="as-sec as-sec--paper as-pad ai-conv" aria-labelledby="ai-conv-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>
  <span class="as-dots ai-conv__dots" aria-hidden="true"></span>

  <div class="u-container ai-conv__grid">
    <figure class="ai-conv__stage">
      <div class="ai-conv__lead as-frame as-fill" data-mask>
        <SmartImage
          file={conv.shots[0]?.image} alt={conv.shots[0]?.alt ?? ''}
         
          widths={[520, 880, 1200]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="ai-conv__sm as-frame as-frame--float as-fill" data-pop data-pop-delay="200">
        <SmartImage
          file={conv.shots[1]?.image} alt={conv.shots[1]?.alt ?? ''}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 50vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <figcaption class="ai-conv__cap">{conv.caption}</figcaption>
    </figure>

    <div class="ai-conv__copy">
      <p class="as-kicker" data-reveal>{conv.kicker}</p>
      <ClipHeading class="as-h as-h--lg" id="ai-conv-t" text={conv.heading} />
      <RichLine class="as-body" text={conv.body[0]} reveal revealDelay={200} />

      <ul class="as-checks">
        {conv.cells.map((c, i) => (
          <li class="as-check" data-reveal data-reveal-delay={250 + i * 70}>
            <span class="as-check__i" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <circle cx="12" cy="12" r="9.4" stroke="currentColor" stroke-width="1.4" />
                <path d="m8 12.2 2.8 2.8 5.4-6" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </span>
            {c.label}
          </li>
        ))}
      </ul>
      <RichLine class="as-note" text={conv.body[1]} linkClass="as-link" reveal revealDelay={540} />
    </div>
  </div>
</section>

{/* ══ 06 · WHAT HAPPENS NEXT ═════════════════════════════════════════════════ */}
<section class="as-sec as-sec--peach as-pad--sm ai-next" aria-labelledby="ai-next-t">
  <div class="u-container ai-next__inner">
    <p class="as-kicker ai-next__kick" data-reveal>{next.kicker}</p>
    <ClipHeading class="as-h as-h--md ai-next__h" id="ai-next-t" text={next.heading} />

    <AsRail steps={next.cells} ground="peach" label="What happens next, four steps" class="ai-next__rail" />
  </div>
</section>

<AsClose
  id="ai-close-t"
  kicker={close.kicker}
  lead={closeLead}
  accent={closeAccent}
  body={close.body[0]}
  photo={close.shots[0]?.image ?? null}
/>

<style>
  /* ═══ 01 · HOW A YEAR ACTUALLY RUNS ═══════════════════════════════════════ */
  .ai-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(24px, 3.2vw, 52px);
    align-items: end;
  }
  :global(.ai-open__h) { max-width: 14ch; }
  :global(.ai-open__stand) { max-width: 46ch; margin-block: 0 clamp(4px, 0.6vw, 8px); }
  .ai-open__rail { margin-top: clamp(28px, 3.4vw, 48px); }

  /* ═══ 02 · THE LEARNING CYCLE ═════════════════════════════════════════════ */
  .ai-cycle {
    --pad: clamp(34px, 4vw, 62px);
    --gap: clamp(24px, 3.4vw, 54px);
    padding-block: var(--pad);
  }
  /* ⚠ THE BEIGE BLEEDS LEFT, AND ITS RIGHT EDGE IS THE COLUMN'S. Setting the
     width as a percentage of the SECTION put the edge inside the right column's
     eyebrow, because the section is the viewport and the columns are the
     container. It is a grid item in column one instead, so the edge tracks the
     column at every width, and only its ::before bleeds — clipped by the
     section's own overflow: hidden. */
  .ai-cycle__panel {
    grid-column: 1;
    grid-row: 1;
    align-self: stretch;
    position: relative;
    z-index: -1;
    margin-block: calc(var(--pad) * -1);
  }
  .ai-cycle__panel::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: calc(var(--gap) / -2);
    left: -100vw;
    background: #f5ede4;
  }
  .ai-cycle__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: var(--gap);
    align-items: center;
  }
  .ai-cycle__stage { grid-column: 1; grid-row: 1; }
  .ai-cycle__copy { grid-column: 2; grid-row: 1; }
  .ai-cycle__kick { margin-bottom: clamp(4px, 0.8vw, 10px); }

  .ai-ring {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 0.86;
    margin-top: clamp(6px, 1vw, 14px);
    color: rgba(201, 60, 10, 0.34);
  }
  .ai-ring__path { position: absolute; inset: 0; width: 100%; height: 100%; }

  .ai-ring__hub {
    position: absolute;
    top: 42%;
    left: 50%;
    translate: -50% -50%;
    display: grid;
    place-content: center;
    justify-items: center;
    width: 23%;
    aspect-ratio: 1 / 1;
    border: 1px solid var(--sb-border);
    border-radius: 50%;
    background: var(--sb-paper);
    box-shadow: var(--sb-shadow-card);
    text-align: center;
  }
  .ai-ring__hub span {
    font-size: clamp(8px, 0.72vw, 10.5px);
    font-weight: 700;
    letter-spacing: 0.15em;
    line-height: 1.5;
    text-transform: uppercase;
    color: var(--sb-charcoal);
  }
  .ai-ring__hub em {
    font-size: clamp(8px, 0.72vw, 10.5px);
    font-style: normal;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  .ai-ring__list { margin: 0; padding: 0; list-style: none; }
  /* ⚠ EACH NODE IS ANCHORED ON THE ELLIPSE by the --x/--y pair computed in the
     frontmatter from the same RING constant the <ellipse> uses. Text hangs below
     the disc; the block is 27% wide, which is what keeps the six from touching. */
  .ai-node {
    position: absolute;
    top: var(--y);
    left: var(--x);
    translate: -50% 0;
    display: grid;
    justify-items: center;
    width: 27%;
    text-align: center;
    transition: translate var(--sb-dur-image) var(--sb-ease);
  }
  .ai-node::before {
    /* lifts the disc so its CENTRE, not its top, sits on the ellipse */
    content: '';
    display: block;
    height: calc(clamp(26px, 2.6vw, 36px) / -2);
  }
  .ai-node__disc {
    display: grid;
    place-items: center;
    width: clamp(26px, 2.6vw, 36px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-violet);
    font-size: clamp(9.5px, 0.72vw, 11.5px);
    font-weight: 700;
    letter-spacing: 0.04em;
    color: #fff;
    transition: background-color var(--sb-dur-image) var(--sb-ease), scale var(--sb-dur-image) var(--sb-ease);
  }
  .ai-node__k {
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(11.5px, 0.95vw, 15px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .ai-node__v {
    margin: clamp(3px, 0.4vw, 5px) 0 0;
    font-size: clamp(8.5px, 0.63vw, 10px);
    line-height: 1.5;
    color: var(--sb-text-muted);
    transition: color var(--sb-dur-image) var(--sb-ease);
  }
  /* The hover the brief asks for: the step lifts, the accent appears, the
     description comes forward. Nothing moves horizontally. */
  .ai-node:hover { translate: -50% -3px; }
  .ai-node:hover .ai-node__disc { background: var(--sb-orange-bright); scale: 1.08; }
  .ai-node:hover .ai-node__v { color: var(--sb-text-secondary); }

  .ai-facets {
    display: grid;
    gap: clamp(8px, 1vw, 12px);
    margin: clamp(18px, 2.2vw, 26px) 0 0;
    padding: 0;
    list-style: none;
  }
  /* Small cards, and the only ones on the page — the reference asks for a stack
     of four here specifically. */
  .ai-facet {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(10px, 1.2vw, 14px);
    align-items: center;
    padding: clamp(10px, 1.2vw, 14px) clamp(12px, 1.4vw, 17px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 4px 16px -10px rgba(28, 14, 8, 0.14);
    transition: transform var(--sb-dur-image) var(--sb-ease), box-shadow var(--sb-dur-image) var(--sb-ease);
  }
  .ai-facet:hover { transform: translateY(-2px); box-shadow: var(--sb-shadow-card); }
  .ai-facet__m { display: block; width: clamp(20px, 1.9vw, 26px); color: var(--sb-violet); }
  .ai-facet__m svg { display: block; width: 100%; height: auto; }
  .ai-facet__t { display: grid; gap: 2px; }
  .ai-facet__k {
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.95vw, 14.5px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .ai-facet__v { font-size: clamp(10px, 0.74vw, 11.8px); line-height: 1.55; color: var(--sb-text-muted); }

  /* ═══ 03 · PUBLISHED WHEN IT MATTERS ══════════════════════════════════════ */
  .ai-struct__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(24px, 3.2vw, 50px);
    align-items: center;
  }
  :global(.ai-struct__b) { max-width: 34ch; }

  .ai-blocks {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
