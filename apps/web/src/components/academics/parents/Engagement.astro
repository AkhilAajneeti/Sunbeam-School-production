---
/**
 * PARENT PARTNERSHIP · 05 — PARENT ENGAGEMENT
 *
 * The mirror of section 04: photograph LEFT, copy right, on the sand band. Same
 * component, `reverse` set — which is what stops two adjacent split sections
 * reading as the same slide twice.
 */
import Photo from '../../ui/Photo.astro';
import Split from './Split.astro';
/* Parents at the Forum. This was the student council and NCC cadets on stage �
   a photograph of STUDENTS under a heading about engaging PARENTS. */
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/');
const photo = ac.pic('photo');
const parents = ac.blockMap('parents');

const { engagement: e } = parents;
---

<Split
  n={e.n}
  eyebrow={e.eyebrow}
  heading={e.heading}
  paragraphs={e.paragraphs}
  items={e.ways}
  reverse
  id="engagement-title"
  anchor="engagement"
  tone="sand"
>
  <div class="eng" slot="media">
    <div class="eng__frame" data-mask data-mask-from="left">
      <Photo
        file={photo}
        alt={e.alt}
        brief="Parent engagement"
        ratio="5 / 6"
        position="50% 40%"
        sizes="(max-width: 1023px) 90vw, 42vw"
      />
    </div>

    {/* An offset tint block behind the frame — the same device the leadership
        portraits on History use, which is what ties the two pages together. */}
    <span class="eng__tint" aria-hidden="true"></span>
  </div>
</Split>

<style>
  .eng { position: relative; isolation: isolate; }

  .eng__frame {
    position: relative;
    z-index: 1;
    border-radius: var(--sb-r-3);
    overflow: hidden;
    box-shadow: var(--sb-shadow-card);
  }

  .eng__frame :global(.photo) { height: 100%; }

  .eng__tint {
    position: absolute;
    z-index: 0;
    inset: 0;
    translate: -20px 20px;
    border-radius: var(--sb-r-3);
    background: rgba(201, 60, 10, 0.16);
  }

  @media (max-width: 639px) {
    /* The tint sticks out 20px to the left; auto margins give it that room on
       both sides and centre the frame at the same time. */
    .eng { margin-inline: 20px; }
  }
</style>
