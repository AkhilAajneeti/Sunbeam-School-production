---
/**
 * PARENT PARTNERSHIP · 01 — ORIENTATION
 *
 * Copy left, a cluster of three photographs right. The cluster rather than one
 * frame because orientation IS three things — the building, the people and the
 * paperwork — and a single image can only say one of them.
 *
 * The frames are placed on an explicit grid so the overlap is a matter of two
 * spans sharing cells. Negative margins would make it depend on each image's own
 * height, so a different crop or a slower decode would rearrange the composition.
 */
import Photo from '../../ui/Photo.astro';
import Split from './Split.astro';

import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/');
const readingPhoto = ac.pic('readingPhoto');
const entrancePhoto = ac.pic('entrancePhoto');
const campusPhoto = ac.pic('campusPhoto');
const parents = ac.blockMap('parents');

const { orientation: o } = parents;
---

<Split
  n={o.n}
  eyebrow={o.eyebrow}
  heading={o.heading}
  paragraphs={o.paragraphs}
  items={o.points}
  cta={o.cta}
  id="orientation-title"
  anchor="orientation"
  tone="ivory"
>
  <div class="ocl" slot="media">
    <div class="ocl__frame ocl__frame--a" data-parallax data-parallax-y="52">
      <div data-mask>
        <Photo
          file={entrancePhoto}
          alt={ac.picAlt('entrancePhoto')}
          brief="Orientation — meeting the school"
          ratio="4 / 5"
          position="50% 42%"
          sizes="(max-width: 1023px) 56vw, 26vw"
        />
      </div>
    </div>

    <div class="ocl__frame ocl__frame--b" data-parallax data-parallax-y="-70">
      <div data-mask data-mask-from="left">
        <Photo
          file={campusPhoto}
          alt={ac.picAlt('campusPhoto')}
          brief="Orientation — the campus walk"
          ratio="1 / 1"
          position="50% 55%"
          sizes="(max-width: 1023px) 44vw, 20vw"
        />
      </div>
    </div>

    <div class="ocl__frame ocl__frame--c" data-parallax data-parallax-y="38">
      <div data-mask>
        <Photo
          file={readingPhoto}
          alt={ac.picAlt('readingPhoto')}
          brief="Orientation — the handbook"
          ratio="3 / 2"
          position="50% 40%"
          sizes="(max-width: 1023px) 62vw, 28vw"
        />
      </div>
    </div>
  </div>
</Split>

<style>
  /* A 12 × 12 cell field the frames are placed into. */
  .ocl {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    grid-template-rows: repeat(12, minmax(0, 1fr));
    /* The field needs a height to divide into rows; an aspect ratio gives it one
       that scales instead of a fixed pixel value that does not. */
    aspect-ratio: 1 / 1;
  }

  .ocl__frame {
    position: relative;
    border-radius: var(--sb-r-2);
    overflow: hidden;
    box-shadow: var(--sb-shadow-card);
    will-change: transform;
  }

  .ocl__frame > div,
  .ocl__frame :global(.photo) { height: 100%; }

  /* a — tall, back-left. b — square, front, over a's right edge. c — wide,
     bottom, behind b's lower corner. */
  .ocl__frame--a { grid-column: 1 / 8; grid-row: 1 / 10; z-index: 1; }
  .ocl__frame--b { grid-column: 6 / 13; grid-row: 3 / 9; z-index: 3; }
  .ocl__frame--c { grid-column: 3 / 12; grid-row: 8 / 13; z-index: 2; }

  /* A keyline on the front frame, so where two photographs overlap there is a
     deliberate edge rather than two crops merging into one another. */
  .ocl__frame--b { border: 5px solid var(--sb-ivory); }

  /* Below this the three frames are ~110px each and the overlaps swallow their
     subjects. Two frames, side by side, at a size worth looking at. */
  @media (max-width: 639px) {
    .ocl {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-rows: auto;
      aspect-ratio: auto;
      gap: var(--sb-4);
    }

    .ocl__frame--a,
    .ocl__frame--b,
    .ocl__frame--c {
      grid-column: auto;
      grid-row: auto;
      /* The parallax script does not run below 1024, so nothing is fighting this
         reset — but a transform left behind would break the flow. */
      transform: none;
    }

    .ocl__frame--a { grid-column: span 2; }
    .ocl__frame--b { display: none; }
    .ocl__frame--c { grid-column: span 2; }
  }
</style>
