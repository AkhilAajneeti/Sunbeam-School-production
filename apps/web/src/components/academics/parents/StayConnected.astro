---
/**
 * ⏸ PARKED — NOT CURRENTLY RENDERED. Removed from the page at the client's
 * request along with everything below it; the page no longer closes on a call to action. The copy is still in
 * `parents` in data/academics.ts. To restore: import it and drop it back into
 * parent-partnership.astro after <Timeline />.
 *
 * PARENT PARTNERSHIP · SECTION 6 — THE CLOSING CTA
 *
 * Four ways to reach the school, on ink, at the foot of the page.
 *
 * THREE OF THE FOUR ARE LIVE LINKS, NOT LABELS. `tel:` and `mailto:` are the
 * whole point of putting a number on a school website: a parent on a phone taps
 * it. Rendering the number as plain text and expecting them to memorise it is the
 * commonest failure on this kind of page.
 *
 * Every value is verified in data/site.ts — the office and admissions lines, the
 * address, and the school's own email — so nothing here is a placeholder anyone
 * has to remember to swap.
 */
import { getSchool } from '../../../lib/cms';
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/');
const parents = ac.blockMap('parents');

const school = await getSchool();

const { cta } = parents;
---

<section class="pcta u-on-dark" aria-labelledby="pcta-title">
  <div class="u-container">
    <div class="pcta__panel">
      <span class="pcta__bloom" aria-hidden="true"></span>

      <div class="pcta__head">
        <h2 class="pcta__h" id="pcta-title" data-split>{cta.heading}</h2>
        <p class="pcta__stand">{cta.stand}</p>
      </div>

      <ul class="pcta__lines">
        {
          cta.lines.map((l, i) => (
            <li class="pcta__line" data-reveal data-reveal-delay={i * 70}>
              <a class="pcta__link" href={l.href}>
                <span class="pcta__label">{l.label}</span>
                <span class="pcta__value t-tabular">{l.value}</span>
                <span class="pcta__go" aria-hidden="true">
                  <svg width="15" height="10" viewBox="0 0 14 10" fill="none">
                    <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
              </a>
            </li>
          ))
        }
      </ul>

      <div class="pcta__actions">
        <a class="btn btn--primary" href={school.external.applyNurseryToIX} target="_blank" rel="noopener">
          Apply online
        </a>
        <a class="btn btn--on-image-secondary" href="/contact-us/">Visit the campus</a>
      </div>
    </div>
  </div>
</section>

<style>
  .pcta {
    padding-block: 0 var(--sb-section-y-major);
    background: var(--sb-ivory);
  }

  .pcta__panel {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding: clamp(36px, 4.6vw, 76px);
    border-radius: 36px;
    background: var(--sb-ink);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
    box-shadow: 0 30px 80px -46px rgba(28, 14, 8, 0.6);
  }

  .pcta__bloom {
    position: absolute;
    z-index: -1;
    inset: -20% -10% auto auto;
    width: 56%;
    aspect-ratio: 1;
    background:
      radial-gradient(circle at 60% 40%, rgba(255, 92, 53, 0.34), transparent 66%),
      radial-gradient(circle at 30% 60%, rgba(255, 138, 92, 0.22), transparent 70%);
    filter: blur(54px);
    pointer-events: none;
  }

  .pcta__head { max-width: 54ch; }

  .pcta__h {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.6vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.035em;
    color: #fff;
  }

  .pcta__stand {
    margin-top: var(--sb-5);
    font-size: var(--sb-body);
    line-height: 1.7;
    color: var(--sb-on-dark-78);
  }

  /* --- The four lines ------------------------------------------------------ */

  .pcta__lines {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 clamp(28px, 4vw, 64px);
    margin: clamp(32px, 4.4vh, 56px) 0 0;
    padding: 0;
    list-style: none;
  }

  /* The rule sits on each line's top edge, so the first row of each column has
     none and there is no trailing rule to suppress. */
  .pcta__line { border-top: 1px solid var(--sb-on-dark-rule); }

  .pcta__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sb-5);
    padding: clamp(16px, 2vh, 24px) 0;
    /* Reserved, not added on hover — otherwise the row shifts by 2px as the
       pointer enters it. */
    border-left: 2px solid transparent;
    padding-left: 0;
    transition:
      border-left-color var(--sb-dur-link) ease,
      padding-left var(--sb-dur-link) var(--sb-ease);
  }

  .pcta__link:hover {
    border-left-color: var(--sb-lime);
    padding-left: var(--sb-5);
  }

  .pcta__label {
    grid-column: 1;
    grid-row: 1;
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sb-lime);
  }

  .pcta__value {
    grid-column: 1;
    grid-row: 2;
    margin-top: 4px;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(17px, 1.6vw, 22px);
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: #fff;
    /* The email is one long unbroken token and would otherwise push the column
       wider than its share of the grid. */
    overflow-wrap: anywhere;
  }

  .pcta__go {
    grid-column: 2;
    grid-row: 1 / span 2;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 1px solid rgba(255, 255, 255, 0.26);
    border-radius: var(--sb-r-full);
    color: var(--sb-lime);
    transition:
      background-color var(--sb-dur-link) ease,
      border-color var(--sb-dur-link) ease,
      transform var(--sb-dur-link) var(--sb-ease);
  }

  .pcta__link:hover .pcta__go {
    background: rgba(255, 138, 92, 0.18);
    border-color: var(--sb-lime);
    transform: translateX(3px);
  }

  .pcta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-4);
    margin-top: clamp(32px, 4.4vh, 52px);
  }

  @media (prefers-reduced-motion: reduce) {
    .pcta__link,
    .pcta__go { transition: none; }
    .pcta__link:hover { padding-left: 0; }
    .pcta__link:hover .pcta__go { transform: none; }
  }

  @media (max-width: 767px) {
    .pcta__panel { border-radius: 24px; }
    .pcta__lines { grid-template-columns: minmax(0, 1fr); }
  }
</style>
