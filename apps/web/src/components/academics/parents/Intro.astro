---
/**
 * ⏸ PARKED — NOT CURRENTLY RENDERED. Removed at the client's request so the page
 * opens straight onto Orientation. The copy is still in `parents.intro` in
 * data/academics.ts and the figures are still derived below. To restore: import
 * it and drop it back into parent-partnership.astro above <Orientation />, and
 * put `{ id: 'partnership', label: 'The partnership' }` back at the head of that
 * page's SectionRail — the anchor this section carries is what that item points
 * at, and it was removed with it.
 *
 * WHAT THE PAGE LOST WITH IT: the argument. Nothing now states what the
 * partnership IS before the page begins listing its parts, and the four figures
 * — channels, families, teaching staff, years ranked first — appear nowhere else
 * on the site's Academics pages.
 *
 * PARENT PARTNERSHIP · SECTION 1 — THE PHILOSOPHY, BEFORE THE FEATURES
 *
 * A statement and a photograph, then the figures. The order is the argument: a
 * page that opens on a list of channels is a manual, and a parent deciding
 * whether to trust a school is not reading a manual.
 *
 * The headline is HeroTitle at level 2 — the banner above owns the <h1>, and the
 * component's server-split, CSS-driven word rise is what lets a heading this high
 * on the page animate at all (motion-gsap.ts refuses to touch anything already on
 * screen, which is why every banner headline on this site used to sit static).
 *
 * FOUR FIGURES, AND NOT THE FOUR THE BRIEF NAMED. It asked for Parent Meetings,
 * Communication Channels, Workshops Every Year and Dedicated Parent Support — but
 * supplied no numbers, and the school publishes none for three of them. Inventing
 * "24 meetings a year" would be inventing a fact about how this school runs. What
 * IS knowable: the channel count follows arithmetically from the published list,
 * and the other three are verified figures a parent actually weighs. Swap them
 * the moment the school supplies its own.
 */
import { Image } from 'astro:assets';
import Photo from '../../ui/Photo.astro';
import HeroTitle from '../../ui/HeroTitle.astro';
import CounterStrip from '../CounterStrip.astro';
import kite from '../../../assets/icons/kite.png';
import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/');
const photo = ac.pic('photo');
const parents = ac.blockMap('parents');
const partnership = ac.section('partnership').points;

const { intro } = parents;

/** Derived, not asserted: the length of the published list of channels. */
const channelCount = partnership.length;

const figures = [
  { n: channelCount, suffix: '', label: 'Standing channels between school and home' },
  { n: 2700, suffix: '+', label: 'Families in the Sunbeam Ballia community' },
  { n: 130, suffix: '+', label: 'Teaching staff a parent can talk to' },
  { n: 6, suffix: '', label: 'Consecutive years ranked #1 in Ballia' },
];
---

<section class="pin" id="partnership" aria-labelledby="pin-title">
  <div class="u-container">
    <div class="pin__grid">
      <div class="pin__copy">
        <p class="pin__eyebrow">
          <span class="pill pill--violet">
            <span class="pin__dot" aria-hidden="true"></span>
            {intro.eyebrow}
          </span>
        </p>

        <HeroTitle
          level={2}
          id="pin-title"
          class="pin__h"
          lead={intro.headingLead}
          mark={intro.headingMark}
          tail={intro.headingTail}
        />

        <div class="pin__prose">
          {intro.paragraphs.map((p) => <p>{p}</p>)}
        </div>
      </div>

      <div class="pin__media" data-reveal>
        <div data-mask>
          <Photo
            file={photo}
            alt={ac.picAlt('photo')}
            brief="Home and school"
            ratio="4 / 5"
            position="50% 40%"
            sizes="(max-width: 1023px) 90vw, 44vw"
          />
        </div>

        {/* Decorative, and the one floating object on this section. */}
        <Image
          class="pin__kite"
          src={kite}
          alt=""
          aria-hidden="true"
          widths={[160, 320]}
          sizes="130px"
          loading="lazy"
        />
      </div>
    </div>

    <div class="pin__figures" data-reveal>
      <CounterStrip tone="light" items={figures} />
    </div>
  </div>
</section>

<style>
  .pin {
    position: relative;
    overflow: hidden;
    padding-block: clamp(56px, 8vh, 92px) var(--sb-section-y);
    background:
      radial-gradient(70% 46% at 92% 4%, #fff2e9 0%, rgba(255, 242, 233, 0) 60%),
      var(--sb-ivory);
  }

  .pin__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    gap: clamp(32px, 5vw, 84px);
    align-items: center;
  }

  .pin__eyebrow { margin-bottom: var(--sb-5); }

  .pin__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--sb-r-full);
    background: var(--sb-violet);
    flex-shrink: 0;
  }

  .pin__eyebrow .pill {
    font-size: var(--sb-label);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  /* HeroTitle's type lives inside that component — a scoped rule here would
     compile to `.pin__h[data-astro-cid-PAGE]` and match nothing, because Astro
     passes a class to a child but not its style scope. Custom properties do cross
     the boundary, so the three values this section varies are handed over on an
     ancestor it owns. */
  .pin__copy {
    --htitle-size: clamp(30px, 4vw, 56px);
    --htitle-measure: 17ch;
    --htitle-color: var(--sb-charcoal);
  }

  .pin__prose { margin-top: clamp(24px, 3.4vh, 40px); }

  .pin__prose p {
    max-width: 52ch;
    font-size: var(--sb-body);
    line-height: 1.76;
    color: var(--sb-text-secondary);
  }

  .pin__prose p + p { margin-top: var(--sb-5); }

  /* --- Media --------------------------------------------------------------- */

  .pin__media {
    position: relative;
    border-radius: var(--sb-r-3);
  }

  .pin__media > div {
    border-radius: var(--sb-r-3);
    overflow: hidden;
    box-shadow: var(--sb-shadow-card);
  }

  .pin__kite {
    position: absolute;
    z-index: 1;
    left: clamp(-34px, -2.2vw, -16px);
    bottom: clamp(-26px, -1.6vw, -10px);
    width: clamp(78px, 8vw, 118px);
    height: auto;
    pointer-events: none;
    user-select: none;
    animation: pin-kite 7s ease-in-out infinite;
  }

  @keyframes pin-kite {
    0%, 100% { rotate: -6deg; translate: 0 0; }
    50% { rotate: 4deg; translate: 6px -10px; }
  }

  /* base.css collapses durations under reduced motion but leaves delays alone;
     switching this off outright parks it at a deliberate resting angle. */
  @media (prefers-reduced-motion: reduce) {
    .pin__kite { animation: none; rotate: -6deg; }
  }

  /* --- Figures ------------------------------------------------------------- */

  .pin__figures {
    margin-top: clamp(48px, 7vh, 88px);
    padding-top: clamp(32px, 4.4vh, 52px);
    border-top: var(--sb-hairline);
  }

  @media (max-width: 1023px) {
    .pin__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(32px, 5vh, 48px); }
    .pin__media { max-width: 520px; }
  }

  @media (max-width: 639px) {
    .pin { padding-block: var(--sb-9) var(--sb-section-y); }
    .pin__kite { display: none; }
  }
</style>
