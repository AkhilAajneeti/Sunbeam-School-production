---
/**
 * ═══ ACADEMIC EXCELLENCE — THE TWO BOARDS ══════════════════════════════════
 *
 * Two real <table> elements side by side, transcribed from the boards mounted
 * in the school. Nothing here is written by us: the sessions, the names and
 * the marks are the school's own record, and this component's only jobs are to
 * put the newest session first, title-case the names for reading, and tint the
 * highest mark on each board.
 *
 * ⚠⚠ IT IS A TABLE BECAUSE IT IS A TABLE. The source is a ruled board with
 * three columns and a row per session, and a reader wants to scan down a year
 * or across a name. Cards would break the column alignment that makes it
 * readable, and a screen reader would lose the session/name/mark relationship
 * altogether. Do not "modernise" this into a card grid.
 *
 * ⚠ THE EMPTY-BOARD GUARD STAYS EVEN THOUGH BOTH BOARDS ARE NOW TRANSCRIBED.
 * `hasBoards` and the `.filter(rows.length > 0)` below cost nothing and cover
 * the state this file shipped in: half a board published is a
 * misrepresentation of the school's record, and a "Highest on this board" tint
 * computed over a partial transcription would be an outright false statement.
 * If a board is ever emptied for re-checking, it disappears rather than lying.
 */
import { getToppers, getAcademicTopic, type TopperRow } from '../../lib/cms';

/**
 * ⚠ THE SECTION'S WORDS, FROM THE CMS — including the two notes that qualify a
 * figure. See data/classCornerPage.ts: they are the page saying which numbers
 * it could not read, not decoration.
 */
const ac = await getAcademicTopic('/academics/class-corner/');
const intro = ac.section('toppersIntro');
const labels = ac.section('toppersLabels');

/**
 * ⚠⚠ THE BOARDS COME FROM THE CMS NOW. They were a data file, which meant the
 * school could not add next session's topper — the one thing this section is
 * certain to need every year — without a developer. Each name is a row in
 * Content Manager → Board Topper.
 *
 * ⚠ data/toppers.ts STAYS IN THE REPOSITORY as the seed's source and as the
 * record of where each line was read off the board. Editing it changes nothing
 * on the site.
 */
const { classX, classXII, hasBoards } = await getToppers();

/**
 * ⚠⚠ DERIVED HERE, NOT STORED. "Highest on this board" is a fact about the
 * rows, not a flag an editor should be able to set — stored, it would drift
 * the moment a name was added and quietly mark the wrong child.
 *
 * ⚠ RETURNS null ON AN EMPTY BOARD. `reduce` with no initial value throws on
 * an empty array, which would take the whole PAGE down rather than just this
 * section.
 */
const peak = (rows: TopperRow[]): TopperRow | null =>
  rows.length
    ? rows.reduce((a, b) => (parseFloat(b.percent) > parseFloat(a.percent) ? b : a))
    : null;

/** 'first — last' from the board's own order, for the table's standfirst. */
const span = (rows: TopperRow[]): string | null =>
  rows.length ? `${rows[0].session} – ${rows[rows.length - 1].session}` : null;

const bestX = peak(classX);
const bestXII = peak(classXII);
const spanX = span(classX);
const spanXII = span(classXII);

/**
 * ⚠ THE STORED SPELLING IS THE RECORD; THE CASING IS PRESENTATION. Names are
 * transcribed in capitals because that is how the boards are engraved, and a
 * wall of capitals is hard to read at table size. This lower-cases everything
 * after the first letter of each word — it does NOT correct anything, and no
 * spelling may be "fixed" in the data to match a hunch.
 */
const nice = (n: string) =>
  n.replace(/[A-Za-z]+/g, (w) => w[0].toUpperCase() + w.slice(1).toLowerCase());

/**
 * ⚠⚠ .reverse() MUTATES, SO THE SPREAD IS LOAD-BEARING. `[...classX]` copies
 * before reversing; reversing the import directly would flip the module's own
 * array for every other consumer, and the data is deliberately stored in the
 * board's engraved order so the transcription can be checked line by line
 * against the photograph.
 */
const boards = [
  {
    label: 'Class X toppers',
    rows: [...classX].reverse(),
    best: bestX,
    span: spanX,
    id: 'toppers-x',
  },
  {
    label: 'Class XII toppers',
    rows: [...classXII].reverse(),
    best: bestXII,
    span: spanXII,
    id: 'toppers-xii',
  },
].filter((b) => b.rows.length > 0);

/** The footnote only exists if a row actually carries the flag. */
const needsFootnote = [...classX, ...classXII].some((r: TopperRow) => r.check);
---

{
  hasBoards && (
    <section class="tpr" id="academic-excellence" aria-labelledby="tpr-heading">
      <span class="tpr__blob" aria-hidden="true" />

      <div class="u-container">
        <p class="tpr__eyebrow">{intro.eyebrow}</p>
        <h2 class="tpr__h" id="tpr-heading">{intro.heading}</h2>
        <p class="tpr__lead">{intro.body[0]}</p>

        <div class="tpr__pair">
          {boards.map((b) => (
            <div class="tpr__board">
              <h3 class="tpr__bh" id={b.id}>
                {b.label}
                {b.span && <span class="tpr__span">{b.span}</span>}
              </h3>

              <table class="tpr__t">
                {/* Named for a screen reader, which reaches the table without
                    the heading beside it. */}
                <caption class="u-visually-hidden">
                  {b.label} — the session topper and percentage on the
                  school's board, newest session first
                </caption>
                <thead>
                  <tr>
                    <th scope="col">Session</th>
                    <th scope="col">Student</th>
                    {/* The board's own column head. The visually-hidden
                        caption above carries the long form for a reader who
                        never sees it. */}
                    <th scope="col">%</th>
                  </tr>
                </thead>
                <tbody>
                  {b.rows.map((r) => {
                    const top = !!b.best && r === b.best;
                    return (
                      <tr class:list={['tpr__r', top && 'tpr__r--top']}>
                        {/* scope="row" — the session is what identifies the
                            row, and without it the name and the mark are read
                            as loose cells. */}
                        <th scope="row">{r.session}</th>
                        <td>
                          {nice(r.name)}
                          {/* ⚠ A TINT AND A LABEL, NOT A TROPHY — and the
                              label is visible text inside the row rather than
                              a legend under the table or a hidden duplicate.
                              A colour-only highlight says nothing to a screen
                              reader and nothing to a reader who cannot
                              distinguish the tint; sitting in the cell it is
                              read out with the name it belongs to.
                              It states only what the arithmetic supports: the
                              highest figure on THIS board. No rank, and no
                              comparison with any other school. */}
                          {top && (
                            <span class="tpr__top">{labels.eyebrow}</span>
                          )}
                        </td>
                        <td class="tpr__pc">
                          {r.percent}
                          {r.check && (
                            <abbr
                              class="tpr__flag"
                              title={labels.body[0]}
                            >
                              *
                            </abbr>
                          )}
                        </td>
                      </tr>
                    );
                  })}
                </tbody>
              </table>

            </div>
          ))}
        </div>

        {needsFootnote && (
          <p class="tpr__fn">{labels.body[1]}</p>
        )}
      </div>
    </section>
  )
}

<style>
  /* ⚠⚠ THE STACKING CONTRACT — ALL FOUR ARE LOAD-BEARING, AND THIS SECTION IS
     THE ONE THE BUG WAS REPORTED ON. `.tpr` was left at `z-index: auto` and
     the pinned PageHero showed through the top of this section three separate
     times. A positioned sibling at `auto` paints above the banner only by tree
     order, which is fragile the moment anything between them creates a
     stacking context.
     ⚠ `isolation: isolate` ALONE DOES NOT FIX IT — the explicit z-index does.
     ⚠ VERIFY WITH MOTION ENABLED, AT THE HEADING. Two earlier checks missed
     it: `reducedMotion: 'reduce'` switches PageHero from sticky to relative,
     where the overlap CANNOT occur at all; and sampling at section.top + 260
     lands on the tables, while the reports were always of the heading. */
  .tpr {
    position: relative;
    z-index: 1;
    isolation: isolate;
    background: var(--sb-sand);
    padding-block: var(--sb-section-y);
    /* For the blob. Independent of the contract above, and no substitute. */
    overflow: hidden;
  }

  .tpr__blob {
    position: absolute;
    z-index: -1;
    top: -160px;
    left: 50%;
    width: 520px;
    height: 520px;
    transform: translateX(-50%);
    border-radius: 50%;
    background: rgba(201, 60, 10, 0.05);
    filter: blur(90px);
    pointer-events: none;
  }

  .tpr__eyebrow {
    margin: 0 0 var(--sb-5);
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  .tpr__h {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 2.6vw, 34px);
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sb-ink);
  }

  .tpr__lead {
    margin: var(--sb-5) 0 var(--sb-8);
    max-width: 60ch;
    font-size: var(--sb-body-sm);
    line-height: 1.7;
    color: var(--sb-text-muted);
  }

  /* ⚠ align-items: stretch (the default, stated) — NOT `start`. The boards
     hold a different number of sessions, 9 against 8, and left to size
     themselves the shorter card stops an inch above the taller one and the
     pair reads as one card and an offcut. These two are a matched set hanging
     side by side on a wall; they end level. */
  .tpr__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: stretch;
    gap: var(--sb-7);
  }

  .tpr__board {
    /* ⚠ 30px, not --sb-6 (24). Measured against the reference after scaling
       for card width: its padding is ~34 on a 706px card, which is 30 on the
       624px card this container gives. */
    padding: 30px;
    border: 1px solid rgba(18, 16, 15, 0.08);
    border-radius: var(--sb-r-0);
    background: var(--sb-paper);
  }

  /* ⚠ space-between: the range belongs at the card's right edge, opposite the
     board's name — it labels the whole table, not the title. Sitting straight
     after the title it read as part of the heading. */
  .tpr__bh {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 10px;
    /* ⚠ THE BOARD'S NAME STANDS WELL CLEAR OF THE COLUMN HEADS. At --sb-5 the
       two sat 18px apart and read as a two-line header; the reference leaves
       ~46px, which is what separates the card's title from the table inside
       it. */
    margin: 0 0 44px;
    font-family: var(--sb-font-display);
    font-size: 20px;
    font-weight: 600;
    color: var(--sb-ink);
  }
  .tpr__span {
    font-family: inherit;
    font-size: var(--sb-caption);
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--sb-text-muted);
  }

  .tpr__t {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--sb-body-sm);
  }
  .tpr__t th,
  .tpr__t td {
    /* ⚠ THE VERTICAL PADDING SETS THE ROW PITCH, and the pitch was 48 against
       the reference's 43 (scaled). Nine rows of that is half a row of drift by
       the foot of the table. */
    padding: 8px 12px;
    text-align: left;
    vertical-align: baseline;
  }
  .tpr__t thead th {
    border-bottom: 1px solid rgba(18, 16, 15, 0.12);
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .tpr__t tbody th {
    font-weight: 600;
    white-space: nowrap;
    color: var(--sb-text-muted);
  }
  .tpr__t tbody td {
    color: var(--sb-ink);
  }
  .tpr__t tbody tr + tr th,
  .tpr__t tbody tr + tr td {
    border-top: 1px solid rgba(18, 16, 15, 0.06);
  }

  /* ⚠ THE FIGURES CARRY A LITTLE MORE WEIGHT THAN THE NAMES. They are what a
     reader scans the column for, and tabular-nums keeps them aligned on the
     decimal down the whole board. */
  .tpr__pc {
    font-variant-numeric: tabular-nums;
    font-weight: 500;
    white-space: nowrap;
  }

  .tpr__r--top th,
  .tpr__r--top td {
    background: var(--sb-lime-wash);
  }
  .tpr__r--top .tpr__pc {
    font-weight: 700;
    color: var(--sb-violet);
  }
  .tpr__r--top th:first-child {
    border-start-start-radius: 8px;
    border-end-start-radius: 8px;
  }
  .tpr__r--top td:last-child {
    border-start-end-radius: 8px;
    border-end-end-radius: 8px;
  }

  .tpr__flag {
    margin-left: 2px;
    border: 0;
    text-decoration: none;
    color: var(--sb-violet);
    cursor: help;
  }

  .tpr__top {
    display: block;
    margin-top: 1px;
    /* ⚠ ITS OWN LEADING. Inheriting the table's 1.6 made this one row 5px
       taller than the reference's, which is enough to push every row below it
       out of step with the board beside it. */
    line-height: 1.2;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }

  .tpr__fn {
    margin: var(--sb-6) 0 0;
    max-width: 68ch;
    font-size: var(--sb-caption);
    line-height: 1.7;
    color: var(--sb-text-muted);
  }

  @media (max-width: 899px) {
    .tpr__pair {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-6);
    }
  }
  @media (max-width: 479px) {
    .tpr__board {
      padding: var(--sb-5);
    }
    .tpr__t th,
    .tpr__t td {
      padding: 9px 8px;
    }
  }
</style>
