---
/**
 * JOURNEY CAROUSEL — a centred head, a three-up rail of image-led cards, arrows
 * on the rail's edges, and an animated wave closing the band.
 *
 * REBUILT TO A SUPPLIED REFERENCE. The client pasted a course-card carousel and
 * asked for it exactly: bracketed eyebrow, centred heading and standfirst, three
 * full-bleed portrait cards, a white plate hung off each card's bottom edge, and
 * circular prev/next buttons sitting on the container's gutters. The previous
 * version of this component was a PINNED COVERFLOW — the centre card square-on
 * and its neighbours turned away in perspective. That is gone, deliberately, and
 * the reasoning for each half of the swap is worth keeping:
 *
 *   · The coverflow needed the pin, because turning cards by their distance from
 *     the centre only reads while something is moving them. Three cards standing
 *     still have nothing to turn.
 *   · Losing the pin means this section no longer takes the page scroll hostage.
 *     `data-rail-nopin` tells the shared machinery in motion-gsap.ts to leave it
 *     on the native scroller, which is a strictly better default — see the note
 *     there.
 *
 * ⚠ THE CARD HAS NO ROOM FOR A DESCRIPTION. The reference card is meta, title,
 * rule and three facts, and that is what this builds. Callers passing a `body`
 * will find it unused: the six workshop paragraphs written for the old card are
 * still in the data and still good copy, but they are not on screen here. If the
 * client wants them back the change is one clamped paragraph between the title
 * and the rule — flagged rather than done, because "exact same as the image" was
 * the instruction.
 *
 * ═══ STILL A REAL SCROLLER ══════════════════════════════════════════════════
 *
 * In CSS this is an `overflow-x` region with scroll-snap, a tabindex and a label,
 * exactly as before. The arrows are an enhancement on top: they ship `hidden` and
 * the script below reveals them, so a blocked script leaves no dead controls and
 * the rail still takes flick, drag, shift-wheel, arrow keys and a scrollbar.
 *
 * ═══ THE PLATE IS ANCHORED, NOT PULLED UP ═══════════════════════════════════
 *
 * The white body is absolutely positioned to the card's bottom and the card
 * reserves a fixed overhang beneath the photograph. A negative margin would have
 * made the composition depend on the plate's own height, so a card whose title
 * ran to three lines would hang lower than its neighbours. This way the overhang
 * is a constant and every card in the row ends on the same line, whatever the
 * copy does.
 */
import Photo from '../ui/Photo.astro';

interface Card {
  n: string;
  title: string;
  /** ⚠ Not rendered — see the header. Kept so callers need not strip their data. */
  body?: string;
  chips: readonly string[];
  /** "Webinar · evening" — split on the middle dot into the card's two meta words. */
  fact?: string;
  /** Resolved ImageMetadata, or undefined where no photograph exists yet. */
  image?: ImageMetadata;
  alt?: string;
}

interface Props {
  /** Section number. Folded into the bracketed eyebrow rather than set loose. */
  n?: string;
  eyebrow: string;
  heading: string;
  stand?: string;
  items: readonly Card[];
  /** Wire to the section's aria-labelledby. */
  id: string;
  /** Anchor id for the section element. */
  anchor?: string;
  /** Spoken description of what the rail holds, for the scroll region. */
  railLabel: string;
  /**
   * An optional way out of the section, centred under the rail. The rail shows
   * a fixed set of cards; this is where a reader goes for the rest.
   */
  cta?: { label: string; href: string; external?: boolean } | null;
  /**
   * The ground the closing wave is painted in — it should be the background of
   * whatever section comes NEXT, so the wave reads as the next band rising into
   * this one rather than as a decoration floating on this one.
   */
  waveInto?: string;
}

const {
  n,
  eyebrow,
  heading,
  stand,
  items,
  id,
  anchor,
  railLabel,
  cta = null,
  waveInto = 'var(--sb-ivory)',
} = Astro.props;

/* The reference card's meta line is two words: an accented one and a muted one.
   Ours come from the one `fact` string the data already carries, split on its
   middle dot — "Webinar · evening" reads as WEBINAR • EVENING. A fact with no
   dot simply has no second word rather than an empty span. */
const cards = items.map((c) => {
  const [lead = '', trail = ''] = (c.fact ?? '').split('·').map((s) => s.trim());
  return { ...c, lead, trail };
});
---

<section
  class="jcar"
  id={anchor}
  data-rail-scope
  data-rail-nopin
  aria-labelledby={id}
>
  <div class="u-container">
    <div class="jcar__head">
      {/* The brackets are the reference's, and they are typed rather than drawn
          in CSS so a screen reader hears the eyebrow the way it is written. */}
      <p class="jcar__eyebrow">[{n ? `${n} · ` : ''}{eyebrow}]</p>
      <h2 class="jcar__h" id={id} data-split>{heading}</h2>
      {stand && <p class="jcar__stand">{stand}</p>}
    </div>
  </div>

  {/* Relative, and the arrows' containing block. It is the CONTAINER's width
      rather than full-bleed: the reference clips the rail exactly at the
      container's edges — three cards, nothing peeking past the third — and the
      arrows hang half outside it onto the gutters. */}
  <div class="jcar__rail">
    <div
      class="jcar__viewport"
      data-rail
      tabindex="0"
      role="region"
      aria-label={railLabel}
    >
      <ol class="jcar__track" data-rail-track>
        {
          cards.map((c) => (
            <li class="jcard" data-rail-item>
              <article class="jcard__inner">
                <div class="jcard__media">
                  {c.image ? (
                    <Photo
                      file={c.image}
                      alt={c.alt ?? ''}
                      brief={c.title}
                      position="50% 40%"
                      sizes="(max-width: 639px) 84vw, (max-width: 1023px) 44vw, 420px"
                    />
                  ) : (
                    <span class="jcard__plain" aria-hidden="true" />
                  )}
                </div>

                <div class="jcard__panel">
                  <p class="jcard__meta">
                    <span class="jcard__meta-a">{c.lead}</span>
                    {c.trail && (
                      <>
                        <span class="jcard__meta-dot" aria-hidden="true" />
                        <span class="jcard__meta-b">{c.trail}</span>
                      </>
                    )}
                  </p>

                  <h3 class="jcard__h">{c.title}</h3>

                  <div class="jcard__foot">
                    <p class="jcard__fact">
                      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <path
                          d="M4 1.6h5l3 3v9.8H4V1.6Z"
                          stroke="currentColor"
                          stroke-width="1.2"
                          stroke-linejoin="round"
                        />
                        <path d="M9 1.8v3h3M6 8h4M6 10.6h4" stroke="currentColor" stroke-width="1.2" />
                      </svg>
                      {c.chips.length} topics
                    </p>

                    <p class="jcard__fact">
                      <svg width="15" height="15" viewBox="0 0 16 16" fill="none" aria-hidden="true">
                        <circle cx="8" cy="5.4" r="2.6" stroke="currentColor" stroke-width="1.2" />
                        <path
                          d="M2.6 14c0-2.7 2.4-4.4 5.4-4.4s5.4 1.7 5.4 4.4"
                          stroke="currentColor"
                          stroke-width="1.2"
                          stroke-linecap="round"
                        />
                      </svg>
                      For parents
                    </p>

                    <p class="jcard__tag t-tabular">Session {c.n}</p>
                  </div>
                </div>
              </article>
            </li>
          ))
        }

        {/* Real element, not padding and not a pseudo: Chrome counts neither in a
            horizontal flex scroller's scrollable width, so the last card would
            end flush against the window edge instead of on the gutter. */}
        <li class="jcar__tail" data-rail-tail aria-hidden="true"></li>
      </ol>
    </div>

    <div class="jcar__nav" data-rail-btns hidden>
      <button class="jcar__arrow jcar__arrow--prev" type="button" data-rail-prev aria-label="Previous">
        <svg width="17" height="12" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M5 1L1 5l4 4M1 5h13" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>
      <button class="jcar__arrow jcar__arrow--next" type="button" data-rail-next aria-label="Next">
        <svg width="17" height="12" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M9 1l4 4-4 4M13 5H0" stroke="currentColor" stroke-width="1.6" />
        </svg>
      </button>
    </div>
  </div>

  {
    cta && (
      <div class="jcar__out">
        <a
          class="btn btn--primary"
          href={cta.href}
          {...(cta.external ? { target: '_blank', rel: 'noopener' } : {})}
        >
          {cta.label}
          {cta.external && <span class="u-visually-hidden">(opens in a new tab)</span>}
        </a>
      </div>
    )
  }

  {/* THE CLOSING WAVE. Four layered paths at four different periods, each morphed
      by SMIL rather than by script — it costs no JavaScript, it runs on the
      compositor, and it keeps working with the motion chunk absent. The layers
      drift out of phase because their durations are coprime-ish (10s, 8s, 6.5s,
      5.5s), which is what stops four waves reading as one thick wave.

      Painted in the NEXT section's ground, so the band below appears to rise into
      this one. Reduced motion is handled in the script at the foot of this file:
      SMIL cannot be stopped from CSS, so it is paused on the element. */}
  <div class="jcar__wave" data-wave aria-hidden="true">
    <svg viewBox="0 0 1440 461" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg">
      <path
        fill-opacity=".09"
