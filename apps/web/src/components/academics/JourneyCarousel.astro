</section>

<style define:vars={{ waveInto }}>
  .jcar {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    /* The foot clears the wave, which is absolutely positioned and therefore
       takes no space of its own. Without it the last card's plate would sit
       under the crests. */
    padding-block: clamp(64px, 9vh, 104px) clamp(150px, 20vh, 240px);
    /* THE FOOT IS DEEPENED SO THE WAVE CAN BE SEEN. Sand and ivory are three
       percent apart in lightness, which is the right relationship for two
       stacked bands and completely wrong for a shape drawn in one on the other —
       the first build's wave was measurably present and visually absent. The
       warm wash only reaches the bottom half, where the crests are. */
    background:
      linear-gradient(to bottom, rgba(201, 60, 10, 0) 50%, rgba(201, 60, 10, 0.085) 100%),
      radial-gradient(58% 34% at 50% 0%, #fff3ec 0%, rgba(255, 243, 236, 0) 68%),
      var(--sb-sand);

    /* One place the three-up arithmetic is defined. --jcar-w is the container's
       real width at any viewport, so the cards divide the same space the heading
       is set in and the row lines up with it exactly. */
    --jcar-gap: clamp(16px, 2.2vw, 34px);
    --jcar-w: min(100vw - 2 * var(--sb-margin), var(--sb-max-content));
    --jcar-per: 1.14;
    /* Constant, so every card in the row ends on the same line — see the header. */
    --jcard-overhang: clamp(44px, 4.6vw, 70px);

    /* ── THE NEXT ARROW HAS TO DODGE THE PAGE'S SECTION INDEX ────────────────
       SectionRail is `position: fixed`, z-index 40, pinned to the right edge —
       and from 1200 up it floats OVER the container rather than in a gutter,
       because the gutter is the margin token and that is never more than 48px.
       Measured at 1280: the index occupies 1191–1260 and the container ends at
       1232, so it covers the container's last 41px. The next button landed
       inside that and the index intercepted its clicks outright.

       IT CANNOT BE SOLVED WITH z-index. `.u-page-panel` in base.css is
       `position: relative; z-index: 1`, which makes the entire page body one
       stacking context — nothing inside it can ever paint above a fixed element
       at 40. Tried, measured, reverted.

       So it is solved geometrically. The button is pushed inward exactly as far
       as it must be and no further: `max()` takes the reference's outward
       overhang wherever the gutter is wide enough to allow it, and the
       clearance the index needs everywhere else. At 1920 that is the full
       overhang; at 1440 it is 23px inside; at 1280 it is 77px inside.
       --jcar-index is the index's measured 70px width plus its own right offset
       plus 10px of daylight. */
    --jcar-index: calc(70px + clamp(12px, 1.6vw, 26px) + 10px);
    --jcar-gutter: calc((100vw - var(--jcar-w)) / 2);
    --jcar-arrow-out: calc(-1 * clamp(23px, 2vw, 29px));
  }

  /* The faint column rules of the reference, at the container's own thirds so
     they land behind the gaps between cards rather than across the cards. */
  .jcar::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset: 0;
    background-image: linear-gradient(
      to right,
      rgba(28, 14, 8, 0.055) 0 1px,
      transparent 1px 100%
    );
    background-size: calc(var(--jcar-w) / 3) 100%;
    background-position: calc(50% - var(--jcar-w) / 2) 0;
    background-repeat: repeat-x;
    pointer-events: none;
  }

  /* --- Head ---------------------------------------------------------------- */

  .jcar__head {
    max-width: 66ch;
    margin-inline: auto;
    text-align: center;
  }

  .jcar__eyebrow {
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    /* --sb-violet-dark, not --sb-violet. The eyebrow is 12px on the sand ground,
       where the lighter brand tone measures 4.3:1 — under AA. On the cards'
       white plate the same tone clears it at 5.1:1 and is used as-is. */
    color: var(--sb-violet-dark);
  }

  h2.jcar__h {
    margin-top: var(--sb-5);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(30px, 4.2vw, 58px);
    line-height: 1.06;
    letter-spacing: -0.038em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .jcar__stand {
    max-width: 58ch;
    margin: clamp(18px, 2.4vh, 28px) auto 0;
    font-size: var(--sb-body);
    line-height: 1.75;
    color: var(--sb-text-secondary);
    text-wrap: pretty;
  }

  /* --- Rail ---------------------------------------------------------------- */

  .jcar__rail {
    position: relative;
    width: var(--jcar-w);
    margin: clamp(36px, 5.4vh, 64px) auto 0;
  }

  .jcar__viewport {
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .jcar__viewport::-webkit-scrollbar { display: none; }

  .jcar__viewport:focus-visible {
    outline: 2px solid var(--sb-focus);
    outline-offset: 4px;
    border-radius: var(--sb-r-0);
  }

  .jcar__track {
    display: flex;
    align-items: flex-start;
    gap: var(--jcar-gap);
    list-style: none;
    margin: 0;
    /* Vertical padding is headroom for the cards' shadows, which the scroller
       would otherwise clip flat along the top and bottom edges. */
    padding: 12px 0 30px;
  }

  /* Zero, but present. The rail is container-width, so the last card already
     finishes on the container's right edge and needs no end spacer — the
     element stays because the shared machinery in motion-gsap.ts measures a
     rail's end from it, and a rail that later opts back into the pin would
     otherwise measure short. */
  .jcar__tail { flex: 0 0 0; }

  /* --- Card ---------------------------------------------------------------- */

  .jcard {
    flex: 0 0 calc(
      (var(--jcar-w) - (var(--jcar-per) - 1) * var(--jcar-gap)) / var(--jcar-per)
    );
    scroll-snap-align: start;
  }

  .jcard__inner {
    position: relative;
    /* The plate hangs into this reserve. See the header — a constant, so the row
       ends level whatever any one title does. */
    padding-bottom: var(--jcard-overhang);
  }

  /* Square, measured off the reference rather than guessed — its cards are 460
     wide by 460 of photograph, with the plate hanging 65 below. A 3:4 crop looked
     right in isolation and made the row a third taller than the thing being
     copied. */
  .jcard__media {
    position: relative;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border-radius: clamp(20px, 2vw, 30px);
    background: var(--sb-sand);
  }

  .jcard__media :global(.photo) { height: 100%; border-radius: 0; }
  .jcard__media :global(img) { transition: transform 1200ms var(--sb-ease); }
  .jcard:hover .jcard__media :global(img) { transform: scale(1.05); }

  .jcard__plain {
    position: absolute;
    inset: 0;
    background:
      repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 26px),
      repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.07) 0 1px, transparent 1px 26px),
      var(--sb-ink);
  }

  /* --- The plate ----------------------------------------------------------- */

  .jcard__panel {
    position: absolute;
    left: clamp(12px, 1.4vw, 22px);
    right: clamp(12px, 1.4vw, 22px);
    bottom: 0;
    padding: clamp(18px, 1.8vw, 26px);
    border-radius: clamp(14px, 1.4vw, 20px);
    background: #fff;
    box-shadow: 0 18px 44px -26px rgba(28, 14, 8, 0.38);
    transition: transform var(--sb-dur-image) var(--sb-ease);
  }

  .jcard:hover .jcard__panel { transform: translateY(-5px); }

  .jcard__meta {
    display: flex;
    align-items: center;
    gap: var(--sb-3);
    font-size: var(--sb-caption);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    line-height: 1.2;
  }

  .jcard__meta-a { color: var(--sb-violet); }
  .jcard__meta-b { color: var(--sb-text-secondary); font-weight: 600; }

  .jcard__meta-dot {
    width: 4px;
    height: 4px;
    border-radius: var(--sb-r-full);
    background: var(--sb-border-strong);
    flex-shrink: 0;
  }

  /* Two lines are reserved rather than clamped: reserving keeps the six plates
     the same depth when a title happens to be short, and NOT clamping means a
     title that genuinely runs to three lines is still read in full. */
  h3.jcard__h {
    min-height: calc(2 * 1.16em);
    margin-top: var(--sb-4);
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(19px, 1.62vw, 25px);
    line-height: 1.16;
    letter-spacing: -0.026em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .jcard__foot {
    display: flex;
    align-items: center;
    gap: var(--sb-5);
    margin-top: clamp(16px, 1.8vw, 22px);
    padding-top: clamp(14px, 1.6vw, 18px);
    border-top: var(--sb-hairline);
  }

  .jcard__fact {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: var(--sb-body-sm);
    line-height: 1.3;
    color: var(--sb-text-secondary);
    white-space: nowrap;
  }

  .jcard__fact svg { color: var(--sb-text-secondary); flex-shrink: 0; }

  /* --sb-violet-dark rather than --sb-violet: this sets at 14px on white and the
     lighter brand tone measured under AA at that size on the old card. */
  .jcard__tag {
    margin-left: auto;
    font-size: var(--sb-body-sm);
    font-weight: 700;
    color: var(--sb-violet-dark);
    white-space: nowrap;
  }

  /* --- Arrows --------------------------------------------------------------
     Positioned on the CONTAINER's gutters, half-overlapping the outer cards, as
     the reference has them. 45% down the rail lands them on the middle of the
     photograph rather than on the plate — the card is a 3:4 image plus a fixed
     overhang, and that ratio holds within a point at every width. */

  .jcar__nav[hidden] { display: none; }

  .jcar__arrow {
    position: absolute;
    top: 45%;
    translate: 0 -50%;
    display: grid;
    place-items: center;
    width: clamp(46px, 4vw, 58px);
    aspect-ratio: 1;
    border-radius: var(--sb-r-full);
    cursor: pointer;
    transition:
      transform var(--sb-dur-link) var(--sb-ease),
      opacity var(--sb-dur-link) ease,
      background-color var(--sb-dur-link) ease;
  }

  .jcar__arrow:hover { transform: scale(1.08); }
  .jcar__arrow:focus-visible { outline: 2px solid var(--sb-focus); outline-offset: 3px; }

  /* Nothing floats over the LEFT gutter, so this one keeps the reference's
     overhang at every width. */
  .jcar__arrow--prev {
    left: var(--jcar-arrow-out);
    border: 1px solid var(--sb-border);
    background: #fff;
    color: var(--sb-charcoal);
    box-shadow: 0 12px 30px -16px rgba(28, 14, 8, 0.4);
  }

  .jcar__arrow--next {
    right: max(var(--jcar-arrow-out), calc(var(--jcar-index) - var(--jcar-gutter)));
    border: 1px solid var(--sb-violet);
    background: var(--sb-violet);
    color: #fff;
    box-shadow: 0 14px 34px -14px rgba(201, 60, 10, 0.6);
  }

  .jcar__arrow--next:hover { background: var(--sb-violet-dark); }

  .jcar__arrow:disabled {
    opacity: 0.38;
    cursor: default;
    transform: none;
  }

  /* --- The way out --------------------------------------------------------- */

  .jcar__out {
    display: flex;
    justify-content: center;
    margin-top: clamp(28px, 4vh, 46px);
  }

  /* --- Wave ---------------------------------------------------------------- */

  .jcar__wave {
    position: absolute;
    z-index: -1;
    inset: auto 0 0 0;
    height: clamp(96px, 12vw, 190px);
    pointer-events: none;
    /* -1px, not 0: at fractional device pixel ratios a shape ending exactly on
       the section's bottom edge leaves a hairline of sand under it. */
    margin-bottom: -1px;
  }

  .jcar__wave svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--waveInto);
  }

  @media (prefers-reduced-motion: reduce) {
    .jcard__media :global(img),
    .jcard__panel,
    .jcar__arrow { transition: none; }
    .jcard:hover .jcard__media :global(img) { transform: none; }
    .jcard:hover .jcard__panel { transform: none; }
    .jcar__arrow:hover { transform: none; }
  }

  /* 2.15 rather than 2, and the fraction is the point: the arrows do not appear
     below 1024, so a row of exactly two cards would give a tablet reader nothing
     to say the rail moves at all. The sliver of the third card is the whole
     affordance. Three fit exactly from 1024 up, where the arrows take over. */
  @media (min-width: 640px) { .jcar { --jcar-per: 2.15; } }
  @media (min-width: 1024px) { .jcar { --jcar-per: 3; } }

  /* SectionRail hides itself below 1200, so between there and 1024 there is
     nothing to dodge and the next arrow takes the reference's overhang back. */
  @media (max-width: 1199px) {
    .jcar__arrow--next { right: var(--jcar-arrow-out); }
  }

  /* Below 1024 the rail is a flick, not an aim at a 52px target, and the gutter
     is too narrow to hold an arrow without it landing on the card's subject. */
  @media (max-width: 1023px) {
    .jcar__nav { display: none !important; }
    .jcard:hover .jcard__media :global(img) { transform: none; }
    .jcard:hover .jcard__panel { transform: none; }
  }

  @media (max-width: 639px) {
    .jcar { padding-block: var(--sb-9) clamp(120px, 26vw, 170px); }
    .jcar::before { display: none; }
  }
</style>

<script>
  /**
   * The rail's arrow buttons and the wave's reduced-motion stop.
   *
   * SCOPED PER SECTION, not `document.querySelector`. The equivalent script on
   * StemRail takes the FIRST `[data-rail]` on the page, which is correct there
   * only because that page has exactly one rail; written that way here it would
   * silently drive the wrong rail the moment a page carried two carousels.
   *
   * PROGRESSIVE ENHANCEMENT in the literal sense: the buttons ship with the
   * `hidden` attribute and this removes it, so a blocked script leaves no dead
   * controls — and the rail is still fully operable by drag, flick, shift-wheel,
   * scrollbar and arrow keys, none of which this file provides or can break.
   *
   * A STEP IS ONE CARD, measured from the DOM. The card basis is a calc() over
   * two clamps, so any pitch hard-coded here would be wrong at most widths.
   */
  document.querySelectorAll<HTMLElement>('.jcar').forEach((section) => {
    const rail = section.querySelector<HTMLElement>('[data-rail]');
    const nav = section.querySelector<HTMLElement>('[data-rail-btns]');

    if (rail && nav) {
      const prev = nav.querySelector<HTMLButtonElement>('[data-rail-prev]')!;
      const next = nav.querySelector<HTMLButtonElement>('[data-rail-next]')!;
      nav.hidden = false;

      // The cards are grandchildren of the scroller: an <ol> sits between them.
      const pitch = () => {
        const cards = rail.querySelectorAll<HTMLElement>('[data-rail-item]');
        if (cards.length < 2) return rail.clientWidth * 0.8;
        return cards[1].getBoundingClientRect().left - cards[0].getBoundingClientRect().left;
      };

      /* The 2px slack absorbs sub-pixel scroll positions, which otherwise leave
         "next" enabled for ever at the right-hand end on fractional DPRs. */
      const sync = () => {
        const max = rail.scrollWidth - rail.clientWidth;
        prev.disabled = rail.scrollLeft <= 2;
        next.disabled = rail.scrollLeft >= max - 2;
      };

      const step = (dir: number) => {
        // Asked at the moment of the scroll rather than baked into CSS, because
        // base.css already disables smooth scrolling under reduced motion and
        // honouring that means reading the preference here.
        const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        rail.scrollBy({ left: dir * pitch(), behavior: reduced ? 'auto' : 'smooth' });
      };

      prev.addEventListener('click', () => step(-1));
      next.addEventListener('click', () => step(1));
      rail.addEventListener('scroll', sync, { passive: true });
      window.addEventListener('resize', sync);
      sync();
    }

    /* SMIL cannot be switched off from a stylesheet — `animation: none` does
       nothing to an <animate> element — so a reader who has asked for reduced
       motion gets the wave frozen on its first frame here instead. */
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      section.querySelectorAll<SVGSVGElement>('[data-wave] svg').forEach((svg) => {
        svg.pauseAnimations();
      });
    }
  });
</script>
