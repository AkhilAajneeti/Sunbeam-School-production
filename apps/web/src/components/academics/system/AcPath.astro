---
import '../../../styles/academics.css';
/**
 * AcPath — an ordered journey drawn as one line, not as a row of cards.
 *
 * The line IS the section. Each beat hangs off a node on it; nothing sits in a
 * box, so there is no card to repeat. Horizontal from 900 up, vertical below —
 * the same rule turned, not a different component.
 *
 * ⚠ EACH BEAT DRAWS ITS OWN SEGMENT, from its node to the next. A single rule
 * inset by a percentage across the whole set starts to the RIGHT of the first
 * node and stops short of the last, because the nodes sit at the left edge of
 * their columns and a percentage inset knows nothing about that. Measured.
 *
 * ⚠ THE FRAME HEIGHT IS FIXED, NOT AN ASPECT-RATIO, and that is a layout
 * decision. The line must meet the centre of every node; with `aspect-ratio` the
 * frame's height depends on a column width CSS cannot name, so the line's offset
 * could only ever be guessed. Declared, both are derived from one expression.
 */
import { Image, Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SmartImage from '../../ui/SmartImage.astro';

interface Beat {
  k: string;
  body?: string;
  photo?: ImageMetadata;
  alt?: string;
  /** A small transparent PNG that sits on the node. */
  icon?: ImageMetadata;
}

interface Props {
  kicker?: string;
  heading: string;
  body?: string[];
  beats: Beat[];
  ground?: 'ivory' | 'paper' | 'sand' | 'ink';
  id?: string;
}

const { kicker, heading, body = [], beats, ground = 'paper', id } = Astro.props;
const headingId = id ?? `acpath-${Math.abs(heading.length * 4231 % 9973)}`;
---

<section class={`ac-section ac--${ground} acp`} aria-labelledby={headingId}>
  <div class="u-container acp__head">
    {kicker && <p class="ac-micro" data-reveal>{kicker}</p>}
    <h2 class="ac-lede acp__h" id={headingId} data-split set:html={heading} />
    {body.map((p, i) => <p class="ac-body" data-reveal data-reveal-delay={140 + i * 80} set:html={p} />)}
  </div>

  {/* ⚠ THE LIST IS NOT THE CONTAINER. `.u-container` supplies padding-inline and
      an <ol> reset of `padding: 0` cancels it — which ran the frames to the
      viewport edge while the heading stayed inset. Wrapped instead. */}
  <div class="u-container">
    <ol class={`acp__set acp__set--${beats.length}`}>
      {beats.map((b, i) => (
        <li class="acp__beat" data-reveal data-reveal-delay={i * 150}>
          {b.photo && (
            <figure class="ac-frame ac-frame--soft acp__art" data-zoom data-zoom-to="1.14">
              <SmartImage
                file={b.photo}
                alt={b.alt ?? ''}
                sizes="(max-width: 900px) 86vw, 28vw"
                fallbackWidth={1100}
                loading="lazy"
              />
            </figure>
          )}
          <span class="acp__node" aria-hidden="true">
            {b.icon
              ? <SmartImage
  file={b.icon}
  alt=""
  fallbackWidth={1100}
/>
              : <span class="acp__dot">{String(i + 1).padStart(2, '0')}</span>}
          </span>
          <p class="acp__k">{b.k}</p>
          {b.body && <p class="acp__p" set:html={b.body} />}
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .acp__head { position: relative; z-index: 1; }
  .acp__h { max-width: 24ch; }

  .acp__set {
    --acp-gap: clamp(30px, 4vw, 48px);
    /* frame height + its bottom margin + half the node = the node's centre, and
       therefore the line's. Declared once, used by both axes. */
    --acp-line: calc(clamp(178px, 21vw, 292px) + clamp(14px, 2vw, 20px) + 14px);
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--acp-gap);
    margin: clamp(34px, 5vw, 62px) 0 0;
    padding: 0;
    list-style: none;
  }

  .acp__beat { position: relative; padding-left: 34px; }

  /* The rail, vertical. Runs the height of the set, behind the nodes. */
  .acp__set::before {
    content: '';
    position: absolute;
    top: 12px;
    bottom: 12px;
    left: 13px;
    width: 2px;
    background: repeating-linear-gradient(to bottom, var(--sb-border-strong) 0 5px, transparent 5px 13px);
  }

  .acp__art {
    margin: 0 0 clamp(14px, 2vw, 20px);
    height: clamp(178px, 21vw, 292px);
  }

  /* A disc of the ground behind the node is what makes the line appear to pass
     behind it rather than through it. */
  .acp__node {
    position: absolute;
    top: 0;
    left: 0;
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--sb-ivory);
    box-shadow: 0 0 0 5px var(--sb-ivory);
  }
  :global(.ac--paper) .acp__node { background: var(--sb-paper); box-shadow: 0 0 0 5px var(--sb-paper); }
  :global(.ac--sand) .acp__node { background: var(--sb-sand); box-shadow: 0 0 0 5px var(--sb-sand); }
  :global(.ac--ink) .acp__node { background: var(--sb-violet-ink); box-shadow: 0 0 0 5px var(--sb-violet-ink); }

  .acp__node :global(img) { display: block; width: 24px; height: 24px; object-fit: contain; }
  .acp__dot {
    font-family: var(--sb-font-display);
    font-size: 12px;
    font-weight: 700;
    color: var(--sb-violet);
  }
  :global(.ac--ink) .acp__dot { color: var(--sb-lime); }

  .acp__k {
    font-family: var(--sb-font-display);
    font-size: clamp(19px, 1.9vw, 27px);
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  :global(.ac--ink) .acp__k { color: #fff; }

  .acp__p {
    max-width: 34ch;
    margin-top: 8px;
    font-size: clamp(14px, 1.02vw, 16px);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }
  :global(.ac--ink) .acp__p { color: rgba(255, 255, 255, 0.76); }

  @media (min-width: 900px) {
    .acp__set { --acp-gap: clamp(26px, 3.4vw, 52px); }
    .acp__set--3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .acp__set--4 { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .acp__set--5 { grid-template-columns: repeat(5, minmax(0, 1fr)); }

    /* The rail turns: one segment per beat, node to node. */
    .acp__set::before { display: none; }
    .acp__beat { padding-left: 0; }
    .acp__beat::after {
      content: '';
      position: absolute;
      top: var(--acp-line);
      left: 30px;
      right: calc(-1 * var(--acp-gap) - 14px);
      height: 2px;
      background: repeating-linear-gradient(to right, var(--sb-border-strong) 0 5px, transparent 5px 13px);
    }
    .acp__beat:last-child::after { display: none; }
    .acp__node { position: relative; top: auto; left: 0; }
    .acp__k { margin-top: clamp(12px, 1.6vw, 18px); }
  }
</style>
