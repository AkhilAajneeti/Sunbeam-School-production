---
import '../../../styles/academics.css';
/**
 * AcCollage — one dominant photograph with one or two smaller ones overlapping.
 *
 * The system's answer to "do not make it a gallery grid". Three frames at three
 * sizes with three different shapes read as one composition; the same three at
 * equal size in a row read as a grid, whatever the gap.
 *
 * ⚠ THE SMALL FRAMES ARE ABSOLUTE, so neither adds height. The collage is sized
 * by the dominant frame alone — otherwise the second frame pushes the third down
 * and the overlap becomes a stack. Below 900 they leave absolute placement
 * entirely: three overlapping frames at 390px is a pile, not a composition.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SmartImage from '../../ui/SmartImage.astro';

interface Frame {
  src: ImageMetadata;
  alt: string;
}

interface Props {
  kicker?: string;
  heading: string;
  body?: string[];
  /** Facts on hairlines beside the collage. */
  ledger?: { k: string; v: string }[];
  lead: Frame;
  /** Up to two. The first is mounted, the second cropped to a circle. */
  support?: Frame[];
  ground?: 'ivory' | 'paper' | 'sand' | 'ink';
  /** Which side the collage takes. */
  side?: 'right' | 'left';
  id?: string;
}

const {
  kicker, heading, body = [], ledger = [], lead, support = [],
  ground = 'sand', side = 'right', id,
} = Astro.props;

const headingId = id ?? `accol-${Math.abs(heading.length * 5279 % 9973)}`;
const [s1, s2] = support;
---

<section class={`ac-section ac--${ground} accol`} aria-labelledby={headingId}>
  <div class={`u-container ac-split${side === 'left' ? ' ac-split--flip' : ''}`}>
    <div class="accol__copy">
      {kicker && <p class="ac-micro" data-reveal>{kicker}</p>}
      <h2 class="ac-lede" id={headingId} data-split set:html={heading} />
      {body.map((p, i) => <p class="ac-body" data-reveal data-reveal-delay={140 + i * 80} set:html={p} />)}

      {ledger.length > 0 && (
        <ul class="ac-ledger" data-reveal data-reveal-delay="240">
          {ledger.map((r) => (
            <li>
              <span class="ac-ledger__k">{r.k}</span>
              <span class="ac-ledger__v" set:html={r.v} />
            </li>
          ))}
        </ul>
      )}
    </div>

    <div class="accol__stage">
      <figure class="ac-frame accol__a" data-mask data-zoom>
        <SmartImage
          file={lead.src}
          alt={lead.alt}
          sizes="(max-width: 900px) 88vw, 40vw"
          fallbackWidth={1100}
          loading="lazy"
        />
      </figure>

      {s1 && (
        <figure class="ac-frame ac-frame--soft ac-frame--mount accol__b" data-reveal data-reveal-delay="150" data-zoom data-zoom-to="1.16">
          <SmartImage
            file={s1.src}
            alt={s1.alt}
            sizes="(max-width: 900px) 48vw, 22vw"
            fallbackWidth={1100}
            loading="lazy"
          />
        </figure>
      )}

      {s2 && (
        <figure class="ac-frame ac-frame--round ac-frame--mount accol__c" data-reveal data-reveal-delay="230" data-zoom data-zoom-to="1.2">
          <SmartImage
            file={s2.src}
            alt={s2.alt}
            sizes="(max-width: 900px) 40vw, 16vw"
            fallbackWidth={1100}
            loading="lazy"
          />
        </figure>
      )}
    </div>
  </div>
</section>

<style>
  .accol__stage { position: relative; }

  .accol__a { width: 82%; aspect-ratio: 4 / 3; }

  .accol__b {
    position: absolute;
    right: 0;
    top: 24%;
    z-index: 3;
    width: 42%;
    aspect-ratio: 3 / 4;
  }

  .accol__c {
    position: absolute;
    left: 6%;
    bottom: -8%;
    z-index: 2;
    width: 30%;
    aspect-ratio: 1;
  }

  @media (max-width: 899px) {
    /* Unstacked: the dominant frame full width, the supports side by side under
       it. Legible on a phone in a way three overlapping frames are not. */
    .accol__stage {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: clamp(12px, 2.6vw, 18px);
    }
    .accol__a { grid-column: 1 / -1; width: 100%; }
    .accol__b,
    .accol__c {
      position: relative;
      right: auto;
      left: auto;
      top: auto;
      bottom: auto;
      width: 100%;
      aspect-ratio: 4 / 3;
      border-width: 0;
      border-radius: var(--sb-r-2);
    }
  }
</style>
