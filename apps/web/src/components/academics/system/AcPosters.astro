---
import '../../../styles/academics.css';
/**
 * AcPosters — designed graphics shown WHOLE, never cropped.
 *
 * ⚠ THIS EXISTS BECAUSE object-fit: cover DESTROYS A POSTER. The school issues
 * an award graphic, a CUET result card and an alumni card as finished artwork —
 * each with its own headline, crest and framed portrait inside it. Crop one to
 * fill a landscape frame and the first thing lost is the headline, which is the
 * only part that carries the fact. Every other primitive in this system uses
 * `cover` on a photograph; this one uses `contain` on a graphic, and that is the
 * entire reason it is a separate component rather than a flag on AcSplit.
 *
 * ⚠ AND NO data-zoom. Scaling a contained graphic pushes its own edges under the
 * plate's clip — the same crop, arrived at by animation. The cards rise instead.
 *
 * The posters vary in shape (square, 4:5, 3:4, portrait), so each sits on a
 * tinted plate of one fixed aspect and is centred inside it. The plate is the
 * thing that lines up; the artwork inside it is left alone.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import SmartImage from '../../ui/SmartImage.astro';

interface Poster {
  art: ImageMetadata;
  alt: string;
  /** Printed under the plate — the name, usually. */
  title: string;
  /** The fact the artwork carries: a score, a college, an employer. */
  meta?: string;
  /** One more line, smaller — the stream, the year, the degree. */
  note?: string;
}

interface Props {
  kicker?: string;
  heading: string;
  body?: string[];
  posters: Poster[];
  ground?: 'ivory' | 'paper' | 'sand' | 'ink';
  /** Aspect of the plate every poster is centred in. */
  aspect?: string;
  /** Stagger alternate cards downward — off for a strict record. */
  stagger?: boolean;
  id?: string;
  texture?: boolean;
}

const {
  kicker, heading, body = [], posters, ground = 'ivory',
  aspect = '4 / 5', stagger = true, id, texture = false,
} = Astro.props;

const headingId = id ?? `acpo-${Math.abs(heading.length * 6151 % 9973)}`;
---

<section class={`ac-section ac--${ground} acpo`} aria-labelledby={headingId}>
  {texture && <span class={ground === 'ink' ? 'ac-dots-bg' : 'ac-grid-bg'} aria-hidden="true"></span>}

  <div class="u-container">
    <div class="acpo__head">
      {kicker && <p class="ac-micro" data-reveal>{kicker}</p>}
      <h2 class="ac-lede" id={headingId} data-split set:html={heading} />
      {body.map((p, i) => <p class="ac-body" data-reveal data-reveal-delay={140 + i * 80} set:html={p} />)}
    </div>

    <ul class={`acpo__grid${stagger ? ' acpo__grid--stagger' : ''}`} style={`--acpo-n: ${posters.length};`}>
      {posters.map((p, i) => (
        <li class="acpo__item" data-reveal data-reveal-delay={120 + i * 90}>
          <span class="acpo__plate" style={`aspect-ratio: ${aspect};`}>
            <SmartImage
              file={p.art}
              alt={p.alt}
              sizes="(max-width: 720px) 84vw, (max-width: 1100px) 42vw, 27vw"
              fallbackWidth={1100}
              loading="lazy"
            />
          </span>

          <p class="acpo__title">{p.title}</p>
          {p.meta && <p class="acpo__meta t-tabular">{p.meta}</p>}
          {p.note && <p class="acpo__note">{p.note}</p>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .acpo__head { max-width: 60ch; }

  .acpo__grid {
    display: grid;
    /* auto-fit, not a fixed count — the sets run from three cards to six, and a
       hard column count turns six cards into six slivers. */
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: clamp(20px, 2.6vw, 40px);
    margin: clamp(38px, 5vw, 68px) 0 0;
    padding: 0;
    list-style: none;
    align-items: start;
  }

  /* Alternate cards drop — three equal cards in a row read as a gallery grid,
     which is the one thing this system is built to avoid. */
  .acpo__grid--stagger > .acpo__item:nth-child(even) { margin-top: clamp(22px, 4vw, 62px); }

  .acpo__item { margin: 0; }

  /* ⚠ THE PLATE CLIPS AND THE ARTWORK IS CONTAINED. Radius on the plate, never
     on the graphic — a designed poster's own corners are part of its layout. */
  .acpo__plate {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: var(--sb-r-2);
    background: rgba(27, 21, 18, 0.05);
    box-shadow: 0 34px 66px -40px rgba(27, 21, 18, 0.5);
  }
  .ac--ink .acpo__plate { background: rgba(255, 255, 255, 0.07); box-shadow: none; }

  /* The <picture> stretch — inline by default, so the img would resolve its
     height against nothing. Same fix as every frame in the system. */
  .acpo__plate > picture { position: absolute; inset: 0; display: block; }
  .acpo__plate img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .acpo__title {
    margin: clamp(14px, 1.6vw, 20px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(17px, 1.5vw, 22px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.16;
    color: var(--sb-charcoal);
  }
  .ac--ink .acpo__title { color: #fff; }

  .acpo__meta {
    margin: 6px 0 0;
    font-size: clamp(13px, 1vw, 15px);
    font-weight: 700;
    color: var(--sb-violet);
  }
  .ac--ink .acpo__meta { color: var(--sb-lime); }

  .acpo__note {
    margin: 4px 0 0;
    font-size: 13px;
    line-height: 1.55;
    color: var(--sb-text-secondary);
  }
  .ac--ink .acpo__note { color: rgba(255, 255, 255, 0.7); }

  @media (max-width: 1100px) {
    .acpo__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 720px) {
    .acpo__grid { grid-template-columns: minmax(0, 1fr); }
    /* The stagger is a desktop device. One per row, it is only a stray gap. */
    .acpo__grid--stagger > .acpo__item:nth-child(even) { margin-top: 0; }
  }
</style>
