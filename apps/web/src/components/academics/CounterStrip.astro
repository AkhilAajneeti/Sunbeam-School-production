---
/**
 * COUNTER STRIP — the eight published quantities.
 *
 * Used on the Academics overview and on Student Success. Shared rather than
 * copied because the numbers must agree between the two pages, and because the
 * count-up markup has a specific shape that is easy to get subtly wrong.
 *
 * THE SERVER RENDERS THE FINAL VALUE. The number is written out formatted in the
 * markup, and the count-up only overwrites it once the motion chunk arrives and
 * the strip scrolls into view. So with JavaScript off, on a slow connection, or
 * under Save-Data, a reader sees 15,000+ — never a 0 that never animates.
 *
 * `data-count-suffix` carries the + so the symbol survives the textContent
 * write; motion-gsap.ts re-appends it on every frame.
 */
import { getAcademicTopic } from '../../lib/cms';

const ac = await getAcademicTopic('/academics/');
const counters = ac.section('counters').stats;

interface Counter {
  n: number;
  suffix: string;
  label: string;
}

interface Props {
  /** 'dark' on ink, 'light' on ivory or sand. */
  tone?: 'dark' | 'light';
  /** Show all eight, or the first n. Ignored when `items` is given. */
  limit?: number;
  /**
   * A page-specific set, for a page whose figures are not the section's standard
   * eight. Parent Partnership passes four that answer a parent's questions rather
   * than an inspector's.
   *
   * WHATEVER IS PASSED HERE IS STILL SUBJECT TO THE RULE AT THE TOP OF
   * data/academics.ts: quantities only, and only quantities the school publishes
   * or that follow arithmetically from them. This prop widens where the numbers
   * come from, not what is allowed to be a number.
   */
  items?: readonly Counter[];
}

const { tone = 'dark', limit, items: custom } = Astro.props;
const items = ac.section('items').stats;
---

<dl class:list={['cstrip', `cstrip--${tone}`]}>
  {items.map((c, i) => (
    <div class="cstrip__item" data-reveal data-reveal-delay={(i % 4) * 80}>
      <dt class="cstrip__n t-tabular">
        <span data-count={c.n} data-count-suffix={c.suffix}>
          {c.n.toLocaleString('en-IN')}{c.suffix}
        </span>
      </dt>
      <dd class="cstrip__l">{c.label}</dd>
    </div>
  ))}
</dl>

<style>
  .cstrip {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-7) var(--sb-6);
    margin: 0;
    padding: 0;
  }

  .cstrip__n {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(34px, 4.2vw, 60px);
    line-height: 1;
    letter-spacing: -0.035em;
  }

  .cstrip__l {
    margin: var(--sb-4) 0 0;
    font-size: var(--sb-caption);
    line-height: 1.5;
  }

  /* --sb-lime is the accent built for dark grounds; the primary would sit near
     3.4:1 on ink. On light grounds the primary is correct and lime would be
     roughly 2.5:1. Same component, two honest palettes. */
  .cstrip--dark .cstrip__n { color: var(--sb-lime); }
  .cstrip--dark .cstrip__l { color: rgba(255, 255, 255, 0.8); }

  .cstrip--light .cstrip__n { color: var(--sb-violet); }
  .cstrip--light .cstrip__l { color: var(--sb-text-secondary); }

  @media (max-width: 1023px) {
    .cstrip { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 479px) {
    .cstrip { grid-template-columns: minmax(0, 1fr); gap: var(--sb-6); }
    .cstrip__n { font-size: 40px; }
  }
</style>
