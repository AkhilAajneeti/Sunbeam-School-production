---
import { getAcademicTopic } from '../../lib/cms';

const ac = await getAcademicTopic('/academics/philosophy/');
const philosophy = ac.section('philosophy').points;
/**
 * THE LEARNING ECOSYSTEM — the client's own constellation, and section two of
 * Academics → Academic Philosophy.
 *
 * The concentric rings, the dotted SVG arcs, the "Learn with purpose" core and
 * the seven <details> discoveries are all as the client made them. It was lifted
 * verbatim out of philosophy.astro when that page was rebuilt onto the shared
 * banner (30 July 2026), briefly parked, and restored here at the client's
 * request — this is the design they want on the page.
 *
 * It covers all seven ideas, including the two the page still owes a section of
 * its own (Curriculum, Affiliation Details), and it holds the #curriculum and
 * #affiliation deep links that the footer and mega-menu point at.
 *
 * <details>, not a JS accordion. Keyboard-operable, screen-reader announced and
 * works with JavaScript off, for free. The only scripted part would have been
 * the open/close animation, and grid-template-rows handles that in CSS.
 */
---

<section class="phil" id="philosophy" aria-labelledby="phil-title">
  <div class="u-container">
    <h2 class="u-visually-hidden" id="phil-title">The Sunbeam learning ecosystem</h2>

    <div class="phil__ecosystem" data-reveal>
      {/* preserveAspectRatio="none" is correct HERE and only here: these are
          two soft dotted arcs with no arrowhead and no fixed geometry to
          distort, so stretching them to the panel is harmless. */}
      <svg class="phil__lines" viewBox="0 0 1000 580" fill="none"
        preserveAspectRatio="none" aria-hidden="true">
        <path d="M94 396C208 300 291 461 401 323S598 132 695 249 843 409 924 179"></path>
        <path d="M94 396C247 523 338 475 501 435S711 493 924 179"></path>
      </svg>

      <div class="phil__core" aria-hidden="true">
        <span>Sunbeam</span><strong>Learn<br />with<br />purpose</strong>
      </div>

      <ol class="phil__list" aria-label="The Sunbeam learning ecosystem">
        {philosophy.map((p, i) => (
          <li class="phil__item" data-reveal data-reveal-delay={i * 90}>
            <details class="phil__discovery"
              id={p.title === 'Curriculum' ? 'curriculum' : p.title === 'Affiliation' ? 'affiliation' : undefined}>
              <summary>
                <span class="phil__n t-tabular" aria-hidden="true">{p.n}</span>
                <span class="phil__mark" aria-hidden="true">{p.mark}</span>
                <div class="phil__body">
                  <h3 class="phil__h">{p.title}</h3>
                </div>
                <span class="phil__open" aria-hidden="true">+</span>
              </summary>
              <div class="phil__answer">
                <div>
                  <p class="phil__what">{p.what}</p>
                  {p.anchor && <p class="phil__anchor">{p.anchor}</p>}
                </div>
              </div>
            </details>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  /* ══════════ THE CONSTELLATION ═══════════════════════════════════════════
     Client's own design, recovered from the previous build and preserved. */
  /* NO TOP PADDING. This sits directly under the Teaching Philosophy band, whose
     closing 120px of padding already provides the gap between the two — its own
     160px on top of that stacked to 280px of empty sand. The band's gradient
     ends on --sb-sand, so the two grounds meet with no seam. */
  .phil {
    background: var(--sb-sand);
    padding-block: 0 var(--sb-section-y-major);
  }

  .phil__ecosystem {
    position: relative;
    min-height: 660px;
    overflow: hidden;
    padding: clamp(88px, 9vw, 136px) clamp(24px, 5vw, 72px);
    border: 1px solid rgba(201, 60, 10, 0.16);
    border-radius: 40px;
    background:
      radial-gradient(circle at 46% 47%, rgba(255, 138, 99, 0.3), transparent 18%),
      radial-gradient(circle at 86% 12%, rgba(25, 194, 176, 0.13), transparent 21%),
      linear-gradient(135deg, #fffaf7, #fff 52%, #fff3ed);
    box-shadow: 0 24px 70px -48px rgba(28, 14, 8, 0.42);
  }

  /* Two orbit rings behind everything. */
  .phil__ecosystem::before,
  .phil__ecosystem::after {
    content: '';
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .phil__ecosystem::before {
    width: 440px;
    height: 440px;
    left: 50%;
    top: 50%;
    border: 1px solid rgba(201, 60, 10, 0.14);
    transform: translate(-50%, -50%);
  }

  .phil__ecosystem::after {
    width: 620px;
    height: 620px;
    left: 50%;
    top: 50%;
    border: 1px dashed rgba(14, 111, 104, 0.18);
    transform: translate(-50%, -50%) rotate(-12deg);
  }

  .phil__lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0.7;
  }

  .phil__lines path {
    stroke: var(--sb-violet);
    stroke-width: 1.25;
    stroke-dasharray: 8 10;
  }

  .phil__core {
    position: absolute;
    z-index: 1;
    left: 50%;
    top: 50%;
    display: grid;
    place-content: center;
    width: clamp(138px, 14vw, 178px);
    aspect-ratio: 1;
    padding: 18px;
    border-radius: 50%;
    text-align: center;
    color: #fff;
    background: var(--sb-violet);
    box-shadow: 0 0 0 12px rgba(201, 60, 10, 0.08), 0 20px 46px -18px rgba(122, 36, 6, 0.72);
    transform: translate(-50%, -50%);
  }

  .phil__core span {
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.78;
  }

  .phil__core strong {
    display: block;
    margin-top: 7px;
    font-family: var(--sb-font-display);
    font-size: clamp(17px, 1.8vw, 23px);
    line-height: 1.03;
    letter-spacing: -0.04em;
  }

  .phil__list {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(22px, 4vw, 56px) clamp(54px, 10vw, 150px);
    align-items: start;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* The stagger is what makes seven items read as a scatter rather than a
     table: every second one drops, and the odd seventh takes column two so it
     does not sit alone under the core. */
  .phil__item { display: block; }
  .phil__item:nth-child(2n) { transform: translateY(56px); }
  .phil__item:last-child { grid-column: 2; }

  .phil__discovery { position: relative; }

  .phil__discovery summary {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    list-style: none;
    padding: 14px 0;
  }

  .phil__discovery summary::-webkit-details-marker { display: none; }

  .phil__discovery summary:focus-visible {
    outline: 3px solid var(--sb-focus);
    outline-offset: 5px;
    border-radius: 8px;
  }

  .phil__n {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-caption);
    color: var(--sb-violet);
    font-variant-numeric: tabular-nums;
  }

  .phil__mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    color: var(--sb-violet-dark);
    background: var(--sb-violet-wash);
    font-size: 14px;
    transition: transform var(--sb-dur-link) var(--sb-ease),
      background var(--sb-dur-link) var(--sb-ease);
  }

  .phil__h {
    margin: 0;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(18px, 1.7vw, 23px);
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
    transition: color var(--sb-dur-link) var(--sb-ease);
  }

  .phil__open {
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border: 1px solid var(--sb-border-strong);
    border-radius: 50%;
    color: var(--sb-violet);
    font-size: 20px;
    line-height: 1;
    transition: transform var(--sb-dur-link) var(--sb-ease),
      color var(--sb-dur-link) var(--sb-ease),
      background var(--sb-dur-link) var(--sb-ease);
  }

  /* grid-template-rows 0fr → 1fr animates a height the browser computes, so no
     JS has to measure the panel. The inner div carries the overflow clip —
     without a child to clip, the rows trick shows the content mid-collapse. */
  .phil__answer {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.42s var(--sb-ease);
  }

  .phil__answer > * { overflow: hidden; }

  .phil__discovery[open] .phil__answer { grid-template-rows: 1fr; }

  .phil__discovery[open] .phil__open {
    color: #fff;
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    transform: rotate(45deg);
  }

  .phil__discovery[open] .phil__mark,
  .phil__discovery:hover .phil__mark {
    background: var(--sb-violet);
    color: #fff;
    transform: scale(1.12) rotate(12deg);
  }

  .phil__discovery:hover .phil__h { color: var(--sb-violet-dark); }

  .phil__what {
    margin: 12px 0 0 54px;
    max-width: 36ch;
    font-size: var(--sb-body-sm);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }

  .phil__anchor {
    margin: var(--sb-5) 0 0 54px;
    padding-left: var(--sb-5);
    border-left: 2px solid var(--sb-violet);
    font-size: var(--sb-caption);
    font-weight: 600;
    letter-spacing: 0.04em;
    color: var(--sb-violet-dark);
  }

  /* ══════════ REDUCED MOTION ══════════════════════════════════════════════ */
  @media (prefers-reduced-motion: reduce) {
    .phil__mark,
    .phil__h,
    .phil__open,
    .phil__answer { transition: none; }

    .phil__discovery[open] .phil__open,
    .phil__discovery[open] .phil__mark,
    .phil__discovery:hover .phil__mark { transform: none; }
  }

  /* ══════════ TABLET ══════════════════════════════════════════════════════
     The orbit cannot survive a narrow column: the core would sit on top of the
     discoveries. It becomes a header for the list instead, the rings go, and
     the arcs drop to a faint texture. */
  @media (max-width: 1023px) {
    .phil__ecosystem { min-height: 0; }

    .phil__core {
      position: relative;
      left: auto;
      top: auto;
      margin: 0 auto 48px;
      transform: none;
    }

    .phil__ecosystem::before,
    .phil__ecosystem::after { display: none; }

    .phil__lines { opacity: 0.24; }
  }

  /* ══════════ MOBILE ══════════════════════════════════════════════════════ */
  @media (max-width: 639px) {
    .phil { padding-block: 0 var(--sb-section-y); }

    .phil__ecosystem { padding: 32px 20px; border-radius: 28px; }
    .phil__list { grid-template-columns: minmax(0, 1fr); gap: 8px; }

    .phil__item:nth-child(2n),
    .phil__item:last-child { transform: none; grid-column: auto; }

    .phil__discovery summary { gap: 8px; }
    .phil__what,
    .phil__anchor { margin-left: 0; }
  }
</style>
