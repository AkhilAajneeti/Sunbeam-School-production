---
/**
 * PARENT PARTNERSHIP · PARENTS' FORUM — four sections and the close.
 *
 * ⚠⚠ THE AGENDA IS THE PAGE, AND IT IS A TRANSCRIPTION. All twelve items are
 * read off the school's own projected slide; the full transcription, the slide's
 * own heading, and the reason ten of the twelve carry no explanatory line are
 * in data/parentsForum.ts. Read that header before editing any wording here.
 *
 * ⚠⚠ THE BRIEF'S TWELVE ARE NOT THE SCHOOL'S TWELVE. The brief listed "The
 * Teaching / Classroom", "The Work That Comes Home", "The Documents" and "The
 * Best of the Child" — groupings that appear nowhere on the slide — and omitted
 * Almanac, Syllabi and Pace of teaching, which are items 1, 2 and 4 on it. The
 * brief's own instruction is "Verify the exact wording and complete list from
 * the source before implementation", so the slide won.
 *
 * ⚠ TEN ITEMS HAVE NO SECOND LINE, ON PURPOSE. Only items 05 and 11 carry any
 * further words on the slide; the other ten are bare names, and the card shows
 * the name and stops. Four of those ten — Grandparents Cove, Positive
 * Affirmations, Scientific Facts, Fruit Break — are school-specific terms the
 * school defines nowhere, and a one-line gloss under each would be four invented
 * school programmes. Those four are worth asking the client to explain.
 *
 * ═══ SOURCE — three artefacts, all the school's own ════════════════════════
 *   parents forum (5).jpg — the projected agenda, legible; the panel behind it,
 *     with a name plate reading "Dr. Arpita Singh, Principal".
 *   parents forum (3).jpg — every desk carries a class nameplate: Nursery,
 *     KG-I A, II-C, II-E, III-A. A junior sitting.
 *   parents forum (4).jpg — a parent answering from the floor with a hand-held
 *     microphone, at a desk labelled II-C. It is the evidence for the page's
 *     'open dialogue' line, and it carries a nameplate too.
 *
 * ⚠ THE SCHOOL'S OWN FORUM POSTER — parents forum (1).jpg, dated 10.11.2025 — is
 * NOT used. It is a designed graphic with its own branding and a phone number on
 * it, and dropping it into a photographic composition makes the page look like a
 * repost. Its content is already represented by the photographs it was built
 * from, all of which are here.
 *
 * ⚠ A NAME DISCREPANCY WORTH THE CLIENT'S ATTENTION: data/site.ts records the
 * principal as "Mrs. Arpita Singh"; her own name plate reads "Dr. Arpita Singh".
 * This page says "the principal" and gives no honorific.
 *
 * ⚠ NOT CLAIMED: how often the forum sits, how a class representative is
 * chosen, how long a term runs, or what was decided at any sitting.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · IVORY  copy left, the room right as an overlapping pair.
 *   02 · CREAM  the agenda — copy and photographs left, twelve items right.
 *   03 · PAPER  five reasons, centred.
 *   04 · CREAM  the contact panel.
 *   05 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from '../assessment/marks';
import AsClose from '../assessment/AsClose.astro';
import PpWhy from './PpWhy.astro';
import PpCta from './PpCta.astro';
import Lightbox from '../../ui/Lightbox.astro';

import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/parents-forum/');
const pRoom = ac.pic('pRoom');
const pRows = ac.pic('pRows');
const pPanel = ac.pic('pPanel');
const pMic = ac.pic('pMic');
const pCohort = ac.pic('pCohort');
const forumAgenda = ac.section('forumAgenda').points;
const agendaHeading = ac.section('agendaHeading').note;
const forumNameplates = ac.section('forumNameplates').facts;
const forumBenefits = ac.section('forumBenefits').points;

const S = 'Sunbeam School Ballia';
const PTM = '/academics/assessment/parent-teacher-meetings/';
const ENGAGE = '/academics/parent-partnership/parent-engagement/';

const plates = forumNameplates.join(', ');
---

{/* ══ 01 · A SEAT WITH A CLASS ON IT ═════════════════════════════════════════
    Ground: warm ivory. Copy left; right, the room and a closer row of parents
    laid one over the other with a dot field behind them. */}
<section class="as-sec as-sec--ivory as-pad pf-open" aria-labelledby="pf-open-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container pf-open__grid">
    <div class="pf-open__copy">
      <p class="as-kicker" data-reveal>Not a parent–teacher meeting</p>
      <h2 class="as-h as-h--xl pf-open__h" id="pf-open-t">
        <span data-clip data-clip-delay="0">A seat with</span>
        <span data-clip data-clip-delay="150"><em>a class on it.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        The clearest thing about this forum is visible on the furniture. Every desk in the room
        carries a class nameplate — <strong>{plates}</strong> — so a parent is not attending in
        general. They are sitting for <strong>a class</strong>, and what they raise is raised on
        that class’s behalf.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="260">
        That is what separates it from a parent–teacher meeting. A {' '}
        <a class="as-link" href={PTM}>PTM</a> is about one child, with that child’s teachers, in
        private. The forum is about the school, with the school’s leadership, in front of the other
        parents — and the answer is given to the room.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="320">
        It sits more than once: the room shown here is a junior sitting, while the agenda in the
        next section was projected at a sitting for <strong>Classes IX to XII</strong>. How the
        seats are allocated is set out on {' '}<a class="as-link" href={ENGAGE}>Parent Engagement</a>.
      </p>
    </div>

    <div class="pf-open__media">
      <span class="as-dots pf-open__dots" aria-hidden="true"></span>

      <a
        class="pf-open__big as-frame"
        data-lb-open
        href={pRoom.src}
        data-lb-alt={`Parents of ${S} seated at desks carrying class nameplates during a Parents' Forum sitting`}
        data-lb-cap="The forum room — every desk named for a class"
        data-mask
      >
        <SmartImage
          file={pRoom}
          alt={ac.picAlt('pRoom')}
         
          widths={[540, 900, 1280]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </a>

      <a
        class="pf-open__small as-frame as-frame--float"
        data-lb-open
        href={pRows.src}
        data-lb-alt={`A closer row of parents at a Parents' Forum sitting at ${S}`}
        data-lb-cap="A row of the same room"
        data-pop
        data-pop-delay="240"
      >
        <SmartImage
          file={pRows}
          alt={ac.picAlt('pRows')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

{/* ══ 02 · TWELVE ITEMS, ON THE WALL ═════════════════════════════════════════
    Ground: cream. The centrepiece. Copy and two photographs left; the twelve
    items right, in two columns, in the school's own order.

    ⚠ THE LIST IS DATA-DRIVEN AND HAS NO CEILING. It maps forumAgenda; a
    thirteenth item is one entry in the data file. Nothing here counts to twelve
    except the heading, which reads it off the array's length. */}
<section class="as-sec as-sec--cream as-pad pf-ag" aria-labelledby="pf-ag-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container pf-ag__grid">
    <div class="pf-ag__copy">
      <p class="as-kicker" data-reveal>Session for Classes IX to XII</p>
      <h2 class="as-h as-h--lg" id="pf-ag-t">
        <span data-clip data-clip-delay="0">{forumAgenda.length === 12 ? 'Twelve items,' : `${forumAgenda.length} items,`}</span>
        <span data-clip data-clip-delay="150"><em>on the wall.</em></span>
      </h2>
      <p class="as-body pf-ag__b" data-reveal data-reveal-delay="200">
        The school projects the agenda rather than keeping it at the front table, which means every
        parent in the room can see the whole list — including the items still to come. All of them are below, in the school’s own words and its own order.
      </p>

      <div class="pf-ag__pics">
        <a
          class="pf-ag__wide as-frame"
          data-lb-open
          href={pPanel.src}
          data-lb-alt={`The agenda for the Parents' Forum projected on screen at ${S}, with the school's leadership panel seated beneath it`}
          data-lb-cap={agendaHeading}
          data-mask
        >
          <SmartImage
            file={pPanel}
            alt={ac.picAlt('pPanel')}
           
            widths={[420, 760, 1100]}
            sizes="(max-width: 1023px) 92vw, 34vw"
            loading="lazy"
            decoding="async"
          />
        </a>

        <a
          class="pf-ag__disc"
          data-lb-open
          href={pMic.src}
          data-lb-alt={`A parent speaking into the microphone from the floor at a Parents' Forum sitting at ${S}, at a desk labelled II-C`}
          data-lb-cap="A parent at the microphone — the desk is labelled II-C"
          data-pop
          data-pop-delay="260"
        >
          <SmartImage
            file={pMic}
            alt={ac.picAlt('pMic')}
           
            widths={[260, 440]}
            sizes="(max-width: 1023px) 36vw, 14vw"
            loading="lazy"
            decoding="async"
          />
        </a>
      </div>
    </div>

    <ol class="pf-items" aria-label={agendaHeading}>
      {forumAgenda.map((a, i) => (
        <li class="pf-item" data-reveal data-reveal-delay={100 + i * 45}>
          <span class="pf-item__n t-tabular">{a.n}</span>
          <span class="pf-item__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[a.mark]} />
            </svg>
          </span>
          <span class="pf-item__t">
            <span class="pf-item__k">{a.k}</span>
            {a.note && <span class="pf-item__v">{a.note}</span>}
          </span>
        </li>
      ))}
    </ol>
  </div>

  <p class="pf-ag__src">
    Transcribed from the school’s own projected slide, headed “{agendaHeading}”. Ten of the twelve
    are a bare name on that slide; only two carry any further words, and both are reproduced here
    exactly as written.
  </p>
</section>

<PpWhy
  id="pf-why-t"
  lead="Why the Parents’ Forum"
  accent="matters"
  items={forumBenefits}
/>

<PpCta
  id="pf-cta-t"
  lead="Have a question"
  tail="or want to know more?"
  body="We’re here to listen and help. Talk to the school office for details of the forum and the sitting that covers your child’s class."
/>

<AsClose
  id="pf-close-t"
  kicker="A question raised for a class"
  lead="Answered"
  accent="to the room."
  body="The school publishes the forum, its agenda and the classes each sitting covers. How often it sits, how a class representative is chosen, and what was decided at any sitting are not published — so they are not stated here."
  photo={pCohort}
  position="50% 40%"
  inline
/>

<Lightbox />

<style>
  /* ═══ 01 · A SEAT WITH A CLASS ON IT ══════════════════════════════════════ */
  .pf-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(28px, 3.8vw, 64px);
    align-items: center;
  }
  .pf-open__h { max-width: 11ch; }
  .pf-open__copy .as-body { max-width: 46ch; }

  .pf-open__media { position: relative; padding-bottom: clamp(30px, 4vw, 58px); }
  .pf-open__dots { top: 14%; left: -4%; z-index: 0; }

  .pf-open__big { display: block; overflow: hidden; border-radius: var(--sb-r-2); cursor: zoom-in; }
  .pf-open__big :global(picture) { display: block; }
  .pf-open__big :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 16 / 10.4;
    object-fit: cover;
  }

  /* ⚠ THE SMALL FRAME OVERLAPS THE LARGE ONE'S LOWER-LEFT CORNER, which is the
     one corner of that photograph carrying no faces — so nothing important is
     ever covered. */
  .pf-open__small {
    position: absolute;
    left: -6%;
    bottom: 0;
    z-index: 2;
    display: block;
    width: 33%;
    overflow: hidden;
    border: 4px solid var(--sb-paper);
    border-radius: var(--sb-r-2);
    cursor: zoom-in;
  }
  .pf-open__small :global(picture) { display: block; }
  .pf-open__small :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3.2; object-fit: cover; }

  /* ═══ 02 · TWELVE ITEMS ═══════════════════════════════════════════════════ */
  .pf-ag__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(28px, 3.6vw, 60px);
    align-items: start;
  }
  .pf-ag__b { max-width: 42ch; }

  .pf-ag__pics { position: relative; margin: clamp(20px, 2.6vw, 34px) 0 0; padding-bottom: clamp(18px, 2.4vw, 30px); }
  .pf-ag__wide { display: block; overflow: hidden; border-radius: var(--sb-r-2); cursor: zoom-in; }
  .pf-ag__wide :global(picture) { display: block; }
  .pf-ag__wide :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 8.6; object-fit: cover; object-position: 62% 40%; }

  /* ⚠ THE DISC IS THE EVIDENCE FOR "open dialogue", and it sits beside the
     agenda deliberately: the list on the wall and a parent answering it from the
     floor are the two halves of the same claim. */
  .pf-ag__disc {
    position: absolute;
    left: 4%;
    bottom: 0;
    z-index: 2;
    display: block;
    width: clamp(74px, 8.4vw, 116px);
    aspect-ratio: 1 / 1;
    overflow: hidden;
    border: 4px solid var(--sb-paper);
    border-radius: 50%;
    box-shadow: var(--sb-shadow-card);
    cursor: zoom-in;
  }
  .pf-ag__disc :global(picture) { display: block; height: 100%; }
  .pf-ag__disc :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 44% 44%; }

  .pf-items {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 16px) clamp(14px, 1.8vw, 26px);
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    padding: 0;
    list-style: none;
  }
  .pf-item {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    gap: clamp(9px, 1vw, 13px);
    align-items: center;
    padding: clamp(11px, 1.3vw, 16px) clamp(12px, 1.4vw, 17px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    transition: border-color var(--sb-dur-image) var(--sb-ease), transform var(--sb-dur-image) var(--sb-ease);
  }
  .pf-item:hover {
    transform: translateY(-2px);
    border-color: color-mix(in srgb, var(--sb-orange-bright) 46%, transparent);
  }
  .pf-item__n {
    display: grid;
    place-items: center;
    width: clamp(23px, 2.1vw, 29px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-orange-bright);
    font-size: clamp(8.5px, 0.64vw, 10.2px);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
  }
  .pf-item__m { display: block; width: clamp(17px, 1.55vw, 22px); color: var(--sb-orange-bright); }
  .pf-item__m svg { display: block; width: 100%; height: auto; }
  .pf-item__t { display: grid; gap: 2px; min-width: 0; }
  .pf-item__k {
    font-family: var(--sb-font-display);
    font-size: clamp(11.5px, 0.92vw, 14.4px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .pf-item__v {
    font-size: clamp(9px, 0.68vw, 10.6px);
    line-height: 1.5;
    color: var(--sb-text-muted);
  }

  .pf-ag__src {
    position: relative;
    max-width: 74ch;
    margin: clamp(22px, 2.8vw, 36px) auto 0;
    padding: 0 var(--sb-margin);
    text-align: center;
    font-size: clamp(9px, 0.68vw, 10.8px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .pf-ag__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(24px, 3.2vw, 34px); }
    .pf-ag__b { max-width: 62ch; }
    .pf-ag__pics { max-width: 560px; }
  }

  @media (max-width: 1023px) {
    .pf-open__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(26px, 4vw, 36px); }
    .pf-open__h { max-width: none; }
    .pf-open__copy .as-body { max-width: 62ch; }
  }

  @media (max-width: 767px) {
    .pf-items { grid-template-columns: minmax(0, 1fr); }
    .pf-open__small { width: 40%; }
    .pf-ag__disc { width: clamp(66px, 18vw, 90px); }
  }
</style>
