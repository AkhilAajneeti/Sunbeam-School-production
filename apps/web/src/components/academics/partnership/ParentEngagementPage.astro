---
/**
 * PARENT PARTNERSHIP · PARENT ENGAGEMENT — four sections and the close.
 *
 * ⚠⚠ WHAT WAS REMOVED FROM THIS PAGE, AND WHY IT STAYS REMOVED.
 * data/academics.ts `parents.engagement.ways` describes four channels — a sports
 * day with "parents both watching and helping run it", the annual function,
 * exhibitions where "students explain their own work to visitors", and
 * volunteering where parents give "a skill, a morning, a trade". The school
 * publishes none of the four, and two of them make claims about what parents DO
 * on the premises. That is not ours to assert, and no amount of design pressure
 * changes it. This page is built from what the school's own photographs and its
 * own projected slide actually show.
 *
 * ⚠⚠ THE AGENDA CARDS CARRY NO INVENTED DESCRIPTIONS. The brief's mock-up shows
 * a one-line gloss under each of twelve items — "Recognition that builds a
 * child's confidence" under Positive Affirmations, "Nutrition, fruit break time
 * and practice" under Fruit Break, "Routes, stops and safety on commute" under a
 * "Transport" item that is not on the agenda at all. The school's slide names
 * these items and describes none of them, so the cards name them too. Ten of the
 * twelve therefore show a title and nothing else — only items 05 and 11 carry
 * further words on the slide — which is the correct amount of information to
 * give. The transcription is in data/parentsForum.ts.
 *
 * ═══ SOURCE — the school's own artefacts ═══════════════════════════════════
 *   parents forum (3).jpg — every desk carries a class nameplate: Nursery,
 *     KG-I A, II-C, II-E, III-A. Parents are seated by class section, not
 *     admitted as a general audience.
 *   parents forum (5).jpg — a second sitting, its projected agenda headed
 *     "Class IX to XII", so the structure repeats up the school. The panel
 *     beneath it is the school's leadership.
 *   parents forum (1).jpg — the school's own poster, dated 10.11.2025, showing
 *     parents at the microphone.
 *   The agenda names "Grandparents Cove" — the engagement is written to reach
 *     past parents. What it IS is not published, so it is named, not explained.
 *
 * ASSET REQUIREMENT: the school's own account of how a class representative is
 * chosen, and what Grandparents Cove is.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · IVORY  copy left, the nameplates right as an overlapping pair.
 *   02 · CREAM  five facts on hairlines, centred heading between two rules.
 *   03 · PAPER  the agenda, twelve cards, six across.
 *   04 · CREAM  the contact panel.
 *   05 · PHOTO  the cinematic close.
 */
import SmartImage from '../../../components/ui/SmartImage.astro';
import '../../../styles/assessment.css';
import { MARK } from '../assessment/marks';
import AsClose from '../assessment/AsClose.astro';
import PpCta from './PpCta.astro';
import Lightbox from '../../ui/Lightbox.astro';

import { getAcademicTopic } from '../../../lib/cms';

const ac = await getAcademicTopic('/academics/parent-partnership/parents-forum/');
const pRoom = ac.pic('pRoom');
const pRows = ac.pic('pRows');
const pCohort = ac.pic('pCohort');
const ac1 = await getAcademicTopic('/academics/parent-partnership/parent-engagement/');
const forumAgenda = ac.section('forumAgenda').points;
const agendaHeading = ac.section('agendaHeading').note;
const forumNameplates = ac.section('forumNameplates').facts;
const engagementFacts = ac1.section('engagementFacts').points;

const S = 'Sunbeam School Ballia';
const FORUM = '/academics/parent-partnership/parents-forum/';

const plates = forumNameplates.join(', ');
---

{/* ══ 01 · BY THE CLASS, NOT BY THE CROWD ════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad pe-open" aria-labelledby="pe-open-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container pe-open__grid">
    <div class="pe-open__copy">
      <p class="as-kicker" data-reveal>How it is actually organised</p>
      <h2 class="as-h as-h--xl pe-open__h" id="pe-open-t">
        <span data-clip data-clip-delay="0">By the class,</span>
        <span data-clip data-clip-delay="150"><em>not by the crowd.</em></span>
      </h2>

      <p class="as-body" data-reveal data-reveal-delay="200">
        The evidence for how Sunbeam engages parents is not in a paragraph — it is on the desk. In
        the school’s own room, every place carries a class nameplate:
        {' '}<strong>{plates}</strong>. A parent is seated <strong>for a class</strong>.
      </p>
      <p class="as-body" data-reveal data-reveal-delay="250">
        The structure repeats up the school — another sitting’s agenda is headed
        {' '}<strong>Classes IX to XII</strong>. That is a materially different arrangement from a
        general invitation: a concern about one class arrives as that class’s concern rather than as
        one family’s, and every section has somebody in the room whether or not its own parents came.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="300">
        The same agenda carries an item called <strong>“Grandparents Cove”</strong> — the engagement
        is written to reach past parents. What it is has not been published, so it is named here and
        left at that. The full agenda is on {' '}<a class="as-link" href={FORUM}>Parents’ Forum</a>.
      </p>
    </div>

    <div class="pe-open__media">
      <span class="as-dots pe-open__dots" aria-hidden="true"></span>

      <a
        class="pe-open__big as-frame"
        data-lb-open
        href={pRoom.src}
        data-lb-alt={`Parents of ${S} seated at desks carrying class nameplates — Nursery, KG-I A, II-C, II-E and III-A are legible`}
        data-lb-cap="Seated by class — the nameplates on the desks"
        data-mask
      >
        <SmartImage
          file={pRoom}
          alt={ac.picAlt('pRoom')}
         
          widths={[540, 900, 1280]}
          sizes="(max-width: 1023px) 92vw, 44vw"
          loading="eager"
          decoding="async"
        />
      </a>

      <a
        class="pe-open__small as-frame as-frame--float"
        data-lb-open
        href={pRows.src}
        data-lb-alt={`A closer row of parents at a sitting of the Parents' Forum at ${S}`}
        data-lb-cap="A row of the same room"
        data-pop
        data-pop-delay="240"
      >
        <SmartImage
          file={pRows}
          alt={ac.picAlt('pRows')}
         
          widths={[320, 560]}
          sizes="(max-width: 1023px) 46vw, 20vw"
          loading="lazy"
          decoding="async"
        />
      </a>
    </div>
  </div>
</section>

{/* ══ 02 · WHAT PARENTS SEE IN THE ROOM ══════════════════════════════════════
    Ground: cream. A centred label ruled off on both sides, then five columns
    divided by dotted hairlines — not cards. Five boxes here would repeat the
    twelve boxes immediately below and the page would read as one long grid. */}
<section class="as-sec as-sec--cream as-pad--sm pe-see" aria-labelledby="pe-see-t">
  <div class="u-container">
    <p class="pe-see__lab" id="pe-see-t" data-reveal>
      <span class="pe-see__rule" aria-hidden="true"></span>
      <span class="pe-see__labt">What parents see in the room</span>
      <span class="pe-see__rule" aria-hidden="true"></span>
    </p>

    <ul class="pe-see__list">
      {engagementFacts.map((f, i) => (
        <li class="pe-fact" data-reveal data-reveal-delay={120 + i * 80}>
          <span class="pe-fact__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[f.mark]} />
            </svg>
          </span>
          <h3 class="pe-fact__k">{f.k}</h3>
          <p class="pe-fact__v">{f.v}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

{/* ══ 03 · THE AGENDA ════════════════════════════════════════════════════════
    Ground: white. Twelve compact cards, six across — light enough that the row
    of five above it stays the heavier statement.

    ⚠ DATA-DRIVEN AND UNBOUNDED. It maps forumAgenda; nothing here counts to
    twelve except the heading, which reads the array's own length. */}
<section class="as-sec as-sec--paper as-pad--sm pe-ag" aria-labelledby="pe-ag-t">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <div class="pe-ag__head">
      <div>
        <p class="as-kicker" data-reveal>What the forum discusses</p>
        <h2 class="as-h as-h--md pe-ag__h" id="pe-ag-t">
          <span data-clip data-clip-delay="0">The agenda,</span>
          <span data-clip data-clip-delay="140"><em>item by item.</em></span>
        </h2>
      </div>
      <p class="as-note pe-ag__b" data-reveal data-reveal-delay="200">
        All of them, in the school’s own words and its own order, transcribed from the
        slide it projects. Ten of the twelve are a bare name on that slide — those cards carry the
        name and nothing else, rather than a description we wrote for them.
      </p>
    </div>

    <ol class="pe-cards" aria-label={agendaHeading}>
      {forumAgenda.map((a, i) => (
        <li class="pe-card" data-pop data-pop-delay={90 + i * 45}>
          <span class="pe-card__n t-tabular">{a.n}</span>
          <h3 class="pe-card__k">{a.k}</h3>
          {a.note && <p class="pe-card__v">{a.note}</p>}
        </li>
      ))}
    </ol>
  </div>
</section>

<PpCta
  id="pe-cta-t"
  lead="Have a question"
  tail="or want to connect?"
  body="We’re here to listen and help. Talk to the school office, or reach the right person on their direct line."
/>

<AsClose
  id="pe-close-t"
  kicker="Represented by class section"
  lead="Every class"
  accent="has someone there."
  body="The school publishes photographs showing parents seated by class section, and names Grandparents Cove on its own agenda. How a representative is chosen, and what parents are invited to help run, are not published — so no volunteering or events programme is described here."
  photo={pCohort}
  position="50% 40%"
  inline
/>

<Lightbox />

<style>
  /* ═══ 01 · BY THE CLASS ═══════════════════════════════════════════════════ */
  .pe-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(0, 1.04fr);
    gap: clamp(28px, 3.8vw, 64px);
    align-items: center;
  }
  .pe-open__h { max-width: 12ch; }
  .pe-open__copy .as-body { max-width: 46ch; }

  .pe-open__media { position: relative; padding-bottom: clamp(30px, 4vw, 56px); }
  .pe-open__dots { top: 10%; left: -5%; z-index: 0; }
  .pe-open__big { display: block; overflow: hidden; border-radius: var(--sb-r-2); cursor: zoom-in; }
  .pe-open__big :global(picture) { display: block; }
  .pe-open__big :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10.4; object-fit: cover; }
  .pe-open__small {
    position: absolute;
    left: 2%;
    bottom: 0;
    z-index: 2;
    display: block;
    width: 34%;
    overflow: hidden;
    border: 4px solid var(--sb-paper);
    border-radius: var(--sb-r-2);
    cursor: zoom-in;
  }
  .pe-open__small :global(picture) { display: block; }
  .pe-open__small :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 4 / 3.1; object-fit: cover; }

  /* ═══ 02 · WHAT PARENTS SEE ═══════════════════════════════════════════════ */
  .pe-see__lab {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: clamp(12px, 1.6vw, 22px);
    margin: 0;
  }
  .pe-see__rule { display: block; height: 1px; background: var(--sb-border-strong); }
  .pe-see__labt {
    font-size: clamp(9px, 0.68vw, 10.8px);
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--sb-orange-bright);
  }

  .pe-see__list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: clamp(22px, 2.8vw, 36px) 0 0;
    padding: 0;
    list-style: none;
  }
  /* ⚠ DOTTED HAIRLINES BETWEEN THE COLUMNS, never around them — the row has to
     read as one ruled sheet rather than as five more cards. */
  .pe-fact {
    display: grid;
    align-content: start;
    justify-items: center;
    padding: clamp(4px, 0.6vw, 8px) clamp(12px, 1.6vw, 24px);
    text-align: center;
  }
  .pe-fact:first-child { padding-left: 0; }
  .pe-fact:last-child { padding-right: 0; }
  .pe-fact + .pe-fact { border-left: 1px dashed var(--sb-border-strong); }
  .pe-fact__m { display: block; width: clamp(26px, 2.4vw, 34px); color: var(--sb-orange-bright); }
  .pe-fact__m svg { display: block; width: 100%; height: auto; }
  .pe-fact__k {
    margin: clamp(10px, 1.3vw, 16px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 0.96vw, 15px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .pe-fact__v {
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-size: clamp(9.5px, 0.7vw, 11px);
    line-height: 1.62;
    color: var(--sb-text-muted);
  }

  /* ═══ 03 · THE AGENDA ═════════════════════════════════════════════════════ */
  .pe-ag__head {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(20px, 2.6vw, 40px);
    align-items: end;
    margin: 0 0 clamp(20px, 2.6vw, 32px);
  }
  .pe-ag__h { margin-top: 0; max-width: 16ch; }
  .pe-ag__b { max-width: 56ch; }

  .pe-cards {
    position: relative;
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(10px, 1.2vw, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .pe-card {
    display: grid;
    align-content: start;
    padding: clamp(12px, 1.4vw, 17px) clamp(12px, 1.4vw, 16px) clamp(14px, 1.6vw, 19px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    box-shadow: 0 3px 12px -10px rgba(28, 14, 8, 0.18);
    transition: transform var(--sb-dur-image) var(--sb-ease), border-color var(--sb-dur-image) var(--sb-ease);
  }
  .pe-card:hover { transform: translateY(-2px); border-color: color-mix(in srgb, var(--sb-orange-bright) 46%, transparent); }
  .pe-card__n {
    display: grid;
    place-items: center;
    width: clamp(21px, 1.9vw, 26px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-orange-bright);
    font-size: clamp(8px, 0.6vw, 9.6px);
    font-weight: 700;
    letter-spacing: 0.03em;
    color: #fff;
  }
  .pe-card__k {
    margin: clamp(8px, 1vw, 12px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(11px, 0.86vw, 13.4px);
    font-weight: 700;
    line-height: 1.22;
    letter-spacing: -0.028em;
    color: var(--sb-charcoal);
  }
  .pe-card__v {
    margin: clamp(5px, 0.6vw, 8px) 0 0;
    font-size: clamp(8.6px, 0.64vw, 10.2px);
    line-height: 1.52;
    color: var(--sb-text-muted);
  }

  /* ═══ RESPONSIVE ══════════════════════════════════════════════════════════ */
  @media (max-width: 1179px) {
    .pe-cards { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  }

  @media (max-width: 1023px) {
    .pe-open__grid { grid-template-columns: minmax(0, 1fr); gap: clamp(26px, 4vw, 36px); }
    .pe-open__h { max-width: none; }
    .pe-open__copy .as-body { max-width: 62ch; }
    .pe-ag__head { grid-template-columns: minmax(0, 1fr); gap: clamp(12px, 2vw, 18px); align-items: start; }
    .pe-ag__h { max-width: none; }
    .pe-see__list { grid-template-columns: repeat(3, minmax(0, 1fr)); row-gap: clamp(22px, 3vw, 30px); }
    .pe-fact { padding-left: clamp(12px, 2.2vw, 22px); padding-right: clamp(12px, 2.2vw, 22px); }
    .pe-fact:nth-child(3n + 1) { padding-left: 0; border-left: 0; }
    .pe-fact:nth-child(3n) { padding-right: 0; }
  }

  @media (max-width: 767px) {
    .pe-cards { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pe-see__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .pe-fact:nth-child(3n + 1) { padding-left: clamp(12px, 2.2vw, 22px); border-left: 1px dashed var(--sb-border-strong); }
    .pe-fact:nth-child(odd) { padding-left: 0; border-left: 0; }
    .pe-fact:nth-child(even) { padding-right: 0; }
    .pe-open__small { width: 42%; }
  }

  @media (max-width: 479px) {
    .pe-cards { grid-template-columns: minmax(0, 1fr); }
    .pe-see__list { grid-template-columns: minmax(0, 1fr); }
    .pe-fact { padding: 0; border-left: 0 !important; }
    .pe-fact + .pe-fact { padding-top: clamp(18px, 4vw, 24px); border-top: 1px dashed var(--sb-border-strong); }
  }
</style>
