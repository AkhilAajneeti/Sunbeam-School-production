---
/**
 * PARENTS' FEEDBACK — the page body.
 *
 * ═══ THE ORDER IS THE ARGUMENT ═════════════════════════════════════════════
 *
 *   1. Voices carousel      — what parents said        (hidden while empty)
 *   2. Parent participation — the channels the school runs
 *   3. Closing band
 *   4. "Your Voice Matters" form — where a parent adds theirs
 *
 * A reader lands, reads what others said, sees the channels, and is invited to
 * contribute at the bottom. ⚠ THE FORM IS LAST, NEVER FIRST: a blank form with
 * no context above it converts nobody.
 *
 * ⚠ THERE IS NO PHOTO STRIP. An earlier version had three photographs between
 * participation and the closing band. It was removed. Do not add one back.
 *
 * ═══ THE TWO RAILS MUST LOOK LIKE ONE COMPONENT ════════════════════════════
 *
 * ⚠⚠ The voices cards and the participation cards sit one above the other, so
 * they share a shell exactly: `--sb-ivory` ground, `--sb-rule` border,
 * `--sb-r-0` radius, NO shadow, `--sb-6` padding, and the same shape-2
 * flourish. A white shadowed card over a flat ivory one reads as two different
 * components that happen to be on the same page.
 *
 * ⚠ `--sb-r-0` IS 16px. `--sb-r-1` IS 999px — the full pill. Style a card with
 * r-1 and it renders as a lozenge.
 *
 * ⚠ TWO CARDS PER SCREEN, NOT FOUR. At four columns each quote had about 240px
 * and broke into a narrow column of five-word lines. Two up gives a readable
 * measure and matches the rail directly below it. That is the BASE rule, so
 * there is no `max-width: 1023px` override restating it.
 *
 * ⚠ `overflow-x: auto` FORCES `overflow-y` TO COMPUTE TO AUTO, so a rail clips
 * vertically whether or not it ever scrolls that way. Both rails carry vertical
 * padding for that reason.
 */
import { participation, closing } from '../../../data/parentsFeedback';
import { getParentTestimonials } from '../../../lib/cms';
import { feedbackBand } from '../../../data/parentsFeedbackForm';
import FeedbackForm from './FeedbackForm.astro';
import leaf from '../../../assets/icons/leaf-remove.png';

/**
 * ⚠⚠ THE CAROUSEL READS THE CLEARED QUOTES, NOT THE FORM'S INBOX. What a
 * parent sends through "Your Voice Matters" goes to Parent Feedback, which no
 * page reads — it is private correspondence about a named child. A quote only
 * reaches this collection after somebody has asked the parent. Pointing this
 * at the inbox would publish whatever a stranger typed into a public form.
 */
const testimonials = await getParentTestimonials();
const hasVoices = testimonials.length > 0;
---

<div class="pfb">
  {/* ══ 1 · VOICES — the whole band is inside the guard ══════════════════════
      ⚠⚠ Heading, copy, carousel, arrows and dots are ALL within
      `hasVoices`. A section with nothing to say should not be on the page —
      not as an empty shell, not as a "coming soon". */}
  {hasVoices && (
    <section class="pfb__band pfb__voices" aria-labelledby="pfb-voices-h">
      <div class="u-container">
        <header class="pfb__head">
          <p class="pfb__eyebrow t-label" data-reveal>What our parents say</p>
          <h2 class="pfb__h" id="pfb-voices-h" data-split>
            Real experiences. Real growth.<br /><span class="pfb__mark">Stronger together.</span>
          </h2>
          <p class="pfb__standfirst" data-reveal>
            Our parents are an integral part of our learning journey.<br />
            Their encouragement inspires us every day.
          </p>
        </header>

        <div class="pfb__frame">
          <button type="button" class="pfb__arrow pfb__arrow--prev" data-v-prev aria-label="Previous">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>

          <ul class="pfb__rail" data-v-rail>
            {testimonials.map((t) => (
              <li class="pfb__card">
                <span class="pfb__cshape" aria-hidden="true"></span>
                <div class="pfb__cin">
                  <span class="pfb__quotemark" aria-hidden="true">”</span>
                  <blockquote class="pfb__quote"><p>{t.quote}</p></blockquote>
                  <div class="pfb__by">
                    <span class="pfb__byicon" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="8" r="3.4"/><path d="M4.5 20c0-3.6 3.4-6 7.5-6s7.5 2.4 7.5 6"/>
                      </svg>
                    </span>
                    <span class="pfb__byname">
                      <strong>{t.parentName}</strong>
                      <span>{t.relation}{t.className ? ` · ${t.className}` : ''}</span>
                      {t.source && <span class="pfb__src">{t.source}</span>}
                    </span>
                  </div>
                </div>
              </li>
            ))}
          </ul>

          <button type="button" class="pfb__arrow pfb__arrow--next" data-v-next aria-label="Next">
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </button>
        </div>

        <div class="pfb__dots" data-v-dots role="tablist" aria-label="Parent testimonials"></div>
      </div>
    </section>
  )}

  {/* ══ 2 · PARENT PARTICIPATION ═══════════════════════════════════════════
      No standfirst. One existed, written by the project to explain that the
      cards are not testimonials; it went with the rest of the invented copy. */}
  <section class="pfb__band pfb__part" aria-labelledby="pfb-part-h">
    <div class="u-container">
      <header class="pfb__head">
        <p class="pfb__eyebrow t-label" data-reveal>Parent participation</p>
        <h2 class="pfb__h" id="pfb-part-h" data-split>Parents are part of the journey.</h2>
      </header>

      <div class="pfb__frame">
        <button type="button" class="pfb__arrow pfb__arrow--prev" data-p-prev aria-label="Previous">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>

        {/* Not anchors, and no hover lift — see the data file. */}
        <ul class="pfb__rail" data-p-rail>
          {participation.map((item) => (
            <li class="pfb__card">
              <span class="pfb__cshape" aria-hidden="true"></span>
              <div class="pfb__cin">
                <span class="pfb__n" aria-hidden="true">{item.n}</span>
                <h3 class="pfb__t">{item.title}</h3>
                {item.paras.map((para) => <p class="pfb__p">{para}</p>)}
              </div>
            </li>
          ))}
        </ul>

        <button type="button" class="pfb__arrow pfb__arrow--next" data-p-next aria-label="Next">
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </button>
      </div>

      <div class="pfb__dots" data-p-dots role="tablist" aria-label="Parent participation"></div>
    </div>
  </section>

  {/* ══ 3 · CLOSING ════════════════════════════════════════════════════════ */}
  <section class="pfb__band pfb__close" aria-labelledby="pfb-close-h">
    <div class="u-container">
      <div class="pfb__closecard">
        <span class="pfb__closeicon" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="9" cy="8" r="3"/><circle cx="17" cy="9" r="2.2"/>
            <path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><path d="M15.5 19c0-2 1.4-3.4 3.2-3.4S22 17 22 19"/>
          </svg>
        </span>

        <div class="pfb__closecopy">
          <h2 class="pfb__h pfb__h--close" id="pfb-close-h" data-split>
            {closing.heading}<br /><span class="pfb__mark">Thank you, parents!</span>
          </h2>
          <p class="pfb__closebody" data-reveal>{closing.body}</p>
        </div>

        <a class="pfb__closecta btn btn--primary" href={closing.cta.href}>
          {closing.cta.label}
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-7 7 7-7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>

        {/* The client's leaf mark. Decorative only. */}
        <img class="pfb__leaf" src={leaf.src} alt="" aria-hidden="true" loading="lazy" decoding="async" />
      </div>
    </div>
  </section>

  {/* ══ 4 · THE FORM ═════════════════════════════════════════════ */}
  <section class="pfb__band pfb__formband" aria-labelledby="pfb-form-h">
    {/* Decoration: blobs, stars and dashed trails, all inert and behind the
        content. Built from gradients and one line-art asset rather than a
        background image — see the stylesheet. */}
    <span class="pfb-d pfb-d__blob pfb-d__blob--tl" aria-hidden="true"></span>
    <span class="pfb-d pfb-d__blob pfb-d__blob--tr" aria-hidden="true"></span>
    <span class="pfb-d pfb-d__blob pfb-d__blob--bl" aria-hidden="true"></span>
    <span class="pfb-d pfb-d__blob pfb-d__blob--br" aria-hidden="true"></span>
    <span class="pfb-d pfb-d__leaf" aria-hidden="true"></span>
    <svg class="pfb-d pfb-d__trail pfb-d__trail--l" viewBox="0 0 420 200" fill="none" aria-hidden="true">
      <path d="M4 150C60 40 180 8 300 60c70 30 90 80 116 96" stroke="currentColor" stroke-width="3"
            stroke-linecap="round" stroke-dasharray="10 14"/>
    </svg>
    <svg class="pfb-d pfb-d__star pfb-d__star--a" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.3 6.1 20.5l1.2-6.7L2.5 9.1l6.6-.9L12 2Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/></svg>
    <svg class="pfb-d pfb-d__star pfb-d__star--b" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.3 6.1 20.5l1.2-6.7L2.5 9.1l6.6-.9L12 2Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/></svg>
    <svg class="pfb-d pfb-d__star pfb-d__star--c" viewBox="0 0 24 24" aria-hidden="true"><path d="m12 2 2.9 6.2 6.6.9-4.8 4.7 1.2 6.7L12 17.3 6.1 20.5l1.2-6.7L2.5 9.1l6.6-.9L12 2Z" stroke="currentColor" stroke-width="1.6" fill="none" stroke-linejoin="round"/></svg>

    {/* The script flourish and its paper plane, top right. Decorative only. */}
    <div class="pfb-fl" aria-hidden="true">
      <p class="pfb-fl__words">
        {feedbackBand.flourish.map((line, i) => (
          <span class:list={['pfb-fl__line', i === feedbackBand.flourish.length - 1 && 'pfb-fl__line--last']}>{line}</span>
        ))}
      </p>
      <span class="pfb-fl__plane"></span>
    </div>

    <div class="u-container">
      <header class="pfb__head pfb-form__head">
        <p class="pfb__eyebrow pfb-form__eyebrow t-label" data-reveal>
          <span class="pfb-form__rule" aria-hidden="true"></span>
          {feedbackBand.eyebrow}
          <span class="pfb-form__rule" aria-hidden="true"></span>
        </p>
        <h2 class="pfb-form__h" id="pfb-form-h" data-split set:html={
          feedbackBand.heading.replace(/\{\{(.+?)\}\}/g, '<em class="pfb-form__mark">$1</em>')
        } />
        <p class="pfb__standfirst" data-reveal>{feedbackBand.standfirst}</p>
      </header>

      {/* ⚠ TWO COLUMNS: the three benefits, then the form card. They collapse to
          one column below 1023px, where a 3-across benefit row would squeeze the
          form into half a screen. */}
      <div class="pfb-form__cols">
        <ul class="pfb-form__benefits">
          {feedbackBand.benefits.map((b, i) => (
            <li class="pfb-form__ben" data-reveal data-reveal-delay={i * 90}>
              <span class="pfb-form__benicon" aria-hidden="true">
                {b.icon === 'heart' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 20s-7-4.4-7-9.2A4.3 4.3 0 0 1 12 7.6a4.3 4.3 0 0 1 7 3.2C19 15.6 12 20 12 20Z"/></svg>}
                {b.icon === 'people' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="8" r="3"/><path d="M3 19c0-3 2.7-5 6-5s6 2 6 5"/><circle cx="17" cy="9" r="2.2"/><path d="M15.5 19c0-2 1.4-3.4 3.2-3.4S22 17 22 19"/></svg>}
                {b.icon === 'star' && <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="m12 3.6 2.6 5.3 5.8.8-4.2 4.1 1 5.8-5.2-2.7-5.2 2.7 1-5.8-4.2-4.1 5.8-.8L12 3.6Z"/></svg>}
              </span>
              <span class="pfb-form__bentext">
                <strong>{b.title}</strong>
                <span>{b.body}</span>
              </span>
            </li>
          ))}
        </ul>

        <div class="pfb__formcard">
          <FeedbackForm />
        </div>
      </div>
    </div>
  </section>
</div>

<style>
  .pfb { background: var(--sb-paper); }

  .pfb__band { position: relative; padding-block: clamp(34px, 4.4vw, 72px); }
  .pfb__voices { background: var(--sb-paper); }
  .pfb__part { background: var(--sb-paper); }
  .pfb__close { background: var(--sb-paper); }
  .pfb__formband { background: var(--sb-ivory); }

  /* ── Heads ───────────────────────────────────────────────────────────── */
  .pfb__head { text-align: center; margin-bottom: clamp(24px, 3vw, 42px); }
  .pfb__eyebrow {
    margin: 0;
    color: var(--sb-violet);
    letter-spacing: 0.22em;
    font-size: clamp(10.5px, 0.2vw + 9px, 12px);
  }
  .pfb__h {
    margin: var(--sb-4) 0 0;
    font-family: var(--sb-font-serif);
    font-size: clamp(23px, 2.2vw, 36px);
    font-weight: 600;
    line-height: 1.18;
    letter-spacing: -0.016em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }
  .pfb__mark { color: var(--sb-violet); }
  .pfb__standfirst {
    max-width: 58ch;
    margin: var(--sb-4) auto 0;
    font-size: clamp(13.5px, 0.3vw + 12px, 15.5px);
    line-height: 1.66;
    color: var(--sb-text-secondary);
  }

  /* ── Frame: arrows outside the rail ──────────────────────────────────── */
  .pfb__frame {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--sb-4);
  }

  .pfb__arrow {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--sb-r-full);
    border: var(--sb-rule);
    background: var(--sb-paper);
    color: var(--sb-charcoal);
    cursor: pointer;
    transition: background 180ms var(--sb-ease), color 180ms var(--sb-ease);
  }
  .pfb__arrow svg { width: 17px; height: 17px; }
  .pfb__arrow:hover { background: var(--sb-violet); color: #fff; border-color: var(--sb-violet); }

  /* ── Rails — identical mechanics in both bands ───────────────────────── */
  .pfb__rail {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc((100% - var(--sb-5)) / 2);
    gap: var(--sb-5);
    margin: 0;
    /* See the header: overflow-x forces overflow-y, so the rail needs room. */
    padding: 10px 2px 14px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    align-items: stretch;
  }
  .pfb__rail::-webkit-scrollbar { display: none; }

  @media (max-width: 767px) {
    .pfb__rail { grid-auto-columns: 88%; }
    .pfb__arrow { display: none; }
    .pfb__frame { grid-template-columns: minmax(0, 1fr); }
  }

  /* ── The shared card shell ───────────────────────────────────────────────
     ⚠⚠ THE VOICES CARD AND THE PARTICIPATION CARD ARE THE SAME ELEMENT. One
     class, one rule. If they ever need to differ, they should stop looking like
     two instances of one component first. */
  .pfb__card {
    position: relative;
    overflow: hidden;
    display: flex;
    min-width: 0;
    height: 100%;
    scroll-snap-align: start;
    padding: var(--sb-6);
    background: var(--sb-ivory);
    border: var(--sb-rule);
    border-radius: var(--sb-r-0);
  }

  /* The flourish, clipped by the card's overflow. */
  .pfb__cshape {
    position: absolute;
    right: -14%;
    bottom: -12%;
    z-index: 0;
    width: 58%;
    aspect-ratio: 355 / 552;
    background: var(--sb-violet);
    opacity: 0.14;
    pointer-events: none;
    /* The drawing occupies only x 956–1310 of a 1429-wide canvas, so it has to
       be scaled and offset to land inside the box — 403%/89% is that
       arithmetic, not a preference. */
    -webkit-mask: url('../../../assets/icons/shape-2.png') no-repeat 89% center / 403% auto;
    mask: url('../../../assets/icons/shape-2.png') no-repeat 89% center / 403% auto;
  }

  /* ⚠ THE CONTENT RIDES ABOVE THE FLOURISH. Without this the mask paints over
     the text — it is a positioned sibling with z-index 0, which beats static
     in-flow content. */
  .pfb__cin {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    width: 100%;
    min-width: 0;
  }

  /* ── Voices card contents ────────────────────────────────────────────── */
  .pfb__quotemark {
    font-family: var(--sb-font-serif);
    font-size: 44px;
    line-height: 0.6;
    color: var(--sb-violet);
    opacity: 0.5;
  }
  .pfb__quote { flex: 1; margin: var(--sb-4) 0 var(--sb-5); }
  .pfb__quote p {
    margin: 0;
    font-size: clamp(14px, 0.4vw + 12px, 16px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
    text-wrap: pretty;
  }
  .pfb__by {
    display: flex;
    align-items: center;
    gap: 11px;
    padding-top: var(--sb-4);
    border-top: var(--sb-rule);
  }
  .pfb__byicon {
    display: grid;
    place-items: center;
    width: 38px;
    height: 38px;
    flex: 0 0 auto;
    border-radius: var(--sb-r-full);
    background: color-mix(in srgb, var(--sb-orange-bright) 12%, transparent);
    color: var(--sb-violet);
  }
  .pfb__byicon svg { width: 19px; height: 19px; }
  .pfb__byname { display: flex; flex-direction: column; min-width: 0; }
  .pfb__byname strong { font-size: 14px; color: var(--sb-charcoal); }
  .pfb__byname span { font-size: 12px; color: var(--sb-text-muted); }
  .pfb__src { font-style: italic; }

  /* ── Participation card contents ─────────────────────────────────────── */
  .pfb__n {
    display: block;
    margin-bottom: clamp(10px, 1.2vw, 16px);
    font-family: var(--sb-font-display);
    font-size: clamp(11px, 0.2vw + 9px, 12.5px);
    font-weight: 700;
    letter-spacing: 0.14em;
    color: var(--sb-violet);
  }
  .pfb__t {
    margin: 0 0 clamp(8px, 1vw, 13px);
    font-family: var(--sb-font-display);
    font-size: clamp(16px, 0.5vw + 12px, 21px);
    font-weight: 700;
    letter-spacing: -0.012em;
    color: var(--sb-charcoal);
  }
  .pfb__p {
    margin: 0 0 clamp(7px, 0.9vw, 11px);
    font-size: clamp(13px, 0.25vw + 11px, 15px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }
  .pfb__p:last-of-type { margin-bottom: 0; }

  /* ── Dots ─────────────────────────────────────────────────────────────────
     ⚠⚠ Built in JS, so they carry no data-astro-cid — every rule hangs off the
     template-rendered parent or it matches nothing. */
  .pfb__dots {
    display: flex;
    justify-content: center;
    gap: 7px;
    margin-top: var(--sb-5);
    min-height: 8px;
  }
  .pfb__dots :global(.pfb__dot) {
    width: 8px;
    height: 8px;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: color-mix(in srgb, var(--sb-charcoal) 18%, transparent);
    cursor: pointer;
    transition: width 220ms var(--sb-ease), background 220ms var(--sb-ease);
  }
  .pfb__dots :global(.pfb__dot[aria-selected='true']) {
    width: 22px;
    background: var(--sb-violet);
  }

  /* ── Closing ─────────────────────────────────────────────────────────── */
  .pfb__closecard {
    position: relative;
    overflow: hidden;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: clamp(16px, 2.2vw, 34px);
    padding: clamp(20px, 2.6vw, 34px) clamp(20px, 2.8vw, 40px);
    border-radius: var(--sb-r-0);
    border: var(--sb-rule);
    background: color-mix(in srgb, var(--sb-orange-bright) 9%, var(--sb-paper));
  }
  .pfb__closeicon {
    display: grid;
    place-items: center;
    width: clamp(52px, 5vw, 68px);
    aspect-ratio: 1;
    border-radius: var(--sb-r-full);
    background: var(--sb-paper);
    color: var(--sb-violet);
  }
  .pfb__closeicon svg { width: 52%; height: auto; }
  .pfb__closecopy { position: relative; z-index: 1; min-width: 0; }
  .pfb__h--close { font-size: clamp(19px, 0.9vw + 13px, 30px); }
  .pfb__closebody {
    max-width: 46ch;
    margin: clamp(6px, 0.8vw, 10px) 0 0;
    font-size: clamp(12.5px, 0.25vw + 10px, 14.5px);
    line-height: 1.62;
    color: var(--sb-text-secondary);
  }
  .pfb__closecta {
    position: relative;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    white-space: nowrap;
  }
  .pfb__closecta svg { width: 15px; height: auto; transition: transform 200ms var(--sb-ease); }
  .pfb__closecta:hover svg { transform: translateX(3px); }
  .pfb__closeicon { position: relative; z-index: 1; }

  .pfb__leaf {
    position: absolute;
    right: -14px;
    bottom: -26px;
    z-index: 0;
    width: clamp(150px, 17vw, 230px);
    height: auto;
    opacity: 0.5;
    transform: scaleX(-1);
    pointer-events: none;
  }

  @media (max-width: 767px) {
    .pfb__closecard { grid-template-columns: minmax(0, 1fr); justify-items: start; }
    .pfb__closecta { width: 100%; justify-content: center; }
    .pfb__leaf { top: -26px; right: -18px; bottom: auto; width: clamp(128px, 34vw, 168px); opacity: 0.32; transform: scaleX(-1) rotate(-72deg); }
  }

  /* ══ FORM BAND ═══════════════════════════════════════════════════════════
     ⚠⚠ `isolation: isolate` IS LOAD-BEARING. Every decoration below sits at
     z-index -1; without a stacking context here they would paint behind this
     band's own background and vanish. `overflow: hidden` clips them to the band
     so nothing widens the page. */
  .pfb__formband {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(44px, 5vw, 86px);
    background:
      radial-gradient(1100px 420px at 12% 0%, color-mix(in srgb, var(--sb-orange-bright) 9%, transparent), transparent 70%),
      radial-gradient(900px 420px at 92% 6%, rgba(120, 165, 220, 0.16), transparent 68%),
      var(--sb-ivory);
  }

  .pfb__formband > .u-container { position: relative; z-index: 1; }

  /* ── Decoration ─────────────────────────────────────────────────────────
     All of it inert, behind the content, and hidden below 1200px where the
     container reaches the viewport edge and a corner piece is no longer in a
     corner. */
  .pfb-d { position: absolute; z-index: -1; pointer-events: none; }

  .pfb-d__blob { border-radius: 50%; filter: blur(10px); }
  .pfb-d__blob--tl {
    top: -70px; left: -90px; width: 360px; aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--sb-orange-bright) 26%, transparent) 0%, transparent 68%);
  }
  .pfb-d__blob--tr {
    top: -60px; right: -60px; width: 340px; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(126, 168, 222, 0.28) 0%, transparent 68%);
  }
  .pfb-d__blob--bl {
    bottom: -90px; left: -40px; width: 320px; aspect-ratio: 1;
    background: radial-gradient(circle, color-mix(in srgb, var(--sb-orange-bright) 20%, transparent) 0%, transparent 70%);
  }
  .pfb-d__blob--br {
    bottom: -70px; right: 6%; width: 300px; aspect-ratio: 1;
    background: radial-gradient(circle, rgba(126, 168, 222, 0.22) 0%, transparent 70%);
  }

  /* The client's leaf, painted (it carries its own peach) and flipped so it
     grows in from the corner rather than off the edge. */
  .pfb-d__leaf {
    right: -26px; bottom: -34px; width: 230px; aspect-ratio: 1;
    background: url('../../../assets/icons/leaf-remove.png') no-repeat center / contain;
    opacity: 0.55;
    transform: scaleX(-1);
  }

  .pfb-d__trail { color: color-mix(in srgb, var(--sb-orange-bright) 52%, transparent); }
  .pfb-d__trail--l { top: 8%; left: -40px; width: 420px; height: 200px; }

  .pfb-d__star { color: rgba(126, 168, 222, 0.55); width: 34px; height: 34px; }
  .pfb-d__star--a { top: 12%; left: 4%; width: 26px; height: 26px; color: color-mix(in srgb, var(--sb-orange-bright) 45%, transparent); }
  .pfb-d__star--b { top: 22%; right: 3%; }
  .pfb-d__star--c { bottom: 16%; left: 5%; }

  /* ── Script flourish ────────────────────────────────────────────────────
     Caveat is already self-hosted for the homepage reviews band. */
  /* ⚠ FAR ENOUGH DOWN TO CLEAR THE BAND'S TOP EDGE. At a small offset the
     words and the plane are sliced by `overflow: hidden` on the band, which
     reads as a rendering fault rather than as decoration. */
  .pfb-fl {
    position: absolute;
    top: clamp(84px, 10vh, 132px);
    right: clamp(24px, 3vw, 72px);
    z-index: 0;
    display: flex;
    align-items: flex-start;
    gap: clamp(4px, 1vw, 14px);
    pointer-events: none;
  }
  .pfb-fl__words {
    margin: 0;
    display: flex;
    flex-direction: column;
    font-family: 'Caveat Variable', var(--sb-font-serif), cursive;
    font-size: clamp(19px, 1.5vw, 26px);
    font-weight: 600;
    line-height: 1.12;
    color: var(--sb-charcoal);
    transform: rotate(-5deg);
  }
  /* ⚠ THE UNDERLINE IS A BORDER ON THE LAST LINE, not a fixed SVG path — the
     word's width changes with the viewport and a drawn path fits one size. */
  .pfb-fl__line--last {
    align-self: flex-start;
    padding-bottom: 2px;
    border-bottom: 2px solid var(--sb-orange-bright);
    border-radius: 2px;
  }
  .pfb-fl__plane {
    width: clamp(64px, 6vw, 96px);
    aspect-ratio: 851 / 682;
    background: var(--sb-orange-bright);
    /* Masked, not painted: the asset is dark navy line-art and would read as a
       bruise on this cream. */
    -webkit-mask: url('../../../assets/icons/rocketpaper.png') no-repeat center / contain;
    mask: url('../../../assets/icons/rocketpaper.png') no-repeat center / contain;
    /* ⚠ NO FLIP. rocketpaper.png already points up and to the right with its
       loop trailing below-left, which is the comp's orientation — a scaleY(-1)
       turns it into a plane diving into the corner. */
    transform: rotate(-4deg);
    opacity: 0.9;
  }

  @media (max-width: 1199px) {
    .pfb-d,
    .pfb-fl { display: none; }
  }

  /* ── Head ───────────────────────────────────────────────────────────────── */
  .pfb-form__eyebrow {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
  }
  .pfb-form__rule {
    width: clamp(22px, 4vw, 46px);
    height: 1.5px;
    background: color-mix(in srgb, var(--sb-violet) 55%, transparent);
  }
  .pfb-form__h {
    margin: var(--sb-4) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(30px, 3.4vw, 50px);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.028em;
    color: var(--sb-ink);
    text-wrap: balance;
  }
  /* ⚠⚠ A CLASS, NEVER A BARE `span`. `data-split` is the site's GSAP line
     reveal, and it wraps the heading's own words in spans at runtime — so
     `:global(span)` matched every one of them and painted the whole heading
     orange instead of just "Matters". */
  .pfb-form__h :global(.pfb-form__mark) { font-style: normal; color: var(--sb-violet); }

  /* ── Two columns ─────────────────────────────────────────────────────────
     ⚠ THE BENEFITS COLUMN IS FIXED-ISH AND THE FORM TAKES THE REST. A 1fr 1fr
     split gives the form half the width, and its own two-column field grid then
     has about 190px a field. */
  .pfb-form__cols {
    display: grid;
    grid-template-columns: minmax(230px, 300px) minmax(0, 1fr);
    gap: clamp(24px, 4vw, 66px);
    align-items: start;
    margin-top: clamp(26px, 3.4vw, 46px);
  }
  @media (max-width: 1023px) {
    .pfb-form__cols { grid-template-columns: minmax(0, 1fr); }
  }

  .pfb-form__benefits {
    display: flex;
    flex-direction: column;
    gap: clamp(18px, 2.2vw, 30px);
    margin: clamp(6px, 2vw, 26px) 0 0;
    padding: 0;
    list-style: none;
  }
  @media (max-width: 1023px) {
    .pfb-form__benefits {
      flex-direction: row;
      flex-wrap: wrap;
      margin-top: 0;
    }
    /* ⚠ RESET THE BASIS WHEN THE DIRECTION FLIPS. A basis set for a column
       becomes a height in a row and each item grows to it. */
    .pfb-form__ben { flex: 1 1 250px; }
  }

  .pfb-form__ben { display: flex; align-items: flex-start; gap: 13px; }
  .pfb-form__benicon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    flex: 0 0 auto;
    border-radius: var(--sb-r-full);
    background: var(--sb-lime-wash);
    color: var(--sb-violet);
  }
  .pfb-form__benicon svg { width: 19px; height: 19px; }
  .pfb-form__bentext { display: flex; flex-direction: column; gap: 3px; min-width: 0; }
  .pfb-form__bentext strong {
    font-family: var(--sb-font-display);
    font-size: 15px;
    font-weight: 700;
    color: var(--sb-violet);
  }
  .pfb-form__bentext span {
    font-size: 13px;
    line-height: 1.55;
    color: var(--sb-text-secondary);
  }

  /* ── The card ───────────────────────────────────────────────────────────── */
  .pfb__formcard {
    padding: clamp(22px, 2.6vw, 38px);
    border: 1px solid rgba(18, 16, 15, 0.06);
    border-radius: 20px;
    background: var(--sb-paper);
    box-shadow: 0 30px 60px -44px rgba(28, 14, 8, 0.4);
  }

  @media (prefers-reduced-motion: reduce) {
    .pfb__arrow,
    .pfb__closecta svg,
    .pfb__dots :global(.pfb__dot) { transition: none; }
  }
</style>

<script>
  /**
   * Both rails, one routine.
   *
   * ⚠⚠ AUTOPLAY ONLY WHEN THE RAIL ACTUALLY OVERFLOWS, and it stops on hover,
   * on keyboard focus, and permanently on a deliberate touch. Reduced motion
   * cancels the timer outright rather than speeding it up. WCAG 2.2.2.
   *
   * ⚠ KNOWN GAP, CLIENT'S DECISION: there is no always-visible pause button.
   * One existed; the client asked for it to be removed. Hover, focus and
   * reduced-motion cover pointer, keyboard and motion-sensitive users — but
   * they are not a substitute for a visible control. If an audit flags it,
   * restore the button rather than arguing the coverage.
   *
   * ⚠ OVERFLOW IS MEASURED, NEVER COUNTED. Five participation cards overflow at
   * two-up; three testimonials do too; two would not. Nothing here counts cards.
   */
  function wire(rail: HTMLElement, dots: HTMLElement, prev: HTMLElement | null, next: HTMLElement | null) {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const behavior: ScrollBehavior = reduce ? 'auto' : 'smooth';
    const DWELL = 5000;

    const maxScroll = () => rail.scrollWidth - rail.clientWidth;
    const overflows = () => maxScroll() > 4;
    const pages = () => Math.max(1, Math.ceil(rail.scrollWidth / rail.clientWidth));

    let held = false;
    let timer: number | undefined;

    function paint() {
      const max = maxScroll();
      const n = dots.children.length;
      if (!n) return;
      const ratio = max > 0 ? rail.scrollLeft / max : 0;
      const i = Math.min(n - 1, Math.max(0, Math.round(ratio * (n - 1))));
      for (let k = 0; k < n; k++) {
        (dots.children[k] as HTMLElement).setAttribute('aria-selected', String(k === i));
      }
    }

    function build() {
      const on = overflows();
      prev?.toggleAttribute('hidden', !on);
      next?.toggleAttribute('hidden', !on);
      dots.replaceChildren();
      if (!on) return;

      const n = pages();
      for (let i = 0; i < n; i++) {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = 'pfb__dot';
        b.setAttribute('role', 'tab');
        b.setAttribute('aria-selected', String(i === 0));
        b.setAttribute('aria-label', `Page ${i + 1} of ${n}`);
        b.addEventListener('click', () => {
          rail.scrollTo({ left: Math.min(i * rail.clientWidth, maxScroll()), behavior });
        });
        dots.appendChild(b);
      }
      paint();
    }

    function tick() {
      if (held || !overflows()) return;
      const atEnd = rail.scrollLeft >= maxScroll() - 4;
      rail.scrollTo({ left: atEnd ? 0 : rail.scrollLeft + rail.clientWidth, behavior });
    }

    if (!reduce) window.setInterval(tick, DWELL);

    const frame = rail.closest('.pfb__frame') ?? rail;
    frame.addEventListener('mouseenter', () => { held = true; });
    frame.addEventListener('mouseleave', () => { held = false; });
    frame.addEventListener('focusin', () => { held = true; });
    frame.addEventListener('focusout', () => { held = false; });
    /* A deliberate touch stops it for good — a reader who has taken hold of the
       rail should not have it moved under them again. */
    rail.addEventListener('pointerdown', () => { held = true; });

    prev?.addEventListener('click', () => rail.scrollBy({ left: -rail.clientWidth, behavior }));
    next?.addEventListener('click', () => rail.scrollBy({ left: rail.clientWidth, behavior }));
    rail.addEventListener('scroll', paint, { passive: true });

    build();
    new ResizeObserver(build).observe(rail);
  }

  const pairs: [string, string, string, string][] = [
    ['[data-v-rail]', '[data-v-dots]', '[data-v-prev]', '[data-v-next]'],
    ['[data-p-rail]', '[data-p-dots]', '[data-p-prev]', '[data-p-next]'],
  ];
  for (const [r, d, p, n] of pairs) {
    const rail = document.querySelector<HTMLElement>(r);
    const dots = document.querySelector<HTMLElement>(d);
    if (rail && dots) {
      wire(rail, dots, document.querySelector<HTMLElement>(p), document.querySelector<HTMLElement>(n));
    }
  }
</script>
