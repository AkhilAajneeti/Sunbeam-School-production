---
/**
 * THE STAFF TABLE — 131 filed rows, searchable, filterable and paged.
 *
 * ⚠ EVERY ROW IS RENDERED ON THE SERVER. Search, filter and pagination only
 * toggle `hidden` on rows that are already in the DOM. That matters for three
 * reasons on a disclosure page: the full filing is in the HTML for anyone who
 * reads source or prints the page, a search engine indexes all 131 names, and
 * the table still works with JavaScript off — it simply shows every row.
 *
 * ⚠ THE COUNTS ARE COMPUTED, NEVER TYPED. "Showing 1 to 12 of 131" reads the
 * live filtered set, and the designation options come from the data. Adding
 * staff to disclosure.ts changes every number here with no edit.
 *
 * ⚠ NO EMPTY-STATE GUESSWORK. A search that matches nothing says so and offers
 * a reset, rather than leaving a blank table that reads as a broken page.
 */
import { MARK } from '../academics/assessment/marks';
import { designationsOf } from '../../lib/cms';
import type { Teacher } from '../../lib/cms';

interface Props {
  /** ⚠ PASSED IN, NOT FETCHED. The page already holds the list; fetching it a
      second time here would be a second round trip for the same 131 rows. */
  teachers: Teacher[];
  /** Rows per page. */
  per?: number;
  id: string;
}

const { per = 12, id, teachers } = Astro.props;

/* ⚠ DERIVED, NEVER A TYPED LIST — the filter can only ever offer a designation
   the table can actually show. */
const designations = designationsOf(teachers);

/**
 * ⚠ THE FILTER SHOWS ITS OWN ARITHMETIC. "PGT (24)" tells a reader how many rows
 * a choice will leave before they make it, and it is counted from the data — so
 * it can never disagree with the table under it.
 */
const counts = new Map<string, number>();
teachers.forEach((t) => counts.set(t.designation, (counts.get(t.designation) ?? 0) + 1));
---

<div class="mp-staff" data-staff data-per={per}>
  <div class="mp-staff__tools">
    <label class="mp-staff__search">
      <span class="u-visually-hidden">Search staff by name</span>
      <span class="mp-staff__searchm" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.search} />
        </svg>
      </span>
      <input type="search" placeholder="Search by name…" data-staff-q autocomplete="off" spellcheck="false" />
    </label>

    <label class="mp-staff__filter">
      <span class="u-visually-hidden">Filter by designation</span>
      <select data-staff-d>
        {designations.map((d, i) => (
          <option value={i === 0 ? '' : d}>{i === 0 ? `${d} (${teachers.length})` : `${d} (${counts.get(d) ?? 0})`}</option>
        ))}
      </select>
      <span class="mp-staff__chev" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </span>
    </label>
  </div>

  <div class="mp-staff__scroll">
    <table class="mp-tab" id={id} role="table">
      <caption class="u-visually-hidden">
        Teaching and support staff of Sunbeam School Ballia, as filed in the school's Mandatory
        Public Disclosure — name, designation and qualification.
      </caption>
      <thead role="rowgroup">
        {/* ⚠ EVERY HEADER IS A BUTTON INSIDE THE CELL, not a click handler on
            the cell. A bare <th> with onclick is unreachable by keyboard and
            announces nothing; the button carries the label and the <th> carries
            aria-sort, which is what a screen reader reports. */}
        <tr role="row">
          {[
            { key: 'n', label: '#', cls: 'mp-tab__num' },
            { key: 'name', label: 'Name', cls: '' },
            { key: 'desig', label: 'Designation', cls: '' },
            { key: 'qual', label: 'Qualification', cls: '' },
          ].map((c) => (
            <th scope="col" class={c.cls} aria-sort={c.key === 'n' ? 'ascending' : 'none'} data-sort-col={c.key}>
              <button type="button" class="mp-tab__sort" data-sort-btn={c.key}>
                <span>{c.label}</span>
                <span class="mp-tab__arrows" aria-hidden="true">
                  <svg viewBox="0 0 12 16" fill="none"><path d="m3 6 3-3 3 3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/><path d="m3 10 3 3 3-3" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
                </span>
              </button>
            </th>
          ))}
        </tr>
      </thead>
      <tbody data-staff-body role="rowgroup">
        {teachers.map((t) => (
          <tr role="row" data-name={t.name.toLowerCase()} data-desig={t.designation}>
            <td role="cell" class="mp-tab__num t-tabular" data-label="No.">{String(t.n).padStart(3, '0')}</td>
            <th role="rowheader" scope="row" class="mp-tab__name" data-label="Name" data-raw={t.name}>{t.name}</th>
            <td role="cell" data-label="Designation"><span class="mp-tag">{t.designation}</span></td>
            <td role="cell" class="mp-tab__qual" data-label="Qualification">{t.qualification}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <p class="mp-staff__none" data-staff-none hidden>
      No member of staff matches that search.
      <button type="button" class="mp-staff__reset" data-staff-reset>Clear the filters</button>
    </p>
  </div>

  <div class="mp-staff__foot">
    <div class="mp-staff__left">
      <p class="mp-staff__count" aria-live="polite" data-staff-count>
        Showing all {teachers.length} entries
      </p>
      <label class="mp-staff__per">
        <span>Rows</span>
        <select data-staff-per>
          {[12, 24, 50].map((v) => <option value={v} selected={v === per}>{v}</option>)}
          <option value="0">All</option>
        </select>
      </label>
    </div>
    <nav class="mp-pag" aria-label="Staff table pages" data-staff-pages hidden></nav>
  </div>
</div>

<script>
  /* Each staff table on the page wires itself. */
  document.querySelectorAll<HTMLElement>('[data-staff]').forEach((root) => {
    const per = Number(root.dataset.per) || 12;
    const q = root.querySelector<HTMLInputElement>('[data-staff-q]');
    const d = root.querySelector<HTMLSelectElement>('[data-staff-d]');
    const body = root.querySelector<HTMLTableSectionElement>('[data-staff-body]');
    const none = root.querySelector<HTMLElement>('[data-staff-none]');
    const count = root.querySelector<HTMLElement>('[data-staff-count]');
    const pages = root.querySelector<HTMLElement>('[data-staff-pages]');
    const reset = root.querySelector<HTMLButtonElement>('[data-staff-reset]');
    if (!body) return;

    const perSel = root.querySelector<HTMLSelectElement>('[data-staff-per]');
    const rows: HTMLTableRowElement[] = Array.from(body.rows);
    let page = 1;
    let size = per;

    /* Sorting state. `n` ascending is the filing's own order, which is the
       correct thing to return to — hence a third click clears the sort. */
    let sortKey = 'n';
    let sortDir = 1;

    /** What each column sorts on. Numbers compare as numbers, not as text. */
    const value = (r: HTMLTableRowElement, key: string): string | number => {
      if (key === 'n') return Number(r.cells[0]?.textContent ?? 0);
      if (key === 'name') return (r.dataset.name ?? '');
      if (key === 'desig') return (r.dataset.desig ?? '');
      return (r.cells[3]?.textContent ?? '').toLowerCase();
    };

    /** Rows surviving the search box and the designation select. */
    const matching = () => {
      const term = (q?.value ?? '').trim().toLowerCase();
      const desig = d?.value ?? '';
      return rows.filter(
        (r) =>
          (!term || (r.dataset.name ?? '').includes(term)) &&
          (!desig || r.dataset.desig === desig),
      );
    };

    /* ⚠ THE SEARCH TERM IS MARKED IN THE NAME, and the cell's untouched text is
       kept in `data-raw` so clearing the box restores it exactly. Rebuilding the
       name from the highlighted DOM would compound every previous pass. */
    const highlight = () => {
      const term = (q?.value ?? '').trim();
      rows.forEach((r) => {
        const cell = r.cells[1] as HTMLElement | undefined;
        const raw = cell?.dataset.raw;
        if (!cell || raw === undefined) return;
        if (!term) { cell.textContent = raw; return; }
        const at = raw.toLowerCase().indexOf(term.toLowerCase());
        if (at === -1) { cell.textContent = raw; return; }
        cell.textContent = '';
        cell.append(
          raw.slice(0, at),
          Object.assign(document.createElement('mark'), { textContent: raw.slice(at, at + term.length) }),
          raw.slice(at + term.length),
        );
      });
    };

    /** Reorder the tbody. Called only when the sort actually changes. */
    const applySort = () => {
      const sorted = [...rows].sort((a, b) => {
        const x = value(a, sortKey);
        const y = value(b, sortKey);
        if (x < y) return -1 * sortDir;
        if (x > y) return 1 * sortDir;
        /* Ties fall back to the filing's own order, so a sort is stable and
           repeatable rather than dependent on the engine. */
        return Number(a.cells[0]?.textContent ?? 0) - Number(b.cells[0]?.textContent ?? 0);
      });
      sorted.forEach((r) => body.appendChild(r));
      root.querySelectorAll<HTMLElement>('[data-sort-col]').forEach((th) => {
        const on = th.dataset.sortCol === sortKey;
        th.setAttribute('aria-sort', on ? (sortDir === 1 ? 'ascending' : 'descending') : 'none');
        th.classList.toggle('is-asc', on && sortDir === 1);
        th.classList.toggle('is-desc', on && sortDir === -1);
      });
    };

    const paint = () => {
      highlight();
      const hits = matching();
      const total = hits.length;
      /* `size` of 0 is the "All" option — one page holding everything. */
      const step = size > 0 ? size : Math.max(total, 1);
      const last = Math.max(1, Math.ceil(total / step));
      if (page > last) page = last;

      const from = (page - 1) * step;
      const to = Math.min(from + step, total);
      const shown = new Set(hits.slice(from, to));
      rows.forEach((r) => r.toggleAttribute('hidden', !shown.has(r)));

      if (none) none.hidden = total > 0;
      if (count) {
        count.textContent = total === 0
          ? 'No entries match'
          : total <= step
            ? `Showing all ${total} ${total === 1 ? 'entry' : 'entries'}`
            : `Showing ${from + 1} to ${to} of ${total} entries`;
      }

      if (!pages) return;
      pages.hidden = last <= 1;
      if (last <= 1) { pages.replaceChildren(); return; }

      /* First, last, and a window around the current page — with an ellipsis
         standing in for whatever the window skips. 131 rows is eleven pages,
         and eleven buttons is a paragraph of numbers. */
      const want = new Set([1, last, page, page - 1, page + 1]);
      const nums = [...want].filter((n) => n >= 1 && n <= last).sort((a, b) => a - b);

      const frag = document.createDocumentFragment();
      const btn = (label: string, target: number, cls: string, disabled = false) => {
        const b = document.createElement('button');
        b.type = 'button';
        b.className = cls;
        b.textContent = label;
        b.disabled = disabled;
        if (cls.includes('is-on')) b.setAttribute('aria-current', 'page');
        b.addEventListener('click', () => { page = target; paint(); root.scrollIntoView({ block: 'start', behavior: 'smooth' }); });
        b.setAttribute('aria-label', label === '→' ? 'Next page' : 'Page ' + label);
        return b;
      };

      nums.forEach((n, i) => {
        if (i > 0 && n - nums[i - 1] > 1) {
          const gap = document.createElement('span');
          gap.className = 'mp-pag__gap';
          gap.textContent = '…';
          gap.setAttribute('aria-hidden', 'true');
          frag.appendChild(gap);
        }
        frag.appendChild(btn(String(n), n, 'mp-pag__b' + (n === page ? ' is-on' : '')));
      });
      frag.appendChild(btn('→', Math.min(page + 1, last), 'mp-pag__b mp-pag__b--next', page === last));
      pages.replaceChildren(frag);
    };

    /* A new search or filter always returns to page one — otherwise a reader on
       page 9 types a name and lands on an empty page 9 of two. */
    const restart = () => { page = 1; paint(); };
    q?.addEventListener('input', restart);
    d?.addEventListener('change', restart);

    /* Escape clears the box from inside it, which is what a search input is
       expected to do and what the UA clear button does on the browsers that
       draw one. */
    q?.addEventListener('keydown', (e) => {
      if (e.key !== 'Escape' || !q.value) return;
      q.value = '';
      restart();
    });

    perSel?.addEventListener('change', () => {
      size = Number(perSel.value);
      restart();
    });

    /* ⚠ A THIRD CLICK RESTORES THE FILING'S OWN ORDER. Ascending, descending,
       then off — because the order the school filed these in is information too,
       and a table that can never get back to it has lost something. */
    root.querySelectorAll<HTMLButtonElement>('[data-sort-btn]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.sortBtn ?? 'n';
        if (sortKey !== key) { sortKey = key; sortDir = 1; }
        else if (sortDir === 1) { sortDir = -1; }
        else { sortKey = 'n'; sortDir = 1; }
        applySort();
        page = 1;
        paint();
      });
    });
    reset?.addEventListener('click', () => {
      if (q) q.value = '';
      if (d) d.value = '';
      restart();
      q?.focus();
    });

    paint();
  });
</script>

<style>
  .mp-staff { display: grid; }

  .mp-staff__tools {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.5fr);
    gap: clamp(8px, 1vw, 14px);
    margin: 0 0 clamp(12px, 1.5vw, 18px);
  }

  .mp-staff__search { position: relative; display: block; }
  .mp-staff__searchm {
    position: absolute;
    top: 50%;
    left: clamp(10px, 1.1vw, 14px);
    translate: 0 -50%;
    display: block;
    width: clamp(14px, 1.2vw, 17px);
    color: var(--sb-text-muted);
    pointer-events: none;
  }
  .mp-staff__searchm svg { display: block; width: 100%; height: auto; }
  .mp-staff__search input {
    width: 100%;
    padding: clamp(9px, 1vw, 12px) clamp(12px, 1.4vw, 16px) clamp(9px, 1vw, 12px) clamp(30px, 3vw, 40px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    color: var(--sb-charcoal);
  }
  .mp-staff__search input::placeholder { color: var(--sb-text-muted); }
  .mp-staff__search input:focus-visible {
    outline: none;
    border-color: var(--sb-orange-bright);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sb-orange-bright) 18%, transparent);
  }
  /* The UA clear button is a different grey in every browser. */
  .mp-staff__search input::-webkit-search-cancel-button { filter: grayscale(1) opacity(0.5); }

  .mp-staff__filter { position: relative; display: block; }
  .mp-staff__filter select {
    width: 100%;
    padding: clamp(9px, 1vw, 12px) clamp(30px, 3vw, 38px) clamp(9px, 1vw, 12px) clamp(12px, 1.4vw, 16px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    color: var(--sb-charcoal);
    appearance: none;
    cursor: pointer;
  }
  .mp-staff__filter select:focus-visible {
    outline: none;
    border-color: var(--sb-orange-bright);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sb-orange-bright) 18%, transparent);
  }
  .mp-staff__chev {
    position: absolute;
    top: 50%;
    right: clamp(11px, 1.2vw, 15px);
    translate: 0 -50%;
    display: block;
    width: clamp(13px, 1.1vw, 16px);
    color: var(--sb-text-muted);
    pointer-events: none;
  }
  .mp-staff__chev svg { display: block; width: 100%; height: auto; }

  /* ⚠ NO overflow HERE, DELIBERATELY. It used to carry `overflow-x: auto`, which
     computes `overflow-y` to auto as well and makes this box — not the viewport
     — the sticky header's containing scroller. The box never scrolls
     vertically, so the header never stuck to anything and the rule was inert.
     The table fits from 640px up and becomes cards below it, so the scroller was
     never earning its keep either. */
  .mp-staff__scroll {
    position: relative;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
  }

  .mp-tab { width: 100%; min-width: 540px; border-collapse: collapse; text-align: left; }
  /* Offset by the condensed masthead, which is what is overhead once the reader
     has scrolled far enough for a sticky header to matter. */
  .mp-tab thead th {
    position: sticky;
    top: var(--sb-masthead-h-condensed, 68px);
    z-index: 2;
    padding: clamp(10px, 1.1vw, 14px) clamp(11px, 1.2vw, 16px);
    border-bottom: 1px solid var(--sb-border);
    background: var(--sb-sand);
    font-size: clamp(9px, 0.68vw, 10.6px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--sb-text-secondary);
  }
  .mp-tab tbody tr + tr { border-top: 1px solid var(--sb-border); }
  .mp-tab tbody tr:hover { background: color-mix(in srgb, var(--sb-violet-wash) 55%, transparent); }
  .mp-tab td,
  .mp-tab tbody th {
    padding: clamp(9px, 1vw, 13px) clamp(11px, 1.2vw, 16px);
    font-size: clamp(10px, 0.76vw, 12.2px);
    line-height: 1.45;
    vertical-align: middle;
  }
  .mp-tab__num { width: 1%; white-space: nowrap; color: var(--sb-text-muted); }
  .mp-tab__name { font-weight: 700; color: var(--sb-charcoal); }
  .mp-tab__qual { color: var(--sb-text-muted); }

  .mp-tag {
    display: inline-block;
    padding: 3px clamp(7px, 0.8vw, 10px);
    border-radius: var(--sb-r-1);
    background: var(--sb-violet-wash);
    font-size: clamp(8.5px, 0.62vw, 10px);
    font-weight: 700;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: var(--sb-violet);
  }

  .mp-staff__none {
    margin: 0;
    padding: clamp(26px, 3.4vw, 44px) clamp(16px, 2vw, 24px);
    text-align: center;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    color: var(--sb-text-muted);
  }
  .mp-staff__reset {
    margin-left: 8px;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    font-weight: 700;
    color: var(--sb-orange-bright);
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  /* ═══ SORTABLE HEADERS ══════════════════════════════════════════════════ */
  .mp-tab thead th { padding: 0; }
  .mp-tab__sort {
    display: flex;
    align-items: center;
    gap: 6px;
    width: 100%;
    padding: clamp(10px, 1.1vw, 14px) clamp(11px, 1.2vw, 16px);
    border: 0;
    background: none;
    font: inherit;
    font-size: clamp(9px, 0.68vw, 10.6px);
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    text-align: left;
    color: var(--sb-text-secondary);
    cursor: pointer;
    transition: color var(--sb-dur-image) var(--sb-ease);
  }
  .mp-tab__sort:hover { color: var(--sb-orange-bright); }
  .mp-tab__sort:focus-visible {
    outline: 2px solid var(--sb-orange-bright);
    outline-offset: -2px;
  }
  /* Both chevrons dim until the column is the sorted one, then the live half
     lights — so the control reads as sortable before it is used. */
  .mp-tab__arrows { display: block; width: 9px; color: var(--sb-border-strong); flex: 0 0 auto; }
  .mp-tab__arrows svg { display: block; width: 100%; height: auto; }
  .mp-tab thead th.is-asc .mp-tab__arrows path:first-child,
  .mp-tab thead th.is-desc .mp-tab__arrows path:last-child { color: var(--sb-orange-bright); stroke: currentColor; }
  .mp-tab thead th.is-asc .mp-tab__arrows,
  .mp-tab thead th.is-desc .mp-tab__arrows { color: var(--sb-orange-bright); }
  .mp-tab thead th.is-asc .mp-tab__arrows path:last-child,
  .mp-tab thead th.is-desc .mp-tab__arrows path:first-child { opacity: 0.28; }
  .mp-tab thead th.is-asc .mp-tab__sort,
  .mp-tab thead th.is-desc .mp-tab__sort { color: var(--sb-charcoal); }

  /* ═══ THE SEARCH MATCH ══════════════════════════════════════════════════ */
  .mp-tab__name :global(mark) {
    padding: 0 2px;
    border-radius: 3px;
    background: color-mix(in srgb, var(--sb-orange-bright) 26%, transparent);
    color: inherit;
  }

  .mp-staff__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(10px, 1.2vw, 16px);
    margin: clamp(11px, 1.3vw, 16px) 0 0;
  }
  .mp-staff__left { display: flex; align-items: center; gap: clamp(10px, 1.4vw, 18px); }
  .mp-staff__count { margin: 0; font-size: clamp(9.5px, 0.7vw, 11.2px); color: var(--sb-text-muted); }
  .mp-staff__per { display: inline-flex; align-items: center; gap: 6px; font-size: clamp(9.5px, 0.7vw, 11.2px); color: var(--sb-text-muted); }
  .mp-staff__per select {
    padding: 4px 6px;
    border: 1px solid var(--sb-border);
    border-radius: 7px;
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(9.5px, 0.7vw, 11.2px);
    font-weight: 700;
    color: var(--sb-text-secondary);
    cursor: pointer;
  }
  .mp-staff__per select:focus-visible { outline: none; border-color: var(--sb-orange-bright); }

  /* ⚠⚠ :global() IS LOAD-BEARING ON EVERY RULE BELOW. Astro scopes CSS by
     stamping a data-astro-cid attribute onto elements at BUILD time; these
     buttons are built at RUNTIME by document.createElement and never receive it,
     so the scoped selectors matched nothing and the pagination rendered as bare
     unstyled numerals. Anything this component creates in script must be styled
     globally or it silently loses its CSS. */
  .mp-pag { display: flex; align-items: center; gap: 5px; }
  .mp-pag :global(.mp-pag__b) {
    display: grid;
    place-items: center;
    min-width: clamp(26px, 2.4vw, 32px);
    height: clamp(26px, 2.4vw, 32px);
    padding: 0 6px;
    border: 1px solid var(--sb-border);
    border-radius: 8px;
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(9.5px, 0.7vw, 11.2px);
    font-weight: 700;
    color: var(--sb-text-secondary);
    cursor: pointer;
    transition: background var(--sb-dur-image) var(--sb-ease), color var(--sb-dur-image) var(--sb-ease), border-color var(--sb-dur-image) var(--sb-ease);
  }
  .mp-pag :global(.mp-pag__b:hover:not(:disabled)) { border-color: var(--sb-orange-bright); color: var(--sb-orange-bright); }
