---
/**
 * MANDATORY PUBLIC DISCLOSURE — the whole body.
 *
 * ⚠⚠ NOT ONE FIGURE ON THIS PAGE IS TYPED INTO IT. Every value, every document
 * link and all 131 staff rows come out of data/disclosure.ts, which records the
 * primary document each was transcribed from. Read that file's header before
 * changing any number here — it also documents where the school's own web page
 * disagrees with the PDF it links to, and why the PDF won.
 *
 * ⚠⚠ THREE THINGS THE REFERENCE DESIGN GOT WRONG ARE NOT REPRODUCED:
 *   · Class XII shown at 100%. The school's own letterhead says 98.90% for 2025
 *     and 96.86% for 2024. A pass rate the school never claimed is the worst
 *     possible thing to invent on a disclosure page.
 *   · An "Appeared" column. The school publishes Registered and Passed only.
 *   · A "Recognition No." distinct from the affiliation number. No such field is
 *     published; the RTE recognition certificate is linked instead.
 *
 * ⚠ THE LEFT NAVIGATION IS DERIVED FROM THE SECTIONS IT POINTS AT. One array
 * drives the rail, the scroll-spy and the section headings, so a sixth section
 * cannot be added to one and forgotten in the others.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   The floating quick-information card, overlapping the banner.
 *   A two-column body: sticky rail left, five disclosure sections right.
 *   A closing compliance callout.
 */
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import MpdStaffTable from './MpdStaffTable.astro';
import { getDisclosure } from '../../lib/cms';
import RichLine from '../ui/RichLine.astro';
import CmsImage from '../ui/CmsImage.astro';


const S = 'Sunbeam School Ballia';

/**
 * ⚠ ONE RECORD NOW DRIVES THE RAIL, THE SPY AND THE HEADINGS. The labels used
 * to be written twice — once in this array for the rail, once as literal text
 * inside each section heading — so the two could disagree. The anchors are the
 * page's own ids and stay exactly what they were; the numbering is derived from
 * position and is not stored.
 */
const {
  sections, quickInfo, quickNote, source: disclosureSource, rail,
  generalInformation, certificates, academicDocs, docViewLabel,
  boardResults, boardResultsNote,
  staffSummary, staffLead, infrastructure, inspectionVideo,
  callout, teachers,
} = await getDisclosure();
---

{/* ══ THE QUICK-INFORMATION CARD ═════════════════════════════════════════════
    It lifts into the banner above it, which is why the section that holds it is
    transparent and has no padding of its own. */}
<section class="mp-quick" aria-label="School identifiers at a glance">
  <div class="u-container">
    <ul class="mp-quick__box">
      {quickInfo.map((q, i) => (
        <li class="mp-qi" data-pop data-pop-delay={80 + i * 70}>
          <span class="mp-qi__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[q.mark]} />
            </svg>
          </span>
          <span class="mp-qi__t">
            <span class="mp-qi__k">{q.k}</span>
            <span class="mp-qi__v t-tabular">
              {q.href ? <a href={q.href}>{q.v}</a> : q.v}
            </span>
          </span>
        </li>
      ))}
    </ul>
    <RichLine class="mp-quick__note" text={quickNote} />
  </div>
</section>

<section class="as-sec as-sec--ivory mp-body" aria-label="Mandatory public disclosure">
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container mp-body__grid">
    {/* ── THE RAIL ─────────────────────────────────────────────────────────── */}
    <aside class="mp-rail" aria-label="Disclosure sections">
      <nav class="mp-rail__box" data-spy-nav>
        <p class="mp-rail__lab">{rail.label}</p>
        <ul class="mp-rail__list">
          {sections.map((s) => (
            <li>
              <a class="mp-rail__a" href={`#${s.id}`} data-spy-link={s.id}>
                <span class="mp-rail__n t-tabular">{s.n}</span>
                <span class="mp-rail__t">{s.label}</span>
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="mp-rail__pdf">
        <p class="mp-rail__pdfk">{rail.pdfTitle}</p>
        <p class="mp-rail__pdfv">{rail.pdfBody}</p>
        <p class="mp-rail__pdfa">
          <a class="as-btn as-btn--solid" href={disclosureSource.pdf} target="_blank" rel="noopener noreferrer">
            {rail.viewLabel}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.external} />
            </svg>
          </a>
        </p>
        <p class="mp-rail__pdfb">
          <a class="mp-rail__dl" href={disclosureSource.pdf} download>
            {rail.downloadLabel}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
            </svg>
          </a>
        </p>
      </div>
    </aside>

    {/* ── THE CONTENT ──────────────────────────────────────────────────────── */}
    <div class="mp-main">
      {/* 01 · GENERAL INFORMATION */}
      <section class="mp-sec" id="mp-general" aria-labelledby="mp-general-t">
        <p class="mp-sec__h" data-reveal>
          <span class="mp-sec__n t-tabular">{sections[0]?.n}</span>
          <span class="mp-sec__t" id="mp-general-t">{sections[0]?.label}</span>
        </p>

        <div class="mp-card">
          <dl class="mp-facts">
            {generalInformation.map((r) => (
              <div class="mp-fact">
                <dt class="mp-fact__k">
                  {r.k}
                  {r.note && <span class="mp-fact__src">{r.note}</span>}
                </dt>
                <dd class="mp-fact__v">
                  {r.href ? <a href={r.href}>{r.v}</a> : r.v}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      </section>

      {/* 02 · DOCUMENTS & CERTIFICATES */}
      <section class="mp-sec" id="mp-docs" aria-labelledby="mp-docs-t">
        <p class="mp-sec__h" data-reveal>
          <span class="mp-sec__n t-tabular">{sections[1]?.n}</span>
          <span class="mp-sec__t" id="mp-docs-t">{sections[1]?.label}</span>
        </p>

        <ul class="mp-docs">
          {certificates.map((c, i) => (
            <li class="mp-doc" data-pop data-pop-delay={70 + i * 45}>
              <span class="mp-doc__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[c.mark]} />
                </svg>
              </span>
              <h3 class="mp-doc__k">{c.k}</h3>
              <p class="mp-doc__v">{c.v}</p>
              <p class="mp-doc__a">
                <a href={c.href} target="_blank" rel="noopener noreferrer">
                  {docViewLabel}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
                  </svg>
                </a>
                <a class="mp-doc__dl" href={c.href} download aria-label={`Download ${c.k}`}>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
                  </svg>
                </a>
              </p>
            </li>
          ))}
        </ul>
      </section>

      {/* 03 · RESULTS & ACADEMICS
          ⚠ THE TABS READ THE ARRAY. Three years today; a fourth is one entry in
          disclosure.ts and nothing here changes. */}
      <section class="mp-sec" id="mp-results" aria-labelledby="mp-results-t">
        <p class="mp-sec__h" data-reveal>
          <span class="mp-sec__n t-tabular">{sections[2]?.n}</span>
          <span class="mp-sec__t" id="mp-results-t">{sections[2]?.label}</span>
        </p>

        <div class="mp-card mp-res" data-res>
          <div class="mp-res__tabs" role="tablist" aria-label="Board examination year">
            {boardResults.map((r, i) => (
              <button
                type="button"
                role="tab"
                class:list={['mp-res__tab', i === 0 && 'is-on']}
                aria-selected={i === 0 ? 'true' : 'false'}
                aria-controls={`mp-res-${r.year}`}
                id={`mp-tab-${r.year}`}
                data-res-tab={r.year}
              >{r.year}</button>
            ))}
          </div>

          {boardResults.map((r, i) => (
            <div
              class="mp-res__panel"
              role="tabpanel"
              id={`mp-res-${r.year}`}
              aria-labelledby={`mp-tab-${r.year}`}
              data-res-panel={r.year}
              hidden={i !== 0}
            >
              <div class="mp-res__pair">
                {[
                  { cls: 'Class X', d: r.x },
                  { cls: 'Class XII', d: r.xii },
                ].map((c) => (
                  <div class="mp-res__col">
                    <h3 class="mp-res__k">{c.cls}</h3>
                    <dl class="mp-res__rows">
                      <div><dt>Number of students registered</dt><dd class="t-tabular">{c.d.registered}</dd></div>
                      <div><dt>Number of students passed</dt><dd class="t-tabular">{c.d.passed}</dd></div>
                      <div class="mp-res__pct"><dt>Pass percentage</dt><dd class="t-tabular">{c.d.percentage}%</dd></div>
                    </dl>
                  </div>
                ))}
              </div>
            </div>
          ))}

          <RichLine class="mp-res__note" text={boardResultsNote} />
        </div>

        <ul class="mp-docs mp-docs--slim">
          {academicDocs.map((c, i) => (
            <li class="mp-doc" data-pop data-pop-delay={70 + i * 45}>
              <span class="mp-doc__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[c.mark]} />
                </svg>
              </span>
              <h3 class="mp-doc__k">{c.k}</h3>
              <p class="mp-doc__v">{c.v}</p>
              <p class="mp-doc__a">
                <a href={c.href} target="_blank" rel="noopener noreferrer">
                  {docViewLabel}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
                  </svg>
                </a>
                <a class="mp-doc__dl" href={c.href} download aria-label={`Download ${c.k}`}>
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.download} />
                  </svg>
                </a>
              </p>
            </li>
          ))}
        </ul>
      </section>

      {/* 04 · STAFF & TEACHING */}
      <section class="mp-sec" id="mp-staff" aria-labelledby="mp-staff-t">
        <p class="mp-sec__h" data-reveal>
          <span class="mp-sec__n t-tabular">{sections[3]?.n}</span>
          <span class="mp-sec__t" id="mp-staff-t">{sections[3]?.label}</span>
        </p>

        <ul class="mp-sum">
          {staffSummary.map((r, i) => (
            <li class="mp-sum__i" data-pop data-pop-delay={60 + i * 40}>
              <span class="mp-sum__k">{r.k}</span>
              <span class="mp-sum__v">{r.v}</span>
            </li>
          ))}
        </ul>

        <RichLine class="mp-staff__lead" text={staffLead} />

        <MpdStaffTable id="mp-staff-table" per={12} teachers={teachers} />
      </section>

      {/* 05 · SCHOOL INFRASTRUCTURE */}
      <section class="mp-sec" id="mp-infra" aria-labelledby="mp-infra-t">
        <p class="mp-sec__h" data-reveal>
          <span class="mp-sec__n t-tabular">{sections[4]?.n}</span>
          <span class="mp-sec__t" id="mp-infra-t">{sections[4]?.label}</span>
        </p>

        <ul class="mp-infra">
          {infrastructure.map((f, i) => (
            <li class="mp-if" data-pop data-pop-delay={70 + i * 50}>
              <span class="mp-if__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK[f.mark]} />
                </svg>
              </span>
              <span class="mp-if__t">
                <span class="mp-if__k">{f.k}</span>
                <span class="mp-if__v t-tabular">{f.v}</span>
                {f.note && <span class="mp-if__u">{f.note}</span>}
              </span>
            </li>
          ))}

          <li class="mp-if mp-if--link" data-pop data-pop-delay={70 + infrastructure.length * 50}>
            <span class="mp-if__m" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none">
                <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.eye} />
              </svg>
            </span>
            <span class="mp-if__t">
              <span class="mp-if__k">Inspection video</span>
              <a class="mp-if__a" href={inspectionVideo} target="_blank" rel="noopener noreferrer">
                Watch on YouTube
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.external} />
                </svg>
              </a>
            </span>
          </li>
        </ul>
      </section>
    </div>
  </div>
</section>

{/* ══ THE COMPLIANCE CALLOUT ═════════════════════════════════════════════════ */}
<section class="as-sec as-sec--cream as-pad--sm mp-callout" aria-labelledby="mp-callout-t">
  <div class="u-container">
    <div class="mp-callout__box">
      <span class="mp-callout__m" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.shield} />
        </svg>
      </span>

      <div class="mp-callout__copy">
        <h2 class="mp-callout__h" id="mp-callout-t">{callout.heading}</h2>
        <RichLine class="mp-callout__b" text={callout.body} />
      </div>

      <div class="mp-callout__pic">
        <CmsImage
          file={callout.photo}
          alt={callout.alt}
          sizes="(max-width: 1023px) 92vw, 30vw"
          fallbackWidth={760}
        />
      </div>
    </div>
  </div>
</section>

<script>
  /* ── THE YEAR TABS ────────────────────────────────────────────────────────
     Panels are all in the DOM; the tab toggles `hidden`. Arrow keys move
     between tabs because a `role="tablist"` that ignores them is worse than
     no role at all. */
  document.querySelectorAll<HTMLElement>('[data-res]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-res-tab]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[data-res-panel]'));

    const show = (year: string) => {
      tabs.forEach((t) => {
        const on = t.dataset.resTab === year;
        t.classList.toggle('is-on', on);
        t.setAttribute('aria-selected', on ? 'true' : 'false');
      });
      panels.forEach((p) => { p.hidden = p.dataset.resPanel !== year; });
    };

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.resTab ?? ''));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (!d) return;
        e.preventDefault();
        const next = tabs[(i + d + tabs.length) % tabs.length];
        next.focus();
        show(next.dataset.resTab ?? '');
      });
    });
  });

  /* ── THE SCROLL SPY ───────────────────────────────────────────────────────
     ⚠ IT MARKS THE SECTION THE READER IS IN, NOT THE LAST ONE TO CROSS THE
     TRIGGER. An IntersectionObserver that just takes the newest entry marks the
     wrong link when you scroll upward, so the whole visible set is recomputed
     and the topmost one wins. */
  const nav = document.querySelector<HTMLElement>('[data-spy-nav]');
  if (nav) {
    const links = new Map<string, HTMLAnchorElement>();
    nav.querySelectorAll<HTMLAnchorElement>('[data-spy-link]').forEach((a) => {
      links.set(a.dataset.spyLink ?? '', a);
    });

    const targets = [...links.keys()]
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => el !== null);

    const visible = new Set<string>();
    const mark = () => {
      const first = targets.find((t) => visible.has(t.id))?.id
        /* Nothing intersecting — past the end, so keep the last section lit. */
        ?? [...targets].reverse().find((t) => t.getBoundingClientRect().top < window.innerHeight / 2)?.id;
      links.forEach((a, id) => {
        const on = id === first;
        a.classList.toggle('is-on', on);
        if (on) a.setAttribute('aria-current', 'true');
        else a.removeAttribute('aria-current');
      });
    };

    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) visible.add(e.target.id);
          else visible.delete(e.target.id);
        });
        mark();
      },
      { rootMargin: '-96px 0px -55% 0px', threshold: 0 },
    );
    targets.forEach((t) => io.observe(t));
    mark();
  }
</script>

<style>
  /* ═══ THE QUICK CARD ══════════════════════════════════════════════════════ */
  /* ⚠ NEGATIVE MARGIN, AND THE SECTION MUST STAY TRANSPARENT. The card lifts
     into the banner above it; a background here would paint a band over the
     photograph instead. */
  .mp-quick {
    position: relative;
    z-index: 3;
    margin-top: clamp(-72px, -5vw, -40px);
  }
  .mp-quick__box {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(10px, 1.4vw, 22px);
    margin: 0;
    padding: clamp(16px, 1.9vw, 26px) clamp(16px, 2vw, 30px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-3);
    background: var(--sb-paper);
    box-shadow: 0 20px 46px -26px rgba(28, 14, 8, 0.4);
    list-style: none;
  }
  .mp-qi { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: clamp(8px, 0.9vw, 12px); align-items: center; }
  .mp-qi + .mp-qi { border-left: 1px solid var(--sb-border); padding-left: clamp(10px, 1.4vw, 22px); }
  .mp-qi__m { display: block; width: clamp(20px, 1.9vw, 26px); color: var(--sb-orange-bright); }
  .mp-qi__m svg { display: block; width: 100%; height: auto; }
  .mp-qi__t { display: grid; gap: 2px; min-width: 0; }
  .mp-qi__k {
    font-size: clamp(8.5px, 0.64vw, 10px);
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .mp-qi__v {
    font-size: clamp(10px, 0.78vw, 12.4px);
    font-weight: 700;
    line-height: 1.3;
    overflow-wrap: anywhere;
    color: var(--sb-charcoal);
  }
  .mp-qi__v a { color: inherit; }
  .mp-qi__v a:hover { color: var(--sb-orange-bright); }
  .mp-quick__note {
    margin: clamp(8px, 1vw, 12px) 0 0;
    text-align: center;
    font-size: clamp(8.5px, 0.64vw, 10.2px);
    color: var(--sb-text-muted);
  }

  /* ═══ THE BODY GRID ═══════════════════════════════════════════════════════ */
  /* ⚠ clip, NOT hidden — AND THIS IS WHAT MAKES THE STAFF TABLE HEADER STICK.
     `.as-sec` uses `overflow: hidden` to clip its decorative grid, which makes
     the section a scrollport; `position: sticky` then resolves against THAT box
     instead of the viewport, and a box that never scrolls vertically means the
     header never sticks. `overflow: clip` clips exactly as well and creates no
     scrollport, so the rule inside starts working. */
  .mp-body {
    overflow: clip;
    padding-block: clamp(34px, 4.4vw, 68px) clamp(40px, 5vw, 78px);
  }
  .mp-body__grid {
    position: relative;
    display: grid;
    grid-template-columns: clamp(200px, 20vw, 268px) minmax(0, 1fr);
    gap: clamp(20px, 2.6vw, 44px);
    align-items: start;
  }

  .mp-rail { position: sticky; top: clamp(84px, 8vw, 108px); display: grid; gap: clamp(12px, 1.4vw, 18px); }
  .mp-rail__box {
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
  }
  .mp-rail__lab {
    margin: 0;
    padding: clamp(12px, 1.3vw, 16px) clamp(14px, 1.5vw, 19px);
    border-bottom: 1px solid var(--sb-border);
    font-size: clamp(8.5px, 0.64vw, 10.2px);
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .mp-rail__list { margin: 0; padding: 0; list-style: none; }
  .mp-rail__a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: clamp(8px, 0.9vw, 12px);
    align-items: center;
    padding: clamp(10px, 1.1vw, 14px) clamp(14px, 1.5vw, 19px);
    font-size: clamp(10px, 0.76vw, 12.2px);
    font-weight: 600;
    color: var(--sb-text-secondary);
    transition: background var(--sb-dur-image) var(--sb-ease), color var(--sb-dur-image) var(--sb-ease);
  }
  .mp-rail__list li + li .mp-rail__a { border-top: 1px solid var(--sb-border); }
  .mp-rail__n { font-size: clamp(9px, 0.68vw, 10.8px); font-weight: 700; color: var(--sb-orange-bright); }
  .mp-rail__a:hover { background: var(--sb-ivory); color: var(--sb-charcoal); }
  .mp-rail__a.is-on { background: var(--sb-orange-bright); color: #fff; }
  .mp-rail__a.is-on .mp-rail__n { color: #fff; }

  .mp-rail__pdf {
    padding: clamp(14px, 1.6vw, 20px) clamp(14px, 1.6vw, 19px) clamp(16px, 1.8vw, 22px);
    border: 1px solid color-mix(in srgb, var(--sb-orange-bright) 34%, transparent);
    border-radius: var(--sb-r-2);
    background: var(--sb-violet-wash);
  }
  .mp-rail__pdfk {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(11.5px, 0.9vw, 14px);
    font-weight: 700;
    letter-spacing: -0.028em;
    color: var(--sb-violet);
  }
  .mp-rail__pdfv { margin: 5px 0 0; font-size: clamp(9px, 0.68vw, 10.8px); line-height: 1.55; color: var(--sb-text-secondary); }
  .mp-rail__pdfa { margin: clamp(11px, 1.3vw, 15px) 0 0; }
  .mp-rail__pdfa .as-btn { width: 100%; justify-content: center; }
