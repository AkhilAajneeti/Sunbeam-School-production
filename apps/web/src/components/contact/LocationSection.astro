---
/**
 * LOCATION — the map, and nothing else.
 *
 * ⚠ THE MAP SLOT AND ITS MOUNTING SCRIPT ARE UNCHANGED. The iframe is still
 * built on intersection from `data-map-src` by the script on the page — this
 * component only re-dresses the section around it. Rewriting a working deferred
 * embed to make it look different would be the exact kind of change that breaks
 * a page for no gain.
 *
 * ⚠ THE FLOATING ADDRESS CARD IS GONE ON THE CLIENT'S INSTRUCTION. It carried
 * the school name, the address, the landmark line and a "Get directions" button
 * over the left of the map. Every one of those facts is still on the page — the
 * address panel beside the form has the address and the landmark is in the
 * embed's own Google listing — so nothing is lost from the page, only from this
 * section. The one thing that goes with it is the button out to Google Maps;
 * the <noscript> block below still carries that link for the scripting-off case,
 * and with scripting on the mounted map is itself clickable through to Maps.
 *
 * ⚠ THE MAP IS QUERIED BY NAME AND ADDRESS, NOT BY COORDINATES. We have never
 * been given a latitude and longitude and typing a plausible pair would be
 * inventing the school's location. Verified: this embed resolves to the place
 * "Sunbeam School Agarsanda Ballia" — the school's own Google listing.
 */
import Atmosphere from './Atmosphere.astro';
import { getSchool, getContactPage } from '../../lib/cms';

const school = await getSchool();
const page = await getContactPage();

const addressOneLine = `${school.address.line1}, ${school.address.city}, ${school.address.state} ${school.address.pin}`;
const mapQuery = encodeURIComponent(`${school.name}, ${addressOneLine}`);
const mapEmbed = `https://www.google.com/maps?q=${mapQuery}&output=embed`;
const mapLink = `https://www.google.com/maps/search/?api=1&query=${mapQuery}`;
---

<section class="loc" id="location" aria-labelledby="loc-h">
  <Atmosphere tone="light" dots={false} blobs={true} />

  {/* ⚠ THE VISIBLE HEADING IS GONE BUT THE SECTION KEEPS A NAME. The client
      removed the "Find us / Agarsanda, Ballia" block; deleting the <h2> outright
      would have left `aria-labelledby="loc-h"` pointing at nothing, which makes
      the landmark anonymous to a screen reader running through the page's
      regions. A visually-hidden heading costs no pixels and keeps it labelled. */}
  <h2 class="u-visually-hidden" id="loc-h">{page.locationHeading}</h2>

  {/* ⚠ THE STAGE WRAPPER STAYS THOUGH IT NOW HOLDS ONE CHILD. It is what
      carries `z-index: 1` over the Atmosphere layer above; folding it away
      would drop the map behind the blobs. */}
  <div class="loc__stage">
    <div
      class="map__slot loc__map"
      data-map-src={mapEmbed}
      data-map-title={`Map showing ${school.name} at ${addressOneLine}`}
    >
    </div>
  </div>

  <noscript>
    <div class="u-container loc__off">
      <p>{addressOneLine}</p>
      <a href={mapLink} target="_blank" rel="noopener noreferrer">Open the map on Google Maps</a>
    </div>
  </noscript>
</section>

<style>
  /* ⚠ NO TOP PADDING. It was clamp(40px, 5vw, 72px), which was breathing room
     under the contact panel's own closing wave; that wave is gone and the panel
     now ends on a tightened foot, so this had become the second half of an empty
     band. The map is full-bleed and is the only thing in this section — butting
     it straight against the panel above is the composition, not an oversight. */
  .loc {
    position: relative;
    padding-block: 0;
    background: var(--sb-ivory);
    isolation: isolate;
  }

  /* ── the stage ──────────────────────────────────────────────────────────── */
  .loc__stage {
    position: relative;
    z-index: 1;
  }

  .loc__map {
    display: block;
    width: 100%;
    height: clamp(340px, 52vh, 560px);
    background: var(--sb-sand);
  }

  .loc__map :global(iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  .loc__off {
    padding-block: var(--sb-5);
    text-align: center;
  }

  /* With nothing floating over it the map can take the taller crop on a wide
     screen — the height was previously held down so the card had somewhere to
     sit without covering the pin. */
  @media (min-width: 1100px) {
    .loc__map { height: clamp(420px, 58vh, 620px); }
  }
</style>
