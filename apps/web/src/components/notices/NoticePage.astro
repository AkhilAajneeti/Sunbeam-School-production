---
/**
 * SCHOOL NOTICES — featured rotator, working filters, poster grid, load more.
 *
 * ⚠⚠ THE POSTER IS THE NOTICE. The school publishes 24 poster images and nothing
 * else — no titles, no dates, no PDFs, no links. Every title and date on this
 * page was read off the artwork itself; sourcing is in data/notices.ts.
 *
 * ⚠ NO CATEGORY FILTER, BECAUSE THE SOURCE HAS NO CATEGORIES. The brief permits
 * one only if the data supports it. Search (by title) and year (from printed
 * dates) are the two filters the data does support, and they are the two here.
 *
 * ⚠ contain, NOT cover, ON EVERY POSTER. These are vertical and square designed
 * sheets whose whole content is text; cropping one to fill a card would cut the
 * notice off the notice. The brief says so in as many words.
 *
 * ⚠ EVERY CARD IS RENDERED ON THE SERVER. Filtering and "load more" only toggle
 * `hidden` on cards already in the DOM, so all 24 notices are in the HTML for
 * search engines and for anyone with JavaScript off — who simply sees them all.
 */
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import Lightbox from '../ui/Lightbox.astro';
import CmsImage from '../ui/CmsImage.astro';
import { getNoticesPageData, fileUrl } from '../../lib/cms';

interface Props {
  /** Cards shown before "Load more". */
  step?: number;
}
const { step = 10 } = Astro.props;

/* ⚠ CONTENT COMES FROM STRAPI NOW, NOT FROM data/notices.ts.
   One request for the whole set; the featured rotator and the year filter are
   derived from that same array rather than queried separately, so they cannot
   disagree with the grid they sit above. The old module is still on disk and
   still the seed's source — it is not deleted until this is verified in a
   production build. See apps/web/src/lib/cms/queries/notices.ts. */
const { notices, featuredNotices, noticeYears, noticeSource } = await getNoticesPageData();

const S = 'Sunbeam School Ballia';
---

{/* ══ 01 · THE FEATURED NOTICE ═══════════════════════════════════════════════
    Poster left, its details right, with prev/next and dots. */}
<section class="as-sec as-sec--ivory as-pad--sm nt-feat" aria-labelledby="nt-feat-t" data-nt-feat>
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container">
    <h2 class="u-visually-hidden" id="nt-feat-t">Latest notices</h2>

    {featuredNotices.map((n, i) => (
      <div class="nt-feat__slide" data-nt-slide={i} hidden={i !== 0}>
        <a
          class="nt-feat__art"
          data-lb-open
          href={fileUrl(n.image)}
          data-lb-alt={n.alt}
          data-lb-cap={n.title}
          data-mask
        >
          {/* ⚠ A TINY COPY OF THE SAME POSTER, BLURRED — not a second download worth
              worrying about and not a different picture. It fills whatever the
              contained poster leaves over, so the letterbox reads as a frame
              instead of dead white.
              Strapi's `xsmall` breakpoint (64px on the long edge) is what serves
              this; the CSS blurs it, so its exact width has never mattered. */}
          <span class="nt-feat__bg" aria-hidden="true">
            <CmsImage
              file={n.image}
              alt=""
              sizes="64px"
              fallbackWidth={64}
              loading="lazy"
            />
          </span>
          <span class="nt-feat__fg">
            <CmsImage
              file={n.image}
              alt={n.alt}
              sizes="(max-width: 1023px) 92vw, 38vw"
              fallbackWidth={760}
              loading={i === 0 ? 'eager' : 'lazy'}
              fetchpriority={i === 0 ? 'high' : undefined}
            />
          </span>
        </a>

        <div class="nt-feat__copy">
          <p class="as-kicker" data-reveal>Latest notice</p>
          <h3 class="as-h as-h--lg nt-feat__h">{n.title}</h3>
          {n.sub && <p class="nt-feat__sub">{n.sub}</p>}

          {n.dateLabel && (
            <p class="nt-feat__date">
              <span class="nt-feat__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.calendar} />
                </svg>
              </span>
              <span class="t-tabular">{n.dateLabel}</span>
            </p>
          )}

          <p class="nt-feat__acts">
            {/* ⚠ NOT A SECOND data-lb-open. Two triggers for one poster put it
                into the viewer twice in a row; this forwards to the frame. */}
            <button type="button" class="nt-btn nt-btn--solid" data-nt-open>
              View notice
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
              </svg>
            </button>
          </p>
        </div>
      </div>
    ))}

    {featuredNotices.length > 1 && (
      <div class="nt-feat__ctrl">
        <ul class="nt-dots" data-nt-dots aria-hidden="true">
          {featuredNotices.map((_, i) => <li><button type="button" class:list={['nt-dot', i === 0 && 'is-on']} data-nt-dot={i}></button></li>)}
        </ul>
        <div class="nt-feat__arrows">
        <button type="button" class="nt-arrow" data-nt-prev>
          <span class="u-visually-hidden">Previous notice</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" class="nt-arrow" data-nt-next>
          <span class="u-visually-hidden">Next notice</span>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" stroke="currentColor" stroke-width="1.9" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        </div>
      </div>
    )}
  </div>
</section>

{/* ══ 02 · ALL NOTICES ═══════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--paper as-pad nt-all" aria-labelledby="nt-all-t" data-nt-grid data-step={step}>
  <span class="as-grid as-grid--fine" aria-hidden="true"></span>

  <div class="u-container">
    <div class="nt-all__head">
      <div>
        <p class="as-kicker" data-reveal>All notices</p>
        <h2 class="as-h as-h--md nt-all__h" id="nt-all-t">
          <span data-clip data-clip-delay="0">Latest</span>
          <span data-clip data-clip-delay="140"><em>updates</em></span>
        </h2>
        <span class="nt-rule" aria-hidden="true"></span>
      </div>

      {/* ⚠ TWO FILTERS, NOT THREE. There is no category data to filter on. */}
      <div class="nt-tools">
        <label class="nt-search">
          <span class="u-visually-hidden">Search notices by title</span>
          <span class="nt-search__m" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none">
              <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.search} />
            </svg>
          </span>
          <input type="search" placeholder="Search notices…" data-nt-q autocomplete="off" />
        </label>

        <label class="nt-sel">
          <span class="u-visually-hidden">Filter by year</span>
          <select data-nt-year>
            <option value="">All years</option>
            {noticeYears.map((y) => <option value={y}>{y}</option>)}
          </select>
          <span class="nt-sel__chev" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
          </span>
        </label>

        <button type="button" class="nt-clear" data-nt-clear>Clear filters</button>
      </div>
    </div>

    <ul class="nt-cards" data-nt-list>
      {notices.map((n, i) => (
        <li
          class="nt-card"
          data-nt-card
          data-title={n.title.toLowerCase() + ' ' + (n.sub ?? '').toLowerCase()}
          data-year={n.date ? n.date.slice(0, 4) : ''}
        >
          <a
            class="nt-card__art"
            data-lb-open
            href={fileUrl(n.image)}
            data-lb-alt={n.alt}
            data-lb-cap={n.dateLabel ? `${n.title} · ${n.dateLabel}` : n.title}
          >
            <CmsImage
              file={n.image}
              alt={n.alt}
              sizes="(max-width: 767px) 88vw, 19vw"
              fallbackWidth={420}
              loading="lazy"
            />
          </a>
          <div class="nt-card__body">
            <h3 class="nt-card__k">{n.title}</h3>
            {n.dateLabel && (
              <p class="nt-card__date">
                <span class="nt-card__m" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none">
                    <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.calendar} />
                  </svg>
                </span>
                <span class="t-tabular">{n.dateLabel}</span>
              </p>
            )}
            <p class="nt-card__go">
              <button type="button" data-nt-open>
                View notice
                <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
                </svg>
              </button>
            </p>
          </div>
        </li>
      ))}
    </ul>

    <p class="nt-empty" data-nt-empty hidden>
      No notice matches that search.
      <button type="button" class="nt-clear nt-clear--inline" data-nt-clear>Clear the filters</button>
    </p>

    <p class="nt-more">
      <button type="button" class="nt-btn nt-btn--wide" data-nt-more>
        Load more notices
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M12 5v14M5 12l7 7 7-7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
      </button>
      <span class="nt-count" aria-live="polite" data-nt-count></span>
    </p>
  </div>
</section>

{/* ══ 03 · IMPORTANT INFORMATION ═════════════════════════════════════════════
    One large card left, two document cards right — the reference's own shape.

    ⚠⚠ THE SECOND DOCUMENT CARD IS NOT A CIRCULARS PDF, BECAUSE THERE IS NO SUCH
    PDF. The reference art offers "School Circulars & Official Notices —
    download all official circulars in PDF format". The school publishes its
    circulars as poster IMAGES, on the page these 24 came from; it issues no
    circulars document of any kind. The brief's own rule settles it — "Do NOT
    invent PDF/calendar links. If a destination does not exist, do not create a
    fake link." So that card points at the school's own Notice page, which is a
    real destination holding the real circulars, and says so.
    The Academic Calendar card IS real and links to the calendar page. */}
<section class="as-sec as-sec--cream nt-info" aria-labelledby="nt-info-t">
  <div class="u-container nt-info__grid">
    <div class="nt-info__main">
      <span class="nt-info__m" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none">
          <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.shield} />
        </svg>
      </span>
      <h2 class="nt-info__h" id="nt-info-t">Important information</h2>
      <p class="nt-info__v">
        Every notice on this page is an official announcement published by {S}. The school issues
        them as posters rather than as documents, so each one opens at full size in the viewer.
      </p>
      <p class="nt-info__act">
        <a class="nt-btn" href="#nt-all-t">
          View all notices
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
          </svg>
        </a>
      </p>
    </div>

    <ul class="nt-docs">
      <li class="nt-doc">
        <span class="nt-doc__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.megaphone} />
          </svg>
        </span>
        <h3 class="nt-doc__k">School circulars &amp; official notices</h3>
        <p class="nt-doc__v">
          The school publishes its circulars as posters on its own Notice page — the source of
          every notice above.
        </p>
        <p class="nt-doc__a">
          <a href={noticeSource} target="_blank" rel="noopener noreferrer">
            Open the school’s page
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.external} />
            </svg>
          </a>
        </p>
      </li>

      <li class="nt-doc">
        <span class="nt-doc__m" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none">
            <g stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.calendar} />
          </svg>
        </span>
        <h3 class="nt-doc__k">Academic calendar</h3>
        <p class="nt-doc__v">
          The session calendars the school publishes, with the planner for the current session.
        </p>
        <p class="nt-doc__a">
          <a href="/academics/academic-calendar/">
            View calendar
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </a>
        </p>
      </li>
    </ul>
  </div>
</section>

<Lightbox />

<script>
  /* ── THE FEATURED ROTATOR ─────────────────────────────────────────────────
     ⚠ NO AUTOPLAY. A notice that slides away mid-read is a notice missed. */
  document.querySelectorAll<HTMLElement>('[data-nt-feat]').forEach((root) => {
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-nt-slide]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-nt-dot]'));
    if (slides.length < 2) return;
    let at = 0;

    const show = (i: number) => {
      at = (i + slides.length) % slides.length;
      slides.forEach((s, k) => { s.hidden = k !== at; });
      dots.forEach((d, k) => d.classList.toggle('is-on', k === at));
    };

    root.querySelector('[data-nt-prev]')?.addEventListener('click', () => show(at - 1));
    root.querySelector('[data-nt-next]')?.addEventListener('click', () => show(at + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));
  });

  /* ⚠ ONE POSTER, ONE VIEWER ENTRY. Every "View notice" control forwards its
     click to the poster beside it, so the lightbox set is the 24 posters and not
     48 alternating duplicates. */
  document.querySelectorAll<HTMLElement>('[data-nt-open]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const scope = btn.closest('[data-nt-card], [data-nt-slide]');
      scope?.querySelector<HTMLAnchorElement>('[data-lb-open]')?.click();
    });
  });

  /* ── THE GRID: SEARCH, YEAR, LOAD MORE ────────────────────────────────────
     All three work on cards already in the DOM. */
  document.querySelectorAll<HTMLElement>('[data-nt-grid]').forEach((root) => {
    const step = Number(root.dataset.step) || 10;
    const cards = Array.from(root.querySelectorAll<HTMLElement>('[data-nt-card]'));
    const q = root.querySelector<HTMLInputElement>('[data-nt-q]');
    const year = root.querySelector<HTMLSelectElement>('[data-nt-year]');
    const more = root.querySelector<HTMLButtonElement>('[data-nt-more]');
    const count = root.querySelector<HTMLElement>('[data-nt-count]');
    const empty = root.querySelector<HTMLElement>('[data-nt-empty]');
    let shown = step;

    const matching = () => {
      const term = (q?.value ?? '').trim().toLowerCase();
      const y = year?.value ?? '';
      return cards.filter(
        (c) => (!term || (c.dataset.title ?? '').includes(term)) && (!y || c.dataset.year === y),
      );
    };

    const paint = () => {
      const hits = matching();
      const visible = new Set(hits.slice(0, shown));
      cards.forEach((c) => c.toggleAttribute('hidden', !visible.has(c)));

      if (empty) empty.hidden = hits.length > 0;
      if (count) {
        count.textContent = hits.length === 0
          ? ''
          : `Showing ${Math.min(shown, hits.length)} of ${hits.length} ${hits.length === 1 ? 'notice' : 'notices'}`;
      }
      /* ⚠ HIDDEN, NOT DISABLED, WHEN THERE IS NO MORE. A greyed button that
         cannot do anything is still something to try clicking. */
      if (more) more.parentElement?.toggleAttribute('hidden', hits.length === 0 || shown >= hits.length);
    };

    const restart = () => { shown = step; paint(); };
    q?.addEventListener('input', restart);
    year?.addEventListener('change', restart);
    q?.addEventListener('keydown', (e) => { if (e.key === 'Escape' && q.value) { q.value = ''; restart(); } });

    root.querySelectorAll<HTMLButtonElement>('[data-nt-clear]').forEach((b) =>
      b.addEventListener('click', () => {
        if (q) q.value = '';
        if (year) year.value = '';
        restart();
        q?.focus();
      }),
    );

    more?.addEventListener('click', () => {
      shown += step;
      paint();
      /* Put focus on the first newly revealed card so a keyboard reader is not
         dropped back at the top of the list. */
      matching()[shown - step]?.querySelector<HTMLAnchorElement>('a')?.focus();
    });

    paint();
  });
</script>

<style>
  /* ⚠⚠ THE hidden ATTRIBUTE ONLY REACHES display:none THROUGH THE UA SHEET, so
     ANY author rule that sets display outranks it. Both the cards and the
     featured slides are grids, which silently defeated `hidden` — Load More and
     both filters were toggling an attribute that changed nothing on screen, and
     the lightbox counted every hidden card as visible. */
  .nt-card[hidden],
  .nt-feat__slide[hidden] { display: none !important; }

  .nt-rule { display: block; width: clamp(34px, 3.4vw, 46px); height: 3px; margin: clamp(9px, 1.1vw, 14px) 0 0; border-radius: 3px; background: var(--sb-orange-bright); }

  .nt-btn {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: clamp(9px, 1vw, 12px) clamp(15px, 1.7vw, 22px);
    border: 1.5px solid color-mix(in srgb, var(--sb-orange-bright) 52%, transparent);
    border-radius: var(--sb-r-1);
    background: none;
    font: inherit;
    font-size: clamp(10px, 0.76vw, 12.2px);
    font-weight: 700;
    white-space: nowrap;
    color: var(--sb-orange-bright);
    cursor: pointer;
    transition: background 220ms var(--sb-ease), color 220ms var(--sb-ease), border-color 220ms var(--sb-ease);
  }
  .nt-btn svg { width: 13px; height: auto; transition: transform 220ms var(--sb-ease); }
  .nt-btn:hover { border-color: var(--sb-orange-bright); background: var(--sb-orange-bright); color: #fff; }
  .nt-btn:hover svg { transform: translateX(3px); }
  .nt-btn--solid { border-color: var(--sb-orange-bright); background: var(--sb-orange-bright); color: #fff; }
  .nt-btn--solid:hover { border-color: var(--sb-violet); background: var(--sb-violet); }
  .nt-btn--wide { padding-inline: clamp(20px, 2.4vw, 32px); }
  .nt-btn--wide:hover svg { transform: translateY(3px); }

  /* ═══ 01 · FEATURED ═══════════════════════════════════════════════════════ */
  .nt-feat { position: relative; padding-block: clamp(38px, 4.6vw, 76px); }
  .nt-feat__slide {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 42fr) minmax(0, 58fr);
    gap: clamp(26px, 3.6vw, 60px);
    align-items: center;
    justify-items: start;
  }
  /* An almost-white warm bloom — present, never visibly orange. */
  .nt-feat::after {
    content: '';
    position: absolute;
    top: -18%;
    right: -8%;
    width: 46%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(circle, color-mix(in srgb, var(--sb-orange-bright) 11%, transparent), transparent 66%);
    pointer-events: none;
    z-index: 0;
  }
  .nt-feat > .u-container { position: relative; z-index: 1; }
  /* ⚠⚠ THE STAGE OWNS THE HEIGHT, NOT THE POSTER — and it has to, because the
     posters run from 0.65 to 1.78 in ratio. Letting each one set its own height
     swung this section by 365px between slides. 10/11 sits between the featured
     three (0.71 / 0.80 / 1.00), so each is within a few per cent of filling it;
     the poster is CONTAINED, never cropped, and the few per cent left over is
     covered by a blurred copy of that same poster rather than empty white — the
     mistake this section was rebuilt to remove. A landscape poster added later
     degrades into more blur, not a broken layout. */
  .nt-feat__art {
    position: relative;
    display: block;
    width: 100%;
    max-width: clamp(300px, 30vw, 430px);
    aspect-ratio: 10 / 11;
    overflow: hidden;
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-3);
    background: var(--sb-paper);
    box-shadow: 0 20px 44px -26px rgba(28, 14, 8, 0.34);
    cursor: zoom-in;
    transition: transform 300ms var(--sb-ease), box-shadow 300ms var(--sb-ease);
  }
  .nt-feat__art:hover { transform: translateY(-3px); box-shadow: 0 26px 52px -26px rgba(28, 14, 8, 0.42); }
  .nt-feat__bg { position: absolute; inset: 0; z-index: 0; }
  .nt-feat__bg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.5;
    filter: blur(24px) saturate(1.15);
    transform: scale(1.25);
  }
  .nt-feat__fg { position: absolute; inset: 0; z-index: 1; display: block; }
  .nt-feat__fg :global(picture) { display: block; width: 100%; height: 100%; }
  .nt-feat__fg :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 10px 22px rgba(28, 14, 8, 0.22));
  }
  .nt-feat__h { margin-top: 0; max-width: 16ch; }
  .nt-feat__sub { margin: clamp(7px, 0.9vw, 11px) 0 0; max-width: 42ch; font-size: clamp(10.5px, 0.8vw, 12.6px); line-height: 1.66; color: var(--sb-text-secondary); }
  .nt-feat__date { display: flex; align-items: center; gap: 7px; margin: clamp(10px, 1.2vw, 15px) 0 0; font-size: clamp(10px, 0.76vw, 12.2px); font-weight: 700; color: var(--sb-text-muted); }
  .nt-feat__m { display: block; width: clamp(14px, 1.2vw, 17px); color: var(--sb-orange-bright); }
  .nt-feat__m svg { display: block; width: 100%; height: auto; }
  .nt-feat__acts { margin: clamp(15px, 1.9vw, 24px) 0 0; }

  /* ⚠ THE CONTROLS SIT AT THE RIGHT EDGE ON DESKTOP, as the reference has them —
     dots above, arrows beneath, both right-aligned and clear of the copy. They
     return to normal flow below 1024, where an absolutely positioned control
     would either overlap the text or hang off the column. */
  .nt-feat__ctrl {
    position: absolute;
    top: 32%;
    right: 0;
    z-index: 2;
    display: grid;
    justify-items: end;
    gap: clamp(11px, 1.3vw, 16px);
  }
  .nt-feat__arrows { display: flex; gap: 8px; }
  .nt-feat__copy { padding-right: clamp(0px, 7vw, 120px); }
  .nt-arrow {
    display: grid;
    place-items: center;
    width: clamp(32px, 2.8vw, 38px);
    aspect-ratio: 1 / 1;
    border: 1px solid var(--sb-border-strong);
    border-radius: 50%;
