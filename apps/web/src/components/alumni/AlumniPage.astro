---
/**
 * ALUMNI — the whole body. Six sections.
 *
 * ⚠⚠ EVERY SECTION RENDERS FROM data/alumniMeets.ts AND data/alumni.ts. Nothing
 * on this page counts to a number, names a session or assumes a photograph. Add
 * a meet to the data file and it appears in the featured block, the slider, the
 * gallery and its own route; add twenty and nothing here changes.
 *
 * ⚠⚠ THE PHOTOGRAPHS DO NOT EXIST YET, AND THE PAGE IS BUILT FOR THAT.
 * src/assets/alumni/ holds three placement graphics and no meet photography, so
 * a meet without a `cover` renders a typographic plate — the event's name set
 * large on warm paper, with its session — rather than borrowing an unrelated
 * school photograph and captioning it as an alumni meet. That is the one thing
 * this page must not do: a group photograph from a farewell or an assembly,
 * labelled "Alumni Meet", is a false claim about who is in the frame.
 *
 * ⚠ NO "COMING SOON" CARDS, per the brief. The reference art showed three
 * placeholder meets for 2026-27, 2027-28 and 2028-29 — events the school has
 * not announced. A card promising one commits the school to it.
 *
 * ⚠ THE STORIES SECTION SHOWS THE THREE REAL ALUMNI, not an empty state. The
 * reference art had this section empty, but data/alumni.ts carries three
 * verified records read off the school's own "OUR ALUMNI" graphics — a degree,
 * an institution and an employer each. Showing an empty state above three real
 * records would be throwing away the only verified alumni content there is.
 * What is genuinely missing — the alumnus speaking in their own words — is
 * stated underneath rather than invented.
 *
 * ═══ COMPOSITION ═══════════════════════════════════════════════════════════
 *   01 · IVORY  the connection — copy left, campus right.
 *   02 · PAPER  the featured meet, split.
 *   03 · CREAM  the meets slider, data-driven.
 *   04 · PAPER  the alumni on record.
 *   05 · IVORY  the gallery strip — awaiting state until photographs arrive.
 *   06 · PHOTO  the dark close.
 */
import { Picture } from 'astro:assets';
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import AlRail from './AlRail.astro';
import Lightbox from '../ui/Lightbox.astro';
import CmsImage from '../ui/CmsImage.astro';
import { getAlumniPageData, fileUrl, getSchool } from '../../lib/cms';

import pCampus from '../../assets/photos/sunbeem-1.jpg';
import pCohort from '../../assets/photos/sunbeem-3.jpg';

const school = await getSchool();

/* ⚠ FROM STRAPI NOW, NOT data/alumniMeets.ts + data/alumni.ts. All five values
   come from one call and four of them are DERIVED from the meets it returned —
   featuredMeet, the gallery flatMap — so they cannot disagree with the grid.
   The old data files remain on disk until this is verified in a production
   build. */
const { alumni, publishedMeets, featuredMeet, publishedStories, alumniGallery } =
  await getAlumniPageData();

const S = 'Sunbeam School Ballia';
const CONTACT = '/contact-us/';
const BASE = '/alumni/';
const REGISTER = '/alumni/registration/';

const hasMeets = publishedMeets.length > 0;
const hasGallery = alumniGallery.length > 0;
const hasStories = publishedStories.length > 0;
---

{/* ══ 01 · THE CONNECTION ════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad al-open" aria-labelledby="al-open-t">
  <span class="as-warm" aria-hidden="true"></span>

  <div class="u-container al-open__grid">
    <div class="al-open__copy">
      <p class="as-kicker" data-reveal>The Sunbeam connection</p>
      <h2 class="as-h as-h--xl al-open__h" id="al-open-t">
        <span data-clip data-clip-delay="0">They leave the gate.</span>
        <span data-clip data-clip-delay="150"><em>They do not leave the school.</em></span>
      </h2>
      <p class="as-body" data-reveal data-reveal-delay="200">
        This page is the school’s alumni record: the meets it holds, and the former students whose
        course it has published. It carries what the school has actually issued — nothing is
        reconstructed from memory, and no one is described as an alumnus unless the school’s own
        card says so.
      </p>
      <p class="as-note" data-reveal data-reveal-delay="260">
        It is built to grow. Each meet the school holds is added with its own photographs and its
        own page, and appears here the moment it is published.
      </p>
    </div>

    <div class="al-open__media">
      <span class="as-dots al-open__dots" aria-hidden="true"></span>
      <div class="al-open__frame as-frame" data-mask>
        <Picture
          src={pCampus}
          alt={`The main building of ${S} at Agarsanda, seen across its front lawn.`}
          formats={['webp']}
          widths={[540, 900, 1280]}
          sizes="(max-width: 1023px) 92vw, 46vw"
          loading="eager"
          decoding="async"
        />
      </div>
    </div>
  </div>
</section>

{/* ══ 02 · THE FEATURED MEET ═════════════════════════════════════════════════
    ⚠ THE WHOLE SECTION IS CONDITIONAL. No published meet, no section — rather
    than a headline standing over nothing. */}
{featuredMeet && (
  <section class="as-sec as-sec--paper as-pad al-feat" aria-labelledby="al-feat-t">
    <span class="as-grid as-grid--fine" aria-hidden="true"></span>

    <div class="u-container al-feat__grid">
      <div class="al-feat__copy">
        <p class="as-kicker" data-reveal>Alumni Meet {featuredMeet.session}</p>
        <h2 class="as-h as-h--lg al-feat__h" id="al-feat-t">
          <span data-clip data-clip-delay="0">{featuredMeet.title}</span>
          {featuredMeet.subtitle && <span data-clip data-clip-delay="150"><em>{featuredMeet.subtitle}</em></span>}
        </h2>

        {featuredMeet.description.map((para, i) => (
          <p class="as-body" data-reveal data-reveal-delay={200 + i * 55}>{para}</p>
        ))}

        <p class="al-feat__acts" data-reveal data-reveal-delay="330">
          <a class="al-pill al-pill--lg" href={`${BASE}${featuredMeet.slug}/`}>
            {featuredMeet.gallery.length > 0 ? 'View event gallery' : 'Read about the meet'}
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </a>
          {featuredMeet.gallery.length > 0 && (
            <a class="al-plain" href={`${BASE}${featuredMeet.slug}/`}>Read about the meet</a>
          )}
        </p>
      </div>

      <div class="al-feat__media">
        {featuredMeet.cover ? (
          <a
            class="al-feat__frame as-frame"
            data-lb-open
            href={fileUrl(featuredMeet.cover)}
            data-lb-alt={featuredMeet.coverAlt}
            data-lb-cap={`${featuredMeet.title} · ${featuredMeet.session}`}
            data-mask
          >
            <CmsImage
              file={featuredMeet.cover}
              alt={featuredMeet.coverAlt ?? `${featuredMeet.title}, the Alumni Meet of ${featuredMeet.session} at ${S}.`}
              sizes="(max-width: 1023px) 92vw, 48vw"
              fallbackWidth={1100}
              loading="lazy"
            />
          </a>
        ) : (
          /* ⚠ A PLATE, NOT A PHOTOGRAPH. See the file header — borrowing an
             unrelated school image here would caption strangers as alumni. */
          <div class="al-plate al-plate--big" data-pop data-pop-delay="180">
            <span class="al-plate__k">Alumni Meet</span>
            <span class="al-plate__t">{featuredMeet.title}</span>
            {featuredMeet.subtitle && <span class="al-plate__s">{featuredMeet.subtitle}</span>}
            <span class="al-plate__y t-tabular">{featuredMeet.session}</span>
            <span class="al-plate__n">Photographs from this meet have not been added yet.</span>
          </div>
        )}
      </div>
    </div>

    {featuredMeet.source && (
      <p class="al-feat__src">{featuredMeet.source}</p>
    )}
  </section>
)}

{/* ══ 03 · THE MEETS ═════════════════════════════════════════════════════════
    ⚠ DATA-DRIVEN AND UNBOUNDED. One card per published meet. With a single meet
    the rail's arrows disable themselves; with twenty it pages. */}
<section class="as-sec as-sec--cream as-pad al-meets" aria-labelledby="al-meets-t">
  <div class="u-container">
    <div class="al-meets__head">
      <div>
        <p class="as-kicker" data-reveal>Alumni meets</p>
        <h2 class="as-h as-h--md al-meets__h" id="al-meets-t">
          <span data-clip data-clip-delay="0">Moments we</span>
          <span data-clip data-clip-delay="140"><em>celebrate together</em></span>
        </h2>
        <span class="al-rule" aria-hidden="true"></span>
      </div>
      <div class="al-head__side">
        <p class="al-meets__n" data-reveal data-reveal-delay="180">
          {publishedMeets.length === 1
            ? 'One meet on record. Each new one is added with its own page and gallery.'
            : `${publishedMeets.length} meets on record, newest first.`}
        </p>
        {featuredMeet && (
          <a class="al-pill" href={`${BASE}${featuredMeet.slug}/`}>
            View all meets
            <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
            </svg>
          </a>
        )}
      </div>
    </div>

    {hasMeets ? (
      <AlRail label="Alumni meets" id="al-meets-rail" per={4} perMd={2} perSm={1}>
        {publishedMeets.map((m) => (
          <li class="al-card">
            <article class="al-card__in">
              <a class="al-card__art" href={`${BASE}${m.slug}/`}>
                {m.cover ? (
                  <CmsImage
                    file={m.cover}
                    alt={m.coverAlt ?? `${m.title}, the Alumni Meet of ${m.session} at ${S}.`}
                    sizes="(max-width: 767px) 84vw, 24vw"
                    fallbackWidth={420}
                    loading="lazy"
                  />
                ) : (
                  <span class="al-plate al-plate--card">
                    <span class="al-plate__t">{m.title}</span>
                    {m.subtitle && <span class="al-plate__s">{m.subtitle}</span>}
                  </span>
                )}
                {m.featured && <span class="al-card__flag">Featured</span>}
              </a>

              <div class="al-card__body">
                <h3 class="al-card__k">{m.title}</h3>
                {m.subtitle && <p class="al-card__s">{m.subtitle}</p>}
                {/* The reference's foot row: the session on the left behind a
                    calendar mark, the action on the right, divided off by a rule. */}
                <p class="al-card__foot">
                  <span class="al-card__meta">
                    <span class="al-card__m" aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none">
                        <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.calendar} />
                      </svg>
                    </span>
                    <span class="t-tabular">{m.session}</span>
                  </span>
                  <a class="al-card__go" href={m.gallery.length > 0 ? `${BASE}${m.slug}/#gallery` : `${BASE}${m.slug}/`}>
                    {m.gallery.length > 0 ? 'View gallery' : 'Read about'}
                    <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                      <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
                    </svg>
                  </a>
                </p>
              </div>
            </article>
          </li>
        ))}
      </AlRail>
    ) : (
      <div class="al-empty">
        <p class="al-empty__k">No alumni meet published yet</p>
        <p class="al-empty__v">Each meet the school holds will appear here with its own page and photographs.</p>
      </div>
    )}
  </div>
</section>

{/* ══ 04 · THE ALUMNI ON RECORD ══════════════════════════════════════════════
    ⚠ THESE THREE ARE VERIFIED. Each is the school's own "OUR ALUMNI" graphic,
    shown whole — it is a designed card, and cropping one removes the school's
    branding and the degree line together. */}
<section class="as-sec as-sec--paper as-pad al-people" aria-labelledby="al-people-t">
  <div class="u-container">
    <div class="al-people__head">
      <div>
        <p class="as-kicker" data-reveal>Alumni stories</p>
        <h2 class="as-h as-h--md al-people__h" id="al-people-t">
          <span data-clip data-clip-delay="0">Where our</span>
          <span data-clip data-clip-delay="140"><em>students went</em></span>
        </h2>
        <span class="al-rule" aria-hidden="true"></span>
      </div>
      <p class="al-people__n" data-reveal data-reveal-delay="180">
        The school issues a card for an alumnus it is following — the degree, the institution and
        the employer. These are those cards, reproduced whole.
      </p>
    </div>

    <ul class="al-people__list">
      {alumni.map((a, i) => (
        <li class="al-person" data-pop data-pop-delay={110 + i * 90}>
          <a
            class="al-person__art"
            data-lb-open
            href={fileUrl(a.poster)}
            data-lb-alt={a.alt}
            data-lb-cap={`${a.name} · ${a.placed}`}
          >
            <CmsImage
              file={a.poster}
              alt={a.alt}
              sizes="(max-width: 767px) 84vw, 30vw"
              fallbackWidth={760}
              loading="lazy"
            />
          </a>
          <div class="al-person__body">
            <h3 class="al-person__k">{a.name}</h3>
            <p class="al-person__study">{a.study}</p>
            <p class="al-person__placed">
              <span class="al-person__m" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none">
                  <g stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.medal} />
                </svg>
              </span>
              {a.placed}
            </p>
          </div>
        </li>
      ))}
    </ul>

    {/* ⚠ THE GAP NAMED, NOT FILLED. A testimonial needs the alumnus's own words
        and their written consent — neither is a data entry. */}
    <p class="al-people__gap">
      {hasStories
        ? 'Further alumni accounts are published below as the school records them.'
        : 'What these cards do not carry is the alumnus speaking — their own account of their years here. Those are published as the school records them, with consent.'}
    </p>
  </div>
</section>

{/* ══ 05 · THE GALLERY ═══════════════════════════════════════════════════════ */}
<section class="as-sec as-sec--ivory as-pad--sm al-gal" aria-labelledby="al-gal-t">
  <div class="u-container">
    <div class="al-gal__head">
      <div>
        <p class="as-kicker" data-reveal>Alumni gallery</p>
        <h2 class="as-h as-h--md al-gal__h" id="al-gal-t">
          <span data-clip data-clip-delay="0">Glimpses of</span>
          <span data-clip data-clip-delay="140"><em>memories</em></span>
        </h2>
        <span class="al-rule" aria-hidden="true"></span>
      </div>
    </div>

    {hasGallery ? (
      <AlRail label="Photographs from the alumni meets" id="al-gal-rail" per={5} perMd={3} perSm={2}>
        {alumniGallery.map((g) => (
          <li class="al-shot">
            <a class="al-shot__a" data-lb-open href={fileUrl(g.image)} data-lb-alt={g.alt} data-lb-cap={g.caption ?? g.alt}>
              <CmsImage
                file={g.image}
                alt={g.alt}
                sizes="(max-width: 767px) 46vw, 19vw"
                fallbackWidth={420}
                loading="lazy"
              />
            </a>
          </li>
        ))}
      </AlRail>
    ) : (
      /* ⚠ THE STRIP READS ITS OWN SOURCE. It is built from the meets' galleries,
         so it fills the moment any meet gains photographs — there is no second
         list to remember to update. */
      <div class="al-empty">
        <p class="al-empty__k">Photographs are being added</p>
        <p class="al-empty__v">
          This strip is built from the galleries of the meets above, so it fills as soon as a meet’s
          photographs are added. No image is shown here unless it is from an alumni meet.
        </p>
      </div>
    )}
  </div>
</section>

{/* ══ 06 · THE CLOSE ═════════════════════════════════════════════════════════ */}
<section class="as-close al-close" aria-labelledby="al-close-t">
  <div class="as-close__media" aria-hidden="true" data-parallax data-parallax-y="-40">
    <Picture
      src={pCohort}
      alt=""
      formats={['webp']}
      widths={[1024, 1600, 2000]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
      style="object-position: 50% 40%;"
    />
  </div>
  <span class="as-close__scrim" aria-hidden="true"></span>
  <span class="as-close__grain" aria-hidden="true"></span>

  <div class="u-container as-close__inner al-close__inner">
    <div>
      <p class="as-kicker as-kicker--dark" data-reveal>Former students</p>
      <h2 class="as-h as-close__h al-close__h" id="al-close-t">
        {/* ⚠ THE SCHOOL’S OWN SENTENCE, off its Pradiptam post: "once a
            Sunbeam, always a Sunbeam". The reference art paraphrased it; the
            school said it better, and quoting beats rewriting. */}
        <span data-clip data-clip-delay="0">Once a Sunbeam,</span>
        <span data-clip data-clip-delay="150">always <em>a Sunbeam.</em></span>
      </h2>
      <p class="as-close__b" data-reveal data-reveal-delay="180">
        Are you a former student of {S}? Leave your details and the school can reach you about the
        next meet — or call the office directly.
      </p>
    </div>

    <div class="al-close__acts" data-reveal data-reveal-delay="240">
      <a class="as-btn as-btn--solid" href={REGISTER}>
        Stay connected
        <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
        </svg>
      </a>
      <a class="al-close__ghost" href={CONTACT}>Contact school</a>
    </div>
  </div>
</section>

<Lightbox />

<style>
  /* ═══ 01 · THE CONNECTION ═════════════════════════════════════════════════ */
  .al-open__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.94fr) minmax(0, 1.06fr);
    gap: clamp(28px, 3.8vw, 64px);
    align-items: center;
  }
  .al-open__h { max-width: 14ch; }
  .al-open__copy .as-body { max-width: 48ch; }
  .al-open__media { position: relative; }
  .al-open__dots { top: -6%; right: -3%; z-index: 0; }
  .al-open__frame { display: block; overflow: hidden; border-radius: var(--sb-r-2); }
  .al-open__frame :global(picture) { display: block; }
  .al-open__frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }

  /* ═══ 02 · THE FEATURED MEET ══════════════════════════════════════════════ */
  .al-feat__grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(28px, 3.8vw, 64px);
    align-items: center;
  }
  .al-feat__h { max-width: 16ch; }
  .al-feat__h em { letter-spacing: -0.02em; }
  .al-feat__copy .as-body { max-width: 46ch; }
  .al-feat__acts { display: flex; flex-wrap: wrap; gap: clamp(8px, 1vw, 12px); margin: clamp(16px, 2vw, 24px) 0 0; }
  .al-feat__frame { display: block; overflow: hidden; border-radius: var(--sb-r-2); cursor: zoom-in; box-shadow: var(--sb-shadow-card); }
  .al-feat__frame :global(picture) { display: block; }
  .al-feat__frame :global(img) { display: block; width: 100%; height: auto; aspect-ratio: 16 / 10; object-fit: cover; }
  .al-feat__src {
    position: relative;
    max-width: 78ch;
    margin: clamp(22px, 2.8vw, 34px) auto 0;
    padding: 0 var(--sb-margin);
    text-align: center;
    font-size: clamp(9px, 0.68vw, 10.8px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }

  /* ⚠ THE PLATE — what a meet looks like before its photographs arrive. It is
     deliberately typographic and deliberately says so, so nobody mistakes it
     for a design that lost its image. */
  .al-plate {
    position: relative;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 4px;
    overflow: hidden;
    border: 1px solid var(--sb-border-strong);
    border-radius: var(--sb-r-2);
    background:
      radial-gradient(120% 100% at 50% 0%, color-mix(in srgb, var(--sb-violet-wash) 80%, transparent), transparent 70%),
      var(--sb-sand);
    text-align: center;
  }
  .al-plate--big { aspect-ratio: 16 / 10; padding: clamp(20px, 3vw, 40px); }
  .al-plate--card { aspect-ratio: 4 / 3; padding: clamp(14px, 2vw, 22px); width: 100%; height: 100%; }
  .al-plate__k {
    font-size: clamp(8.5px, 0.64vw, 10.2px);
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--sb-text-muted);
  }
  .al-plate__t {
    font-family: var(--sb-font-display);
    font-size: clamp(20px, 2.6vw, 44px);
    font-weight: 800;
    line-height: 1.06;
    letter-spacing: -0.04em;
    color: var(--sb-charcoal);
  }
  .al-plate--card .al-plate__t { font-size: clamp(15px, 1.5vw, 22px); }
  .al-plate__s {
    font-family: var(--sb-font-display);
    font-size: clamp(12px, 1.2vw, 20px);
    font-style: italic;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sb-orange-bright);
  }
  .al-plate--card .al-plate__s { font-size: clamp(10px, 0.82vw, 12.6px); }
  .al-plate__y {
    margin-top: clamp(6px, 0.9vw, 12px);
    padding: 4px clamp(9px, 1vw, 13px);
    border-radius: var(--sb-r-1);
    background: var(--sb-paper);
    font-size: clamp(9px, 0.7vw, 11px);
    font-weight: 700;
    letter-spacing: 0.06em;
    color: var(--sb-text-secondary);
  }
  .al-plate__n {
    margin-top: clamp(8px, 1.1vw, 14px);
    max-width: 30ch;
    font-size: clamp(8.6px, 0.64vw, 10.2px);
    line-height: 1.55;
    color: var(--sb-text-muted);
  }

  /* ═══ THE REFERENCE'S SHARED CHROME ═══════════════════════════════════════
     A short orange rule under every section heading, and an outlined pill for
     the section's own action. Both come straight off the reference art and are
     defined once so the three sections cannot drift apart. */
  .al-rule {
    display: block;
    width: clamp(34px, 3.4vw, 46px);
    height: 3px;
    margin: clamp(9px, 1.1vw, 14px) 0 0;
    border-radius: 3px;
    background: var(--sb-orange-bright);
  }

  .al-pill {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: clamp(8px, 0.95vw, 11px) clamp(15px, 1.7vw, 22px);
    border: 1.5px solid color-mix(in srgb, var(--sb-orange-bright) 55%, transparent);
    border-radius: var(--sb-r-1);
    font-size: clamp(10px, 0.76vw, 12.2px);
    font-weight: 700;
    white-space: nowrap;
    color: var(--sb-orange-bright);
