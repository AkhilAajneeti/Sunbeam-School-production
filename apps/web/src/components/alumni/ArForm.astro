---
/**
 * THE ALUMNI REGISTRATION FORM.
 *
 * ⚠⚠ IT VALIDATES FOR REAL AND SUBMITS ONLY IF THERE IS SOMEWHERE TO SUBMIT TO.
 * `registrationSettings.endpoint` is null while the school has no handler, and
 * the form reads it: every field is checked, every error is shown inline and
 * announced, and then — with no endpoint — it says plainly that nothing was sent
 * and offers the office line instead. Set the endpoint and the identical form
 * posts and shows the success state. No markup changes either way.
 *
 * A form that appears to submit into nothing is worse than one that admits it
 * is not wired up: it collects real names, numbers and email addresses from
 * people who believe the school asked for them.
 *
 * ⚠ VALIDATION IS CUSTOM, NOT `required` ALONE. Native bubbles are unstyleable,
 * vanish on scroll, and only ever show the first error. This shows all of them
 * at once, ties each to its field with `aria-describedby`, sets `aria-invalid`,
 * and moves focus to the first one — which is what makes it usable by keyboard
 * and by screen reader rather than merely blocking a bad POST.
 *
 * ⚠ THE FIELDS COME FROM data/alumniRegistration.ts. Nine hand-written blocks
 * would drift the first time the client changed one.
 *
 * ⚠ DOUBLE SUBMISSION IS BLOCKED BY A FLAG, not by disabling the button on
 * click — a disabled button that never re-enables after a network failure
 * strands the reader with a form they cannot send.
 */
import '../../styles/assessment.css';
import { MARK } from '../academics/assessment/marks';
import { registrationFields, registrationSettings } from '../../data/alumniRegistration';

const { endpoint, successMessage, contactPhone, contactPhoneDisplay, contactEmail } = registrationSettings;
---

<form
  class="arf"
  novalidate
  data-arf
  data-endpoint={endpoint ?? ''}
  data-success={successMessage}
  data-phone={contactPhoneDisplay}
  aria-describedby="arf-live"
>
  <div class="arf-grid">
    {registrationFields.map((f) => {
      const id = `arf-${f.name}`;
      const err = `${id}-err`;
      return (
        <p class:list={['arf-f', f.wide && 'arf-f--wide']}>
          <label class="arf-lab" for={id}>
            {f.label}
            {f.required
              ? <span class="arf-req" aria-hidden="true">*</span>
              : <span class="arf-opt">optional</span>}
          </label>

          {f.type === 'textarea' ? (
            <textarea
              id={id}
              name={f.name}
              rows="4"
              placeholder={f.hint}
              data-required={f.required ? 'true' : undefined}
              aria-describedby={err}
            />
          ) : f.type === 'select' ? (
            <span class="arf-sel">
              <select id={id} name={f.name} data-required={f.required ? 'true' : undefined} aria-describedby={err}>
                <option value="">Select…</option>
                {f.options?.map((o) => <option value={o}>{o}</option>)}
              </select>
              <span class="arf-chev" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none"><path d="m6 9 6 6 6-6" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" /></svg>
              </span>
            </span>
          ) : (
            <input
              id={id}
              name={f.name}
              type={f.type}
              placeholder={f.hint}
              autocomplete={f.auto}
              inputmode={f.rule === 'phone' ? 'tel' : f.rule === 'year' ? 'numeric' : undefined}
              data-required={f.required ? 'true' : undefined}
              data-rule={f.rule}
              aria-describedby={err}
            />
          )}

          {/* Empty until it has something to say, so a screen reader is not told
              about an error that has not happened. */}
          <span class="arf-err" id={err} data-err-for={f.name}></span>
        </p>
      );
    })}

    {/* ⚠⚠ THE HONEYPOT. Its name must look worth filling to a bot and mean
        NOTHING to a browser's autofill — never `company`, `organization` or
        any other address-book word. The contact form used `company` and
        Chrome filled it for anyone with an employer saved, so the server threw
        real enquiries away as spam and answered 200. `autocomplete="off"`,
        being off-screen and tabindex="-1" do not prevent that; only the name
        and the label do. */}
    <div class="arf-hp" aria-hidden="true">
      <label for="arf-topicref">Topic reference</label>
      <input id="arf-topicref" name="topicRef" type="text" tabindex="-1" autocomplete="off" />
    </div>

    <p class="arf-f arf-f--wide arf-consent">
      <label class="arf-check" for="arf-consent">
        <input type="checkbox" id="arf-consent" name="consent" data-required="true" aria-describedby="arf-consent-err" />
        <span>I agree to be contacted by Sunbeam School Ballia about alumni meets.</span>
      </label>
      <span class="arf-err" id="arf-consent-err" data-err-for="consent"></span>
    </p>
  </div>

  <div class="arf-actions">
    <button type="submit" class="arf-submit" data-arf-submit>
      <span data-arf-label>Submit registration</span>
      <svg class="arf-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.arrow} />
      </svg>
      <span class="arf-spin" aria-hidden="true"></span>
    </button>

    <button type="reset" class="arf-reset" data-arf-reset>
      Reset
      <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
        <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.refresh} />
      </svg>
    </button>
  </div>

  {/* One live region for the whole form — status and failure both land here. */}
  <p class="arf-live" id="arf-live" role="status" aria-live="polite" data-arf-live></p>
</form>

<script>
  document.querySelectorAll<HTMLFormElement>('[data-arf]').forEach((form) => {
    const live = form.querySelector<HTMLElement>('[data-arf-live]');
    const submit = form.querySelector<HTMLButtonElement>('[data-arf-submit]');
    const label = form.querySelector<HTMLElement>('[data-arf-label]');
    const endpoint = form.dataset.endpoint || '';
    const phone = form.dataset.phone || 'the school office';
    let sending = false;

    const controls = Array.from(
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement>('[data-required], [data-rule]'),
    );

    const errorFor = (name: string) => form.querySelector<HTMLElement>(`[data-err-for="${name}"]`);

    /** One field's complaint, or '' when it is fine. */
    const check = (el: HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement): string => {
      const required = el.dataset.required === 'true';
      const rule = (el as HTMLInputElement).dataset.rule;

      if (el instanceof HTMLInputElement && el.type === 'checkbox') {
        return required && !el.checked ? 'Please tick this to continue.' : '';
      }

      const value = el.value.trim();
      if (required && !value) return 'This field is required.';
      if (!value) return '';

      /* ⚠ DELIBERATELY PERMISSIVE PATTERNS. A stricter address regex rejects
         valid mail; the job here is to catch a typo, not to police RFC 5322. */
      if (rule === 'email' && !/^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value)) {
        return 'Please enter a valid email address.';
      }
      if (rule === 'phone') {
        const digits = value.replace(/\D/g, '');
        if (digits.length < 10 || digits.length > 13) return 'Please enter a valid mobile number.';
      }
      if (rule === 'year') {
        const y = Number(value);
        const now = new Date().getFullYear();
        /* The Ballia campus opened in 2013, so nobody passed out of it before
           then — and a year in the future is a typo, not a leaver. */
        if (!/^\d{4}$/.test(value) || y < 2013 || y > now) {
          return `Please enter a passing year between 2013 and ${now}.`;
        }
      }
      return '';
    };

    const paint = (el: HTMLElement, msg: string) => {
      const box = errorFor((el as HTMLInputElement).name);
      if (box) {
        box.textContent = msg;
        box.classList.toggle('is-on', Boolean(msg));
      }
      el.setAttribute('aria-invalid', msg ? 'true' : 'false');
      el.closest('.arf-f')?.classList.toggle('has-err', Boolean(msg));
    };

    /* Validate on blur, then live once a field has already complained — so a
       reader is corrected as they fix it, but never scolded mid-word. */
    controls.forEach((el) => {
      el.addEventListener('blur', () => paint(el, check(el)));
      el.addEventListener('input', () => {
        if (el.getAttribute('aria-invalid') === 'true') paint(el, check(el));
      });
      el.addEventListener('change', () => {
        if (el.getAttribute('aria-invalid') === 'true' || el instanceof HTMLSelectElement) paint(el, check(el));
      });
    });

    const setBusy = (on: boolean) => {
      form.classList.toggle('is-sending', on);
      if (submit) submit.setAttribute('aria-busy', on ? 'true' : 'false');
      if (label) label.textContent = on ? 'Sending…' : 'Submit registration';
    };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      if (sending) return;

      let firstBad: HTMLElement | null = null;
      controls.forEach((el) => {
        const msg = check(el);
        paint(el, msg);
        if (msg && !firstBad) firstBad = el;
      });

      if (firstBad) {
        if (live) {
          live.textContent = 'Please correct the highlighted fields.';
          live.className = 'arf-live is-err';
        }
        (firstBad as HTMLElement).focus();
        return;
      }

      /* ⚠ NO ENDPOINT — SAY SO, DO NOT PRETEND. */
      if (!endpoint) {
        if (live) {
          live.innerHTML =
            'Your details are valid, but this form is <strong>not connected yet</strong> — nothing was sent and nothing was stored. ' +
            'To register today, please call the school office on ' + phone + '.';
          live.className = 'arf-live is-note';
          live.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        }
        return;
      }

      sending = true;
      setBusy(true);
      try {
        const res = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          /* ⚠ sourcePage IS ADDED HERE, NOT AS A HIDDEN INPUT. A hidden input
             is part of the form and a caller can set it to anything; this is
             read from the browser at the moment of sending. */
          body: JSON.stringify({
            ...Object.fromEntries(new FormData(form).entries()),
            sourcePage: location.pathname,
          }),
        });
        if (!res.ok) throw new Error(String(res.status));

        /* ⚠⚠ THE ORDER HERE IS LOAD-BEARING: RESET FIRST, THEN SPEAK.
           `form.reset()` fires a `reset` event, and the listener at the foot of
           this script clears the live region — which is right when a reader
           presses a reset button, and fatal here. Setting the message before
           the reset meant it was written and then wiped in the same tick: the
           registration was stored, 201 came back, and the screen said nothing
           at all. Do not move these three lines back above the reset. */
        form.reset();
        controls.forEach((el) => paint(el, ''));

        if (live) {
          live.textContent = form.dataset.success || 'Thank you.';
          live.className = 'arf-live is-ok';
        }
      } catch {
        if (live) {
          live.textContent =
            'Sorry — that could not be sent just now. Please try again, or call the school office on ' + phone + '.';
          live.className = 'arf-live is-err';
        }
      } finally {
        sending = false;
        setBusy(false);
        live?.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
      }
    });

    form.addEventListener('reset', () => {
      controls.forEach((el) => paint(el, ''));
      if (live) { live.textContent = ''; live.className = 'arf-live'; }
    });
  });
</script>

<style>
  .arf-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: clamp(12px, 1.5vw, 18px); }
  .arf-f { display: grid; gap: 5px; margin: 0; }
  .arf-f--wide { grid-column: 1 / -1; }

  .arf-lab {
    display: flex;
    align-items: baseline;
    gap: 6px;
    font-size: clamp(9.6px, 0.72vw, 11.4px);
    font-weight: 700;
    color: var(--sb-text-secondary);
  }
  .arf-req { color: var(--sb-orange-bright); }
  .arf-opt { font-size: clamp(8.4px, 0.62vw, 9.8px); font-weight: 400; font-style: italic; color: var(--sb-text-muted); }

  .arf-f input,
  .arf-f select,
  .arf-f textarea {
    width: 100%;
    padding: clamp(9px, 1.05vw, 13px) clamp(11px, 1.3vw, 15px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    color: var(--sb-charcoal);
    transition: border-color 200ms var(--sb-ease), box-shadow 200ms var(--sb-ease);
  }
  .arf-f textarea { resize: vertical; min-height: 92px; }
  .arf-f input::placeholder,
  .arf-f textarea::placeholder { color: var(--sb-text-muted); }
  .arf-f input:focus-visible,
  .arf-f select:focus-visible,
  .arf-f textarea:focus-visible {
    outline: none;
    border-color: var(--sb-orange-bright);
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--sb-orange-bright) 18%, transparent);
  }
  .arf-f.has-err input,
  .arf-f.has-err select,
  .arf-f.has-err textarea { border-color: #b3341a; }

  .arf-sel { position: relative; display: block; }
  .arf-sel select { appearance: none; padding-right: clamp(30px, 3vw, 38px); cursor: pointer; }
  .arf-chev {
    position: absolute;
    top: 50%;
    right: clamp(11px, 1.2vw, 15px);
    translate: 0 -50%;
    display: block;
    width: clamp(13px, 1.1vw, 16px);
    color: var(--sb-text-muted);
    pointer-events: none;
  }
  .arf-chev svg { display: block; width: 100%; height: auto; }

  /* Collapsed until it has text, so an empty span never adds a gap. */
  .arf-err { display: none; font-size: clamp(8.8px, 0.66vw, 10.4px); line-height: 1.5; color: #b3341a; }
  .arf-err.is-on { display: block; }

  .arf-consent { margin-top: clamp(2px, 0.5vw, 6px); }

  /* Off-screen rather than display:none — a field that is not rendered at all
     is one some bots skip, and the whole point is that they fill it. */
  .arf-hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .arf-check {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 9px;
    align-items: start;
    font-size: clamp(9.6px, 0.72vw, 11.4px);
    line-height: 1.6;
    color: var(--sb-text-secondary);
    cursor: pointer;
  }
  .arf-check input {
    width: 16px;
    height: 16px;
    margin-top: 1px;
    accent-color: var(--sb-orange-bright);
    cursor: pointer;
  }

  .arf-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(9px, 1.1vw, 14px);
    margin: clamp(16px, 2vw, 24px) 0 0;
  }
  .arf-submit {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 9px;
    padding: clamp(10px, 1.15vw, 14px) clamp(18px, 2vw, 27px);
    border: 1.5px solid var(--sb-orange-bright);
    border-radius: var(--sb-r-1);
    background: var(--sb-orange-bright);
    font: inherit;
    font-size: clamp(11px, 0.82vw, 13px);
    font-weight: 700;
    color: #fff;
    cursor: pointer;
    transition: background 220ms var(--sb-ease), border-color 220ms var(--sb-ease);
  }
  .arf-submit:hover { background: var(--sb-violet); border-color: var(--sb-violet); }
  .arf-arrow { width: 14px; height: auto; transition: transform 220ms var(--sb-ease); }
  .arf-submit:hover .arf-arrow { transform: translateX(3px); }

  .arf-spin {
    display: none;
    width: 13px;
    height: 13px;
    border: 2px solid rgba(255, 255, 255, 0.42);
    border-top-color: #fff;
    border-radius: 50%;
    animation: arf-turn 700ms linear infinite;
  }
  .is-sending .arf-spin { display: block; }
  .is-sending .arf-arrow { display: none; }
  .is-sending .arf-submit { pointer-events: none; opacity: 0.86; }
  @keyframes arf-turn { to { transform: rotate(360deg); } }

  .arf-reset {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    padding: clamp(10px, 1.15vw, 14px) clamp(15px, 1.7vw, 22px);
    border: 1px solid var(--sb-border-strong);
    border-radius: var(--sb-r-1);
    background: var(--sb-paper);
    font: inherit;
    font-size: clamp(10.5px, 0.78vw, 12.4px);
    font-weight: 700;
    color: var(--sb-text-secondary);
    cursor: pointer;
    transition: border-color 220ms var(--sb-ease), color 220ms var(--sb-ease);
  }
  .arf-reset svg { width: 13px; height: auto; }
  .arf-reset:hover { border-color: var(--sb-charcoal); color: var(--sb-charcoal); }

  .arf-live {
    display: none;
    margin: clamp(13px, 1.6vw, 19px) 0 0;
    padding: clamp(11px, 1.3vw, 15px) clamp(12px, 1.5vw, 17px);
    border: 1px solid var(--sb-border-strong);
    border-left: 3px solid var(--sb-border-strong);
    border-radius: var(--sb-r-2);
    background: var(--sb-sand);
    font-size: clamp(9.8px, 0.74vw, 11.6px);
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }
  .arf-live.is-note,
  .arf-live.is-ok,
  .arf-live.is-err { display: block; }
  .arf-live.is-note { border-left-color: var(--sb-orange-bright); background: var(--sb-violet-wash); }
  .arf-live.is-ok { border-left-color: #2f7d4f; background: #eef7f1; color: #205537; }
  .arf-live.is-err { border-left-color: #b3341a; background: #fdf0ec; color: #8a2a15; }

  @media (prefers-reduced-motion: reduce) {
    .arf-spin { animation-duration: 2s; }
    .arf-arrow { transition: none; }
  }

  @media (max-width: 639px) {
    .arf-grid { grid-template-columns: minmax(0, 1fr); }
    .arf-submit,
    .arf-reset { width: 100%; justify-content: center; }
  }
</style>
