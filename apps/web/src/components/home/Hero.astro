---
/**
 * §03 · HERO — docs/06 §03
 *
 * AUDIT 1.3, verbatim: "The hero banner should function as a stationary image
 * slider where only the images transition, rather than the entire page moving."
 * So: the frame, headline, deck and buttons are fixed. Only the photograph and
 * its own caption cross-fade — the caption belongs to the image.
 *
 * The eyebrow carries the school's real motto, read off the crest ring on the
 * official logo artwork ("DUTY · DEVOTION · DISCIPLINE"). Text extraction never
 * surfaced it; it exists only in the emblem. It is the single most
 * Sunbeam-specific line available and it replaces a generic name-and-year
 * eyebrow that merely repeated the masthead.
 */
import { getHero } from '../../lib/cms';
import AccentHeading from '../ui/AccentHeading.astro';
import Photo from '../ui/Photo.astro';
/* ⚠ THE CLIENT'S OWN BANNER SET, src/assets/banners/ — ALL NINE OF THEM.
   The folder holds ten files, but banner10.jpg is byte-identical to
   banner2.jpg (same MD5, same 346,606 bytes), so there are nine distinct
   photographs and the tenth can never add a frame. */

const { eyebrow, title, deck, actions, stats, slides } = await getHero();

/**
 * ⚠⚠ THE STUDENTS PHOTOGRAPH LEADS NOW, and the poster is gone entirely.
 *
 * The client asked for students in the hero so the page reads as a school at
 * first glance. Slide one is a Class IX/X chemistry practical — the school's own
 * lab, its own uniform, its own blackboard dated 20 NOV 2025. It is the only
 * supplied photograph that shows learning actually happening, which is what
 * audit 1.1 asked for and what docs/07 § A2 recorded as still owed. That request
 * is now closed.
 *
 * ⚠ AND IT REPLACES THE RoboWunder POSTER, which fixes a real defect rather than
 * just reordering. That slide was a finished poster with typography baked into
 * it, and a full-bleed hero crop sliced the wording into fragments — "nbeam",
 * "OOL BALLIA", "ONAL ROBOTICS CHAMPI" — competing with the headline in the same
 * frame. Two headlines, neither readable. A poster cannot survive being cropped
 * to 21:9; a photograph can.
 *
 * ⚠ THE ROBOTICS RESULT IS NOT LOST. It is still published on Achievements and
 * on the STEM & Robotics page, where it is shown at its own aspect ratio and can
 * actually be read.
 */
/**
 * ⚠ EVERY CAPTION AND alt HERE WAS WRITTEN FROM THE PHOTOGRAPH, NOT FROM ITS
 * FILENAME. banner1.jpg says nothing about what banner1 shows; each of these
 * was opened and described from what is actually in frame. Where a frame's
 * occasion is not legible in it — banner3, the podcast studio — the line says
 * what can be seen and stops. No event name, date or result is inferred.
 *
 * ⚠ ALL NINE DISTINCT BANNERS ARE IN THE ROTA. The tenth file is a duplicate
 * (see the import note), so ten slides is the most this set can produce.
 *
 * ⚠ THE ORDER IS NOT THE FILE ORDER. Frames full of children lead, and the
 * three that are mostly adults — the studio, the mementoes, the release — sit
 * at the back, because a visitor rarely reaches slide eight and the first
 * three have to say "school" on their own.
 *
 * ⚠ THE PRACTICAL STAYS AT SLIDE ONE. The client asked for students in the hero
 * so the page reads as a school at first glance, and it is the only frame on
 * hand that shows learning happening rather than an occasion being marked. The
 * banners are all occasions.
 */
---

<section class="hero" data-hero aria-label="Welcome to Sunbeam School Ballia">
  <div class="hero__stage">
    {slides.map((slide, i) => (
      <div
        class="hero__slide"
        data-slide
        data-caption={slide.caption ?? slide.brief}
        data-caption-tag={slide.caption ? '' : 'Needed · A2'}
        data-active={i === 0 ? '' : undefined}
        aria-hidden={i !== 0}
      >
        <Photo
          file={slide.image}
          alt={slide.alt}
          brief={slide.brief}
          tone={slide.tone}
          position={slide.position}
          ref="A2"
          quiet
          eager={i === 0}
          sizes="100vw"
        />
      </div>
    ))}
    <div class="hero__tint" aria-hidden="true"></div>
    <div class="hero__scrim" aria-hidden="true"></div>
  </div>

  <div class="hero__content u-container u-on-dark">
    <div class="hero__copy">
      {/* ⚠ THE ADMISSIONS BADGE IS GONE FROM THE HERO. The client asked for
          Admissions in the header and nowhere on the main page — this pill was
          the last piece of it left, announcing the intake directly above a
          headline that is about the school, not the intake. The header button
          carries that message now.
          ⚠ The .hero__badge / .hero__badge-dot styles are left in place: they
          cost nothing unused, and this is the kind of thing that comes back for
          one admissions season. */}
      <p class="hero__eyebrow t-label">{eyebrow}</p>
      <AccentHeading
        tag="h1"
        class="hero__title t-display"
        split
        accentClass="t-squiggle--lime"
        breakClass="hero__br"
        text={title}
      />
      <p class="hero__deck t-body-lg">{deck}</p>
      {/* ⚠ THE TWO APPLICATION FORMS, NOT AN ADMISSIONS PAGE. The school has no
          admissions page of its own — what it publishes is these two forms, one
          per intake, named exactly this way in its own top bar. The hero now
          offers the same two actions rather than routing a parent through a
          page the school does not have.
          ⚠ SAME URLS THE UTILITY BAR USES — applyForm*, the session-coded forms
          the school itself links, not the generic /apply-online/ landing page.
          ⚠ NEW TAB WITH rel=noopener: both forms are on another host, and a
          parent part-way through one should not lose the school site behind. */}
      {/* ⚠⚠ NO APPLY BUTTONS HERE ANY MORE. The client asked that Admissions
          live in the header and NOT on the main page, so the one place to apply
          is the header button and the utility bar above it. Repeating it here
          was the duplication they were pointing at.
          These two go where the hero used to send people before the apply links
          briefly took the slot — both real, finished pages. */}
      <div class="hero__actions">
        {actions.map((a, i) => (
          <a class={`btn ${i === 0 ? 'btn--on-image-primary' : 'btn--on-image-secondary'}`} href={a.href}>{a.label}</a>
        ))}
      </div>

      {/* Floating stat card — reference hero pattern. Verified figures only. */}
      <div class="hero__stats">
        {stats.map((stat) => (
          <div class="hero__stat">
            <span class="hero__stat-value">{stat.value}</span>
            <span class="hero__stat-label">{stat.label}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="hero__meta">
      <p class="hero__caption" data-hero-caption aria-live="off">
        <span class="hero__caption-tag t-label">{slides[0].caption ? '' : 'Needed · A2'}</span>
        <span class="hero__caption-text">{slides[0].caption ?? slides[0].brief}</span>
      </p>

      {/* ⚠ THE DOT ROW IS GONE, THE PAUSE CONTROL IS ONLY HIDDEN — and that
          distinction is deliberate. The client asked for the strip of dashes
          and the button to come off the banner, and the dashes are pure
          decoration: they are gone from the markup entirely.

          The button is not decoration. The hero advances on its own every
          4.5s, and WCAG 2.2.2 requires any auto-updating content that runs
          longer than five seconds to offer a way to stop it. Deleting the only
          such control would be a real accessibility failure, not a tidy-up.

          So it is positioned out of the layout at opacity 0 — still in the tab
          order, still announced, still operable — and it fades in at its old
          place the moment it takes keyboard focus. Nothing shows on the banner
          until someone actually reaches for the control.

          The other two guards were already in the script and still hold:
          autoplay never starts under prefers-reduced-motion, and never starts
          below 768px at all. */}
      <button class="hero__pause" type="button" data-hero-pause aria-label="Pause image slideshow">
        <svg class="hero__icon-pause" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
          <rect x="0" y="0" width="3" height="12" fill="currentColor" />
          <rect x="7" y="0" width="3" height="12" fill="currentColor" />
        </svg>
        <svg class="hero__icon-play" width="10" height="12" viewBox="0 0 10 12" aria-hidden="true">
          <path d="M0 0L10 6L0 12Z" fill="currentColor" />
        </svg>
      </button>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: clamp(600px, calc(100svh - 140px), 820px);
    background: var(--sb-ink);
    isolation: isolate;
  }

  /* --- Image stage ------------------------------------------------------- */

  .hero__stage {
    position: absolute;
    inset: 0;
    overflow: hidden;
    z-index: 0;
  }

  .hero__slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    /* Audit 1.3 — opacity only. Nothing translates, nothing scales. */
    transition: opacity var(--sb-dur-fade) ease-in-out;
  }

  .hero__slide[data-active] { opacity: 1; }

  /* Square. <Photo> carries a 16px radius for the card contexts it usually sits
     in; a full-bleed banner is not one of those, and the rounded corners showed
     against the stage. */
  .hero__slide :global(.photo) { border-radius: 0; }

  /* Warm the photography toward the brand without tinting it into a filter.
     Kept light: a heavy maroon wash makes the whole frame read as sepia, and
     this school needs to look current, not archival. */
  .hero__tint {
    position: absolute;
    inset: 0;
    background: rgba(61, 0, 0, 0.12);
  }

  /* Two-axis scrim.
     The stock bottom-weighted scrim assumes a photograph that darkens toward
     the base. The real campus shot is bright at BOTH ends — sky above, sunlit
     grass below — and it left the gold eyebrow effectively invisible and the
     headline marginal.
     So the vertical scrim is joined by a left-weighted one, which lands exactly
     where the copy sits (columns 1–7) and clears by the two-thirds mark, so the
     buildings on the right stay fully legible. */
  .hero__scrim {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        to right,
        rgba(18, 16, 15, 0.9) 0%,
        rgba(18, 16, 15, 0.82) 30%,
        rgba(18, 16, 15, 0.52) 50%,
        rgba(18, 16, 15, 0.16) 70%,
        rgba(18, 16, 15, 0) 84%
      ),
      linear-gradient(
        to top,
        rgba(18, 16, 15, 0.78) 0%,
        rgba(18, 16, 15, 0.4) 30%,
        rgba(18, 16, 15, 0.16) 60%,
        rgba(18, 16, 15, 0.26) 100%
      );
  }

  /* On narrow screens the copy spans the full width, so the horizontal ramp
     would leave the right-hand words sitting on bare photograph. */
  /* From tablet down the copy spans most of the width, so the horizontal ramp
     no longer covers it and the vertical one has to do all the work. */
  @media (max-width: 1023px) {
    /* The copy block reaches roughly 70% up the frame here, and a worst-case
       white building behind white text needs ~0.82 alpha to clear 4.5:1. So the
       ramp stays heavy to the 78% mark and only releases above it, where the
       photograph is left to read on its own. */
    .hero__scrim {
      background:
        linear-gradient(
          to top,
          rgba(18, 16, 15, 0.92) 0%,
          rgba(18, 16, 15, 0.88) 55%,
          rgba(18, 16, 15, 0.8) 78%,
          rgba(18, 16, 15, 0.46) 92%,
          rgba(18, 16, 15, 0.34) 100%
        );
    }
  }

  /* --- Content ----------------------------------------------------------- */

  .hero__content {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(var(--sb-cols), minmax(0, 1fr));
    column-gap: var(--sb-gutter);
    align-items: end;
    padding-block: var(--sb-11);
  }

  /* Asymmetric: columns 1–7 of 12. Never centred. */
  .hero__copy {
    /* Columns 1–8. .hero__meta holds 9–12, so column 8 was simply unused, and
       the title needs it: "Where Ballia's children" is 780px at 76px against a
       737px seven-column measure. */
    grid-column: 1 / span 8;
  }

  .hero__badge {
    margin-bottom: var(--sb-6);
    backdrop-filter: blur(6px);
  }

  .hero__badge-dot {
    width: 8px;
    height: 8px;
    border-radius: var(--sb-r-full);
    background: var(--sb-lime);
    flex-shrink: 0;
  }

  /* Floating stat card — reference hero pattern. */
  .hero__stats {
    display: inline-flex;
    align-items: stretch;
    gap: var(--sb-7);
    margin-top: var(--sb-8);
    padding: var(--sb-6) var(--sb-7);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.2);
    border-radius: var(--sb-r-2);
    backdrop-filter: blur(10px);
  }

  .hero__stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .hero__stat + .hero__stat {
    padding-left: var(--sb-7);
    border-left: 1px solid rgba(255, 255, 255, 0.22);
  }

  .hero__stat-value {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: 30px;
    line-height: 1.1;
    letter-spacing: -0.03em;
    color: #fff;
  }

  .hero__stat-label {
    font-size: var(--sb-caption);
    color: rgba(255, 255, 255, 0.82);
  }

  /* The motto is set in white, not gold.
     Measured over the real campus photograph, gold ran at 2.89:1 average and
     1.31:1 at worst — and the fix is not a heavier scrim: gold (#C9A227, L=0.38)
     needs a ground darker than L=0.046 to clear 4.5:1, which would mean blacking
     out the photograph entirely. Gold stays as the rule above, where it is
     decoration rather than text. */
  .hero__eyebrow {
    color: #fff;
    margin-bottom: var(--sb-6);
  }

  /**
   * WARNING: :global BECAUSE ANOTHER COMPONENT RENDERS THIS ELEMENT.
   *
   * Astro scopes a component’s CSS by stamping data-astro-cid-* on the elements
   * in its OWN template. The h1 here is rendered by AccentHeading, so it carries
   * AccentHeading’s attribute and not this file’s - and every .hero__title rule
   * below silently matched nothing. The heading fell back to the page’s dark
   * default text colour and sat black on a dark photograph, along with losing its
   * measure, its margin and both of its breakpoints.
   *
   * ⚠ Passing a class INTO a component does not carry the caller’s scope with it.
   */
  :global(.hero__title) {
    color: #fff;
    /* FLUID, so the chosen break holds at every width rather than only at the
       two where it happened to fit.
       Line 1 is a constant 10.26em ("Where Ballia's children" at this tracking),
       and the eight-column measure is about 0.58vw. 5.2vw keeps 10.26em inside
       that at every size in the range — a fixed 76px did not: it needed 780px
       against 762px at 1240, and broke into three lines there while looking
       correct at 1200.
       No max-width: a measure's only job here would be to stop line 1 fitting,
       and `text-wrap: balance` is gone because balancing fights a break we
       have already chosen. */
    font-size: clamp(40px, 5.2vw, 76px);
    max-width: none;
    margin-bottom: var(--sb-6);
  }

  .hero__deck {
    color: var(--sb-on-dark-90);
    max-width: 46ch;
    margin-bottom: var(--sb-8);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-4);
  }

  /* --- Meta: editorial caption + controls, bottom right ------------------ */

  .hero__meta {
    position: relative; /* anchors the hidden pause control */
    grid-column: 9 / span 4;
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sb-5);
    text-align: right;
  }

  .hero__caption {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: var(--sb-2);
    padding-right: var(--sb-5);
    border-right: 2px solid var(--sb-gold);
    transition: opacity var(--sb-dur-fade) ease-in-out;
  }

  .hero__caption.is-fading { opacity: 0; }

  .hero__caption-tag { color: var(--sb-gold); }

  .hero__caption-text {
    font-size: var(--sb-caption);
    line-height: 1.45;
    color: var(--sb-on-dark-78);
    max-width: 34ch;
  }

  /* ⚠ ABSOLUTE AND opacity: 0, NOT display: none OR visibility: hidden.
     Either of those would drop it out of the tab order, which is the one thing
     that must not happen — it is the page's only way to stop the slideshow.
     Absolute keeps it out of the flow, so .hero__meta lays out exactly as if
     the control were not there. */
  .hero__pause {
    position: absolute;
    right: 0;
    bottom: calc(-1 * var(--sb-8, 44px) - 12px);
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    color: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: var(--sb-r-1);
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--sb-dur-btn) ease, color var(--sb-dur-btn) ease,
      border-color var(--sb-dur-btn) ease;
  }

  /* It appears the instant somebody reaches for it, and not before. */
  .hero__pause:focus-visible {
    opacity: 1;
    pointer-events: auto;
  }

  .hero__pause:hover { color: #fff; border-color: rgba(255, 255, 255, 0.6); }

  .hero__icon-play { display: none; }
  .hero__pause[data-paused] .hero__icon-play { display: block; }
  .hero__pause[data-paused] .hero__icon-pause { display: none; }

  /* --- Tablet ------------------------------------------------------------- */

  @media (max-width: 1023px) {
    .hero__copy { grid-column: 1 / span 6; }
    .hero__meta { grid-column: 7 / span 2; }
    :global(.hero__title) { max-width: none; }
  }

  /* Below ~900 the caption competes with the deck for the same optical line. */
  @media (max-width: 899px) {
    .hero__caption-text { display: none; }
    .hero__caption { border-right: 0; padding-right: 0; }
    .hero__caption-tag { color: rgba(255, 255, 255, 0.5); }
  }

  /* --- Mobile: 4:5 crop, stacked actions, controls below copy ------------- */

  /* The type size bottoms out at 40px, so below roughly 480 the first line can
     no longer fit however wide the column is. The chosen break is dropped there
     and the heading wraps naturally. */
  @media (max-width: 479px) {
    :global(.hero__br) { display: none; }
  }

  @media (max-width: 767px) {
    .hero {
      min-height: clamp(560px, 84svh, 680px);
      align-items: flex-end;
    }

    .hero__content {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      padding-block: var(--sb-9);
      gap: var(--sb-7);
    }

    .hero__badge { margin-bottom: var(--sb-5); font-size: 12px; }
    .hero__eyebrow { margin-bottom: var(--sb-5); }
    .hero__stats {
      display: flex;
      width: 100%;
      gap: var(--sb-5);
      padding: var(--sb-5);
      margin-top: var(--sb-7);
    }
    .hero__stat + .hero__stat { padding-left: var(--sb-5); }
    .hero__stat-value { font-size: 22px; }
    .hero__stat-label { font-size: 11px; }
    :global(.hero__title) { max-width: none; margin-bottom: var(--sb-5); }
    .hero__deck { max-width: none; margin-bottom: var(--sb-7); }

    .hero__actions { flex-direction: column; }
    .hero__actions .btn { width: 100%; }

    .hero__meta {
      align-items: flex-start;
      text-align: left;
      gap: 0;
    }

    .hero__caption { display: none; }

    /* Auto-advance never runs at this width, so a pause control would be a
       button that does nothing — and dropping it from the tab order here is
       safe for exactly that reason. Swiping still moves the slider. */
    .hero__pause { display: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]');

  if (hero) {
    const slides = Array.from(hero.querySelectorAll<HTMLElement>('[data-slide]'));
    const dots = Array.from(hero.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const pauseBtn = hero.querySelector<HTMLButtonElement>('[data-hero-pause]');
    const caption = hero.querySelector<HTMLElement>('[data-hero-caption]');
    const captionText = caption?.querySelector<HTMLElement>('.hero__caption-text');
    const captionTag = caption?.querySelector<HTMLElement>('.hero__caption-tag');

    // A real photograph gets an editorial caption; a slot still awaiting one
    // keeps showing its shot brief under a "Needed" tag.
    const captions = slides.map((slide) => ({
      text: slide.dataset.caption ?? '',
      tag: slide.dataset.captionTag ?? '',
    }));

    const INTERVAL = 4500;
    let index = 0;
    let timer: number | undefined;
    let userPaused = false;

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    // Auto-advance is desktop-only and motion-respecting (docs/06 §03 Mobile).
    const mayAutoplay = () =>
      !reduced.matches && window.matchMedia('(min-width: 768px)').matches && !userPaused;

    const show = (next: number) => {
      if (next === index) return;
      slides[index].removeAttribute('data-active');
      slides[index].setAttribute('aria-hidden', 'true');
      dots[index]?.setAttribute('aria-current', 'false');

      index = (next + slides.length) % slides.length;

      slides[index].setAttribute('data-active', '');
      slides[index].setAttribute('aria-hidden', 'false');
      dots[index]?.setAttribute('aria-current', 'true');

      // The caption belongs to the image, so it cross-fades with it.
      if (caption && captionText && captionTag) {
        caption.classList.add('is-fading');
        window.setTimeout(() => {
          captionText.textContent = captions[index].text;
          captionTag.textContent = captions[index].tag;
          caption.classList.remove('is-fading');
        }, 450);
      }
    };

    const stop = () => {
      if (timer) window.clearInterval(timer);
      timer = undefined;
    };

    const start = () => {
      stop();
      if (!mayAutoplay()) return;
      timer = window.setInterval(() => show(index + 1), INTERVAL);
    };

    dots.forEach((dot, i) =>
      dot.addEventListener('click', () => {
        show(i);
        start();
      })
    );

    pauseBtn?.addEventListener('click', () => {
      userPaused = !userPaused;
      pauseBtn.toggleAttribute('data-paused', userPaused);
      pauseBtn.setAttribute(
        'aria-label',
        userPaused ? 'Play image slideshow' : 'Pause image slideshow'
      );
      if (userPaused) stop();
      else start();
    });

    // Pause on hover and on keyboard focus.
    hero.addEventListener('mouseenter', stop);
    hero.addEventListener('mouseleave', start);
    hero.addEventListener('focusin', stop);
    hero.addEventListener('focusout', start);

    // Swipe — the only way to advance on mobile.
    let touchX = 0;
    hero.addEventListener(
      'touchstart',
      (event) => { touchX = event.changedTouches[0].clientX; },
      { passive: true }
    );
    hero.addEventListener(
      'touchend',
      (event) => {
        const delta = event.changedTouches[0].clientX - touchX;
        if (Math.abs(delta) > 48) show(index + (delta < 0 ? 1 : -1));
      },
      { passive: true }
    );

    reduced.addEventListener('change', start);
    start();
  }
</script>
