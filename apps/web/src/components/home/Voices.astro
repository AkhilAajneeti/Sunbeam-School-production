---
/**
 * §12 · ALUMNI — audit §13
 *
 * Three infinite marquee rows, adjacent rows travelling in opposite directions.
 * The avatar sits on the right of every card.
 *
 * CONTAINMENT: the rows live inside the standard site container and each row
 * clips at the container edge, not the viewport. That is the difference from
 * the earlier version — no full-bleed, no negative margins, so cards are never
 * cut off against the screen edge. Edge masks fade them in and out.
 *
 * Motion is CSS-only: each track holds the set twice and translates -50%, so
 * the loop is seamless without JavaScript measuring anything.
 *
 * WCAG 2.2.2 — KNOWN GAP, client decision. The success criterion wants a pause
 * mechanism for content that moves for more than five seconds, and this had a
 * real button. The client asked for it to be removed, so what remains is:
 *   · pause on hover and on keyboard focus (`:focus-within`)
 *   · prefers-reduced-motion stops the animation entirely and turns each row
 *     into a plain horizontal scroller
 * That covers pointer users, keyboard users and anyone with reduced motion set,
 * but it is not a substitute for an always-available control. If an audit flags
 * it, restore the button — it lived in a `.voices__foot` under the rows.
 *
 * CONTENT: `voices.items` is empty, so cards render their empty state. Quotes
 * attributed to named students of a real school are not ours to write — see
 * docs/08 D19. Fill `items` in data/home.ts and every card populates.
 */
import { getVoices } from '../../lib/cms';
import AccentHeading from '../ui/AccentHeading.astro';
import { getAlumni } from '../../lib/cms';
import CmsImage from '../ui/CmsImage.astro';

import { showBuildNotes } from '../../data/site';

const voices = await getVoices();

/* ⚠ FROM STRAPI NOW, NOT data/alumni.ts. The same three cards, and `a.video`
   still drives the hover film exactly as before — it is a path on the alumnus,
   not media, because the school supplies these as external links rather than
   uploads. The old data file remains on disk until this is verified in a
   production build. */
const alumni = await getAlumni();

/**
 * Cloud edges. Built from overlapping circles rather than one hand-written path
 * — circles of the same opaque fill merge into a single silhouette, so the
 * shape stays editable (nudge a radius, get a different cloud) instead of being
 * an unreadable string of bezier coordinates.
 *
 * Clustered into five masses with shallow valleys between them. An evenly
 * spaced row of similar circles reads as a scalloped border; real cloud has a
 * big central billow with smaller puffs shouldering it, and gaps between.
 */
const cloudTop = [
  { cx: 34, cy: 44, r: 46 }, { cx: 122, cy: 38, r: 72 }, { cx: 214, cy: 42, r: 52 },
  { cx: 272, cy: 32, r: 34 },
  { cx: 352, cy: 38, r: 50 }, { cx: 446, cy: 34, r: 84 }, { cx: 548, cy: 36, r: 58 },
  { cx: 604, cy: 30, r: 32 },
  { cx: 690, cy: 38, r: 44 }, { cx: 772, cy: 40, r: 72 }, { cx: 856, cy: 38, r: 54 },
  { cx: 908, cy: 30, r: 30 },
  { cx: 996, cy: 38, r: 48 }, { cx: 1088, cy: 32, r: 88 }, { cx: 1188, cy: 36, r: 60 },
  { cx: 1248, cy: 30, r: 34 },
  { cx: 1320, cy: 38, r: 42 }, { cx: 1394, cy: 40, r: 66 }, { cx: 1448, cy: 42, r: 44 },
];

const cloudBottom = [
  { cx: 30, cy: 40, r: 52 }, { cx: 116, cy: 34, r: 80 }, { cx: 208, cy: 38, r: 48 },
  { cx: 262, cy: 30, r: 30 },
  { cx: 338, cy: 40, r: 44 }, { cx: 412, cy: 38, r: 68 }, { cx: 496, cy: 34, r: 56 },
  { cx: 560, cy: 30, r: 34 },
  { cx: 648, cy: 36, r: 52 }, { cx: 748, cy: 32, r: 86 }, { cx: 848, cy: 36, r: 58 },
  { cx: 906, cy: 30, r: 32 },
  { cx: 984, cy: 40, r: 46 }, { cx: 1066, cy: 38, r: 70 }, { cx: 1152, cy: 40, r: 50 },
  { cx: 1212, cy: 32, r: 32 },
  { cx: 1298, cy: 36, r: 54 }, { cx: 1390, cy: 34, r: 78 }, { cx: 1452, cy: 40, r: 46 },
];

/* The marquee maths is gone with the marquee. `voices` still supplies the
   eyebrow and the deck. */
---

<section class="voices" data-voices aria-labelledby="voices-heading">
  {/* Cloud edges. Filled with --sb-sand, the colour of the sections ABOVE and
      BELOW — that is what makes the band melt into its neighbours instead of
      reading as a separate slab dropped onto the page. Purely decorative, so
      hidden from assistive tech. */}
  <span class="voices__edge voices__edge--top" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="none" focusable="false">
      <rect x="0" y="0" width="1440" height="32" />
      {cloudTop.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
    </svg>
  </span>

  <span class="voices__edge voices__edge--bottom" aria-hidden="true">
    <svg viewBox="0 0 1440 130" preserveAspectRatio="none" focusable="false">
      <rect x="0" y="0" width="1440" height="32" />
      {cloudBottom.map((c) => <circle cx={c.cx} cy={c.cy} r={c.r} />)}
    </svg>
  </span>

  <div class="u-container">
    <div class="voices__head" data-reveal>
      <p class="voices__eyebrow pill pill--violet">{voices.eyebrow}</p>
      <AccentHeading class="voices__heading t-h2-sans" id="voices-heading" split text={voices.heading} />
      <p class="voices__deck t-body-lg">{voices.deck}</p>
    </div>

    {/* ⚠ THREE MARQUEE ROWS OF EMPTY QUOTE CARDS USED TO SIT HERE — nine slots
        reading "Quote to be supplied by the school", 1,046px of homepage. An
        empty testimonial wall is not neutral: a parent reads it as a school
        whose former students will not vouch for it, in the exact place the
        audit wants trust built.

        ⚠ AND IT WAS THE WRONG SUBJECT. It was headed "Student Voices"; audit
        §13 asks for ALUMNI, and three of its four criteria — current
        profession, higher education journey, career achievements — are things
        a current pupil cannot answer. It also wanted a named minor's
        photograph and quote, which is the harder consent case (C5), in order
        to satisfy a requirement about adults who can consent for themselves
        (C6). The audit never asks for student testimonials anywhere. */}
    <ul class="acards">
      {alumni.map((a) => (
        <li>
          <article class="acard" data-acard data-video={a.video ?? undefined}>
            <div class="acard__media">
              <CmsImage
                file={a.poster}
                alt={a.alt}
                sizes="(max-width: 640px) 78vw, 300px"
                fallbackWidth={420}
                loading="lazy"
              />

              {/* Ships empty. The script inserts a <video> only where one is
                  supplied, so a card with no film carries no dead player. */}
              <span class="acard__player" data-acard-player></span>

              {a.video && (
                <span class="acard__play" aria-hidden="true">
                  <svg width="20" height="22" viewBox="0 0 18 20" fill="currentColor">
                    <path d="M17 8.27a2 2 0 0 1 0 3.46L3 19.79A2 2 0 0 1 0 18.06V1.94A2 2 0 0 1 3 .21l14 8.06Z" />
                  </svg>
                </span>
              )}
            </div>

            {/* ⚠ NO VISIBLE CAPTION — client instruction: the card is the
                artwork, as in the supplied reference, and becomes the video
                frame the moment a film is supplied.

                THE DETAIL IS NOT LOST. Every fact that used to be printed here
                — name, degree, institution, employer — is carried in the image
                alt, so a screen reader still hears "…alumni card for Sudhanshu
                Raj Mishra — B.Tech, Bangalore Institute of Technology, placed
                at GE Aerospace". It is also still typeset inside the school's
                own artwork, which is what a sighted reader is looking at.
                Removing the caption removed a duplicate, not the information.

                ⚠ ONE CONDITION ON THAT, AND IT MATTERS LATER. When video
                arrives the poster stays as the video's poster frame, so the
                name still appears before playback. If a film is ever supplied
                WITHOUT that artwork behind it, this caption has to come back —
                otherwise the card names nobody, on screen or to a reader. */}
          </article>
        </li>
      ))}
    </ul>

    {showBuildNotes && (
      <p class="voices__note">
        <strong>Three alumni, every field read off the school's own cards.</strong>
        What none of them carries is the alumnus speaking about Sunbeam — audit 13.6 —
        which is asset request <strong>A4</strong> and needs written consent as much as
        it needs a camera. Add a <code>video</code> path to any entry in
        <code>data/alumni.ts</code> and that card plays it on hover.
      </p>
    )}
  </div>
</section>

<style>
  /* Two very low-saturation washes — cool on the left, warm on the right —
     over the page ground. Kept faint on purpose: the moment a tint is strong
     enough to notice as a colour, the band stops reading as atmosphere and
     starts reading as a coloured box.

     The flat --sb-ivory is the LAST layer, so it is also the computed
     background-color. That matters: the contrast audit resolves grounds from
     `backgroundColor`, and a gradient-only background would resolve to
     transparent and silently skip every text node in this section. */
  .voices {
    /* The cloud edges are absolutely positioned INSIDE the section's padding,
       so they eat it: at 120px padding and a 108px cloud, only 12px of clear
       space was left between the cards and the silhouette — which is what made
       the band feel cramped top and bottom.
       Padding is therefore section rhythm PLUS the cloud height, so the clear
       space either side matches every other section on the page. */
    --cloud-h: clamp(52px, 7.5vw, 108px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background:
      radial-gradient(62% 78% at 10% 38%, rgba(163, 191, 232, 0.28), transparent 68%),
      radial-gradient(58% 74% at 90% 58%, rgba(255, 176, 148, 0.30), transparent 68%),
      var(--sb-ivory);
    /* ⚠ `--sb-section-y`, NOT section-y PLUS the cloud height. That calc gave
       this section 228px top and bottom against every other section's 120, and
       it double-counted: docs/08 D25 sized the cloud edge to be SHORTER than the
       padding on purpose — 108 against 120 at desktop, 52 against 64 on mobile —
       precisely so the clouds live IN the breathing space rather than needing
       their own. Adding it again bought 216px of nothing and made the band
       above the alumni cards read as a hole. */
    padding-block: var(--sb-section-y);
  }

  /* --- Cloud edges ---------------------------------------------------------- */

  .voices__edge {
    position: absolute;
    left: 0;
    right: 0;
    z-index: -1;
    /* Always shorter than the section's own padding, so the clouds sit in the
       breathing space and never collide with the heading:
       108px against 120px padding at desktop, 52px against 64px at mobile. */
    height: var(--cloud-h);
    line-height: 0;
    pointer-events: none;
  }

  .voices__edge svg {
    display: block;
    width: 100%;
    height: 100%;
    fill: var(--sb-sand);
  }

  .voices__edge--top { top: 0; }

  /* Mirrored rather than a second SVG — the two puff sets already differ, so
     flipping gives a distinct silhouette without more markup. */
  .voices__edge--bottom { bottom: 0; transform: scaleY(-1); }

  /* --- Header, centred ----------------------------------------------------- */

  .voices__head {
    max-width: 62ch;
    margin-inline: auto;
    margin-bottom: var(--sb-9);
    text-align: center;
  }

  .voices__eyebrow { margin-bottom: var(--sb-6); }

  .voices__heading {
    color: var(--sb-charcoal);
    margin-bottom: var(--sb-heading-gap);
  }

  /* One step darker than the usual deck muted grey. The blue wash puts this
     text on a ground of roughly rgb(227,232,241) at its worst point, where
     --sb-text-muted measured 4.46:1 at 768 — a hair under AA. Sampled from
     rendered pixels, not from the computed background-color, which reports flat
     ivory and cannot see a gradient at all. */
  .voices__deck {
    color: var(--sb-text-secondary);
    max-width: 54ch;
    margin-inline: auto;
  }

  /* --- Alumni cards ---------------------------------------------------------
     Three portrait cards in a row, per the client's reference. The three
     marquee rows and their pill cards are gone; the cloud edges, the wash, the
     centred header and the section rhythm are untouched, as asked. */

  .acards {
    list-style: none;
    margin: clamp(34px, 5vh, 58px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(16px, 2vw, 30px);
    max-width: 1000px;
    margin-inline: auto;
  }

  .acard {
    display: flex;
    flex-direction: column;
    border-radius: var(--sb-r-2);
    overflow: hidden;
    background: var(--sb-paper);
    box-shadow: inset 0 0 0 1px var(--sb-border);
    transition: transform var(--sb-dur-link) var(--sb-ease), box-shadow var(--sb-dur-link) ease;
  }

  .acard:hover,
  .acard:focus-within {
    transform: translateY(-4px);
    box-shadow: inset 0 0 0 1px transparent, var(--sb-shadow-card-hover);
  }

  /* ⚠ `contain`, NOT `cover`. These are the school's own designed cards — crest,
     "OUR ALUMNI" title, a name banner and the employer's logo — and the three
     are different shapes (4:5 and 5:7). Cropping them to a common frame would
     slice the name off one and the employer off another, which is the same rule
     the award posters on Achievements follow. */
  .acard__media {
    position: relative;
    aspect-ratio: 4 / 5;
    background: var(--sb-sand);
    overflow: hidden;
  }

  .acard__media :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: opacity 320ms ease;
  }

  /* The film, inserted by the script only where one exists. It sits over the
     poster and fades in, so there is never a black frame while it buffers. */
  .acard__player {
    position: absolute;
    inset: 0;
  }

  .acard__player :global(video) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transition: opacity 320ms ease;
  }

  .acard[data-playing] .acard__player :global(video) { opacity: 1; }

  .acard__play {
    position: absolute;
    left: 50%;
    top: 50%;
    translate: -50% -50%;
    display: grid;
    place-items: center;
    width: 62px;
    height: 62px;
    border-radius: var(--sb-r-full);
    background: rgba(255, 255, 255, 0.82);
    color: var(--sb-violet);
    backdrop-filter: blur(2px);
    padding-left: 4px; /* optical: a triangle reads left-heavy when centred */
    transition: opacity 260ms ease, transform 260ms var(--sb-ease);
  }

  .acard:hover .acard__play { opacity: 0; transform: translate(0, 0) scale(0.9); }

  @media (min-width: 640px) {
    .acards { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .voices__note {
    margin: var(--sb-8) 0 0;
    padding: var(--sb-4) var(--sb-6);
    border-left: 3px solid var(--sb-violet);
    background: var(--sb-violet-wash);
    font-size: var(--sb-body-sm);
    color: var(--sb-text-secondary);
  }

  /* --- Mobile ---------------------------------------------------------------- */

  @media (max-width: 767px) {
    .voices__head { max-width: none; margin-bottom: var(--sb-7); }
  }

  /* --- Reduced motion --------------------------------------------------------
     Nothing in this section moves on its own any more — the marquee is gone —
     so all that is left is to still the card lift and the hover playback. The
     script also refuses to start a video at all under this preference. */
  @media (prefers-reduced-motion: reduce) {
    .acard, .acard__play, .acard__media :global(img) { transition: none; }
    .acard:hover, .acard:focus-within { transform: none; }
    .acard:hover .acard__play { opacity: 1; transform: none; }
  }
</style>
<script>
  /**
   * HOVER TO PLAY — the client's ask, built so it costs nothing until there is
   * something to play.
   *
   * ⚠ THE <video> IS CREATED ON FIRST HOVER, NOT AT PAGE LOAD. Three video
   * elements in the markup would have the browser opening three connections and
   * fetching metadata for films nobody has asked to watch — on the mid-range
   * Android over 4G docs/03 § D1 describes, on a homepage whose critical-path
   * budget is under 1 KB. A card only builds its player when a pointer actually
   * lands on it, and only if a `video` path exists in data/alumni.ts.
   *
   * ⚠ MUTED, `playsinline`, LOOPING. Muted is not a style choice: every browser
   * blocks autoplay with sound, so an unmuted hover-play simply fails silently.
   * `playsinline` stops iOS taking the video fullscreen the instant it starts.
   *
   * ⚠ POINTER, NOT TOUCH. `hover: hover` gates the whole thing. A phone fires a
   * synthetic hover on tap, so without this the first tap would start a film
   * instead of following the card — and a video that plays when you are trying
   * to read is the behaviour every "autoplaying video" complaint is about.
   *
   * ⚠ AND NOT UNDER REDUCED MOTION. A film starting by itself is exactly the
   * kind of unrequested movement that preference exists to prevent. The poster
   * stays, which loses nothing: every fact on the card is text beneath it.
   */
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)');
  const stillness = window.matchMedia('(prefers-reduced-motion: reduce)');

  document.querySelectorAll<HTMLElement>('[data-acard]').forEach((card) => {
    const src = card.dataset.video;
    const slot = card.querySelector<HTMLElement>('[data-acard-player]');
    if (!src || !slot) return;

    let film: HTMLVideoElement | null = null;

    const build = () => {
      if (film) return film;
      film = document.createElement('video');
      film.src = src;
      film.muted = true;
      film.loop = true;
      film.playsInline = true;
      film.preload = 'none';
      /* Decorative here: the card's heading, course and employer already say
         who this is, so announcing the film again is duplication. */
      film.setAttribute('aria-hidden', 'true');
      film.tabIndex = -1;
      slot.append(film);
      return film;
    };

    const start = () => {
      if (!canHover.matches || stillness.matches) return;
      const v = build();
      /* `play()` rejects if the browser declines — an unhandled rejection here
         would surface as a console error on a card that simply did not play. */
      v.play().then(
        () => card.setAttribute('data-playing', 'true'),
        () => card.removeAttribute('data-playing'),
      );
    };

    const stop = () => {
      card.removeAttribute('data-playing');
      if (!film) return;
      film.pause();
      film.currentTime = 0;
    };

    card.addEventListener('pointerenter', (e) => {
      if (e.pointerType === 'touch') return;
      start();
    });
    card.addEventListener('pointerleave', stop);

    /* Keyboard parity: a card reached by tab behaves as a card hovered. */
    card.addEventListener('focusin', start);
    card.addEventListener('focusout', stop);

    /* Scrolled away mid-play, a paused film is one less decoder running. */
    new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) stop();
    }).observe(card);
  });
</script>
