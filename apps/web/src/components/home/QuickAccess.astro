---
/**
 * §04 · PARENT QUICK ACCESS — docs/06 §04
 *
 * The highest-frequency audience (D2, existing parents) gets a one-tap route to
 * the six things they actually come for, without being routed through marketing.
 *
 * Rebuilt on reference 1's card pattern: a soft pastel disc holding a line-art
 * icon, title, one-line descriptor and a circular arrow. Replaces the earlier
 * rule-separated band, which read as thin and gave a lot of air to very little.
 *
 * The icons are functional, not decorative — each names its destination, which
 * is what makes this scannable at a glance for a returning parent.
 */
import { getSiteSettings } from '../../lib/cms';

const { quickAccess } = await getSiteSettings();

/** Pastel disc per item, plus the icon path. Tones stay in the warm family. */
const looks = [
  { tone: 'peach', label: 'Admissions' },
  { tone: 'sky', label: 'Transport' },
  { tone: 'sun', label: 'Academic Calendar' },
  { tone: 'mint', label: 'Notice Board' },
  { tone: 'rose', label: 'Results' },
  { tone: 'lilac', label: 'Contact' },
] as const;
---

<section class="quick" aria-labelledby="quick-heading">
  <div class="u-container">
    <div class="quick__head">
      <p class="quick__eyebrow"><span class="pill pill--violet">For Parents &amp; Students</span></p>
      <h2 class="quick__heading t-h2-sans" data-split id="quick-heading">
        Everything you came <span class="t-squiggle">for</span>
      </h2>
    </div>

    <ul class="quick__grid">
      {quickAccess.map((item, i) => (
        <li>
          <a
            class={`qcard qcard--${looks[i].tone}`}
            href={item.href}
            aria-label={`${item.label} — ${item.desc}`}
            {...('external' in item && item.external
              ? { target: '_blank', rel: 'noopener' }
              : {})}
          >
            <span class={`qcard__disc qcard__disc--${looks[i].tone}`} aria-hidden="true">
              {i === 0 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8Z" />
                  <path d="M14 3v5h5M9 13h6M9 17h4" />
                </svg>
              )}
              {i === 1 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="4" width="18" height="12" rx="2" />
                  <path d="M3 10h18M7 16v2M17 16v2" />
                  <circle cx="7.5" cy="13" r="1" /><circle cx="16.5" cy="13" r="1" />
                </svg>
              )}
              {i === 2 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="16" rx="2" />
                  <path d="M3 10h18M8 3v4M16 3v4M8 14h3M8 17h6" />
                </svg>
              )}
              {i === 3 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="4" y="4" width="16" height="16" rx="2" />
                  <path d="M8 3v3M16 3v3M8 11h8M8 15h5" />
                </svg>
              )}
              {i === 4 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 20V10M12 20V4M19 20v-7" />
                  <path d="M3 20h18" />
                </svg>
              )}
              {i === 5 && (
                <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                  stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="5" width="18" height="14" rx="2" />
                  <path d="m3 7 9 6 9-6" />
                </svg>
              )}
            </span>

            <span class="qcard__body">
              {/* The title element is the MASK; the inner span is the moving
                  copy and ::before is the duplicate that rolls up behind it.
                  data-title is generated from the same source as the visible
                  text, so the two can never drift apart. */}
              <span class="qcard__title" data-title={item.label}>
                <span>{item.label}</span>
              </span>
              <span class="qcard__desc">{item.desc}</span>
            </span>

            {/* ⚠ A SIBLING OF THE BODY, NOT THE LAST LINE INSIDE IT. Sitting in the
                text column it added a 34px disc plus its margin to every card’s
                height for no information — six cards paying for the same arrow
                twice over. Pinned to the corner it costs no height at all. */}
            <span class="qcard__go" aria-hidden="true">
              <svg width="13" height="10" viewBox="0 0 14 10" fill="none">
                <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.6" />
              </svg>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .quick {
    background: var(--sb-ivory);
    padding-block: var(--sb-section-y);
    border-bottom: var(--sb-hairline);
  }

  .quick__head {
    text-align: center;
    margin-bottom: var(--sb-9);
  }

  .quick__eyebrow { margin-bottom: var(--sb-5); }
  .quick__heading { color: var(--sb-charcoal); }

  .quick__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sb-8) var(--sb-9);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  /* --- Card ----------------------------------------------------------------- */

  .qcard {
    position: relative;
    /* isolation, not just overflow: the fill sits at z-index -1, and without
       its own stacking context it would paint behind the SECTION background
       rather than the card - invisible, and a confusing one to debug. */
    isolation: isolate;
    overflow: hidden;
    display: flex;
    /* ⚠ CENTRE, NOT flex-start. Every card stretches to the tallest one in its
       row, so a short card pinned its disc and copy to the top and left the
       remainder as dead space underneath. The arrow is absolutely positioned in
       the corner and is unaffected by this. */
    align-items: center;
    gap: var(--sb-6);
    height: 100%;
    padding: var(--sb-7);
    border-radius: 25px;
    background: #fff;
    box-shadow: 0 6px 34px rgba(215, 216, 222, 0.41);
  }

  /* PART A - the fill wipes down from the top edge. 0.4s, deliberately faster
     than the 1.05s title roll: the offset between them is the effect. */
  .qcard::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--qcard-fill, var(--sb-violet-wash));
    border-radius: inherit;
    z-index: -1;
    -webkit-transform: scaleY(0);
    transform: scaleY(0);
    /* Top edge, so the fill wipes DOWNWARD. */
    -webkit-transform-origin: 50% 0%;
    transform-origin: 50% 0%;
    -webkit-transition: -webkit-transform 0.4s ease-out;
    transition: transform 0.4s ease-out;
  }

  .qcard:hover::before,
  .qcard:focus-within::before {
    -webkit-transform: scaleY(1);
    transform: scaleY(1);
  }

  /* PER-TONE FILL. Each card fills with a light tint of the hue already in its
     own icon disc, so the six read as a set rather than six unrelated colours.

     MEASURED on every tone (title 21px/700 needs 3.0, description 15px needs
     4.5, icon needs 4.5 as a graphic):
       title       15.0 - 16.4
       description  4.56 - 4.97
       icon on the white hover disc  5.93 - 8.88
     A deeper tint was tried first and pushed rose and lilac descriptions to
     4.41 and 4.33 - under AA - so this is as saturated as the fill can get
     while the small text stays legible. */
  .qcard--peach { --qcard-fill: #ffeae1; }
  .qcard--sky   { --qcard-fill: #e6eefc; }
  .qcard--sun   { --qcard-fill: #fdf3dc; }
  .qcard--mint  { --qcard-fill: #e2f4ea; }
  .qcard--rose  { --qcard-fill: #fde7ee; }
  .qcard--lilac { --qcard-fill: #ece8fa; }

  /* The disc turns white on hover. A pastel disc against a light tint of its
     OWN hue measured 1.09 - the circle simply disappeared. White keeps the
     shape and puts the icon back on its strongest ground. */
  .qcard:hover .qcard__disc,
  .qcard:focus-within .qcard__disc { background: #fff; }

  /* Everything the card holds rides above the fill. */
  .qcard > * {
    position: relative;
    z-index: 1;
  }

  .qcard__disc {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 88px;
    height: 88px;
    border-radius: var(--sb-r-full);
    transition: transform var(--sb-dur-image) var(--sb-ease);
  }

  .qcard:hover .qcard__disc,
  .qcard:focus-within .qcard__disc { transform: scale(1.06); }

  /* Soft discs, warm family. Icon strokes are the deep tone of each disc so
     they stay legible rather than relying on the pastel alone. */
  .qcard__disc--peach { background: #ffe6da; color: #b03d0c; }
  .qcard__disc--sky   { background: #dfeafb; color: #1d4e89; }
  .qcard__disc--sun   { background: #fdeecb; color: #8a5a00; }
  .qcard__disc--mint  { background: #dcf0e4; color: #2f6b4f; }
  .qcard__disc--rose  { background: #fde0e6; color: #a8264a; }
  .qcard__disc--lilac { background: #e7e3f7; color: #4b3b96; }

  .qcard__body {
    display: flex;
    flex-direction: column;
    gap: var(--sb-3);
    /* Clears the corner mark so a long title cannot run under it. */
    padding-right: 42px;
    /* ⚠⚠ min-width: 0 IS WHAT MAKES THAT PADDING BIND. This is a flex item, and
       a flex item defaults to min-width: auto — it refuses to shrink below its
       content, so the title kept its full width, ignored the padding and ran
       under the arrow (35px under it at 1024, where the grid is still three-up
       at its narrowest). With the floor removed the title wraps inside the
       padded box, which is what the padding was reserving space for. */
    min-width: 0;
  }

  /* --- Title: roll-up swap ----------------------------------------------------
     The element is the mask, its inner span is the copy that rolls out, and
     ::before is an identical copy waiting below that rolls in. Both move on the
     same duration and easing, so they travel as one piece of type rather than
     two things that happen to be animating.

     The duplicate takes its text from data-title, and every typographic
     property is inherited from this element, so the two copies cannot diverge —
     including on a title that wraps to two lines. */
  .qcard__title {
    position: relative;
    display: block;
    overflow: hidden;
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: var(--sb-h4);
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
    transition: color var(--sb-dur-link) ease;
  }

  .qcard__title > span {
    display: inline-block;
    -webkit-transition: -webkit-transform 1.05s cubic-bezier(0.3, 0.86, 0.36, 0.95);
    transition: transform 1.05s cubic-bezier(0.3, 0.86, 0.36, 0.95);
  }

  .qcard__title::before {
    content: attr(data-title);
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    /* Inherited from the element, so it matches the span exactly — size,
       weight, leading, tracking and colour, including the hover colour. */
    -webkit-transform: translateY(110%);
    transform: translateY(110%);
    -webkit-transition: -webkit-transform 1.05s cubic-bezier(0.3, 0.86, 0.36, 0.95);
    transition: transform 1.05s cubic-bezier(0.3, 0.86, 0.36, 0.95);
  }

  /* Triggered by the whole card, not the text. :focus-visible is included so a
     keyboard user gets the same feedback a mouse user does. */
  .qcard:hover .qcard__title > span,
  .qcard:focus-within .qcard__title > span {
    -webkit-transform: translateY(-125%);
    transform: translateY(-125%);
  }

  .qcard:hover .qcard__title::before,
  .qcard:focus-within .qcard__title::before {
    -webkit-transform: translateY(0);
    transform: translateY(0);
  }

  /* The title used to turn violet on hover. That is now the FILL colour, so it
     would disappear into it. Colour is handled by the invert toggle below. */

  /* docs/05 § N — the swap is decoration. With reduced motion the second copy
     never enters and the first never leaves; only the colour changes. */
  @media (prefers-reduced-motion: reduce) {
    .qcard__title > span,
    .qcard__title::before { transition: none; }
    .qcard:hover .qcard__title > span,
    .qcard:focus-within .qcard__title > span { -webkit-transform: none; transform: none; }
    .qcard:hover .qcard__title::before,
    .qcard:focus-within .qcard__title::before {
      -webkit-transform: translateY(110%);
      transform: translateY(110%);
    }
  }

  .qcard__desc {
    font-size: var(--sb-body-sm);
    line-height: 1.55;
    color: var(--sb-text-muted);
  }

  /* ⚠ .qcard > .qcard__go, NOT .qcard__go. The rule above sets position:
     relative on every direct child to lift it over the wipe fill, and at equal
     specificity that would fight this one on source order alone. Two classes
     settles it outright. */
  .qcard > .qcard__go {
    position: absolute;
    top: var(--sb-6);
    right: var(--sb-6);
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--sb-r-full);
    border: 1px solid var(--sb-border-strong);
    color: var(--sb-charcoal);
    transition: background-color var(--sb-dur-btn) ease, color var(--sb-dur-btn) ease,
      border-color var(--sb-dur-btn) ease, transform var(--sb-dur-btn) var(--sb-ease);
  }

  /* Turned to point out of the corner it sits in — up and to the right, the
     direction the card actually sends you. */
  .qcard__go svg {
    transform: rotate(-45deg);
    transition: transform var(--sb-dur-btn) var(--sb-ease);
  }

  .qcard:hover .qcard__go,
  .qcard:focus-within .qcard__go {
    transform: translate(4px, -4px);
  }

  /* CONTRAST NOTE - the white-text toggle has been removed, not just switched
     off. It made sense against the saturated orange fill (5.08:1). On these
     light tints white measures 1.06 - 1.11, which is invisible, so leaving the
     class available would only invite someone to turn on unreadable text.
     Dark text on the tints: title 15.0+, description 4.56+. */
  /* --- REDUCED MOTION ---------------------------------------------------------
     docs/05 N. The fill still arrives - it carries the hover state, which is
     information - but it fades rather than wiping, and neither copy of the
     title moves. */
  @media (prefers-reduced-motion: reduce) {
    .qcard::before {
      -webkit-transform: scaleY(1);
      transform: scaleY(1);
      opacity: 0;
      -webkit-transition: opacity 0.15s linear;
      transition: opacity 0.15s linear;
    }

    .qcard:hover::before,
    .qcard:focus-within::before { opacity: 1; }

    .qcard__title > span,
    .qcard__title::before { transition: none; }

    .qcard:hover .qcard__title > span,
    .qcard:focus-within .qcard__title > span { -webkit-transform: none; transform: none; }

    .qcard:hover .qcard__title::before,
    .qcard:focus-within .qcard__title::before {
      -webkit-transform: translateY(110%);
      transform: translateY(110%);
    }

    .qcard:hover .qcard__disc,
    .qcard:focus-within .qcard__disc { transform: none; }
  }

  /* --- Tablet: 2 columns ------------------------------------------------------ */

  /* ⚠ 1199, NOT 1023, SINCE THE ARROW MOVED TO THE CORNER. Three-up columns
     are ~113px of text width at 1024, and the arrow now takes 42px of that from
     the top line — “Admissions” is one unbreakable word wider than what is left,
     so it ran 35px under the arrow. It fitted before only because the arrow used
     to sit BELOW the text. Two-up from 1199 down gives the title its width back. */
  @media (max-width: 1199px) {
    .quick__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sb-8) var(--sb-7); }
    .qcard__disc { width: 76px; height: 76px; }
    .qcard__disc svg { width: 26px; height: 26px; }
  }

  /* --- Mobile: single column, tighter -------------------------------------- */

  @media (max-width: 639px) {
    .quick__grid { grid-template-columns: minmax(0, 1fr); gap: var(--sb-7); }
    .qcard { gap: var(--sb-5); }
    .qcard__disc { width: 64px; height: 64px; }
    .qcard__disc svg { width: 24px; height: 24px; }
    .qcard__go { display: none; } /* the whole card is the tap target here */
  }
</style>
