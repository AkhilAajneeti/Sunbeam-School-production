---
/**
 * §07 · LEARNING AT SUNBEAM — docs/06 §07, audit 2.A + 2.C
 *
 * Full-bleed split: one photograph left, dark evidence panel right.
 *
 * Height is viewport-driven so the whole section lands in one screen without
 * scrolling. A single image, held to the exact height of the split.
 */
import { getLearning } from '../../lib/cms';
import Photo from '../ui/Photo.astro';

const learning = await getLearning();
---

<section class="learn u-on-dark" aria-labelledby="learn-heading" data-learn>
  <div class="learn__media">
    <Photo
      file={learning.photo}
      alt={learning.photoAlt}
      brief={learning.imageBrief}
      position="50% 45%"
      sizes="(max-width: 1023px) 100vw, 55vw"
    />
  </div>

  <div class="learn__panel">
    <div class="learn__inner" data-reveal>
      <p class="learn__eyebrow t-label">{learning.eyebrow}</p>
      <h2 class="learn__heading t-h2-sans" data-split id="learn-heading">{learning.heading}</h2>

      <div class="learn__body">
        {learning.paragraphs.map((p) => <p>{p}</p>)}
      </div>

      <ul class="learn__evidence">
        {learning.evidence.map((item, i) => (
          <li class="learn__row">
            <span class="learn__row-title">{item.title}</span>
            <span class="learn__row-detail">{item.detail}</span>
          </li>
        ))}
      </ul>

      <a class="learn__link" href={learning.link.href}>
        {learning.link.label}
        <svg class="arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
          <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.5" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .learn {
    display: grid;
    grid-template-columns: 52fr 48fr;
    background: var(--sb-ink);
    align-items: stretch;
    /* Sized against the viewport so the split lands in one screen. */
    min-height: clamp(500px, calc(100svh - 150px), 720px);
  }

  /* --- Image ---------------------------------------------------------------- */

  /* Absolutely positioned so the media column is exactly the height of the
     split and never grows with the image's intrinsic size. */
  .learn__media { position: relative; overflow: hidden; }

  .learn__media :global(.photo) {
    position: absolute;
    inset: 0;
    height: 100%;
  }

  /* --- Dark panel ----------------------------------------------------------- */

  .learn__panel {
    display: flex;
    align-items: center;
    padding: clamp(32px, 5vh, 72px) clamp(28px, 4vw, 80px);
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.035) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .learn__inner { max-width: 48ch; }

  .learn__eyebrow { color: var(--sb-lime); margin-bottom: var(--sb-4); }

  .learn__heading {
    color: #fff;
    font-size: clamp(24px, 3.4vh, var(--sb-h2));
    margin-bottom: var(--sb-5);
    max-width: 18ch;
  }

  .learn__body p {
    color: var(--sb-on-dark-78);
    font-size: clamp(14px, 1.85vh, var(--sb-body));
    line-height: 1.6;
  }

  .learn__body p + p { margin-top: var(--sb-4); }

  /* Hairline-separated rows — not four cards. */
  .learn__evidence {
    margin-top: clamp(18px, 2.6vh, 40px);
    border-top: 1px solid var(--sb-on-dark-rule);
  }

  .learn__row {
    display: grid;
    gap: 2px;
    padding: clamp(9px, 1.5vh, 18px) 0 clamp(9px, 1.5vh, 18px) var(--sb-5);
    border-bottom: 1px solid var(--sb-on-dark-rule);
    border-left: 2px solid transparent;
    transition: border-left-color var(--sb-dur-link) ease,
      padding-left var(--sb-dur-link) var(--sb-ease),
      background-color var(--sb-dur-link) ease;
  }

  .learn__row:hover,
  .learn__row:focus-visible {
    border-left-color: var(--sb-lime);
    padding-left: var(--sb-6);
    background: rgba(255, 255, 255, 0.04);
  }

  .learn__row-title {
    font-weight: 600;
    font-size: clamp(14px, 1.9vh, var(--sb-body));
    color: #fff;
  }

  .learn__row-detail {
    font-size: clamp(12px, 1.6vh, var(--sb-body-sm));
    line-height: 1.5;
    color: var(--sb-on-dark-66);
  }

  .learn__link {
    display: inline-flex;
    align-items: center;
    gap: var(--sb-3);
    margin-top: clamp(16px, 2.4vh, 32px);
    padding-bottom: var(--sb-2);
    font-weight: 600;
    font-size: var(--sb-body-sm);
    color: #fff;
    border-bottom: 1px solid var(--sb-lime);
  }

  .learn__link:hover .arrow { transform: translateX(4px); }
  .arrow { transition: transform var(--sb-dur-link) var(--sb-ease); }

  /* Under ~960px tall the panel cannot hold the heading, both paragraphs, five
     evidence rows AND clear the 97px sticky masthead. The second paragraph is
     the least load-bearing line — the five rows below it carry the actual
     evidence — so it steps aside rather than the rows being cropped. */
  @media (max-height: 960px) {
    .learn__body p:last-child { display: none; }
    .learn__row { padding-block: clamp(7px, 1.2vh, 14px); }
  }

  /* --- Tablet & mobile ------------------------------------------------------- */

  @media (max-width: 1023px) {
    .learn { grid-template-columns: minmax(0, 1fr); min-height: 0; }
    .learn__media { aspect-ratio: 3 / 2; }

    /* Stacked, the photograph met the dark panel on a hard horizontal line and
       the two read as separate sections rather than one. A fade over the last
       third of the image dissolves it into the panel's own ground, so the band
       reads as a single object. Matches the treatment on §PrincipalSpeak, which
       stacks the same way — the two sections should behave alike. */
    .learn__media::after {
      content: '';
      position: absolute;
      inset: auto 0 0 0;
      /* Deep, and eased. A short linear fade compresses the whole luminance
         drop into the last 60px and the eye still reads a line there; measured
         at 390 it went 61 → 25 in that distance. Four stops over ~40% of the
         image spread the same drop far enough to disappear. */
      height: clamp(150px, 40%, 280px);
      background: linear-gradient(to bottom,
        rgba(22, 16, 12, 0) 0%,
        rgba(22, 16, 12, 0.5) 46%,
        rgba(22, 16, 12, 0.88) 78%,
        var(--sb-ink) 100%);
      pointer-events: none;
      z-index: 1;
    }

    /* Pulled up under the fade so the copy starts inside the blend rather than
       after a visible gap. */
    .learn__panel { padding-top: var(--sb-7); }
    .learn__panel { padding: var(--sb-9) var(--sb-margin); }
    .learn__inner { max-width: none; }
    .learn__heading { max-width: 22ch; }
  }

  @media (max-width: 767px) {
    .learn__media { aspect-ratio: 4 / 3; }
  }

</style>
