---
/**
 * §16 · FOOTER — docs/06 §16
 *
 * Reference treatment: dark ground, an oversized wordmark spanning the full
 * width, four link columns beside a brand/contact block, and a compact base bar.
 *
 * AUDIT 14.1 — "Reduce the size of the social media icons for a cleaner and
 * more balanced appearance." Icons are 15px inside 34px buttons, monochrome at
 * rest and brand-coloured only on hover.
 *
 * AUDIT 14.3 — YouTube and X are NOT linked. The audit asks the school to
 * either maintain them consistently or remove them; that decision is still open
 * (asset request A9), and shipping a link to a dormant channel is exactly what
 * the audit warns against. They can be restored in one line in site.ts.
 */
import { getSchool } from '../../lib/cms';
import { footerUtility } from "../../data/navigation";

const school = await getSchool();

/**
 * Footer columns are the audit's four content sections, with every heading and
 * link named exactly as the audit names it — §1 About Us, §2 Academics (A–F),
 * §3 Campus Tour, §4 Beyond Academics. §7 Transport, §8 School Planner &
 * Academic Calendar and §5 School Activities fold into the section each belongs
 * to. The remaining sections — §6 Career, §9 Uniform Catalogue, §10 Notices,
 * §11 Latest News & Events, §12 Alumni — sit in the utility row below, since
 * the navigation bar tops out at eight items (see Masthead.astro).
 */
const columns = [
  {
    heading: "About Us",
    href: "/about/",
    links: [
      {
        label: "Our Journey",
        href: "/about/history-legacy/",
      },
      { label: "Vision and Mission", href: "/about/vision-mission/" },
      {
        label: "Legacy of the institution",
        /* ⚠ NO FRAGMENT — #legacy does not exist on that page (its anchors are
           leadership, voices-heading, line-heading, film-heading). In the footer
           that was one dead fragment on all 129 pages. */
        href: "/about/history-legacy/",
      },
      { label: "Director's Message", href: "/about/directors-message/" },
      { label: "Principal's Message", href: "/about/principals-message/" },
      // { label: 'Achievements & Recognition', href: '/about/achievements/' },
    ],
  },
  {
    heading: "Academics",
    href: "/academics/",
    links: [
      { label: "Academic Philosophy", href: "/academics/philosophy/" },
      { label: "Academic Structure", href: "/academics/structure/" },
      { label: "Teaching & Learning", href: "/academics/teaching-learning/" },
      { label: "Assessment Pattern", href: "/academics/assessment/" },
      {
        label: "Career Development & Student Success",
        href: "/academics/student-success/",
      },
      { label: "Parent Partnership", href: "/academics/parent-partnership/" },
      {
        label: "School Planner & Academic Calendar",
        href: "/academics/academic-calendar/",
      },
    ],
  },
  /* Restored to make the fourth column. It is also what puts Campus Tour,
     Safety & Security, Facilities & Infrastructure and Transport back within
     reach of the footer — with it commented out, twelve navigation destinations
     had no footer route at all. Trimmed to the six that have or will have a
     page, so the column matches the other three in length rather than running
     twice as long. */
  {
    heading: "Campus Tour",
    href: "/campus/",
    links: [
      { label: "Campus Tour", href: "/campus/" },
      {
        label: "Facilities & Infrastructure",
        href: "/campus/facilities-infrastructure/",
      },
      { label: "Safety & Security", href: "/campus/safety-security/" },
      { label: "Sports Facilities", href: "/campus/sports-facilities/" },
      { label: "Library", href: "/campus/library/" },
      { label: "Transport", href: "/campus/transport/" },
    ],
  },
  {
    /* ⚠ NO href — AND THAT IS THE POINT. This was href: "#", which rendered a
       link identical to its three siblings that did nothing but steal focus.
       The other columns head a real section; this one is a grouping label, so
       it renders as a heading instead. */
    heading: "Other Links",
    links: [
      {
        label: "School Planner & Academic Calendar",
        href: "/academics/academic-calendar/",
      },
      /* §9 Uniform Catalogue, replacing Achievements at the client's request. */
      {
        label: "Uniform Catalogue",
        href: "/admissions/uniform-catalogue/",
      },
      /* ⚠ THIS ROW EXISTS BECAUSE THE UTILITY BAR LOST ITS CONTACT LINK. The
         client asked for Contact off the top bar; measured after that change,
         /contact-us/ was linked from exactly ONE place on the whole site — a
         quick card on the homepage — and from no inner page at all. The footer
         carried the address, a phone and an email, but never a link to the
         page itself.

         Removing it from the bar was the instruction; stranding the page was
         not, and the footer is where a contact link conventionally lives. */
      {
        label: "Contact Us",
        href: "/contact-us/",
      },
    ],
  },
];

const socials = [
  {
    name: "Facebook",
    href: school.social.facebook,
    path: "M15 8h-2a1 1 0 0 0-1 1v2h3l-.4 3H12v7H9v-7H7v-3h2V9a4 4 0 0 1 4-4h2v3Z",
  },
  {
    name: "Instagram",
    href: school.social.instagram,
    path: "M12 8.6a3.4 3.4 0 1 0 0 6.8 3.4 3.4 0 0 0 0-6.8Zm0 5.6a2.2 2.2 0 1 1 0-4.4 2.2 2.2 0 0 1 0 4.4ZM16 4H8a4 4 0 0 0-4 4v8a4 4 0 0 0 4 4h8a4 4 0 0 0 4-4V8a4 4 0 0 0-4-4Zm2.8 12a2.8 2.8 0 0 1-2.8 2.8H8A2.8 2.8 0 0 1 5.2 16V8A2.8 2.8 0 0 1 8 5.2h8A2.8 2.8 0 0 1 18.8 8v8Zm-2-8.6a.8.8 0 1 1-1.6 0 .8.8 0 0 1 1.6 0Z",
  },
  {
    name: "LinkedIn",
    href: school.social.linkedin,
    path: "M6.94 5.5a1.94 1.94 0 1 1-3.88 0 1.94 1.94 0 0 1 3.88 0ZM3.2 9h3.5v11H3.2V9Zm5.8 0h3.35v1.5h.05A3.67 3.67 0 0 1 15.7 8.7c3.5 0 4.15 2.3 4.15 5.3V20h-3.5v-5.3c0-1.27-.02-2.9-1.77-2.9-1.78 0-2.05 1.38-2.05 2.8V20H9V9Z",
  },
] as const;
---

<footer class="foot">
  <div class="u-container">
    {
      /* Smoky wordmark — gradient clipped to the glyphs so the letters dissolve
        downward into the ground rather than sitting on it. Decorative: the
        school's name is already in the crest alt text and the base bar. */
    }
    <div class="foot__wordmark" aria-hidden="true">{school.shortName}</div>

    <div class="foot__main">
      <div class="foot__brand">
        <img
          class="foot__crest"
          src="/brand/sunbeam-emblem.png"
          alt=""
          width="190"
          height="144"
        />
        <p class="foot__tagline">
          A CBSE co-educational day school at Agarsanda, Ballia — Nursery to
          Class XII, part of the Sunbeam group since 1972.
        </p>

        <address class="foot__address">
          <span>{school.address.line1}</span>
          <span
            >{school.address.city}, {school.address.state}
            {school.address.pin}</span
          >
        </address>

        <div class="foot__contact">
          <a href={`tel:${school.phone.admissions}`} class="t-tabular"
            >{school.phone.admissionsDisplay}</a
          >
          <a href={`tel:${school.phone.office}`} class="t-tabular"
            >{school.phone.officeDisplay}</a
          >
          <a href={`mailto:${school.email}`} class="foot__email"
            >{school.email}</a
          >
        </div>
      </div>

      <nav class="foot__cols" aria-label="Footer">
        {
          columns.map((col) => (
            <div class="foot__col">
              {col.href ? (
                <a class="foot__col-head" href={col.href}>
                  {col.heading}
                </a>
              ) : (
                <h3 class="foot__col-head foot__col-head--plain">{col.heading}</h3>
              )}
              <ul>
                {col.links.map((l) => (
                  <li>
                    <a href={l.href}>{l.label}</a>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </nav>
    </div>

    <!-- <nav class="foot__utility" aria-label="Footer utilities">
      <ul>
        {footerUtility.map((l) => (
          <li><a href={l.href}>{l.label}</a></li>
        ))}
      </ul>
    </nav> -->

    <div class="foot__base">
      <p class="foot__legal">
        <span
          >© {new Date().getFullYear()}
          {school.name}. All rights reserved.</span
        >
        <span class="foot__affil t-tabular">
          CBSE Affiliation No. {school.affiliationNo} · School Code {
            school.schoolCode
          }
        </span>
      </p>

      <ul class="foot__social">
        {
          socials.map((s) => (
            <li>
              <a
                class="foot__social-btn"
                href={s.href}
                target="_blank"
                rel="noopener"
                aria-label={`${school.shortName} on ${s.name}`}
              >
                <svg
                  width="15"
                  height="15"
                  viewBox="0 0 24 24"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d={s.path} />
                </svg>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</footer>

<style>
  .foot {
    background: var(--sb-violet-ink);
    color: rgba(255, 255, 255, 0.72);
    /* Generous top padding so the wordmark clears the sticky masthead when the
       page is scrolled to the very end — that overlap was slicing the top off
       the letters. */
    padding-block: var(--sb-12) var(--sb-8);
    font-size: var(--sb-body-sm);
    overflow: hidden;
  }

  /* --- Smoky wordmark ------------------------------------------------------
     Sized in vw so it spans the container at every width. The "smoke" is a
     vertical gradient clipped to the glyphs: near-solid at the cap line, gone
     by the baseline, so the letters dissolve into the ground rather than
     sitting on it. A negative bottom margin lets the page edge crop it. */
  .foot__wordmark {
    font-family: var(--sb-font-display);
    font-weight: 700;
    /* Sized against the CONTAINER, not the viewport.
       A plain `vw` step keeps growing on wide monitors while the container stays
       capped at --sb-max-content, so past ~1460px the wordmark overflowed and
       `overflow: hidden` silently sliced the last letter off.
       8.25 is the measured advance width of "SUNBEAM BALLIA" in Bricolage
       Grotesque 700 at -0.045em tracking (8.083 per 1px of font-size) plus ~2%
       headroom. RE-MEASURE THIS IF THE DISPLAY FACE CHANGES — the divisor is
       face-specific. Poppins was 7.89, and carrying its 8.05 over to Bricolage
       overflowed the container by 5.3px, which `overflow: hidden` then sliced
       off the final A without any visible error.
       Measure with a DOM Range on the element's contents, not the element's own
       width: a block-level element is always exactly as wide as its container,
       so measuring the block always reports "fits". */
    font-size: max(
      30px,
      calc(min(100vw - 2 * var(--sb-margin), var(--sb-max-content)) / 8.25)
    );
    line-height: 1;
    letter-spacing: -0.045em;
    text-transform: uppercase;
    white-space: nowrap;
    padding-bottom: var(--sb-8);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    margin-bottom: var(--sb-10);
    user-select: none;

    background-image: linear-gradient(
      180deg,
      rgba(255, 255, 255, 0.42) 0%,
      rgba(255, 255, 255, 0.26) 34%,
      rgba(255, 255, 255, 0.1) 66%,
      rgba(255, 255, 255, 0.02) 88%,
      rgba(255, 255, 255, 0) 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  /* Older engines without background-clip: text would render solid white and
     overpower the footer, so fall back to a flat low-opacity wordmark. */
  @supports not ((-webkit-background-clip: text) or (background-clip: text)) {
    .foot__wordmark {
      background-image: none;
      color: rgba(255, 255, 255, 0.16);
      -webkit-text-fill-color: rgba(255, 255, 255, 0.16);
    }
  }

  /* --- Brand + columns ------------------------------------------------------ */

  .foot__main {
    display: grid;
    grid-template-columns: minmax(0, 3.4fr) minmax(0, 8fr);
    gap: var(--sb-11);
    padding-bottom: var(--sb-10);
  }

  .foot__crest {
    height: 54px;
    width: auto;
    margin-bottom: var(--sb-6);
  }

  .foot__tagline {
    color: rgba(255, 255, 255, 0.66);
    max-width: 40ch;
    margin-bottom: var(--sb-6);
    line-height: 1.6;
  }

  .foot__address {
    display: flex;
    flex-direction: column;
    font-style: normal;
    color: rgba(255, 255, 255, 0.66);
    line-height: 1.7;
    margin-bottom: var(--sb-5);
  }

  .foot__contact {
    display: flex;
    flex-direction: column;
    gap: var(--sb-2);
  }

  /* 23px measured at 390 — one pixel under the 24×24 WCAG 2.2 SC 2.5.8 (AA)
     minimum, on the school's two phone numbers. `min-height` with the text
     centred costs no layout: the column's own `gap` already separates the rows,
     so nothing below moves. */
  .foot__contact a {
    display: flex;
    align-items: center;
    min-height: 24px;
    color: #fff;
    font-weight: 600;
    width: fit-content;
    transition: color var(--sb-dur-link) ease;
  }

  .foot__contact a:hover {
    color: var(--sb-lime);
  }

  .foot__email {
    font-weight: 400 !important;
    word-break: break-all;
  }

  /* FOUR EXPLICIT TRACKS. The previous `auto-fit, minmax(0, 260px)` sized tracks
     to a 260px cap, and the column area is only ~868px wide — so it fitted three
     and wrapped the fourth underneath. Naming four tracks divides the space that
     exists instead of asking for space there isn't, and `minmax(0, 1fr)` lets a
     long label wrap inside its column rather than forcing the track wider.
     ⚠ IF A COLUMN IS ADDED OR REMOVED, CHANGE THIS NUMBER — a hard count is what
     stops three columns stretching across a four-column measure. */
  .foot__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-8) var(--sb-7);
  }

  .foot__cols ul {
    display: flex;
    flex-direction: column;
    gap: var(--sb-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__col-head {
    display: block;
    font-family: var(--sb-font-display);
    font-weight: 600;
    font-size: var(--sb-body);
    color: #fff;
    margin-bottom: var(--sb-5);
    letter-spacing: -0.01em;
  }

  .foot__col-head:hover {
    color: var(--sb-lime);
  }

  /* ⚠ THE ONE COLUMN HEAD THAT IS NOT A LINK. An <h3> brings UA margins and a
     bolder default weight an <a> does not, and it must not react to hover —
     looking clickable is exactly what was wrong with it before. */
  .foot__col-head--plain {
    margin-top: 0;
    cursor: default;
  }
  .foot__col-head--plain:hover {
    color: #fff;
  }

  /* ⚠ THE WHOLE FOOTER SITEMAP FAILED WCAG 2.2 SC 2.5.8 (AA) — 20 links at 18px
     tall, on every page of the site. This is the site's second navigation, and
     on a phone it is the ONLY place several sections are reachable from, so it
     is the last place a 24px minimum should be missed.

     `inline-flex` + `min-height`, not a bigger `gap` on the list: the gap would
     push the rows apart without growing the hit area, which looks like a fix
     and is not one. The anchors are `width: fit-content` by being inline, so a
     tap still only lands on the label, not on the empty column beside it. */
  .foot__cols li a {
    display: inline-flex;
    align-items: center;
    min-height: 24px;
    color: rgba(255, 255, 255, 0.66);
    transition: color var(--sb-dur-link) ease;
  }

  .foot__cols li a:hover {
    color: #fff;
  }

  /* --- Utility row ---------------------------------------------------------- */

  .foot__utility {
    padding-block: var(--sb-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .foot__utility ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-4) var(--sb-6);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .foot__utility a {
    font-size: var(--sb-caption);
    color: rgba(255, 255, 255, 0.6);
    transition: color var(--sb-dur-link) ease;
  }

  .foot__utility a:hover {
    color: var(--sb-lime);
  }

  /* --- Base bar ------------------------------------------------------------- */

  .foot__base {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-7);
    padding-top: var(--sb-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .foot__legal {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3) var(--sb-6);
    margin: 0;
    font-size: var(--sb-caption);
    color: rgba(255, 255, 255, 0.55);
  }

  .foot__affil {
    color: rgba(255, 255, 255, 0.72);
  }

  /* Audit 14.1 — small, monochrome at rest. */
  .foot__social {
    display: flex;
    gap: var(--sb-3);
    list-style: none;
    margin: 0;
    padding: 0;
    flex-shrink: 0;
  }

  .foot__social-btn {
    display: grid;
    place-items: center;
    width: 34px;
    height: 34px;
    border-radius: var(--sb-r-full);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: rgba(255, 255, 255, 0.66);
    transition:
      background-color var(--sb-dur-btn) ease,
      color var(--sb-dur-btn) ease,
      border-color var(--sb-dur-btn) ease;
  }

  .foot__social-btn:hover {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
  }

  /* --- Tablet ---------------------------------------------------------------- */

  @media (max-width: 1023px) {
    .foot__main {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-9);
    }

    .foot__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sb-8) var(--sb-7);
    }
  }

  /* --- Mobile ---------------------------------------------------------------- */

  @media (max-width: 767px) {
    .foot {
      padding-block: var(--sb-9) var(--sb-7);
    }

    /* Two lines rather than a hairline-thin single line on a phone. */
    /* Font size still comes from the container formula above — it already
       resolves correctly at phone widths, so only the rhythm changes here. */
    .foot__wordmark {
      line-height: 1;
      padding-bottom: var(--sb-6);
      margin-bottom: var(--sb-8);
    }

    .foot__base {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--sb-6);
    }

    .foot__legal {
      gap: var(--sb-2);
    }
  }

  @media (max-width: 479px) {
    .foot__cols {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-7);
    }
  }
</style>
