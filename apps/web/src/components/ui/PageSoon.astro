---
/**
 * NOT-YET-BUILT PAGE — the site's chrome, an honest line, and no dead end.
 *
 * ═══ WHY THIS EXISTS ═══════════════════════════════════════════════════════
 *
 * Client: "if a page is not created, by default the user shouldn't see an error
 * screen and black screen — it should look like the page is created but content
 * is not."
 *
 * Sixteen destinations in the navigation had no page behind them. Every one of
 * them returned the framework's raw 404: unstyled, unbranded, no masthead, no
 * footer, no way back. On a school site during admission season that reads as
 * "this school's website is broken", which is a worse claim than "this section
 * is still being written".
 *
 * So an unbuilt route now renders the real masthead, the real footer, a proper
 * banner, and the crest in the middle of the page with one line saying the
 * section is being prepared.
 *
 * ═══ WHAT IT DOES NOT DO ═══════════════════════════════════════════════════
 *
 * ⚠ IT DOES NOT PRETEND THE CONTENT EXISTS. There is no lorem, no invented
 * statistic, no stock photograph, and no fake heading implying a page that was
 * written and is merely hidden. docs/07's placeholder policy governs every
 * other missing asset on this site and it governs this too: a placeholder is
 * deliberately obvious. The difference between this and an error page is
 * dignity, not deception.
 *
 * ⚠ IT ALWAYS OFFERS A WAY ON. A page with nothing on it is still a dead end if
 * the only exit is the back button, so each one carries the admissions helpline
 * and a route home — the two things a parent who followed a broken link
 * actually needs.
 *
 * ⚠ THESE ARE REAL 200s, SO A CRAWLER WILL INDEX THEM.
 * `robots` is an optional BaseLayout prop, added for this — omitted, a page
 * stays indexable, so no existing page changed. `noindex, follow` keeps an
 * empty section out of search results while still following its links, and it
 * disappears on its own: the day a real page exists at that path it takes
 * precedence and this component never renders.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from './PageHero.astro';
import { getSchool } from '../../lib/cms';

import heroPhoto from '../../assets/photos/sunbeem-1.jpg';

const school = await getSchool();

interface Props {
  /** The destination's own label, taken from the navigation where it has one. */
  title: string;
  /** Breadcrumb parent, where the route has one. */
  section?: { label: string; href: string } | null;
}

const { title, section = null } = Astro.props;

const crumbs = [
  { label: 'Home', href: '/' },
  ...(section ? [{ label: section.label, href: section.href }] : []),
];
---

<BaseLayout
  title={`${title} — Sunbeam School Ballia`}
  description={`${title} at Sunbeam School Ballia. This section of the website is being prepared — for anything you need in the meantime, please call the school on ${school.phone.admissionsDisplay}.`}
  robots="noindex, follow"
>
  <PageHero
    title={title}
    standfirst="This section is being prepared."
    crumbs={crumbs}
    src={heroPhoto}
    alt="The Sunbeam School Ballia campus at Agarsanda, seen across the school lawn"
    position="50% 45%"
  />

  <div class="u-page-panel soon-panel">
    <section class="soon" aria-labelledby="soon-title">
      <div class="u-container soon__inner">
        {/* The crest, centred — the client's own request, and the one mark that
            says "this is the school's site" without claiming anything about the
            page it sits on. Decorative: the masthead already names the school
            to a screen reader, so repeating it here is noise. */}
        <img
          class="soon__crest"
          src="/brand/sunbeam-emblem.png"
          alt=""
          width="190"
          height="144"
          loading="eager"
          decoding="async"
        />

        <h2 class="soon__h" id="soon-title">We’re still writing this page</h2>

        <p class="soon__b">
          {title} will live here. The section is being prepared and will be published
          as soon as the school has approved its content — nothing has been put up in
          the meantime that we could not stand behind.
        </p>

        <div class="soon__acts">
          <a class="btn btn--primary" href={`tel:${school.phone.admissions}`}>
            Call the school — {school.phone.admissionsDisplay}
          </a>
          <a class="btn btn--secondary" href="/">Back to the homepage</a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  div.soon-panel { padding-block: 0; }

  .soon {
    padding-block: clamp(64px, 12vh, 140px);
    background: var(--sb-ivory);
  }

  .soon__inner {
    max-width: 58ch;
    margin-inline: auto;
    text-align: center;
  }

  /* Muted rather than full colour: the crest is here to steady the page, not to
     become its subject. */
  .soon__crest {
    display: block;
    width: clamp(96px, 11vw, 132px);
    height: auto;
    margin-inline: auto;
    opacity: 0.9;
  }

  .soon__h {
    margin-top: clamp(24px, 3vh, 36px);
    font-family: var(--sb-font-display);
    font-size: clamp(25px, 3vw, 40px);
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: -0.032em;
    color: var(--sb-charcoal);
    text-wrap: balance;
  }

  .soon__b {
    margin-top: var(--sb-5);
    font-size: var(--sb-body);
    line-height: 1.75;
    color: var(--sb-text-secondary);
    text-wrap: pretty;
  }

  .soon__acts {
    margin-top: clamp(28px, 4vh, 44px);
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-4);
    justify-content: center;
  }
</style>
