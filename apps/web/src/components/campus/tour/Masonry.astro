---
import { getCampusTourData, fileUrl } from '../../../lib/cms';
const {allFrames, shot} = await getCampusTourData();

/**
 * §4 · MASONRY GALLERY + LIGHTBOX — every frame on the campus, one wall.
 *
 * LAYOUT IS CSS COLUMNS, NOT A JS MASONRY. The shoot is genuinely mixed —
 * 5568×3712 landscapes next to 3640×5568 portraits — so a column flow gives the
 * Pinterest stagger for free, reflows on resize with no listener, and cannot
 * leave the page in a collapsed state if a script fails. A JS masonry would buy
 * strict left-to-right reading order at the cost of all three.
 *
 * FULL-SIZE SOURCES COME FROM STRAPI. The URL of the stored original rides on
 * `data-full`, so the lightbox is one fetch. This used to call getImage() to
 * emit a 1600w WebP per frame at BUILD time — 73 of them, every build — which is
 * exactly the image work the CMS migration removed.
 *
 * LAZY BY DEFAULT. Sixty-eight frames would be an unreasonable payload for a
 * parent on a metered connection in Ballia, so every thumbnail is `loading=lazy`
 * and the wall is capped at two source widths.
 *
 * THE LIGHTBOX IS A REAL DIALOG. Keyboard (←/→/Escape), touch swipe, a counter,
 * focus trapped while open and returned to the thumbnail on close. Filtering
 * rebuilds the navigable set, so ←/→ walk the visible frames rather than
 * wandering into hidden ones — which is the bug this pattern usually ships with.
 */
import CmsImage from '../../ui/CmsImage.astro';

import SectionHead from '../../academics/SectionHead.astro';

/**
 * The full-size source the lightbox opens.
 *
 * ⚠ NO getImage() ANY MORE. Astro's getImage re-processed every frame at build
 * time — 73 of them — which is the image work this migration exists to remove.
 * Strapi already holds the original, so the lightbox points straight at it and
 * the build does nothing.
 */
const frames = allFrames.map((f) => ({ ...f, full: fileUrl(f.src) }));
---

{/* The heading COUNTS the frames rather than stating a number. It read
    "Sixty-eight frames" while the folders held 67 — a basketball frame had been
    removed and the heading did not know, so the page contradicted its own
    filter chips on the same screen. */}
<section class="gal" id="gallery" aria-labelledby="gal-title">
  <div class="u-container">
    <SectionHead
      id="gal-title"
      eyebrow="The whole wall"
      heading={`${frames.length} frames of the campus`}
      stand="Filter by facility, or open any frame full screen."
      measure={20}
    />

    {/* --- Filters ------------------------------------------------------- */}
    <div class="gal__filters" role="group" aria-label="Filter photographs by facility">
      <button type="button" class="gal__chip is-on" data-gal-filter="all" aria-pressed="true">
        All <span class="gal__chip-n">{frames.length}</span>
      </button>
      {shot.map((f) => (
        <button type="button" class="gal__chip" data-gal-filter={f.id} aria-pressed="false">
          {f.name} <span class="gal__chip-n">{f.images.length}</span>
        </button>
      ))}
    </div>

    <p class="gal__status u-visually-hidden" role="status" data-gal-status></p>

    {/* --- The wall ------------------------------------------------------ */}
    <div class="gal__wallwrap">
    <div class="gal__wall" data-gal-wall>
      {frames.map((f, i) => (
        <figure class="gal__cell" data-gal-cell={f.id}>
          <button
            type="button"
            class="gal__open"
            data-gal-open={i}
            data-full={f.full}
            data-caption={f.facility}
            data-alt={f.alt}
            aria-label={`Open: ${f.alt}`}
          >
            <CmsImage
              file={f.src}
              alt={f.alt}
              sizes="(max-width: 600px) 92vw, (max-width: 1000px) 46vw, 30vw"
              loading="lazy"
      fallbackWidth={760}
    />
            <span class="gal__veil" aria-hidden="true"></span>
            <figcaption class="gal__cap">{f.facility}</figcaption>
          </button>
        </figure>
      ))}
    </div>

      {/* The fade is a sibling of the wall inside a relative wrapper, and is
          pointer-events:none — so it blurs the last visible row into the ground
          without blocking a click on the frames underneath it. */}
      <div class="gal__fade" data-gal-fade aria-hidden="true"></div>
    </div>

    <div class="gal__more" data-gal-more>
      <button type="button" class="btn btn--primary gal__more-btn" data-gal-load>
        Load more
        <span class="gal__more-n t-tabular" data-gal-remaining></span>
      </button>
    </div>

    <p class="gal__empty" data-gal-empty hidden>No photographs in this category yet.</p>
  </div>
</section>

{/* --- Lightbox ---------------------------------------------------------- */}
<div class="lb" data-lb hidden>
  <div class="lb__scrim" data-lb-close aria-hidden="true"></div>

  <div class="lb__panel" role="dialog" aria-modal="true" aria-label="Photograph viewer">
    {/* Top bar — caption, counter and Close, on their own row rather than
        floating over the picture. The old close button sat in the corner of the
        image, which is where a bright frame hides it. */}
    <header class="lb__bar">
      <p class="lb__meta">
        <span class="lb__cap" data-lb-cap></span>
        <span class="lb__n t-tabular" data-lb-n></span>
      </p>

      <button type="button" class="lb__close" data-lb-close>
        <svg width="15" height="15" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path d="M1 1L17 17M17 1L1 17" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
        </svg>
        Close
        <kbd>Esc</kbd>
      </button>
    </header>

    <div class="lb__stage">
      <button type="button" class="lb__nav lb__prev" data-lb-prev aria-label="Previous photograph">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="M15 4 7 12l8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>

      <img class="lb__img" data-lb-img alt="" />

      <button type="button" class="lb__nav lb__next" data-lb-next aria-label="Next photograph">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <path d="m9 4 8 8-8 8" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </button>
    </div>

    {/* Filmstrip. Built from the already-loaded grid thumbnails, so choosing a
        frame costs no extra request — and it turns "next, next, next" into one
        click on the frame you actually want. */}
    <div class="lb__strip" data-lb-strip aria-label="Choose a photograph"></div>
  </div>
</div>

<style>
  .gal {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  /* --- Filters ------------------------------------------------------------- */

  .gal__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3);
    justify-content: center;
    margin-top: var(--sb-9);
  }

  .gal__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--sb-paper);
    border: var(--sb-hairline);
    color: var(--sb-text-secondary);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--sb-dur-link) ease, color var(--sb-dur-link) ease,
      border-color var(--sb-dur-link) ease;
  }

  .gal__chip:hover { border-color: var(--sb-violet); color: var(--sb-violet); }

  .gal__chip.is-on {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
  }

  .gal__chip-n {
    font-size: 11px;
    font-weight: 700;
    opacity: 0.62;
  }

  /* --- Wall ---------------------------------------------------------------- */

  .gal__wall {
    margin-top: var(--sb-9);
    column-count: 4;
    column-gap: var(--sb-5);
  }

  .gal__cell {
    /* A cell must not be split across two columns — that is the one thing a
       column-flow masonry gets wrong by default. */
    break-inside: avoid;
    margin: 0 0 var(--sb-5);
  }

  .gal__cell[hidden] { display: none; }

  .gal__open {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    border-radius: 12px;
    overflow: hidden;
    background: var(--sb-sand);
    cursor: zoom-in;
  }

  .gal__open :global(img) {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 700ms var(--sb-ease);
  }

  .gal__open:hover :global(img),
  .gal__open:focus-visible :global(img) { transform: scale(1.05); }

  .gal__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(18, 12, 8, 0.62) 100%);
    opacity: 0;
    transition: opacity var(--sb-dur-link) ease;
  }

  .gal__cap {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 12px;
    color: #fff;
    font-size: var(--sb-body-sm);
    font-weight: 650;
    text-align: left;
    opacity: 0;
    transform: translateY(6px);
    transition: opacity var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  .gal__open:hover .gal__veil,
  .gal__open:focus-visible .gal__veil,
  .gal__open:hover .gal__cap,
  .gal__open:focus-visible .gal__cap { opacity: 1; }

  .gal__open:hover .gal__cap,
  .gal__open:focus-visible .gal__cap { transform: none; }

  /* --- Load more ----------------------------------------------------------- */

  .gal__wallwrap { position: relative; }

  /* Blurs and fades the last visible row into the ground, so the wall reads as
     "there is more below" rather than as having simply stopped. Hidden entirely
     once everything is loaded — a permanent fade over the true end of the wall
     would be a lie about there being more. */
  .gal__fade {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 220px;
    pointer-events: none;
    background: linear-gradient(180deg, transparent, var(--sb-ivory) 82%);
    -webkit-backdrop-filter: blur(3px);
    backdrop-filter: blur(3px);
    /* The blur must not smear the sharp frames higher up the wall, so the layer
       masks itself to the same ramp it paints. */
    -webkit-mask-image: linear-gradient(180deg, transparent, #000 62%);
    mask-image: linear-gradient(180deg, transparent, #000 62%);
    opacity: 1;
    transition: opacity 260ms ease;
  }

  .gal__fade[hidden] { display: none; }

  .gal__more {
    display: flex;
    justify-content: center;
    margin-top: var(--sb-7);
  }

  .gal__more[hidden] { display: none; }

  .gal__more-btn {
    display: inline-flex;
    align-items: center;
    gap: var(--sb-3);
  }

  .gal__more-n {
    font-size: var(--sb-caption);
    font-weight: 700;
    opacity: 0.7;
  }

  .gal__empty {
    margin-top: var(--sb-8);
    text-align: center;
    color: var(--sb-text-muted);
  }

  .gal__empty[hidden] { display: none; }

  /* --- Phones: the filters become one scrolling row -------------------------
     Twelve wrapping chips stacked into six centred rows and took ~300px of the
     screen before a single photograph appeared — more height than the gallery's
     own heading. As a single non-wrapping rail they take one row and scroll,
     and the bleed to the screen edges is the cue that there are more. */
  @media (max-width: 700px) {
    .gal__filters {
      flex-wrap: nowrap;
      justify-content: flex-start;
      overflow-x: auto;
      overscroll-behavior-x: contain;
      margin-inline: calc(var(--sb-margin) * -1);
      padding-inline: var(--sb-margin);
      padding-bottom: 4px;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .gal__filters::-webkit-scrollbar { display: none; }

    .gal__chip {
      flex: 0 0 auto;
      min-height: 36px;
      padding: 0 13px;
      font-size: var(--sb-caption);
    }
  }

  @media (max-width: 1200px) { .gal__wall { column-count: 3; } }
  @media (max-width: 820px) { .gal__wall { column-count: 2; } }

  /* TWO COLUMNS ON PHONES, not one. A single column made each frame full-width,
     which is a slideshow rather than a wall — the staggered, mixed-height read
     that makes a masonry legible at a glance only exists once there are two
     columns for the heights to stagger against. It also halves the scroll. */
  @media (max-width: 520px) {
    .gal__wall { column-count: 2; column-gap: 10px; }
    .gal__cell { margin-bottom: 10px; }
    .gal__open { border-radius: 9px; }
    /* The caption is 14px over a 165px-wide frame; the veil stays so the
       hover/tap state still reads, but the label would be two cramped lines. */
    .gal__cap { display: none; }
  }

  /* --- Lightbox ------------------------------------------------------------ */

  /* --- Lightbox ------------------------------------------------------------
     THE VIEWER IS MOVED TO <body> BY THE SCRIPT, and it has to be. This markup
     is authored inside `.u-page-panel`, which sets `position: relative;
     z-index: 1` — that is a STACKING CONTEXT, so the viewer's z-index of 200 is
     scoped inside it and resolves against the panel's 1. The masthead sits at 50
     in the root context and therefore painted straight over the top of the
     viewer: the whole header bar, the nav and its dropdown stayed visible, and
     the Close button was underneath them. No z-index value here could have
     fixed that; the element had to leave the context. */
  .lb { position: fixed; inset: 0; z-index: 200; }
  .lb[hidden] { display: none; }

  .lb__scrim {
    position: absolute;
    inset: 0;
    /* 0.97, not 0.94. At 0.94 the masthead and the cards behind stayed legible
       through it, so the viewer's own caption read as floating over the page
       rather than replacing it. The blur is a second line of defence for the
       same reason — together they stop the background competing. */
    background: rgba(10, 7, 5, 0.97);
    -webkit-backdrop-filter: blur(10px) saturate(60%);
    backdrop-filter: blur(10px) saturate(60%);
    opacity: 0;
    transition: opacity 220ms ease;
  }

  .lb.is-open .lb__scrim { opacity: 1; }

  /* Three rows: bar, picture, filmstrip. The picture takes whatever is left,
     so the strip and the bar can never be pushed off-screen by a tall frame. */
  .lb__panel {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    gap: clamp(10px, 2vh, 20px);
    padding: clamp(12px, 2.4vh, 22px) clamp(12px, 2.4vw, 28px);
  }

  /* --- Top bar -------------------------------------------------------------- */

  .lb__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sb-5);
  }

  .lb__meta {
    display: flex;
    align-items: baseline;
    gap: var(--sb-4);
    min-width: 0;
  }

  .lb__cap {
    font-size: var(--sb-body);
    font-weight: 650;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .lb__n { font-size: var(--sb-body-sm); color: rgba(255, 255, 255, 0.6); }

  /* Labelled, not a bare glyph. An unlabelled × in a corner is the control
     people miss, and this one had also been hidden behind the masthead. */
  .lb__close {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex-shrink: 0;
    height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.22);
    color: #fff;
    font-size: var(--sb-body-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background 180ms ease, border-color 180ms ease;
  }

  .lb__close:hover,
  .lb__close:focus-visible {
    background: rgba(255, 255, 255, 0.22);
    border-color: rgba(255, 255, 255, 0.4);
  }

  .lb__close kbd {
    font-family: inherit;
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.04em;
    padding: 2px 5px;
    border-radius: 4px;
    background: rgba(255, 255, 255, 0.16);
    color: rgba(255, 255, 255, 0.8);
  }

  /* --- Stage ---------------------------------------------------------------- */

  /* grid-template-ROWS is declared, and that is the fix for the oversized
     image. With columns only, the stage's single row is auto-sized by its
     content, so the image's `max-height: 100%` had nothing definite to resolve
     against and the browser treated it as `none`. On a tall window it happened
     to fit and looked fine; on a wide, short one the picture ran past the
     bottom and the filmstrip sat on top of it. An explicit `minmax(0, 1fr)`
     row makes the height definite and the clamp real. */
  .lb__stage {
    position: relative;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    grid-template-rows: minmax(0, 1fr);
    align-items: center;
    gap: clamp(8px, 1.6vw, 20px);
    min-height: 0;
  }

  /* Centred in both axes, and deliberately smaller than the space available:
     84% of the stage plus a 1180px ceiling keeps the frame from crowding the
     bar and the strip, and stops a wide landscape stretching the full width of
     a 1920 screen where it stops reading as a photograph and starts reading as
     a background. */
  .lb__img {
    justify-self: center;
    align-self: center;
    max-width: min(100%, 1180px);
    max-height: 84%;
    object-fit: contain;
    border-radius: 10px;
    box-shadow: 0 24px 60px -24px rgba(0, 0, 0, 0.8);
    opacity: 0;
    transform: scale(0.985);
    transition: opacity 260ms ease, transform 320ms var(--sb-ease);
  }

  .lb.is-ready .lb__img { opacity: 1; transform: none; }

  .lb__nav {
    display: grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #fff;
    cursor: pointer;
    transition: background 180ms ease, transform 220ms var(--sb-ease);
  }

  .lb__nav:hover,
  .lb__nav:focus-visible { background: rgba(255, 255, 255, 0.24); transform: scale(1.07); }

  /* --- Filmstrip ------------------------------------------------------------ */

  .lb__strip {
    display: flex;
    gap: 8px;
    justify-content: flex-start;
    overflow-x: auto;
    padding: 4px 2px 6px;
    scrollbar-width: thin;
    scroll-behavior: smooth;
  }

  .lb__strip:empty { display: none; }

  /* :global, AND IT HAS TO BE. The thumbnails are built by the script at
     runtime, so they never receive the `data-astro-cid` attribute that Astro
     compiles into every scoped selector — a plain `.lb__thumb { }` rule here
     matches nothing at all. Measured before the fix: computed flex was the
     browser default `0 1 auto` rather than the `0 0 auto` written below, so all
     24 shrank to fit instead of scrolling. At 1440 that happened to land near
     55px and looked deliberate; at 390 they collapsed to 2.8px.
     Scoping through the authored parent keeps the rules from leaking. */
  .lb__strip :global(.lb__thumb) {
    flex: 0 0 auto;
    width: 74px;
    height: 52px;
    padding: 0;
    border: 2px solid transparent;
    border-radius: 8px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.08);
    opacity: 0.5;
    cursor: pointer;
    transition: opacity 180ms ease, border-color 180ms ease, transform 220ms var(--sb-ease);
  }

  .lb__strip :global(.lb__thumb img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .lb__strip :global(.lb__thumb:hover),
  .lb__strip :global(.lb__thumb:focus-visible) {
    opacity: 0.9;
    transform: translateY(-2px);
  }

  .lb__strip :global(.lb__thumb[aria-current='true']) {
    opacity: 1;
    border-color: var(--sb-lime);
    box-shadow: 0 0 0 3px rgba(255, 138, 92, 0.28);
  }

  @media (max-width: 700px) {
    .lb__nav { width: 40px; height: 40px; }
    .lb__strip :global(.lb__thumb) { width: 58px; height: 42px; }
    .lb__close kbd { display: none; }
  }


  @media (prefers-reduced-motion: reduce) {
    .lb__img, .lb__scrim { transition: none; }
  }
</style>

<script>
  /* --- Filtering --------------------------------------------------------- */
  const wall = document.querySelector<HTMLElement>('[data-gal-wall]');
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-gal-filter]')];
  const cells = [...document.querySelectorAll<HTMLElement>('[data-gal-cell]')];
  const empty = document.querySelector<HTMLElement>('[data-gal-empty]');
  const status = document.querySelector<HTMLElement>('[data-gal-status]');
  const fade = document.querySelector<HTMLElement>('[data-gal-fade]');
  const more = document.querySelector<HTMLElement>('[data-gal-more]');
  const loadBtn = document.querySelector<HTMLButtonElement>('[data-gal-load]');
  const remaining = document.querySelector<HTMLElement>('[data-gal-remaining]');

  /* Sixty-eight frames is too many to hand a reader at once, so the wall opens
     on a batch and grows by the same amount. BATCH is a multiple of 4 and 3 so
     the last row is full at every column count the layout uses. */
  /* 24 on desktop fills three or four columns; on a phone the wall is a SINGLE
     column, so the same 24 is about 7,000px of scrolling before the reader
     reaches anything else. 8 is a multiple of both column counts the narrow
     layout uses (1 and 2), so the last row is never left half empty. */
  const BATCH = window.matchMedia('(max-width: 700px)').matches ? 8 : 24;
  let filterId = 'all';
  let limit = BATCH;

  /* The lightbox walks the VISIBLE set — which now means "matches the filter AND
     is within the loaded batch". Recomputed on every change rather than captured
     once, so arrowing never wanders into a frame the reader cannot see. */
  let visible: HTMLButtonElement[] = [];

  const apply = () => {
    let matched = 0;
    let shown = 0;

    cells.forEach((c) => {
      const match = filterId === 'all' || c.dataset.galCell === filterId;
      if (match) matched++;
      // Batch position counts only within the matching set, so filtering to a
      // category of 11 shows all 11 rather than whichever of them happened to
      // fall inside the first 24 of the unfiltered wall.
      const within = match && matched <= limit;
      c.hidden = !within;
      if (within) shown++;
    });

    chips.forEach((b) => {
      const on = b.dataset.galFilter === filterId;
      b.classList.toggle('is-on', on);
      b.setAttribute('aria-pressed', String(on));
    });

    const left = matched - shown;
    if (empty) empty.hidden = matched > 0;
    if (fade) fade.hidden = left === 0;
    if (more) more.hidden = left === 0;
    if (remaining) remaining.textContent = left ? `+${Math.min(BATCH, left)}` : '';
    if (status) {
      status.textContent = left
        ? `${shown} of ${matched} photographs shown.`
        : `All ${shown} photograph${shown === 1 ? '' : 's'} shown.`;
    }

    visible = cells
      .filter((c) => !c.hidden)
      .map((c) => c.querySelector<HTMLButtonElement>('[data-gal-open]')!)
      .filter(Boolean);
  };

  chips.forEach((b) =>
    b.addEventListener('click', () => {
      filterId = b.dataset.galFilter!;
      limit = BATCH; // a new category starts from the top, not mid-scroll
      apply();
    })
  );

  loadBtn?.addEventListener('click', () => {
    const first = visible.length; // where the new batch will begin
    limit += BATCH;
    apply();
    /* Focus the first newly-revealed frame. Without this a keyboard user is
       left on a button that may have just disappeared, and the tab order
       restarts from the top of the document. */
    visible[first]?.focus({ preventScroll: true });
  });

  apply();

  /* --- Lightbox ---------------------------------------------------------- */
  const lb = document.querySelector<HTMLElement>('[data-lb]');
  const img = document.querySelector<HTMLImageElement>('[data-lb-img]');
  const cap = document.querySelector<HTMLElement>('[data-lb-cap]');
  const num = document.querySelector<HTMLElement>('[data-lb-n]');

  if (lb && img && cap && num && wall) {
    let index = 0;
    let opener: HTMLElement | null = null;

    /* ESCAPE THE STACKING CONTEXT. `.u-page-panel` is position:relative with
       z-index:1, so everything authored inside it — including this viewer at
       z-index 200 — is trapped below the masthead's 50 in the root context.
       Re-parenting to <body> is the fix; raising the number here cannot be. */
    document.body.appendChild(lb);

    const strip = lb.querySelector<HTMLElement>('[data-lb-strip]');

    /* The strip reuses each grid thumbnail's ALREADY-DECODED src, so building it
       costs no network at all — the browser has those bytes. */
    const buildStrip = () => {
      if (!strip) return;
      strip.textContent = '';
      visible.forEach((btn, i) => {
        const src = btn.querySelector('img')?.currentSrc || btn.querySelector('img')?.src || '';
        const t = document.createElement('button');
        t.type = 'button';
        t.className = 'lb__thumb';
        t.setAttribute('aria-label', btn.dataset.alt ?? `Photograph ${i + 1}`);
        const im = document.createElement('img');
        im.src = src;
        im.alt = '';
        im.loading = 'lazy';
        t.appendChild(im);
        t.addEventListener('click', () => { index = i; render(); });
        strip.appendChild(t);
      });
    };

    const syncStrip = () => {
      if (!strip) return;
      [...strip.children].forEach((el, i) => {
        el.setAttribute('aria-current', String(i === index));
      });
      (strip.children[index] as HTMLElement | undefined)?.scrollIntoView({
        block: 'nearest',
        inline: 'center',
      });
    };

    const render = () => {
      const btn = visible[index];
      if (!btn) return;
      lb.classList.remove('is-ready');
      img.src = btn.dataset.full!;
      img.alt = btn.dataset.alt!;
      cap.textContent = btn.dataset.caption!;
      num.textContent = `${index + 1} / ${visible.length}`;
      syncStrip();
      // is-ready drives the fade; decode() keeps it from firing on a blank frame.
      img.decode?.().catch(() => {}).finally(() => lb.classList.add('is-ready'));
    };

    const open = (btn: HTMLButtonElement) => {
      // `visible` is kept current by apply(); no recompute needed here.
      index = Math.max(0, visible.indexOf(btn));
      opener = btn;
      lb.hidden = false;
      requestAnimationFrame(() => lb.classList.add('is-open'));
      document.body.style.overflow = 'hidden';
      // Rebuilt per open, because filtering and Load more both change the set.
      buildStrip();
      render();
      lb.querySelector<HTMLButtonElement>('.lb__close')?.focus();
    };

    const close = () => {
      lb.classList.remove('is-open', 'is-ready');
      lb.hidden = true;
      document.body.style.overflow = '';
      opener?.focus();
    };

    const step = (d: number) => {
      if (!visible.length) return;
      index = (index + d + visible.length) % visible.length;
      render();
    };

    wall.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLButtonElement>('[data-gal-open]');
      if (btn) open(btn);
    });

    lb.querySelectorAll('[data-lb-close]').forEach((el) => el.addEventListener('click', close));
    lb.querySelector('[data-lb-prev]')?.addEventListener('click', () => step(-1));
    lb.querySelector('[data-lb-next]')?.addEventListener('click', () => step(1));

    document.addEventListener('keydown', (e) => {
      if (lb.hidden) return;
      if (e.key === 'Escape') { e.preventDefault(); close(); }
      else if (e.key === 'ArrowLeft') { e.preventDefault(); step(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); step(1); }
      else if (e.key === 'Tab') {
        // Trap: the dialog's controls are the only focusable things in it.
        const f = [...lb.querySelectorAll<HTMLElement>('button')].filter((b) => b.offsetParent !== null);
        if (!f.length) return;
        const first = f[0];
        const last = f[f.length - 1];
        if (e.shiftKey && document.activeElement === first) { e.preventDefault(); last.focus(); }
        else if (!e.shiftKey && document.activeElement === last) { e.preventDefault(); first.focus(); }
      }
    });

    /* Touch swipe. 45px threshold, and the vertical guard stops a scroll gesture
       that drifts sideways from being read as a swipe. */
    let sx = 0;
    let sy = 0;
    lb.addEventListener('touchstart', (e) => {
      sx = e.changedTouches[0].clientX;
      sy = e.changedTouches[0].clientY;
    }, { passive: true });

    lb.addEventListener('touchend', (e) => {
      const dx = e.changedTouches[0].clientX - sx;
      const dy = e.changedTouches[0].clientY - sy;
      if (Math.abs(dx) > 45 && Math.abs(dx) > Math.abs(dy)) step(dx < 0 ? 1 : -1);
    }, { passive: true });
  }
</script>
