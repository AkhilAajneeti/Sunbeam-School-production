---
/**
 * §8 · VISIT CTA — the close.
 *
 * Audit §1: "a visit tells you more than any brochure ever will" is the argument
 * the whole page has been building, so the last band asks for one.
 *
 * The background is the campus establishing shot under a heavy scrim — the same
 * frame the banner opens on, which closes the page where it started. Contrast is
 * carried by the scrim rather than by hoping the photograph is dark enough,
 * matching PageHero's approach.
 *
 * The floating marks are decorative and `aria-hidden`; they drift only when
 * motion is allowed.
 */
import { Picture } from 'astro:assets';
import { getSchool, getCampusTourData } from '../../../lib/cms';
import campus from '../../../assets/photos/sunbeem-1.jpg';

const school = await getSchool();
const { visitBand, visitCtaLabel, visitCtaHref, visitCallLabel } = await getCampusTourData();
---

<section class="vst" aria-labelledby="vst-title">
  <div class="vst__media" aria-hidden="true">
    <Picture
      src={campus}
      alt=""
      formats={['webp']}
      widths={[900, 1400, 1920]}
      sizes="100vw"
      loading="lazy"
      decoding="async"
    />
  </div>
  <div class="vst__scrim" aria-hidden="true"></div>

  <span class="vst__mark vst__mark--1" aria-hidden="true"></span>
  <span class="vst__mark vst__mark--2" aria-hidden="true"></span>

  <div class="u-container vst__inner">
    <p class="vst__eyebrow t-label" data-reveal>{visitBand.eyebrow}</p>
    <h2 class="vst__h" id="vst-title" data-split>{visitBand.heading}</h2>
    <p class="vst__stand" data-reveal data-reveal-delay="80">
      Photographs can only show you the rooms. Book a visit and walk the corridors,
      meet the staff, and see an ordinary school day as it actually runs.
    </p>

    <div class="vst__actions" data-reveal data-reveal-delay="150">
      <a class="btn btn--primary" href={visitCtaHref}>{visitCtaLabel}</a>
      <a class="vst__call" href={`tel:${school.phone.admissions}`}>
        {visitCallLabel}
        <strong class="t-tabular">{school.phone.admissionsDisplay}</strong>
      </a>
    </div>
  </div>
</section>

<style>
  .vst {
    position: relative;
    padding-block: clamp(72px, 14vh, 148px);
    background: var(--sb-ink);
    color: #fff;
    overflow: hidden;
    isolation: isolate;
    text-align: center;
  }

  .vst__media { position: absolute; inset: 0; z-index: -2; }

  .vst__media :global(picture),
  .vst__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 60%;
    display: block;
  }

  /* Heavier than the banner's: this band carries a button and a phone number as
     well as a heading, and those need their contrast from the scrim rather than
     from whatever happens to be behind them. */
  .vst__scrim {
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      180deg,
      rgba(16, 10, 6, 0.82) 0%,
      rgba(16, 10, 6, 0.88) 50%,
      rgba(16, 10, 6, 0.84) 100%
    );
  }

  .vst__mark {
    position: absolute;
    border-radius: 50%;
    border: 1px solid rgba(255, 138, 92, 0.3);
    pointer-events: none;
  }

  .vst__mark--1 {
    width: 260px;
    height: 260px;
    top: -70px;
    left: -60px;
    animation: vst-drift 18s ease-in-out infinite alternate;
  }

  .vst__mark--2 {
    width: 380px;
    height: 380px;
    bottom: -140px;
    right: -100px;
    animation: vst-drift 24s ease-in-out infinite alternate-reverse;
  }

  @keyframes vst-drift {
    from { transform: translateY(0) scale(1); }
    to { transform: translateY(22px) scale(1.06); }
  }

  .vst__eyebrow { color: var(--sb-lime); }

  .vst__h {
    margin-top: var(--sb-5);
    font-family: var(--sb-font-display);
    font-size: clamp(30px, 4.6vw, 56px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .vst__stand {
    margin: var(--sb-6) auto 0;
    max-width: 58ch;
    font-size: var(--sb-body-lg);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.84);
  }

  .vst__actions {
    margin-top: var(--sb-8);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sb-6);
  }

  .vst__call {
    display: inline-flex;
    align-items: baseline;
    gap: var(--sb-3);
    font-size: var(--sb-body-sm);
    color: rgba(255, 255, 255, 0.78);
  }

  .vst__call strong { color: var(--sb-lime); font-size: var(--sb-body); }
  .vst__call:hover { color: #fff; }

  @media (prefers-reduced-motion: reduce) {
    .vst__mark { animation: none; }
  }
</style>
