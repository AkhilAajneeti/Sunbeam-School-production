---
import { getCampusTourData } from '../../../lib/cms';
const {facilities, journey} = await getCampusTourData();

/**
 * §7 · A DAY ON CAMPUS — the student's route through the buildings.
 *
 * The connective device is a drawn line down the middle with the stops
 * alternating either side, so the eye zig-zags rather than scanning a column.
 * Each stop shows the real photograph of the place it names, pulled from the
 * same facility data as the gallery — so the journey cannot drift out of sync
 * with the wall.
 *
 * Two stops name rooms the school has not photographed yet (Smart Classroom,
 * Medical Support). Rather than borrow another room's picture and imply it, they
 * render as a marked gap in the line — honest, and it reads as a deliberate
 * pause rather than a broken image.
 */
import { Picture } from 'astro:assets';

import SectionHead from '../../academics/SectionHead.astro';

const byId = new Map(facilities.map((f) => [f.id, f]));
const stops = journey.map((s, i) => {
  const fac = byId.get(s.id);
  return { ...s, fac, img: fac?.images[i % Math.max(fac.images.length, 1)] ?? fac?.images[0] };
});
---

<section class="jny" aria-labelledby="jny-title">
  <div class="u-container">
    <SectionHead
      id="jny-title"
      eyebrow="A day, end to end"
      heading="How a student meets the campus"
      stand="Assembly to the last bell, in the order the buildings actually come."
      measure={20}
    />

    <ol class="jny__list">
      <div class="jny__rail" aria-hidden="true"></div>

      {stops.map((s, i) => (
        <li class:list={['jny__stop', i % 2 === 1 && 'jny__stop--right']} data-reveal>
          <span class="jny__node" aria-hidden="true"><span class="t-tabular">{String(i + 1).padStart(2, '0')}</span></span>

          <div class="jny__card">
            <div class="jny__media">
              {s.img ? (
                <Picture
                  src={s.img}
                  alt={`${s.fac?.alt ?? s.label}`}
                  formats={['webp']}
                  widths={[400, 800]}
                  sizes="(max-width: 900px) 92vw, 40vw"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="jny__gap">Photograph pending</span>
              )}
            </div>

            <div class="jny__text">
              <h3 class="jny__h">{s.label}</h3>
              <p class="jny__body">{s.body}</p>
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .jny {
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  .jny__list {
    position: relative;
    list-style: none;
    margin: var(--sb-10) 0 0;
    padding: 0;
  }

  .jny__rail {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    translate: -50% 0;
    background: linear-gradient(180deg, transparent, var(--sb-violet) 6%, var(--sb-violet) 94%, transparent);
    opacity: 0.28;
  }

  .jny__stop {
    position: relative;
    width: calc(50% - 46px);
    margin-bottom: var(--sb-9);
  }

  .jny__stop--right { margin-left: calc(50% + 46px); }

  .jny__node {
    position: absolute;
    top: 22px;
    right: -60px;
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: var(--sb-violet);
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    box-shadow: 0 0 0 5px var(--sb-sand);
  }

  .jny__stop--right .jny__node { right: auto; left: -60px; }

  .jny__card {
    display: grid;
    grid-template-columns: 132px minmax(0, 1fr);
    gap: var(--sb-5);
    align-items: center;
    padding: var(--sb-5);
    background: var(--sb-paper);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(28, 14, 8, 0.05), 0 10px 24px rgba(28, 14, 8, 0.05);
    transition: transform var(--sb-dur-link) var(--sb-ease), box-shadow var(--sb-dur-link) ease;
  }

  .jny__card:hover {
    transform: translateY(-3px);
    box-shadow: 0 3px 6px rgba(28, 14, 8, 0.07), 0 18px 38px rgba(28, 14, 8, 0.1);
  }

  .jny__media {
    aspect-ratio: 1 / 1;
    border-radius: 11px;
    overflow: hidden;
    background: var(--sb-sand);
    display: grid;
    place-items: center;
  }

  .jny__media :global(picture) { display: block; width: 100%; height: 100%; }

  .jny__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .jny__gap {
    padding: var(--sb-3);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    text-align: center;
    color: var(--sb-text-muted);
  }

  .jny__h {
    font-family: var(--sb-font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .jny__body {
    margin-top: var(--sb-3);
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  /* --- Narrow: one column, rail to the left ------------------------------- */

  @media (max-width: 900px) {
    .jny__rail { left: 15px; }
    .jny__stop,
    .jny__stop--right { width: auto; margin-left: 52px; }
    .jny__node,
    .jny__stop--right .jny__node { right: auto; left: -52px; }
  }

  @media (max-width: 480px) {
    .jny__card { grid-template-columns: minmax(0, 1fr); }
    .jny__media { aspect-ratio: 16 / 9; }
  }
</style>
