---
import { getCampusTourData } from '../../../lib/cms';
const {overviewStats} = await getCampusTourData();

/**
 * §2 · CAMPUS OVERVIEW — the figures, before any photograph.
 *
 * The brief asked for the page to open on statistics rather than images, which
 * is right: a wall of thumbnails at the top gives a parent nothing to hold on to,
 * and four numbers do.
 *
 * `data-count` is the site's existing count-up hook (motion-gsap.ts) — the value
 * is written into the element as static text too, so the figure is correct and
 * readable if the GSAP chunk never loads. `data-count-suffix` keeps the + and %
 * from being eaten by the textContent write.
 */

import SectionHead from '../../academics/SectionHead.astro';
---

<section class="cov" aria-labelledby="cov-title">
  <div class="u-container">
    <SectionHead
      id="cov-title"
      eyebrow="The campus at a glance"
      heading="Twelve laboratories, a library, and room to run"
      stand="Sixty-eight photographs of the Agarsanda campus, organised by the place they were taken."
      measure={22}
    />

    <ul class="cov__grid">
      {overviewStats.map((s, i) => (
        <li class="cov__card" data-reveal data-reveal-delay={i * 90}>
          <p class="cov__n t-tabular">
            <span data-count={s.count} data-count-suffix={s.suffix}>
              {s.count.toLocaleString('en-IN')}{s.suffix}
            </span>
          </p>
          <p class="cov__label">{s.label}</p>
          <p class="cov__note">{s.note}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .cov {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .cov__grid {
    list-style: none;
    margin: var(--sb-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-6);
  }

  .cov__card {
    padding: var(--sb-8) var(--sb-6) var(--sb-7);
    background: var(--sb-paper);
    border-radius: 16px;
    box-shadow: 0 1px 2px rgba(28, 14, 8, 0.05), 0 12px 28px rgba(28, 14, 8, 0.05);
    transition: transform var(--sb-dur-link) var(--sb-ease), box-shadow var(--sb-dur-link) ease;
  }

  .cov__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgba(28, 14, 8, 0.06), 0 20px 40px rgba(28, 14, 8, 0.1);
  }

  .cov__n {
    font-family: var(--sb-font-display);
    font-size: clamp(34px, 4vw, 52px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-violet);
  }

  .cov__label {
    margin-top: var(--sb-5);
    font-weight: 650;
    color: var(--sb-charcoal);
  }

  .cov__note {
    margin-top: var(--sb-2);
    font-size: var(--sb-caption);
    color: var(--sb-text-muted);
  }

  @media (max-width: 1023px) {
    .cov__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 520px) {
    .cov__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
