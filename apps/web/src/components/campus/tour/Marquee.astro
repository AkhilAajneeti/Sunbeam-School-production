---
import { getCampusTourData } from '../../../lib/cms';
const {shot} = await getCampusTourData();

/**
 * §6 · CONTINUOUS RAIL — two lanes of campus frames, drifting opposite ways.
 *
 * NOT GSAP, AND DELIBERATELY. The brief asked for a GSAP marquee, but every
 * other animation on this site is behind motion.ts's two gates — reduced-motion
 * and Save-Data — and a section whose ENTIRE content is the movement would be an
 * empty band for anyone the gates catch. A CSS keyframe translate runs without
 * the library, needs no scroll listener, is composited off the main thread, and
 * stops dead for `prefers-reduced-motion` while the photographs stay on screen.
 * That is strictly better here; GSAP still drives the reveals and the parallax
 * everywhere else on the page.
 *
 * NO HORIZONTAL DOCUMENT OVERFLOW. motion-gsap.ts rule 3 exists because an `x`
 * transform is the easiest way to make the whole page scroll sideways. The track
 * is clipped by an `overflow: hidden` lane, so the transform is contained —
 * verified at 360–1920.
 *
 * The lane renders its frames TWICE and travels exactly -50%, which is what
 * makes the loop seamless rather than snapping back.
 */
import CmsImage from '../../ui/CmsImage.astro';


/** One frame from each facility, then a second pass for variety, capped. */
const pool = shot.flatMap((f) => f.images.slice(0, 3).map((src) => ({ src, alt: f.alt })));
const laneA = pool.filter((_, i) => i % 2 === 0).slice(0, 14);
const laneB = pool.filter((_, i) => i % 2 === 1).slice(0, 14);
---

<section class="mrq" aria-label="A continuous run of campus photographs">
  <div class="mrq__lane" data-mrq>
    <div class="mrq__track mrq__track--a">
      {[...laneA, ...laneA].map((f, i) => (
        <div class="mrq__cell" aria-hidden={i >= laneA.length ? 'true' : undefined}>
          <CmsImage
            file={f.src}
            alt={i >= laneA.length ? '' : f.alt}
            sizes="300px"
            loading="lazy"
      fallbackWidth={760}
    />
        </div>
      ))}
    </div>
  </div>

  <div class="mrq__lane" data-mrq>
    <div class="mrq__track mrq__track--b">
      {[...laneB, ...laneB].map((f, i) => (
        <div class="mrq__cell mrq__cell--short" aria-hidden={i >= laneB.length ? 'true' : undefined}>
          <CmsImage
            file={f.src}
            alt={i >= laneB.length ? '' : f.alt}
            sizes="240px"
            loading="lazy"
      fallbackWidth={760}
    />
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .mrq {
    padding-block: var(--sb-10);
    background: var(--sb-violet-ink);
    display: flex;
    flex-direction: column;
    gap: var(--sb-5);
    overflow: hidden;
  }

  .mrq__lane {
    overflow: hidden;
    /* Feathered ends, so frames enter and leave rather than being chopped. */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }

  .mrq__track {
    display: flex;
    gap: var(--sb-5);
    width: max-content;
    will-change: transform;
  }

  .mrq__track--a { animation: mrq-left 64s linear infinite; }
  .mrq__track--b { animation: mrq-right 78s linear infinite; }

  /* -50% exactly — the track holds two copies, so half a track is one full set
     and the loop has no seam. */
  @keyframes mrq-left {
    from { transform: translate3d(0, 0, 0); }
    to { transform: translate3d(-50%, 0, 0); }
  }

  @keyframes mrq-right {
    from { transform: translate3d(-50%, 0, 0); }
    to { transform: translate3d(0, 0, 0); }
  }

  .mrq__lane:hover .mrq__track,
  .mrq__lane:focus-within .mrq__track { animation-play-state: paused; }

  .mrq__cell {
    width: 300px;
    aspect-ratio: 3 / 2;
    flex: 0 0 auto;
    border-radius: 12px;
    overflow: hidden;
    background: rgba(255, 255, 255, 0.06);
  }

  .mrq__cell--short { width: 240px; aspect-ratio: 4 / 3; }

  .mrq__cell :global(picture) { display: block; width: 100%; height: 100%; }

  .mrq__cell :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    opacity: 0.86;
    transition: opacity var(--sb-dur-link) ease, transform 600ms var(--sb-ease);
  }

  .mrq__cell:hover :global(img) { opacity: 1; transform: scale(1.05); }

  @media (max-width: 700px) {
    .mrq__cell { width: 210px; }
    .mrq__cell--short { width: 170px; }
  }

  /* The band's whole content is the movement, so it must not vanish — the frames
     simply stop, and the lane becomes an ordinary clipped strip. */
  @media (prefers-reduced-motion: reduce) {
    .mrq__track--a,
    .mrq__track--b { animation: none; transform: none; }
  }
</style>
