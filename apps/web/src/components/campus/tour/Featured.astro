---
import { getCampusTourData } from '../../../lib/cms';
const { facilities, featured, featuredBand } = await getCampusTourData();

/**
 * §5 · FEATURED FACILITIES — alternating showcase, one facility per row.
 *
 * The brief's instruction was "do not simply display images — tell users what
 * makes each facility special", so every row carries three highlights alongside
 * the picture. The highlights are written from what is visible IN THE FRAMES —
 * the library's Ballia literature shelf and magazine rack are both in the
 * photographs — or from figures the school publishes. Nothing is invented to
 * fill a bullet.
 *
 * The collage is a large lead image plus two supporting frames, and it flips
 * side every row. `data-parallax` on the lead gives the drift the brief asked
 * for; it is the site's existing hook, so it inherits the reduced-motion and
 * Save-Data gates rather than adding a second animation system.
 */
import CmsImage from '../../ui/CmsImage.astro';

import SectionHead from '../../academics/SectionHead.astro';

interface Row {
  id: string;
  title: string;
  body: string;
  highlights: string[];
}

/** Only facilities with enough frames to build a collage appear here. */
const rows: Row[] = [
  {
    id: 'library',
    title: 'Nalanda Library',
    body:
      'Fifteen thousand books, a magazine rack, and shelving that runs from mythology to a ' +
      'Ballia literature section of its own. Round tables at the centre for group reading, ' +
      'long tables along the wall for the ones who want quiet.',
    highlights: ['17,574 volumes', 'Dedicated reading programme', 'Ballia literature collection'],
  },
  {
    id: 'chemistry',
    title: 'Chemistry Laboratory',
    body:
      'Bench room for a full practical class at once, with reagent shelving along the wall and ' +
      'preparation space behind. Senior practicals run here through the board year.',
    highlights: ['Full-class bench capacity', 'Reagent and apparatus store', 'Board practical ready'],
  },
  {
    id: 'biology',
    title: 'Biology Laboratory',
    body:
      'Microscope benches, specimen models and charts, and the dissection tables behind them — ' +
      'a room set up so a class can work in pairs rather than watch a demonstration.',
    highlights: ['Microscope stations', 'Specimen and model collection', 'Paired practical layout'],
  },
  {
    id: 'computer',
    title: 'Computer Laboratories',
    body:
      'Two laboratories of networked desktops — one sized for the junior school, one for board-year ' +
      'practicals. Part of what a Microsoft Showcase School is expected to have, and does.',
    highlights: ['Two networked labs', 'Junior and senior provision', 'Microsoft Showcase School'],
  },
  {
    id: 'composite',
    title: 'Composite Science Lab',
    body:
      'The junior science room, where the first experiments happen before physics, chemistry and ' +
      'biology separate into rooms of their own.',
    highlights: ['Middle-school science', 'All three disciplines', 'First practical experience'],
  },
  {
    id: 'josh',
    title: 'JOSH Ground',
    body:
      'The main field. Morning assembly happens here, and so do athletics, inter-house fixtures and ' +
      'the games period for most of the school.',
    highlights: ['Morning assembly', 'Inter-house fixtures', 'Athletics and games'],
  },
];


/**
 * ⚠⚠ CMS FIRST, THE LOCAL ROWS ONLY AS A FALLBACK.
 *
 * `featured` is the six rooms as the school edits them in Campus Tour Page. The
 * `rows` array above is what used to be hardcoded here, and it stays as the
 * fallback for one reason: this band is six rooms of prose, and an unseeded or
 * unpublished CMS would otherwise render an empty band on the campus tour.
 *
 * ⚠ DELETE `rows` ONCE THE CMS IS SEEDED IN EVERY ENVIRONMENT, not before.
 * While both exist they can disagree, and the CMS is the one that wins.
 */
const source: Row[] = featured.length > 0 ? featured : rows;

const byId = new Map(facilities.map((f) => [f.id, f]));
const shown = source
  .map((r) => ({ row: r, fac: byId.get(r.id)! }))
  .filter((x) => x.fac && x.fac.images.length >= 2);
---

<section class="ftr" aria-labelledby="ftr-title">
  <div class="u-container">
    <SectionHead
      id="ftr-title"
      eyebrow={featuredBand.eyebrow}
      heading={featuredBand.heading}
      measure={20}
    />
  </div>

  {shown.map(({ row, fac }, i) => (
    <article class:list={['ftr__row', i % 2 === 1 && 'ftr__row--flip']}>
      <div class="u-container ftr__inner">
        <div class="ftr__collage">
          <div class="ftr__lead" data-parallax data-parallax-y="-20">
            <CmsImage
              file={fac.images[0]}
              alt={`${fac.alt} — main view`}
              sizes="(max-width: 1000px) 92vw, 46vw"
              loading="lazy"
      fallbackWidth={760}
    />
          </div>

          <div class="ftr__sides">
            {fac.images.slice(1, 3).map((src, k) => (
              <div class="ftr__side" data-reveal data-reveal-delay={k * 90}>
                <CmsImage
                  file={src}
                  alt={`${fac.alt} — detail ${k + 1}`}
                  sizes="(max-width: 1000px) 44vw, 22vw"
                  loading="lazy"
      fallbackWidth={760}
    />
              </div>
            ))}
          </div>
        </div>

        <div class="ftr__body">
          <p class="ftr__count t-label">{fac.images.length} photographs</p>
          <h3 class="ftr__h" data-reveal>{row.title}</h3>
          <p class="ftr__copy" data-reveal data-reveal-delay="60">{row.body}</p>

          <ul class="ftr__highs">
            {row.highlights.map((h, k) => (
              <li data-reveal data-reveal-delay={120 + k * 70}>
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" aria-hidden="true">
                  <path d="m5 12.5 4.5 4.5L19 7" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                {h}
              </li>
            ))}
          </ul>

          <a class="link-tertiary ftr__link" href="#gallery" data-fac-jump={fac.id}>
            See all {fac.images.length}
            <svg class="arrow" width="14" height="10" viewBox="0 0 14 10" fill="none" aria-hidden="true">
              <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.5" />
            </svg>
          </a>
        </div>
      </div>
    </article>
  ))}
</section>

<style>
  .ftr {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
    overflow: hidden; /* contains the parallax drift */
  }

  .ftr__row { margin-top: var(--sb-11); }

  .ftr__inner {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 88px);
    align-items: center;
  }

  /* The flip is a grid-order change, not a direction change: `direction: rtl`
     would also reverse the highlight list's bullets and the link's arrow. */
  .ftr__row--flip .ftr__collage { order: 2; }

  .ftr__collage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 30%;
    gap: var(--sb-4);
    align-items: stretch;
  }

  .ftr__lead {
    border-radius: 18px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--sb-sand);
  }

  .ftr__sides {
    display: grid;
    grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: var(--sb-4);
  }

  .ftr__side {
    border-radius: 14px;
    overflow: hidden;
    background: var(--sb-sand);
  }

  .ftr__lead :global(picture),
  .ftr__side :global(picture) { display: block; width: 100%; height: 100%; }

  .ftr__lead :global(img),
  .ftr__side :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 700ms var(--sb-ease);
  }

  .ftr__lead:hover :global(img),
  .ftr__side:hover :global(img) { transform: scale(1.05); }

  .ftr__count { color: var(--sb-text-muted); }

  .ftr__h {
    margin-top: var(--sb-4);
    font-family: var(--sb-font-display);
    font-size: clamp(26px, 3vw, 40px);
    font-weight: 600;
    letter-spacing: -0.025em;
    color: var(--sb-charcoal);
  }

  .ftr__copy {
    margin-top: var(--sb-5);
    max-width: 52ch;
    line-height: 1.68;
    color: var(--sb-text-secondary);
  }

  .ftr__highs {
    list-style: none;
    margin: var(--sb-7) 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: var(--sb-4);
  }

  .ftr__highs li {
    display: flex;
    align-items: center;
    gap: var(--sb-4);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    color: var(--sb-charcoal);
  }

  .ftr__highs svg { color: var(--sb-violet); flex-shrink: 0; }

  .ftr__link { margin-top: var(--sb-7); }

  @media (max-width: 1000px) {
    .ftr__inner { grid-template-columns: minmax(0, 1fr); gap: var(--sb-8); }
    .ftr__row--flip .ftr__collage { order: 0; }
    .ftr__row { margin-top: var(--sb-10); }
  }

  @media (max-width: 560px) {
    .ftr__collage { grid-template-columns: minmax(0, 1fr); }
    .ftr__sides { grid-template-rows: none; grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .ftr__side { aspect-ratio: 1 / 1; }
  }
</style>
