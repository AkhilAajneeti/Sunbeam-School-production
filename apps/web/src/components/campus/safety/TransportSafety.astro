---
import { getCampusSafetyData } from '../../../lib/cms';
const { transportFeatures, transportBand, transportFigures } = await getCampusSafetyData();

/**
 * §4 · TRANSPORT SAFETY — the fleet band.
 *
 * The brief asked for "a premium bus image" with feature cards over it. There is
 * no photograph of a Sunbeam Ballia bus in the repository, and the one aerial
 * that shows a bus park is a different school in hill country. So the band is
 * built as a dark composed panel with the figures carrying it, and the photo
 * slot renders its brief — the composition is finished and swaps to a real
 * photograph the day one arrives, with nothing else moving.
 *
 * THE THREE FIGURES ARE THE ARGUMENT. 29 buses, 22 routes, GPS and governors on
 * every one of them — all published. They lead, and the unconfirmed items follow
 * behind them rather than being mixed in as equals.
 */

import { showBuildNotes } from '../../../data/site';
import { getSchool } from '../../../lib/cms';
import SectionHead from '../../academics/SectionHead.astro';
import Photo from '../../ui/Photo.astro';
import SafetyIcon from './SafetyIcon.astro';
import campus from '../../../assets/photos/sunbeem-1.jpg';

const school = await getSchool();

const icons: Record<string, string> = {
  'GPS Tracking': 'gps',
  'Speed Governor': 'speed',
  '22 Routes': 'route',
  'Verified Drivers': 'badge',
  'Lady Attendant': 'person',
  'Parent Communication': 'message',
};

/**
 * ONE FRAME PER CARD, and only where a real one exists.
 *
 * ⚠ THE HONEST STATE OF THIS: the repository holds no photograph of a school
 * bus, a GPS unit, a driver or an attendant. Of the six cards, exactly one can
 * be illustrated truthfully — "22 Routes", by the campus the routes run to. The
 * other five carry their OWN shot brief rather than a shared one, so hovering
 * still changes the panel and each hover states precisely which photograph is
 * missing. The mechanism is finished; the moment transport photography arrives
 * each card becomes one line in `shots` below.
 */
const shots: Record<string, ImageMetadata | undefined> = {
  '22 Routes': campus,
};

const briefs: Record<string, string> = {
  'GPS Tracking': 'The GPS unit in a bus cab, 16:10 — screen live, route showing',
  'Speed Governor': 'The speed governor fitted in a bus, 16:10 — close, with the seal visible',
  'Verified Drivers': 'A Sunbeam Ballia driver at the wheel, 16:10 — in uniform, bus livery visible',
  'Lady Attendant': 'The attendant helping younger children board, 16:10 — at the bay, morning light',
  'Parent Communication': 'A parent reading a route notice on a phone, 16:10 — or the notice board in use',
};

/**
 * ⚠⚠ CMS FIRST, THESE LITERALS ONLY AS A FALLBACK. `transportFigures` is what
 * the school edits in Campus Safety Page; the array below is what used to be
 * hardcoded here and stays so an unseeded or unpublished CMS does not render a
 * band with three empty figures.
 *
 * ⚠ DELETE `FALLBACK_FIGURES` ONCE THE CMS IS SEEDED IN EVERY ENVIRONMENT, not
 * before — while both exist they can disagree, and the CMS is the one that wins.
 *
 * ⚠⚠ THESE COUNTS ARE STATED THREE TIMES ON THIS PAGE — here, in words in the
 * band's own standfirst ("Twenty-two routes across Ballia"), and inside the
 * "Bus Zone" map point ("29+ buses across 22 routes"). All three are editable
 * and none derives from the others, so a fleet change needs all three.
 */
const FALLBACK_FIGURES = [
  { value: '29+', label: 'Buses in the fleet' },
  { value: '22', label: 'Routes across Ballia' },
  { value: '100%', label: 'GPS and speed-governed' },
];

const figures = transportFigures.length > 0 ? transportFigures : FALLBACK_FIGURES;
---

<section class="tsf" aria-labelledby="tsf-title">
  <div class="u-container">
    <SectionHead
      id="tsf-title"
      eyebrow={transportBand.eyebrow}
      heading={transportBand.heading}
      stand={transportBand.stand}
      tone="dark"
      measure={20}
    />

    <div class="tsf__figures">
      {figures.map((f, i) => (
        <div class="tsf__figure" data-reveal data-reveal-delay={i * 80}>
          <p class="tsf__figure-v t-tabular">{f.value}</p>
          <p class="tsf__figure-l">{f.label}</p>
        </div>
      ))}
    </div>

    <div class="tsf__panel">
      {/* One frame per card, stacked and cross-faded — hovering a feature
          brings its own frame forward. Panes are stacked rather than swapped so
          the box never collapses between two states and the panel height stays
          put while the picture changes. */}
      <div class="tsf__media" data-reveal data-tsf-media>
        {transportFeatures.map((f, i) => (
          <figure class="tsf__pane" data-tsf-pane={i} data-on={i === 0 ? '' : undefined}>
            <Photo
              src={shots[f.label]}
              alt={shots[f.label] ? `${f.label} — Sunbeam School Ballia` : undefined}
              brief={briefs[f.label] ?? 'A Sunbeam Ballia bus at the boarding bay, 16:10'}
              ratio="16 / 10"
              tone="ink"
              ref="A2"
            />
          </figure>
        ))}
      </div>

      <ul class="tsf__cards">
        {transportFeatures.map((f, i) => (
          <li
            class:list={['tsf__card', !f.verified && 'tsf__card--pending']}
            data-tsf-card={i}
            tabindex="0"
            data-reveal
            data-reveal-delay={i * 60}
          >
            <span class="tsf__card-icon"><SafetyIcon name={icons[f.label] ?? 'shield'} size={22} /></span>
            <p class="tsf__card-label">
              {f.label}
              {!f.verified && showBuildNotes && <span class="tsf__chip">to confirm</span>}
            </p>
            <p class="tsf__card-body">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>

    <p class="tsf__contact">
      Transport in-charge · {school.phone.transportIncharge} ·
      <a href={`tel:${school.phone.transport}`} class="t-tabular">{school.phone.transportDisplay}</a>
    </p>
  </div>
</section>

<style>
  .tsf {
    padding-block: var(--sb-section-y);
    background: var(--sb-violet-ink);
    color: rgba(255, 255, 255, 0.76);
  }

  /* --- Figures ------------------------------------------------------------- */

  .tsf__figures {
    margin-top: var(--sb-9);
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sb-7);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    border-bottom: 1px solid rgba(255, 255, 255, 0.14);
    padding-block: var(--sb-7);
  }

  .tsf__figure { text-align: center; }

  .tsf__figure-v {
    font-family: var(--sb-font-display);
    font-size: clamp(38px, 5vw, 60px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-lime);
  }

  .tsf__figure-l {
    margin-top: var(--sb-3);
    font-size: var(--sb-body-sm);
    color: rgba(255, 255, 255, 0.7);
  }

  /* --- Panel --------------------------------------------------------------- */

  .tsf__panel {
    margin-top: var(--sb-9);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--sb-9);
    align-items: start;
  }

  /* --- The swapping panel --------------------------------------------------
     Panes are absolutely stacked inside a ratio-locked box, so the panel holds
     one height no matter which frame is showing. The first pane is in normal
     flow — it is what gives the box its height in the first place, so the
     layout is correct before any script runs and if none ever does. */
  .tsf__media {
    position: relative;
    isolation: isolate;
  }

  .tsf__pane {
    margin: 0;
    opacity: 0;
    transform: scale(1.015);
    transition: opacity 420ms ease, transform 620ms var(--sb-ease);
  }

  .tsf__pane:not(:first-child) {
    position: absolute;
    inset: 0;
  }

  .tsf__pane[data-on] { opacity: 1; transform: none; }

  .tsf__cards {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sb-5);
  }

  /* The active card is marked, so it is obvious WHICH card the panel is
     showing — without it the picture changes and nothing says why. */
  .tsf__card[data-on] {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 255, 255, 0.26);
  }

  .tsf__card:focus-visible {
    outline: 2px solid var(--sb-lime);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tsf__pane { transition: none; transform: none; }
  }

  .tsf__card {
    padding: var(--sb-6) var(--sb-5);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-top: 2px solid var(--sb-lime);
    transition: background var(--sb-dur-link) ease, transform var(--sb-dur-link) var(--sb-ease);
  }

  .tsf__card:hover { background: rgba(255, 255, 255, 0.09); transform: translateY(-2px); }

  .tsf__card--pending {
    border-top-color: rgba(255, 255, 255, 0.22);
    background: transparent;
  }

  .tsf__card-icon { color: var(--sb-lime); margin-bottom: var(--sb-4); }
  .tsf__card--pending .tsf__card-icon { color: rgba(255, 255, 255, 0.42); }

  .tsf__card-label {
    font-weight: 650;
    font-size: var(--sb-body-sm);
    color: #fff;
  }

  .tsf__chip {
    display: inline-block;
    margin-left: var(--sb-2);
    padding: 1px 6px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.82);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .tsf__card-body {
    margin-top: var(--sb-3);
    font-size: var(--sb-caption);
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.66);
  }

  .tsf__contact {
    margin-top: var(--sb-8);
    padding-top: var(--sb-6);
    border-top: 1px solid rgba(255, 255, 255, 0.14);
    font-size: var(--sb-body-sm);
    color: rgba(255, 255, 255, 0.72);
  }

  .tsf__contact a { color: var(--sb-lime); }
  .tsf__contact a:hover { color: #fff; text-decoration: underline; }

  /* --- Narrow -------------------------------------------------------------- */


  @media (max-width: 1023px) {
    .tsf__panel { grid-template-columns: minmax(0, 1fr); }
  }

  @media (max-width: 600px) {
    .tsf__figures { grid-template-columns: minmax(0, 1fr); gap: var(--sb-6); }
    .tsf__cards { grid-template-columns: minmax(0, 1fr); }
  }
</style>

<script>
  /**
   * The panel follows the pointer across the feature cards.
   *
   * Hover AND focus, so tabbing through the six cards drives the picture too —
   * they carry `tabindex="0"` for exactly that reason. Pointer-hover is gated on
   * a device that actually hovers: on a touch screen `:hover` sticks after a tap
   * and the panel would freeze on whichever card was last touched.
   *
   * Leaving the group returns to the first card rather than holding the last —
   * the section should look the same each time it is scrolled back to.
   */
  document.querySelectorAll<HTMLElement>('[data-tsf-media]').forEach((media) => {
    const section = media.closest('section');
    if (!section) return;

    const cards = [...section.querySelectorAll<HTMLElement>('[data-tsf-card]')];
    const panes = [...media.querySelectorAll<HTMLElement>('[data-tsf-pane]')];
    if (!cards.length || !panes.length) return;

    const canHover = window.matchMedia('(hover: hover)').matches;

    const show = (i: number) => {
      panes.forEach((p, k) => (k === i ? p.setAttribute('data-on', '') : p.removeAttribute('data-on')));
      cards.forEach((c, k) => (k === i ? c.setAttribute('data-on', '') : c.removeAttribute('data-on')));
    };

    show(0);

    cards.forEach((card, i) => {
      if (canHover) card.addEventListener('mouseenter', () => show(i));
      card.addEventListener('focus', () => show(i));
      // Tap on touch: the only way to reach a frame without a hover state.
      card.addEventListener('click', () => show(i));
    });

    if (canHover) {
      const list = cards[0].parentElement;
      list?.addEventListener('mouseleave', () => show(0));
    }
  });
</script>
