---
import { getCampusSafetyData } from '../../../lib/cms';
const {emergencyPoints, emergencySteps} = await getCampusSafetyData();

/**
 * §3 · EMERGENCY PREPAREDNESS — split figure, then the response as a flow.
 *
 * The split is asymmetric on purpose: a 5:7 gives the copy the wider half, which
 * is the right way round for a section a parent reads rather than looks at.
 *
 * THE FLOW IS FOUR STEPS AND EVERY ONE IS UNVERIFIED. Alert → Assemble →
 * Account → Assist is standard school evacuation procedure, but the school has
 * published no drill protocol, so the whole strip carries a single honest note
 * rather than four separate "to confirm" chips that would read as noise. It
 * describes what the procedure would be, and says so.
 */

import { showBuildNotes } from '../../../data/site';
import SectionHead from '../../academics/SectionHead.astro';
import Photo from '../../ui/Photo.astro';
import SafetyIcon from './SafetyIcon.astro';

const icons: Record<string, string> = {
  'Fire suppression': 'hose',
  'Evacuation routes': 'exit',
  'Emergency drills': 'alert',
  'First aid': 'cross',
};

const stepIcons = ['alert', 'assemble', 'roll', 'heart'];
---

<section class="emg" aria-labelledby="emg-title">
  <div class="u-container">
    <div class="emg__split">
      <div class="emg__media" data-reveal>
        {/* No photograph of the school's fire equipment exists in the repository.
            Photo renders the labelled brief rather than a stand-in, so the slot
            is a visible request instead of a quiet lie. */}
        <Photo
          brief="Fire hose reel or corridor extinguisher station, 4:5 — the school's own equipment, in place"
          ratio="4 / 5"
          tone="maroon"
          ref="A2"
        />
      </div>

      <div class="emg__body">
        <SectionHead
          id="emg-title"
          eyebrow="If something goes wrong"
          heading="Prepared, not improvised"
          stand="Fire equipment sized for the building, and a procedure everyone has walked before they need it."
          align="start"
          measure={18}
        />

        <ul class="emg__points">
          {emergencyPoints.map((p, i) => (
            <li
              class:list={['emg__point', !p.verified && 'emg__point--pending']}
              data-reveal
              data-reveal-delay={i * 70}
            >
              <span class="emg__point-icon"><SafetyIcon name={icons[p.label] ?? 'shield'} size={20} /></span>
              <div>
                <p class="emg__point-label">
                  {p.label}
                  {!p.verified && showBuildNotes && <span class="emg__chip">to confirm</span>}
                </p>
                <p class="emg__point-body">{p.body}</p>
              </div>
            </li>
          ))}
        </ul>
      </div>
    </div>

    {/* --- Response flow ---------------------------------------------------- */}
    <div class="emg__flow" data-reveal>
      <p class="emg__flow-head t-label">The response, in order</p>

      <ol class="emg__steps">
        {emergencySteps.map((s, i) => (
          <li class="emg__step" data-reveal data-reveal-delay={i * 90}>
            <span class="emg__step-icon"><SafetyIcon name={stepIcons[i]} size={22} /></span>
            <span class="emg__step-n t-tabular">{s.step}</span>
            <p class="emg__step-label">{s.label}</p>
            <p class="emg__step-body">{s.body}</p>
          </li>
        ))}
      </ol>

      <p class="emg__flow-note">
        This sequence describes standard school evacuation procedure. Sunbeam Ballia
        has not yet published its own drill protocol — the steps above are awaiting
        the school's confirmation.
      </p>
    </div>
  </div>
</section>

<style>
  .emg {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .emg__split {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--sb-11);
    align-items: center;
  }

  .emg__media :global(.ph),
  .emg__media :global(.photo) { width: 100%; }

  /* --- Points -------------------------------------------------------------- */

  .emg__points {
    list-style: none;
    margin: var(--sb-8) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--sb-6) var(--sb-7);
  }

  .emg__point {
    display: flex;
    gap: var(--sb-4);
    padding-top: var(--sb-5);
    border-top: 2px solid var(--sb-violet);
  }

  .emg__point--pending { border-top-color: var(--sb-border); }

  .emg__point-icon { color: var(--sb-violet); }
  .emg__point--pending .emg__point-icon { color: var(--sb-text-muted); }

  .emg__point-label {
    font-weight: 650;
    font-size: var(--sb-body-sm);
    color: var(--sb-charcoal);
  }

  .emg__chip {
    display: inline-block;
    margin-left: var(--sb-3);
    padding: 1px 7px;
    border-radius: 999px;
    background: var(--sb-lime-wash);
    color: var(--sb-lime-deep);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .emg__point-body {
    margin-top: var(--sb-2);
    font-size: var(--sb-body-sm);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  /* --- Flow ---------------------------------------------------------------- */

  .emg__flow {
    margin-top: var(--sb-11);
    padding: var(--sb-8) var(--sb-8) var(--sb-7);
    background: var(--sb-paper);
    border: var(--sb-hairline);
  }

  .emg__flow-head { color: var(--sb-violet); }

  .emg__steps {
    list-style: none;
    margin: var(--sb-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-6);
  }

  /* The chevron between steps is generated, so the markup stays four list items
     and a screen reader is not read four stray arrow characters. */
  .emg__step {
    position: relative;
    padding-right: var(--sb-6);
  }

  .emg__step + .emg__step::before {
    content: '';
    position: absolute;
    left: calc(var(--sb-6) * -1);
    top: 12px;
    width: 7px;
    height: 7px;
    border-top: 1.5px solid var(--sb-violet);
    border-right: 1.5px solid var(--sb-violet);
    transform: rotate(45deg);
    opacity: 0.55;
  }

  .emg__step-icon { color: var(--sb-violet); margin-bottom: var(--sb-4); }

  .emg__step-n {
    font-size: var(--sb-caption);
    font-weight: 700;
    color: var(--sb-lime-deep);
    letter-spacing: 0.08em;
  }

  .emg__step-label {
    margin-top: var(--sb-2);
    font-family: var(--sb-font-display);
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .emg__step-body {
    margin-top: var(--sb-3);
    font-size: var(--sb-body-sm);
    line-height: 1.55;
    color: var(--sb-text-secondary);
  }

  .emg__flow-note {
    margin-top: var(--sb-7);
    padding-top: var(--sb-5);
    border-top: var(--sb-hairline);
    font-size: var(--sb-caption);
    line-height: 1.6;
    color: var(--sb-text-muted);
    max-width: 74ch;
  }

  /* --- Narrow -------------------------------------------------------------- */

  @media (max-width: 1023px) {
    .emg__split { grid-template-columns: minmax(0, 1fr); gap: var(--sb-9); }
    .emg__media { max-width: 420px; }
    .emg__steps { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--sb-7); }
    .emg__step:nth-child(3)::before { display: none; }
  }

  @media (max-width: 600px) {
    .emg__points { grid-template-columns: minmax(0, 1fr); }
    .emg__steps { grid-template-columns: minmax(0, 1fr); }
    .emg__step::before { display: none !important; }
    .emg__flow { padding: var(--sb-6); }
  }
</style>
