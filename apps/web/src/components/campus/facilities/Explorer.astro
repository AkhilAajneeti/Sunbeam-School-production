---
import { getFacilitiesData } from '../../../lib/cms';
const {allItems, groups} = await getFacilitiesData();

/**
 * §5 · FACILITY EXPLORER — the complete list, filterable, in one grid.
 *
 * THIS SECTION IS THE CONTENT-PRESERVATION GUARANTEE. Every item in
 * src/data/facilities.ts renders here, flattened out of its group. The designed
 * sections above are a curated route through the inventory; this is the
 * inventory. If a facility exists in the data it appears in this grid, so
 * nothing can be lost by being left out of a feature row.
 *
 * The running count in the heading is computed, not typed — it cannot drift from
 * what is on the page, and it is the page's own audit of itself.
 *
 * Equal-height cards on a single ground, per the brief's "avoid random
 * background colours": the only colour is the icon plate, and only the hover
 * state moves.
 */

import { showBuildNotes } from '../../../data/site';
import SectionHead from '../../academics/SectionHead.astro';
import FacIcon from './FacIcon.astro';
---

<section class="exp" aria-labelledby="exp-title">
  <div class="u-container">
    <SectionHead
      id="exp-title"
      eyebrow="Everything, in one place"
      heading={`All ${allItems.length} facilities`}
      stand="The complete inventory — filter it, or read straight down."
      measure={20}
    />

    <div class="exp__filters" role="group" aria-label="Filter facilities by category">
      <button type="button" class="exp__chip is-on" data-exp-filter="all" aria-pressed="true">
        All <span>{allItems.length}</span>
      </button>
      {groups.map((g) => (
        <button type="button" class="exp__chip" data-exp-filter={g.id} aria-pressed="false">
          {g.title} <span>{g.items.length}</span>
        </button>
      ))}
    </div>

    <p class="u-visually-hidden" role="status" data-exp-status></p>

    <ul class="exp__grid" data-exp-grid>
      {allItems.map((it, i) => (
        <li class="exp__cell" data-exp-cell={it.groupId} data-reveal data-reveal-delay={(i % 4) * 55}>
          <article class="exp__card">
            <span class="exp__icon"><FacIcon name={it.icon} size={22} /></span>
            <h3 class="exp__label">
              {it.label}
              {it.unlisted && showBuildNotes && <span class="exp__flag">verify</span>}
            </h3>
            <p class="exp__body">{it.body}</p>
            <p class="exp__group t-label">{it.group}</p>
          </article>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .exp {
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  /* --- Filters ------------------------------------------------------------- */

  .exp__filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sb-3);
    justify-content: center;
    margin-top: var(--sb-9);
  }

  .exp__chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    background: var(--sb-paper);
    border: var(--sb-hairline);
    color: var(--sb-text-secondary);
    font-size: var(--sb-body-sm);
    font-weight: 600;
    cursor: pointer;
    transition: background var(--sb-dur-link) ease, color var(--sb-dur-link) ease,
      border-color var(--sb-dur-link) ease;
  }

  .exp__chip:hover { border-color: var(--sb-violet); color: var(--sb-violet); }

  .exp__chip.is-on {
    background: var(--sb-violet);
    border-color: var(--sb-violet);
    color: #fff;
  }

  .exp__chip span { font-size: 11px; font-weight: 700; opacity: 0.62; }

  /* --- Grid ---------------------------------------------------------------- */

  .exp__grid {
    list-style: none;
    margin: var(--sb-9) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--sb-5);
  }

  .exp__cell[hidden] { display: none; }

  /* Equal heights come from the cell stretching and the card filling it, so a
     three-line description does not leave a short card beside a tall one. */
  .exp__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: var(--sb-6);
    background: var(--sb-paper);
    border-radius: 14px;
    box-shadow: 0 1px 2px rgba(28, 14, 8, 0.04);
    transition: transform var(--sb-dur-link) var(--sb-ease), box-shadow var(--sb-dur-link) ease;
  }

  .exp__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 2px 4px rgba(28, 14, 8, 0.06), 0 16px 34px rgba(28, 14, 8, 0.1);
  }

  .exp__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 11px;
    background: var(--sb-violet-wash);
    color: var(--sb-violet);
    margin-bottom: var(--sb-5);
  }

  .exp__card:hover .exp__icon { background: var(--sb-violet); color: #fff; }

  .exp__label {
    font-family: var(--sb-font-display);
    font-size: 16px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--sb-charcoal);
  }

  .exp__flag {
    display: inline-block;
    margin-left: var(--sb-2);
    padding: 1px 6px;
    border-radius: 999px;
    background: var(--sb-lime-wash);
    color: var(--sb-lime-deep);
    font-family: var(--sb-font-body);
    font-size: 9px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    vertical-align: 2px;
  }

  .exp__body {
    margin-top: var(--sb-3);
    font-size: var(--sb-caption);
    line-height: 1.6;
    color: var(--sb-text-secondary);
  }

  /* Pushed to the foot by margin-top:auto, so the category label lines up across
     a row whatever length the descriptions are. */
  .exp__group {
    margin-top: auto;
    padding-top: var(--sb-5);
    color: var(--sb-text-muted);
  }

  @media (max-width: 1100px) { .exp__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .exp__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 480px) { .exp__grid { grid-template-columns: minmax(0, 1fr); } }
</style>

<script>
  const cells = [...document.querySelectorAll<HTMLElement>('[data-exp-cell]')];
  const chips = [...document.querySelectorAll<HTMLButtonElement>('[data-exp-filter]')];
  const status = document.querySelector<HTMLElement>('[data-exp-status]');

  chips.forEach((btn) =>
    btn.addEventListener('click', () => {
      const id = btn.dataset.expFilter!;
      let shown = 0;
      cells.forEach((c) => {
        const match = id === 'all' || c.dataset.expCell === id;
        c.hidden = !match;
        if (match) shown++;
      });
      chips.forEach((b) => {
        const on = b.dataset.expFilter === id;
        b.classList.toggle('is-on', on);
        b.setAttribute('aria-pressed', String(on));
      });
      if (status) status.textContent = `${shown} facilities shown.`;
    })
  );
</script>
