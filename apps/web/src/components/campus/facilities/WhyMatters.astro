---
import { getFacilitiesData } from '../../../lib/cms';
const {whyCards} = await getFacilitiesData();

/**
 * §7 · WHY THE INFRASTRUCTURE MATTERS — benefit, not inventory.
 *
 * The brief's instruction was explicit: "each card should explain how the
 * facility benefits students, not just list its name". So no card here names a
 * room. Each one takes a figure the page has already proved and says what it
 * buys a child — "eighty-plus computers" becomes "a child works alone, not in a
 * group of four", which is the sentence a parent is actually weighing.
 *
 * Dark ground because it closes the argument before the CTA, and because six
 * light cards after six light group bands would disappear into them.
 */

import SectionHead from '../../academics/SectionHead.astro';
import FacIcon from './FacIcon.astro';
---

<section class="why" aria-labelledby="why-title">
  <span class="why__glow" aria-hidden="true"></span>

  <div class="u-container why__inner">
    <SectionHead
      id="why-title"
      eyebrow="What it adds up to"
      heading="Why any of this matters"
      stand="Buildings are not the argument. What a child can do inside them is."
      tone="dark"
      measure={20}
    />

    <ul class="why__grid">
      {whyCards.map((c, i) => (
        <li class="why__card" data-reveal data-reveal-delay={(i % 3) * 80}>
          <span class="why__icon"><FacIcon name={c.icon} size={24} /></span>
          <h3 class="why__h">{c.title}</h3>
          <p class="why__body">{c.body}</p>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .why {
    position: relative;
    padding-block: var(--sb-section-y);
    background: var(--sb-violet-ink);
    color: rgba(255, 255, 255, 0.76);
    overflow: hidden;
    isolation: isolate;
  }

  .why__inner { position: relative; z-index: 1; }

  /* A single soft warm bloom behind the heading — enough to stop the band being
     a flat rectangle, cheap enough to cost nothing. */
  .why__glow {
    position: absolute;
    top: -20%;
    left: 50%;
    width: min(900px, 90vw);
    aspect-ratio: 1;
    translate: -50% 0;
    background: radial-gradient(circle, rgba(201, 60, 10, 0.22), transparent 62%);
    pointer-events: none;
    z-index: 0;
  }

  .why__grid {
    list-style: none;
    margin: var(--sb-10) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--sb-6);
  }

  .why__card {
    padding: var(--sb-7) var(--sb-6) var(--sb-8);
    background: rgba(255, 255, 255, 0.045);
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    transition: background var(--sb-dur-link) ease, border-color var(--sb-dur-link) ease,
      transform var(--sb-dur-link) var(--sb-ease);
  }

  .why__card:hover {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(255, 255, 255, 0.2);
    transform: translateY(-4px);
  }

  .why__icon {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 12px;
    background: rgba(255, 138, 92, 0.14);
    color: var(--sb-lime);
    margin-bottom: var(--sb-6);
  }

  .why__h {
    font-family: var(--sb-font-display);
    font-size: 21px;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: #fff;
  }

  .why__body {
    margin-top: var(--sb-4);
    font-size: var(--sb-body-sm);
    line-height: 1.68;
    color: rgba(255, 255, 255, 0.68);
  }

  @media (max-width: 1000px) { .why__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .why__grid { grid-template-columns: minmax(0, 1fr); } }
</style>
