---
import { getFacilitiesData } from '../../../lib/cms';
const { kpis, figuresBand } = await getFacilitiesData();

/**
 * §2 · INFRASTRUCTURE OVERVIEW — eight KPI cards.
 *
 * Every figure is one the school publishes (docs/01 § 5). `data-count` is the
 * site's existing count-up hook, and the value is ALSO written as static text so
 * the number is correct and readable if the GSAP chunk never loads — a figure
 * that renders as "0" on a slow phone is worse than one that never animates.
 *
 * ONE FIGURE THE BRIEF ASKED FOR IS ABSENT. "Other staff" is on the brief's KPI
 * list, but the school publishes no count for non-teaching staff anywhere. A
 * plausible number would be an invention, so the card is not here — and this
 * comment is where that decision is recorded.
 */

import SectionHead from '../../academics/SectionHead.astro';
import BurstCard from '../../ui/BurstCard.astro';
import FacIcon from './FacIcon.astro';
---

<section class="kpi" aria-labelledby="kpi-title">
  <div class="u-container">
    <SectionHead
      id="kpi-title"
      eyebrow={figuresBand.eyebrow}
      heading={figuresBand.heading}
      stand={figuresBand.stand}
      measure={20}
    />

    {/* Same card as Parent Partnership §04 — the flipping disc, the pointer
        bloom and the corner ribbon all come from BurstCard. Only the content
        differs: a figure carries this card where a title carries that one, so
        the minimum height comes down from 350px to 300px. */}
    <ol class="kpi__grid">
      {kpis.map((k, i) => (
        <BurstCard
          index={i + 1}
          class="kpi__card"
          minHeight="clamp(240px, 22vw, 300px)"
          data-pop
          data-pop-delay={(i % 4) * 90}
        >
          <FacIcon slot="icon" name={k.icon} size={26} />

          <p class="kpi__n t-tabular">
            <span data-count={k.count} data-count-suffix={k.suffix}>
              {k.count.toLocaleString('en-IN')}{k.suffix}
            </span>
          </p>
          <h3 class="kpi__label">{k.label}</h3>
          <p class="kpi__note">{k.note}</p>
        </BurstCard>
      ))}
    </ol>
  </div>
</section>

<style>
  .kpi {
    padding-block: var(--sb-section-y);
    background: var(--sb-ivory);
  }

  .kpi__grid {
    list-style: none;
    margin: clamp(38px, 5.6vh, 68px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 30px);
  }

  /* The card chrome is BurstCard's. Everything below is content only — the
     figure, its label and the note under it. */

  .kpi__n {
    margin-top: clamp(20px, 2.4vw, 32px);
    font-family: var(--sb-font-display);
    font-size: clamp(30px, 3.4vw, 46px);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.04em;
    color: var(--sb-charcoal);
  }

  h3.kpi__label {
    margin-top: var(--sb-4);
    font-family: var(--sb-font-display);
    font-size: clamp(16px, 1.3vw, 19px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: var(--sb-violet);
    text-wrap: balance;
  }

  /* margin-top:auto pins the note to the foot, so the notes line up across a row
     however long the labels above them run. */
  .kpi__note {
    margin-top: auto;
    padding-top: var(--sb-4);
    font-size: var(--sb-caption);
    line-height: 1.55;
    color: var(--sb-text-muted);
  }

  @media (max-width: 1100px) { .kpi__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } }
  @media (max-width: 800px) { .kpi__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }

  /* STAYS TWO-UP ON PHONES. It used to drop to one column below 460, which
     turned eight figures into eight full-width cards and roughly 2,400px of
     scrolling before the page proper began. Two-up halves that. The card's
     minimum height comes down to match the narrower measure, and the figure
     steps down a size so "17,574" cannot overflow a ~160px card. */
  @media (max-width: 560px) {
    .kpi__grid { gap: 10px; }
    .kpi__grid :global(.bcard) { --bcard-min: 186px; padding: 16px 14px; }
    .kpi__n { margin-top: 14px; font-size: clamp(24px, 7vw, 30px); }
    h3.kpi__label { font-size: 14px; }
    .kpi__note { font-size: 11px; padding-top: 10px; }
    .kpi__grid :global(.bcard__badge) { width: 40px; }
  }
</style>
