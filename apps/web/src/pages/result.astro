---
/**
 * ESSENTIAL INFORMATION · RESULT.
 *
 * The school's Result page is a heading, the line "WANT TO CHECK YOUR REPORT
 * CARD?", and a "Click here" opening its portal in a new tab. This page changes
 * the presentation and preserves the destination exactly. No pass percentage,
 * topper, mark or year table appears anywhere — the school publishes none.
 * Sourcing is in data/services.ts.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import ResultPage from '../components/services/ResultPage.astro';

import banner from '../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
>
  <PageHero
    {/* ⚠ TWO CRUMBS — HOME / RESULT, as specified. PageHero appends the
        current page from `title`, so passing Home alone yields exactly that. */}
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ResultPage />
  </div>
</BaseLayout>
