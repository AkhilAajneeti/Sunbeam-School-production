---
/**
 * HOMEPAGE — section order fixed by docs/04 § G1.
 *
 * The page is an answer sequence: each section closes one parent question and
 * opens the next.
 *
 * BUILT     §01 Utility Bar · §02 Main Navigation (BaseLayout)
 *           §03 Hero · §03b Proof Strip · §04 Quick Access
 *           §05 Sunbeam Story · §07 Learning   (§06 Academic Journey removed for now)
 *           §08 Campus · §11 Events & News · §10 Notice Board + §12 Alumni
 *           §12b Voices · §13 Affiliations · §14 Achievements · §15 Admissions CTA
 *           §16 Footer
 * PENDING   §10 dedicated event galleries (blocked on asset A2)
 *
 * ORDER — §13 Affiliations then §14 Achievements is fixed by the audit, which
 * places affiliations "before the footer" and achievements immediately after
 * it. §15 closes the page on the admissions ask.
 *
 * Background rhythm — no two adjacent sections share a treatment:
 *   dark → sand → ivory → paper → ivory → ink → ivory mosaic → sand
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/home/Hero.astro';
import ProofStrip from '../components/home/ProofStrip.astro';
import QuickAccess from '../components/home/QuickAccess.astro';
import Story from '../components/home/Story.astro';
import PrincipalSpeak from '../components/home/PrincipalSpeak.astro';
import Learning from '../components/home/Learning.astro';
import Campus from '../components/home/Campus.astro';
import EventsNews from '../components/home/EventsNews.astro';
import NoticeBoard from '../components/home/NoticeBoard.astro';
import Voices from '../components/home/Voices.astro';
import Affiliations from '../components/home/Affiliations.astro';
import Achievements from '../components/home/Achievements.astro';
import AdmissionsCta from '../components/home/AdmissionsCta.astro';
---

<BaseLayout
>
  <Hero />
  <ProofStrip />
  <QuickAccess />
  <Story />
  <PrincipalSpeak />
  <Campus />
  <Learning />
  <EventsNews />
  <NoticeBoard />
  <Voices />
  <Affiliations />
  <Achievements />
  <AdmissionsCta />
</BaseLayout>
