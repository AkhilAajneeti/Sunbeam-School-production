---
import { getActivitiesData } from '../../../lib/cms';

const { schoolActivities } = await getActivitiesData();
/**
 * SCHOOL ACTIVITIES — page 1 of the index.
 *
 * ⚠ PAGE ONE IS THIS ROUTE, NOT `/page/1/`. Serving identical content at two
 * URLs is the commonest way a site competes with itself in search, and this is a
 * top-level navigation destination. `Pager` expresses the same rule when it
 * builds hrefs, so the two halves agree.
 *
 * ⚠ THIS ROUTE WAS IN THE MAIN NAVIGATION WITH NO PAGE BEHIND IT.
 * `/beyond-academics/school-activities/` is navigation.ts §5, a top-level menu
 * item; until now it landed on the generated "page coming" placeholder. Writing
 * this file retires that placeholder automatically — pages/[...slug].astro only
 * mints routes that have no file.
 *
 * The body lives in components/news/ActivityIndex so page 1 and page 2 cannot
 * drift; see the note there.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ActivityIndex from '../../../components/news/ActivityIndex.astro';
---

<BaseLayout
>
  <ActivityIndex current={1} />
</BaseLayout>
