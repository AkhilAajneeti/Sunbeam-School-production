---
/**
 * ALUMNI — the index.
 *
 * The body renders entirely from data/alumniMeets.ts and data/alumni.ts. What
 * is verified, what is not, and why a meet without photographs renders a
 * typographic plate rather than borrowing a school photograph, are in those
 * files' headers and the component's.
 *
 * Writing this file also retires the generated placeholder: [...slug].astro
 * emits every nav destination that has no page, and a static route always wins.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import AlumniPage from '../../components/alumni/AlumniPage.astro';

/* ⚠ THE MEET'S OWN GROUP PHOTOGRAPH, published by the school on its
   school-activities page. It replaced a campus shot the moment the real
   image existed — an Alumni banner should show alumni. */
import banner from '../../assets/alumni-meets/pradiptam-2-0-2026-27/01-group-on-the-steps.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <AlumniPage />
  </div>
</BaseLayout>
