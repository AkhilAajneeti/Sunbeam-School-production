---
/**
 * ONE ALUMNI MEET — /alumni/<slug>/.
 *
 * ⚠ THE ROUTES ARE GENERATED FROM THE PUBLISHED MEETS AND NOTHING ELSE. An
 * unpublished meet has no page at all rather than a page nobody links to, and
 * adding a meet to data/alumniMeets.ts mints its route on the next build.
 *
 * ⚠⚠ ONLY FIELDS THAT CARRY A VALUE ARE RENDERED. The school publishes no date,
 * venue, attendance figure, chief guest or programme for any meet, so this page
 * has no rows for them — not empty rows, not "TBA". A blank field on a school
 * page is an invitation to fill it in with a guess, and this whole build exists
 * to stop that happening.
 *
 * ⚠ NO SIBLING NAVIGATION WHILE THERE IS ONE MEET. Previous/next links across a
 * single-item set are two dead controls; they appear once a second meet does.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import Lightbox from '../../components/ui/Lightbox.astro';
import CmsImage from '../../components/ui/CmsImage.astro';
import '../../styles/assessment.css';
import { MARK } from '../../components/academics/assessment/marks';
import { getAlumniMeets, fileUrl, getSchool } from '../../lib/cms';

import bannerFallback from '../../assets/photos/sunbeem-1.jpg';

const school = await getSchool();

/**
 * ⚠ ONE REQUEST FOR EVERY MEET, NOT ONE PER PAGE. getStaticPaths returns the
 * meet as a prop, so each generated page already holds its own record and never
 * fetches again — the N+1 that a per-page query would cause during a build.
 *
 * ⚠ ONLY PUBLISHED MEETS GET A ROUTE, and that is now enforced by the CMS rather
 * than by remembering to filter. A draft meet is invisible to the read-only
 * token, so it cannot mint a page.
 */
export async function getStaticPaths() {
  const meets = await getAlumniMeets();
  return meets.map((meet, index) => ({
    params: { slug: meet.slug },
    props: { meet, prev: index > 0 ? meets[index - 1] : null, next: meets[index + 1] ?? null },
  }));
}

const { meet, prev, next } = Astro.props;

const S = 'Sunbeam School Ballia';
const ALL = '/alumni/';

/* ⚠ prev/next COME FROM getStaticPaths NOW. They used to be computed here by
   searching the full published list for this meet's own index — which meant
   every generated page re-read the whole collection to find its two neighbours.
   The path builder already knows the order, so it hands them over as props. */
---

<BaseLayout
  title={`${meet.title} — Alumni Meet ${meet.session} — ${S}`}
  description={meet.description[0]}
>
  <PageHero
    title={meet.title}
    standfirst={meet.subtitle ? `${meet.subtitle} · Alumni Meet ${meet.session}` : `Alumni Meet ${meet.session}`}
    crumbs={[
      { label: 'Home', href: '/' },
      { label: 'Alumni', href: ALL },
    ]}
    src={bannerFallback}
    file={meet.cover}
    alt={meet.coverAlt ?? `The main building of ${S} at Agarsanda.`}
    position="50% 46%"
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <section class="as-sec as-sec--ivory as-pad am-body" aria-labelledby="am-about-t">
      <span class="as-warm" aria-hidden="true"></span>

      <div class="u-container am-grid">
        <div class="am-copy">
          <p class="as-kicker" data-reveal>About the meet</p>
          <h2 class="as-h as-h--lg am-h" id="am-about-t">
            <span data-clip data-clip-delay="0">{meet.title}</span>
            {meet.subtitle && <span data-clip data-clip-delay="150"><em>{meet.subtitle}</em></span>}
          </h2>

          {meet.description.map((para, i) => (
            <p class="as-body" data-reveal data-reveal-delay={180 + i * 55}>{para}</p>
          ))}
        </div>

        <aside class="am-side" aria-label="Meet details">
          <dl class="am-facts">
            <div class="am-fact">
              <dt>Session</dt>
              <dd class="t-tabular">{meet.session}</dd>
            </div>
            <div class="am-fact">
              <dt>Event</dt>
              <dd>{meet.subtitle ? `${meet.title} — ${meet.subtitle}` : meet.title}</dd>
            </div>
            {meet.gallery.length > 0 && (
              <div class="am-fact">
                <dt>Photographs</dt>
                <dd class="t-tabular">{meet.gallery.length}</dd>
              </div>
            )}
          </dl>

          {/* ⚠ THE ABSENCE STATED. Better than three empty rows. */}
          <p class="am-side__n">
            The school has not published a date, a venue or an attendance figure for this meet, so
            none is shown. The school office holds the details.
          </p>
          <p class="am-side__a">
            <a class="as-btn" href={`tel:${school.phone.office}`}>
              {school.phone.officeDisplay}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                <g stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" set:html={MARK.phone} />
              </svg>
            </a>
          </p>
        </aside>
      </div>

      {meet.source && <p class="am-src">{meet.source}</p>}
    </section>

    <section class="as-sec as-sec--paper as-pad am-gal" id="gallery" aria-labelledby="am-gal-t">
      <span class="as-grid as-grid--fine" aria-hidden="true"></span>

      <div class="u-container">
        <p class="as-kicker" data-reveal>Gallery</p>
        <h2 class="as-h as-h--md am-gal__h" id="am-gal-t">
          <span data-clip data-clip-delay="0">Photographs from</span>
          <span data-clip data-clip-delay="140"><em>the meet</em></span>
        </h2>

        {meet.gallery.length > 0 ? (
          <ul class="am-shots">
            {meet.gallery.map((g, i) => (
              <li class="am-shot" data-pop data-pop-delay={80 + i * 45}>
                <a class="am-shot__a" data-lb-open href={fileUrl(g.image)} data-lb-alt={g.alt} data-lb-cap={g.caption ?? g.alt}>
                  <CmsImage
                    file={g.image}
                    alt={g.alt}
                    sizes="(max-width: 767px) 92vw, 30vw"
                    fallbackWidth={760}
                    loading="lazy"
                  />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <div class="am-empty">
            <p class="am-empty__k">Photographs have not been added yet</p>
            <p class="am-empty__v">
              When the school’s own photographs of this meet are added they appear here, and in the
              gallery strip on the <a href={ALL}>Alumni page</a>. No image is shown in the meantime —
              a photograph from another school event, captioned as this meet, would misdescribe
              everybody in the frame.
            </p>
          </div>
        )}
      </div>
    </section>

    <nav class="am-nav" aria-label="Alumni meets">
      <div class="u-container am-nav__in">
        <a class="am-nav__back" href={ALL}>
          <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M15 5 8 12l7 7" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
          All alumni meets
        </a>

        {(prev || next) && (
          <p class="am-nav__sib">
            {prev && <a href={`${ALL}${prev.slug}/`}>← {prev.title}</a>}
            {next && <a href={`${ALL}${next.slug}/`}>{next.title} →</a>}
          </p>
        )}
      </div>
    </nav>
  </div>

  <Lightbox />
</BaseLayout>

<style>
  .am-grid {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.85fr);
    gap: clamp(26px, 3.6vw, 58px);
    align-items: start;
  }
  .am-h { max-width: 18ch; }
  .am-copy .as-body { max-width: 62ch; }

  .am-side {
    padding: clamp(16px, 2vw, 26px) clamp(16px, 2vw, 24px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
  }
  .am-facts { margin: 0; }
  .am-fact {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 14px;
    padding: clamp(8px, 1vw, 12px) 0;
    border-bottom: 1px solid var(--sb-border);
  }
  .am-fact dt { font-size: clamp(9.5px, 0.72vw, 11.4px); color: var(--sb-text-muted); }
  .am-fact dd {
    margin: 0;
    text-align: right;
    font-size: clamp(10.5px, 0.8vw, 12.6px);
    font-weight: 700;
    color: var(--sb-charcoal);
  }
  .am-side__n {
    margin: clamp(11px, 1.4vw, 16px) 0 0;
    font-size: clamp(9px, 0.68vw, 10.8px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }
  .am-side__a { margin: clamp(12px, 1.5vw, 18px) 0 0; }
  .am-side__a .as-btn { width: 100%; justify-content: center; }

  .am-src {
    position: relative;
    max-width: 78ch;
    margin: clamp(22px, 2.8vw, 34px) auto 0;
    padding: 0 var(--sb-margin);
    text-align: center;
    font-size: clamp(9px, 0.68vw, 10.8px);
    line-height: 1.66;
    color: var(--sb-text-muted);
  }

  .am-gal { scroll-margin-top: calc(var(--sb-masthead-h) + 24px); }
  .am-gal__h { margin-top: 0; }
  .am-shots {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 20px);
    margin: clamp(20px, 2.6vw, 32px) 0 0;
    padding: 0;
    list-style: none;
  }
  .am-shot__a { display: block; overflow: hidden; border-radius: var(--sb-r-2); cursor: zoom-in; }
  .am-shot__a :global(picture) { display: block; }
  .am-shot__a :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    transition: scale var(--sb-dur-image) var(--sb-ease);
  }
  .am-shot__a:hover :global(img) { scale: 1.06; }

  .am-empty {
    display: grid;
    gap: 6px;
    margin: clamp(20px, 2.6vw, 32px) 0 0;
    padding: clamp(26px, 3.6vw, 48px);
    border: 1px dashed var(--sb-border-strong);
    border-radius: var(--sb-r-3);
    background: var(--sb-ivory);
    text-align: center;
  }
  .am-empty__k {
    margin: 0;
    font-family: var(--sb-font-display);
    font-size: clamp(14px, 1.24vw, 20px);
    font-weight: 700;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
  }
  .am-empty__v { margin: 0 auto; max-width: 62ch; font-size: clamp(9.6px, 0.72vw, 11.4px); line-height: 1.66; color: var(--sb-text-muted); }
  .am-empty__v a { color: var(--sb-violet); font-weight: 700; text-decoration: underline; text-underline-offset: 3px; }

  .am-nav { padding-block: clamp(20px, 2.6vw, 34px); background: var(--sb-ivory); border-top: 1px solid var(--sb-border); }
  .am-nav__in { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: clamp(10px, 1.4vw, 18px); }
  .am-nav__back,
  .am-nav__sib a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: clamp(10px, 0.76vw, 12.2px);
    font-weight: 700;
    color: var(--sb-violet);
  }
  .am-nav__back svg { width: 14px; height: auto; }
  .am-nav__back:hover,
  .am-nav__sib a:hover { color: var(--sb-orange-bright); }
  .am-nav__sib { display: flex; gap: clamp(12px, 1.6vw, 22px); margin: 0; }

  @media (max-width: 1023px) {
    .am-grid { grid-template-columns: minmax(0, 1fr); }
    .am-h { max-width: none; }
  }

  @media (max-width: 767px) {
    .am-shots { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }

  @media (max-width: 479px) {
    .am-shots { grid-template-columns: minmax(0, 1fr); }
  }
</style>
