---
/**
 * ALUMNI REGISTRATION.
 *
 * Two kinds of content sit on this page and are kept apart deliberately: the
 * Pradiptam 2.0 meet is published fact from the school's own site, and the form,
 * the purpose strip and the engagement cards are UI proposed for the new site.
 * The reasoning, and the notice that states it on the page itself, are in the
 * component header and in data/alumniRegistration.ts.
 *
 * The banner, navbar and footer are untouched: this hero is the same PageHero
 * treatment every other page uses, with no variant props.
 *
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import AlumniRegistrationPage from '../../components/alumni/AlumniRegistrationPage.astro';

import banner from '../../assets/alumni-meets/allumniBanner.png';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <AlumniRegistrationPage />
  </div>
</BaseLayout>
