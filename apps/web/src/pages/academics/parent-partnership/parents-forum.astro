---
/**
 * PARENT PARTNERSHIP · PARENTS' FORUM.
 *
 * The body is a bespoke composition and its agenda is data-driven from
 * data/parentsForum.ts — twelve items transcribed off the school's own projected
 * slide. Why the design brief's twelve are not the school's twelve, and why four
 * of them carry no description, are in that file's header and the component's.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import ParentsForumPage from '../../../components/academics/partnership/ParentsForumPage.astro';

import banner from '../../../assets/parents forum/parents forum (5).jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ParentsForumPage />
  </div>
</BaseLayout>
