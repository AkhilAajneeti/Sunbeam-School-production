---
/**
 * PARENT PARTNERSHIP · SCHOOL–PARENT COMMUNICATION.
 *
 * Every number, address and link on the body comes out of data/site.ts — not one
 * is typed into the component. What the school does NOT publish, and is
 * therefore not claimed anywhere on the page, is listed in the component header.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SchoolParentCommunicationPage from '../../../components/academics/partnership/SchoolParentCommunicationPage.astro';

import banner from '../../../assets/corridor and stairs/DSC_1223 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <SchoolParentCommunicationPage />
  </div>
</BaseLayout>
