---
/**
 * PARENT PARTNERSHIP · PARENT ORIENTATION — audit §2F.
 *
 * ⚠ THE BANNER IS THE SHARED PageHero, AND THAT IS NOT NEGOTIABLE. An earlier
 * version of this page replaced it with a bespoke full-height hero carrying its
 * own breadcrumb. The Academics banner is a locked global component: same
 * height, same overlay, same typography, same breadcrumb position, same
 * responsive behaviour as every other Academics page. The design work starts
 * below it.
 *
 * ⚠ REBUILT ON RESEARCH FROM THE LIVE OFFICIAL SITE, NOT FROM THIS REPOSITORY.
 * This page was once a two-section "the school publishes almost nothing" page.
 * That described the repository accurately and the school inaccurately: its
 * /orientation/ page carries five programmes for 2024-25, three for 2026-27,
 * attendance figures, a result document per programme and seventy-odd
 * photographs. An empty repository is not evidence of an empty source.
 *
 * See components/academics/ParentOrientationPage.astro for every source, the
 * deliberate omissions, and the decision not to republish the result PDFs.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import ParentOrientationPage from '../../../components/academics/ParentOrientationPage.astro';

/* The banner photograph is itself an orientation frame — a member of staff
   showing parents the PRECEPT syllabus — rather than a generic campus shot. */
import banner from '../../../assets/school-event/Parent-Orientation/pop4-2024-a.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  {/* ⚠ THE PANEL IS REQUIRED. PageHero is sticky and this panel covers it as the
      page scrolls; without it the banner hangs under the footer. */}
  <div class="u-page-panel po-panel">
    <ParentOrientationPage />
  </div>
</BaseLayout>

<style>
  div.po-panel { padding-block: 0; }
</style>
