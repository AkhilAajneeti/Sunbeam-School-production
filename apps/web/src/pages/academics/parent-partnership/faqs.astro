---
/**
 * PARENT PARTNERSHIP · PARENT FAQs — audit §2F.
 *
 * ⚠ BUILT TO THE CLIENT'S REFERENCE MOCKUP. Banner unchanged (the shared
 * PageHero), then: editorial intro with an asymmetric image pair → a strip of
 * essential facts → the accordion → a dark closing CTA.
 *
 * ═══ CONTENT — RESEARCHED AGAINST sunbeamballia.edu.in ═════════════════════
 * The mockup's sample answer reads "The school operates from 7:45 AM to 1:45 PM,
 * Monday to Saturday." ⚠ THAT IS NOT PUBLISHED ANYWHERE ON THE SCHOOL'S SITE and
 * is not used. /general-info/ and the site search return nothing for timings, so
 * question 07 says so and gives the office number. Inventing a school day would
 * be among the more damaging things this site could print — a family plans the
 * morning around it.
 *
 * VERIFIED, and what each answer rests on:
 *   Apply online     — /general-info/: online application for Nursery to IX and
 *                      for Class XI; admission helpline +91-7755005908.
 *   Orientation      — /orientation/: five programmes in 2024-25, three in
 *                      2026-27, a published result list per programme, and the
 *                      1st programme poster's "234 Students with 389 Parents".
 *   Transport        — /bus-routes/: a table of 27 routes, each with the vehicle
 *                      number, the driver's name and mobile, and the stops.
 *                      "FOR FURTHER ENQUIRY CONTACT OUR TRANSPORT IN CHARGE:
 *                      MR. SHEO SARJAN SINGH, MOBILE No. 7755005909."
 *   Fees             — /fee-structure/: published as a document to view/download,
 *                      not as a figure this site can restate.
 *   Affiliation      — CBSE 2131962, school code 70205 (data/site.ts).
 *   Results          — /result/ and the parent login portal; mandatory
 *                      disclosure carries "LAST THREE-YEAR RESULT OF THE BOARD
 *                      EXAMINATION AS PER APPLICABILITY".
 *   Timings          — NOT PUBLISHED. Stated as such.
 *
 * ⚠ NO FEES, DATES, DOCUMENT LISTS, AGE CRITERIA OR TIMINGS ARE INVENTED. Where
 * the school publishes a document rather than a figure, this page says so and
 * points at the desk that holds it.
 *
 * ⚠ THE ACCORDION IS BUTTONS, NOT <details>. Single-open behaviour and the
 * grid-template-rows height transition both need the state in one place, and a
 * <summary> cannot carry the number/plus layout without fighting its marker.
 * Every row is a real button with aria-expanded and aria-controls, so it works
 * from the keyboard and reads correctly to a screen reader.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import SmartImage from '../../../components/ui/SmartImage.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import { Image } from 'astro:assets';
import { getSchool } from '../../../lib/cms';

/* ⚠ FOUR DIFFERENT PHOTOGRAPHS, ONE PER SLOT. The banner first used the same
   library frame as the intro lead — the one thing the brief rules out. The
   banner now carries parents, which is the subject of the page. */
import banner from '../../../assets/parents forum/parents forum (2).jpg';

/* ⚠ ICONS BY <Image>, dot-bg BY CSS MASK. dot-bg.png is referenced from another
   component's stylesheet by url(); handing it to astro:assets makes it emit as
   .webp and 404 that stylesheet. These four have no CSS references. */
import oPlane from '../../../assets/icons/rocketpaper.png';
import oBooks from '../../../assets/icons/books.png';
import oStar from '../../../assets/icons/star.png';
import oArrow from '../../../assets/icons/arrowcurve.png';
import { getAcademicTopic } from '../../../lib/cms';
import RichLine from '../../../components/ui/RichLine.astro';

const ac = await getAcademicTopic('/academics/parent-partnership/faqs/');
const pReading = ac.pic('pReading');
const pCampus = ac.pic('pCampus');
const pCohort = ac.pic('pCohort');

const sb = await getSchool();

const S = 'Sunbeam School Ballia';

/* The five facts a parent checks first. Every one published. */
const facts = ac.section('facts').points;

/* ⚠ SEVEN QUESTIONS, FIVE WITH REAL ANSWERS AND TWO THAT SAY SO. A page of
   seven confident answers would be a page with two inventions in it. */
const faqs = ac.section('faqs').faqs;
---

<BaseLayout
>
  {/* ══ BANNER — the shared Academics component, unchanged ═══════════════════ */}
  <PageHero
    src={banner}
  />

  <div class="u-page-panel fq-panel">

    {/* ══ 01 · INTRODUCTION ═══════════════════════════════════════════════════ */}
    <section class="fq-intro" aria-labelledby="fq-intro-title">
      <span class="fq-intro__dots" aria-hidden="true"></span>
      <span class="fq-intro__glow" aria-hidden="true"></span>

      <div class="u-container fq-intro__grid">
        <div class="fq-intro__copy">
          <p class="fq-eyebrow" data-reveal>Parent FAQs</p>
          <h2 class="fq-intro__h" id="fq-intro-title">
            <span data-clip data-clip-delay="0">Questions</span>
            <span data-clip data-clip-delay="130"><em>parents ask.</em></span>
          </h2>
          <p class="fq-intro__b" data-reveal data-reveal-delay="180">
            Clear answers to the most common questions about admission, school life, transport and
            academics — drawn from what the school itself publishes. Where it publishes nothing, this
            page says so and names who to ask.
          </p>
          <span class="fq-intro__rule" aria-hidden="true"><span data-draw></span></span>
        </div>

        <div class="fq-intro__media">
          <Image class="fq-intro__plane" src={oPlane} alt="" width={92} aria-hidden="true"
            loading="lazy" data-parallax data-parallax-y="16" />

          <figure class="fq-intro__lead" data-mask data-zoom data-zoom-to="1.07">
            <SmartImage
              file={pReading}
              alt={ac.picAlt('pReading')}
             
              widths={[560, 900]}
              sizes="(max-width: 1000px) 92vw, 42vw"
              loading="lazy"
              decoding="async"
            />
          </figure>

          <figure class="fq-intro__inset" data-parallax data-parallax-y="22">
            <SmartImage
              file={pCampus}
              alt={ac.picAlt('pCampus')}
             
              widths={[380, 640]}
              sizes="(max-width: 1000px) 52vw, 24vw"
              loading="lazy"
              decoding="async"
            />
          </figure>

          {/* ⚠ TEXT ON AN SVG PATH, NOT A SPAN ROTATED BEHIND THE ICON. The first
              version set the words as a block inside the circle, where they
              simply overlapped the star and were unreadable. A textPath around a
              real circle is the only way to set type on a curve. */}
          <span class="fq-seal" aria-hidden="true">
            <svg class="fq-seal__ring" viewBox="0 0 100 100">
              <defs>
                <path id="fq-seal-path" fill="none"
                  d="M 50,50 m -37,0 a 37,37 0 1,1 74,0 a 37,37 0 1,1 -74,0" />
              </defs>
              <text>
                <textPath href="#fq-seal-path" startOffset="0">
                  A partnership that builds futures · A partnership that builds futures ·
                </textPath>
              </text>
            </svg>
            <Image class="fq-seal__i" src={oStar} alt="" width={30} loading="lazy" />
          </span>
        </div>
      </div>
    </section>

    {/* ══ 02 · ESSENTIAL FACTS ════════════════════════════════════════════════ */}
    <section class="fq-facts" aria-label="Essential information">
      <div class="u-container">
        <ul class="fq-facts__row">
          {facts.map((f, i) => (
            <li class="fq-fact" data-drift="18" style={`--i: ${i};`}>
              <p class="fq-fact__k">{f.k}</p>
              <p class="fq-fact__v">{f.v}</p>
              <p class="fq-fact__s">{f.s}</p>
            </li>
          ))}
        </ul>
      </div>
    </section>

    {/* ══ 03 · THE ACCORDION ══════════════════════════════════════════════════ */}
    <section class="fq-main" aria-labelledby="fq-main-title">
      <div class="u-container fq-main__grid">

        <aside class="fq-main__side">
          <p class="fq-eyebrow" data-reveal>Frequently asked</p>
          <h2 class="fq-main__h" id="fq-main-title">
            <span data-clip data-clip-delay="0">Everything you</span>
            <span data-clip data-clip-delay="120">want to know,</span>
            <span data-clip data-clip-delay="240"><em>right here.</em></span>
          </h2>
          <Image class="fq-main__deco" src={oBooks} alt="" width={116} aria-hidden="true" loading="lazy" />
          <p class="fq-main__b" data-reveal data-reveal-delay="200">
            Open any question to see the answer. Every one is drawn from the school’s own published
            information — and two of them say plainly that the school has published nothing yet.
          </p>

          {/* ⚠ THE DRAWN ARROW FROM THE REFERENCE, POINTING AT THE QUESTIONS.
              It is the one element on the page that says "click these" without
              writing the words, so it belongs beside the instruction and aimed
              at the list — not in the intro, where it would point at a
              photograph and mean nothing.

              Absolute, in a lane the copy is barred from: .fq-main__b's
              max-width subtracts this same width, so the two can never meet
              however the column resizes. */}
          <Image class="fq-main__arrow" src={oArrow} alt="" width={230} aria-hidden="true"
            loading="lazy" data-reveal data-reveal-delay="320" />
        </aside>

        <div class="fq-list" data-faq>
          {faqs.map((f, i) => (
            <div class={`fq-item${i === 0 ? ' is-open' : ''}`}>
              <h3 class="fq-item__h">
                <button
                  type="button"
                  class="fq-item__btn"
                  id={`fq-b-${i}`}
                  aria-expanded={i === 0 ? 'true' : 'false'}
                  aria-controls={`fq-p-${i}`}
                >
                  <span class="fq-item__n t-tabular">{String(i + 1).padStart(2, '0')}</span>
                  <span class="fq-item__q">{f.q}</span>
                  <span class="fq-item__ico" aria-hidden="true"></span>
                </button>
              </h3>

              <div class="fq-item__panel" id={`fq-p-${i}`} role="region" aria-labelledby={`fq-b-${i}`}>
                <div class="fq-item__inner">
                  {/* ⚠ RichLine, NOT set:html. The answers carry emphasis — "**Nursery to Class
                      IX**" — and the CMS stores the marker rather than raw markup, so
                      nothing an editor types can put HTML into this page. */}
                  {f.a.map((para) => <RichLine class="fq-item__a" text={para} />)}
                  {f.note && <p class="fq-item__note">{f.note}</p>}
                  {f.cta && (
                    <a
                      class="fq-item__cta"
                      href={f.cta.href}
                      {...(f.cta.external ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
                    >
                      {f.cta.label}
                      <span aria-hidden="true">→</span>
                    </a>
                  )}
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    {/* ══ 04 · STILL HAVE A QUESTION ══════════════════════════════════════════ */}
    <section class="fq-cta" aria-labelledby="fq-cta-title">
      <div class="fq-cta__media" data-zoom data-zoom-to="1.1">
        <SmartImage
          file={pCohort}
          alt={ac.picAlt('pCohort')}
         
          widths={[900, 1400, 1600]}
          sizes="100vw"
          loading="lazy"
          decoding="async"
        />
      </div>
      <span class="fq-cta__scrim" aria-hidden="true"></span>
      <span class="fq-cta__glow" aria-hidden="true"></span>

      <div class="u-container fq-cta__grid">
        <div>
          <p class="fq-eyebrow fq-eyebrow--onink" data-reveal>Still have a question?</p>
          <h2 class="fq-cta__h" id="fq-cta-title">
            <span data-drift="22">We’re here</span>
            <span data-drift="22">to <em>help.</em></span>
          </h2>
        </div>

        <div class="fq-cta__side">
          <p class="fq-cta__b" data-reveal data-reveal-delay="140">
            If you need something this page does not answer — a fee schedule for your child’s class,
            a bus stop, a date — the admissions desk holds it.
          </p>
          <ul class="fq-cta__lines">
            <li><span>Admissions</span><a href={`tel:${sb.phone.admissions}`}>{sb.phone.admissionsDisplay}</a></li>
            <li><span>School office</span><a href={`tel:${sb.phone.office}`}>{sb.phone.officeDisplay}</a></li>
            <li><span>Email</span><a href={`mailto:${sb.email}`}>{sb.email}</a></li>
          </ul>
          {/* The reference runs a drawn trail off the end of this button; the
              asset is the plane-and-trail, used at a size where it reads as a
              flourish beside the button rather than a second illustration. */}
          <span class="fq-cta__act">
            <a class="btn btn--primary" href="/contact-us/">Contact the school</a>
            <span class="fq-cta__trail" aria-hidden="true"></span>
          </span>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  /**
   * The accordion. One open at a time, first open by default.
   *
   * ⚠ THE HEIGHT ANIMATION IS grid-template-rows: 0fr → 1fr, NOT max-height.
   * A max-height transition has to guess a number large enough for the tallest
   * answer, which makes short answers snap and long ones lag. The grid track
   * animates to the panel's own content height, so every row opens at the same
   * speed whatever is inside it — and it needs no measurement in JS.
   */
  const root = document.querySelector('[data-faq]');
  if (root) {
    const items = Array.from(root.querySelectorAll<HTMLElement>('.fq-item'));

    const setOpen = (item: HTMLElement, open: boolean) => {
      item.classList.toggle('is-open', open);
      item.querySelector('button')?.setAttribute('aria-expanded', String(open));
    };

    root.addEventListener('click', (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>('.fq-item__btn');
      if (!btn) return;
      const item = btn.closest<HTMLElement>('.fq-item');
      if (!item) return;
      const willOpen = !item.classList.contains('is-open');
      items.forEach((i) => setOpen(i, false));
      setOpen(item, willOpen);
    });
  }
</script>

<style>
  /* The page sits on cream throughout; each band varies it rather than the
     wholesale ground changes the Academics system uses. */
  div.fq-panel { padding-block: 0; background: var(--sb-ivory); }

  .fq-eyebrow {
    margin: 0;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.19em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .fq-eyebrow--onink { color: var(--sb-lime); }

  /* ═══ 01 · INTRO ═════════════════════════════════════════════════════════ */
  .fq-intro {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    padding-block: clamp(40px, 5vw, 78px);
  }
  /* Cream base + a very soft peach glow, so the band reads as designed even
     before any photograph loads. */
  .fq-intro__glow {
    position: absolute;
    z-index: -2;
    top: -28%;
    right: -8%;
    width: 52%;
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 60, 10, 0.14) 0%, rgba(201, 60, 10, 0) 68%);
  }
  /* ⚠ dot-bg AS A MASK, NOT AN <Image> — see the note in the frontmatter. */
  .fq-intro__dots {
    position: absolute;
    z-index: -1;
    left: clamp(-30px, -2vw, -10px);
    bottom: 8%;
    width: clamp(120px, 16vw, 220px);
    aspect-ratio: 1 / 1;
    background: var(--sb-violet);
    opacity: 0.15;
    -webkit-mask-image: url('../../../assets/icons/dot-bg.png');
    mask-image: url('../../../assets/icons/dot-bg.png');
    -webkit-mask-size: contain;
    mask-size: contain;
    -webkit-mask-repeat: no-repeat;
    mask-repeat: no-repeat;
  }

  .fq-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.92fr) minmax(0, 1.08fr);
    gap: clamp(28px, 4vw, 66px);
    align-items: center;
  }
  .fq-intro__h {
    margin: clamp(12px, 1.5vw, 18px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(34px, 4.4vw, 64px);
    font-weight: 700;
    line-height: 1.0;
    letter-spacing: -0.046em;
    color: var(--sb-charcoal);
  }
  .fq-intro__h span { display: block; }
  .fq-intro__h em { font-style: normal; color: var(--sb-violet); }
  .fq-intro__b {
    max-width: 46ch;
    margin: clamp(14px, 1.6vw, 20px) 0 0;
    font-size: clamp(14px, 1.02vw, 16px);
    line-height: 1.72;
    color: var(--sb-text-secondary);
  }
  .fq-intro__rule {
    display: block;
    width: clamp(58px, 6vw, 92px);
    height: 3px;
    margin: clamp(16px, 1.8vw, 24px) 0 0;
    border-radius: 2px;
    background: rgba(201, 60, 10, 0.2);
    overflow: hidden;
  }
  .fq-intro__rule span { display: block; width: 100%; height: 100%; background: var(--sb-violet); transform-origin: left center; }


  .fq-intro__media { position: relative; }
  .fq-intro__lead {
    position: relative;
    margin: 0;
    overflow: hidden;
    aspect-ratio: 3 / 2;
    border-radius: clamp(18px, 1.8vw, 28px);
    box-shadow: 0 34px 68px -40px rgba(27, 21, 18, 0.5);
  }
  .fq-intro__lead :global(picture) { display: block; width: 100%; height: 100%; }
  .fq-intro__lead :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  /* The smaller frame breaks the lead frame's lower-right corner — the
     asymmetry the brief asks for, rather than two equal cards. */
  .fq-intro__inset {
    position: absolute;
    right: clamp(-14px, -1.2vw, 0px);
    bottom: clamp(-34px, -3vw, -18px);
    width: clamp(140px, 25vw, 260px);
    aspect-ratio: 4 / 3;
    margin: 0;
    overflow: hidden;
    border: 7px solid var(--sb-ivory);
    border-radius: clamp(12px, 1.2vw, 18px);
    box-shadow: 0 26px 52px -32px rgba(27, 21, 18, 0.48);
  }
  .fq-intro__inset :global(picture) { display: block; width: 100%; height: 100%; }
  .fq-intro__inset :global(img) { display: block; width: 100%; height: 100%; object-fit: cover; }

  .fq-intro__plane {
    position: absolute;
    z-index: 3;
    top: clamp(-26px, -2vw, -12px);
    left: clamp(-22px, -1.6vw, -8px);
    width: clamp(52px, 5.4vw, 92px);
    height: auto;
    rotate: -8deg;
    opacity: 0.9;
    pointer-events: none;
  }

  /* The badge, as in the reference — a round seal sitting on the seam between
     the two frames. */
  .fq-seal {
    position: absolute;
    z-index: 4;
    left: clamp(8px, 4vw, 62px);
    bottom: clamp(-34px, -3vw, -20px);
    display: grid;
    place-items: center;
    width: clamp(78px, 8vw, 108px);
    aspect-ratio: 1 / 1;
    border-radius: 50%;
    background: var(--sb-paper);
    box-shadow: 0 18px 38px -20px rgba(27, 21, 18, 0.45);
  }
  .fq-seal__i { position: relative; z-index: 1; width: 34%; height: auto; }
  .fq-seal__ring {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    animation: fq-spin 30s linear infinite;
  }
  .fq-seal__ring text {
    font-size: 8.4px;
    font-weight: 700;
    letter-spacing: 0.055em;
    text-transform: uppercase;
    fill: var(--sb-violet);
  }
  @keyframes fq-spin { to { rotate: 360deg; } }
  @media (prefers-reduced-motion: reduce) { .fq-seal__ring { animation: none; } }

  /* ═══ 02 · FACTS ═════════════════════════════════════════════════════════ */
  .fq-facts { padding-block: clamp(30px, 3.4vw, 52px); }
  .fq-facts__row {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: 0;
    margin: 0;
    padding: clamp(20px, 2.2vw, 32px) clamp(14px, 1.6vw, 26px);
    list-style: none;
    background: var(--sb-paper);
    border-radius: clamp(16px, 1.6vw, 24px);
    box-shadow: 0 24px 54px -38px rgba(27, 21, 18, 0.36);
  }
  /* Hairlines between, not around — a strip, not five cards. */
  .fq-fact { padding-inline: clamp(12px, 1.4vw, 22px); border-left: 1px solid rgba(27, 21, 18, 0.1); }
  .fq-fact:first-child { border-left: 0; }
  .fq-fact__k {
    margin: 0;
    font-size: 10.5px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--sb-violet);
  }
  .fq-fact__v {
    margin: 7px 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(14px, 1.1vw, 17px);
    font-weight: 700;
    line-height: 1.24;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .fq-fact__s { margin: 4px 0 0; font-size: 11.5px; line-height: 1.46; color: var(--sb-text-secondary); }

  /* ═══ 03 · ACCORDION ═════════════════════════════════════════════════════ */
  .fq-main { padding-block: clamp(34px, 4vw, 66px) clamp(48px, 5.6vw, 90px); }
  .fq-main__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(26px, 3.6vw, 60px);
    align-items: start;
  }
  /* sticky also anchors .fq-main__arrow — see the note at the static override */
  .fq-main__side { position: sticky; top: clamp(90px, 12vh, 130px); }
  .fq-main__h {
    margin: clamp(12px, 1.4vw, 18px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(28px, 3vw, 44px);
    font-weight: 700;
    line-height: 1.02;
    letter-spacing: -0.044em;
    color: var(--sb-charcoal);
  }
  .fq-main__h span { display: block; }
  .fq-main__h em { font-style: normal; color: var(--sb-violet); }
  .fq-main__deco {
    display: block;
    width: clamp(72px, 8vw, 116px);
    height: auto;
    margin: clamp(20px, 2.4vw, 34px) 0 0;
    opacity: 0.9;
  }
  .fq-main__b {
    /* ⚠ THE SECOND TERM RESERVES THE ARROW'S LANE. Without it the instruction
       runs the full column width at some sizes and collides with the arrow. */
    max-width: min(34ch, calc(100% - clamp(84px, 9vw, 132px)));
    margin: clamp(12px, 1.4vw, 18px) 0 0;
    font-size: clamp(13.5px, 1vw, 15px);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }
  .fq-main__arrow {
    position: absolute;
    /* Overhangs into the gutter so the head arrives at the cards rather than
       stopping inside the rail. The gutter is at least 26px, so the card
       column is never reached. */
    right: clamp(-34px, -2.6vw, -10px);
    bottom: 0;
    width: clamp(72px, 8vw, 118px);
    height: auto;
    opacity: 0.7;
    pointer-events: none;
  }

