---
/**
 * ACADEMICS · BOARD RESULTS.
 *
 * The school publishes no board percentages, and this page does not estimate
 * one. What it sets out instead — the outcome data the school does publish, and
 * why a guessed pass rate is the single worst number to invent on a school site
 * — is in the component header.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import BoardResultsPage from '../../components/academics/assessment/BoardResultsPage.astro';

import banner from '../../assets/library/DSC_1226 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <BoardResultsPage />
  </div>
</BaseLayout>
