---
/**
 * ACADEMIC STRUCTURE · PRE-PRIMARY — Nursery, LKG and UKG.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, NOT THE Ac* SYSTEM. This page used to be
 * AcCollage → AcPath → AcClose, which gave it the same three shapes as every
 * other structure page. The seven sections now live in one component so the
 * early years read as their own place rather than as a stage in a list.
 * Sourcing, the photograph roster and the four things this page refuses to claim
 * are all documented in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED. PageHero takes the same props
 * as every other Academics page, so the header treatment stays identical across
 * the section.
 *
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE, NOT A SCOPED RULE. A scoped
 * `div.ac-panel { padding-block: 0 }` depends on the build hashing the same
 * class into both the HTML and the stylesheet; when that skewed, the panel got
 * its default 120px back and a white band opened between the close section and
 * the footer. Inline cannot skew.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import PrePrimaryPage from '../../../components/academics/structure/PrePrimaryPage.astro';

import banner from '../../../assets/activity learning lab/DSC_1215 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <PrePrimaryPage />
  </div>
</BaseLayout>
