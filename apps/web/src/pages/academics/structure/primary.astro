---
/**
 * ACADEMIC STRUCTURE · PRIMARY — Classes I to V.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION, NOT THE Ac* SYSTEM. Sourcing, the
 * photograph roster and the two places where this page departs from the design
 * brief on evidence grounds are documented in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED — PageHero takes the same props
 * as every other Academics page, so the header treatment stays identical.
 *
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE, NOT A SCOPED RULE. A scoped
 * rule depends on the build hashing the same class into both the HTML and the
 * stylesheet; when that skewed, the panel got its default 120px back and a white
 * band opened between the close section and the footer. Inline cannot skew.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import PrimaryPage from '../../../components/academics/structure/PrimaryPage.astro';

import banner from '../../../assets/school-event/Impetus—ClassesIII-V/Impetus—ClassesIII-V-02.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <PrimaryPage />
  </div>
</BaseLayout>
