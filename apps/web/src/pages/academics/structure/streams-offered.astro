---
/**
 * ACADEMIC STRUCTURE · STREAMS OFFERED — the four at Senior Secondary.
 *
 * ⚠ THE BANNER IS THE SHARED PageHero AND ITS TREATMENT IS UNTOUCHED — same
 * component, same photograph, same crop, same crumbs, same height as every other
 * Academics page. All of the art direction is below it.
 *
 * The page was rebuilt off the generic AcPath → AcSplit → AcClose system into a
 * composed one: four sections, four grounds, four different ideas, none of them
 * the numeral + eyebrow + heading + paragraph + photo block the client rejected
 * as "a repeated template". The whole composition lives in
 * components/academics/structure/StreamsOfferedPage.astro, and every claim it
 * makes — and every claim it deliberately does NOT make — is sourced in that
 * file's frontmatter.
 *
 * ═══ WHAT IS VERIFIED, AND WHAT IS NOT ═════════════════════════════════════
 * The FOUR STREAM NAMES are verified — school.streams in data/site.ts, and the
 * school publishes them. PCM and PCB are definitional, so printing their subject
 * lists claims nothing extra. Commerce and Humanities are given as DIRECTIONS,
 * not as combinations, because the school has not published its commerce core
 * and the Humanities core varies more between schools than any other stream.
 * Section 04 says exactly that and sends the reader to Subject Combinations,
 * which is where the caveated detail lives.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import StreamsOfferedPage from '../../../components/academics/structure/StreamsOfferedPage.astro';

import banner from '../../../assets/bio lab/DSC_1274 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  {/* ⚠ THE PANEL IS REQUIRED. PageHero is sticky and this panel covers it as the
      page scrolls; without it the banner hangs under the footer.

      ⚠ THE PADDING RESET IS AN INLINE STYLE — see the note on the same override
      in subject-combinations.astro for why a stylesheet form of it is not
      reliable here. */}
  <div class="u-page-panel" style="padding-block: 0;">
    <StreamsOfferedPage />
  </div>
</BaseLayout>
