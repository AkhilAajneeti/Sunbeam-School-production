---
/**
 * TEACHING & LEARNING · STEM, ROBOTICS & ENRICHMENT — audit §2C.
 *
 * ⚠ THE BANNER IS THE SHARED PageHero AND ITS TREATMENT IS UNTOUCHED — same
 * component, same photograph, same crop, same crumbs, same height, same title
 * and standfirst as before and as every other Academics page. All of the
 * redesign is below it.
 *
 * ⚠ COMBINED PAGE — three of the brief's fourteen bullets: STEM Education,
 * Robotics & Coding, and Mathematics & Science Enrichment. The three standalone
 * routes were an implementation experiment; their verified content is merged
 * here and the routes are retired.
 *
 * ⚠⚠ THE ROBOTICS LAB IS NOT PHOTOGRAPHED, AND NOTHING PRETENDS OTHERWISE.
 * Robotics-drones.jpg and dron.jpg are stock DJI product shots, not this
 * school's room, and are banned by the client. Section 02 is a typographic
 * composition around the four items the school lists, and says so on the page.
 * ASSET REQUIREMENT: photography of the Robotics Lab.
 *
 * The page was rebuilt off the generic AcSplit → AcStatement → bespoke list →
 * AcCollage → AcClose system into a composed one: five sections, five different
 * builds. Everything below the banner lives in
 * components/academics/teaching/StemRoboticsPage.astro, and that file's
 * frontmatter carries the source for every claim.
 *
 * ⚠ SCOPE BOUNDARY — the results in full live on Student Success; the room
 * inventory lives on Laboratories & Academic Clubs; the panels and computer-room
 * teaching live on Smart Classrooms.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import StemRoboticsPage from '../../../components/academics/teaching/StemRoboticsPage.astro';

import banner from '../../../assets/photos/sb-chem-lab.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  {/* ⚠ THE PANEL IS REQUIRED. PageHero is sticky and this panel covers it as the
      page scrolls; without it the banner hangs under the footer.

      ⚠ AND THE PADDING RESET IS AN INLINE STYLE, DELIBERATELY. `.u-page-panel`
      in base.css carries `padding-bottom: var(--sb-section-y)` — 120px of empty
      cream between the closing section and the footer. A stylesheet form of the
      override can be served from a different build than the HTML that needs it,
      and then it silently stops applying; an inline style travels IN the HTML,
      so the two cannot skew. Same decision as the other redesigned pages. */}
  <div class="u-page-panel" style="padding-block: 0;">
    <StemRoboticsPage />
  </div>
</BaseLayout>
