---
/**
 * STUDENT SUCCESS · OLYMPIAD ACHIEVEMENTS.
 *
 * No award total. The school publishes none, and "100+ Olympiad awards" was in
 * the original brief. What it does publish — which programmes, from which class,
 * and a small number of named results — is in the component header, along with
 * the photograph the repository does not hold.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import OlympiadPage from '../../../components/academics/assessment/OlympiadPage.astro';

import banner from '../../../assets/composite lab/DSC_1255 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <OlympiadPage />
  </div>
</BaseLayout>
