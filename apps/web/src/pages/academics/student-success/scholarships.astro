---
/**
 * STUDENT SUCCESS · SCHOLARSHIPS.
 *
 * The school publishes no scholarship terms, and this page invents none. The
 * reference artwork for this page carried four named awards, all four of them
 * fabrications; why they were dropped, and why fees are the one subject where a
 * guess does measurable harm, is set out in the component header.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import ScholarshipsPage from '../../../components/academics/assessment/ScholarshipsPage.astro';

import banner from '../../../assets/library/DSC_1230 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <ScholarshipsPage />
  </div>
</BaseLayout>
