---
/**
 * ASSESSMENT & SUPPORT · REMEDIAL SUPPORT.
 *
 * ⚠ THE BODY IS A BESPOKE COMPOSITION. Sourcing — the school's own promotion
 * policy — and the one place this page departs from the reference mockup on
 * evidence grounds (the class range) are in the component's header.
 *
 * ⚠ THE BANNER, NAVBAR AND FOOTER ARE UNTOUCHED.
 * ⚠ THE PANEL'S padding-block IS AN INLINE STYLE — a scoped rule can skew
 * against its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import RemedialSupportPage from '../../../components/academics/assessment/RemedialSupportPage.astro';

import banner from '../../../assets/chem lab/DSC_1262 copy.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <RemedialSupportPage />
  </div>
</BaseLayout>
