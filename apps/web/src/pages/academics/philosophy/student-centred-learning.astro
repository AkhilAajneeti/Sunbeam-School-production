---
/**
 * ACADEMIC PHILOSOPHY · STUDENT-CENTRED LEARNING — audit §2A.
 *
 * ⚠ THE BANNER IS THE SHARED PageHero, THE SAME AS EVERY OTHER PAGE. A bespoke
 * editorial hero was built here first — a poster-scale display word over the
 * hall photograph, with a portrait breaking the section's bottom edge. The
 * client's instruction is that the banner stays consistent with the rest of the
 * site, so it does. The art direction the brief asked for lives in the six
 * sections below it instead, which is where it can be different without the
 * masthead area behaving unlike every other page.
 *
 * ⚠ UNVERIFIABLE CLAIMS WERE DELETED, NOT REDESIGNED. See the header of
 * StudentCentredPage for the full list and the searches behind it.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import StudentCentredPage from '../../../components/academics/StudentCentredPage.astro';
import banner from '../../../assets/school-activities/josh-spring-camp/02.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  {/* padding-block: 0 — every section carries its own rhythm, and the panel
      adding its own on top is what put a 183px void under the hero on three
      earlier pages. */}
  <div class="u-page-panel sc-panel">
    <StudentCentredPage />
  </div>
</BaseLayout>

<style>
  div.sc-panel { padding-block: 0; }
</style>
