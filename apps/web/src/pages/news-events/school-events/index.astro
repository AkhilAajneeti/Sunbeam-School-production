---
/**
 * SCHOOL EVENTS — the index. A card per event; the facts live on its own page.
 *
 * Content: the school's own /event-chronicles/ and /school-activities/ pages.
 * See data/newsPages.ts.
 *
 * ⚠ THIS REPLACES A LEDGER, for the reason the workshops index did. Every fact
 * about all twelve events sat on one screen — guest, office, date, description —
 * which made the page long and made no single event linkable. The school shares
 * individual events; now each has a URL to share.
 *
 * ⚠ THE FIGURES ARE COUNTED, NEVER TYPED. Same rule as the workshops index: an
 * asserted number drifts from the content the moment an item is added, so the
 * page counts what is actually there.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SectionRail from '../../../components/academics/SectionRail.astro';
import IndexIntro from '../../../components/news/IndexIntro.astro';
import CardGrid from '../../../components/news/CardGrid.astro';

import { getChroniclePage } from '../../../lib/cms';;
import heroPhoto from '../../../assets/photos/sunbeem-5.jpg';

const schoolEvents = await getChroniclePage('school-events');

const items = schoolEvents.groups.flatMap((g) => g.items);

/* A named person with an office — "Mr. Ashutosh Kumar Pandey, IRS" — is the
   thing that makes an event checkable, so it is what the figures count. */
const NAMED = /\b(Mr|Mrs|Ms|Dr|Prof|Shri)\b/;
const DATED = (i: { when?: string }) => Boolean(i.when);

const figures = [
  { n: items.length, k: 'events on record' },
  { n: items.filter((i) => NAMED.test(i.meta)).length, k: 'name the guest or who led it' },
  { n: items.filter(DATED).length, k: 'carry a published date' },
];
---

<BaseLayout
>
  <PageHero
    src={heroPhoto}
  />

  <SectionRail items={schoolEvents.groups.map((g) => ({ id: g.id, label: g.label }))} />

  <div class="u-page-panel se-panel">
    <IndexIntro
      eyebrow={schoolEvents.eyebrow}
      heading={schoolEvents.heading}
      stand={schoolEvents.stand}
      figures={figures}
    />

    <CardGrid page={schoolEvents} base="/news-events/school-events/" unit="event" />
  </div>
</BaseLayout>

<style>
  div.se-panel { padding-block: 0; }

  .se-panel :global(section[id]) {
    scroll-margin-top: calc(var(--sb-masthead-h) + 24px);
  }
</style>
