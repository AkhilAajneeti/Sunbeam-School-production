---
/**
 * CELEBRATIONS — the index. A card per day; the guests live on its own page.
 *
 * Content: the school's own /school-activities/ and /event-chronicles/. See
 * data/newsPages.ts for what was taken and what was left.
 *
 * ⚠ NO DATES ARE INVENTED HERE. A festival recurs every year, so a date printed
 * against one would be a claim about WHICH year's celebration this describes —
 * and a static build cannot keep that honest. Only the days the school itself
 * dated carry a date, which is why the counted figure below is six of sixteen
 * rather than sixteen of sixteen. The gap is the truth, not an omission.
 *
 * ⚠ THE FILE MOVED FROM celebrations.astro TO celebrations/index.astro. The
 * route is unchanged — /news-events/celebrations/ — but the directory is what
 * lets [slug].astro sit beside it.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHero from '../../../components/ui/PageHero.astro';
import SectionRail from '../../../components/academics/SectionRail.astro';
import IndexIntro from '../../../components/news/IndexIntro.astro';
import CardGrid from '../../../components/news/CardGrid.astro';

import { getChroniclePage } from '../../../lib/cms';;
import heroPhoto from '../../../assets/photos/sunbeem-2.jpg';

const celebrations = await getChroniclePage('celebrations');

const items = celebrations.groups.flatMap((g) => g.items);

/* A named person or a named class is what makes a day checkable rather than
   generic, so it is what the middle figure counts. */
const NAMED = /\b(Mr|Mrs|Ms|Dr|Prof|Shri|Smt|Class|Classes)\b/;

const figures = [
  { n: items.length, k: 'days on record' },
  { n: items.filter((i) => NAMED.test(i.meta)).length, k: 'name the guest or who ran it' },
  { n: items.filter((i) => i.when).length, k: 'carry a published date' },
];
---

<BaseLayout
>
  <PageHero
    src={heroPhoto}
  />

  <SectionRail items={celebrations.groups.map((g) => ({ id: g.id, label: g.label }))} />

  <div class="u-page-panel cl-panel">
    <IndexIntro
      eyebrow={celebrations.eyebrow}
      heading={celebrations.heading}
      stand={celebrations.stand}
      figures={figures}
    />

    <CardGrid page={celebrations} base="/news-events/celebrations/" unit="day" />
  </div>
</BaseLayout>

<style>
  div.cl-panel { padding-block: 0; }

  .cl-panel :global(section[id]) {
    scroll-margin-top: calc(var(--sb-masthead-h) + 24px);
  }
</style>
