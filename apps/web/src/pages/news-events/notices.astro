---
/**
 * NEWS & EVENTS · SCHOOL NOTICES.
 *
 * The school's Notice page is a bare image gallery — 24 posters, no titles, no
 * dates, no categories, no PDFs. Every title and date on this page was read off
 * the poster artwork itself; the sourcing, and why there is no category filter,
 * are in data/notices.ts.
 *
 * The banner, navbar and footer are untouched.
 * The panel's padding-block is an inline style — a scoped rule can skew against
 * its build hash and reopen the white band above the footer.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import NoticePage from '../../components/notices/NoticePage.astro';

import banner from '../../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel" style="padding-block: 0;">
    <NoticePage step={10} />
  </div>
</BaseLayout>
