---
/**
 * ONE WORKSHOP — routing only. The page itself is components/news/DetailPage.
 *
 * ⚠ getStaticPaths BUILDS ONLY THE ITEMS THAT CARRY A SLUG. An item without one
 * produces no route, and the index renders it as a card with no button — so a
 * missing detail page can never surface as a broken link.
 */
import DetailPage from '../../../components/news/DetailPage.astro';
import { getChroniclePage, type ChronicleItem } from '../../../lib/cms';;

const workshops = await getChroniclePage('workshops');

export async function getStaticPaths() {
  const wk = await getChroniclePage('workshops');
  return wk.groups.flatMap((g) =>
    g.items
      .filter((i) => i.slug)
      .map((item) => ({
        params: { slug: item.slug! },
        props: { item, group: g.label },
      })),
  );
}

interface Props {
  item: ChronicleItem;
  group: string;
}

const { item, group } = Astro.props;
---

<DetailPage item={item} group={group} page={workshops} base="/news-events/workshops/" />
