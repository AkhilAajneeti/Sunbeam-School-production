---
/**
 * ABOUT → DIRECTOR'S MESSAGE — audit 1.9
 *
 * COPY — supplied by the school, used as given. Two notes:
 *
 * 1. This resolves the placeholder that stood here, and corrects our records:
 *    docs/01 § 5 held only "Sunbeam Group Director: Mrs. Amrita Burman", which
 *    is a different person in a different role from the Director of the Ballia
 *    school. Nothing was ever printed under that name — which is exactly why
 *    this page needed no retraction.
 *
 * 2. THE PULL QUOTE IS PARAGRAPH 3'S SECOND SENTENCE, MOVED — not copied. It
 *    read "…city of Ballia. Sunbeam Ballia is committed to make Ballia a name to
 *    reckon with for education and to provide world-class quality education."
 *    Setting that line as a quote while leaving it in the body would print it
 *    twice, so the body keeps the first sentence and the quote takes the second.
 *    Every word the school supplied is still on the page, exactly once.
 *
 * 3. Three spellings are corrected from the copy as supplied: "privileges'" →
 *    "privilege of", "Program form IIM Calcutta" → "from", and "gear with" →
 *    "is geared with". Audit 1.12 asks for precisely this proofreading on the
 *    leadership pages. Nothing else is altered — the wording, the order and the
 *    emphasis are the school's own.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import LeaderMessage from '../../components/about/LeaderMessage.astro';
import { getLeaderMessage } from '../../lib/cms';
import banner from '../../assets/photos/sunbeem-2.jpg';

const leader = await getLeaderMessage('director');


---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel">
    <LeaderMessage
      eyebrow={leader?.eyebrow}
      heading={leader?.heading}
      name={leader?.name}
      role={leader?.roleLabel}
      portrait={leader?.portrait}
      portraitAlt={leader?.portraitAlt}
      portraitBrief={leader?.portraitBrief}
      pullQuote={leader?.pullQuote}
      paragraphs={leader?.paragraphs ?? []}
      credentials={leader?.credentials ?? []}
      pending={leader?.pending}
    />
  </div>
</BaseLayout>
