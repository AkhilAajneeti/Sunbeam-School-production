---
/**
 * ABOUT → HISTORY & LEGACY — audit 1.6, 1.8 and 1.11
 *
 * Audit 1.11, verbatim: the contributions of "the Chairman, Secretary and other
 * dignitaries can be incorporated within the History section instead of creating
 * separate menu links." So this page carries both messages, at #leadership, and
 * docs/04 § redirects already point /chairmans-message/ and /secretarys-message/
 * here rather than to pages of their own.
 *
 * COPY — every word is the school's own, from its History, Chairman's Message
 * and Secretary's Message pages.
 *
 * ⚠ ONE STALE FACT, LEFT AS WRITTEN. The Chairman's message says the school has
 * spread the Sunbeam revolution "for last 7 years". Founded 2013 plus seven puts
 * the writing around 2020; it is 2026, so the true figure is thirteen. It is a
 * signed message and not ours to quietly rewrite, so it is reproduced exactly.
 * It is one word to change once the school decides — update the number, add a
 * dateline, or ask the Chairman for a refreshed line. Audit 1.12 asks for
 * precisely this kind of proofreading on the leadership pages.
 *
 * Two plain typos ARE corrected, both in the History paragraph: "is the one of
 * the leading educational Institution" → "is one of the leading educational
 * institutions", and the stray capitalisation on "Institution".
 */
import AdvisoryCouncil from '../../components/about/AdvisoryCouncil.astro';
import LegacyTimeline from '../../components/about/LegacyTimeline.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/ui/PageHero.astro";
import VideoFeature from "../../components/about/VideoFeature.astro";
import Photo from "../../components/ui/Photo.astro";
import { getSchool, getHistoryPage } from '../../lib/cms';
import stars from "../../assets/icons/stars.png";
import banner from "../../assets/photos/sunbeem-1.jpg";
import poster from "../../assets/photos/sunbeem-2.jpg";
import { Image } from "astro:assets";

const school = await getSchool();
const { history, voices } = await getHistoryPage();

/**
 * THE CLIENT'S COPY, SET AS TWO PARAGRAPHS AT THE CLIENT'S REQUEST.
 *
 * ⚠ NOT ONE WORD IS CUT. The client sent six paragraphs and then asked for two,
 * so the six are joined 1-2-3 and 4-5-6 — founding and what the school offers,
 * then how it teaches and where it stands today. Every sentence survives in its
 * original order; only the breaks between them moved.
 *
 * ⚠ FULL WIDTH AND JUSTIFIED, ALSO AT THE CLIENT'S REQUEST. Worth knowing: this
 * puts the measure back to ~110 characters a line, and justified text at that
 * width opens rivers of white space between words. It was set to 44rem
 * ragged-right for exactly that reason. The client has asked for the other
 * treatment and that is their call — this note is here so the next person does
 * not "fix" it back.
 *
 * ⚠ EVERY FIGURE STILL AGREES WITH data/site.ts — 2013, 456, 2,700+, Nursery to
 * Class XII, CBSE New Delhi, the four streams, Duty/Devotion/Discipline.
 */

/**
 * The plate under the paragraph.
 *
 * The school's History page is the single paragraph above and nothing more, so
 * there is no further narrative to draw on — writing one would be inventing a
 * school's own history, which is the one thing this build never does. What IS
 * available is fact the school already publishes elsewhere on its site, and
 * none of these three are repeated by the timeline further down the page: that
 * covers 1972, 2013, today's strength and the Education World run.
 *
 * A longer account of the founding years is asset request A3.
 */



---

<BaseLayout
>
  <PageHero
    {/* ⚠ RENAMED AT THE CLIENT'S REQUEST — "History of the school" is struck
        through on their mark-up and replaced with this. The ROUTE is unchanged:
        /about/history-legacy/ is linked from the footer, the nav, the homepage
        and two redirects that target #leadership on it, so renaming the URL as
        well would break four things to fix a label. */}
    src={banner}
  />

  <div class="u-page-panel">
    {
      /* --- The film, first --------------------------------------------------- */
    }
    <section class="hist-film" aria-labelledby="film-heading">
      <div class="u-container">
        {
          /* No data-reveal: the scale-up IS this element's entrance, and two
            things writing transform would fight each other. */
        }
        {/* ⚠ HIDDEN AT THE CLIENT’S REQUEST — “for now”, so it is commented out
            rather than deleted. Everything it needs is still here: the
            VideoFeature import, the poster image, the YouTube id and the
            .hist-film__media styles. Delete this comment wrapper to bring it
            back; nothing else has to be rebuilt. */}
        {/*
        <div class="hist-film__media" data-expand>
          <VideoFeature
            id="kfCpTF0Aagk"
            title="Journey of Sunbeam School"
            duration="14:30"
            poster={poster}
            posterAlt="Students and staff gathered at the entrance to Sunbeam School Ballia."
            posterPosition="50% 42%"
            ratio="21 / 9"
          />
        </div>
        */}

        <div class="hist-film__copy" data-reveal>
          <Image
            class="history-stars"
            src={stars}
            alt=""
            aria-hidden="true"
            widths={[200, 400]}
            sizes="200px"
            loading="lazy"
          />
          <p class="hist__pill">
            <span class="pill pill--violet">Our Story</span>
          </p>
          <h2 class="hist-film__heading" id="film-heading" data-split>
            A Legacy of Learning.<br />A Future of <span class="t-squiggle">Possibilities.</span>
          </h2>
          <div class="hist-film__prose">
            {history.map((p) => <p>{p}</p>)}
            {/* ⚠ INSIDE .hist-film__prose, NOT AFTER IT. As a sibling it had its
                own max-width in ch — and ch is a DIFFERENT WIDTH in the display
                font than in the body font, so auto-centring a wider box started
                it 46px to the left of the paragraphs above it. Sharing the
                container shares the left edge, whatever the fonts do. */}
            <p class="hist-film__sign">{school.tagline}</p>
          </div>
        </div>
      </div>
    </section>

    {
      /* --- Legacy: the line from 1972 ---------------------------------------- */
    }
    <LegacyTimeline />

    {
      /* --- Leadership. Audit 1.11, and the target of both redirects ---------- */
    }
    <section
      class="hist-voices"
      id="leadership"
      aria-labelledby="voices-heading"
    >
      <div class="u-container">
        <div class="hist-voices__head" data-reveal>
          <p class="hist__pill">
            <span class="pill pill--violet">Leadership</span>
          </p>
          <h2
            class="hist-voices__heading t-h2-sans"
            id="voices-heading"
            data-split
          >
            In their own <span class="t-squiggle">words</span>
          </h2>
        </div>

        {
          voices.map((v, i) => (
            <article
              class:list={['voice', i % 2 === 1 && 'voice--flip']}
              data-reveal
            >
              <div class="voice__media">
                <Photo
                  file={v.portrait}
                  alt={v.alt ?? ''}
                  brief={`${v.role} portrait`}
                  ratio="4 / 5"
                  position="50% 18%"
                  sizes="(max-width: 899px) 260px, 360px"
                />
              </div>

              <div class="voice__body">
                <svg
                  class="voice__mark"
                  width="34"
                  height="26"
                  viewBox="0 0 18 15"
                  fill="currentColor"
                  aria-hidden="true"
                >
                  <path d="M7.2 0C3.3 0 0 3.1 0 7.4c0 3.9 2.7 6.9 6.2 7.6l.6-1.9C4.5 12.4 3 10.6 3 8.3h4.2V0Zm10.6 0c-3.9 0-7.2 3.1-7.2 7.4 0 3.9 2.7 6.9 6.2 7.6l.6-1.9c-2.3-.7-3.8-2.5-3.8-4.8H18V0Z" />
                </svg>

                <div class="voice__prose">
                  {v.paragraphs.map((p) => (
                    <p>{p}</p>
                  ))}
                </div>

                <div class="voice__sign">
                  <p class="voice__name">{v.name}</p>
                  {/* ⚠ THE ROLE ALONE. This printed “Chairman, Sunbeam School Ballia” —
                      but the reader is already on the school’s own About page,
                      under the school’s own masthead, so naming the school after
                      every office was saying it three times on one screen. */}
                  <p class="voice__role">{v.role}</p>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </section>

    {
      /* --- The advisory council. Audit 1.11 again -----------------------------
         "Other dignitaries can be incorporated within the History section
         instead of creating separate menu links" — so the council board sits
         here, after the two signed messages, and adds no nav entry of its own.
         ⚠ IT IS NOT THE SCHOOL MANAGEMENT COMMITTEE, which is a statutory
         filing and lives on the disclosure page. See data/advisoryCouncil.ts. */
    }
    <AdvisoryCouncil />
  </div>
</BaseLayout>

<style>
  /* stars */
  .history-stars {
    position: absolute;
    top: -18px;
    right: clamp(-24px, -2vw, 18px);
    width: clamp(84px, 10vw, 120px);
    height: auto;
    opacity: 0.28;
    z-index: 0;
    pointer-events: none;
    user-select: none;
    transform: rotate(-8deg);
    animation: affil-drift 7s ease-in-out infinite;
    will-change: transform;
  }

  .hist__pill {
    margin-bottom: var(--sb-6);
  }

  /* --- Film ------------------------------------------------------------------ */

  /* No top padding: .u-page-panel already opens the page with its own, and the
     two stacked to 208px of empty ground between the banner and the heading. */
  .hist-film {
    padding-block: 0 var(--sb-section-y);
  }

  /* SCALE-UP ON SCROLL. The frame starts at 80% and reaches full size as it
     travels up the viewport - motion-gsap.ts scrubs it against scroll.

     The 80% START LIVES IN CSS, not in the script. This element sits just under
     the banner and is on screen at first paint, so setting the start in JS
     meant a visible snap from full size down to 80% the moment the motion
     chunk arrived. In CSS it is simply how the frame is drawn.

     The degraded state is therefore a slightly inset video rather than a
     hidden one - fine if the chunk never loads, which is the test that matters.

     transform, not width: width would relayout the poster every frame; a scale
     is composited and costs nothing. */
  .hist-film__media {
    transform: scale(0.8);
    transform-origin: 50% 50%;
    will-change: transform;
  }

  /* No scroll-coupled scaling for anyone who asked for less motion. */
  @media (prefers-reduced-motion: reduce) {
    .hist-film__media {
      transform: none;
    }
  }

  /* Copy sits BELOW the film, centred on it, rather than beside it.
     66ch, not 74: centred text is harder to track back than ranged-left, since
     every line starts at a different place, so it wants the shorter measure. */
  .hist-film__copy {
    position: relative;
    overflow: visible;
    isolation: isolate;
    max-width: 100%;
    margin: clamp(40px, 6vh, 80px) auto 0;
    text-align: center;
  }

  .hist-film__copy > :not(.history-stars) {
    position: relative;
    z-index: 1;
  }

  .hist-film__heading {
    font-family: var(--sb-font-display);
    font-weight: 700;
    font-size: clamp(28px, 3vw, 42px);
    line-height: 1.14;
    letter-spacing: -0.03em;
    color: var(--sb-charcoal);
    margin-bottom: var(--sb-6);
  }

  /* ⚠⚠ A MEASURE, AND NO LONGER JUSTIFIED. At the full container width this ran
     to about 140 characters a line — near double the comfortable 65-75 — and it
     was set justify, which at that width pulls rivers of white space through the
     paragraphs. Six paragraphs made both faults obvious where two had hidden
     them. Ragged-right at 68ch reads; justified at 140ch does not. */
  /* ⚠ FULL WIDTH AND JUSTIFIED — the client asked for both, reversing the 44rem
     ragged-right measure that was here. See the note on the copy above: at this
     width the line runs ~110 characters and justification opens rivers. Left as
     asked, documented so it is not silently changed back. */
  /* ⚠⚠ IT BREAKS OUT OF .u-container, which is what "100%" actually needed.
     max-width:100% was already true and still looked boxed, because the parent
     caps at 1280px — the site-wide container — so 100% of it is 1280 however
     wide the screen. This escapes that cap with a viewport-width breakout and
     keeps only the page gutter.

     ⚠ IT IS A LONG LINE AND THAT IS THE TRADE. At 1900px this runs ~200
     characters justified, well past the comfortable 65-75. Asked for twice, so
     it stands — noted here so it is not "fixed" back by someone who assumes it
     was an accident. */
  .hist-film__prose {
    width: 100vw;
    max-width: 100vw;
    margin-inline: calc(50% - 50vw);
    padding-inline: var(--sb-margin, clamp(18px, 4vw, 56px));
    text-align: justify;
  }

  /* The tagline closes the section, so it carries the weight the prose does not. */
  .hist-film__sign {
    text-align: left;
    margin: clamp(20px, 2.6vw, 30px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(17px, 0.6vw + 12px, 23px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sb-violet);
    text-align: left;
  }

  .hist-film__prose p {
    font-size: var(--sb-body);
    line-height: 1.75;
    color: var(--sb-text-secondary);
    text-align: justify;
  }

  .hist-film__prose p + p {
    margin-top: var(--sb-5);
  }

  /* --- Fact row --------------------------------------------------------------
     Three columns on a hairline rule, dividers BETWEEN only. The rule is drawn
     on the row's top edge and on each item's left, so it needs no
     :last-child exception and no trailing divider to suppress. */
  .hist-film__facts {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(32px, 4.5vh, 52px) 0 0;
    padding-top: var(--sb-7);
    border-top: var(--sb-hairline);
    text-align: center;
  }

  .hist-film__fact {
    padding-inline: var(--sb-5);
  }

  /* The divider sits on the item, so the first column simply has none. */
  .hist-film__fact + .hist-film__fact {
    border-left: var(--sb-hairline);
  }

  .hist-film__fact dt {
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--sb-violet);
    margin-bottom: var(--sb-3);
  }

  .hist-film__fact dd {
    margin: 0;
    font-size: var(--sb-body-sm);
    line-height: 1.5;
    font-weight: 600;
    color: var(--sb-charcoal);
    /* Tabular figures so the affiliation and school code numbers line up
       against the words either side of them rather than wobbling. */
    font-variant-numeric: tabular-nums;
    /* These wrap at two or three words, and the greedy default broke
       "School Code 70205" across the line, orphaning the number away from its
       own label. Balance splits at the phrase instead. Unsupported browsers
       just get the greedy wrap, which is what it was before. */
    text-wrap: balance;
  }

  /* Stacked, the vertical dividers become horizontal ones — a left border on a
     full-width row would read as a stray tick. */
  @media (max-width: 639px) {
    .hist-film__facts {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--sb-5);
    }

    .hist-film__fact {
      padding-inline: 0;
    }

    .hist-film__fact + .hist-film__fact {
      border-left: 0;
      border-top: var(--sb-hairline);
      padding-top: var(--sb-5);
    }
  }

  /* --- Timeline --------------------------------------------------------------- */

  .hist-line {
    padding-block: var(--sb-section-y);
    background: var(--sb-sand);
  }

  .hist-line__head {
    margin-bottom: var(--sb-9);
  }
  .hist-line__heading {
    color: var(--sb-charcoal);
  }

  /* The ranking sits under the heading as a standfirst, not as a fourth step on
     the road — it is a credential, not a moment in the timeline. */
  .hist-line__stand {
    max-width: 56ch;
    margin: clamp(11px, 1.4vw, 16px) auto 0;
    font-size: clamp(14px, 0.4vw + 9px, 16.5px);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }
  .hist-line__stand strong { font-weight: 700; color: var(--sb-charcoal); }

  /* The road itself lives in components/academics/JourneyRoad.astro — the
     zigzag, the badges, the dotted arcs, the title roll and the stacked
     fallback all travel with it, and Assessment & Support now uses the same
     one. Its defaults ARE this page’s original values, so the output here is
     byte-identical; a caller on another palette passes its own accent. */

  /* --- LEADERSHIP · "In their own words" ------------------------------------
     REBUILT. The base rules for this section had been deleted from the
     stylesheet while its two media queries were left behind — `.voice` and
     `.voice__media` existed ONLY inside `@media (max-width: 899px)` and
     `(max-width: 639px)`. Ten of the section's twelve classes had no CSS at all.

     The visible symptom was the portraits rendering enormous: with no
     `display: grid` on `.voice`, `.voice__media` fell back to a full-width
     block, and Photo's `ratio="4 / 5"` then made it two thousand pixels tall.
     The prose, which should sit beside it, was pushed underneath.

     The two surviving media queries are the contract this block is written to
     satisfy — they override `grid-template-columns`, reset `order` to 0 and cap
     the portrait at 280px, so the base has to establish a grid, set an order on
     the flipped portrait, and leave the portrait width to the column. */

  /* ⚠ THE BOTTOM IS DELIBERATELY SHORT, AND ONLY BECAUSE OF WHAT FOLLOWS. This
     section no longer ends the page — the advisory council board runs directly
     under it, on the same subject — and a full --sb-section-y at both ends
     stacked to 240px of empty ground between the Secretary's portrait and that
     board. If anything is ever put between the two, put the full value back. */
  .hist-voices {
    padding-block: var(--sb-section-y) clamp(56px, 7vh, 80px);
    background: var(--sb-ivory);
  }

  .hist-voices__head {
    margin-bottom: var(--sb-10);
  }

  .hist-voices__heading {
    margin-top: var(--sb-4);
    color: var(--sb-charcoal);
  }

  .voice {
    display: grid;
    /* 360px matches the `sizes` the Photo is given, so the browser is not
       fetching a candidate wider than the slot it lands in. */
    grid-template-columns: 360px minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
  }

  /* The second portrait sits on the right, and that needs BOTH halves of this:
     `order` alone moved the media into the second grid cell, which is the 1fr
     track — so the flipped portrait came out 862px wide and the prose was
     squeezed into the 360px column. The track list has to be mirrored too.

     The swap is keyed to `.voice--flip` ONLY, never `.voice + .voice`. The
     899px query stacks the row with a plain `.voice` selector, and `.voice +
     .voice` would out-specify it and keep two columns on a phone. */
  .voice--flip {
    grid-template-columns: minmax(0, 1fr) 360px;
  }

  .voice--flip .voice__media,
  .voice + .voice .voice__media {
    order: 2;
  }

  .voice + .voice {
    margin-top: var(--sb-10);
    padding-top: var(--sb-10);
    border-top: var(--sb-hairline);
  }

  .voice__media {
    border-radius: 18px;
    overflow: hidden;
    box-shadow: 0 2px 6px rgba(28, 14, 8, 0.08), 0 22px 44px rgba(28, 14, 8, 0.12);
  }

  .voice__mark {
    display: block;
    color: var(--sb-violet);
    opacity: 0.85;
    margin-bottom: var(--sb-5);
  }

  .voice__prose p {
    color: var(--sb-text-secondary);
    line-height: 1.75;
    max-width: 62ch;
  }

  .voice__prose p + p {
    margin-top: var(--sb-5);
  }

  /* The rule is the width of the name, not the column — a full-width hairline
     under a two-word signature reads as a section break rather than a sign-off. */
  .voice__sign {
    display: inline-block;
    margin-top: var(--sb-7);
    padding-top: var(--sb-5);
    border-top: 2px solid var(--sb-violet);
  }

  .voice__name {
    font-family: var(--sb-font-display);
    font-size: clamp(18px, 1.6vw, 21px);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }

  .voice__role {
    margin-top: 2px;
    font-size: var(--sb-body-sm);
    color: var(--sb-text-muted);
  }

  @media (max-width: 1023px) {
    .hist-line__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .hist-next__row {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 899px) {
    .voice {
      grid-template-columns: minmax(0, 1fr);
    }
    /* Order is a desktop device; stacked, the portrait always leads. */
    .voice + .voice .voice__media {
      order: 0;
    }
    .voice__media {
      max-width: 280px;
    }
  }

  @media (max-width: 639px) {
    .hist-line__list {
      grid-template-columns: minmax(0, 1fr);
    }
    .voice + .voice {
      margin-top: var(--sb-9);
      padding-top: var(--sb-9);
    }
  }
</style>
