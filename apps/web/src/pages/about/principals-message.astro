---
/**
 * ABOUT → PRINCIPAL'S MESSAGE — audit 1.10, 1.12
 *
 * Audit 1.10 keeps this as its own page rather than folding it into About.
 *
 * COPY — the passages below are the school's own published words, used verbatim.
 * Audit 1.12 requires the published page to be "thoroughly proofread to
 * eliminate grammatical and spelling errors": these particular passages read
 * cleanly, which is why they are the ones extracted for the homepage too. The
 * FULL message has not been supplied in a proofread form — asset request A5 —
 * so what is here is an accurate extract, not an invented expansion of it.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import LeaderMessage from '../../components/about/LeaderMessage.astro';
import { getLeaderMessage } from '../../lib/cms';
import banner from '../../assets/photos/sunbeem-1.jpg';

const leader = await getLeaderMessage('principal');


---

<BaseLayout
>
  <PageHero
    src={banner}
  />

  <div class="u-page-panel">
    <LeaderMessage
      eyebrow={leader?.eyebrow}
      heading={leader?.heading}
      name={leader?.name}
      role={leader?.roleLabel}
      portrait={leader?.portrait}
      portraitAlt={leader?.portraitAlt}
      portraitBrief={leader?.portraitBrief}
      pullQuote={leader?.pullQuote}
      paragraphs={leader?.paragraphs ?? []}
      credentials={leader?.credentials ?? []}
      pending={leader?.pending}
    />
  </div>
</BaseLayout>
