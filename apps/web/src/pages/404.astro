---
/**
 * 404 — THE PAGE A MISTYPED OR STALE LINK LANDS ON.
 *
 * ═══ WHY THIS EXISTS ═══════════════════════════════════════════════════════
 *
 * Without a 404.astro, Astro's static build emits nothing for an unknown path
 * and the host answers instead. On Vercel that is a raw error screen reading
 * "404: NOT_FOUND · Code: NOT_FOUND · ID: bom1::785sn-…" with a link to
 * Vercel's documentation: it names the hosting provider, prints an internal
 * request ID, carries no branding, and offers no route back to the school. A
 * parent who followed an old link from a WhatsApp forward sees that and
 * concludes the school's website is broken.
 *
 * ⚠ THIS IS NOT PageSoon, AND THE DIFFERENCE MATTERS. PageSoon says "this
 * section is being written" about a route the school MEANT to publish. This
 * says "this address does not exist", which is a different claim, and saying
 * the first where the second is true would be a lie to anyone who mistyped a
 * URL. The two must never be merged.
 *
 * ⚠ EVERY DESTINATION BELOW IS A REAL, FINISHED PAGE. Sending someone who has
 * already hit a dead end to /admissions/ — which is itself still a placeholder
 * — would be a second dead end in a row. Checked against the build, not
 * assumed: these are the routes that have content today.
 *
 * ⚠ noindex. A 404 that gets indexed is worse than no 404 page at all.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/ui/PageHero.astro';
import { getSchool } from '../lib/cms';

import heroPhoto from '../assets/photos/sunbeem-1.jpg';

const school = await getSchool();

/** Real pages only — see the note above. */
const routes = [
  { label: 'Homepage', href: '/', desc: 'Start again from the top.' },
  { label: 'Notices', href: '/news-events/notices/', desc: 'Official circulars as the school issues them.' },
  { label: 'Academics', href: '/academics/', desc: 'Structure, teaching and student success.' },
  { label: 'Campus Tour', href: '/campus/', desc: 'The grounds, facilities and transport.' },
  { label: 'Contact Us', href: '/contact-us/', desc: 'Address, numbers and the school office.' },
  { label: 'Mandatory Public Disclosure', href: '/general-info/', desc: 'The CBSE-required disclosure and its documents.' },
];
---

<BaseLayout
>
  <PageHero
    src={heroPhoto}
  />

  <div class="u-page-panel nf-panel">
    <section class="nf" aria-labelledby="nf-title">
      <div class="u-container nf__inner">
        <p class="as-kicker" data-reveal>Error 404</p>
        <h2 class="nf__h" id="nf-title">We can’t find that page</h2>
        <p class="nf__b">
          The link may be out of date, or the address may have been mistyped. Nothing
          has gone wrong with the rest of the site — here is where most people were
          heading.
        </p>

        <ul class="nf__grid">
          {routes.map((r) => (
            <li>
              <a class="nf__card" href={r.href}>
                <span class="nf__card-h">{r.label}</span>
                <span class="nf__card-d">{r.desc}</span>
                <span class="nf__card-go" aria-hidden="true">
                  <svg width="13" height="10" viewBox="0 0 14 10" fill="none">
                    <path d="M9 1L13 5L9 9M13 5H0" stroke="currentColor" stroke-width="1.6" />
                  </svg>
                </span>
              </a>
            </li>
          ))}
        </ul>

        <p class="nf__call">
          Still stuck? Call the school on{' '}
          <a href={`tel:${school.phone.admissions}`}>{school.phone.admissionsDisplay}</a>.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>

<style>
  div.nf-panel { padding-block: 0; }

  .nf {
    padding-block: clamp(56px, 9vh, 110px);
    background: var(--sb-ivory);
  }
  .nf__inner { max-width: 900px; }

  .nf__h {
    margin: clamp(8px, 1vw, 12px) 0 0;
    font-family: var(--sb-font-display);
    font-size: clamp(28px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.06;
    letter-spacing: -0.02em;
    color: var(--sb-charcoal);
  }
  .nf__b {
    margin: clamp(12px, 1.6vw, 18px) 0 0;
    max-width: 58ch;
    font-size: clamp(13.5px, 1vw, 15.5px);
    line-height: 1.7;
    color: var(--sb-text-secondary);
  }

  .nf__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.5vw, 18px);
    margin: clamp(26px, 3.4vw, 40px) 0 0;
    padding: 0;
    list-style: none;
  }

  .nf__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 100%;
    padding: clamp(16px, 1.9vw, 22px);
    padding-right: clamp(38px, 4vw, 46px);
    border: 1px solid var(--sb-border);
    border-radius: var(--sb-r-2);
    background: var(--sb-paper);
    transition:
      border-color 220ms var(--sb-ease),
      transform 220ms var(--sb-ease),
      box-shadow 220ms var(--sb-ease);
  }
  .nf__card:hover {
    border-color: var(--sb-violet);
    transform: translateY(-3px);
    box-shadow: 0 18px 34px -24px rgba(28, 14, 8, 0.4);
  }

  .nf__card-h {
    font-family: var(--sb-font-display);
    font-size: clamp(14px, 1.05vw, 16px);
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--sb-charcoal);
  }
  .nf__card-d {
    font-size: clamp(12px, 0.85vw, 13px);
    line-height: 1.55;
    color: var(--sb-text-muted);
  }
  .nf__card-go {
    position: absolute;
    top: clamp(16px, 1.9vw, 22px);
    right: clamp(14px, 1.6vw, 18px);
    display: grid;
    place-items: center;
    width: 26px;
    height: 26px;
    border-radius: var(--sb-r-full);
    border: 1px solid var(--sb-border-strong);
    color: var(--sb-charcoal);
    transition: transform 220ms var(--sb-ease);
  }
  .nf__card-go svg { transform: rotate(-45deg); }
  .nf__card:hover .nf__card-go { transform: translate(3px, -3px); }

  .nf__call {
    margin: clamp(22px, 2.6vw, 30px) 0 0;
    font-size: clamp(12.5px, 0.9vw, 14px);
    color: var(--sb-text-muted);
  }
  .nf__call a {
    font-weight: 700;
    color: var(--sb-violet);
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 899px) {
    .nf__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (max-width: 559px) {
    .nf__grid { grid-template-columns: minmax(0, 1fr); }
  }
</style>
