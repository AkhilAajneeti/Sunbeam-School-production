---
import { getTransportData, transportCountsSentence, getSchool } from '../../lib/cms';

const { stats } = await getTransportData();
const school = await getSchool();

/**
 * ⚠⚠ THIS PAGE COMPOSES ITS OWN META DESCRIPTION, AND IT IS THE ONLY ONE THAT DOES.
 *
 * G2 moved every route's description into page-meta, which was right for 73 of
 * the 74 — but this one states COUNTS: "22 buses across 28 route runs and 91
 * boarding points". Those are derived from the routes themselves, so a stored
 * copy is correct on the day it is written and wrong the moment the school adds
 * a route, with nothing to indicate it has gone stale.
 *
 * So the sentence is rebuilt from the live Bus Route rows and passed as an
 * override; BaseLayout prefers a passed description over the stored one. The
 * page-meta row still holds its (now ignored) copy, which is harmless and keeps
 * the table uniform — the alternative is a null column that means "ask the
 * route", which is worse to read.
 */
const description =
  `Bus routes for ${school.name}: ${transportCountsSentence(stats)}. ` +
  "Search your area to find the bus that stops near you, with the driver's name and number for every route.";

/**
 * TRANSPORT — a route portal, not a marketing page.
 *
 * ═══ WHAT THE SOURCE PAGE IS, AND WHAT IT IS NOT ═══════════════════════════
 *
 * https://sunbeamballia.edu.in/bus-routes/ is a single five-column table of 28
 * route runs, plus one line naming the transport in-charge. That is the entire
 * page. Every route, driver, mobile number and stop here is from that table,
 * parsed out of its HTML rather than retyped — see data/transport.ts.
 *
 * It publishes NO timings, NO fares, NO registration numbers and NO FAQs, so
 * this page has none of those either.
 *
 * ═══ THE BRIEF IS TO MIRROR THE CONTENT AND DESIGN IT ══════════════════════
 *
 * Client, after reviewing a first pass: *"i want every content similar to the
 * parent page … no need to update anything our duty is only to design."*
 *
 * That reversed three things this page had been doing, all of them well-meant
 * and all of them the site editing the school's data rather than presenting it:
 *
 *   · It reported 27 route runs, filtering out the staff bus because a parent
 *     cannot ride it. The parent page has 28 rows; there are now 28.
 *   · Every card's right-hand endpoint read "School / Sunbeam Ballia". True of
 *     a school bus, and nowhere in the published Route column. Both endpoints
 *     are now the first and last entries of the list as printed.
 *   · A written FAQ and a "told to us, not yet published" safety group. Both
 *     were honestly labelled and neither was the school's. Both are gone.
 *
 * What remains beyond the route table is only what the school states elsewhere
 * on its own site: GPS and speed governors and "Buses : 29+" from
 * /facilities-infrastructure/, and the transport in-charge from the bus-routes
 * page itself.
 *
 * ═══ TWO DEPARTURES FROM THE REQUESTED SECTION LIST, BOTH DELIBERATE ═══════
 *
 * ⚠ "COVERAGE AREAS" AND "ROUTE FINDER" ARE ONE SECTION, NOT TWO. They are the
 * same interaction: the coverage chips ARE the search. Split apart, a parent
 * reads a list of localities, finds theirs, and then has to scroll to a
 * separate box and retype it. Joined, the chip IS the query — one tap and the
 * routes below filter to the buses that stop there. Two sections would have
 * looked like more page and been less use.
 *
 * ⚠ THERE IS NO FLEET GALLERY, because there is no fleet photography. The
 * repository holds not one image of a Sunbeam Ballia bus — the only aerial that
 * shows a bus park is another school in hill country. Under docs/07 the choice
 * is an obvious placeholder or nothing, and a gallery is not a component that
 * degrades gracefully to one tile of grey. It goes in the moment photographs
 * arrive; the request is logged in the placeholder inventory.
 *
 * ⚠ THIS FILE RETIRES A GENERATED PLACEHOLDER AUTOMATICALLY — a real file at
 * this path wins over pages/[...slug].astro and drops out of its list.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionRail from '../../components/academics/SectionRail.astro';
import RouteFinder from '../../components/transport/RouteFinder.astro';
import TransportBands from '../../components/transport/TransportBands.astro';


import heroPhoto from '../../assets/photos/sunbeem-1.jpg';

const rail = [
  { id: 'overview', label: 'Overview' },
  { id: 'routes', label: 'Find your route' },
  { id: 'safety', label: 'Safety' },
  { id: 'transport-contact', label: 'Contact' },

];
---

<BaseLayout
  description={description}
>
  <PageHero
    src={heroPhoto}
  />

  <SectionRail items={rail} />

  {/* padding-block: 0 — each band carries its own --sb-section-y, and the panel
      adding its own on top is what put a 183px void under the hero on three
      earlier pages. */}
  {/* The route finder is SLOTTED into TransportBands, landing between the
      overview and the safety band. See the note at that slot on why this is a
      slot and not CSS `order`. */}
  <div class="u-page-panel tr-panel">
    <TransportBands>
      <RouteFinder />
    </TransportBands>
  </div>
</BaseLayout>

<style>
  div.tr-panel { padding-block: 0; }

  .tr-panel :global(section[id]) {
    scroll-margin-top: calc(var(--sb-masthead-h) + 24px);
  }
</style>
