---
/**
 * CAMPUS → FACILITIES & INFRASTRUCTURE  ·  audit §3 — "Merge Facilities and
 * Infrastructure within the Campus Tour section, supported by impactful
 * photographs that effectively showcase the campus."
 *
 * CONTENT PRESERVATION WAS THE FIRST REQUIREMENT, so it is worth stating how it
 * is guaranteed rather than merely intended. Every facility lives in
 * src/data/facilities.ts, and §2 Groups renders ALL of them — the six category
 * sections between them carry the complete inventory, 47 items, with each
 * section printing its own count in the heading column. A facility therefore
 * cannot be lost by being left out of a designed section; it would have to be
 * deleted from the data. The counts are computed from the arrays rather than
 * typed, so the page audits itself.
 *
 * ⚠ THE GROUPS ARE NOW THE ONLY FULL LISTING. A flat, filterable Explorer used
 * to repeat the inventory after them and was removed at the client's request
 * (the page was running long). Nothing was lost — Groups already rendered all
 * 47 — but if a facility is ever added to `facilities.ts` outside a group, this
 * page will no longer catch it. The Showcase section, four feature rows for
 * Robotics/Library/Smart Classrooms/Sports, went at the same time as duplicating
 * what the groups above it already say, and Progression — the arrival-to-
 * graduation track — went with them. All three components are still in
 * components/campus/facilities/ if any of them returns.
 *
 * FIVE ITEMS THE BRIEF'S OWN LIST MISSED are restored from docs/01 — the
 * Language Lab, the Srijan Lab, the sand pool, the little agriculture land and
 * the Class 7 KIDS Entrepreneurship programme.
 *
 *   1 Kpis         ivory      · 8 published figures, counting up
 *   2 Groups       alternating· 6 categories, sticky heading + all 47 items
 *   3 Masonry      ivory      · REUSED from the Campus Tour — 68 frames
 *   4 Progression  ivory      · arrival → graduation, horizontal
 *   5 VisitCta     ink        · REUSED from the Campus Tour
 *
 * ⚠ THE TWO STRONGEST CLAIMS HAVE NO PHOTOGRAPH. The Robotics Lab (drone, 3-D
 * printer, telescope) and the Smart Classrooms are unphotographed anywhere in
 * this repository. Both keep a full showcase row and render their shot brief;
 * `Robotics-drones.jpg` is a consumer DJI product shot and
 * `Smart-classrooms.jpg` is an empty Western lecture theatre, so neither is used.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/ui/PageHero.astro';
import SectionRail from '../../components/academics/SectionRail.astro';

import Kpis from '../../components/campus/facilities/Kpis.astro';
import Groups from '../../components/campus/facilities/Groups.astro';

/* Reused wholesale from the Campus Tour, per the brief's "reuse components
   wherever possible" — the gallery and the closing CTA are the same job here. */
import Masonry from '../../components/campus/tour/Masonry.astro';
import VisitCta from '../../components/campus/tour/VisitCta.astro';

import heroPhoto from '../../assets/photos/sunbeem-1.jpg';
---

<BaseLayout
>
  <PageHero
    src={heroPhoto}
  />

  <SectionRail
    items={[
      { id: 'figures', label: 'In figures' },
      { id: 'learning', label: 'Learning' },
      { id: 'science', label: 'Science' },
      { id: 'digital', label: 'Digital' },
      { id: 'creative', label: 'Creative' },
      { id: 'sport', label: 'Sport' },
      { id: 'safety', label: 'Safety' },
      { id: 'gallery', label: 'Gallery' },
    ]}
  />

  {/* padding-bottom: 0 — VisitCta closes on its own ink ground. */}
  <div class="u-page-panel fi-panel">
    <div id="figures"><Kpis /></div>

    {/* Groups renders its own six <section>s, each carrying the id the rail
        targets — so the rail links straight at the category, not at a wrapper. */}
    <Groups />

    <Masonry />
    <VisitCta />
  </div>
</BaseLayout>

<style>
  /* padding-block: 0, following div.as-panel on Academic Structure. Every
     section on this page carries its own --sb-section-y, so the panel's default
     63px top padding stacked on the first section's 120px and opened a 183px
     void under the banner. The foot is zero because VisitCta closes on its own
     ink ground. `div.` to out-specify .u-page-panel in base.css. */
  div.fi-panel { padding-block: 0; }

  /* Both the wrappers and the ids Groups emits itself need the sticky-masthead
     offset, or a rail jump lands with the heading hidden under the header. */
  .fi-panel > div[id],
  .fi-panel :global(section[id]) {
    scroll-margin-top: calc(var(--sb-masthead-h) + 24px);
  }
</style>
