---
import '../styles/tokens.css';
import '../styles/base.css';
import UtilityBar from '../components/navigation/UtilityBar.astro';
import Masthead from '../components/navigation/Masthead.astro';
import MobileNav from '../components/navigation/MobileNav.astro';
import Footer from '../components/layout/Footer.astro';
import { getSchool, getPageMeta, composeTitle } from '../lib/cms';

const school = await getSchool();

/**
 * ⚠⚠ SEO COMES FROM page-meta IN STRAPI, KEYED ON THIS PAGE'S OWN ROUTE.
 *
 * Every static route used to hardcode its own <title> and meta description in
 * frontmatter — 68 of them, and 66 of those repeated " — Sunbeam School Ballia"
 * as a literal. The layout now looks itself up by `Astro.url.pathname` and
 * composes the title from site-settings, so the school's name lives in exactly
 * one place and a description is edited in the admin rather than in a .astro
 * file.
 *
 * ⚠ THE PROPS SURVIVE AS AN OVERRIDE, AND THEY ARE NOT VESTIGIAL. Dynamic routes
 * — /alumni/<slug>/, the news detail pages — build their title from the record
 * they are rendering, which is content the CMS holds against the ITEM, not
 * against the route. They keep passing `title` and `description`, and a passed
 * value always wins over the looked-up one.
 */
interface Props {
  /** Overrides page-meta. Used by dynamic routes, whose SEO is per-record. */
  title?: string;
  description?: string;
  /** e.g. "noindex, follow". Omit on real pages — the default is indexable. */
  robots?: string;
}
const { title: titleProp, description: descProp, robots: robotsProp } = Astro.props;

/* Look this page up by its own path. Null for dynamic routes, which pass props. */
const pageMeta = await getPageMeta(Astro.url.pathname);

const title = titleProp ?? composeTitle(pageMeta, school.name);
const description = descProp ?? pageMeta?.seo?.metaDescription ?? '';

/* `noIndex` is a boolean in the CMS; the tag wants the string the site has
   always emitted. 'follow' is deliberate — a placeholder should not be indexed
   but its outbound links should still be crawled. */
const robots = robotsProp ?? (pageMeta?.seo?.noIndex ? 'noindex, follow' : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    {/* A reload must start at the top.

        Browsers default `history.scrollRestoration` to "auto" and put you back
        where you were — normally helpful, but wrong for a page built as a scroll
        narrative: you reload and land in the middle of it with no context, and
        every entrance animation above you has already been skipped.

        This is deliberately an inline, render-blocking script in the head. It
        has to run before the browser performs the restoration; a module script
        or anything deferred executes too late and you would see the jump happen.

        Note this does NOT force a scroll — it only stops the browser restoring
        one. A URL with a #hash still lands on its target, which a `scrollTo(0,0)`
        would have fought. */}
    <script is:inline>
      if ('scrollRestoration' in history) history.scrollRestoration = 'manual';
    </script>
    <title>{title}</title>
    {/* Finding X8 — the current site ships no meta description at all. */}
    <meta name="description" content={description} />
    {/* Only emitted where a page asks for it. The not-yet-built pages generated
        by `[...slug].astro` return a real 200, so a crawler would otherwise
        index a section with nothing behind it — `noindex, follow` keeps it out
        of results while still following its links. */}
    {robots && <meta name="robots" content={robots} />}
    <meta name="theme-color" content="#5C0000" />
    <link rel="canonical" href={Astro.url.href} />
    {/* ⚠ THE 57KB FULL EMBLEM WAS THE ONLY ICON DECLARED, and it is unreadable at
        16px. The mark is unchanged — these are just the sizes a browser and a
        phone home screen actually ask for. A genuinely simplified mark for the
        smallest size is still worth having from the school. */}
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/icon-192.png" sizes="192x192" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/source-serif-4-latin-wght-normal.woff2"
      crossorigin
    />
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/ibm-plex-sans-latin-wght-normal.woff2"
      crossorigin
    />
    {/* The display face renders above the fold in the hero heading, so it is
        preloaded rather than discovered when the CSS parses. */}
    <link
      rel="preload"
      as="font"
      type="font/woff2"
      href="/fonts/bricolage-grotesque-latin-wght-normal.woff2"
      crossorigin
    />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={school.name} />
    <meta property="og:url" content={Astro.url.href} />
    {/* ⚠ WITHOUT THIS, EVERY WHATSAPP AND FACEBOOK SHARE RENDERED WITH NO
        PICTURE — and those are the school’s main distribution channels. It is
        the school’s own campus photograph cropped to 1200x630, not a fabricated
        card. Absolute URL, because both scrapers require one. */}
    <meta property="og:image" content={new URL("/og/sunbeam-ballia.jpg", Astro.site ?? Astro.url).href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`The campus of ${school.name} at Agarsanda.`} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>

  <body>
    <a class="u-skip-link" href="#main">Skip to content</a>

    <UtilityBar />
    <Masthead />
    <MobileNav />

    <main id="main">
      <slot />
    </main>

    <Footer />

    {/* Motion (docs/05 § N). Replaces the IntersectionObserver reveal that used
        to live here, so nothing is ever animated by two systems at once.
        Content is visible by default and this only hides things once it has
        loaded and confirmed motion is permitted — see src/scripts/motion.ts. */}
    <script>
      import '../scripts/motion';
    </script>
  </body>
</html>
